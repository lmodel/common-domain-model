<BusinessDateRange> CLOSED {
    (  $<BusinessDateRange_tes> (  &<DateRange_tes> ;
          rdf:type [ <DateRange> ] ? ;
          <businessDayConvention> [ <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#FOLLOWING>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#FRN>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#MODFOLLOWING>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#PRECEDING>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#MODPRECEDING>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NEAREST>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NONE>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NotApplicable> ] ;
          <businessCenters> @<BusinessCenters> ?
       ) ;
       rdf:type [ <BusinessDateRange> ] ?
    )
}

<BusinessDayAdjustments> CLOSED {
    (  $<BusinessDayAdjustments_tes> (  <businessDayConvention> [
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#FOLLOWING>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#FRN>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#MODFOLLOWING>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#PRECEDING>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#MODPRECEDING>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NEAREST>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NONE>
             <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NotApplicable> ] ;
          <businessCenters> @<BusinessCenters> ?
       ) ;
       rdf:type [ <BusinessDayAdjustments> ] ?
    )
}

<BusinessDayOffset>  (
    CLOSED {
       (  $<BusinessDayOffset_tes> (  &<Period_tes> ;
             rdf:type [ <Period> ] ? ;
             <businessCenters> @<BusinessCenters> ? ;
             <fixingOffsetDefinition> @linkml:String ? ;
             <fixingOffsetReason> @linkml:String ?
          ) ;
          rdf:type [ <BusinessDayOffset> ] ?
       )
    } OR @<FloatingRateIndexFixingOffset>
)

<BusinessEvent> CLOSED {
    (  $<BusinessEvent_tes> (  &<EventInstruction_tes> ;
          rdf:type [ <EventInstruction> ] ? ;
          <eventQualifier> @linkml:String ? ;
          <after> @<TradeState> *
       ) ;
       rdf:type [ <BusinessEvent> ] ?
    )
}

<BusinessUnit> CLOSED {
    (  $<BusinessUnit_tes> (  <name> @linkml:String ;
          <identifier> @<Identifier> ? ;
          <contactInformation> @<ContactInformation> ?
       ) ;
       rdf:type [ <BusinessUnit> ] ?
    )
}

<BuyerSeller>  (
    CLOSED {
       (  $<BuyerSeller_tes> (  <buyer> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
                <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] ;
             <seller> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
                <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ]
          ) ;
          rdf:type [ <BuyerSeller> ] ?
       )
    } OR @<CancelableProvision> OR @<ExtendibleProvision>
)

<CalculatedRateDetails> CLOSED {
    (  $<CalculatedRateDetails_tes> (  <observations> @<CalculatedRateObservations> ? ;
          <weightedRates> @linkml:Decimal * ;
          <growthFactor> @linkml:Decimal * ;
          <compoundedGrowth> @linkml:Decimal * ;
          <aggregateValue> @linkml:Decimal ? ;
          <aggregateWeight> @linkml:Decimal ? ;
          <calculatedRate> @linkml:Decimal ?
       ) ;
       rdf:type [ <CalculatedRateDetails> ] ?
    )
}

<CalculatedRateObservationDatesAndWeights> CLOSED {
    (  $<CalculatedRateObservationDatesAndWeights_tes> (  <observationDates> @linkml:Date * ;
          <weights> @linkml:Decimal *
       ) ;
       rdf:type [ <CalculatedRateObservationDatesAndWeights> ] ?
    )
}

<CalculatedRateObservations> CLOSED {
    (  $<CalculatedRateObservations_tes> (  <observationDates> @linkml:Date * ;
          <weights> @linkml:Decimal * ;
          <observedRates> @linkml:Decimal * ;
          <processedRates> @linkml:Decimal *
       ) ;
       rdf:type [ <CalculatedRateObservations> ] ?
    )
}

<CalculateResetInstruction> CLOSED {
    (  $<CalculateResetInstruction_tes> (  <payout> @<Payout> + ;
          <rateRecordDate> @linkml:Date ? ;
          <resetDate> @linkml:Date
       ) ;
       rdf:type [ <CalculateResetInstruction> ] ?
    )
}

<CalculateResetValueInstruction> CLOSED {
    (  $<CalculateResetValueInstruction_tes> (  <resetValue> @<Price> ;
          <calculationMethod> [ <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#Averaging>
             <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#Compounding>
             <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#CompoundedIndex> ] ? ;
          <observedRateDates> @<DatedValue> +
       ) ;
       rdf:type [ <CalculateResetValueInstruction> ] ?
    )
}

<CalculateTransferInstruction> CLOSED {
    (  $<CalculateTransferInstruction_tes> (  <tradeState> @<TradeState> ;
          <payout> @<Payout> ;
          <resets> @<Reset> * ;
          <payerReceiver> @<PayerReceiver> ? ;
          <quantity> @<Quantity> ? ;
          <date> @linkml:Date ?
       ) ;
       rdf:type [ <CalculateTransferInstruction> ] ?
    )
}

