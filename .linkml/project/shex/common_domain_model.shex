<CalculationSchedule> CLOSED {
    (  $<CalculationSchedule_tes> <schedulePeriod> @<SchedulePeriod> + ;
       rdf:type [ <CalculationSchedule> ] ?
    )
}

<CalculationScheduleDeliveryPeriods> CLOSED {
    (  $<CalculationScheduleDeliveryPeriods_tes> (  &<AssetDeliveryPeriods_tes> ;
          rdf:type [ <AssetDeliveryPeriods> ] ? ;
          <deliveryCapacity> @<Quantity> ? ;
          <priceTimeIntervalQuantity> @<Price> ?
       ) ;
       rdf:type [ <CalculationScheduleDeliveryPeriods> ] ?
    )
}

<CalendarSpread> CLOSED {
    (  $<CalendarSpread_tes> <expirationDateTwo> @<AdjustableOrRelativeDate> ;
       rdf:type [ <CalendarSpread> ] ?
    )
}

<CancelableProvision> CLOSED {
    (  $<CancelableProvision_tes> (  &<BuyerSeller_tes> ;
          rdf:type [ <BuyerSeller> ] ? ;
          <exerciseNotice> @<ExerciseNotice> ? ;
          <followUpConfirmation> @linkml:Boolean ;
          <cancelableProvisionAdjustedDates> @<CancelableProvisionAdjustedDates> ? ;
          <finalCalculationPeriodDateAdjustment> @<FinalCalculationPeriodDateAdjustment> * ;
          <initialFee> @<Transfer> ? ;
          <callingParty> [ <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#InitialBuyer>
             <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#InitialSeller>
             <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#Either>
             <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#AsDefinedInMasterAgreement> ] ? ;
          <earliestDate> @<AdjustableOrRelativeDate> ? ;
          <expirationDate> @<AdjustableOrRelativeDate> ? ;
          <effectiveDate> @<AdjustableOrRelativeDates> ? ;
          <effectivePeriod> @<Period> ? ;
          <earliestCancellationTime> @<BusinessCenterTime> ? ;
          <latestCancelationTime> @<BusinessCenterTime> ? ;
          <exerciseTerms> @<ExerciseTerms>
       ) ;
       rdf:type [ <CancelableProvision> ] ?
    )
}

<CancelableProvisionAdjustedDates> CLOSED {
    (  $<CancelableProvisionAdjustedDates_tes> <cancellationEvent> @<CancellationEvent> + ;
       rdf:type [ <CancelableProvisionAdjustedDates> ] ?
    )
}

<CancellationEvent> CLOSED {
    (  $<CancellationEvent_tes> (  <adjustedExerciseDate> @linkml:Date ;
          <adjustedEarlyTerminationDate> @linkml:Date
       ) ;
       rdf:type [ <CancellationEvent> ] ?
    )
}

<Cash> CLOSED {
    (  $<Cash_tes> (  &<AssetBase_tes> ;
          rdf:type [ <AssetBase> ] ?
       ) ;
       rdf:type [ <Cash> ] ?
    )
}

<CashCollateralValuationMethod> CLOSED {
    (  $<CashCollateralValuationMethod_tes> (  <applicableCsa> [ <https://w3id.org/lmodel/common-domain-model/CsaTypeEnum#NoCSA>
             <https://w3id.org/lmodel/common-domain-model/CsaTypeEnum#ExistingCSA>
             <https://w3id.org/lmodel/common-domain-model/CsaTypeEnum#ReferenceVMCSA> ] ? ;
          <cashCollateralCurrency> @linkml:String ? ;
          <cashCollateralInterestRate> @linkml:String ? ;
          <agreedDiscountRate> @linkml:String ? ;
          <protectedParty> [ <https://w3id.org/lmodel/common-domain-model/PartyDeterminationEnum#ExercisingParty>
             <https://w3id.org/lmodel/common-domain-model/PartyDeterminationEnum#NonExercisingParty>
             <https://w3id.org/lmodel/common-domain-model/PartyDeterminationEnum#AsSpecifiedInMasterAgreement>
             <https://w3id.org/lmodel/common-domain-model/PartyDeterminationEnum#AsSpecifiedInStandardTermsSupplement>
             <https://w3id.org/lmodel/common-domain-model/PartyDeterminationEnum#Both> ] * ;
          <prescribedDocumentationAdjustment> @linkml:Boolean ?
       ) ;
       rdf:type [ <CashCollateralValuationMethod> ] ?
    )
}

<CashflowRepresentation> CLOSED {
    (  $<CashflowRepresentation_tes> (  <cashflowsMatchParameters> @linkml:Boolean ;
          <paymentCalculationPeriod> @<PaymentCalculationPeriod> *
       ) ;
       rdf:type [ <CashflowRepresentation> ] ?
    )
}

<CashSettlementTerms> CLOSED {
    (  $<CashSettlementTerms_tes> (  <cashSettlementMethod> [
             <https://w3id.org/lmodel/common-domain-model/CashSettlementMethodEnum#CashPriceMethod>
             <https://w3id.org/lmodel/common-domain-model/CashSettlementMethodEnum#CashPriceAlternateMethod>
