<ExercisePeriod> CLOSED {
    (  $<ExercisePeriod_tes> (  <earliestExerciseDateTenor> @<Period> ;
          <exerciseFrequency> @<Period> ?
       ) ;
       rdf:type [ <ExercisePeriod> ] ?
    )
}

<ExerciseProcedure> CLOSED {
    (  $<ExerciseProcedure_tes> (  <manualExercise> @<ManualExercise> ? ;
          <automaticExercise> @<AutomaticExercise> ? ;
          <followUpConfirmation> @linkml:Boolean ;
          <limitedRightToConfirm> @linkml:Boolean ? ;
          <splitTicket> @linkml:Boolean ?
       ) ;
       rdf:type [ <ExerciseProcedure> ] ?
    )
}

<ExerciseTerms> CLOSED {
    (  $<ExerciseTerms_tes> (  <style> [ <https://w3id.org/lmodel/common-domain-model/OptionExerciseStyleEnum#European>
             <https://w3id.org/lmodel/common-domain-model/OptionExerciseStyleEnum#Bermuda>
             <https://w3id.org/lmodel/common-domain-model/OptionExerciseStyleEnum#American> ] ? ;
          <commencementDate> @<AdjustableOrRelativeDate> ? ;
          <exerciseDates> @<AdjustableOrRelativeDates> ? ;
          <expirationDate> @<AdjustableOrRelativeDate> * ;
          <relevantUnderlyingDate> @<AdjustableOrRelativeDates> ? ;
          <earliestExerciseTime> @<BusinessCenterTime> ? ;
          <latestExerciseTime> @<BusinessCenterTime> ? ;
          <expirationTime> @<BusinessCenterTime> ? ;
          <expirationTimeType> [ <https://w3id.org/lmodel/common-domain-model/ExpirationTimeTypeEnum#Close>
             <https://w3id.org/lmodel/common-domain-model/ExpirationTimeTypeEnum#Open>
             <https://w3id.org/lmodel/common-domain-model/ExpirationTimeTypeEnum#OSP>
             <https://w3id.org/lmodel/common-domain-model/ExpirationTimeTypeEnum#SpecificTime>
             <https://w3id.org/lmodel/common-domain-model/ExpirationTimeTypeEnum#XETRA>
             <https://w3id.org/lmodel/common-domain-model/ExpirationTimeTypeEnum#DerivativesClose>
             <https://w3id.org/lmodel/common-domain-model/ExpirationTimeTypeEnum#AsSpecifiedInMasterConfirmation> ] ;
          <multipleExercise> @<MultipleExercise> ? ;
          <exerciseFeeSchedule> @<ExerciseFeeSchedule> ? ;
          <exerciseProcedure> @<ExerciseProcedure> ? ;
          <exerciseFee> @<ExerciseFee> ? ;
          <partialExercise> @<PartialExercise> ?
       ) ;
       rdf:type [ <ExerciseTerms> ] ?
    )
}

<Exposure> CLOSED {
    (  $<Exposure_tes> (  <tradePortfolio> @<PortfolioState> ;
          <aggregateValue> @<Money> ;
          <calculationDateTime> @linkml:Datetime ? ;
          <valuationDateTime> @linkml:Datetime
       ) ;
       rdf:type [ <Exposure> ] ?
    )
}

<ExposureScope> CLOSED {
    (  $<ExposureScope_tes> <partyElection> @<LegacyExposureScopeElection> * ;
       rdf:type [ <ExposureScope> ] ?
    )
}

<ExtendibleProvision> CLOSED {
    (  $<ExtendibleProvision_tes> (  &<BuyerSeller_tes> ;
          rdf:type [ <BuyerSeller> ] ? ;
          <exerciseNotice> @<ExerciseNotice> ? ;
          <followUpConfirmation> @linkml:Boolean ? ;
          <extendibleProvisionAdjustedDates> @<ExtendibleProvisionAdjustedDates> ? ;
          <callingParty> [ <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#InitialBuyer>
             <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#InitialSeller>
             <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#Either>
             <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#AsDefinedInMasterAgreement> ] ? ;
          <singlePartyOption> @<PartyRole> ? ;
          <noticeDeadlinePeriod> @<RelativeDateOffset> ? ;
          <noticeDeadlineDateTime> @linkml:Datetime ? ;
          <extensionTerm> @<RelativeDateOffset> ? ;
          <extensionPeriod> @<AdjustableRelativeOrPeriodicDates> ? ;
          <exerciseTerms> @<ExerciseTerms>
       ) ;
       rdf:type [ <ExtendibleProvision> ] ?
    )
}

<ExtendibleProvisionAdjustedDates> CLOSED {
    (  $<ExtendibleProvisionAdjustedDates_tes> <extensionEvent> @<ExtensionEvent> + ;
       rdf:type [ <ExtendibleProvisionAdjustedDates> ] ?
    )
}

<ExtensionEvent> CLOSED {
    (  $<ExtensionEvent_tes> (  <adjustedExerciseDate> @linkml:Date ;
          <adjustedExtendedTerminationDate> @linkml:Date
       ) ;
       rdf:type [ <ExtensionEvent> ] ?
    )
}

<ExtraordinaryEvents> CLOSED {
    (  $<ExtraordinaryEvents_tes> (  <additionalBespokeTerms> @<Clause> * ;
          <mergerEvents> @<EquityCorporateEvents> ? ;
          <tenderOfferEvents> @<EquityCorporateEvents> ? ;
          <compositionOfCombinedConsideration> @linkml:Boolean ? ;
          <indexAdjustmentEvents> @<IndexAdjustmentEvents> ? ;
          <additionalDisruptionEvents> @<AdditionalDisruptionEvents> ? ;
          <failureToDeliver> @linkml:Boolean ? ;
          <representations> @<Representations> ? ;
          <nationalizationOrInsolvency> [
             <https://w3id.org/lmodel/common-domain-model/NationalizationOrInsolvencyOrDelistingEventEnum#NegotiatedCloseout>
             <https://w3id.org/lmodel/common-domain-model/NationalizationOrInsolvencyOrDelistingEventEnum#CancellationAndPayment> ]
          ? ;
          <delisting> [
             <https://w3id.org/lmodel/common-domain-model/NationalizationOrInsolvencyOrDelistingEventEnum#NegotiatedCloseout>
             <https://w3id.org/lmodel/common-domain-model/NationalizationOrInsolvencyOrDelistingEventEnum#CancellationAndPayment> ]
          ?
       ) ;
       rdf:type [ <ExtraordinaryEvents> ] ?
    )
}

<FailureToPay> CLOSED {
    (  $<FailureToPay_tes> (  <applicable> @linkml:Boolean ;
          <gracePeriodExtension> @<GracePeriodExtension> ? ;
          <paymentRequirement> @<Money> ?
       ) ;
       rdf:type [ <FailureToPay> ] ?
    )
}

<FallbackRateParameters> CLOSED {
    (  $<FallbackRateParameters_tes> (  <floatingRateIndex> [
             <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexEnum#AED-EBOR-Reuters>
             <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexEnum#AED-EIBOR>
