<CollateralCriteriaBase>  (
    CLOSED {
       (  $<CollateralCriteriaBase_tes> (  <collateralCriteria> @<CollateralCriteria> ? ;
             <appliesTo> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
                <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] * ;
             <restrictTo> [ <https://w3id.org/lmodel/common-domain-model/CollateralMarginTypeEnum#VariationMargin>
                <https://w3id.org/lmodel/common-domain-model/CollateralMarginTypeEnum#InitialMargin> ] ? ;
             <ratingPriorityResolution> [ <https://w3id.org/lmodel/common-domain-model/RatingPriorityResolutionEnum#Issuer>
                <https://w3id.org/lmodel/common-domain-model/RatingPriorityResolutionEnum#Asset>
                <https://w3id.org/lmodel/common-domain-model/RatingPriorityResolutionEnum#Lowest>
                <https://w3id.org/lmodel/common-domain-model/RatingPriorityResolutionEnum#Highest>
                <https://w3id.org/lmodel/common-domain-model/RatingPriorityResolutionEnum#Average> ] ?
          ) ;
          rdf:type [ <CollateralCriteriaBase> ] ?
       )
    } OR @<ConcentrationLimitCriteria> OR @<EligibleCollateralCriteria>
)

<CollateralGuarantorType> CLOSED {
    (  $<CollateralGuarantorType_tes> <guarantorType> [
          <https://w3id.org/lmodel/common-domain-model/CollateralEntityTypeEnum#SupraNational>
          <https://w3id.org/lmodel/common-domain-model/CollateralEntityTypeEnum#SovereignCentralBank>
          <https://w3id.org/lmodel/common-domain-model/CollateralEntityTypeEnum#QuasiGovernment>
          <https://w3id.org/lmodel/common-domain-model/CollateralEntityTypeEnum#RegionalGovernment>
          <https://w3id.org/lmodel/common-domain-model/CollateralEntityTypeEnum#Corporate>
          <https://w3id.org/lmodel/common-domain-model/CollateralEntityTypeEnum#Fund>
          <https://w3id.org/lmodel/common-domain-model/CollateralEntityTypeEnum#SpecialPurposeVehicle> ] ;
       rdf:type [ <CollateralGuarantorType> ] ?
    )
}

