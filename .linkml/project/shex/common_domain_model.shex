<CalculationAgentTerms> CLOSED {
    (  $<CalculationAgentTerms_tes> (  <party> [
             <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party%201>
             <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party%202>
             <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party%20Making%20the%20Demand> ] ? ;
          <bespokeCalculationAgentTerms> @linkml:String ?
       ) ;
       rdf:type [ <CalculationAgentTerms> ] ?
    )
}

<CalculationAndTimingBase>  (
    CLOSED {
       (  $<CalculationAndTimingBase_tes> <notificationTime> @<NotificationTime> ;
          rdf:type [ <CalculationAndTimingBase> ] ?
       )
    } OR @<CalculationAndTimingCollateralTransferAgreement> OR @<CalculationAndTimingInitialMargin> OR
    @<CalculationAndTimingLegacy> OR @<CalculationAndTimingVariationMargin>
)

<CalculationAndTimingCollateralTransferAgreement> CLOSED {
    (  $<CalculationAndTimingCollateralTransferAgreement_tes> (  &<CalculationAndTimingBase_tes> ;
          rdf:type [ <CalculationAndTimingBase> ] ? ;
          <calculationAgentTerms> @<CalculationAgentTerms> ? ;
          <bespokeCalculationDate> @<BespokeCalculationDate> ? ;
          <bespokeCalculationTime> @<BespokeCalculationTime> ? ;
          <calculationDateLocation> @<ValuationCalculationDateLocation> ? ;
          <cashSettlementDay> @linkml:String ? ;
          <securitiesSettlementDay> @linkml:String ?
       ) ;
       rdf:type [ <CalculationAndTimingCollateralTransferAgreement> ] ?
    )
}

<CalculationAndTimingInitialMargin> CLOSED {
    (  $<CalculationAndTimingInitialMargin_tes> (  &<CalculationAndTimingBase_tes> ;
          rdf:type [ <CalculationAndTimingBase> ] ? ;
          <calculationAgentTerms> @<CalculationAgentTerms> ;
          <bespokeCalculationDate> @<BespokeCalculationDate> ? ;
          <bespokeCalculationTime> @<BespokeCalculationTime> ? ;
          <calculationDateLocation> @<ValuationCalculationDateLocation> ;
          <cashSettlementDay> @linkml:String ? ;
          <securitiesSettlementDay> @linkml:String ?
       ) ;
       rdf:type [ <CalculationAndTimingInitialMargin> ] ?
    )
}

<CalculationAndTimingLegacy> CLOSED {
    (  $<CalculationAndTimingLegacy_tes> (  &<CalculationAndTimingBase_tes> ;
          rdf:type [ <CalculationAndTimingBase> ] ? ;
          <valuationDate> @<CSAValuationDate> ;
          <valuationTime> @<ValuationTime> ;
          <valuationAgent> @<ValuationAgent>
       ) ;
       rdf:type [ <CalculationAndTimingLegacy> ] ?
    )
}

<CalculationAndTimingVariationMargin> CLOSED {
    (  $<CalculationAndTimingVariationMargin_tes> (  &<CalculationAndTimingBase_tes> ;
          rdf:type [ <CalculationAndTimingBase> ] ? ;
          <valuationDate> @<CSAValuationDate> ;
          <valuationTime> @<ValuationTime> ;
          <valuationAgent> @<ValuationAgent> ;
          <valuationDateLocation> @<ValuationCalculationDateLocation>
       ) ;
       rdf:type [ <CalculationAndTimingVariationMargin> ] ?
    )
}

<CalculationCurrencyElection> CLOSED {
    (  $<CalculationCurrencyElection_tes> (  <party> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] ;
          <isBaseCurrency> @linkml:Boolean ;
          <currency> @linkml:String ?
       ) ;
       rdf:type [ <CalculationCurrencyElection> ] ?
    )
}

