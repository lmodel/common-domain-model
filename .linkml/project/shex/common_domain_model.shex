<TransferBase>  (
    CLOSED {
       (  $<TransferBase_tes> (  <identifier> @<Identifier> * ;
             <quantity> @<NonNegativeQuantity> ;
             <asset> @<Asset> ;
             <settlementDate> @<AdjustableOrAdjustedOrRelativeDate> ;
             <paymentDiscounting> @<PaymentDiscounting> ? ;
             <partyReferencePayerReceiver> @<PartyReferencePayerReceiver> ?
          ) ;
          rdf:type [ <TransferBase> ] ?
       )
    } OR @<PayoutTransferBase> OR @<UnscheduledTransfer>
)

<TransferContactInformation> CLOSED {
