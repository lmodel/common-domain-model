    )
}

<Strike> CLOSED {
    (  $<Strike_tes> (  <strikeRate> @linkml:Decimal ;
          <buyer> [ <https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum#Payer>
             <https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum#Receiver> ] ? ;
          <seller> [ <https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum#Payer>
             <https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum#Receiver> ] ?
       ) ;
       rdf:type [ <Strike> ] ?
    )
}

<StrikeSchedule> CLOSED {
    (  $<StrikeSchedule_tes> (  &<RateSchedule_tes> ;
          rdf:type [ <RateSchedule> ] ? ;
          <buyer> [ <https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum#Payer>
             <https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum#Receiver> ] ? ;
          <seller> [ <https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum#Payer>
             <https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum#Receiver> ] ?
       ) ;
       rdf:type [ <StrikeSchedule> ] ?
    )
}

<StrikeSpread> CLOSED {
    (  $<StrikeSpread_tes> (  <upperStrike> @<OptionStrike> ;
          <upperStrikeNumberOfOptions> @linkml:Decimal
       ) ;
       rdf:type [ <StrikeSpread> ] ?
    )
}

