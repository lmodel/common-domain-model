<FloatingRateIndexMappings> CLOSED {
    (  $<FloatingRateIndexMappings_tes> (  <mapsTo> @<FloatingRateIndexMap> ? ;
          <mapsFrom> @<FloatingRateIndexMap> *
       ) ;
       rdf:type [ <FloatingRateIndexMappings> ] ?
    )
}

<FloatingRateProcessingDetails> CLOSED {
    (  $<FloatingRateProcessingDetails_tes> (  <rawRate> @linkml:Decimal ;
          <processingParameters> @<FloatingRateProcessingParameters> ? ;
          <processedRate> @linkml:Decimal ;
          <spreadExclusiveRate> @linkml:Decimal
       ) ;
       rdf:type [ <FloatingRateProcessingDetails> ] ?
    )
}

<FloatingRateProcessingParameters> CLOSED {
    (  $<FloatingRateProcessingParameters_tes> (  <initialRate> @<Price> ? ;
          <multiplier> @linkml:Decimal ? ;
          <spread> @linkml:Decimal ? ;
          <treatment> [ <https://w3id.org/lmodel/common-domain-model/RateTreatmentEnum#BondEquivalentYield>
             <https://w3id.org/lmodel/common-domain-model/RateTreatmentEnum#MoneyMarketYield> ] ? ;
          <capRate> @linkml:Decimal ? ;
          <floorRate> @linkml:Decimal ? ;
          <rounding> @<Rounding> ? ;
          <negativeTreatment> [
             <https://w3id.org/lmodel/common-domain-model/NegativeInterestRateTreatmentEnum#NegativeInterestRateMethod>
             <https://w3id.org/lmodel/common-domain-model/NegativeInterestRateTreatmentEnum#ZeroInterestRateMethod>
             <https://w3id.org/lmodel/common-domain-model/NegativeInterestRateTreatmentEnum#ZeroInterestRateExcludingSpreadMethod>
             ] ?
       ) ;
       rdf:type [ <FloatingRateProcessingParameters> ] ?
    )
}

<FloatingRateSettingDetails> CLOSED {
