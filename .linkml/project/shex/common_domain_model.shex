<AssetDeliveryPeriods>  (
    CLOSED {
       (  $<AssetDeliveryPeriods_tes> (  <startDate> @linkml:Date ? ;
             <endDate> @linkml:Date ? ;
             <profile> @<AssetDeliveryProfile> *
          ) ;
          rdf:type [ <AssetDeliveryPeriods> ] ?
       )
    } OR @<CalculationScheduleDeliveryPeriods>
)

<AssetDeliveryProfile> CLOSED {
    (  $<AssetDeliveryProfile_tes> (  <loadType> [ <https://w3id.org/lmodel/common-domain-model/LoadTypeEnum#BaseLoad>
             <https://w3id.org/lmodel/common-domain-model/LoadTypeEnum#PeakLoad>
             <https://w3id.org/lmodel/common-domain-model/LoadTypeEnum#OffPeak>
             <https://w3id.org/lmodel/common-domain-model/LoadTypeEnum#BlockHours>
             <https://w3id.org/lmodel/common-domain-model/LoadTypeEnum#Shaped>
             <https://w3id.org/lmodel/common-domain-model/LoadTypeEnum#GasDay>
             <https://w3id.org/lmodel/common-domain-model/LoadTypeEnum#Other> ] ? ;
          <block> @<AssetDeliveryProfileBlock> * ;
          <bankHolidaysTreatment> [ <https://w3id.org/lmodel/common-domain-model/BankHolidayTreatmentEnum#AsWeekday>
             <https://w3id.org/lmodel/common-domain-model/BankHolidayTreatmentEnum#AsWeekend> ] ?
       ) ;
       rdf:type [ <AssetDeliveryProfile> ] ?
    )
}

<AssetDeliveryProfileBlock> CLOSED {
    (  $<AssetDeliveryProfileBlock_tes> (  <startTime> @linkml:Time ? ;
          <endTime> @linkml:Time ? ;
          <dayOfWeek> [ <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#MON>
             <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#TUE>
             <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#WED>
             <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#THU>
             <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#FRI>
             <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#SAT>
             <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#SUN> ] * ;
          <deliveryCapacity> @<Quantity> ? ;
          <priceTimeIntervalQuantity> @<Price> ?
       ) ;
       rdf:type [ <AssetDeliveryProfileBlock> ] ?
    )
}

