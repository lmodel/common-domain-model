<ValuationDate> CLOSED {
    (  $<ValuationDate_tes> (  <singleValuationDate> @<SingleValuationDate> ? ;
          <multipleValuationDates> @<MultipleValuationDates> ? ;
          <valuationDate> @<RelativeDateOffset> ? ;
          <fxFixingDate> @<FxFixingDate> ? ;
          <fxFixingSchedule> @<AdjustableDates> ?
       ) ;
       rdf:type [ <ValuationDate> ] ?
    )
}

<ValuationDates> CLOSED {
    (  $<ValuationDates_tes> (  <initialValuationDate> @<PerformanceValuationDates> ? ;
          <interimValuationDate> @<PerformanceValuationDates> ? ;
          <finalValuationDate> @<PerformanceValuationDates>
       ) ;
       rdf:type [ <ValuationDates> ] ?
    )
}

<ValuationInstruction> CLOSED {
    (  $<ValuationInstruction_tes> (  <valuation> @<Valuation> + ;
          <replace> @linkml:Boolean
       ) ;
       rdf:type [ <ValuationInstruction> ] ?
    )
}

<ValuationMethod> CLOSED {
    (  $<ValuationMethod_tes> (  <valuationSource> @<ValuationSource> ;
          <quotationMethod> [ <https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum#Bid>
             <https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum#Ask>
             <https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum#Mid>
             <https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum#ExercisingPartyPays> ] ? ;
