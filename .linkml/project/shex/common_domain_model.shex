          <netPostedAndHeldInterest> @linkml:Boolean ;
          <netInterestWithMarginCalls> @linkml:Boolean ;
          <includeAccrualInMarginCalc> @linkml:Boolean ;
          <accrueInterestOnUnsettledInterest> @linkml:Boolean ? ;
          <onFullReturn> @linkml:Boolean ;
