          <alternativeProvision> @linkml:String ? ;
          <cutoffTime> @linkml:Time ? ;
          <notification> @<CollateralInterestNotification> ?
       ) ;
       rdf:type [ <CollateralInterestHandlingParameters> ] ?
    )
}

<CollateralInterestNotification> CLOSED {
    (  $<CollateralInterestNotification_tes> (  <trigger> @linkml:String ;
          <offset> @linkml:Decimal ;
