             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA2022VerifiedCarbonCredit>
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA2023DigitalAssetDerivatives> ] * ;
          <contractualTermsSupplement> @<ContractualTermsSupplement> * ;
          <contractualMatrix> @<ContractualMatrix> * ;
          <masterAgreementType> [ <https://w3id.org/lmodel/common-domain-model/MasterAgreementTypeEnum#AFB>
             <https://w3id.org/lmodel/common-domain-model/MasterAgreementTypeEnum#Bespoke>
             <https://w3id.org/lmodel/common-domain-model/MasterAgreementTypeEnum#CMA>
             <https://w3id.org/lmodel/common-domain-model/MasterAgreementTypeEnum#CMOF>
             <https://w3id.org/lmodel/common-domain-model/MasterAgreementTypeEnum#CCPClearingConditions>
