<AgreementPrimitiveInstruction> CLOSED {
    (  $<AgreementPrimitiveInstruction_tes> (  <termsChange> @<AgreementTermsChangeInstruction> ? ;
          <partyChange> @<PartyChangeInstruction> ?
       ) ;
       rdf:type [ <AgreementPrimitiveInstruction> ] ?
    )
}

<AgreementTerms> CLOSED {
    (  $<AgreementTerms_tes> (  <agreement> @<Agreement> ;
          <clauseLibrary> @linkml:Boolean ? ;
          <counterparty> @<Counterparty> +
       ) ;
       rdf:type [ <AgreementTerms> ] ?
