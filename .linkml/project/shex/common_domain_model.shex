<StandardizedScheduleInitialMargin> CLOSED {
    (  $<StandardizedScheduleInitialMargin_tes> (  <tradeInfo> @<StandardizedScheduleTradeInfo> * ;
          <netInitialMargin> @<Money>
       ) ;
       rdf:type [ <StandardizedScheduleInitialMargin> ] ?
    )
}

