<UnscheduledTransfer> CLOSED {
    (  $<UnscheduledTransfer_tes> (  &<TransferBase_tes> ;
          rdf:type [ <TransferBase> ] ? ;
          <transferType> [ <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Recall>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Return>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Assignment>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#BrokerageCommission>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Increase>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Novation>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#PartialTermination>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Premium>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Renegotiation>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Termination>
             <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Upfront> ] ?
       ) ;
       rdf:type [ <UnscheduledTransfer> ] ?
    )
}

<Valuation> CLOSED {
    (  $<Valuation_tes> (  <timestamp> @linkml:Datetime ;
          <source> [ <https://w3id.org/lmodel/common-domain-model/ValuationSourceEnum#CentralCounterparty> ] ? ;
          <amount> @<Money> ;
          <method> [ <https://w3id.org/lmodel/common-domain-model/ValuationTypeEnum#MarkToMarket>
             <https://w3id.org/lmodel/common-domain-model/ValuationTypeEnum#MarkToModel> ] ? ;
          <scope> [ <https://w3id.org/lmodel/common-domain-model/ValuationScopeEnum#Collateral>
             <https://w3id.org/lmodel/common-domain-model/ValuationScopeEnum#Trade> ] ;
          <delta> @linkml:Decimal ? ;
          <valuationTiming> [ <https://w3id.org/lmodel/common-domain-model/PriceTimingEnum#ClosingPrice>
             <https://w3id.org/lmodel/common-domain-model/PriceTimingEnum#OpeningPrice> ] ? ;
          <priceComponent> @<Price> ?
       ) ;
       rdf:type [ <Valuation> ] ?
    )
}

<ValuationAgent> CLOSED {
    (  $<ValuationAgent_tes> (  <party> [
             <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party%201>
             <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party%202>
             <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party%20Making%20the%20Demand> ] ? ;
          <valuationAgent> [ <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SoleValuationAgent>
             <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SwitchUponDefault>
             <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SwitchUponFailureToPerform>
             <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#FixedPartyForDisputes> ] * ;
          <additionalLanguage> @linkml:String ?
       ) ;
       rdf:type [ <ValuationAgent> ] ?
    )
}

<ValuationCalculationDateLocation> CLOSED {
    (  $<ValuationCalculationDateLocation_tes> <partyElection> @<ValuationCalculationDateLocationElection> + ;
