<Taxonomy>  (
    CLOSED {
       (  $<Taxonomy_tes> (  <source> [ <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#CFI>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#ISDA>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#ICAD>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#EMIR>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#EU_EMIR_EligibleCollateralAssetClass>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#UK_EMIR_EligibleCollateralAssetClass>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#CFTC>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#US_CFTC_PR_EligibleCollateralAssetClass>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#MAS>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#CSA>
                <https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum#Other> ] ? ;
             <value> @<TaxonomyValue> ? ;
             <calculated> @linkml:Boolean ?
          ) ;
          rdf:type [ <Taxonomy> ] ?
       )
    } OR @<ProductTaxonomy>
)

<TaxonomyClassification> CLOSED {
    (  $<TaxonomyClassification_tes> (  <description> @linkml:String ? ;
          <className> @linkml:String ? ;
          <value> @linkml:String ;
          <ordinal> @linkml:Integer ?
       ) ;
       rdf:type [ <TaxonomyClassification> ] ?
    )
}

<TaxonomyValue> CLOSED {
    (  $<TaxonomyValue_tes> (  <name> @linkml:String ? ;
          <classification> @<TaxonomyClassification> *
       ) ;
       rdf:type [ <TaxonomyValue> ] ?
    )
}

<TelephoneNumber> CLOSED {
    (  $<TelephoneNumber_tes> (  <telephoneNumberType> [ <https://w3id.org/lmodel/common-domain-model/TelephoneTypeEnum#Work>
             <https://w3id.org/lmodel/common-domain-model/TelephoneTypeEnum#Mobile>
             <https://w3id.org/lmodel/common-domain-model/TelephoneTypeEnum#Fax>
             <https://w3id.org/lmodel/common-domain-model/TelephoneTypeEnum#Personal> ] ? ;
          <number> @linkml:String
       ) ;
       rdf:type [ <TelephoneNumber> ] ?
    )
}

<TerminationCurrency> CLOSED {
    (  $<TerminationCurrency_tes> (  <statedTerminationCurrency> @<TerminationCurrencySelection> ? ;
          <partyOptionTerminationCurrency> @<PartyOptionTerminationCurrency> ?
       ) ;
       rdf:type [ <TerminationCurrency> ] ?
    )
}

<TerminationCurrencyAmendment> CLOSED {
    (  $<TerminationCurrencyAmendment_tes> (  <isApplicable> @linkml:Boolean ;
          <effectiveDate> @<AmendmentEffectiveDate> ? ;
          <partyElection> @<TerminationCurrencyElection> *
       ) ;
       rdf:type [ <TerminationCurrencyAmendment> ] ?
    )
}

<TerminationCurrencyElection> CLOSED {
    (  $<TerminationCurrencyElection_tes> (  <party> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] + ;
          <isSpecified> @linkml:Boolean ;
          <currency> @linkml:String ?
       ) ;
       rdf:type [ <TerminationCurrencyElection> ] ?
    )
}

<TerminationCurrencySelection> CLOSED {
    (  $<TerminationCurrencySelection_tes> (  <statedCurrency> @linkml:String ? ;
          <fallbackCurrency> @linkml:String ? ;
          <partyElection> @<PartyTerminationCurrencySelection> * ;
          <bothAffected> @linkml:String ?
       ) ;
       rdf:type [ <TerminationCurrencySelection> ] ?
    )
}

<TerminationProvision> CLOSED {
    (  $<TerminationProvision_tes> (  <cancelableProvision> @<CancelableProvision> ? ;
          <earlyTerminationProvision> @<EarlyTerminationProvision> ? ;
          <evergreenProvision> @<EvergreenProvision> ? ;
          <extendibleProvision> @<ExtendibleProvision> ? ;
          <recallProvision> @<RecallProvision> ?
       ) ;
       rdf:type [ <TerminationProvision> ] ?
    )
}

<TermsChangeInstruction> CLOSED {
    (  $<TermsChangeInstruction_tes> (  <product> @<NonTransferableProduct> ? ;
          <ancillaryParty> @<AncillaryParty> * ;
          <adjustment> [ <https://w3id.org/lmodel/common-domain-model/NotionalAdjustmentEnum#Execution>
             <https://w3id.org/lmodel/common-domain-model/NotionalAdjustmentEnum#PortfolioRebalancing>
             <https://w3id.org/lmodel/common-domain-model/NotionalAdjustmentEnum#Standard> ] ?
       ) ;
       rdf:type [ <TermsChangeInstruction> ] ?
    )
}

<Threshold> CLOSED {
    (  $<Threshold_tes> <partyElection> @<ThresholdElection> + ;
       rdf:type [ <Threshold> ] ?
    )
}

<ThresholdElection> CLOSED {
    (  $<ThresholdElection_tes> (  <party> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] ;
          <fixedAmount> @<ThresholdMinimumTransferAmountFixedAmount> ? ;
          <ratingsBased> @<ThresholdRatingsBased> ? ;
          <infinity> @linkml:Boolean ? ;
          <other> @linkml:String ?
       ) ;
       rdf:type [ <ThresholdElection> ] ?
    )
}

<ThresholdMinimumTransferAmountBase>  (
    CLOSED {
       (  $<ThresholdMinimumTransferAmountBase_tes> (  <zeroEvent> @linkml:Boolean ;
             <event> [ <https://w3id.org/lmodel/common-domain-model/ZeroEventEnum#EventOfDefault>
                <https://w3id.org/lmodel/common-domain-model/ZeroEventEnum#TerminationEvent>
                <https://w3id.org/lmodel/common-domain-model/ZeroEventEnum#A%20Termination%20Event%20in%20respect%20of%20which%20all%20Transactions%20are%20Affected%20Transactions>
                <https://w3id.org/lmodel/common-domain-model/ZeroEventEnum#PotentialEventOfDefault>
                <https://w3id.org/lmodel/common-domain-model/ZeroEventEnum#AdditionalTerminationEvent>
                <https://w3id.org/lmodel/common-domain-model/ZeroEventEnum#Other> ] *
          ) ;
          rdf:type [ <ThresholdMinimumTransferAmountBase> ] ?
       )
    } OR @<MinimumTransferAmountRatingsBased> OR @<ThresholdMinimumTransferAmountFixedAmount> OR @<ThresholdRatingsBased>
)

<ThresholdMinimumTransferAmountFixedAmount> CLOSED {
    (  $<ThresholdMinimumTransferAmountFixedAmount_tes> (  &<ThresholdMinimumTransferAmountBase_tes> ;
          rdf:type [ <ThresholdMinimumTransferAmountBase> ] ? ;
          <amount> @<Money>
       ) ;
       rdf:type [ <ThresholdMinimumTransferAmountFixedAmount> ] ?
    )
}

