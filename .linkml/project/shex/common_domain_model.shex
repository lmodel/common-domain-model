          rdf:type [ <RateSchedule> ] ? ;
          <spreadScheduleType> [ <https://w3id.org/lmodel/common-domain-model/SpreadScheduleTypeEnum#Long>
             <https://w3id.org/lmodel/common-domain-model/SpreadScheduleTypeEnum#Short> ] ?
       ) ;
       rdf:type [ <SpreadSchedule> ] ?
    )
}

