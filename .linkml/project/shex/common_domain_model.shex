<VarianceCapFloor> CLOSED {
    (  $<VarianceCapFloor_tes> (  <varianceCap> @linkml:Boolean ;
          <unadjustedVarianceCap> @linkml:Decimal ? ;
          <boundedVariance> @<BoundedVariance> ?
       ) ;
       rdf:type [ <VarianceCapFloor> ] ?
    )
}

<VarianceReturnTerms> CLOSED {
    (  $<VarianceReturnTerms_tes> (  &<ReturnTermsBase_tes> ;
          rdf:type [ <ReturnTermsBase> ] ? ;
          <varianceStrikePrice> @<Price> ? ;
          <volatilityStrikePrice> @<Price> ? ;
          <varianceCapFloor> @<VarianceCapFloor> ? ;
          <volatilityCapFloor> @<VolatilityCapFloor> ? ;
          <vegaNotionalAmount> @<NonNegativeQuantitySchedule> ? ;
          <exchangeTradedContractNearest> @<Observable> ?
       ) ;
       rdf:type [ <VarianceReturnTerms> ] ?
    )
}

<Velocity> CLOSED {
    (  $<Velocity_tes> (  <periodMultiplier> @linkml:Integer ? ;
          <period> [ <https://w3id.org/lmodel/common-domain-model/PeriodTimeEnum#Hour>
             <https://w3id.org/lmodel/common-domain-model/PeriodTimeEnum#Minute>
             <https://w3id.org/lmodel/common-domain-model/PeriodTimeEnum#Second> ] ?
       ) ;
       rdf:type [ <Velocity> ] ?
    )
}

<VolatilityCapFloor> CLOSED {
    (  $<VolatilityCapFloor_tes> (  <applicable> @linkml:Boolean ;
          <totalVolatilityCap> @linkml:Decimal ? ;
          <volatilityCapFactor> @linkml:Decimal ?
       ) ;
       rdf:type [ <VolatilityCapFloor> ] ?
    )
}

<VolatilityReturnTerms> CLOSED {
    (  $<VolatilityReturnTerms_tes> (  &<ReturnTermsBase_tes> ;
          rdf:type [ <ReturnTermsBase> ] ? ;
          <volatilityStrikePrice> @<Price> ;
          <volatilityCapFloor> @<VolatilityCapFloor> ? ;
          <exchangeTradedContractNearest> @<ListedDerivative> ?
       ) ;
       rdf:type [ <VolatilityReturnTerms> ] ?
    )
}

<WeightedAveragingObservation> CLOSED {
    (  $<WeightedAveragingObservation_tes> (  <dateTime> @linkml:Datetime ? ;
          <observationNumber> @linkml:Integer ? ;
          <weight> @linkml:Decimal
       ) ;
       rdf:type [ <WeightedAveragingObservation> ] ?
    )
}

<Workflow> CLOSED {
    (  $<Workflow_tes> <steps> @<WorkflowStep> + ;
       rdf:type [ <Workflow> ] ?
    )
}

<WorkflowState> CLOSED {
    (  $<WorkflowState_tes> (  <workflowStatus> [ <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Accepted>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Alleged>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Amended>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Cancelled>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Certain>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Cleared>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Pending>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Rejected>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Submitted>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Terminated>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Uncertain>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Unconfirmed>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Affirmed>
             <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Confirmed> ] ;
          <comment> @linkml:String ? ;
          <partyCustomisedWorkflow> @<PartyCustomisedWorkflow> * ;
          <warehouseIdentity> [ <https://w3id.org/lmodel/common-domain-model/WarehouseIdentityEnum#DTCC_TIW_Gold> ] ?
       ) ;
       rdf:type [ <WorkflowState> ] ?
    )
}

<WorkflowStep> CLOSED {
    (  $<WorkflowStep_tes> (  <timestamp> @<EventTimestamp> + ;
          <businessEvent> @<BusinessEvent> ? ;
          <counterpartyPositionBusinessEvent> @<CounterpartyPositionBusinessEvent> ? ;
          <proposedEvent> @<EventInstruction> ? ;
          <rejected> @linkml:Boolean ? ;
          <approval> @<WorkflowStepApproval> * ;
          <previousWorkflowStep> @<WorkflowStep> ? ;
          <nextEvent> @<EventInstruction> ? ;
          <messageInformation> @<MessageInformation> ? ;
          <eventIdentifier> @<Identifier> + ;
          <action> [ <https://w3id.org/lmodel/common-domain-model/ActionEnum#New>
             <https://w3id.org/lmodel/common-domain-model/ActionEnum#Correct>
             <https://w3id.org/lmodel/common-domain-model/ActionEnum#Cancel> ] ? ;
          <party> @<Party> * ;
          <account> @<Account> * ;
          <creditLimitInformation> @<CreditLimitInformation> ? ;
          <workflowState> @<WorkflowState> ?
       ) ;
       rdf:type [ <WorkflowStep> ] ?
    )
}

<WorkflowStepApproval> CLOSED {
    (  $<WorkflowStepApproval_tes> (  <timestamp> @<EventTimestamp> ;
          <approved> @linkml:Boolean ;
          <party> @<Party> ;
          <rejectedReason> @linkml:String ?
       ) ;
       rdf:type [ <WorkflowStepApproval> ] ?
    )
}
