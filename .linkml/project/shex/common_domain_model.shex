<Basket> CLOSED {
    (  $<Basket_tes> (  &<AssetBase_tes> ;
          rdf:type [ <AssetBase> ] ? ;
          <basketConstituent> @<BasketConstituent> +
       ) ;
       rdf:type [ <Basket> ] ?
    )
}

<BasketConstituent> CLOSED {
    (  $<BasketConstituent_tes> (  <observable> @<Observable> ;
          <quantity> @<NonNegativeQuantitySchedule> * ;
          <initialValuationPrice> @<PriceSchedule> * ;
          <interimValuationPrice> @<PriceSchedule> * ;
          <finalValuationPrice> @<PriceSchedule> *
       ) ;
       rdf:type [ <BasketConstituent> ] ?
    )
}

<BasketReferenceInformation> CLOSED {
    (  $<BasketReferenceInformation_tes> (  <basketName> @linkml:String ? ;
          <basketId> @linkml:String * ;
          <referencePool> @<ReferencePool> ;
          <nthToDefault> @linkml:Integer ? ;
          <mthToDefault> @linkml:Integer ? ;
          <tranche> @<Tranche> ?
       ) ;
       rdf:type [ <BasketReferenceInformation> ] ?
    )
}

<BespokeCalculationDate> CLOSED {
