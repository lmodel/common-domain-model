# metamodel_version: 1.12.0
# version: 8.0.0-dev.13
BASE <https://w3id.org/lmodel/common-domain-model/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<NonNegativeNumber> <NonNegativeNumber>

<FpMLCodingScheme> <FpMLCodingScheme>

<Account> CLOSED {
    (  $<Account_tes> (  <partyReference> @<Party> ? ;
          <accountNumber> @linkml:String ;
          <accountName> @linkml:String ? ;
          <accountType> [ <https://w3id.org/lmodel/common-domain-model/AccountTypeEnum#AggregateClient>
             <https://w3id.org/lmodel/common-domain-model/AccountTypeEnum#Client>
             <https://w3id.org/lmodel/common-domain-model/AccountTypeEnum#House> ] ? ;
          <accountBeneficiary> @<Party> ? ;
          <servicingParty> @<Party> ?
       ) ;
       rdf:type [ <Account> ] ?
    )
}

<AccrualFactor> CLOSED {
    (  $<AccrualFactor_tes> (  <value> @<PriceSchedule> ;
          <calculationTerms> @<AccrualFactorCalculationTerms> ?
       ) ;
       rdf:type [ <AccrualFactor> ] ?
    )
}

<AccrualFactorCalculationTerms> CLOSED {
    (  $<AccrualFactorCalculationTerms_tes> (  <tenorTillMaturity> @linkml:Decimal ;
          <dayCountFraction> [ <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#ACT/360>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#ACT/365L>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#ACT/364>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#ACT/365.FIXED>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#ACT/ACT.AFB>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#ACT/ACT.ICMA>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#ACT/ACT.ISDA>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#ACT/ACT.ISMA>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#CAL/252>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#1/1>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#30E/360>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#30E/360.ISDA>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#30/360>
             <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum#RBA%20Bond%20Basis> ] ;
          <interpolationTerms> @<StubValue> ?
       ) ;
       rdf:type [ <AccrualFactorCalculationTerms> ] ?
    )
}

<AdditionalDisruptionEvents> CLOSED {
    (  $<AdditionalDisruptionEvents_tes> (  <changeInLaw> @linkml:Boolean ? ;
          <failureToDeliver> @linkml:Boolean ? ;
          <insolvencyFiling> @linkml:Boolean ? ;
          <hedgingDisruption> @linkml:Boolean ? ;
          <increasedCostOfHedging> @linkml:Boolean ? ;
          <foreignOwnershipEvent> @linkml:Boolean ? ;
          <lossOfStockBorrow> @linkml:Boolean ? ;
          <maximumStockLoanRate> @linkml:Decimal ? ;
          <increasedCostOfStockBorrow> @linkml:Boolean ? ;
          <initialStockLoanRate> @linkml:Decimal ? ;
          <determiningParty> [ <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#DisruptionEventsDeterminingParty>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#ExtraordinaryDividendsParty>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#PredeterminedClearingOrganizationParty>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#ExerciseNoticeReceiverPartyManual>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#ExerciseNoticeReceiverPartyOptionalEarlyTermination>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#ExerciseNoticeReceiverPartyCancelableProvision>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#ExerciseNoticeReceiverPartyExtendibleProvision>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#CalculationAgentIndependent>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#CalculationAgentOptionalEarlyTermination>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#CalculationAgentMandatoryEarlyTermination>
             <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum#CalculationAgentFallback> ] ? ;
          <additionalBespokeTerms> @<Clause> *
       ) ;
       rdf:type [ <AdditionalDisruptionEvents> ] ?
    )
}

<AdditionalFixedPayments> CLOSED {
    (  $<AdditionalFixedPayments_tes> (  <interestShortfallReimbursement> @linkml:Boolean ? ;
          <principalShortfallReimbursement> @linkml:Boolean ? ;
          <writedownReimbursement> @linkml:Boolean ?
       ) ;
       rdf:type [ <AdditionalFixedPayments> ] ?
    )
}

<AdditionalObligations> CLOSED {
    (  $<AdditionalObligations_tes> (  <party> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] ;
          <additionalObligations> @linkml:String
       ) ;
       rdf:type [ <AdditionalObligations> ] ?
    )
}

<AdditionalRepresentation> CLOSED {
    (  $<AdditionalRepresentation_tes> (  <partyElection> @<AdditionalRepresentationElection> + ;
          <customElection> @linkml:String ?
       ) ;
       rdf:type [ <AdditionalRepresentation> ] ?
    )
}

<AdditionalRepresentationElection> CLOSED {
    (  $<AdditionalRepresentationElection_tes> (  <party> [
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] ;
          <isApplicable> @linkml:Boolean ;
          <additionalLanguage> @linkml:String ?
       ) ;
       rdf:type [ <AdditionalRepresentationElection> ] ?
    )
}

<AdditionalRepresentations> CLOSED {
    (  $<AdditionalRepresentations_tes> (  <additionalRepresentation> @<AdditionalRepresentation> ? ;
          <regulatoryComplianceRepresentation> @linkml:Boolean ?
       ) ;
       rdf:type [ <AdditionalRepresentations> ] ?
    )
}

<AdditionalRightsEvent> CLOSED {
    (  $<AdditionalRightsEvent_tes> (  <isApplicable> @linkml:Boolean ;
          <qualification> @linkml:String ?
       ) ;
       rdf:type [ <AdditionalRightsEvent> ] ?
    )
}

<AdditionalTerminationEventElection> CLOSED {
    (  $<AdditionalTerminationEventElection_tes> (  <party> [
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] ;
          <isApplicable> @linkml:Boolean ;
          <furtherDetails> @linkml:String ?
       ) ;
       rdf:type [ <AdditionalTerminationEventElection> ] ?
    )
}

<AdditionalType> CLOSED {
    (  $<AdditionalType_tes> (  <standardValue> [ <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#NotApplicable>
             <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#EquityOptionOrIndexOption>
             <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#Other> ] ;
          <customValue> @linkml:String ?
       ) ;
       rdf:type [ <AdditionalType> ] ?
    )
}

<Address> CLOSED {
    (  $<Address_tes> (  <street> @linkml:String + ;
          <city> @linkml:String ? ;
          <state> @linkml:String ? ;
          <country> @linkml:String ? ;
          <postalCode> @linkml:String ?
       ) ;
       rdf:type [ <Address> ] ?
    )
}

<AddressesForTransfer> CLOSED {
    (  $<AddressesForTransfer_tes> <partyElection> @<TransferInformationElection> + ;
       rdf:type [ <AddressesForTransfer> ] ?
    )
}

<AdjustableDate> CLOSED {
    (  $<AdjustableDate_tes> (  <unadjustedDate> @linkml:Date ? ;
          <dateAdjustments> @<BusinessDayAdjustments> ? ;
          <dateAdjustmentsReference> @<BusinessDayAdjustments> ? ;
          <adjustedDate> @linkml:Date ?
       ) ;
       rdf:type [ <AdjustableDate> ] ?
    )
}

<AdjustableDates> CLOSED {
    (  $<AdjustableDates_tes> (  <unadjustedDate> @linkml:Date * ;
          <dateAdjustments> @<BusinessDayAdjustments> ? ;
          <adjustedDate> @linkml:Date *
       ) ;
       rdf:type [ <AdjustableDates> ] ?
    )
}

<AdjustableOrAdjustedDate> CLOSED {
    (  $<AdjustableOrAdjustedDate_tes> (  <unadjustedDate> @linkml:Date ? ;
          <dateAdjustments> @<BusinessDayAdjustments> ? ;
          <adjustedDate> @linkml:Date ?
       ) ;
       rdf:type [ <AdjustableOrAdjustedDate> ] ?
    )
}

<AdjustableOrAdjustedOrRelativeDate> CLOSED {
    (  $<AdjustableOrAdjustedOrRelativeDate_tes> (  <unadjustedDate> @linkml:Date ? ;
          <dateAdjustments> @<BusinessDayAdjustments> ? ;
          <adjustedDate> @linkml:Date ? ;
          <relativeDate> @<RelativeDateOffset> ?
       ) ;
       rdf:type [ <AdjustableOrAdjustedOrRelativeDate> ] ?
    )
}

<AdjustableOrRelativeDate> CLOSED {
    (  $<AdjustableOrRelativeDate_tes> (  <adjustableDate> @<AdjustableDate> ? ;
          <relativeDate> @<AdjustedRelativeDateOffset> ?
       ) ;
       rdf:type [ <AdjustableOrRelativeDate> ] ?
    )
}

<AdjustableOrRelativeDates> CLOSED {
    (  $<AdjustableOrRelativeDates_tes> (  <adjustableDates> @<AdjustableDates> ? ;
          <relativeDates> @<RelativeDates> ?
       ) ;
       rdf:type [ <AdjustableOrRelativeDates> ] ?
    )
}

<AdjustableRelativeOrPeriodicDates> CLOSED {
    (  $<AdjustableRelativeOrPeriodicDates_tes> (  <adjustableDates> @<AdjustableDates> ? ;
          <relativeDates> @<RelativeDates> ? ;
          <periodicDates> @<PeriodicDates> ?
       ) ;
       rdf:type [ <AdjustableRelativeOrPeriodicDates> ] ?
    )
}

<AdjustDateInstruction> CLOSED {
    (  $<AdjustDateInstruction_tes> <adjustedDate> @linkml:Date ;
       rdf:type [ <AdjustDateInstruction> ] ?
    )
}

<AdjustedRelativeDateOffset> CLOSED {
    (  $<AdjustedRelativeDateOffset_tes> (  &<RelativeDateOffset_tes> ;
          rdf:type [ <RelativeDateOffset> ] ? ;
          <relativeDateAdjustments> @<BusinessDayAdjustments> ?
       ) ;
       rdf:type [ <AdjustedRelativeDateOffset> ] ?
    )
}

<AdjustmentFactor> CLOSED {
    (  $<AdjustmentFactor_tes> (  <value> @linkml:Decimal ;
          <calculationTerms> @<AdjustmentFactorCalculationTerms> ?
       ) ;
       rdf:type [ <AdjustmentFactor> ] ?
    )
}

<AdjustmentFactorCalculationTerms> CLOSED {
    (  $<AdjustmentFactorCalculationTerms_tes> (  <shareForShareRatio> @linkml:Decimal ? ;
          <shareForRightsRatio> @linkml:Decimal ? ;
          <rightsSubscriptionPrice> @<Price> ? ;
          <dividendRatio> @linkml:Decimal ? ;
          <spinOff> @<SpinOff> ? ;
          <merger> @<Merger> ? ;
          <accrualFactor> @<AccrualFactor> ? ;
          <lastFixingPriceBeforeAdjustment> @<Price> ? ;
          <dividendObservation> @<PriceSchedule> ? ;
          <bespokeCalculationFormula> @linkml:String ?
       ) ;
       rdf:type [ <AdjustmentFactorCalculationTerms> ] ?
    )
}

<AdjustObservationDatesInstruction> CLOSED {
    (  $<AdjustObservationDatesInstruction_tes> <adjustedObservationDates> @linkml:Date + ;
       rdf:type [ <AdjustObservationDatesInstruction> ] ?
    )
}

<AdjustPeriodInstruction> CLOSED {
    (  $<AdjustPeriodInstruction_tes> <adjustedPeriod> @<CalculationPeriodBase> ;
       rdf:type [ <AdjustPeriodInstruction> ] ?
    )
}

<AgencyRatingCriteria> CLOSED {
    (  $<AgencyRatingCriteria_tes> (  <creditNotation> @<CreditNotation> ;
          <mismatchResolution> [ <https://w3id.org/lmodel/common-domain-model/CreditNotationMismatchResolutionEnum#Lowest>
             <https://w3id.org/lmodel/common-domain-model/CreditNotationMismatchResolutionEnum#Highest>
             <https://w3id.org/lmodel/common-domain-model/CreditNotationMismatchResolutionEnum#ReferenceAgency>
             <https://w3id.org/lmodel/common-domain-model/CreditNotationMismatchResolutionEnum#Average>
             <https://w3id.org/lmodel/common-domain-model/CreditNotationMismatchResolutionEnum#SecondBest>
             <https://w3id.org/lmodel/common-domain-model/CreditNotationMismatchResolutionEnum#Other> ] ? ;
          <referenceAgency> [ <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum#AMBest>
             <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum#CBRS>
             <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum#DBRS>
             <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum#Fitch>
             <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum#Japanagency>
             <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum#Moodys>
             <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum#RatingAndInvestmentInformation>
             <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum#StandardAndPoors> ] ? ;
          <boundary> [ <https://w3id.org/lmodel/common-domain-model/CreditNotationBoundaryEnum#Minimum>
             <https://w3id.org/lmodel/common-domain-model/CreditNotationBoundaryEnum#Maximum> ] ?
       ) ;
       rdf:type [ <AgencyRatingCriteria> ] ?
    )
}

<Aggregation> CLOSED {
    (  $<Aggregation_tes> (  <aggregationType> [
             <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#Aggregated>
             <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#LoanByLoan>
             <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#AggregatedAndLoanByLoan>
             <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#NotSpecified> ] ;
          <loansCanBeGrouped> @linkml:Boolean ;
          <otherDetails> @linkml:String ?
       ) ;
       rdf:type [ <Aggregation> ] ?
    )
}

<AggregationParameters> CLOSED {
    (  $<AggregationParameters_tes> (  <dateTime> @linkml:Datetime ;
          <totalPosition> @linkml:Boolean ? ;
          <positionStatus> [ <https://w3id.org/lmodel/common-domain-model/PositionStatusEnum#Executed>
             <https://w3id.org/lmodel/common-domain-model/PositionStatusEnum#Formed>
             <https://w3id.org/lmodel/common-domain-model/PositionStatusEnum#Settled>
             <https://w3id.org/lmodel/common-domain-model/PositionStatusEnum#Cancelled>
             <https://w3id.org/lmodel/common-domain-model/PositionStatusEnum#Closed> ] ? ;
          <party> @<Party> * ;
          <product> @<NonTransferableProduct> * ;
          <productQualifier> @linkml:String * ;
          <tradeReference> @<Trade> *
       ) ;
       rdf:type [ <AggregationParameters> ] ?
    )
}

<Agreement> CLOSED {
    (  $<Agreement_tes> (  <creditSupportAgreementElections> @<CreditSupportAgreementElections> ? ;
          <collateralTransferAgreementElections> @<CollateralTransferAgreementElections> ? ;
          <securityAgreementElections> @<SecurityAgreementElections> ? ;
          <clauseLibrarySchedule> @<ClauseLibrarySchedule> ? ;
          <transactionAdditionalTerms> @<TransactionAdditionalTerms> ? ;
          <masterAgreementElections> @<MasterAgreementElections> ?
       ) ;
       rdf:type [ <Agreement> ] ?
    )
}

<AgreementEvent> CLOSED {
    (  $<AgreementEvent_tes> (  &<AgreementEventInstruction_tes> ;
          rdf:type [ <AgreementEventInstruction> ] ? ;
          <eventQualifier> @linkml:String ? ;
          <after> @<LegalAgreement> *
       ) ;
       rdf:type [ <AgreementEvent> ] ?
    )
}

<AgreementEventInstruction>  (
    CLOSED {
       (  $<AgreementEventInstruction_tes> (  <eventDate> @linkml:Date ;
             <effectiveDate> @linkml:Date ;
             <instruction> @<AgreementInstruction> * ;
             <intent> [ <https://w3id.org/lmodel/common-domain-model/AgreementEventIntentEnum#AmendedTerms>
                <https://w3id.org/lmodel/common-domain-model/AgreementEventIntentEnum#AmendedParties>
                <https://w3id.org/lmodel/common-domain-model/AgreementEventIntentEnum#Termination>
                <https://w3id.org/lmodel/common-domain-model/AgreementEventIntentEnum#AmendedAndRestated>
                <https://w3id.org/lmodel/common-domain-model/AgreementEventIntentEnum#Novation>
                <https://w3id.org/lmodel/common-domain-model/AgreementEventIntentEnum#Superseded> ] *
          ) ;
          rdf:type [ <AgreementEventInstruction> ] ?
       )
    } OR @<AgreementEvent>
)

<AgreementInstruction> CLOSED {
    (  $<AgreementInstruction_tes> (  <primitiveInstruction> @<AgreementPrimitiveInstruction> * ;
          <before> @<LegalAgreement> ?
       ) ;
       rdf:type [ <AgreementInstruction> ] ?
    )
}

<AgreementName> CLOSED {
    (  $<AgreementName_tes> (  <agreementType> [
             <https://w3id.org/lmodel/common-domain-model/LegalAgreementTypeEnum#BrokerConfirmation>
             <https://w3id.org/lmodel/common-domain-model/LegalAgreementTypeEnum#Confirmation>
             <https://w3id.org/lmodel/common-domain-model/LegalAgreementTypeEnum#CreditSupportAgreement>
