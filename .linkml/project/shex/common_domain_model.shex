             <https://w3id.org/lmodel/common-domain-model/RoundingDirectionEnum#Nearest> ] ;
          <roundToUnit> [ <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum#Second>
             <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum#Minute>
             <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum#Hour>
             <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum#Day>
             <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum#Week>
             <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum#Month>
             <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum#Year> ] ?
       ) ;
       rdf:type [ <TimeRounding> ] ?
    )
}

<TimeZone> CLOSED {
    (  $<TimeZone_tes> (  <time> @linkml:Time ;
          <location> @linkml:String ?
       ) ;
       rdf:type [ <TimeZone> ] ?
    )
}

<TradableProduct>  (
    CLOSED {
       (  $<TradableProduct_tes> (  <product> @<NonTransferableProduct> ;
             <tradeLot> @<TradeLot> + ;
             <counterparty> @<Counterparty> + ;
             <ancillaryParty> @<AncillaryParty> * ;
             <adjustment> [ <https://w3id.org/lmodel/common-domain-model/NotionalAdjustmentEnum#Execution>
                <https://w3id.org/lmodel/common-domain-model/NotionalAdjustmentEnum#PortfolioRebalancing>
                <https://w3id.org/lmodel/common-domain-model/NotionalAdjustmentEnum#Standard> ] ?
          ) ;
          rdf:type [ <TradableProduct> ] ?
       )
    } OR @<Trade>
)

<Trade> CLOSED {
    (  $<Trade_tes> (  &<TradableProduct_tes> ;
          rdf:type [ <TradableProduct> ] ? ;
          <tradeIdentifier> @<TradeIdentifier> + ;
          <tradeDate> @linkml:Date ;
          <tradeTime> @<TimeZone> ? ;
          <party> @<Party> * ;
          <partyRole> @<PartyRole> * ;
          <executionDetails> @<ExecutionDetails> ? ;
          <contractDetails> @<ContractDetails> ? ;
          <collateral> @<Collateral> ?
       ) ;
       rdf:type [ <Trade> ] ?
    )
}

<TradeIdentifier> CLOSED {
    (  $<TradeIdentifier_tes> (  &<Identifier_tes> ;
          rdf:type [ <Identifier> ] ? ;
          <identifierType> [ <https://w3id.org/lmodel/common-domain-model/TradeIdentifierTypeEnum#UniqueTransactionIdentifier>
             <https://w3id.org/lmodel/common-domain-model/TradeIdentifierTypeEnum#UniqueSwapIdentifier> ] ?
       ) ;
       rdf:type [ <TradeIdentifier> ] ?
    )
}

<TradeLot> CLOSED {
    (  $<TradeLot_tes> (  <lotIdentifier> @<Identifier> * ;
          <priceQuantity> @<PriceQuantity> +
       ) ;
       rdf:type [ <TradeLot> ] ?
    )
}

<TradePricingReport> CLOSED {
    (  $<TradePricingReport_tes> (  <trade> @<Trade> ;
          <pricingTime> @<TimeZone> ;
