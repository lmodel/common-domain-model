       ) ;
       rdf:type [ <FloatingAmountEvents> ] ?
    )
}

<FloatingAmountProvisions> CLOSED {
    (  $<FloatingAmountProvisions_tes> (  <wacCapInterestProvision> @linkml:Boolean ? ;
          <stepUpProvision> @linkml:Boolean ?
       ) ;
       rdf:type [ <FloatingAmountProvisions> ] ?
    )
}

<FloatingRate>  (
    CLOSED {
       (  $<FloatingRate_tes> (  &<FloatingRateBase_tes> ;
             rdf:type [ <FloatingRateBase> ] ? ;
             <floatingRateMultiplierSchedule> @<RateSchedule> ? ;
             <rateTreatment> [ <https://w3id.org/lmodel/common-domain-model/RateTreatmentEnum#BondEquivalentYield>
                <https://w3id.org/lmodel/common-domain-model/RateTreatmentEnum#MoneyMarketYield> ] ? ;
             <calculationParameters> @<FloatingRateCalculationParameters> ? ;
             <fallbackRate> @<FallbackRateParameters> ?
          ) ;
          rdf:type [ <FloatingRate> ] ?
       )
    } OR @<FloatingRateSpecification>
)

<FloatingRateBase>  (
    CLOSED {
       (  $<FloatingRateBase_tes> (  <rateOption> @<InterestRateIndex> ? ;
