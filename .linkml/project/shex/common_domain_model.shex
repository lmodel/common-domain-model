             <https://w3id.org/lmodel/common-domain-model/DayTypeEnum#ExchangeBusiness>
             <https://w3id.org/lmodel/common-domain-model/DayTypeEnum#ScheduledTradingDay> ]
       ) ;
       rdf:type [ <CollateralInterestNotification> ] ?
    )
}

<CollateralInterestParameters> CLOSED {
    (  $<CollateralInterestParameters_tes> (  <postingParty> [
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
