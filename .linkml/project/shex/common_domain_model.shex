             <https://w3id.org/lmodel/common-domain-model/LegalAgreementTypeEnum#SecurityAgreement>
             <https://w3id.org/lmodel/common-domain-model/LegalAgreementTypeEnum#Other> ] ;
          <creditSupportAgreementType> [
             <https://w3id.org/lmodel/common-domain-model/CreditSupportAgreementTypeEnum#CreditSupportDeed>
             <https://w3id.org/lmodel/common-domain-model/CreditSupportAgreementTypeEnum#CreditSupportAnnex>
             <https://w3id.org/lmodel/common-domain-model/CreditSupportAgreementTypeEnum#CollateralTransferAgreement> ] ? ;
          <creditSupportAgreementMarginType> [
             <https://w3id.org/lmodel/common-domain-model/CollateralMarginTypeEnum#VariationMargin>
             <https://w3id.org/lmodel/common-domain-model/CollateralMarginTypeEnum#InitialMargin> ] ? ;
          <contractualDefinitionsType> [
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA1991InterestRate>
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA1993CommodityDerivatives>
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA1996EquityDerivatives>
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA1997Bullion>
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA1997GovernmentBondOption>
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA1998FxAndCurrencyOption>
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA1999CreditDerivatives>
             <https://w3id.org/lmodel/common-domain-model/ContractualDefinitionsEnum#ISDA2000>
