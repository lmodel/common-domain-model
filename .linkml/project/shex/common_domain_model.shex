<ExecutionDetails> CLOSED {
    (  $<ExecutionDetails_tes> (  <executionType> [ <https://w3id.org/lmodel/common-domain-model/ExecutionTypeEnum#Electronic>
             <https://w3id.org/lmodel/common-domain-model/ExecutionTypeEnum#OffFacility>
             <https://w3id.org/lmodel/common-domain-model/ExecutionTypeEnum#OnVenue> ] ;
          <executionVenue> @<LegalEntity> ? ;
          <packageReference> @<IdentifiedList> ?
       ) ;
       rdf:type [ <ExecutionDetails> ] ?
    )
}

<ExecutionInstruction> CLOSED {
    (  $<ExecutionInstruction_tes> (  <product> @<NonTransferableProduct> ;
          <priceQuantity> @<PriceQuantity> + ;
          <counterparty> @<Counterparty> + ;
          <ancillaryParty> @<AncillaryParty> * ;
          <parties> @<Party> + ;
          <partyRoles> @<PartyRole> * ;
          <executionDetails> @<ExecutionDetails> ;
          <tradeDate> @linkml:Date ;
          <tradeTime> @<TimeZone> ? ;
          <tradeIdentifier> @<TradeIdentifier> + ;
          <collateral> @<Collateral> ? ;
          <lotIdentifier> @<Identifier> ?
       ) ;
       rdf:type [ <ExecutionInstruction> ] ?
    )
}

<ExecutionLanguage> CLOSED {
    (  $<ExecutionLanguage_tes> (  <standardLanguage> @linkml:Boolean ;
          <numberOfOriginals> @linkml:String ? ;
          <otherLanguage> @linkml:String ?
       ) ;
       rdf:type [ <ExecutionLanguage> ] ?
    )
}

<ExecutionLocation> CLOSED {
    (  $<ExecutionLocation_tes> (  <executionLocation> [
             <https://w3id.org/lmodel/common-domain-model/ExecutionLocationEnum#ExecutedOutsideBelgium>
             <https://w3id.org/lmodel/common-domain-model/ExecutionLocationEnum#ExecutedInBelgium>
             <https://w3id.org/lmodel/common-domain-model/ExecutionLocationEnum#OtherLocation> ] ;
          <otherLanguage> @linkml:String ? ;
          <dutyPayer> @linkml:String ? ;
          <dutyPayerLanguage> @linkml:String ? ;
          <dutyPaymentDate> @linkml:Date ? ;
          <dutyPaymentLanguage> @linkml:String ?
       ) ;
       rdf:type [ <ExecutionLocation> ] ?
    )
}

<ExecutionTerms> CLOSED {
    (  $<ExecutionTerms_tes> (  <executionLanguage> @<ExecutionLanguage> ;
          <executionLocation> @<ExecutionLocation>
       ) ;
       rdf:type [ <ExecutionTerms> ] ?
    )
}

<ExerciseFee> CLOSED {
    (  $<ExerciseFee_tes> (  &<PayerReceiver_tes> ;
          rdf:type [ <PayerReceiver> ] ? ;
          <notionalReference> @<Money> ;
          <feeAmount> @linkml:Decimal ? ;
          <feeRate> @linkml:Decimal ? ;
          <feePaymentDate> @<RelativeDateOffset>
       ) ;
       rdf:type [ <ExerciseFee> ] ?
    )
}

<ExerciseFeeSchedule> CLOSED {
    (  $<ExerciseFeeSchedule_tes> (  &<PayerReceiver_tes> ;
          rdf:type [ <PayerReceiver> ] ? ;
          <notionalReference> @<Money> ;
          <feeAmountSchedule> @<AmountScheduleWithInitialValue> ? ;
          <feeRateSchedule> @<ScheduleWithInitialValue> ? ;
          <feePaymentDate> @<RelativeDateOffset>
       ) ;
       rdf:type [ <ExerciseFeeSchedule> ] ?
    )
}

<ExerciseInstruction> CLOSED {
    (  $<ExerciseInstruction_tes> (  <exerciseQuantity> @<PrimitiveInstruction> ;
          <exerciseOption> @<Payout> ? ;
          <exerciseDate> @<AdjustableOrAdjustedDate> ? ;
          <exerciseTime> @<BusinessCenterTime> ? ;
          <replacementTradeIdentifier> @<TradeIdentifier> *
       ) ;
       rdf:type [ <ExerciseInstruction> ] ?
    )
}

<ExerciseNotice> CLOSED {
    (  $<ExerciseNotice_tes> (  <exerciseNoticeGiver> [ <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeGiverEnum#Buyer>
