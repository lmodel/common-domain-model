             <https://w3id.org/lmodel/common-domain-model/ValuationMethodEnum#AverageBlendedHighest> ] ? ;
          <quotationAmount> @<Money> ? ;
          <minimumQuotationAmount> @<Money> ? ;
          <cashCollateralValuationMethod> @<CashCollateralValuationMethod> ?
       ) ;
       rdf:type [ <ValuationMethod> ] ?
    )
}

<ValuationPostponement> CLOSED {
    (  $<ValuationPostponement_tes> <maximumDaysOfPostponement> @linkml:Integer ;
       rdf:type [ <ValuationPostponement> ] ?
    )
}

<ValuationSource> CLOSED {
    (  $<ValuationSource_tes> (  <quotedCurrencyPair> @<QuotedCurrencyPair> ? ;
          <informationSource> @<FxSpotRateSource> ? ;
          <settlementRateOption> @<AssetSettlementRateOption> ? ;
          <referenceBanks> @<ReferenceBanks> ? ;
          <dealerOrCCP> @<AncillaryEntity> ?
       ) ;
       rdf:type [ <ValuationSource> ] ?
    )
}

<ValuationTerms> CLOSED {
    (  $<ValuationTerms_tes> (  <futuresPriceValuation> @linkml:Boolean ? ;
          <optionsPriceValuation> @linkml:Boolean ? ;
