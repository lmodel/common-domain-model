<Inventory> CLOSED {
    (  $<Inventory_tes> <inventoryRecord> @<InventoryRecord> * ;
       rdf:type [ <Inventory> ] ?
    )
}

<InventoryRecord>  (
    CLOSED {
       (  $<InventoryRecord_tes> (  <identifier> @<AssignedIdentifier> ;
             <security> @<Security>
          ) ;
          rdf:type [ <InventoryRecord> ] ?
       )
    } OR @<AvailableInventoryRecord>
)

<IsdaAdditionalTerminationEvent> CLOSED {
    (  $<IsdaAdditionalTerminationEvent_tes> <partyElection> @<AdditionalTerminationEventElection> + ;
       rdf:type [ <IsdaAdditionalTerminationEvent> ] ?
    )
}

<IsdaCalculationAgent> CLOSED {
    (  $<IsdaCalculationAgent_tes> (  <asSpecifiedInConfirmation> @linkml:Boolean ;
          <eventOfDefault> @<IsdaCalculationAgentElection> ? ;
          <potentialEventOfDefault> @<IsdaCalculationAgentElection> ? ;
          <terminationEvent> @<IsdaCalculationAgentElection> ? ;
          <noEvent> @<IsdaCalculationAgentElection> ;
          <substituteCalculationAgent> @<SubstituteCalculationAgentElection> ;
          <otherComments> @linkml:String ?
       ) ;
       rdf:type [ <IsdaCalculationAgent> ] ?
    )
}

<IsdaCalculationAgentElection> CLOSED {
    (  $<IsdaCalculationAgentElection_tes> (  <isApplicable> @linkml:Boolean ;
          <agent> [ <https://w3id.org/lmodel/common-domain-model/IsdaMasterCalculationAgentEnum#Party_A>
             <https://w3id.org/lmodel/common-domain-model/IsdaMasterCalculationAgentEnum#Party_B>
             <https://w3id.org/lmodel/common-domain-model/IsdaMasterCalculationAgentEnum#Party_A_Party_B>
             <https://w3id.org/lmodel/common-domain-model/IsdaMasterCalculationAgentEnum#Party_A_Or_Party_B>
             <https://w3id.org/lmodel/common-domain-model/IsdaMasterCalculationAgentEnum#Demands_4c>
             <https://w3id.org/lmodel/common-domain-model/IsdaMasterCalculationAgentEnum#Demands_4d>
             <https://w3id.org/lmodel/common-domain-model/IsdaMasterCalculationAgentEnum#Other> ] ? ;
          <agentIfOther> @linkml:String ?
       ) ;
       rdf:type [ <IsdaCalculationAgentElection> ] ?
