<CalculationPeriod> CLOSED {
    (  $<CalculationPeriod_tes> (  &<CalculationPeriodBase_tes> ;
          rdf:type [ <CalculationPeriodBase> ] ? ;
          <unadjustedStartDate> @linkml:Date ? ;
          <unadjustedEndDate> @linkml:Date ? ;
          <calculationPeriodNumberOfDays> @linkml:Integer ? ;
          <notionalAmount> @linkml:Decimal ? ;
          <fxLinkedNotionalAmount> @<FxLinkedNotionalAmount> ? ;
          <floatingRateDefinition> @<FloatingRateDefinition> ? ;
          <fixedRate> @linkml:Decimal ? ;
          <dayCountYearFraction> @linkml:Decimal ? ;
          <forecastAmount> @<Money> ? ;
          <forecastRate> @linkml:Decimal ?
       ) ;
       rdf:type [ <CalculationPeriod> ] ?
    )
}

<CalculationPeriodBase>  (
    CLOSED {
       (  $<CalculationPeriodBase_tes> (  <adjustedStartDate> @linkml:Date ? ;
             <adjustedEndDate> @linkml:Date ?
          ) ;
          rdf:type [ <CalculationPeriodBase> ] ?
       )
    } OR @<CalculationPeriod>
)

<CalculationPeriodData> CLOSED {
    (  $<CalculationPeriodData_tes> (  <startDate> @linkml:Date ;
          <endDate> @linkml:Date ;
          <daysInPeriod> @linkml:Integer ;
          <daysInLeapYearPeriod> @linkml:Integer ;
          <isFirstPeriod> @linkml:Boolean ;
          <isLastPeriod> @linkml:Boolean
       ) ;
       rdf:type [ <CalculationPeriodData> ] ?
    )
}

<CalculationPeriodDates> CLOSED {
    (  $<CalculationPeriodDates_tes> (  <effectiveDate> @<AdjustableOrRelativeDate> ? ;
          <terminationDate> @<AdjustableOrRelativeDate> ? ;
          <calculationPeriodDatesAdjustments> @<BusinessDayAdjustments> ? ;
          <firstPeriodStartDate> @<AdjustableOrRelativeDate> ? ;
          <firstRegularPeriodStartDate> @linkml:Date ? ;
          <firstCompoundingPeriodEndDate> @linkml:Date ? ;
          <lastRegularPeriodEndDate> @linkml:Date ? ;
          <stubPeriodType> [ <https://w3id.org/lmodel/common-domain-model/StubPeriodTypeEnum#ShortInitial>
             <https://w3id.org/lmodel/common-domain-model/StubPeriodTypeEnum#ShortFinal>
             <https://w3id.org/lmodel/common-domain-model/StubPeriodTypeEnum#LongInitial>
             <https://w3id.org/lmodel/common-domain-model/StubPeriodTypeEnum#LongFinal> ] * ;
          <calculationPeriodFrequency> @<CalculationPeriodFrequency> ?
       ) ;
       rdf:type [ <CalculationPeriodDates> ] ?
    )
}

