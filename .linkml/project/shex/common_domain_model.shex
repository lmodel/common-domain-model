<StubPeriod> CLOSED {
    (  $<StubPeriod_tes> (  <calculationPeriodDatesReference> @<CalculationPeriodDates> ;
          <initialStub> @<StubValue> ? ;
          <finalStub> @<StubValue> ?
       ) ;
       rdf:type [ <StubPeriod> ] ?
    )
}

<StubValue> CLOSED {
    (  $<StubValue_tes> (  <floatingRate> @<StubFloatingRate> * ;
          <stubRate> @linkml:Decimal ? ;
          <stubAmount> @<Money> ?
       ) ;
       rdf:type [ <StubValue> ] ?
    )
}

<SubstituteCalculationAgentElection> CLOSED {
    (  $<SubstituteCalculationAgentElection_tes> (  <methodologyForSubstitutionExists> @linkml:Boolean ;
          <substituteCalculationAgentIsIndependent> @linkml:Boolean ? ;
          <substituteCalculationAgentAppointedBy> [
             <https://w3id.org/lmodel/common-domain-model/SubstituteCalculationAgentAppointerEnum#Party_A>
             <https://w3id.org/lmodel/common-domain-model/SubstituteCalculationAgentAppointerEnum#Party_B>
             <https://w3id.org/lmodel/common-domain-model/SubstituteCalculationAgentAppointerEnum#PartyA_Party_B>
             <https://w3id.org/lmodel/common-domain-model/SubstituteCalculationAgentAppointerEnum#Third_Party>
             <https://w3id.org/lmodel/common-domain-model/SubstituteCalculationAgentAppointerEnum#Other> ] ? ;
          <substituteCalculationAgentAppointedByIfOther> @linkml:String ? ;
          <costOfSubstituteCalculationAgentIsBoreBy> [
             <https://w3id.org/lmodel/common-domain-model/PayeeOfSubstituteCalculationAgentEnum#Party_A>
             <https://w3id.org/lmodel/common-domain-model/PayeeOfSubstituteCalculationAgentEnum#Party_B>
             <https://w3id.org/lmodel/common-domain-model/PayeeOfSubstituteCalculationAgentEnum#PartyA_Party_B>
             <https://w3id.org/lmodel/common-domain-model/PayeeOfSubstituteCalculationAgentEnum#Furthest_Estimate>
             <https://w3id.org/lmodel/common-domain-model/PayeeOfSubstituteCalculationAgentEnum#Other> ] ? ;
          <costOfSubstituteCalculationAgentBoreByIfOther> @linkml:String ?
       ) ;
       rdf:type [ <SubstituteCalculationAgentElection> ] ?
    )
}

<SubstitutedRegime> CLOSED {
    (  $<SubstitutedRegime_tes> <partyElection> @<SubstitutedRegimeElection> + ;
       rdf:type [ <SubstitutedRegime> ] ?
    )
}

<SubstitutedRegimeElection> CLOSED {
    (  $<SubstitutedRegimeElection_tes> (  <party> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] ;
          <isApplicable> @linkml:Boolean ;
          <regime> [ <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Australia>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Canada>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#CFTC>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#EMIR>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Hong%20Kong>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Japan>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Prudential>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#SEC>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Singapore>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Switzerland>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Brazil>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#United%20Kingdom>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#South%20Africa>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#South%20Korea>
             <https://w3id.org/lmodel/common-domain-model/RegulatoryRegimeEnum#Hong%20Kong%20SFC> ] * ;
          <additionalRegime> @linkml:String *
       ) ;
       rdf:type [ <SubstitutedRegimeElection> ] ?
    )
}

<Substitution> CLOSED {
    (  $<Substitution_tes> <partyElection> @<SubstitutionPartyElection> * ;
       rdf:type [ <Substitution> ] ?
    )
}

<SubstitutionPartyElection> CLOSED {
    (  $<SubstitutionPartyElection_tes> (  <party> [ <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party1>
             <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum#Party2> ] ;
          <needsConsent> @linkml:Boolean ;
          <substitutionDateLanguage> @linkml:String ? ;
          <specificConsentLanguage> @linkml:String ? ;
          <legacyConsent> [ <https://w3id.org/lmodel/common-domain-model/LegacyConsentEnum#ConsentRequired>
             <https://w3id.org/lmodel/common-domain-model/LegacyConsentEnum#NoConsent>
             <https://w3id.org/lmodel/common-domain-model/LegacyConsentEnum#ConsentRequiredNoDelay>
             <https://w3id.org/lmodel/common-domain-model/LegacyConsentEnum#TimesAdjusted>
             <https://w3id.org/lmodel/common-domain-model/LegacyConsentEnum#NoticeConditions>
             <https://w3id.org/lmodel/common-domain-model/LegacyConsentEnum#CostsApportioned> ] ?
       ) ;
       rdf:type [ <SubstitutionPartyElection> ] ?
    )
}

<SubstitutionProvisions> CLOSED {
    (  $<SubstitutionProvisions_tes> (  <numberOfSubstitutionsAllowed> @linkml:Integer ? ;
          <noticeDeadlinePeriod> @<Period> ? ;
          <noticeDeadlineDateTime> @linkml:Datetime ?
       ) ;
       rdf:type [ <SubstitutionProvisions> ] ?
    )
}

