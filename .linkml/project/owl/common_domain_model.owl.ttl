            owl:onProperty common_domain_model:finalPrincipalExchangeCalculation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:mainPublication ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialIndexLevel ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialIndexLevel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:indexSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Offset ;
            owl:onProperty common_domain_model:inflationLag ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:indexSource ],
