common_domain_model:CSASpecifiedOrAccessConditionEnum a owl:Class ;
    rdfs:label "CSASpecifiedOrAccessConditionEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/CSASpecifiedOrAccessConditionEnum#Illegality> <https://w3id.org/lmodel/common-domain-model/CSASpecifiedOrAccessConditionEnum#TaxEvent> <https://w3id.org/lmodel/common-domain-model/CSASpecifiedOrAccessConditionEnum#TaxEventUponMerger> <https://w3id.org/lmodel/common-domain-model/CSASpecifiedOrAccessConditionEnum#CreditEventUponMerger> <https://w3id.org/lmodel/common-domain-model/CSASpecifiedOrAccessConditionEnum#AdditionalTerminationEvents> <https://w3id.org/lmodel/common-domain-model/CSASpecifiedOrAccessConditionEnum#ForceMajeureEvent> <https://w3id.org/lmodel/common-domain-model/CSASpecifiedOrAccessConditionEnum#PotentialTerminationEvents> ) ;
    skos:definition "Specifies the types of events in the related Master Agreement that, when triggered, could temporarily or permanently suspend rights to rehypothecate, transfer or substitute collateral." ;
