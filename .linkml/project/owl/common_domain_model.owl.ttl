    rdfs:subClassOf common_domain_model:QuotationSideEnum ;
    skos:definition "Denotes a value as the Closing price reported in or by the relevant Price Source as specified in the relevant Confirmation." .

<https://w3id.org/lmodel/common-domain-model/QuotationSideEnum#High> a owl:Class ;
    rdfs:label "High" ;
    rdfs:subClassOf common_domain_model:QuotationSideEnum ;
    skos:definition "Denotes a value as the High price reported in or by the relevant Price Source as specified in the relevant Confirmation." .

<https://w3id.org/lmodel/common-domain-model/QuotationSideEnum#Index> a owl:Class ;
    rdfs:label "Index" ;
    rdfs:subClassOf common_domain_model:QuotationSideEnum ;
    skos:definition "Denotes a value as the Index price reported in or by the relevant Price Source as specified in the relevant Confirmation." .

<https://w3id.org/lmodel/common-domain-model/QuotationSideEnum#LocationalMarginal> a owl:Class ;
    rdfs:label "LocationalMarginal" ;
    rdfs:subClassOf common_domain_model:QuotationSideEnum ;
    skos:definition "Denotes a value as the Locational Marginal price reported in or by the relevant Price Source as specified in the relevant Confirmation." .

<https://w3id.org/lmodel/common-domain-model/QuotationSideEnum#Low> a owl:Class ;
    rdfs:label "Low" ;
    rdfs:subClassOf common_domain_model:QuotationSideEnum ;
    skos:definition "Denotes a value as the Low price reported in or by the relevant Price Source as specified in the relevant Confirmation." .

<https://w3id.org/lmodel/common-domain-model/QuotationSideEnum#MarginalHourly> a owl:Class ;
    rdfs:label "MarginalHourly" ;
    rdfs:subClassOf common_domain_model:QuotationSideEnum ;
    skos:definition "Denotes a value as the Marginal Hourly price reported in or by the relevant Price Source as specified in the relevant Confirmation." .

<https://w3id.org/lmodel/common-domain-model/QuotationSideEnum#MarketClearing> a owl:Class ;
    rdfs:label "MarketClearing" ;
    rdfs:subClassOf common_domain_model:QuotationSideEnum ;
    skos:definition "Denotes a value as the Market Clearing price reported in or by the relevant Price Source as specified in the relevant Confirmation." .

<https://w3id.org/lmodel/common-domain-model/QuotationSideEnum#MeanOfBidAndAsk> a owl:Class ;
    rdfs:label "MeanOfBidAndAsk" ;
