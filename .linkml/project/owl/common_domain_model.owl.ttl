    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:effectivePeriod a owl:ObjectProperty ;
    rdfs:label "effectivePeriod" ;
    rdfs:range common_domain_model:Period ;
    skos:closeMatch fpml_5_10:CancelableProvision.effectivePeriod ;
    skos:definition "Effective period for cancelation when notice is given. This is the period after notice is given that cancellation becomes effecticve." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:eligibilityQuery a owl:ObjectProperty ;
    rdfs:label "eligibilityQuery" ;
    rdfs:range common_domain_model:EligibilityQuery ;
    skos:definition "a copy of the input query that was checked against the eligible collateral specification" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:eligibilityToHoldCollateral a owl:ObjectProperty ;
    rdfs:label "eligibilityToHoldCollateral" ;
    rdfs:range common_domain_model:EligibilityToHoldCollateral ;
    skos:definition "The specification of the conditions under which a party and its custodian(s) are entitled to hold posted collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:eligibleCurrencyInclBaseCurrency a owl:DatatypeProperty ;
    rdfs:label "eligibleCurrencyInclBaseCurrency" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:BaseAndEligibleCurrency.eligibleCurrencyInclBaseCurrency ;
    skos:definition "A flag detailing whether the Base Currency is included as an Eligible Currency." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:eligibleCurrencyOther a owl:DatatypeProperty ;
    rdfs:label "eligibleCurrencyOther" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BaseAndEligibleCurrency.eligibleCurrencyOther ;
    skos:definition "Utilised where the clause data structure is not able to capture a material aspect of the clause." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    common_domain_model:metadata_scheme true .

common_domain_model:endTime a owl:DatatypeProperty ;
    rdfs:label "endTime" ;
