common_domain_model:PayerReceiver a owl:Class ;
	rdfs:label "PayerReceiver" ;
	rdfs:subClassOf _:c14n10704 , _:c14n2975 , _:c14n3893 , _:c14n5063 , _:c14n6927 , _:c14n8899 ;
	skos:definition "Specifies the parties responsible for making and receiving payments defined by this structure." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_party .
common_domain_model:PayerReceiverEnum\#Payer a owl:Class ;
	rdfs:label "Payer" ;
	rdfs:subClassOf common_domain_model:PayerReceiverEnum ;
	skos:definition "The party identified as the stream payer." .
common_domain_model:PayerReceiverEnum\#Receiver a owl:Class ;
	rdfs:label "Receiver" ;
	rdfs:subClassOf common_domain_model:PayerReceiverEnum ;
	skos:definition "The party identified as the stream receiver." .
common_domain_model:PayerReceiverEnum a owl:Class ;
	rdfs:label "PayerReceiverEnum" ;
	owl:unionOf _:c14n351 ;
