    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:EconomicTerms a owl:Class ;
    rdfs:label "EconomicTerms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AssetPayout common_domain_model:CommodityPayout common_domain_model:CreditDefaultPayout common_domain_model:FixedPricePayout common_domain_model:InterestRatePayout common_domain_model:OptionPayout common_domain_model:PerformancePayout common_domain_model:SettlementPayout ) ] common_domain_model:Payout ) ] ;
            owl:onProperty common_domain_model:payout ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DirectOrRelativeTime ;
            owl:onProperty common_domain_model:terminationTime ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:payout ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectiveTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:nonStandardisedTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationAgent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TerminationProvision ;
            owl:onProperty common_domain_model:terminationProvision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:terminationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:nonStandardisedTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Collateral ;
            owl:onProperty common_domain_model:collateral ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:terminationDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:calculationAgent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:nonStandardisedTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:collateral ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:terminationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectiveTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:collateral ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:terminationProvision ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:terminationTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:terminationProvision ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CalculationAgent ;
            owl:onProperty common_domain_model:calculationAgent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DirectOrRelativeTime ;
            owl:onProperty common_domain_model:effectiveTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:terminationTime ] ;
    skos:definition " This class represents the full set of price-forming features associated with a contractual product: the payout component, the notional/quantity, the effective and termination date and the date adjustment provisions when applying uniformily across the payout components. This class also includes the legal provisions which have valuation implications: cancelable provision, extendible provision, early termination provision and extraordinary events specification." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Rosetta condition: DayCountFraction — if payout -> InterestRatePayout count = 2 then payout -> InterestRatePayout -> dayCountFraction exists",
        "Rosetta condition: FpML_cd_26_28 — // Cashflow is no longer part of the product so this condition cannot be tested at the economic terms level. // Consider adding a generic validation at the trade state level that any cashflow must be between effective and termination dates. True",
        "Rosetta condition: FpML_cd_27 — // Cashflow is no longer part of the product so this condition cannot be tested at the economic terms level. // Consider adding a generic validation at the trade state level that any cashflow must be between effective and termination dates. True",
        "Rosetta condition: FpML_cd_30 — if payout -> InterestRatePayout -> paymentDates -> lastRegularPaymentDate exists and terminationDate exists then payout -> InterestRatePayout -> paymentDates -> lastRegularPaymentDate all < terminationDate -> adjustableDate -> unadjustedDate or payout -> InterestRatePayout -> paymentDates -> lastRegularPaymentDate all < terminationDate -> adjustableDate -> adjustedDate",
        "Rosetta condition: IndependentCalculationAgent — if calculationAgent -> calculationAgentParty exists then calculationAgent -> calculationAgentParty = AncillaryRoleEnum -> CalculationAgentIndependent",
        "Rosetta condition: LastRegularPaymentDate — if payout -> InterestRatePayout -> paymentDates -> lastRegularPaymentDate exists and payout -> InterestRatePayout -> stubPeriod -> finalStub exists then payout -> InterestRatePayout count = 2",
        "Rosetta condition: MarketPrice — if payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation is absent then payout -> CreditDefaultPayout -> transactedPrice -> marketFixedRate is absent and payout -> CreditDefaultPayout -> transactedPrice -> marketPrice is absent",
        "Rosetta condition: NotionalResetInterestRatePayoutExists — if payout -> PerformancePayout -> priceQuantity -> reset contains True then payout -> InterestRatePayout exists",
        "Rosetta condition: NotionalResetOnPerformancePayout — payout -> CreditDefaultPayout -> priceQuantity -> reset is absent and payout -> AssetPayout -> priceQuantity -> reset is absent and payout -> CommodityPayout -> priceQuantity -> reset is absent and payout -> FixedPricePayout -> priceQuantity -> reset is absent and payout -> SettlementPayout -> priceQuantity -> reset is absent and payout -> OptionPayout -> priceQuantity -> reset is absent",
        "Rosetta condition: PayRelativeTo — if payout -> InterestRatePayout count = 2 and payout -> InterestRatePayout -> paymentDates exists then payout -> InterestRatePayout -> paymentDates -> payRelativeTo exists",
        "Rosetta condition: PaymentDates — if payout -> InterestRatePayout count = 2 then payout -> InterestRatePayout -> dayCountFraction exists",
        "Rosetta condition: PaymentDatesAdjustments — if payout -> InterestRatePayout count = 2 and payout -> InterestRatePayout -> paymentDates exists then payout -> InterestRatePayout -> paymentDates -> paymentDatesAdjustments exists",
        "Rosetta condition: PaymentFrequency — if payout -> InterestRatePayout count = 2 and payout -> InterestRatePayout -> paymentDates exists then payout -> InterestRatePayout -> paymentDates -> paymentFrequency exists",
        "Rosetta condition: Quantity — if payout -> OptionPayout exists then payout -> OptionPayout -> priceQuantity exists or payout -> OptionPayout -> underlier -> Product ->> economicTerms -> payout -> InterestRatePayout count = 2",
        "Rosetta condition: ReturnType_Total_Requires_Dividends — if payout -> PerformancePayout -> returnTerms -> priceReturnTerms -> returnType all = ReturnTypeEnum -> Total then payout -> PerformancePayout -> returnTerms -> dividendReturnTerms exists" .

common_domain_model:ElectiveAmountElection a owl:Class ;
    rdfs:label "ElectiveAmountElection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:amount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:customElection ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:amount ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:amount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:electiveAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ElectiveAmountEnum ;
            owl:onProperty common_domain_model:electiveAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:customElection ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:electiveAmount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:customElection ] ;
    skos:definition "A class to specify the party elective amounts which can be used for the purpose of specifying elections such as the ISDA CSA Threshold and Minimum Transfer Amount." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta condition: NonZeroAmount — if electiveAmount is absent then amount exists or customElection exists" .

common_domain_model:EligibilityToHoldCollateral a owl:Class ;
    rdfs:label "EligibilityToHoldCollateral" ;
    rdfs:seeAlso isda:CSA_VM_2016 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialCustodian ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllEligibilityToHoldCollateralCriteria common_domain_model:AnyEligibilityToHoldCollateralCriteria common_domain_model:RatingAgencyValue common_domain_model:AmountOfNetCapital ) ] common_domain_model:EligibilityToHoldCollateralCriteria ) ] ;
            owl:onProperty common_domain_model:criteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalEntity ;
            owl:onProperty common_domain_model:initialCustodian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:eligibleCountry ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:criteria ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:custodianEligibility ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialCustodian ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:custodianCondition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:custodianCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:custodianEligibility ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:custodianCondition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:custodianEligibility ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:eligibleCountry ] ;
    skos:definition "Specifies the conditions under which a party and its custodian(s) are entitled to hold collateral." ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"13\" clause \" (h)(i)\" name \"Eligibility to Hold Posted Collateral (VM) Custodians (VM)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta condition: Custodian — if custodianEligibility = True then initialCustodian exists else initialCustodian is absent and custodianCondition is absent" .

common_domain_model:EligibleCreditSupport a owl:Class ;
    rdfs:label "EligibleCreditSupport" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EligibleCollateralElection ;
            owl:onProperty common_domain_model:partyElection ] ;
    skos:definition "Specifies the collateral posting obligations of the security provider or security providers as specified in the corresponding agreement" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

