    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:CalculationMethodEnum a owl:Class ;
    rdfs:label "CalculationMethodEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#Averaging> <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#Compounding> <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#CompoundedIndex> ) ;
    skos:definition "What calculation type is required, averaging or compounding. This enumeration is used to represent the definitions of modular calculated rates as described in the 2021 ISDA Definitions, section 7." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#Averaging>,
        <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#CompoundedIndex>,
        <https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum#Compounding> .

