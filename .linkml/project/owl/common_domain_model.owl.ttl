common_domain_model:SettlementDate a owl:Class ;
    rdfs:label "SettlementDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:paymentDelay ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:cashSettlementBusinessDays ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:paymentDelay ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessDateRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrAdjustedOrRelativeDate ;
            owl:onProperty common_domain_model:adjustableOrRelativeDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDelay ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustableOrRelativeDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:valueDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:cashSettlementBusinessDays ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDateRange ;
            owl:onProperty common_domain_model:businessDateRange ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableDates ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:valueDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:cashSettlementBusinessDays ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustableOrRelativeDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessDateRange ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:valueDate ] ;
    skos:definition "A data defining the settlement date(s) for cash or physical settlement as either a set of explicit dates, together with applicable adjustments, or as a date relative to some other (anchor) date, or as any date in a range of contiguous business days. This data type provides a level of abstraction on top of the different legacy methods used to specify a settlement / payment date, which vary across product types, asset classes and delivery types." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    skos:note "Rosetta condition: BusinessDays — if cashSettlementBusinessDays exists then cashSettlementBusinessDays >= 0 else adjustableOrRelativeDate exists or valueDate exists or adjustableDates exists or businessDateRange exists",
        "Rosetta condition: DateChoice — optional choice adjustableOrRelativeDate, valueDate, adjustableDates, businessDateRange" ;
    common_domain_model:metadata_key true .

common_domain_model:SettlementProvision a owl:Class ;
