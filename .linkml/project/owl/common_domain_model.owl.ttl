<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeA> a owl:Class ;
    rdfs:label "EU_EMIRTypeA" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition "Denotes Cash in the form of money credited to an account in any currency, or similar claims for the repayment of money, such as money market deposits." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeB> a owl:Class ;
    rdfs:label "EU_EMIRTypeB" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes gold in the form of allocated pure gold bullion of recognised good delivery." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeC> a owl:Class ;
    rdfs:label "EU_EMIRTypeC" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by Member States' central governments or central banks." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeD> a owl:Class ;
    rdfs:label "EU_EMIRTypeD" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by Member States' regional governments or local authorities whose exposures are treated as exposures to the central government of that Member State in accordance with Article 115(2) of Regulation (EU) No 575/2013." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeE> a owl:Class ;
    rdfs:label "EU_EMIRTypeE" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by Member States' public sector entities whose exposures are treated as exposures to the central government, regional government or local authority of that Member State in accordance with Article 116(4) of Regulation (EU) No 575/2013." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeF> a owl:Class ;
    rdfs:label "EU_EMIRTypeF" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by Member States' regional governments or local authorities other than those referred to in (TypeD.)" .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeG> a owl:Class ;
    rdfs:label "EU_EMIRTypeG" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by Member States' public sector entities other than those referred to in (TypeE)." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeH> a owl:Class ;
    rdfs:label "EU_EMIRTypeH" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by multilateral development banks listed in Article 117(2) of Regulation (EU) No 575/2013." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeI> a owl:Class ;
    rdfs:label "EU_EMIRTypeI" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by the international organisations listed in Article 118 of Regulation (EU) No 575/2013." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeJ> a owl:Class ;
    rdfs:label "EU_EMIRTypeJ" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by third countries' governments or central banks." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeK> a owl:Class ;
    rdfs:label "EU_EMIRTypeK" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by third countries' regional governments or local authorities that meet the requirements of (TypeD) and (TypeE)." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeL> a owl:Class ;
    rdfs:label "EU_EMIRTypeL" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by third countries' regional governments or local authorities other than those referred to in (TypeD) and (TypeE)." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeM> a owl:Class ;
    rdfs:label "EU_EMIRTypeM" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes debt securities issued by credit institutions or investment firms including bonds referred to in Article 52(4) of Directive 2009/65/EC of the European Parliament and of the Council." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeN> a owl:Class ;
    rdfs:label "EU_EMIRTypeN" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes corporate bonds." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeO> a owl:Class ;
    rdfs:label "EU_EMIRTypeO" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes the most senior tranche of a securitisation, as defined in Article 4(61) of Regulation (EU) No 575/2013, that is not a re-securitisation as defined in Article 4(63) of that Regulation." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeP> a owl:Class ;
    rdfs:label "EU_EMIRTypeP" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes convertible bonds provided that they can be converted only into equities which are included in an index specified pursuant to point (a) of Article 197 (8) of Regulation (EU) No 575/2013." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeQ> a owl:Class ;
    rdfs:label "EU_EMIRTypeQ" ;
    rdfs:subClassOf common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:definition " Denotes equities included in an index specified pursuant to point (a) of Article 197(8) of Regulation (EU) No 575/2013." .

<https://w3id.org/lmodel/common-domain-model/EUEMIREligibleCollateralEnum#EU_EMIRTypeR> a owl:Class ;
    rdfs:label "EU_EMIRTypeR" ;
