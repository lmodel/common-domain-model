	rdfs:label "SFE" ;
	rdfs:subClassOf common_domain_model:RollConventionEnum ;
	skos:definition "Sydney Futures Exchange 90-Day Bank Accepted Bill Futures Settlement Dates. The second Friday of the (delivery) month" .
