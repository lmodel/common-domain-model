    rdfs:range common_domain_model:DividendAmountTypeEnum ;
    skos:definition "Determination of Gross Cash Dividend per Share." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:exchangeId a owl:DatatypeProperty ;
    rdfs:label "exchangeId" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CommodityProductDefinition.exchangeId ;
    skos:definition " Identifies the exchange from which the reference price should be sourced, using the scheme at the following url: http://www.fpml.org/coding-scheme/external/exchange-id-MIC-1-0" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
