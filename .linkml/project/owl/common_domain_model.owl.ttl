common_domain_model:DeliveryReturnAmountEnum a owl:Class ;
    rdfs:label "DeliveryReturnAmountEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/DeliveryReturnAmountEnum#Standard> <https://w3id.org/lmodel/common-domain-model/DeliveryReturnAmountEnum#NonStandardRatings> <https://w3id.org/lmodel/common-domain-model/DeliveryReturnAmountEnum#NonStandardOther> ) ;
    skos:definition "In respect of a Valuation Date, the amount of collateral which a party is entitled to demand to be transferred to it as a Delivery or Return Amount." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/DeliveryReturnAmountEnum#NonStandardOther>,
        <https://w3id.org/lmodel/common-domain-model/DeliveryReturnAmountEnum#NonStandardRatings>,
        <https://w3id.org/lmodel/common-domain-model/DeliveryReturnAmountEnum#Standard> .

common_domain_model:DemandsAndNotices a owl:Class ;
    rdfs:label "DemandsAndNotices" ;
    rdfs:seeAlso isda:CSA_NewYork_1994 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:deemedEffectiveNextLBD ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:deemedEffectiveNextLBD ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NoticeInformationElection ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:deemedEffectiveNextLBD ] ;
    skos:definition "Specifies the address where the demands, specifications and notices will be communicated to for each of the parties to the agreement." ;
    skos:editorialNote "ISDA CSA_NewYork_1994 paragraph \"13\" clause \"(k)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:DeterminationRoleEnum a owl:Class ;
    rdfs:label "DeterminationRoleEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/DeterminationRoleEnum#CalculationAgent> <https://w3id.org/lmodel/common-domain-model/DeterminationRoleEnum#HedgingParty> <https://w3id.org/lmodel/common-domain-model/DeterminationRoleEnum#DeterminingParty> ) ;
    skos:definition "Defines the enumerated values to specify the determination roles to the transaction. Such roles mostly address any determination that would be required when some Extraordinary Events would happen, for instance qualifying the effectiveness of such event, or when a calculation is required, etc. else any other kind of determination as need be." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/DeterminationRoleEnum#CalculationAgent>,
        <https://w3id.org/lmodel/common-domain-model/DeterminationRoleEnum#DeterminingParty>,
        <https://w3id.org/lmodel/common-domain-model/DeterminationRoleEnum#HedgingParty> .

common_domain_model:DirectionRatingSet a owl:Class ;
    rdfs:label "DirectionRatingSet" ;
    skos:definition "A logical container to hold a defined set of related data. In this case the collation of Ratings Agency, Rating value and an associated direction that are grouped by either AND or OR logic." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." .

common_domain_model:DividendEntitlementEnum a owl:Class ;
    rdfs:label "DividendEntitlementEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/DividendEntitlementEnum#ExDate> <https://w3id.org/lmodel/common-domain-model/DividendEntitlementEnum#RecordDate> ) ;
    skos:definition "The enumerated values to specify the date on which the receiver of the equity payout is entitled to the dividend." ;
