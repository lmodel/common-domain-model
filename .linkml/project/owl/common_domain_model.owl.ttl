common_domain_model:RollFeature a owl:Class ;
    rdfs:label "RollFeature" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RollSourceCalendarEnum ;
            owl:onProperty common_domain_model:rollSourceCalendar ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:deliveryDateRollConvention ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:deliveryDateRollConvention ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Offset ;
            owl:onProperty common_domain_model:deliveryDateRollConvention ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:rollSourceCalendar ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:rollSourceCalendar ] ;
    skos:definition "Used in conjunction with an exchange-based pricing source. Identifies a way in which the futures contracts referenced will roll between periods. " ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

<https://w3id.org/lmodel/common-domain-model/RollSourceCalendarEnum#Future> a owl:Class ;
    rdfs:label "Future" ;
    rdfs:subClassOf common_domain_model:RollSourceCalendarEnum .

