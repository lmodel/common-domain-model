    skos:closeMatch gist:Assignment,
        oscal:ResponsibleParty ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:note "Rosetta func: FilterRelatedPartyByRole — Filters the list of RelatedParty based on the provided partyRoleEnum." ;
