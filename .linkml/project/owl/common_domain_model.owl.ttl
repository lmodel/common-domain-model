common_domain_model:Threshold a owl:Class ;
    rdfs:label "Threshold" ;
    rdfs:seeAlso isda:CSA_NewYork_1994 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ThresholdElection ;
