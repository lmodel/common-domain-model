    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#FixedPartyForDisputes>,
        <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SoleValuationAgent>,
        <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SwitchUponDefault>,
        <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SwitchUponFailureToPerform> .

common_domain_model:ValuationCalculationDateLocation a owl:Class ;
    rdfs:label "ValuationCalculationDateLocation" ;
    rdfs:seeAlso isda:CSA_IM_Japanese_2016,
        isda:CSA_IM_NewYork_2016,
        isda:CSD_IM_English_2016 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ValuationCalculationDateLocationElection ;
            owl:onProperty common_domain_model:partyElection ] ;
    skos:definition "Specification of the Calculation Date Location for the respective parties to the legal agreement." ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(e)(i)\" name \"Calculation Date Location\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(d)(i)\" name \"Calculation Date Location\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(d)(i)\" name \"Calculation Date Location\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:VolatilityCapFloor a owl:Class ;
    rdfs:label "VolatilityCapFloor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:totalVolatilityCap ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:volatilityCapFactor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:totalVolatilityCap ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:applicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:volatilityCapFactor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:volatilityCapFactor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:applicable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:totalVolatilityCap ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:applicable ] ;
    skos:definition "Contains volatility-based barriers. Volatility Cap needs to be specified in accordance with the ISDA 2011 Equity Derivatives Definitions." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    skos:note "Rosetta condition: CapFloorApplicability — if applicable = True then totalVolatilityCap exists or volatilityCapFactor exists // If CapFloor is applicable at least one cap expression must exist else totalVolatilityCap is absent and volatilityCapFactor is absent // If CapFloor is not applicable, then there cannot be any volatility caps",
        "Rosetta condition: PositiveCaps — if totalVolatilityCap exists then totalVolatilityCap >= 0 and if volatilityCapFactor exists then volatilityCapFactor >= 0" .

common_domain_model:additionalObligations a owl:DatatypeProperty ;
    rdfs:label "additionalObligations" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:AdditionalObligations.additionalObligations ;
    skos:definition "The party specific additional obligations applicable to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:alternativeProvision a owl:DatatypeProperty ;
    rdfs:label "alternativeProvision" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.alternativeProvision ;
    skos:definition "Specifies an alternative to interest amount, when the alternative provision clause is specified." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:alternativeToInterestAmount a owl:ObjectProperty ;
    rdfs:label "alternativeToInterestAmount" ;
    rdfs:range common_domain_model:AlternativeToInterestAmountEnum ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.alternativeToInterestAmount ;
    skos:definition "Specifies the alternative to interest amounts." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:asCalculationAgent a owl:DatatypeProperty ;
    rdfs:label "asCalculationAgent" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:BespokeCalculationTime.asCalculationAgent ;
    skos:definition "If set to True, the Calculation Time for Initial Margin is the time as of which the Calculation Agent (IM) computes its end of day valuations of derivatives transactions." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:asPermitted a owl:DatatypeProperty ;
    rdfs:label "asPermitted" ;
    rdfs:range xsd:boolean ;
    skos:definition "If set to True, the Control Agreement is a Credit Support Document with respect to the party(ies)." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"6\" clause \"(e)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:basketPercentage a owl:DatatypeProperty ;
    rdfs:label "basketPercentage" ;
    rdfs:range xsd:decimal ;
    skos:definition "The relative weight of each respective basket constituent, expressed in percentage. A basket percentage of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:bespokeCalculationTimeTerms a owl:DatatypeProperty ;
    rdfs:label "bespokeCalculationTimeTerms" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BespokeCalculationTime.bespokeCalculationTimeTerms ;
    skos:definition "Additional Terms applicable to Calculation Time for Initial Margin." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:businessDaysThereafter a owl:DatatypeProperty ;
    rdfs:label "businessDaysThereafter" ;
    rdfs:range xsd:integer ;
    skos:definition "The number of business days between successive valuation dates when multiple valuation dates are applicable for cash settlement. ISDA 2003 Term: Business Days thereafter." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:capRateSchedule a owl:ObjectProperty ;
    rdfs:label "capRateSchedule" ;
    rdfs:range common_domain_model:StrikeSchedule ;
    skos:definition "The cap rate or cap rate schedule, if any, which applies to the floating rate. The cap rate (strike) is only required where the floating rate on a swap stream is capped at a certain level. A cap rate schedule is expressed as explicit cap rates and dates and the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The cap rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A cap rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:cashRatio a owl:DatatypeProperty ;
    rdfs:label "cashRatio" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies the cash actual dividend payout ratio associated with the equity underlier. A ratio of 90% should be expressed at 0.90." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:cashSettlementBusinessDays a owl:DatatypeProperty ;
    rdfs:label "cashSettlementBusinessDays" ;
    rdfs:range xsd:integer ;
    skos:definition "The number of business days used in the determination of the cash settlement payment date. If a cash settlement amount is specified, the cash settlement payment date will be this number of business days following the calculation of the final price. If a cash settlement amount is not specified, the cash settlement payment date will be this number of business days after all conditions to settlement are satisfied. ISDA 2003 Term: Cash Settlement Date. This attribute was formerly part of 'CashSettlementTerms' as used for credit event settlement, which now includes a common 'SettlementDate' attribute." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:commencementDate a owl:ObjectProperty ;
    rdfs:label "commencementDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:definition "The first day of the exercise period for an American style option." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:compareVariableSet a owl:ObjectProperty ;
    rdfs:label "compareVariableSet" ;
    rdfs:range common_domain_model:DirectionRatingMultiplier ;
    skos:definition "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier where multiple credit ratings are compared when determining the applicable Independent Amount." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:compoundingType a owl:ObjectProperty ;
    rdfs:label "compoundingType" ;
    rdfs:range common_domain_model:CompoundingTypeEnum ;
    skos:closeMatch fpml_5_10:CollateralInterestCalculationParameters.compoundingType ;
    skos:definition "Specifies the type of compounding to be applied (None, Business, Calendar)." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:creditSupportAgreementType a owl:ObjectProperty ;
    rdfs:label "creditSupportAgreementType" ;
    rdfs:range common_domain_model:CreditSupportAgreementTypeEnum ;
    skos:closeMatch fpml_5_10:AgreementName.creditSupportAgreementType ;
    skos:definition "Specification of the credit support agreement type." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:creditSupportProvider a owl:ObjectProperty ;
    rdfs:label "creditSupportProvider" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "The specified Credit Support Provider(s), if any." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:criteria a owl:ObjectProperty ;
    rdfs:label "criteria" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllEligibilityToHoldCollateralCriteria common_domain_model:AnyEligibilityToHoldCollateralCriteria common_domain_model:RatingAgencyValue common_domain_model:AmountOfNetCapital ) ] common_domain_model:EligibilityToHoldCollateralCriteria ) ] ;
    skos:definition "A logical container to hold a defined set of related data. In this case the collation of criteria required by the party and its custodian to Hold the other party's Posted Collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:customValue a owl:DatatypeProperty ;
    rdfs:label "customValue" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:AdditionalType.customValue ;
    skos:definition "The qualification of the Additional Type of transaction that can require the collection or delivery of initial margin when specified as a custom value by the parties to the legal agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:dayOfMonth a owl:DatatypeProperty ;
    rdfs:label "dayOfMonth" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculationFrequency.dayOfMonth ;
    skos:definition "Specifies the day of the month if used." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:durationInYears a owl:DatatypeProperty ;
    rdfs:label "durationInYears" ;
    rdfs:range xsd:decimal ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:election a owl:DatatypeProperty ;
    rdfs:label "election" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:AppropriatedCollateralValuation.election ;
    skos:definition "The parties' election that qualify the Valuation of Appropriate Collateral in the case where it is deemed applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:entity a owl:ObjectProperty ;
    rdfs:label "entity" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "Specification of the process agent entity." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:floatingRateMultiplier a owl:DatatypeProperty ;
    rdfs:label "floatingRateMultiplier" ;
    rdfs:range xsd:decimal ;
    skos:definition "A rate multiplier to apply to the floating rate. The multiplier can be a positive or negative decimal. This element should only be included if the multiplier is not equal to 1 (one)." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:floorRateSchedule a owl:ObjectProperty ;
    rdfs:label "floorRateSchedule" ;
    rdfs:range common_domain_model:StrikeSchedule ;
    skos:definition "The floor rate or floor rate schedule, if any, which applies to the floating rate. The floor rate (strike) is only required where the floating rate on a swap stream is floored at a certain strike level. A floor rate schedule is expressed as explicit floor rates and dates and the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The floor rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A floor rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:fxDesignatedCurrency a owl:DatatypeProperty ;
    rdfs:label "fxDesignatedCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "When specified, the reference currency for the purpose of specifying the FX Haircut relating to a posting obligation. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    common_domain_model:metadata_scheme true .

common_domain_model:highestLowestVariableSet a owl:ObjectProperty ;
    rdfs:label "highestLowestVariableSet" ;
    rdfs:range common_domain_model:RatingMultiplier ;
    skos:definition "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier where highest or lowest of the associated credit ratings are used when determining the applicable Independent Amount." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:includeCoolingOffLanguage a owl:DatatypeProperty ;
    rdfs:label "includeCoolingOffLanguage" ;
    rdfs:range xsd:boolean ;
    skos:definition "The Pledgor/Obligor/Chargor Rights Event election includes cooling off language when the attribute is set of True." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:indexAnnexVersion a owl:DatatypeProperty ;
    rdfs:label "indexAnnexVersion" ;
    rdfs:range xsd:integer ;
    skos:definition "A CDS index series version identifier, e.g. 1, 2, 3 etc." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:indexFactor a owl:DatatypeProperty ;
    rdfs:label "indexFactor" ;
    rdfs:range xsd:decimal ;
    skos:definition "Index Factor is the index version factor or percent, expressed as an absolute decimal value between 0 and 1, that multiplied by the original notional amount yields the notional amount covered by the seller of protection." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:indexSeries a owl:DatatypeProperty ;
    rdfs:label "indexSeries" ;
    rdfs:range xsd:integer ;
    skos:definition "A CDS index series identifier, e.g. 1, 2, 3 etc." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:initialStockLoanRate a owl:DatatypeProperty ;
    rdfs:label "initialStockLoanRate" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.initialStockLoanRate ;
    skos:definition "Specifies the initial stock loan per ISDA Def. A percentage of 5% is represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:isTerminationCurrency a owl:DatatypeProperty ;
    rdfs:label "isTerminationCurrency" ;
    rdfs:range xsd:boolean ;
    skos:definition "The reference currency for the purpose of specifying the FX Haircut relating to a posting obligation is the Termination Currency when the Boolean value is set to True." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:legacyVMCustodian a owl:ObjectProperty ;
    rdfs:label "legacyVMCustodian" ;
    rdfs:range common_domain_model:LegacyVMCustodianEnum ;
    skos:definition "Details how the Custodian is determined." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:legalDocument a owl:DatatypeProperty ;
    rdfs:label "legalDocument" ;
    rdfs:range xsd:string ;
    skos:definition "The specification of this other agreement, when the qualification is True." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:marginPercentage a owl:DatatypeProperty ;
    rdfs:label "marginPercentage" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CollateralValuationTreatment.marginPercentage ;
    skos:definition "Specifies a percentage value of transaction needing to be posted as collateral expressed as a valuation. As an example a 104% requirement would be represented as a decimal number 1.04." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ERCCBestPractice#Margin_Ratio>,
        <https://www.icmagroup.org/market-practice-and-regulatory-policy/GMRA#Margin_Ratio> .

common_domain_model:maximumBusinessDays a owl:DatatypeProperty ;
    rdfs:label "maximumBusinessDays" ;
    rdfs:range xsd:integer ;
    skos:definition "A maximum number of business days. Its precise meaning is dependant on the context in which this element is used. Intended to be used to limit a particular ISDA fallback provision." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:maximumStockLoanRate a owl:DatatypeProperty ;
    rdfs:label "maximumStockLoanRate" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.maximumStockLoanRate ;
    skos:definition "Specifies the maximum stock loan rate for Loss of Stock Borrow. A percentage of 5% is represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:minimumNumberOfOptions a owl:DatatypeProperty ;
    rdfs:label "minimumNumberOfOptions" ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum number of options that can be exercised on a given exercise date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:monthOfYear a owl:DatatypeProperty ;
    rdfs:label "monthOfYear" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculationFrequency.monthOfYear ;
    skos:definition "Specifies the month of the year if used." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:mthToDefault a owl:DatatypeProperty ;
    rdfs:label "mthToDefault" ;
    rdfs:range xsd:integer ;
    skos:closeMatch fpml_5_10:BasketReferenceInformation.mthToDefault ;
    skos:definition "M th reference obligation to default to allow representation of N th to M th defaults." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:nonCashRatio a owl:DatatypeProperty ;
    rdfs:label "nonCashRatio" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies the non cash actual dividend payout ratio associated with the equity underlier. A ratio of 90% should be expressed at 0.90." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:nthToDefault a owl:DatatypeProperty ;
    rdfs:label "nthToDefault" ;
    rdfs:range xsd:integer ;
    skos:closeMatch fpml_5_10:BasketReferenceInformation.nthToDefault ;
    skos:definition "N th reference obligation to default triggers payout." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:numberOfDataSeries a owl:DatatypeProperty ;
    rdfs:label "numberOfDataSeries" ;
    rdfs:range xsd:integer ;
    skos:definition "Number of data series, normal market practice is that correlation data sets are drawn from geographic market areas, such as America, Europe and Asia Pacific, each of these geographic areas will have its own data series to avoid contagion." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:numberOfValuationDates a owl:DatatypeProperty ;
    rdfs:label "numberOfValuationDates" ;
    rdfs:range xsd:integer ;
    skos:definition "The number of valuation dates between valuation start date and valuation end date." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:numberValuationDates a owl:DatatypeProperty ;
    rdfs:label "numberValuationDates" ;
    rdfs:range xsd:integer ;
    skos:definition "Where multiple valuation dates are specified as being applicable for cash settlement, this element specifies (a) the number of applicable valuation dates, and (b) the number of business days after satisfaction of all conditions to settlement when the first such valuation date occurs, and (c) the number of business days thereafter of each successive valuation date. ISDA 2003 Term: Multiple Valuation Dates." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:observation a owl:ObjectProperty ;
    rdfs:label "observation" ;
    rdfs:range common_domain_model:ObservationInstruction ;
    skos:definition "Specifies inputs needed to process an observation." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:observationNumber a owl:DatatypeProperty ;
    rdfs:label "observationNumber" ;
    rdfs:range xsd:integer ;
    skos:definition "Observation number, which should be unique, within a series generated by a date schedule." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:observationWeight a owl:DatatypeProperty ;
    rdfs:label "observationWeight" ;
    rdfs:range xsd:integer ;
    skos:definition "The number of days weighting to be associated with the rate observation, i.e. the number of days such rate is in effect. This is applicable in the case of a weighted average method of calculation where more than one reset date is established for a single calculation period." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:parentParty a owl:ObjectProperty ;
    rdfs:label "parentParty" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "Represents the identification of a parent child relationship between two entities in the Umbrella agreement, allowing non-legal entities to be linked to the appropriate legal entity and allowing funds, portfolio or managed accounts to be linked to their applicable Investment Manager or Agent within the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:partyElections a owl:ObjectProperty ;
    rdfs:label "partyElections" ;
    rdfs:range common_domain_model:ElectiveAmountElection ;
    skos:definition "The party elective amounts." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:partyVersion a owl:ObjectProperty ;
    rdfs:label "partyVersion" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "The party which the specified SIMM version applies to." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:periodSkip a owl:DatatypeProperty ;
    rdfs:label "periodSkip" ;
    rdfs:range xsd:integer ;
    skos:definition "The number of periods in the referenced date schedule that are between each date in the relative date schedule. Thus a skip of 2 would mean that dates are relative to every second date in the referenced schedule. If present this should have a value greater than 1." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:portfolioIdentifier a owl:ObjectProperty ;
    rdfs:label "portfolioIdentifier" ;
    rdfs:range common_domain_model:Identifier ;
    skos:closeMatch fpml_5_10:CollateralPortfolio.portfolioIdentifier ;
    skos:definition "Specifies a unique identifier for a set of collateral positions in a portfolio." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:primaryContactInformation a owl:ObjectProperty ;
    rdfs:label "primaryContactInformation" ;
    rdfs:range common_domain_model:ContactInformation ;
    skos:definition "The main notice/address information of the party." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:recoveryFactor a owl:DatatypeProperty ;
    rdfs:label "recoveryFactor" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CashSettlementTerms.recoveryFactor ;
    skos:definition "Used for fixed recovery, specifies the recovery level, determined at contract formation, to be applied on a default. Used to calculate the amount paid by the seller to the buyer for cash settlement on the cash settlement date. Amount calculation is (1 minus the Recovery Factor) multiplied by the Floating Rate Payer Calculation Amount. The currency will be derived from the Floating Rate Payer Calculation Amount." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:representativeEvent a owl:ObjectProperty ;
    rdfs:label "representativeEvent" ;
    rdfs:range common_domain_model:ExceptionEnum ;
    skos:definition "The specification of whether the representative event terms are applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:resolutionAlternative a owl:ObjectProperty ;
    rdfs:label "resolutionAlternative" ;
    rdfs:range common_domain_model:LegacyResolutionAlternativeEnum ;
    skos:definition "Details of the alternative dispute resolution procedure (if any)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:specifiedEntity a owl:ObjectProperty ;
    rdfs:label "specifiedEntity" ;
    rdfs:range common_domain_model:SpecifiedEntity ;
    skos:definition "The party specific election of Specified Entities for the Event of Default or Termination Event specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:specifiedNumber a owl:DatatypeProperty ;
    rdfs:label "specifiedNumber" ;
    rdfs:range xsd:integer ;
    skos:definition "The minimum number of the specified public information sources that must publish information that reasonably confirms that a credit event has occurred. The market convention is two. ISDA 2003 Term: Specified Number." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:spreadSchedule a owl:ObjectProperty ;
    rdfs:label "spreadSchedule" ;
    rdfs:range common_domain_model:SpreadSchedule ;
    skos:definition "The ISDA Spread or a Spread schedule expressed as explicit spreads and dates. In the case of a schedule, the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The spread is a per annum rate, expressed as a decimal. For purposes of determining a calculation period amount, if positive the spread will be added to the floating rate and if negative the spread will be subtracted from the floating rate. A positive 10 basis point (0.1%) spread would be represented as 0.001." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:standardLanguage a owl:DatatypeProperty ;
    rdfs:label "standardLanguage" ;
    rdfs:range xsd:boolean ;
    skos:definition "A boolean attribute to determine if standard language is applicable or not." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:standardValue a owl:ObjectProperty ;
    rdfs:label "standardValue" ;
    rdfs:range common_domain_model:AdditionalTypeEnum ;
    skos:closeMatch fpml_5_10:AdditionalType.standardValue ;
    skos:definition "The qualification of the Additional Type of transaction that can require the collection or delivery of initial margin when specified as a standard value." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:style a owl:ObjectProperty ;
    rdfs:label "style" ;
    rdfs:range common_domain_model:OptionExerciseStyleEnum ;
    skos:definition "Whether the option has a single exercise (european), multiple exercise dates (bermuda), or a continuous range of exercise (american)." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:upperBarrier a owl:DatatypeProperty ;
    rdfs:label "upperBarrier" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:BoundedVariance.upperBarrier ;
    skos:definition "All observations above this price level will be excluded from the variance calculation." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:valuation a owl:ObjectProperty ;
    rdfs:label "valuation" ;
    rdfs:range common_domain_model:ValuationInstruction ;
    skos:definition "Specifies inputs needed to process an update of a valuation." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:weekOfMonth a owl:DatatypeProperty ;
    rdfs:label "weekOfMonth" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculationFrequency.weekOfMonth ;
    skos:definition "Specifies the week of the month if used." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:AggregationSpecificationEnum a owl:Class ;
    rdfs:label "AggregationSpecificationEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#Aggregated> <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#LoanByLoan> <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#AggregatedAndLoanByLoan> <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#NotSpecified> ) ;
    skos:definition "The potential options for specifying whether mark to market value of collateral is determined on an aggregated or loan by loan basis." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#Aggregated>,
        <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#AggregatedAndLoanByLoan>,
        <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#LoanByLoan>,
        <https://w3id.org/lmodel/common-domain-model/AggregationSpecificationEnum#NotSpecified> .

common_domain_model:AlternativeToInterestAmountEnum a owl:Class ;
    rdfs:label "AlternativeToInterestAmountEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AlternativeToInterestAmountEnum#Standard> <https://w3id.org/lmodel/common-domain-model/AlternativeToInterestAmountEnum#ActualAmountReceived> <https://w3id.org/lmodel/common-domain-model/AlternativeToInterestAmountEnum#TransferIfDeliveryAmountBelowMTA> <https://w3id.org/lmodel/common-domain-model/AlternativeToInterestAmountEnum#Other> ) ;
    skos:definition "If there is an alternative to interest amounts, how is it specified?" ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/AlternativeToInterestAmountEnum#ActualAmountReceived>,
        <https://w3id.org/lmodel/common-domain-model/AlternativeToInterestAmountEnum#Other>,
        <https://w3id.org/lmodel/common-domain-model/AlternativeToInterestAmountEnum#Standard>,
        <https://w3id.org/lmodel/common-domain-model/AlternativeToInterestAmountEnum#TransferIfDeliveryAmountBelowMTA> .

common_domain_model:AmendmentEffectiveDateEnum a owl:Class ;
    rdfs:label "AmendmentEffectiveDateEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum#AnnexDate> <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum#DeedDate> <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum#AgreementDate> <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum#AmendmentEffectiveDate> ) ;
    skos:definition "The enumerated values to specify the effective date of the Amendment to Termination Currency when specified as a specific date (e.g. the annex date)." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(t)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum#AgreementDate>,
        <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum#AmendmentEffectiveDate>,
        <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum#AnnexDate>,
        <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum#DeedDate> .

common_domain_model:AssetPayout a owl:Class ;
    rdfs:label "AssetPayout" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:tradeType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:minimumFee ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DividendTerms ;
            owl:onProperty common_domain_model:dividendTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dividendTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:minimumFee ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dividendTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Observable common_domain_model:Product ) ] common_domain_model:Asset ) ] ;
            owl:onProperty common_domain_model:underlier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AssetPayoutTradeTypeEnum ;
            owl:onProperty common_domain_model:tradeType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:minimumFee ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:tradeType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:assetLeg ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AssetLeg ;
            owl:onProperty common_domain_model:assetLeg ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:underlier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:underlier ],
        common_domain_model:PayoutBase ;
    skos:closeMatch fpml_5_10:AssetPayout ;
    skos:definition "Security finance payout specification in case the product payout involves some form of security collateral, as in a securities financing transaction. Plus additional description for ICMA." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Rosetta condition: Quantity — priceQuantity exists",
        "Rosetta condition: UnderlierNotCash — underlier -> Cash is absent" .

common_domain_model:Basket a owl:Class ;
    rdfs:label "Basket" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:basketConstituent ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BasketConstituent ;
            owl:onProperty common_domain_model:basketConstituent ],
        common_domain_model:AssetBase ;
    skos:definition "Defines a custom basket by referencing an identifier and its constituents." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Rosetta condition: AssetType — assetType = Security" .

common_domain_model:CalculationAgent a owl:Class ;
    rdfs:label "CalculationAgent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationAgentPartyEnum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:calculationAgentBusinessCenter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationAgentBusinessCenter ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PartyDeterminationEnum ;
            owl:onProperty common_domain_model:calculationAgentPartyEnum ],
        [ a owl:Restriction ;
