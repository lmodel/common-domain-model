common_domain_model:InflationCalculationMethodEnum\#Ratio a owl:Class ;
	rdfs:label "Ratio" ;
	rdfs:subClassOf common_domain_model:InflationCalculationMethodEnum ;
	skos:definition "(Inflation Index Final / Inflation Index Base). Inflation Index Final is inflation index for Reference Month that is the Lag number of months prior to Payment Date (subject to interpolation). Inflation Index Base subject to the Calculation Style. Used in inflation asset swaps to calculate the inflation coupons and principal exchange." .
common_domain_model:InflationCalculationMethodEnum\#Return a owl:Class ;
	rdfs:label "Return" ;
	rdfs:subClassOf common_domain_model:InflationCalculationMethodEnum ;
	skos:definition "(Inflation Index Final / Inflation Index Base -1). Inflation Index Final is the inflation index for Reference Month that is the Lag number of months prior to Payment Date (subject to interp). Inflation Index Base subject to the Calculation Style. Used in market standard ZC Inflation swaps." .
common_domain_model:InflationCalculationMethodEnum\#Spread a owl:Class ;
	rdfs:label "Spread" ;
	rdfs:subClassOf common_domain_model:InflationCalculationMethodEnum ;
	skos:definition "Inflation Index Final - Inflation Index Base). Inflation Index Final is Index for Ref month the Lag months prior to Payment Date (subject to interp). Inflation Index Base subject to the Calculation Style. Typically used for fixing locks." .
common_domain_model:InflationCalculationMethodEnum a owl:Class ;
	rdfs:label "InflationCalculationMethodEnum" ;
	owl:unionOf _:c14n4356 ;
	skos:definition "Indicates how to use the inflation index to calculate the payment (e.g. Ratio, Return, Spread). Added for Inflation Asset Swap" ;
	skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate ;
	linkml:permissible_values common_domain_model:InflationCalculationMethodEnum\#Ratio , common_domain_model:InflationCalculationMethodEnum\#Return , common_domain_model:InflationCalculationMethodEnum\#Spread .
common_domain_model:InflationCalculationStyleEnum\#YearOnYear a owl:Class ;
	rdfs:label "YearOnYear" ;
	rdfs:subClassOf common_domain_model:InflationCalculationStyleEnum ;
	skos:definition "YearOnYear means Inflation Index Base is the inflation index for Reference Month that is 12 months prior to Inflation Index Final (subject to interpolation). Inflation Index Base is cashflow dependent." .
common_domain_model:InflationCalculationStyleEnum\#ZeroCoupon a owl:Class ;
	rdfs:label "ZeroCoupon" ;
	rdfs:subClassOf common_domain_model:InflationCalculationStyleEnum ;
	skos:definition "ZeroCoupon means Inflation Index Base used in the CalculationMethod is the inflation index for the Reference Month that is the lag number of months prior to Effective Date in the case of a swap, or Bond Interest Accrual Date in the case of an Asset Swap (subject to interpolation). Inflation Index Base has the same value for each inflation cashflow and Principal Exchange calculation within the trade." .
common_domain_model:InflationCalculationStyleEnum a owl:Class ;
	rdfs:label "InflationCalculationStyleEnum" ;
	owl:unionOf _:c14n6154 ;
	skos:definition "Indicates the style of how the inflation index calculates the payment (e.g. YearOnYear, ZeroCoupon)." ;
	skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate ;
	linkml:permissible_values common_domain_model:InflationCalculationStyleEnum\#YearOnYear , common_domain_model:InflationCalculationStyleEnum\#ZeroCoupon .
