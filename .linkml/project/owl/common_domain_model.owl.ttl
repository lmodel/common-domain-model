common_domain_model:Measure a owl:Class ;
    rdfs:label "Measure" ;
    rdfs:subClassOf common_domain_model:MeasureBase ;
    skos:closeMatch gist:Magnitude ;
    skos:definition "Defines a concrete measure as a number associated to a unit. It extends MeasureBase by requiring the value attribute to be present. A measure may be unit-less so the unit attribute is still optional." ;
    skos:inScheme common_domain_model:cdm_base_math ;
    skos:note "Rosetta condition: ValueExists — value exists" .

common_domain_model:MeasureBase a owl:Class ;
    rdfs:label "MeasureBase" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:UnitType ;
            owl:onProperty common_domain_model:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:value ] ;
    skos:definition "Provides an abstract type to define a measure as a number associated to a unit. This type is abstract because all its attributes are optional. The types that extend it can specify further existence constraints." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:MeasureSchedule a owl:Class ;
    rdfs:label "MeasureSchedule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DatedValue ;
            owl:onProperty common_domain_model:datedValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:datedValue ],
        common_domain_model:MeasureBase ;
    skos:definition "A set of measures, all in the same unit, where the values are defined through a schedule of steps. The initial value may be defined either as part of the steps, or using the single amount attribute." ;
    skos:inScheme common_domain_model:cdm_base_math ;
    skos:note "Rosetta condition: ValueExists — value exists or datedValue exists" .

common_domain_model:Merger a owl:Class ;
    rdfs:label "Merger" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:acquiredSecurity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:acquiredSecurity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Security ;
            owl:onProperty common_domain_model:purchaserSecurity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Price ;
            owl:onProperty common_domain_model:purchaserSecurityPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:purchaserSecurityPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Security ;
            owl:onProperty common_domain_model:acquiredSecurity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Price ;
            owl:onProperty common_domain_model:acquiredSecurityPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:acquiredSecurityPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:purchaserSecurity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:acquiredSecurityPrice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:purchaserSecurity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:purchaserSecurityPrice ] ;
    skos:definition "Defines the underlier for both the Purchaser Company and the Acquired Compagny involved in Merger corporate action, as well as th respective price observation for each." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: EquityPrice — purchaserSecurity -> securityType = Equity and acquiredSecurity -> securityType = Equity" .

common_domain_model:MinimumTransferAmount a owl:Class ;
    rdfs:label "MinimumTransferAmount" ;
    rdfs:seeAlso isda:CSA_English_1995,
        isda:CSA_NewYork_1994,
        isda:CSA_VM_English_2016,
        isda:CSA_VM_NewYork_2016,
        isda:CSD_English_1995 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MinimumTransferAmountElection ;
            owl:onProperty common_domain_model:partyElection ] ;
    skos:definition "Represents the threshold specified in the agreement below which collateral need not be delivered, and represents the smallest incremental value of exposure that must be reached before the parties are obliged to transfer collateral." ;
    skos:editorialNote "ISDA CSA_English_1995 name \"Minimum Transfer Amount\"",
        "ISDA CSA_NewYork_1994 name \"Minimum Transfer Amount\"",
        "ISDA CSA_VM_English_2016 name \"Minimum Transfer Amount\"",
        "ISDA CSA_VM_NewYork_2016 name \"Minimum Transfer Amount\"",
        "ISDA CSD_English_1995 name \"Minimum Transfer Amount\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:MoneyBound a owl:Class ;
    rdfs:label "MoneyBound" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:inclusive ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:inclusive ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:money ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:money ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:inclusive ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:money ] ;
    skos:definition "The money bound is defined as a money amount and whether the bound is inclusive." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:MoneyMarketTypeEnum a owl:Class ;
    rdfs:label "MoneyMarketTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/MoneyMarketTypeEnum#CommercialPaper> <https://w3id.org/lmodel/common-domain-model/MoneyMarketTypeEnum#CertificateOfDeposit> ) ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/MoneyMarketTypeEnum#CertificateOfDeposit>,
        <https://w3id.org/lmodel/common-domain-model/MoneyMarketTypeEnum#CommercialPaper> .

<https://w3id.org/lmodel/common-domain-model/MoneyMarketTypeEnum#CertificateOfDeposit> a owl:Class ;
    rdfs:label "CertificateOfDeposit" ;
    rdfs:subClassOf common_domain_model:MoneyMarketTypeEnum .

<https://w3id.org/lmodel/common-domain-model/MoneyMarketTypeEnum#CommercialPaper> a owl:Class ;
    rdfs:label "CommercialPaper" ;
    rdfs:subClassOf common_domain_model:MoneyMarketTypeEnum .

common_domain_model:MoneyRange a owl:Class ;
    rdfs:label "MoneyRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:upperBound ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:lowerBound ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MoneyBound ;
            owl:onProperty common_domain_model:upperBound ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:upperBound ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MoneyBound ;
            owl:onProperty common_domain_model:lowerBound ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:lowerBound ] ;
    skos:definition "The money range defined as either a lower and upper money bound, or both." ;
    skos:inScheme common_domain_model:cdm_base_math ;
    skos:note "Rosetta condition: AtLeastOneOf — lowerBound exists or upperBound exists" .

common_domain_model:MultipleDebtTypes a owl:Class ;
    rdfs:label "MultipleDebtTypes" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:condition ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:QuantifierEnum ;
            owl:onProperty common_domain_model:condition ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:debtType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:condition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:debtType ] ;
    skos:definition "Represents a class to specify multiple credit debt types alongside a conditional 'any' or 'all' qualifier." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

<https://w3id.org/lmodel/common-domain-model/NationalizationOrInsolvencyOrDelistingEventEnum#CancellationAndPayment> a owl:Class ;
    rdfs:label "CancellationAndPayment" ;
    rdfs:subClassOf common_domain_model:NationalizationOrInsolvencyOrDelistingEventEnum ;
    skos:definition "The trade is terminated." .

<https://w3id.org/lmodel/common-domain-model/NationalizationOrInsolvencyOrDelistingEventEnum#NegotiatedCloseout> a owl:Class ;
    rdfs:label "NegotiatedCloseout" ;
    rdfs:subClassOf common_domain_model:NationalizationOrInsolvencyOrDelistingEventEnum ;
    skos:definition "The parties may, but are not obliged, to terminate the transaction on mutually acceptable terms and if the terms are not agreed then the transaction continues." .

common_domain_model:NaturalPersonRole a owl:Class ;
    rdfs:label "NaturalPersonRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NaturalPerson ;
            owl:onProperty common_domain_model:personReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NaturalPersonRoleEnum ;
            owl:onProperty common_domain_model:role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:personReference ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:personReference ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:role ] ;
    skos:closeMatch gist:Assignment,
        oscal:ResponsibleParty ;
    skos:definition "A class to specify the role(s) that natural person(s) may have in relation to the contract." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

<https://w3id.org/lmodel/common-domain-model/NaturalPersonRoleEnum#Broker> a owl:Class ;
    rdfs:label "Broker" ;
    rdfs:subClassOf common_domain_model:NaturalPersonRoleEnum ;
