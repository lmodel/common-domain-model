	skos:definition "A wrapper that encapsulates the specific ResetInstructionCompositionStepsEnum, allowing the engine to identify the exact phase of the Reset lifecycle currently being processed." ;
	skos:inScheme common_domain_model:cdm_event_instructioncomposition , common_domain_model:cdm_event_instructioncomposition_reset .
