        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:directTime ] ;
    skos:definition "Represents a time definition that can be either an absolute (direct) time or a time calculated relative to another referenced time. Either one directTime or one relativeTime should be provided" ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:DiscountingMethod a owl:Class ;
