common_domain_model:ConcentrationLimit a owl:Class ;
    rdfs:label "ConcentrationLimit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:concentrationLimitCriteria ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:valueLimit ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NumberRange ;
            owl:onProperty common_domain_model:percentageLimit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:valueLimit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:concentrationLimitCriteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ConcentrationLimitCriteria ;
            owl:onProperty common_domain_model:concentrationLimitCriteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MoneyRange ;
            owl:onProperty common_domain_model:valueLimit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:percentageLimit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:percentageLimit ] ;
    skos:definition "Represents a class to describe concentration limits that may be applicable to eligible collateral criteria." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:note "Rosetta condition: ConcentrationLimitValueChoice — required choice valueLimit, percentageLimit",
        "Rosetta condition: PercentageConcentrationLimit — if concentrationLimitCriteria -> concentrationLimitType = ConcentrationLimitTypeEnum -> MarketCapitalisation then percentageLimit exists" .

common_domain_model:ConcentrationLimitCriteria a owl:Class ;
    rdfs:label "ConcentrationLimitCriteria" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:concentrationLimitType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:averageTradingVolume ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AverageTradingVolume ;
            owl:onProperty common_domain_model:averageTradingVolume ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ConcentrationLimitTypeEnum ;
            owl:onProperty common_domain_model:concentrationLimitType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:averageTradingVolume ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:concentrationLimitType ],
        common_domain_model:CollateralCriteriaBase ;
    skos:definition "Respresents a class to describe a set of criteria to describe specific assets that the concentration limits apply to." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:note "Rosetta condition: ConcentrationLimitTypeChoice — required choice concentrationLimitType, averageTradingVolume, collateralCriteria" .

<https://w3id.org/lmodel/common-domain-model/ConcentrationLimitTypeEnum#Asset> a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:subClassOf common_domain_model:ConcentrationLimitTypeEnum ;
    skos:definition "Specifies a limit on a single asset in the eligible collateral schedule" .

