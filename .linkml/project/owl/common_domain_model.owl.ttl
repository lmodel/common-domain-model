        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AmendmentEffectiveDate ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectiveDate ] ;
    skos:definition " A class to specify whether Amendment to Minimum Transfer Amount language is applicable or not." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta condition: AmendmentNotApplicable — if isApplicable = False then effectiveDate is absent and partyElections is absent" .

common_domain_model:MultipleExercise a owl:Class ;
    rdfs:label "MultipleExercise" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:maximumNumberOfOptions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:maximumNotionalAmount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:maximumNotionalAmount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:maximumNumberOfOptions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:maximumNumberOfOptions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:maximumNotionalAmount ],
        common_domain_model:PartialExercise ;
    skos:definition "A class defining multiple exercises. As defined in the 2000 ISDA Definitions, Section 12.4. Multiple Exercise, the buyer of the option has the right to exercise all or less than all the unexercised notional amount of the underlying swap on one or more days in the exercise period, but on any such day may not exercise less than the minimum notional amount or more than the maximum notional amount, and if an integral multiple amount is specified, the notional exercised must be equal to or, be an integral multiple of, the integral multiple amount. In FpML, MultipleExercise is built upon the PartialExercise.model." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Rosetta condition: MaximumChoice — required choice maximumNotionalAmount, maximumNumberOfOptions",
        "Rosetta condition: MaximumNumberOfOptions — if maximumNumberOfOptions exists then maximumNotionalAmount >= 0",
        "Rosetta condition: MinimumNumberOfOptions — if minimumNumberOfOptions exists then minimumNumberOfOptions >= 0" .

common_domain_model:MultipleValuationDates a owl:Class ;
    rdfs:label "MultipleValuationDates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:businessDaysThereafter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:numberValuationDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessDaysThereafter ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:numberValuationDates ],
