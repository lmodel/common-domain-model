    skos:definition "A single, specifically identified Asset chosen from the Asset data type" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:SpecifiedEntity a owl:Class ;
    rdfs:label "SpecifiedEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:specifiedEntityTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:specifiedEntityTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:materialSubsidiaryTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:otherSpecifiedEntityTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:materialSubsidiaryTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:materialSubsidiaryTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalEntity ;
            owl:onProperty common_domain_model:specifiedEntity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SpecifiedEntityTermsEnum ;
            owl:onProperty common_domain_model:specifiedEntityTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:otherSpecifiedEntityTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:otherSpecifiedEntityTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:specifiedEntity ] ;
    skos:definition "The party specific election of Specified Entities for the Event of Default or Termination Event specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda ;
    skos:note "Rosetta condition: MaterialSubsidiary — if specifiedEntityTerms = SpecifiedEntityTermsEnum -> MaterialSubsidiary then materialSubsidiaryTerms exists",
        "Rosetta condition: OtherSpecifiedEntity — if specifiedEntityTerms = SpecifiedEntityTermsEnum -> OtherSpecifiedEntity then otherSpecifiedEntityTerms exists",
        "Rosetta condition: SpecifiedEntity — if specifiedEntityTerms = SpecifiedEntityTermsEnum -> NamedSpecifiedEntity then specifiedEntity exists" .

common_domain_model:ValuationAgentDeterminationEnum a owl:Class ;
    rdfs:label "ValuationAgentDeterminationEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SoleValuationAgent> <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SwitchUponDefault> <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#SwitchUponFailureToPerform> <https://w3id.org/lmodel/common-domain-model/ValuationAgentDeterminationEnum#FixedPartyForDisputes> ) ;
    skos:definition "Specifies how the Valuation Agent is determined." ;
