<http://www.fpml.org/coding-scheme/credit-event-type-1-0#Bankruptcy> a owl:Class ;
    rdfs:label "Bankruptcy" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "The reference entity has been dissolved or has become insolvent. It also covers events that may be a precursor to insolvency such as instigation of bankruptcy or insolvency proceedings. Sovereign trades are not subject to Bankruptcy as 'technically' a Sovereign cannot become bankrupt. ISDA 2003 Term: Bankruptcy." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#DistressedRatingsDowngrade> a owl:Class ;
    rdfs:label "DistressedRatingsDowngrade" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "Results from the fact that the rating of the reference obligation is downgraded to a distressed rating level. From a usage standpoint, this credit event is typically not applicable in case of RMBS trades." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#FailureToPay> a owl:Class ;
    rdfs:label "FailureToPay" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "This credit event triggers, after the expiration of any applicable grace period, if the reference entity fails to make due payments in an aggregrate amount of not less than the payment requirement on one or more obligations (e.g. a missed coupon payment). ISDA 2003 Term: Failure to Pay." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#FailureToPayInterest> a owl:Class ;
    rdfs:label "FailureToPayInterest" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "Corresponds to the failure by the Reference Entity to pay an expected interest amount or the payment of an actual interest amount that is less than the expected interest amount. ISDA 2003 Term: Failure to Pay Interest." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#FailureToPayPrincipal> a owl:Class ;
    rdfs:label "FailureToPayPrincipal" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "Corresponds to the failure by the Reference Entity to pay an expected principal amount or the payment of an actual principal amount that is less than the expected principal amount. ISDA 2003 Term: Failure to Pay Principal." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#GovernmentalIntervention> a owl:Class ;
    rdfs:label "GovernmentalIntervention" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "A governmental intervention is an event resulting from an action by a governmental authority that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2014 Term: Governmental Intervention." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#ImpliedWritedown> a owl:Class ;
    rdfs:label "ImpliedWritedown" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "Results from the fact that losses occur to the underlying instruments that do not result in reductions of the outstanding principal of the reference obligation." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#MaturityExtension> a owl:Class ;
    rdfs:label "MaturityExtension" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "Results from the fact that the underlier fails to make principal payments as expected." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#ObligationAcceleration> a owl:Class ;
    rdfs:label "ObligationAcceleration" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "One or more of the obligations have been declared due and payable before they would otherwise have been due and payable as a result of, or on the basis of, the occurrence of a default, event of default or other similar condition or event other than failure to pay (preferred by the market over Obligation Default, because more definitive and encompasses the definition of Obligation Default - this is more favorable to the Seller). Subject to the default requirement amount. ISDA 2003 Term: Obligation Acceleration." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#ObligationDefault> a owl:Class ;
    rdfs:label "ObligationDefault" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "One or more of the obligations have become capable of being declared due and payable before they would otherwise have been due and payable as a result of, or on the basis of, the occurrence of a default, event of default or other similar condition or event other than failure to pay. ISDA 2003 Term: Obligation Default." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#RepudiationMoratorium> a owl:Class ;
    rdfs:label "RepudiationMoratorium" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "The reference entity, or a governmental authority, either refuses to recognise or challenges the validity of one or more obligations of the reference entity, or imposes a moratorium thereby postponing payments on one or more of the obligations of the reference entity. Subject to the default requirement amount. ISDA 2003 Term: Repudiation/Moratorium." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#Restructuring> a owl:Class ;
    rdfs:label "Restructuring" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "A restructuring is an event that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2003 Term: Restructuring." .

<http://www.fpml.org/coding-scheme/credit-event-type-1-0#Writedown> a owl:Class ;
    rdfs:label "Writedown" ;
    rdfs:subClassOf common_domain_model:CreditEventTypeEnum ;
    skos:definition "Results from the fact that the underlier writes down its outstanding principal amount." .

<http://www.fpml.org/coding-scheme/credit-limit-type-1-1#CS01> a owl:Class ;
    rdfs:label "CS01" ;
    rdfs:subClassOf common_domain_model:CreditLimitTypeEnum ;
    skos:definition "The type of credit line expressed in CS01. The sensitivity with respect to changes in the CDS spread." .

<http://www.fpml.org/coding-scheme/credit-limit-type-1-1#DV01> a owl:Class ;
    rdfs:label "DV01" ;
    rdfs:subClassOf common_domain_model:CreditLimitTypeEnum ;
    skos:definition "The type of credit line expressed in DV01. The dollar value of a one basis point decrease in interest rates. It shows the change in a bond's price compared to a decrease in the bond's yield." .

<http://www.fpml.org/coding-scheme/credit-limit-type-1-1#IM> a owl:Class ;
    rdfs:label "IM" ;
    rdfs:subClassOf common_domain_model:CreditLimitTypeEnum ;
    skos:definition "The type of credit line expressed in Initial Margin value." .

<http://www.fpml.org/coding-scheme/credit-limit-type-1-1#Notional> a owl:Class ;
    rdfs:label "Notional" ;
    rdfs:subClassOf common_domain_model:CreditLimitTypeEnum ;
    skos:definition "The type of credit line expressed in Notional amount." .

<http://www.fpml.org/coding-scheme/credit-limit-type-1-1#PV01> a owl:Class ;
    rdfs:label "PV01" ;
    rdfs:subClassOf common_domain_model:CreditLimitTypeEnum ;
    skos:definition "The type of credit line expressed in PV01. The value of a one dollar or one basis point annuity." .

<http://www.fpml.org/coding-scheme/credit-rating-agency-1-0#AMBest> a owl:Class ;
    rdfs:label "AMBest" ;
    rdfs:subClassOf common_domain_model:CreditRatingAgencyEnum ;
    skos:definition "A. M. Best" .

