common_domain_model:RollSourceCalendarEnum a owl:Class ;
    rdfs:label "RollSourceCalendarEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/RollSourceCalendarEnum#ListedOption> <https://w3id.org/lmodel/common-domain-model/RollSourceCalendarEnum#Future> ) ;
    skos:definition "Used in conjunction with an exchange-based pricing source. Identifies a date source calendar from which the pricing dates and thus roll to the next contract will be based off (e.g. pricing is based on the NYMEX WTI First Nearby Futures Contract, if Future is chosen, the pricing will roll to the next futures contract on expiration, if ListedOption is chosen, the pricing will roll to the next futures contract on the Option expiration date which is three business days before the expiration of the NYMEX WTI futures contract.) Omitting this element will result in the default behavior expected with the pricing source described within the commodity element." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/RollSourceCalendarEnum#Future>,
        <https://w3id.org/lmodel/common-domain-model/RollSourceCalendarEnum#ListedOption> .

common_domain_model:RoundingFrequencyEnum a owl:Class ;
    rdfs:label "RoundingFrequencyEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/RoundingFrequencyEnum#Daily> <https://w3id.org/lmodel/common-domain-model/RoundingFrequencyEnum#PeriodEnd> ) ;
    skos:definition "How often is rounding performed" ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/RoundingFrequencyEnum#Daily>,
        <https://w3id.org/lmodel/common-domain-model/RoundingFrequencyEnum#PeriodEnd> .

common_domain_model:Schedule a owl:Class ;
    rdfs:label "Schedule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DatedValue ;
            owl:onProperty common_domain_model:datedValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:datedValue ] ;
    skos:definition "A class defining a schedule of rates or amounts in terms of an initial value and then a series of step date and value pairs. On each step date the rate or amount changes to the new step value. The series of step date and value pairs are optional. If not specified, this implies that the initial value remains unchanged over time." ;
    skos:inScheme common_domain_model:cdm_base_math ;
    skos:relatedMatch gist:ScheduledEvent .

common_domain_model:SecurityProviderRightsEvent a owl:Class ;
    rdfs:label "SecurityProviderRightsEvent" ;
    rdfs:seeAlso isda:CSA_IM_Japanese_2016,
        isda:CSA_IM_NewYork_2016,
        isda:CSD_IM_English_2016 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:customElection ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
