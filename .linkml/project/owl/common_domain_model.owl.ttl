common_domain_model:DayDistributionEnum a owl:Class ;
    rdfs:label "DayDistributionEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum#All> <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum#First> <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum#Last> <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum#Penultimate> ) ;
    skos:definition "Denotes the method by which the pricing days are distributed across the pricing period." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum#All>,
        <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum#First>,
        <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum#Last>,
        <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum#Penultimate> .

common_domain_model:DeliveryMethodEnum a owl:Class ;
    rdfs:label "DeliveryMethodEnum" ;
    owl:unionOf ( <http://www.fpml.org/coding-scheme/delivery-method-1-0#DeliveryVersusPayment> <http://www.fpml.org/coding-scheme/delivery-method-1-0#FreeOfPayment> <http://www.fpml.org/coding-scheme/delivery-method-1-0#PreDelivery> <http://www.fpml.org/coding-scheme/delivery-method-1-0#PrePayment> ) ;
    skos:definition "Specifies delivery methods for securities transactions. This coding-scheme defines the possible delivery methods for securities." ;
    skos:exactMatch fpml:delivery-method ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    linkml:permissible_values <http://www.fpml.org/coding-scheme/delivery-method-1-0#DeliveryVersusPayment>,
        <http://www.fpml.org/coding-scheme/delivery-method-1-0#FreeOfPayment>,
        <http://www.fpml.org/coding-scheme/delivery-method-1-0#PreDelivery>,
        <http://www.fpml.org/coding-scheme/delivery-method-1-0#PrePayment> .

