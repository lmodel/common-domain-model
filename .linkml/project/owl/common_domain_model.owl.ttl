	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:EscrowArrangement a owl:Class ;
	rdfs:label "EscrowArrangement" ;
	rdfs:subClassOf _:c14n10246 , _:c14n12100 , _:c14n2461 , _:c14n4289 , _:c14n4722 , _:c14n5052 , _:c14n7038 , _:c14n8189 , _:c14n9336 ;
