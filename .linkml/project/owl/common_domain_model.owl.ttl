        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustedExerciseDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:adjustedExerciseDate ] ;
    skos:closeMatch fpml_5_10:CancellationEvent ;
    skos:definition "The adjusted dates for a specific cancellation date, including the adjusted exercise date and adjusted termination date." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    common_domain_model:metadata_key true .

