common_domain_model:AssetBackedEnum a owl:Class ;
    rdfs:label "AssetBackedEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AssetBackedEnum#HomeEquity> <https://w3id.org/lmodel/common-domain-model/AssetBackedEnum#AutoLoan> <https://w3id.org/lmodel/common-domain-model/AssetBackedEnum#StudentLoan> <https://w3id.org/lmodel/common-domain-model/AssetBackedEnum#CreditCard> <https://w3id.org/lmodel/common-domain-model/AssetBackedEnum#Property> <https://w3id.org/lmodel/common-domain-model/AssetBackedEnum#Mortgage> <https://w3id.org/lmodel/common-domain-model/AssetBackedEnum#Other> ) ;
