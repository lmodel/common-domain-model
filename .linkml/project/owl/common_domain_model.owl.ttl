common_domain_model:PortfolioReturnTerms a owl:Class ;
    rdfs:label "PortfolioReturnTerms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:underlier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:finalValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:finalValuationPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:interimValuationPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NonNegativeQuantitySchedule ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Observable common_domain_model:Product ) ] common_domain_model:Observable ) ] ;
            owl:onProperty common_domain_model:underlier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PayerReceiver ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:interimValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:underlier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:initialValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialValuationPrice ],
        common_domain_model:ReturnTerms ;
    skos:definition "Specifies an individual type of return of a Performance Payout, when such individual return is part of an aggregation of multiple similar returns, at Performance Payout level." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    common_domain_model:metadata_key true .

common_domain_model:Position a owl:Class ;
    rdfs:label "Position" ;
    rdfs:subClassOf common_domain_model:PositionBase ;
    skos:definition "A Position describes how much of a given Product is being held and constitutes the atomic element of a Portfolio." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:PositionBase a owl:Class ;
    rdfs:label "PositionBase" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:asset ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:product ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:priceQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:cashBalance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:cashBalance ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TradeState ;
            owl:onProperty common_domain_model:tradeReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Product ;
            owl:onProperty common_domain_model:product ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceQuantity ;
            owl:onProperty common_domain_model:priceQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Cash common_domain_model:Commodity common_domain_model:DigitalAsset common_domain_model:Instrument ) ] common_domain_model:Asset ) ] ;
            owl:onProperty common_domain_model:asset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:cashBalance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:asset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:tradeReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:product ] ;
    skos:definition "Base class to describe a Position, which could be a group of products (e.g. trade portfolio) or a group of assets (e.g. collateral portfolio)." ;
    skos:inScheme common_domain_model:cdm_event_position ;
    skos:note "Rosetta condition: ProductOrAsset — required choice product, asset" .

<https://w3id.org/lmodel/common-domain-model/PositionEventIntentEnum#CorporateActionAdjustment> a owl:Class ;
