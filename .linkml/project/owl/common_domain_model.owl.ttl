        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableDate ;
            owl:onProperty common_domain_model:finalFixingDate ] ;
    skos:definition "A data defining:  the parameters used to generate the reset dates schedule and associated fixing dates. The reset dates are the dates on which the new index value (which is observed on the fixing date) is applied for each period and on which the interest rate hence begins to accrue." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    skos:note "Rosetta condition: NonWeeklyPeriod — if resetFrequency -> period <> PeriodExtendedEnum -> W then resetFrequency -> weeklyRollConvention is absent",
        "Rosetta condition: RateCutOffDaysOffset — if rateCutOffDaysOffset exists then rateCutOffDaysOffset -> periodMultiplier < 0",
        "Rosetta condition: WeeklyPeriod — if resetFrequency -> period = PeriodExtendedEnum -> W then resetFrequency -> weeklyRollConvention exists" ;
    common_domain_model:metadata_key true .

common_domain_model:ResetFrequency a owl:Class ;
    rdfs:label "ResetFrequency" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:WeeklyRollConventionEnum ;
            owl:onProperty common_domain_model:weeklyRollConvention ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:weeklyRollConvention ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:weeklyRollConvention ],
        common_domain_model:Frequency ;
    skos:definition "A class defining the reset frequency. In the case of a weekly reset, also specifies the day of the week that the reset occurs. If the reset frequency is greater than the calculation period frequency the this implies that more or more reset dates is established for each calculation period and some form of rate averaging is applicable. The specific averaging method of calculation is specified in FloatingRateCalculation. In case the reset frequency is of value T (term), the period is defined by the swap/swapStream/calculationPerioDates/effectiveDate and the swap/swapStream/calculationPerioDates/terminationDate." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    skos:note "Rosetta condition: FpML_ird_49 — if weeklyRollConvention exists then period = PeriodExtendedEnum -> W" .

common_domain_model:ResetInstruction a owl:Class ;
    rdfs:label "ResetInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:rateRecordDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AssetPayout common_domain_model:CommodityPayout common_domain_model:CreditDefaultPayout common_domain_model:FixedPricePayout common_domain_model:InterestRatePayout common_domain_model:OptionPayout common_domain_model:PerformancePayout common_domain_model:SettlementPayout ) ] common_domain_model:Payout ) ] ;
            owl:onProperty common_domain_model:payout ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:payout ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:resetDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:resetDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:rateRecordDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:rateRecordDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:resetDate ] ;
    skos:definition "Defines the information needed to create a Reset Business Event. " ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta func: Create_Reset — Defines how a Reset should be constructed." ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_Reset\",\"description\":\"Defines how a Reset should be constructed.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"ResetInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"reset\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" .

