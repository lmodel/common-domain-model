	skos:definition "Defines the assets and movements in a security financing transaction." , "Security finance payout specification in case the product payout involves some form of security collateral, as in a securities financing transaction. Plus additional description for ICMA." ;
	skos:inScheme common_domain_model:cdm_product_template ;
