common_domain_model:StockSplitInstruction a owl:Class ;
    rdfs:label "StockSplitInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:adjustmentRatio ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
