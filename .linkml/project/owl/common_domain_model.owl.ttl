common_domain_model:SecuredDebt a owl:Class ;
    rdfs:label "SecuredDebt" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:assetBacked ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:propertyType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SecuredTypeEnum ;
            owl:onProperty common_domain_model:securedType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CollateralizedObligationEnum ;
            owl:onProperty common_domain_model:collateralizedObligation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:securedType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CoveredBondEnum ;
            owl:onProperty common_domain_model:coveredBond ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:securedType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:collateralizedObligation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:collateralizedObligation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:coveredBond ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PropertyTypeEnum ;
            owl:onProperty common_domain_model:propertyType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:propertyType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AssetBackedEnum ;
            owl:onProperty common_domain_model:assetBacked ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:assetBacked ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:coveredBond ] ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    skos:note "Rosetta condition: AssetBackedExists — if securedType <> SecuredTypeEnum -> AssetBacked then assetBacked is absent",
        "Rosetta condition: CollateralizedObligationExists — if securedType <> CollateralizedObligation then collateralizedObligation is absent",
        "Rosetta condition: CoveredBondsExists — if securedType <> CoveredBonds then coveredBond is absent",
        "Rosetta condition: PropertyExists — if assetBacked <> Mortgage or assetBacked <> Property or collateralizedObligation <> CMO then propertyType is absent" .

common_domain_model:SecuredTypeEnum a owl:Class ;
    rdfs:label "SecuredTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/SecuredTypeEnum#AssetBacked> <https://w3id.org/lmodel/common-domain-model/SecuredTypeEnum#CollateralizedObligation> <https://w3id.org/lmodel/common-domain-model/SecuredTypeEnum#CoveredBonds> ) ;
