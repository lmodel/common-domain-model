    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AveragingWeightingMethodEnum#Unweighted> <https://w3id.org/lmodel/common-domain-model/AveragingWeightingMethodEnum#Weighted> ) ;
    skos:definition "The enumerated values to specify the method of calculation to be used when averaging rates. Per ISDA 2000 Definitions, Section 6.2. Certain Definitions Relating to Floating Amounts." ;
