common_domain_model:TimeTypeEnum a owl:Class ;
    rdfs:label "TimeTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/TimeTypeEnum#Close> <https://w3id.org/lmodel/common-domain-model/TimeTypeEnum#Open> <https://w3id.org/lmodel/common-domain-model/TimeTypeEnum#OSP> <https://w3id.org/lmodel/common-domain-model/TimeTypeEnum#SpecificTime> <https://w3id.org/lmodel/common-domain-model/TimeTypeEnum#XETRA> <https://w3id.org/lmodel/common-domain-model/TimeTypeEnum#DerivativesClose> <https://w3id.org/lmodel/common-domain-model/TimeTypeEnum#AsSpecifiedInMasterConfirmation> ) ;
