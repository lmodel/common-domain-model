            owl:onProperty common_domain_model:dateOfBirth ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:suffix ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:firstName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:firstName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:contactInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:honorific ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dateOfBirth ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:middleName ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initial ],
        [ a owl:Restriction ;
