common_domain_model:custodyArrangements a owl:ObjectProperty ;
    rdfs:label "custodyArrangements" ;
    rdfs:range common_domain_model:CustodyArrangements ;
    skos:definition "The Custodian and Segregated Account details in respect of each party to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:customProvision a owl:DatatypeProperty ;
    rdfs:label "customProvision" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:dayType a owl:ObjectProperty ;
    rdfs:label "dayType" ;
    rdfs:range common_domain_model:DayTypeEnum ;
    skos:definition "In the case of an offset specified as a number of days, this element defines whether consideration is given as to whether a day is a good business day or not. If a day type of business days is specified then non-business days are ignored when calculating the offset. The financial business centers to use for determination of business days are implied by the context in which this element is used. This element must only be included when the offset is specified as a number of days. If the offset is zero days then the dayType element should not be included." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:delivery a owl:ObjectProperty ;
    rdfs:label "delivery" ;
    rdfs:range common_domain_model:AssetDeliveryInformation ;
    skos:closeMatch fpml_5_10:CommodityPayout.delivery ;
    skos:definition "Contains the information relative to the delivery of the asset." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:deliveryCapacity a owl:ObjectProperty ;
    rdfs:label "deliveryCapacity" ;
    rdfs:range common_domain_model:Quantity ;
    skos:closeMatch fpml_5_10:AssetDeliveryInformation.deliveryCapacity ;
    skos:definition "The number of units included in the transaction for each delivery interval" ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:excluded a owl:DatatypeProperty ;
    rdfs:label "excluded" ;
    rdfs:range xsd:string ;
    skos:definition "A free format string to specify any excluded obligations or deliverable obligations, as the case may be, of the reference entity or excluded types of obligations or deliverable obligations. ISDA 2003 Term: Excluded Obligations/Excluded Deliverable Obligations." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:executionDetails a owl:ObjectProperty ;
    rdfs:label "executionDetails" ;
    rdfs:range common_domain_model:ExecutionDetails ;
    skos:definition "Specifies the type and venue of execution, e.g. via voice, or electronically." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:fixedRate a owl:DatatypeProperty ;
    rdfs:label "fixedRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The value of the fixed rate that was used." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:fxHaircutCurrency a owl:ObjectProperty ;
    rdfs:label "fxHaircutCurrency" ;
    rdfs:range common_domain_model:FxHaircutCurrency ;
    skos:definition "The reference currency for the purpose of specifying the FX Haircut relating to a posting obligation, as being either the Termination Currency or an FX Designated Currency." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:fxSpotRateSource a owl:ObjectProperty ;
    rdfs:label "fxSpotRateSource" ;
    rdfs:range common_domain_model:FxSpotRateSource ;
    skos:definition "The information source and time at which the spot currency exchange rate will be observed." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:identifer a owl:ObjectProperty ;
    rdfs:label "identifer" ;
    rdfs:range common_domain_model:AssignedIdentifier ;
    skos:definition "Unique identifier for this record. This can be used to uniquely identify a specific piece of inventory." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:inclusive a owl:DatatypeProperty ;
    rdfs:label "inclusive" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies whether the period bound is inclusive, e.g. for a lower bound, false would indicate greater than, whereas true would indicate greater than or equal to." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:jurisdictionRelatedTerms a owl:ObjectProperty ;
    rdfs:label "jurisdictionRelatedTerms" ;
    rdfs:range common_domain_model:JurisdictionRelatedTerms ;
    skos:definition "The jurisdiction specific terms relevant to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:lowerBound a owl:ObjectProperty ;
    rdfs:label "lowerBound" ;
    rdfs:range common_domain_model:PeriodBound ;
    skos:definition "Specifies the lower bound of a period range, e.g. greater than or equal to 5Y." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:marginApproach a owl:ObjectProperty ;
    rdfs:label "marginApproach" ;
    rdfs:range common_domain_model:MarginApproachEnum ;
    skos:definition "Specifies the margin approach specific to Initial Margin agreements." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:noticeDeadlineDateTime a owl:DatatypeProperty ;
    rdfs:label "noticeDeadlineDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "A specific date and time for the notice deadline" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:noticeDeadlinePeriod a owl:ObjectProperty ;
    rdfs:label "noticeDeadlinePeriod" ;
    rdfs:range common_domain_model:Period ;
    skos:definition "Defines the min period for notify of a substitution." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:notionalReference a owl:ObjectProperty ;
    rdfs:label "notionalReference" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "A pointer style reference to the associated notional schedule defined elsewhere in the document." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    common_domain_model:metadata_reference true .

common_domain_model:observationTerms a owl:ObjectProperty ;
    rdfs:label "observationTerms" ;
    rdfs:range common_domain_model:ObservationTerms ;
    skos:definition "Class containing terms that are associated with observing a price/benchmark/index across either single or multple observations. To be used for option contracts that reference a benchmark price." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:offsetDays a owl:DatatypeProperty ;
    rdfs:label "offsetDays" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculationFrequency.offsetDays ;
    skos:definition "Specifies how many days from the trigger event should the payment occur." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:otherAgreements a owl:ObjectProperty ;
    rdfs:label "otherAgreements" ;
    rdfs:range common_domain_model:OtherAgreements ;
    skos:definition "The bespoke definition of other agreement terms as specified by the parties to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:performance a owl:DatatypeProperty ;
    rdfs:label "performance" ;
    rdfs:range xsd:string ;
    skos:definition "Performance calculation, in accordance with Part 1 Section 12 of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap, Para 75. 'Equity Performance'. Cumulative performance is used as a notional multiplier factor on both legs of an Equity Swap." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:precision a owl:DatatypeProperty ;
    rdfs:label "precision" ;
    rdfs:range xsd:integer ;
    skos:definition "Specifies the rounding precision in terms of a number of decimal places when the number is evaluated in decimal form (not percentage), e.g. 0.09876543 rounded to the nearest 5 decimal places is  0.0987654." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:processAgent a owl:ObjectProperty ;
    rdfs:label "processAgent" ;
    rdfs:range common_domain_model:ProcessAgent ;
    skos:definition "The Process Agent that might be appointed by the parties to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:quotedCurrencyPair a owl:ObjectProperty ;
    rdfs:label "quotedCurrencyPair" ;
    rdfs:range common_domain_model:QuotedCurrencyPair ;
    skos:definition "Describes the composition of a rate that has been quoted or is to be quoted." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:ratingsBased a owl:ObjectProperty ;
    rdfs:label "ratingsBased" ;
    rdfs:range common_domain_model:ThresholdRatingsBased ;
    skos:definition "Defines that the Threshold is based on a Ratings condition(s)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:relativeDate a owl:ObjectProperty ;
    rdfs:label "relativeDate" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:closeMatch fpml_5_10:AdjustableOrAdjustedOrRelativeDate.relativeDate ;
    skos:definition "A date specified as some offset to another date (the anchor date)." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:seller a owl:ObjectProperty ;
    rdfs:label "seller" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:closeMatch fpml_5_10:BuyerSeller.seller ;
    skos:definition "Seller party that can be resolved as one of the two principal parties to the transaction. The party that sells ('writes') this instrument, i.e. that grants the rights defined by this instrument and in return receives a payment for it. ISDA 2002 Equity Definitions section 1.19: `Seller` means the party specified as such in the related Confirmation. | ISDA 2006 Definitions article 12.1 (a)(i) relating to a Swaption: 'Seller' means the party the party specified as such or as writer in the related Confirmation | ISDA 2006 Definitions article 12.1 (a)(ii) relating to Swap Transactions with applicable Early Termination: the party specified as such or as writer in the related Confirmation or, if neither party is specified as such, the Non-exercising Party | ISDA 2006 Definitions article 12.1 (a)(iii) relating to any other Option Transaction: the party specified as such in the related Confirmation. | ISDA 2014 Credit Definition article 1.4: `Seller` means the Floating Rate Payer." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:singlePartyOption a owl:ObjectProperty ;
    rdfs:label "singlePartyOption" ;
    rdfs:range common_domain_model:PartyRole ;
    skos:definition "If the ability to extend the contract is not available to both parties then this component specifies the buyer and seller of the option." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:threshold a owl:ObjectProperty ;
    rdfs:label "threshold" ;
    rdfs:range common_domain_model:Threshold ;
    skos:definition "Represents the amount of unsecured risk that a party is willing to tolerate without holding any posted collateral provided by the other party." ;
    skos:editorialNote "ISDA CSA_English_1995",
        "ISDA CSA_NewYork_1994",
        "ISDA CSA_VM_English_2016",
        "ISDA CSA_VM_NewYork_2016",
        "ISDA CSD_English_1995" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:time a owl:DatatypeProperty ;
    rdfs:label "time" ;
    rdfs:range xsd:time ;
    skos:definition "The observation time." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:tradeState a owl:ObjectProperty ;
    rdfs:label "tradeState" ;
    rdfs:range common_domain_model:TradeState ;
    skos:closeMatch fpml_5_10:CalculateTransferInstruction.tradeState ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:tranche a owl:DatatypeProperty ;
    rdfs:label "tranche" ;
    rdfs:range xsd:string ;
    skos:definition "Denotes the loan tranche that is subject to the derivative transaction. It will typically be referenced as the Bloomberg tranche number. ISDA Standards Terms Supplement term: Bloomberg Tranche Number." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:treatment a owl:ObjectProperty ;
    rdfs:label "treatment" ;
    rdfs:range common_domain_model:CollateralTreatment ;
    skos:closeMatch fpml_5_10:CollateralPosition.treatment ;
    skos:definition "Specifies if there is any treatment to be applied to collateral, such as percentage discount which will impact collateral value." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:unit a owl:ObjectProperty ;
    rdfs:label "unit" ;
    rdfs:range common_domain_model:UnitType ;
    skos:definition "Qualifies the unit by which the amount is measured. Optional because a measure may be unit-less (e.g. when representing a ratio between amounts in the same unit)." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:upperBound a owl:ObjectProperty ;
    rdfs:label "upperBound" ;
    rdfs:range common_domain_model:PeriodBound ;
    skos:definition "Specifies the upper bound of a period range, e.g. less than to 10Y." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:valuationAgent a owl:ObjectProperty ;
    rdfs:label "valuationAgent" ;
    rdfs:range common_domain_model:ValuationAgent ;
    skos:closeMatch fpml_5_10:CalculationAndTimingLegacy.valuationAgent ;
    skos:definition "Details of the party calculating the value of collateral to be delivered or returned." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:valuationDates a owl:ObjectProperty ;
    rdfs:label "valuationDates" ;
    rdfs:range common_domain_model:ValuationDates ;
    skos:definition "The parameters used to generate the 'Equity Valuation Dates' schedule, including the Effective Date and Termination Date for the Swap." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CodeListIdentification.version ;
    skos:definition "The the most recent version of the codelist, eg. 9-1" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:AssetTypeEnum a owl:Class ;
    rdfs:label "AssetTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Security> <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Cash> <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Commodity> <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#ListedDerivative> <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Loan> <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#LetterOfCredit> <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Other> ) ;
    skos:definition "Represents an enumeration list to identify the asset type." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Cash>,
        <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Commodity>,
        <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#LetterOfCredit>,
        <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#ListedDerivative>,
        <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Loan>,
        <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Other>,
        <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum#Security> .

common_domain_model:CalculationPeriodDates a owl:Class ;
    rdfs:label "CalculationPeriodDates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:lastRegularPeriodEndDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CalculationPeriodFrequency ;
            owl:onProperty common_domain_model:calculationPeriodFrequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:calculationPeriodFrequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:terminationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:firstRegularPeriodStartDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:lastRegularPeriodEndDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:terminationDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:calculationPeriodDatesAdjustments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:terminationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:firstCompoundingPeriodEndDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:firstCompoundingPeriodEndDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:firstRegularPeriodStartDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:firstPeriodStartDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:lastRegularPeriodEndDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:stubPeriodType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationPeriodFrequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationPeriodDatesAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:firstRegularPeriodStartDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:firstPeriodStartDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:StubPeriodTypeEnum ;
            owl:onProperty common_domain_model:stubPeriodType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:firstPeriodStartDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:calculationPeriodDatesAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:firstCompoundingPeriodEndDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:effectiveDate ] ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates ;
    skos:definition "A data for:  defining the parameters used to generate the calculation period dates schedule, including the specification of any initial or final stub calculation periods. A calculation period schedule consists of an optional initial stub calculation period, one or more regular calculation periods and an optional final stub calculation period. In the absence of any initial or final stub calculation periods, the regular part of the calculation period schedule is assumed to be between the effective date and the termination date. No implicit stubs are allowed, i.e. stubs must be explicitly specified using an appropriate combination of firstPeriodStartDate, firstRegularPeriodStartDate and lastRegularPeriodEndDate." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    skos:note "Rosetta condition: FpML_ird_16 — if firstRegularPeriodStartDate exists then terminationDate -> adjustableDate -> unadjustedDate > firstRegularPeriodStartDate",
        "Rosetta condition: FpML_ird_17 — if lastRegularPeriodEndDate exists then terminationDate -> adjustableDate -> unadjustedDate > lastRegularPeriodEndDate",
        "Rosetta condition: FpML_ird_18 — if firstRegularPeriodStartDate exists and lastRegularPeriodEndDate exists then lastRegularPeriodEndDate > firstRegularPeriodStartDate",
        "Rosetta condition: FpML_ird_20 — if lastRegularPeriodEndDate exists then lastRegularPeriodEndDate > effectiveDate -> adjustableDate -> unadjustedDate",
        "Rosetta condition: FpML_ird_21 — if firstPeriodStartDate exists and effectiveDate exists then firstPeriodStartDate -> adjustableDate -> unadjustedDate < effectiveDate -> adjustableDate -> unadjustedDate",
        "Rosetta condition: FpML_ird_22 — if firstPeriodStartDate exists and firstRegularPeriodStartDate exists then firstPeriodStartDate -> adjustableDate -> unadjustedDate < firstRegularPeriodStartDate",
        "Rosetta func: CalculationPeriod — 2006 ISDA Definition Section 4.13. 'Calculation Period' means, in respect of a Swap Transaction and a party, each period from, and including, one Period End Date of that party to, but excluding, the next following applicable Period End Date during the Term of the Swap Transaction, except that (a) the initial Calculation Period for the party will commence on, and include, the Effective Date and (b) the final Calculation Period for the party will end on, but exclude, the Termination Date.",
        "Rosetta func: CalculationPeriods — 2006 ISDA Definition Section 4.13. 'Calculation Period' means, in respect of a Swap Transaction and a party, each period from, and including, one Period End Date of that party to, but excluding, the next following applicable Period End Date during the Term of the Swap Transaction, except that (a) the initial Calculation Period for the party will commence on, and include, the Effective Date and (b) the final Calculation Period for the party will end on, but exclude, the Termination Date." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"CalculationPeriod\",\"description\":\"2006 ISDA Definition Section 4.13. 'Calculation Period' means, in respect of a Swap Transaction and a party, each period from, and including, one Period End Date of that party to, but excluding, the next following applicable Period End Date during the Term of the Swap Transaction, except that (a) the initial Calculation Period for the party will commence on, and include, the Effective Date and (b) the final Calculation Period for the party will end on, but exclude, the Termination Date.\",\"inputs\":[{\"name\":\"calculationPeriodDates\",\"type\":\"CalculationPeriodDates\",\"cardinality\":\"1..1\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"CalculationPeriodData\",\"cardinality\":\"1..1\"},\"code_implementation\":true},{\"name\":\"CalculationPeriods\",\"description\":\"2006 ISDA Definition Section 4.13. 'Calculation Period' means, in respect of a Swap Transaction and a party, each period from, and including, one Period End Date of that party to, but excluding, the next following applicable Period End Date during the Term of the Swap Transaction, except that (a) the initial Calculation Period for the party will commence on, and include, the Effective Date and (b) the final Calculation Period for the party will end on, but exclude, the Termination Date.\",\"inputs\":[{\"name\":\"calculationPeriodDates\",\"type\":\"CalculationPeriodDates\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"CalculationPeriodData\",\"cardinality\":\"0..*\"},\"code_implementation\":true}]" .

common_domain_model:CustomisableOffset a owl:Class ;
    rdfs:label "CustomisableOffset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:offset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:offset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:customProvision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:customProvision ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:customProvision ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Offset ;
            owl:onProperty common_domain_model:offset ] ;
    skos:definition "A class to specify an offset either as a normalized [multiplier, period, dayType] or as a custom provision of type string." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:DebtInterestEnum a owl:Class ;
    rdfs:label "DebtInterestEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#Fixed> <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#Floating> <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InflationLinked> <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#IndexLinked> <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InterestOnly> <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#OtherStructured> <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InverseFloating> <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#ZeroCoupon> ) ;
    skos:definition "Represents an enumeration list that specifies the general rule for periodic interest rate payment." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#Fixed>,
        <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#Floating>,
        <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#IndexLinked>,
        <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InflationLinked>,
        <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InterestOnly>,
        <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InverseFloating>,
        <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#OtherStructured>,
        <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#ZeroCoupon> .

common_domain_model:DebtPrincipalEnum a owl:Class ;
    rdfs:label "DebtPrincipalEnum" ;
