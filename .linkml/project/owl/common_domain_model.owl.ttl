common_domain_model:DebtInterestEnum\#Fixed a owl:Class ;
	rdfs:label "Fixed" ;
	rdfs:subClassOf common_domain_model:DebtInterestEnum ;
	skos:definition "Denotes payment calculated with reference to a fixed interest rate." .
common_domain_model:DebtInterestEnum\#Floating a owl:Class ;
	rdfs:label "Floating" ;
	rdfs:subClassOf common_domain_model:DebtInterestEnum ;
	skos:definition "Denotes payment calculated with reference to a floating interest rate." .
common_domain_model:DebtInterestEnum\#IndexLinked a owl:Class ;
	rdfs:label "IndexLinked" ;
	rdfs:subClassOf common_domain_model:DebtInterestEnum ;
