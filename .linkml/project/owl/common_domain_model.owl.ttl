@prefix common_domain_model: <https://w3id.org/lmodel/common-domain-model/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fpml: <http://www.fpml.org/coding-scheme/> .
@prefix fpml_5_10: <https://www.fpml.org/spec/fpml-5-10#> .
@prefix gist: <https://w3id.org/lmodel/gist/> .
@prefix icma: <https://www.icmagroup.org/market-practice-and-regulatory-policy/> .
@prefix isda: <https://www.isda.org/specifications/> .
@prefix iso29100: <https://w3id.org/lmodel/iso29100/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix oscal: <https://w3id.org/lmodel/oscal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <https://spdx.org/rdf/3.0.1/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/lmodel/common-domain-model.owl.ttl> a owl:Ontology ;
    rdfs:label "common_domain_model" ;
    dcterms:license "Apache-2.0" ;
    dcterms:source <https://github.com/finos/common-domain-model/tree/master/rosetta-source/src/main/rosetta> ;
    rdfs:seeAlso <https://cdm.finos.org/>,
        <https://github.com/finos/common-domain-model> ;
    skos:definition "FINOS Common Domain Model (CDM) — LinkML schema" .

common_domain_model:AdditionalTerminationEvent a owl:Class ;
    rdfs:label "AdditionalTerminationEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:applicableParty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:applicableParty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:name ] ;
    skos:closeMatch fpml_5_10:AdditionalTerminationEvent ;
    skos:definition "A class to specify an optional termination event, additional to the Termination Events that will be deemed an Access Condition (Initial Margin CSA) or a Specified Condition (Variation Margin CSA)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:AssetFlow a owl:Class ;
    rdfs:label "AssetFlow" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:assetFlowType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ScheduledTransferEnum ;
            owl:onProperty common_domain_model:assetFlowType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PayerReceiver ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:assetFlowType ],
        common_domain_model:AssetFlowBase ;
    skos:closeMatch fpml_5_10:AssetFlow ;
    skos:definition "Specifies an asset flow, i.e. the outcome of either of computation (e.g. interest accrual) or an assessment of some sort. The asset flow can then be turned into an asset transfer artefact to be used as the input to a payment system or the outcome of it. The associated globalKey denotes the ability to associate a hash value to the AssetFlow instantiations for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:BillingInstruction a owl:Class ;
    rdfs:label "BillingInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:receivingParty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:billingEndDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:billingSummary ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:billingRecordInstruction ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:sendingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:billingEndDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BillingRecordInstruction ;
            owl:onProperty common_domain_model:billingRecordInstruction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:sendingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:billingStartDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:billingStartDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:sendingParty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:receivingParty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:billingEndDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:billingStartDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:receivingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BillingSummaryInstruction ;
            owl:onProperty common_domain_model:billingSummary ] ;
    skos:closeMatch fpml_5_10:BillingInstruction ;
    skos:definition "Specifies the instructions for creation of a Security Lending billing invoice." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta func: Create_SecurityLendingInvoice — Defines the process of calculating and creating a Security Lending Invoice." ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_SecurityLendingInvoice\",\"description\":\"Defines the process of calculating and creating a Security Lending Invoice.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"BillingInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"invoice\",\"type\":\"SecurityLendingInvoice\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:BoundedCorrelation a owl:Class ;
    rdfs:label "BoundedCorrelation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:minimumBoundaryPercent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:maximumBoundaryPercent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:minimumBoundaryPercent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:maximumBoundaryPercent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:maximumBoundaryPercent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:minimumBoundaryPercent ] ;
    skos:closeMatch fpml_5_10:BoundedCorrelation ;
    skos:definition "Describes correlation bounds, which form a cap and a floor on the realized correlation." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:BrokerConfirmation a owl:Class ;
    rdfs:label "BrokerConfirmation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BrokerConfirmationTypeEnum ;
            owl:onProperty common_domain_model:brokerConfirmationType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:brokerConfirmationType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:brokerConfirmationType ] ;
    skos:definition "Identifies the market sector in which the trade has been arranged." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:CalculateTransferInstruction a owl:Class ;
    rdfs:label "CalculateTransferInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:payout ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:resets ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:tradeState ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:date ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TradeState ;
            owl:onProperty common_domain_model:tradeState ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:tradeState ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Reset ;
            owl:onProperty common_domain_model:resets ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PayerReceiver ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Quantity ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:payerReceiver ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AssetPayout common_domain_model:CommodityPayout common_domain_model:CreditDefaultPayout common_domain_model:FixedPricePayout common_domain_model:InterestRatePayout common_domain_model:OptionPayout common_domain_model:PerformancePayout common_domain_model:SettlementPayout ) ] common_domain_model:Payout ) ] ;
            owl:onProperty common_domain_model:payout ] ;
    skos:closeMatch fpml_5_10:CalculateTransferInstruction ;
    skos:definition "Defines the tradeState or payout on which to create a Transfer along with all necessary resets." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta func: CalculateTransfer — Function specification to calculate a transfer, e.g. following a reset on a contract",
        "Rosetta func: Create_AssetTransfer — Defines how Transfer that represents an exchange of asset based on an asset payout, should be constructed.",
        "Rosetta func: Create_CashTransfer — Defines how Transfer that represents an exchange of cash, should be constructed.",
        "Rosetta func: ResolveTransfer — Defines how to calculate the amount due to be transferred after a Reset Event." ;
    common_domain_model:rosetta_functions "[{\"name\":\"CalculateTransfer\",\"description\":\"Function specification to calculate a transfer, e.g. following a reset on a contract\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"CalculateTransferInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"0..*\"}},{\"name\":\"Create_CashTransfer\",\"description\":\"Defines how Transfer that represents an exchange of cash, should be constructed.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"CalculateTransferInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_AssetTransfer\",\"description\":\"Defines how Transfer that represents an exchange of asset based on an asset payout, should be constructed.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"CalculateTransferInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}},{\"name\":\"ResolveTransfer\",\"description\":\"Defines how to calculate the amount due to be transferred after a Reset Event.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"CalculateTransferInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:CalculatedRateObservationDatesAndWeights a owl:Class ;
    rdfs:label "CalculatedRateObservationDatesAndWeights" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:weights ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:observationDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:weights ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:observationDates ] ;
    skos:closeMatch fpml_5_10:CalculatedRateObservationDatesAndWeights ;
    skos:definition "Type for reporting the observations dates and the corresponding weights going into a daily calculated rate" ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate ;
    skos:note "Rosetta func: GenerateObservationDatesAndWeights — Apply shifts to generate the list of observation dates and weights for each of those date." ;
    common_domain_model:rosetta_functions "[{\"name\":\"GenerateObservationDatesAndWeights\",\"description\":\"Apply shifts to generate the list of observation dates and weights for each of those date.\",\"inputs\":[{\"name\":\"calculationParams\",\"type\":\"FloatingRateCalculationParameters\",\"cardinality\":\"1..1\"},{\"name\":\"resetDates\",\"type\":\"ResetDates\",\"cardinality\":\"0..1\"},{\"name\":\"calculationPeriod\",\"type\":\"CalculationPeriodBase\",\"cardinality\":\"1..1\"},{\"name\":\"priorCalculationPeriod\",\"type\":\"CalculationPeriodBase\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"results\",\"type\":\"CalculatedRateObservationDatesAndWeights\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:CalculationPeriodData a owl:Class ;
    rdfs:label "CalculationPeriodData" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:startDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:isLastPeriod ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:isLastPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:daysInLeapYearPeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:endDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:endDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:daysInLeapYearPeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:isFirstPeriod ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:daysInPeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:startDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:daysInPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:endDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:daysInPeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:daysInLeapYearPeriod ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:isFirstPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isFirstPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isLastPeriod ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:startDate ] ;
    skos:closeMatch fpml_5_10:CalculationPeriodData ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    skos:note "Rosetta func: CalculationPeriod — 2006 ISDA Definition Section 4.13. 'Calculation Period' means, in respect of a Swap Transaction and a party, each period from, and including, one Period End Date of that party to, but excluding, the next following applicable Period End Date during the Term of the Swap Transaction, except that (a) the initial Calculation Period for the party will commence on, and include, the Effective Date and (b) the final Calculation Period for the party will end on, but exclude, the Termination Date.",
        "Rosetta func: CalculationPeriodRange",
        "Rosetta func: CalculationPeriods — 2006 ISDA Definition Section 4.13. 'Calculation Period' means, in respect of a Swap Transaction and a party, each period from, and including, one Period End Date of that party to, but excluding, the next following applicable Period End Date during the Term of the Swap Transaction, except that (a) the initial Calculation Period for the party will commence on, and include, the Effective Date and (b) the final Calculation Period for the party will end on, but exclude, the Termination Date." ;
    common_domain_model:rosetta_functions "[{\"name\":\"CalculationPeriod\",\"description\":\"2006 ISDA Definition Section 4.13. 'Calculation Period' means, in respect of a Swap Transaction and a party, each period from, and including, one Period End Date of that party to, but excluding, the next following applicable Period End Date during the Term of the Swap Transaction, except that (a) the initial Calculation Period for the party will commence on, and include, the Effective Date and (b) the final Calculation Period for the party will end on, but exclude, the Termination Date.\",\"inputs\":[{\"name\":\"calculationPeriodDates\",\"type\":\"CalculationPeriodDates\",\"cardinality\":\"1..1\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"CalculationPeriodData\",\"cardinality\":\"1..1\"},\"code_implementation\":true},{\"name\":\"CalculationPeriods\",\"description\":\"2006 ISDA Definition Section 4.13. 'Calculation Period' means, in respect of a Swap Transaction and a party, each period from, and including, one Period End Date of that party to, but excluding, the next following applicable Period End Date during the Term of the Swap Transaction, except that (a) the initial Calculation Period for the party will commence on, and include, the Effective Date and (b) the final Calculation Period for the party will end on, but exclude, the Termination Date.\",\"inputs\":[{\"name\":\"calculationPeriodDates\",\"type\":\"CalculationPeriodDates\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"CalculationPeriodData\",\"cardinality\":\"0..*\"},\"code_implementation\":true},{\"name\":\"CalculationPeriodRange\",\"inputs\":[{\"name\":\"dateAdjustments\",\"type\":\"BusinessDayAdjustments\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"result\",\"type\":\"CalculationPeriodData\",\"cardinality\":\"1..1\"},\"code_implementation\":true}]" .

common_domain_model:CheckEligibilityResult a owl:Class ;
    rdfs:label "CheckEligibilityResult" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EligibleCollateralSpecification ;
            owl:onProperty common_domain_model:specification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:matchingEligibleCriteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:isEligible ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:isEligible ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:specification ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EligibleCollateralCriteria ;
            owl:onProperty common_domain_model:matchingEligibleCriteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:specification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:eligibilityQuery ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isEligible ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EligibilityQuery ;
            owl:onProperty common_domain_model:eligibilityQuery ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:eligibilityQuery ] ;
    skos:definition "Result for the CheckEligibilityByDetails and CheckEligibilityForProduct functions" ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:note "Rosetta func: CheckEligibilityByDetails — This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.",
        "Rosetta func: CheckEligibilityForProduct" ;
    common_domain_model:rosetta_functions "[{\"name\":\"CheckEligibilityForProduct\",\"inputs\":[{\"name\":\"specifications\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..*\"},{\"name\":\"product\",\"type\":\"TransferableProduct\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"eligibilityResult\",\"type\":\"CheckEligibilityResult\",\"cardinality\":\"0..1\"},\"code_implementation\":true},{\"name\":\"CheckEligibilityByDetails\",\"description\":\"This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.\",\"inputs\":[{\"name\":\"specification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"eligibilityResult\",\"type\":\"CheckEligibilityResult\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:ClearingInstruction a owl:Class ;
    rdfs:label "ClearingInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:party1 ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:alphaContract ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:party1 ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:clearingParty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:clearingParty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:party2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isOpenOffer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:isOpenOffer ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:party2 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:isOpenOffer ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:clearerParty1 ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TradeState ;
            owl:onProperty common_domain_model:alphaContract ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:clearerParty2 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:alphaContract ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:clearerParty1 ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:party2 ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:clearerParty2 ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:clearingParty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:clearerParty2 ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:clearerParty1 ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:party1 ] ;
    skos:closeMatch fpml_5_10:ClearingInstruction ;
    skos:definition "All information required to perform the clear life cycle event; the clearing party (CCP), the two parties facing each other on the alpha contract, and optionally the parties acting as clearing members." ;
