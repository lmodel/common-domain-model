common_domain_model:dividendReturnTerms a owl:ObjectProperty ;
    rdfs:label "dividendReturnTerms" ;
    rdfs:range common_domain_model:DividendReturnTerms ;
    skos:definition "Return terms based upon dividend payments associated to the underlier." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:dividendValuationDate a owl:ObjectProperty ;
    rdfs:label "dividendValuationDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:definition "Specifies the dividend valuation dates of the swap." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendValuationDates a owl:ObjectProperty ;
    rdfs:label "dividendValuationDates" ;
    rdfs:range common_domain_model:AdjustableRelativeOrPeriodicDates ;
    skos:definition "Specifies the dividend valuation dates of the swap." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dlvryTp a owl:DatatypeProperty ;
    rdfs:label "dlvryTp" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#DlvryTp> .

