common_domain_model:eventDeterminationDate a owl:DatatypeProperty ;
    rdfs:label "eventDeterminationDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date in which the credit event is determined by the Credit Derivatives Determinations Comitee." ;
