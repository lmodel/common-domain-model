        <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#OvernightAvg>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#RefBanks>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#Screen> .

common_domain_model:FxHaircutCurrency a owl:Class ;
    rdfs:label "FxHaircutCurrency" ;
    rdfs:subClassOf [ a owl:Restriction ;
