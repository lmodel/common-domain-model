common_domain_model:NonTransferableProduct a owl:Class ;
    rdfs:label "NonTransferableProduct" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:economicTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ProductIdentifier ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ProductTaxonomy ;
            owl:onProperty common_domain_model:taxonomy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:taxonomy ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EconomicTerms ;
            owl:onProperty common_domain_model:economicTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:economicTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:identifier ] ;
    skos:definition "A data type to specify the financial product's economic terms, alongside the product identification and product taxonomy. The non-transferable product data type represents a product that can be traded (as part of a TradableProduct) but cannot be transferred to others.  It is meant to be used across the pre-execution, execution and (as part of the Contract) post-execution lifecycle contexts." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Rosetta condition: PrimaryAssetClass — if economicTerms -> nonStandardisedTerms = True then taxonomy -> primaryAssetClass exists",
        "Rosetta func: FXFarLeg — Extracts the far leg of an FX swap (deliverable or not) based on two criteria: the forward payout with the latest value date or the forward payout with the latest settlement date.",
        "Rosetta func: UnderlierForOptionOrForwardProduct — Extracts the underlier from an option or a forward." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"UnderlierForOptionOrForwardProduct\",\"description\":\"Extracts the underlier from an option or a forward.\",\"inputs\":[{\"name\":\"product\",\"type\":\"NonTransferableProduct\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"underlierProduct\",\"type\":\"Underlier\",\"cardinality\":\"1..1\"}},{\"name\":\"FXFarLeg\",\"description\":\"Extracts the far leg of an FX swap (deliverable or not) based on two criteria: the forward payout with the latest value date or the forward payout with the latest settlement date.\",\"inputs\":[{\"name\":\"product\",\"type\":\"NonTransferableProduct\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"nearLegPayout\",\"type\":\"SettlementPayout\",\"cardinality\":\"0..1\"}}]" .

