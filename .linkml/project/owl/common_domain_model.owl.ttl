common_domain_model:calculatedRate a owl:DatatypeProperty ;
    rdfs:label "calculatedRate" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculatedRateDetails.calculatedRate ;
