        <https://w3id.org/lmodel/common-domain-model/ValueSecuritiesEnum#Other> .

common_domain_model:account a owl:ObjectProperty ;
    rdfs:label "account" ;
    rdfs:range common_domain_model:Account ;
    skos:definition "The account that might be associated with the party. At most one account can be specified, as it is expected that this information is used in the context of a contract or legal document where only one account per party can be associated with such object." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:additionalAmendments a owl:DatatypeProperty ;
    rdfs:label "additionalAmendments" ;
    rdfs:range xsd:string ;
    skos:definition "Any additional amendments that might be specified by the parties to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:additionalInformation a owl:DatatypeProperty ;
    rdfs:label "additionalInformation" ;
    rdfs:range xsd:string ;
    skos:definition "Additional information on the recipient." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:addressesForTransfer a owl:ObjectProperty ;
    rdfs:label "addressesForTransfer" ;
    rdfs:range common_domain_model:AddressesForTransfer ;
    skos:definition "The optional specification of address for transfer as specified by the respective parties to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:adjustableDates a owl:ObjectProperty ;
    rdfs:label "adjustableDates" ;
    rdfs:range common_domain_model:AdjustableDates ;
    skos:closeMatch fpml_5_10:AdjustableOrRelativeDates.adjustableDates ;
    skos:definition "A series of dates that shall be subject to adjustment if they would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the date." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:adjustedCashSettlementPaymentDate a owl:DatatypeProperty ;
    rdfs:label "adjustedCashSettlementPaymentDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the cash settlement amount is paid. This date should already be adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:adjustedCashSettlementValuationDate a owl:DatatypeProperty ;
    rdfs:label "adjustedCashSettlementValuationDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date by which the cash settlement amount must be agreed. This date should already be adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:adjustedEarlyTerminationDate a owl:DatatypeProperty ;
    rdfs:label "adjustedEarlyTerminationDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CancellationEvent.adjustedEarlyTerminationDate ;
    skos:definition "The early termination date that is applicable if an early termination provision is exercised. This date should already be adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:assetClass a owl:ObjectProperty ;
    rdfs:label "assetClass" ;
    rdfs:range common_domain_model:StandardizedScheduleAssetClassEnum ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:averagingMethod a owl:ObjectProperty ;
    rdfs:label "averagingMethod" ;
    rdfs:range common_domain_model:AveragingCalculationMethodEnum ;
    skos:definition "Specifies enumerations for the type of averaging calculation." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:baseCurrency a owl:ObjectProperty ;
    rdfs:label "baseCurrency" ;
    rdfs:range common_domain_model:ISOCurrencyCodeEnum ;
    skos:closeMatch fpml_5_10:BaseAndEligibleCurrency.baseCurrency ;
    skos:definition "The common agreed currency into which relevant amounts of all collateral arrangements between the parties are converted, or if not an actual currency, the process through which this is determined. Where hardcoded (e.g. under the 1994 ISDA Credit Support Annex (Security Interest  NY Law)), the currency that effectively performs this function." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:businessCentersReference a owl:ObjectProperty ;
    rdfs:label "businessCentersReference" ;
    rdfs:range common_domain_model:BusinessCenters ;
    skos:closeMatch fpml_5_10:BusinessCenters.businessCentersReference ;
    skos:definition "A reference to a financial business center location specified elsewhere in the instance document." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    common_domain_model:metadata_reference true .

common_domain_model:buyer a owl:ObjectProperty ;
    rdfs:label "buyer" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:closeMatch fpml_5_10:BuyerSeller.buyer ;
    skos:definition "Buyer party that can be resolved as one of the two principal parties to the transaction. The party that buys this instrument, i.e. pays for this instrument and receives the rights defined by it. ISDA 2002 Equity Definitions section 1.18: `Buyer` means the party specified as such in the related Confirmation. | ISDA 2006 Definitions article 12.1 (b)(i) relating to a Swaption: 'Buyer' means the party that will, on each Premium Payment Date, pay to Seller the Premium | ISDA 2006 Definitions article 12.1 (b)(ii) relating to Swap Transactions with applicable Early Termination: the party specified as such in the related Confirmation, or the Exercising Party if neither party is specified | ISDA 2006 Definitions article 12.1 (b)(iii) relating to any other Option Transaction: the party specified as such in the related Confirmation. | ISDA 2014 Credit Definition article 1.4: `Buyer` means the Fixed Rate Payer." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:calculationAgent a owl:ObjectProperty ;
    rdfs:label "calculationAgent" ;
    rdfs:range common_domain_model:CalculationAgent ;
    skos:definition "The ISDA calculation agent responsible for performing duties as defined in the applicable product definitions." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:calculationMethod a owl:ObjectProperty ;
    rdfs:label "calculationMethod" ;
    rdfs:range common_domain_model:AveragingCalculationMethodEnum ;
    skos:closeMatch fpml_5_10:AveragingCalculationMethod.calculationMethod ;
    skos:definition "Identifies which of the Pythagorean means is being used to compute an average value." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:calculationPeriodDates a owl:ObjectProperty ;
    rdfs:label "calculationPeriodDates" ;
    rdfs:range common_domain_model:CalculationPeriodDates ;
    skos:closeMatch fpml_5_10:CommodityPayout.calculationPeriodDates ;
    skos:definition "Defines the calculation period dates schedule." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:category a owl:ObjectProperty ;
    rdfs:label "category" ;
    rdfs:range common_domain_model:ObligationCategoryEnum ;
    skos:definition "Used in both obligations and deliverable obligations to represent a class or type of securities which apply. ISDA 2003 Term: Obligation Category/Deliverable Obligation Category." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:comment a owl:DatatypeProperty ;
    rdfs:label "comment" ;
    rdfs:range xsd:string ;
    skos:definition "Optional comments for this group of inventory records." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:contactInformation a owl:ObjectProperty ;
    rdfs:label "contactInformation" ;
    rdfs:range common_domain_model:ContactInformation ;
    skos:closeMatch fpml_5_10:BusinessUnit.contactInformation ;
