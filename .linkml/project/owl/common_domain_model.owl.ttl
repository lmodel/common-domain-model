    rdfs:label "dualExchangeRateIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:earliestCancellationTime a owl:ObjectProperty ;
    rdfs:label "earliestCancellationTime" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:closeMatch fpml_5_10:CancelableProvision.earliestCancellationTime ;
    skos:definition "The earliest time in a business day that notice of cancelation can be given." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:earliestDate a owl:ObjectProperty ;
    rdfs:label "earliestDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:closeMatch fpml_5_10:CancelableProvision.earliestDate ;
    skos:definition "The first day when cancelation is permitted to take effect. A party may give notice prior to this date and taken together with the effective period would be necessary to cancel on this date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:earliestExerciseDateTenor a owl:ObjectProperty ;
    rdfs:label "earliestExerciseDateTenor" ;
    rdfs:range common_domain_model:Period ;
    skos:definition "The time interval to the first (and possibly only) exercise date in the exercise period." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:earlyCallDate a owl:DatatypeProperty ;
    rdfs:label "earlyCallDate" ;
    rdfs:range xsd:date ;
    skos:definition "Date prior to which the option buyer will have to pay a Make Whole Amount to the option seller if he/she exercises the option." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:earlyTerminationDate a owl:DatatypeProperty ;
    rdfs:label "earlyTerminationDate" ;
    rdfs:range xsd:boolean ;
    skos:definition "The early termination election." ;
