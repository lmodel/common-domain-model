common_domain_model:PostingObligations a owl:Class ;
    rdfs:label "PostingObligations" ;
    rdfs:seeAlso isda:CSA_IM_NewYork_2016 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:securityProvider ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PostingObligationsElection ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:securityProvider ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyElection ] ;
    skos:definition "A class to specify the collateral posting obligations of the security provider or security providers as specified in the corresponding agreement." ;
    skos:editorialNote "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(ii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

