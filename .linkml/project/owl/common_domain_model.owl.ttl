common_domain_model:Id a owl:Class ;
    rdfs:label "Id" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:lei ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:lei ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:lei ] ;
    skos:inScheme common_domain_model:cdm_regulation .

common_domain_model:Illiquidity a owl:Class ;
    rdfs:label "Illiquidity" ;
    rdfs:seeAlso isda:FXandCurrencyOptionsDefintions_1998 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:illiquidityIsApplicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EscrowArrangement ;
            owl:onProperty common_domain_model:escrowArrangement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:illiquidityValuationDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fallbackReferencePrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:minimumAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:illiquidityValuationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
