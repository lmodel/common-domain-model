common_domain_model:IdentifiedList a owl:Class ;
    rdfs:label "IdentifiedList" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:listId ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Price ;
            owl:onProperty common_domain_model:price ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Identifier ;
            owl:onProperty common_domain_model:componentId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:price ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:componentId ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Identifier ;
            owl:onProperty common_domain_model:listId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:price ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:listId ] ;
    skos:definition "Attaches an identifier to a collection of objects, when those objects themselves can each be represented by an identifier. One use case is the representation of package transactions, where each component is a separate trade with its own identifier, and those trades are linked together as a package with its own identifier. The data type has been named generically rather than referring to 'packages' as it may have a number of other uses." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_identifier ;
    common_domain_model:metadata_key true .

