common_domain_model:Reset a owl:Class ;
    rdfs:label "Reset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:averagingMethodology ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Price ;
            owl:onProperty common_domain_model:resetValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:averagingMethodology ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:resetValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Observation ;
            owl:onProperty common_domain_model:observations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:resetDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:rateRecordDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:rateRecordDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:observations ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:rateRecordDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AveragingCalculation ;
            owl:onProperty common_domain_model:averagingMethodology ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:resetDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:resetDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:resetValue ] ;
    skos:definition "Defines the reset value or fixing value produced in cashflow calculations, during the life-cycle of a financial instrument. The reset process defined in Create_Reset function joins product definition details with observations to compute the reset value." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: AveragingMethodologyExists — if observations count > 1 then averagingMethodology exists",
        "Rosetta func: InterestCashSettlementAmount — Defines the performance calculations relevant for a fixed or floating rate payout.",
        "Rosetta func: ResolveInterestRateReset — Defines how to resolve the reset value for an InterestRatePayout.",
        "Rosetta func: ResolvePerformanceReset — Defines how to resolve the reset value for a performance payout.",
        "Rosetta func: ResolveReset — Defines the interface for adopters to resolve a reset, given a trade state and a date.",
        "Rosetta func: ResolveSecurityFinanceBillingAmount — Calculates the billing amount for a Security Finance transaction." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"ResolveInterestRateReset\",\"description\":\"Defines how to resolve the reset value for an InterestRatePayout.\",\"inputs\":[{\"name\":\"payouts\",\"type\":\"InterestRatePayout\",\"cardinality\":\"1..*\"},{\"name\":\"observation\",\"type\":\"Observation\",\"cardinality\":\"1..1\"},{\"name\":\"resetDate\",\"type\":\"date\",\"cardinality\":\"1..1\"},{\"name\":\"rateRecordDate\",\"type\":\"date\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"reset\",\"type\":\"Reset\",\"cardinality\":\"1..1\"}},{\"name\":\"InterestCashSettlementAmount\",\"description\":\"Defines the performance calculations relevant for a fixed or floating rate payout.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"},{\"name\":\"payout\",\"type\":\"Payout\",\"cardinality\":\"1..1\"},{\"name\":\"resets\",\"type\":\"Reset\",\"cardinality\":\"1..*\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"interestCashSettlementAmount\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}},{\"name\":\"ResolveReset\",\"description\":\"Defines the interface for adopters to resolve a reset, given a trade state and a date.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"reset\",\"type\":\"Reset\",\"cardinality\":\"1..1\"},\"code_implementation\":true},{\"name\":\"ResolvePerformanceReset\",\"description\":\"Defines how to resolve the reset value for a performance payout.\",\"inputs\":[{\"name\":\"performancePayout\",\"type\":\"PerformancePayout\",\"cardinality\":\"1..1\"},{\"name\":\"observation\",\"type\":\"Observation\",\"cardinality\":\"1..1\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"reset\",\"type\":\"Reset\",\"cardinality\":\"1..1\"}},{\"name\":\"ResolveSecurityFinanceBillingAmount\",\"description\":\"Calculates the billing amount for a Security Finance transaction.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"},{\"name\":\"reset\",\"type\":\"Reset\",\"cardinality\":\"1..1\"},{\"name\":\"recordStartDate\",\"type\":\"date\",\"cardinality\":\"1..1\"},{\"name\":\"recordEndDate\",\"type\":\"date\",\"cardinality\":\"1..1\"},{\"name\":\"transferDate\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}}]" .

