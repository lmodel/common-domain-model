common_domain_model:AddressesForTransfer a owl:Class ;
    rdfs:label "AddressesForTransfer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TransferInformationElection ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyElection ] ;
    skos:definition "Specifies the address for transfer as specified by the respective parties to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:AllCriteria a owl:Class ;
    rdfs:label "AllCriteria" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:allCriteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllEligibilityToHoldCollateralCriteria common_domain_model:AnyEligibilityToHoldCollateralCriteria common_domain_model:RatingAgencyValue common_domain_model:AmountOfNetCapital ) ] common_domain_model:CollateralCriteria ) ] ;
            owl:onProperty common_domain_model:allCriteria ] ;
    skos:definition "Used to combine two or more Collateral Criteria using AND logic." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:AllDirectionRating a owl:Class ;
    rdfs:label "AllDirectionRating" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:allDirectionRating ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllDirectionRating common_domain_model:AnyDirectionRating common_domain_model:DirectionRating ) ] common_domain_model:DirectionRatingSet ) ] ;
            owl:onProperty common_domain_model:allDirectionRating ] ;
    skos:definition "Used to combine two or more Ratings and associated direction using AND logic." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:AncillaryEntity a owl:Class ;
    rdfs:label "AncillaryEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:ancillaryParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalEntity ;
            owl:onProperty common_domain_model:legalEntity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:legalEntity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:legalEntity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AncillaryRoleEnum ;
            owl:onProperty common_domain_model:ancillaryParty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:ancillaryParty ] ;
    skos:closeMatch fpml_5_10:AncillaryEntity ;
    skos:definition "Holds an identifier for an ancillary entity, either identified directly via its ancillary role or directly as a legal entity." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:AncillaryParty a owl:Class ;
    rdfs:label "AncillaryParty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AncillaryRoleEnum ;
            owl:onProperty common_domain_model:role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:onBehalfOf ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:onBehalfOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:onBehalfOf ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:role ] ;
    skos:closeMatch fpml_5_10:AncillaryParty ;
    skos:definition "Defines an ancillary role enumerated value with an associated party reference. The product is agnostic to the actual parties involved in the transaction, with the party references abstracted away from the product definition and replaced by the AncillaryRoleEnum. The AncillaryRoleEnum can then be positioned in the product and this AncillaryParty type, which is positioned outside of the product definition, allows the AncillaryRoleEnum to be associated with an actual party reference." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:note "Rosetta func: ExtractAncillaryPartyByRole — Extracts from a list of AncillaryParty data types, the AncillaryParty that corresponds to the AncillaryRoleEnum." ;
    common_domain_model:rosetta_functions "[{\"name\":\"ExtractAncillaryPartyByRole\",\"description\":\"Extracts from a list of AncillaryParty data types, the AncillaryParty that corresponds to the AncillaryRoleEnum.\",\"inputs\":[{\"name\":\"ancillaryParties\",\"type\":\"AncillaryParty\",\"cardinality\":\"1..*\"},{\"name\":\"roleEnumToExtract\",\"type\":\"AncillaryRoleEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"ancillaryParty\",\"type\":\"AncillaryParty\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:AnyCriteria a owl:Class ;
    rdfs:label "AnyCriteria" ;
    rdfs:subClassOf [ a owl:Restriction ;
