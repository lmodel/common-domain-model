common_domain_model:Period a owl:Class ;
    rdfs:label "Period" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:period ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:periodMultiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:periodMultiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PeriodEnum ;
            owl:onProperty common_domain_model:period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:periodMultiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:period ] ;
    skos:closeMatch gist:TimeInterval ;
    skos:definition "A class to define recurring periods or time offsets." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: DayPeriod — if periodMultiplier = 0 then period = PeriodEnum -> D" ;
    common_domain_model:metadata_key true .

common_domain_model:endDate a owl:DatatypeProperty ;
    rdfs:label "endDate" ;
    rdfs:range xsd:date ;
    skos:definition "The last date of a date range." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:rounding a owl:ObjectProperty ;
    rdfs:label "rounding" ;
    rdfs:range common_domain_model:TimeRounding ;
    skos:definition "Optional rules that define how the calculated time should be rounded after the offset has been applied." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

