common_domain_model:IdentifiedList a owl:Class ;
	rdfs:label "IdentifiedList" ;
	rdfs:subClassOf _:c14n10835 , _:c14n12346 , _:c14n1815 , _:c14n2903 , _:c14n453 , _:c14n6074 , _:c14n8183 , _:c14n9902 ;
	skos:definition "Attaches an identifier to a collection of objects, when those objects themselves can each be represented by an identifier. One use case is the representation of package transactions, where each component is a separate trade with its own identifier, and those trades are linked together as a package with its own identifier. The data type has been named generically rather than referring to 'packages' as it may have a number of other uses." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_identifier ;
	common_domain_model:rosetta_metadata "key" .
common_domain_model:Identifier a owl:Class ;
	rdfs:label "Identifier" ;
	rdfs:subClassOf _:c14n11678 , _:c14n12770 , _:c14n13695 , _:c14n1635 , _:c14n3291 , _:c14n4588 , _:c14n484 , _:c14n6394 , _:c14n7066 ;
	skos:definition "A class to specify a generic identifier, applicable to CDM artefacts such as executions, contracts, lifecycle events and legal documents. An issuer can be associated with the actual identifier value as a way to properly qualify it." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_identifier ;
	common_domain_model:doc_reference "ICMA GMRA namingConvention Identifier" ;
	common_domain_model:rosetta_metadata "key" .
