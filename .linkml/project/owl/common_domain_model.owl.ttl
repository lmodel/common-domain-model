common_domain_model:LegalEntity a owl:Class ;
    rdfs:label "LegalEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:entityIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EntityIdentifier ;
            owl:onProperty common_domain_model:entityIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:name ] ;
    skos:closeMatch spdx:Organization,
        gist:Organization,
        oscal:Party ;
    skos:definition "A class to specify a legal entity, with a required name and an optional entity identifier (such as the LEI)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:narrowMatch gist:GovernmentOrganization ;
    skos:relatedMatch iso29100:PIIController,
        iso29100:PIIProcessor ;
    common_domain_model:metadata_key true .

common_domain_model:Price a owl:Class ;
    rdfs:label "Price" ;
    rdfs:subClassOf common_domain_model:PriceSchedule ;
    skos:definition "Specifies a price as a single value to be associated to a financial product. This data type extends PriceSchedule and requires that only the amount value exists." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Rosetta condition: AmountOnlyExists — value exists and datedValue is absent" ;
    skos:relatedMatch gist:Magnitude .

common_domain_model:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the taxonomy value as a simple string, which may be associated to an external scheme." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:effectiveDate a owl:DatatypeProperty ;
    rdfs:label "effectiveDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CodeValue.effectiveDate ;
    skos:definition "When the code became/becomes effective" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

