common_domain_model:ConditionsPrecedent a owl:Class ;
    rdfs:label "ConditionsPrecedent" ;
    rdfs:seeAlso isda:CSA_IM_2016,
        isda:CSA_IM_Japanese_2016,
        isda:CSA_IM_NewYork_2016,
        isda:CSA_NewYork_1994,
        isda:CSA_VM_2016,
        isda:CSD_English_1995,
        isda:CSD_IM_English_2016,
        isda:CSD_IM_English_2018 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SpecifiedConditionOrAccessCondition ;
            owl:onProperty common_domain_model:specifiedConditionOrAccessCondition ],
        [ a owl:Restriction ;
