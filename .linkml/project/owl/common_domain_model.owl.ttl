common_domain_model:VarianceCapFloor a owl:Class ;
    rdfs:label "VarianceCapFloor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:boundedVariance ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:varianceCap ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:varianceCap ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:unadjustedVarianceCap ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:unadjustedVarianceCap ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:boundedVariance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:unadjustedVarianceCap ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BoundedVariance ;
            owl:onProperty common_domain_model:boundedVariance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:varianceCap ] ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    skos:note "Rosetta condition: CapFloorApplicability — if varianceCap = True then unadjustedVarianceCap exists or boundedVariance exists // If CapFloor is applicable at least one cap expression must exist else unadjustedVarianceCap is absent and boundedVariance is absent // If CapFloor is not applicable, then there cannot be any volatility caps",
        "Rosetta condition: PositiveUnadjustedVarianceCap — if unadjustedVarianceCap exists then unadjustedVarianceCap > 0" .

common_domain_model:addendumLanguage a owl:DatatypeProperty ;
    rdfs:label "addendumLanguage" ;
    rdfs:range xsd:string ;
    skos:definition "The party specific language to be included in the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:after a owl:ObjectProperty ;
    rdfs:label "after" ;
    rdfs:range common_domain_model:TradeState ;
    skos:closeMatch fpml_5_10:BusinessEvent.after ;
    skos:definition "Specifies the after trade state(s) created." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:agreementType a owl:ObjectProperty ;
    rdfs:label "agreementType" ;
    rdfs:range common_domain_model:LegalAgreementTypeEnum ;
    skos:closeMatch fpml_5_10:AgreementName.agreementType ;
    skos:definition "Specification of the legal agreement type." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:allCriteria a owl:ObjectProperty ;
    rdfs:label "allCriteria" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllEligibilityToHoldCollateralCriteria common_domain_model:AnyEligibilityToHoldCollateralCriteria common_domain_model:RatingAgencyValue common_domain_model:AmountOfNetCapital ) ] common_domain_model:EligibilityToHoldCollateralCriteria ) ] ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:amendmentsToJapaneseProvisions a owl:DatatypeProperty ;
    rdfs:label "amendmentsToJapaneseProvisions" ;
    rdfs:range xsd:boolean ;
    skos:definition "Additional Amendments to Japanese Securities Provisions are specified when True, and not specified when False." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:amendmentsToJapaneseProvisionsTerms a owl:DatatypeProperty ;
    rdfs:label "amendmentsToJapaneseProvisionsTerms" ;
    rdfs:range xsd:string ;
    skos:definition "Specific terms applicable to Additional Amendments to Japanese Securities Provisions." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:anyCriteria a owl:ObjectProperty ;
    rdfs:label "anyCriteria" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllEligibilityToHoldCollateralCriteria common_domain_model:AnyEligibilityToHoldCollateralCriteria common_domain_model:RatingAgencyValue common_domain_model:AmountOfNetCapital ) ] common_domain_model:EligibilityToHoldCollateralCriteria ) ] ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:assetBacked a owl:ObjectProperty ;
    rdfs:label "assetBacked" ;
    rdfs:range common_domain_model:AssetBackedEnum ;
    skos:definition "Specifies the type of Asset Backed Security." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:assignmentOfClaim a owl:DatatypeProperty ;
    rdfs:label "assignmentOfClaim" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:basketReferenceInformation a owl:ObjectProperty ;
    rdfs:label "basketReferenceInformation" ;
    rdfs:range common_domain_model:BasketReferenceInformation ;
    skos:definition "This attribute contains all the terms relevant to defining the Credit Default Swap Basket." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:bespokeEventDescription a owl:DatatypeProperty ;
    rdfs:label "bespokeEventDescription" ;
    rdfs:range xsd:string ;
    skos:definition "Corporate action triggered by the occurrence of an event which description is seperatly agreed between the parties and/or described in any referenced agreement (for instance bespoke term described in any string type objects present in most root attributes of Agreement type)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:billingSummary a owl:ObjectProperty ;
    rdfs:label "billingSummary" ;
    rdfs:range common_domain_model:BillingSummary ;
    skos:definition "The billing summaries contained within the invoice" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:boundedVariance a owl:ObjectProperty ;
    rdfs:label "boundedVariance" ;
    rdfs:range common_domain_model:BoundedVariance ;
    skos:definition "Conditions which bound variance. The contract specifies one or more boundary levels. These levels are expressed as prices for confirmation purposes Underlyer price must be equal to or higher than Lower Barrier is known as Up Conditional Swap Underlyer price must be equal to or lower than Upper Barrier is known as Down Conditional Swap Underlyer price must be equal to or higher than Lower Barrier and must be equal to or lower than Upper Barrier is known as Barrier Conditional Swap." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:cabEndDateElection a owl:DatatypeProperty ;
    rdfs:label "cabEndDateElection" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralAccessBreach.cabEndDateElection ;
    skos:definition "Determination of whether the Collateral Access Breach end date is a number of days (True) or specified (False)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:cabEndDateTerms a owl:DatatypeProperty ;
    rdfs:label "cabEndDateTerms" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CollateralAccessBreach.cabEndDateTerms ;
    skos:definition "Specific terms for when Collateral Access Breach terms end." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:calculationDateImTerms a owl:DatatypeProperty ;
    rdfs:label "calculationDateImTerms" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BespokeCalculationDate.calculationDateImTerms ;
    skos:definition "The Additional Calculation Date terms for the purposes of Initial Margin." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:calendarDay a owl:DatatypeProperty ;
    rdfs:label "calendarDay" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CSAValuationDate.calendarDay ;
    skos:definition "Defines the day of the calendar if this is specified for in the ValuationDateDateEnum." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:callType a owl:ObjectProperty ;
    rdfs:label "callType" ;
    rdfs:range common_domain_model:CallTypeEnum ;
    skos:definition "Indicates the status of the call message type, such as expected call, notification of a call or an actionable margin call." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:capRate a owl:ObjectProperty ;
    rdfs:label "capRate" ;
    rdfs:range common_domain_model:Strike ;
    skos:definition "The cap rate, if any, which applies to the floating rate for the calculation period. The cap rate (strike) is only required where the floating rate on a swap stream is capped at a certain strike level. The cap rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A cap rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:clearedDate a owl:DatatypeProperty ;
    rdfs:label "clearedDate" ;
    rdfs:range xsd:date ;
    skos:definition "Specifies the date on which a trade is cleared (novated) through a central counterparty clearing service." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:closedState a owl:ObjectProperty ;
    rdfs:label "closedState" ;
    rdfs:range common_domain_model:ClosedState ;
    skos:definition "Represents the qualification of what led to the trade's closure alongside the dates on which this closure took effect." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:collateralProvisions a owl:ObjectProperty ;
    rdfs:label "collateralProvisions" ;
    rdfs:range common_domain_model:CollateralProvisions ;
    skos:closeMatch fpml_5_10:Collateral.collateralProvisions ;
    skos:definition "specifies the collateral provisions of the product." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:collateralizedObligation a owl:ObjectProperty ;
    rdfs:label "collateralizedObligation" ;
    rdfs:range common_domain_model:CollateralizedObligationEnum ;
    skos:definition "Specifies the type of Collateralized Obligation." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:compoundingBusinessCenter a owl:DatatypeProperty ;
    rdfs:label "compoundingBusinessCenter" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CollateralInterestCalculationParameters.compoundingBusinessCenter ;
    skos:definition "Specifies the applicable business centers for compounding." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:corporateActionTransferType a owl:ObjectProperty ;
    rdfs:label "corporateActionTransferType" ;
    rdfs:range common_domain_model:CorporateActionTypeEnum ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:corporateActionType a owl:ObjectProperty ;
    rdfs:label "corporateActionType" ;
    rdfs:range common_domain_model:CorporateActionTypeEnum ;
    skos:definition "The type of corporate action taking place." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:coveredBond a owl:ObjectProperty ;
    rdfs:label "coveredBond" ;
    rdfs:range common_domain_model:CoveredBondEnum ;
    skos:definition "Specifies the type of Covered Bond." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:creditSupportAgreementMarginType a owl:ObjectProperty ;
    rdfs:label "creditSupportAgreementMarginType" ;
    rdfs:range common_domain_model:CollateralMarginTypeEnum ;
    skos:closeMatch fpml_5_10:AgreementName.creditSupportAgreementMarginType ;
    skos:definition "specifies the type of margin for which a legal agreement is named." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:creditSupportDocument a owl:ObjectProperty ;
    rdfs:label "creditSupportDocument" ;
    rdfs:range common_domain_model:LegalAgreement ;
    skos:definition "The specified Credit Support Document(s), if any." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:creditSupportProviderTerms a owl:ObjectProperty ;
    rdfs:label "creditSupportProviderTerms" ;
    rdfs:range common_domain_model:CreditSupportProviderTermsEnum ;
    skos:definition "Specification of the Credit Support Provider terms." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:custodianEligibility a owl:DatatypeProperty ;
    rdfs:label "custodianEligibility" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies whether the party's custodian is eligible to hold the other party's posted collateral. If 'True' then the custodian is eligible to hold the Posted Collateral given that the specified criteria are met." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:datedValue a owl:ObjectProperty ;
    rdfs:label "datedValue" ;
    rdfs:range common_domain_model:DatedValue ;
    skos:definition "A schedule of step date and value pairs. On each step date the associated step value becomes effective. The step dates are used to order the steps by ascending order. This attribute is optional so the data type may be used to define a schedule with a single value." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:dayFrequency a owl:DatatypeProperty ;
    rdfs:label "dayFrequency" ;
    rdfs:range xsd:decimal ;
    skos:definition "Defines the occurrence of the dayOfWeek within the pricing period on which pricing will take place, e.g. the 3rd Friday within each Calculation Period. If omitted, every dayOfWeek will be a pricing day." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:definitionOfMarketValueNonStandard a owl:DatatypeProperty ;
    rdfs:label "definitionOfMarketValueNonStandard" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CollateralSpecification.definitionOfMarketValueNonStandard ;
    skos:definition "If the definition of 'Market Value' is non standard, it can be specified here." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:depositaryReceipt a owl:ObjectProperty ;
    rdfs:label "depositaryReceipt" ;
    rdfs:range common_domain_model:DepositaryReceiptTypeEnum ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:determinationTerms a owl:ObjectProperty ;
    rdfs:label "determinationTerms" ;
    rdfs:range common_domain_model:DeterminationRolesAndTerms ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:discountRate a owl:DatatypeProperty ;
    rdfs:label "discountRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "A discount rate, expressed as a decimal, to be used in the calculation of a discounted amount. A discount amount of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:discountRateDayCountFraction a owl:ObjectProperty ;
    rdfs:label "discountRateDayCountFraction" ;
    rdfs:range common_domain_model:DayCountFractionEnum ;
    skos:definition "A discount day count fraction to be used in the calculation of a discounted amount." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:dutyPayer a owl:DatatypeProperty ;
    rdfs:label "dutyPayer" ;
    rdfs:range xsd:string ;
    skos:definition "The payer of documentary duty." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:dutyPayerLanguage a owl:DatatypeProperty ;
    rdfs:label "dutyPayerLanguage" ;
    rdfs:range xsd:string ;
    skos:definition "Bespoke terms specific to the payment of documentary duty." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:dutyPaymentDate a owl:DatatypeProperty ;
    rdfs:label "dutyPaymentDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date that documentary duty will be paid." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:dutyPaymentLanguage a owl:DatatypeProperty ;
    rdfs:label "dutyPaymentLanguage" ;
    rdfs:range xsd:string ;
    skos:definition "Bespoke terms specific to the date that documentary duty will be paid." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:earliestExerciseTime a owl:ObjectProperty ;
    rdfs:label "earliestExerciseTime" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:definition "The earliest time at which notice of exercise can be given by the buyer to the seller (or seller's agent) to, and including, the expiration date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:earlyTerminationDateOptionalLanguage a owl:DatatypeProperty ;
    rdfs:label "earlyTerminationDateOptionalLanguage" ;
    rdfs:range xsd:boolean ;
    skos:definition "A boolean attribute to specify whether Failure to Pay Early Termination language is included (True) or excluded (False) from the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:electiveAmount a owl:ObjectProperty ;
    rdfs:label "electiveAmount" ;
    rdfs:range common_domain_model:ElectiveAmountEnum ;
    skos:definition "Specifies an enumerated election to express the elective amount." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:escrowArrangementIsApplicable a owl:DatatypeProperty ;
    rdfs:label "escrowArrangementIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:executionType a owl:ObjectProperty ;
    rdfs:label "executionType" ;
    rdfs:range common_domain_model:ExecutionTypeEnum ;
    skos:definition "Identifies the type of execution, e.g. via voice, electronically..." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:executionVenue a owl:ObjectProperty ;
    rdfs:label "executionVenue" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "Represents the venue on which a trade was executed." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:exerciseDates a owl:ObjectProperty ;
    rdfs:label "exerciseDates" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDates ;
    skos:definition "The dates that define the Bermuda option exercise dates and the expiration date. The last specified date is assumed to be the expiration date. The dates can either be specified as a series of explicit dates and associated adjustments or as a series of dates defined relative to another schedule of dates, for example, the calculation period start dates. Where a relative series of dates are defined the first and last possible exercise dates can be separately specified." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:exerciseFee a owl:ObjectProperty ;
    rdfs:label "exerciseFee" ;
    rdfs:range common_domain_model:ExerciseFee ;
    skos:definition "A fee to be paid on exercise. This could be represented as an amount or a rate and notional reference on which to apply the rate." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:exerciseFeeSchedule a owl:ObjectProperty ;
    rdfs:label "exerciseFeeSchedule" ;
    rdfs:range common_domain_model:ExerciseFeeSchedule ;
    skos:definition "The fees associated with an exercise date. The fees are conditional on the exercise occurring. The fees can be specified as actual currency amounts or as percentages of the notional amount being exercised." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:failureToPayEarlyTermination a owl:DatatypeProperty ;
    rdfs:label "failureToPayEarlyTermination" ;
    rdfs:range xsd:boolean ;
    skos:definition "A boolean attribute to specify whether Failure to Pay Early Termination language in the agreement is deemed applicable or not." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:firstPaymentDate a owl:DatatypeProperty ;
    rdfs:label "firstPaymentDate" ;
    rdfs:range xsd:date ;
    skos:definition "The first unadjusted payment date. This day may be subject to adjustment in accordance with any business day convention specified in paymentDatesAdjustments. This element must only be included if there is an initial stub. This date will normally correspond to an unadjusted calculation period start or end date. This is true even if early or delayed payment is specified to be applicable since the actual first payment date will be the specified number of days before or after the applicable adjusted calculation period start or end date with the resulting payment date then being adjusted in accordance with any business day convention specified in paymentDatesAdjustments." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:firstRegularPeriodStartDate a owl:DatatypeProperty ;
    rdfs:label "firstRegularPeriodStartDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates.firstRegularPeriodStartDate ;
    skos:definition "The start date of the regular part of the calculation period schedule. It must only be specified if there is an initial stub calculation period. This day may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:floorRate a owl:ObjectProperty ;
    rdfs:label "floorRate" ;
    rdfs:range common_domain_model:Strike ;
    skos:definition "The floor rate, if any, which applies to the floating rate for the calculation period. The floor rate (strike) is only required where the floating rate on a swap stream is floored at a certain strike level. The floor rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. The floor rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:includesDefaultLanguage a owl:DatatypeProperty ;
    rdfs:label "includesDefaultLanguage" ;
    rdfs:range xsd:boolean ;
    skos:definition "Default language is included when True, and excluded when False." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:initialCustodian a owl:ObjectProperty ;
    rdfs:label "initialCustodian" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "Election to specify the initial custodian." ;
    skos:editorialNote "ISDA CSA_VM_2016" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:initialLevel a owl:DatatypeProperty ;
    rdfs:label "initialLevel" ;
    rdfs:range xsd:decimal ;
    skos:definition "Contract will strike off this initial level. Providing just the initialLevel without initialLevelSource, infers that this is AgreedInitialPrice - a specified Initial Index Level." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:initialLevelSource a owl:ObjectProperty ;
    rdfs:label "initialLevelSource" ;
    rdfs:range common_domain_model:DeterminationMethodEnum ;
    skos:definition "In this context, this is AgreedInitialPrice - a specified Initial Index Level." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:isBaseCurrency a owl:DatatypeProperty ;
    rdfs:label "isBaseCurrency" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CalculationCurrencyElection.isBaseCurrency ;
    skos:definition "The SIMM Calculation Currency (also known as SIMM Reporting Currency) means the Base Currency when True. It means a different currency when False. In that latter case, the SIMM Calculation Currency is specified as part of the currency attribute." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:isExchangeListed a owl:DatatypeProperty ;
    rdfs:label "isExchangeListed" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AssetBase.isExchangeListed ;
    skos:definition "Defines whether the Asset is listed on a public exchange." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:lastRegularPaymentDate a owl:DatatypeProperty ;
    rdfs:label "lastRegularPaymentDate" ;
    rdfs:range xsd:date ;
    skos:definition "The last regular payment date when specified as a date, as in the FpML interest rate construct. FpML specifies that this date may be subject to adjustment in accordance with any business day convention specified in the paymentDatesAdjustments attribute." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:lastRegularPeriodEndDate a owl:DatatypeProperty ;
    rdfs:label "lastRegularPeriodEndDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates.lastRegularPeriodEndDate ;
    skos:definition "The end date of the regular part of the calculation period schedule. It must only be specified if there is a final stub calculation period. This day may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:latestExerciseTime a owl:ObjectProperty ;
    rdfs:label "latestExerciseTime" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:definition "For a Bermuda or American style option, the latest time on an exercise business day (excluding the expiration date) within the exercise period that notice can be given by the buyer to the seller or seller's agent. Notice of exercise given after this time will be deemed to have been given on the next exercise business day." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:legacyNamedEntity a owl:ObjectProperty ;
    rdfs:label "legacyNamedEntity" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "The identity of the relevant custodian where Named Entity is elected." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:legalAgreement a owl:ObjectProperty ;
    rdfs:label "legalAgreement" ;
    rdfs:range common_domain_model:LegalAgreement ;
    skos:definition "Optional legal agreements associated to the contract being formed, for instance a master agreement." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:masterConfirmationAnnexType a owl:ObjectProperty ;
    rdfs:label "masterConfirmationAnnexType" ;
    rdfs:range common_domain_model:MasterConfirmationAnnexTypeEnum ;
    skos:closeMatch fpml_5_10:AgreementName.masterConfirmationAnnexType ;
    skos:definition "The type of master confirmation annex executed between the parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:masterConfirmationType a owl:ObjectProperty ;
    rdfs:label "masterConfirmationType" ;
    rdfs:range common_domain_model:MasterConfirmationTypeEnum ;
    skos:closeMatch fpml_5_10:AgreementName.masterConfirmationType ;
    skos:definition "The type of master confirmation executed between the parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:materialSubsidiaryTerms a owl:DatatypeProperty ;
    rdfs:label "materialSubsidiaryTerms" ;
    rdfs:range xsd:string ;
    skos:definition "The meaning of Material Subsidiary for the Event of Default or Termination Event specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:maximumNotionalAmount a owl:DatatypeProperty ;
    rdfs:label "maximumNotionalAmount" ;
    rdfs:range xsd:decimal ;
    skos:definition "The maximum notional amount that can be exercised on a given exercise date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:maximumNumberOfOptions a owl:DatatypeProperty ;
    rdfs:label "maximumNumberOfOptions" ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum number of options that can be exercised on a given exercise date. If the number is not specified, it means that the maximum number of options corresponds to the remaining unexercised options." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:multipleExercise a owl:ObjectProperty ;
    rdfs:label "multipleExercise" ;
    rdfs:range common_domain_model:MultipleExercise ;
    skos:definition "As defined in the 2000 ISDA Definitions, Section 12.4. Multiple Exercise, the buyer of the option has the right to exercise all or less than all the unexercised notional amount of the underlying swap on one or more days in the exercise period, but on any such day may not exercise less than the minimum notional amount or more that the maximum notional amount, and if an integral multiple amount is specified, the notional amount exercised must be equal to, or be an integral multiple of, the integral multiple amount." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:nationalizationIsApplicable a owl:DatatypeProperty ;
    rdfs:label "nationalizationIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:nonLegalEntity a owl:ObjectProperty ;
    rdfs:label "nonLegalEntity" ;
    rdfs:range common_domain_model:NonLegalEntity ;
    skos:definition "Specifies a non-legal entity that exists in the agreement with a defined relationship to a Legal entity to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:numberOfOriginals a owl:DatatypeProperty ;
    rdfs:label "numberOfOriginals" ;
    rdfs:range xsd:string ;
    skos:definition "The number of original documents." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:observationHistory a owl:ObjectProperty ;
    rdfs:label "observationHistory" ;
    rdfs:range common_domain_model:ObservationEvent ;
    skos:definition "Represents the observed events related to a particular product or process, such as credit events or corporate actions." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:observationTimeType a owl:ObjectProperty ;
    rdfs:label "observationTimeType" ;
    rdfs:range common_domain_model:TimeTypeEnum ;
    skos:definition "The enumerated values to specify points in the day when option exercise and valuation can occur." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:observations a owl:ObjectProperty ;
    rdfs:label "observations" ;
    rdfs:range common_domain_model:Observation ;
    skos:definition "Represents an audit of the observations used to produce the reset value. If multiple observations were necessary to produce the reset value, the aggregation method should be defined on the payout." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:otherSpecifiedEntityTerms a owl:DatatypeProperty ;
    rdfs:label "otherSpecifiedEntityTerms" ;
    rdfs:range xsd:string ;
    skos:definition "The non standard terms for the Event of Default or Termination Event specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:partialExercise a owl:ObjectProperty ;
    rdfs:label "partialExercise" ;
    rdfs:range common_domain_model:PartialExercise ;
    skos:definition "As defined in the 2000 ISDA Definitions, Section 12.3. Partial Exercise, the buyer of the option has the right to exercise all or less than all the notional amount of the underlying swap on the expiration date, but may not exercise less than the minimum notional amount, and if an integral multiple amount is specified, the notional amount exercised must be equal to, or be an integral multiple of, the integral multiple amount." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:positionState a owl:ObjectProperty ;
    rdfs:label "positionState" ;
    rdfs:range common_domain_model:PositionStatusEnum ;
    skos:definition "Identifies the state of the position, to distinguish if just executed, formed, already settled, closed, etc." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:premiumType a owl:ObjectProperty ;
    rdfs:label "premiumType" ;
    rdfs:range common_domain_model:PremiumTypeEnum ;
    skos:definition "(Optionally) Additional attribute that can further define any premium to the price." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:presentValuePrincipalAmount a owl:ObjectProperty ;
    rdfs:label "presentValuePrincipalAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "The amount representing the present value of the principal payment." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:priceSourceHeading a owl:DatatypeProperty ;
    rdfs:label "priceSourceHeading" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the heading or field name for the price  on a given page or screen, where applicable." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:priceSourceLocation a owl:DatatypeProperty ;
    rdfs:label "priceSourceLocation" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the location of the price which may be a specific page, electornic screen name, or a code (e.g. a RIC code) where the price can be found." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:priceType a owl:ObjectProperty ;
    rdfs:label "priceType" ;
    rdfs:range common_domain_model:PriceTypeEnum ;
    skos:definition "Specifies the price type as an enumeration: interest rate, exchange rate, asset price etc. This attribute is mandatory so that prices can always be clasiffied according to their type. The price type implies some constraints on the price's units." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:publiclyAvailableInformation a owl:ObjectProperty ;
    rdfs:label "publiclyAvailableInformation" ;
    rdfs:range common_domain_model:Resource ;
    skos:definition "A public information source, e.g. a particular newspaper or electronic news service, that may publish relevant information used in the determination of whether or not a credit event has occurred." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:putCall a owl:ObjectProperty ;
    rdfs:label "putCall" ;
    rdfs:range common_domain_model:PutCallEnum ;
    skos:definition "Specifies the embedded option feature of a debt security." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:quasiGovernmentType a owl:ObjectProperty ;
    rdfs:label "quasiGovernmentType" ;
    rdfs:range common_domain_model:QuasiGovernmentIssuerType ;
    skos:closeMatch fpml_5_10:CollateralIssuerType.quasiGovernmentType ;
    skos:definition "Specifies debt issues by institutions or bodies, typically constituted by statute, with a function mandated by the government and subject to government supervision inclusive of profit- and non-profit making bodies. Includes the US Agencies and GSEs and the EU concept of public sector entities. Excluding any entities which are also Regional Government." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:ratingVariableSet a owl:ObjectProperty ;
    rdfs:label "ratingVariableSet" ;
    rdfs:range common_domain_model:CreditNotation ;
    skos:definition "Allows a grouping of Rating agencies and Rating values." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:redemptionType a owl:ObjectProperty ;
    rdfs:label "redemptionType" ;
    rdfs:range common_domain_model:RedemptionTypeEnum ;
    skos:definition "Specifies the contractual redemption or conversion features associated with a debt security." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:referenceObligation a owl:ObjectProperty ;
    rdfs:label "referenceObligation" ;
    rdfs:range common_domain_model:ReferenceObligation ;
    skos:definition "The Reference Obligation is a financial instrument that is either issued or guaranteed by the reference entity. It serves to clarify the precise reference entity protection is being offered upon, and its legal position with regard to other related firms (parents/subsidiaries). Furthermore the Reference Obligation is ALWAYS deliverable and establishes the Pari Passu ranking (as the deliverable bonds must rank equal to the reference obligation). ISDA 2003 Term: Reference Obligation." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:regimeTerms a owl:ObjectProperty ;
    rdfs:label "regimeTerms" ;
    rdfs:range common_domain_model:RegimeTerms ;
    skos:closeMatch fpml_5_10:ApplicableRegime.regimeTerms ;
    skos:definition "A class that is used by the ApplicableRegime and the AdditionalRegime classes to specify the terms that are specific to each party and regime which are referred to in the Regime Table as part of certain legal agreements, such as the ISDA 2016 and 2018 CSA for Initial Margin." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:regionalGovernmentType a owl:ObjectProperty ;
    rdfs:label "regionalGovernmentType" ;
    rdfs:range common_domain_model:RegionalGovernmentIssuerType ;
    skos:closeMatch fpml_5_10:CollateralIssuerType.regionalGovernmentType ;
    skos:definition "Specifies Regional government, local authority or municipal." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:relevantClass a owl:DatatypeProperty ;
    rdfs:label "relevantClass" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:relevantProvisionsElection a owl:DatatypeProperty ;
    rdfs:label "relevantProvisionsElection" ;
    rdfs:range xsd:boolean ;
    skos:definition "Recommended Japanese Securities Provisions are applicable when True, additional Provisions are specified when False." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:relevantProvisionsTerms a owl:DatatypeProperty ;
    rdfs:label "relevantProvisionsTerms" ;
    rdfs:range xsd:string ;
    skos:definition "Specific terms applicable to Recommended Japanese Securities Provisions." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:representativeEndDate a owl:ObjectProperty ;
    rdfs:label "representativeEndDate" ;
    rdfs:range common_domain_model:CustomisableOffset ;
    skos:definition "The definition of representative end date in relation to a representative event." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:representativeEventTerms a owl:DatatypeProperty ;
    rdfs:label "representativeEventTerms" ;
    rdfs:range xsd:string ;
    skos:definition "The specific representative event terms applicable when specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:representativeTerms a owl:DatatypeProperty ;
    rdfs:label "representativeTerms" ;
    rdfs:range xsd:string ;
    skos:definition "The specific representative terms applicable when specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sovereignEntity a owl:DatatypeProperty ;
    rdfs:label "sovereignEntity" ;
    rdfs:range xsd:boolean ;
    skos:definition "True if sovereign entity (e.g. not separate legal personality from sovereign) or false if non-sovereign entity (e.g. separate legal personality from sovereign)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:specialPurposeVehicleType a owl:ObjectProperty ;
    rdfs:label "specialPurposeVehicleType" ;
    rdfs:range common_domain_model:SpecialPurposeVehicleIssuerType ;
    skos:closeMatch fpml_5_10:CollateralIssuerType.specialPurposeVehicleType ;
    skos:definition "Specifies a subsidiary company that is formed to undertake a specific business purpose of acquisition and financing of specific assets on a potentially limited recourse basis dependent of how it is designed. E.g. asset backed securities, including securitisations." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:standardDefinitionOfMarketValueUsed a owl:DatatypeProperty ;
    rdfs:label "standardDefinitionOfMarketValueUsed" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralSpecification.standardDefinitionOfMarketValueUsed ;
    skos:definition "Is the standard definition of 'Market Value' used in the GMSLA?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:substitutedRegime a owl:ObjectProperty ;
    rdfs:label "substitutedRegime" ;
    rdfs:range common_domain_model:SubstitutedRegime ;
    skos:definition "The specification of Additional regimes for purposes of determining whether a Regulatory Event has occurred." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:supraNationalType a owl:ObjectProperty ;
    rdfs:label "supraNationalType" ;
    rdfs:range common_domain_model:SupraNationalIssuerTypeEnum ;
    skos:closeMatch fpml_5_10:CollateralIssuerType.supraNationalType ;
    skos:definition "Specifies debt issued by international organisations and multilateral banks." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:taxonomy a owl:ObjectProperty ;
    rdfs:label "taxonomy" ;
    rdfs:range common_domain_model:Taxonomy ;
    skos:closeMatch fpml_5_10:AssetBase.taxonomy ;
    skos:definition "Defines the taxonomy of an object by combining a taxonomy source (i.e. the rules to classify the object) and a value (i.e. the output of those rules on the object." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:terminationCurrencyCondition a owl:ObjectProperty ;
    rdfs:label "terminationCurrencyCondition" ;
    rdfs:range common_domain_model:TerminationCurrencyConditionEnum ;
    skos:definition "Specifies the enumerated conditions for selection of the termination currency." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:terminationCurrencySpecifiedCondition a owl:DatatypeProperty ;
    rdfs:label "terminationCurrencySpecifiedCondition" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies alternative conditions for selection of the termination currency." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:tradeIdentifier a owl:ObjectProperty ;
    rdfs:label "tradeIdentifier" ;
    rdfs:range common_domain_model:TradeIdentifier ;
    skos:definition "Denotes one or more identifiers associated with the transaction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:valuationHistory a owl:ObjectProperty ;
    rdfs:label "valuationHistory" ;
    rdfs:range common_domain_model:Valuation ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:varianceCap a owl:DatatypeProperty ;
    rdfs:label "varianceCap" ;
    rdfs:range xsd:boolean ;
    skos:definition "If present and true, then variance cap is applicable." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:visibilityIndicator a owl:DatatypeProperty ;
    rdfs:label "visibilityIndicator" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates the choice if the call instruction is visible or not to the other party." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:volatilityCapFactor a owl:DatatypeProperty ;
    rdfs:label "volatilityCapFactor" ;
    rdfs:range xsd:decimal ;
    skos:definition "Volatility Cap Amount in accordance with the ISDA 2011 Equity Derivatives Definitions. The Calculated VolCapAmt can be optionally provided." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:weights a owl:DatatypeProperty ;
    rdfs:label "weights" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculatedRateObservations.weights ;
    skos:definition "The corresponding weight for each date." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:zeroEvent a owl:DatatypeProperty ;
    rdfs:label "zeroEvent" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether a trigger applies for the Threshold or Minimum Transfer Amount to fall to zero. If 'True' then such a trigger exists." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:AccountTypeEnum a owl:Class ;
    rdfs:label "AccountTypeEnum" ;
    owl:unionOf ( <http://www.fpml.org/coding-scheme/account-type-1-1#AggregateClient> <http://www.fpml.org/coding-scheme/account-type-1-1#Client> <http://www.fpml.org/coding-scheme/account-type-1-1#House> ) ;
    skos:definition "The enumeration values to qualify the type of account." ;
    skos:exactMatch fpml:account-type ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    linkml:permissible_values <http://www.fpml.org/coding-scheme/account-type-1-1#AggregateClient>,
        <http://www.fpml.org/coding-scheme/account-type-1-1#Client>,
        <http://www.fpml.org/coding-scheme/account-type-1-1#House> .

common_domain_model:ActionEnum a owl:Class ;
    rdfs:label "ActionEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ActionEnum#New> <https://w3id.org/lmodel/common-domain-model/ActionEnum#Correct> <https://w3id.org/lmodel/common-domain-model/ActionEnum#Cancel> ) ;
    skos:definition "The enumeration values to specify the actions associated with transactions." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/ActionEnum#Cancel>,
        <https://w3id.org/lmodel/common-domain-model/ActionEnum#Correct>,
        <https://w3id.org/lmodel/common-domain-model/ActionEnum#New> .

common_domain_model:AdjustedRelativeDateOffset a owl:Class ;
    rdfs:label "AdjustedRelativeDateOffset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:relativeDateAdjustments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:relativeDateAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:relativeDateAdjustments ],
        common_domain_model:RelativeDateOffset ;
    skos:definition "A type defining a date (referred to as the derived date) as a relative offset from another date (referred to as the anchor date) plus optional date adjustments." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:AppropriatedCollateralValuation a owl:Class ;
    rdfs:label "AppropriatedCollateralValuation" ;
    rdfs:seeAlso isda:CSD_IM_English_2016 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:isSpecified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:election ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isSpecified ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:election ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:election ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:isSpecified ] ;
    skos:closeMatch fpml_5_10:AppropriatedCollateralValuation ;
    skos:definition "A class to specify the Valuation of Appropriated Collateral." ;
    skos:editorialNote "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(u)\" name \"Valuation of Appropriated Collateral\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta condition: NotSpecified — if isSpecified = False then election is absent",
        "Rosetta condition: Specified — if isSpecified = True then election exists" .

common_domain_model:AssetIdTypeEnum a owl:Class ;
    rdfs:label "AssetIdTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AssetIdTypeEnum#CurrencyCode> <https://w3id.org/lmodel/common-domain-model/AssetIdTypeEnum#ExchangeCode> <https://w3id.org/lmodel/common-domain-model/AssetIdTypeEnum#ClearingCode> ) ;
