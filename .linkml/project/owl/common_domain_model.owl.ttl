common_domain_model:EventInstruction a owl:Class ;
    rdfs:label "EventInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:eventDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:eventTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:packageInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:IdentifiedList ;
            owl:onProperty common_domain_model:packageInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Instruction ;
            owl:onProperty common_domain_model:instruction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:intent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:instruction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:packageInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:eventTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectiveTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TimeZone ;
            owl:onProperty common_domain_model:eventTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:corporateActionIntent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TimeZone ;
            owl:onProperty common_domain_model:effectiveTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EventIntentEnum ;
            owl:onProperty common_domain_model:intent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:corporateActionIntent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:intent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:eventDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectiveTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CorporateActionTypeEnum ;
            owl:onProperty common_domain_model:corporateActionIntent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:eventDate ] ;
    skos:definition "Specifies instructions to create a BusinessEvent." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    skos:note "Rosetta condition: CorporateAction — if corporateActionIntent exists then intent = EventIntentEnum -> CorporateActionAdjustment",
        "Rosetta func: Create_ProposedWorkflowStep — Represents the proposal to create a business event that results in a workflow step containing an instruction, message details, identifiers, event timestamps, parties and accounts. The optional previous workflow step input provides workflow lineage to where there has been a correction or cancellation to the proposed step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New." ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_ProposedWorkflowStep\",\"description\":\"Represents the proposal to create a business event that results in a workflow step containing an instruction, message details, identifiers, event timestamps, parties and accounts. The optional previous workflow step input provides workflow lineage to where there has been a correction or cancellation to the proposed step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New.\",\"inputs\":[{\"name\":\"messageInformation\",\"type\":\"MessageInformation\",\"cardinality\":\"0..1\"},{\"name\":\"timestamp\",\"type\":\"EventTimestamp\",\"cardinality\":\"1..*\"},{\"name\":\"eventIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"1..*\"},{\"name\":\"party\",\"type\":\"Party\",\"cardinality\":\"0..*\"},{\"name\":\"account\",\"type\":\"Account\",\"cardinality\":\"0..*\"},{\"name\":\"previousWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"0..1\"},{\"name\":\"action\",\"type\":\"ActionEnum\",\"cardinality\":\"1..1\"},{\"name\":\"proposedEvent\",\"type\":\"EventInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"approval\",\"type\":\"WorkflowStepApproval\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"proposedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:ExecutionDetails a owl:Class ;
    rdfs:label "ExecutionDetails" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:IdentifiedList ;
            owl:onProperty common_domain_model:packageReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalEntity ;
            owl:onProperty common_domain_model:executionVenue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:executionVenue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:packageReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ExecutionTypeEnum ;
            owl:onProperty common_domain_model:executionType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:executionType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:executionVenue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:packageReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:executionType ] ;
    skos:definition "Defines specific attributes that relate to trade executions." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: ExecutionVenue — if executionType = ExecutionTypeEnum -> Electronic then executionVenue exists",
        "Rosetta func: Create_PackageExecutionDetails — Add a package component to an execution details object. This package component is constructed using an identifier for the package and the list of identifiers for its components.",
        "Rosetta func: EmptyExecutionDetails" ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_PackageExecutionDetails\",\"description\":\"Add a package component to an execution details object. This package component is constructed using an identifier for the package and the list of identifiers for its components.\",\"inputs\":[{\"name\":\"executionDetails\",\"type\":\"ExecutionDetails\",\"cardinality\":\"0..1\"},{\"name\":\"listId\",\"type\":\"Identifier\",\"cardinality\":\"1..1\"},{\"name\":\"componentId\",\"type\":\"Identifier\",\"cardinality\":\"2..*\"}],\"output\":{\"name\":\"newExecutionDetails\",\"type\":\"ExecutionDetails\",\"cardinality\":\"1..1\"}},{\"name\":\"EmptyExecutionDetails\",\"output\":{\"name\":\"executionDetails\",\"type\":\"ExecutionDetails\",\"cardinality\":\"0..1\"},\"code_implementation\":true}]" .

common_domain_model:ExecutionLocationEnum a owl:Class ;
    rdfs:label "ExecutionLocationEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ExecutionLocationEnum#ExecutedOutsideBelgium> <https://w3id.org/lmodel/common-domain-model/ExecutionLocationEnum#ExecutedInBelgium> <https://w3id.org/lmodel/common-domain-model/ExecutionLocationEnum#OtherLocation> ) ;
