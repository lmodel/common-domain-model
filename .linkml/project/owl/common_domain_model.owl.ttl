            owl:onProperty common_domain_model:portfolioReturnTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:observationTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:underlier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:finalValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:interimValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:paymentDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:initialValuationPrice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ReturnTerms ;
            owl:onProperty common_domain_model:returnTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:valuationDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PaymentDates ;
            owl:onProperty common_domain_model:paymentDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ObservationTerms ;
            owl:onProperty common_domain_model:observationTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FxFeature ;
            owl:onProperty common_domain_model:fxFeature ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:returnTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Observable common_domain_model:Product ) ] common_domain_model:Underlier ) ] ;
            owl:onProperty common_domain_model:underlier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:observationTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:portfolioReturnTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:finalValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:underlier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:interimValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:returnTerms ],
        common_domain_model:PayoutBase ;
    skos:definition "Contains the necessary specifications for all performance payouts, encompassing equity return, dividend, variance, volatility and correlation products." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Rosetta condition: CorrelationUnderlierOnlyBasket — if returnTerms -> correlationReturnTerms exists then underlier -> Observable -> Basket exists",
        "Rosetta condition: EquitySpecificAttributes — if Qualify_UnderlierObservable_Equity(underlier -> Observable) = False then returnTerms -> varianceReturnTerms -> dividendApplicability is absent and returnTerms -> varianceReturnTerms -> equityUnderlierProvisions is absent and returnTerms -> varianceReturnTerms -> sharePriceDividendAdjustment is absent and returnTerms -> volatilityReturnTerms -> dividendApplicability is absent and returnTerms -> volatilityReturnTerms -> equityUnderlierProvisions is absent and returnTerms -> volatilityReturnTerms -> sharePriceDividendAdjustment is absent and returnTerms -> correlationReturnTerms -> dividendApplicability is absent and returnTerms -> correlationReturnTerms -> equityUnderlierProvisions is absent and returnTerms -> correlationReturnTerms -> sharePriceDividendAdjustment is absent",
        "Rosetta condition: NoSharePriceDividendAdjustmentForeignExchange — if underlier -> Observable -> Index -> ForeignExchangeRateIndex exists then returnTerms -> varianceReturnTerms -> sharePriceDividendAdjustment is absent and returnTerms -> volatilityReturnTerms -> sharePriceDividendAdjustment is absent",
        "Rosetta condition: NoSharePriceDividendAdjustmentIndex — if underlier -> Observable -> Index exists then returnTerms -> varianceReturnTerms -> sharePriceDividendAdjustment is absent and returnTerms -> volatilityReturnTerms -> sharePriceDividendAdjustment is absent",
        "Rosetta condition: PortfolioOrStraightReturn — required choice returnTerms, portfolioReturnTerms",
        "Rosetta condition: PortfolioReturnIsMultipleReturns — if portfolioReturnTerms exists then portfolioReturnTerms count > 1",
        "Rosetta condition: Quantity — priceQuantity exists",
        "Rosetta condition: Underlier — underlier -> Observable exists",
        "Rosetta condition: UnderlierOfPortfolioIsBasket — if portfolioReturnTerms -> priceReturnTerms exists then underlier -> Observable -> Basket exists" .

common_domain_model:PortfolioState a owl:Class ;
    rdfs:label "PortfolioState" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:lineage ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Lineage ;
            owl:onProperty common_domain_model:lineage ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Position ;
            owl:onProperty common_domain_model:positions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:positions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:lineage ] ;
    skos:definition "State-full representation of a Portfolio that describes all the positions held at a given time, in various states which can be either traded, settled, etc., with lineage information to the previous state" ;
    skos:inScheme common_domain_model:cdm_event_position ;
    skos:note "Rosetta condition: Initialisation — if lineage -> portfolioStateReference is absent then positions is absent and lineage -> eventReference is absent",
        "Rosetta condition: NonTransferable — positions -> product -> NonTransferableProduct exists",
        "Rosetta func: EvaluatePortfolioState — Function specification to evaluate a portfolio's aggregation parameters and return a new portfolio state containing aggregated positions." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"EvaluatePortfolioState\",\"description\":\"Function specification to evaluate a portfolio's aggregation parameters and return a new portfolio state containing aggregated positions.\",\"inputs\":[{\"name\":\"portfolio\",\"type\":\"Portfolio\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"portfolioState\",\"type\":\"PortfolioState\",\"cardinality\":\"1..1\"},\"code_implementation\":true}]" .

