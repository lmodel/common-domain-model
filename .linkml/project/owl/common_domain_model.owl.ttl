common_domain_model:MaterialChangeInCircumstance a owl:Class ;
    rdfs:label "MaterialChangeInCircumstance" ;
    rdfs:seeAlso isda:FXandCurrencyOptionsDefintions_1998 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:maximumDaysOfDisruption ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:escrowArrangement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ValuationPostponement ;
            owl:onProperty common_domain_model:maximumDaysOfDisruption ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:materialChangeInCircumstanceIsApplicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:materialChangeInCircumstanceIsApplicable ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:materialChangeInCircumstanceIsApplicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EscrowArrangement ;
            owl:onProperty common_domain_model:escrowArrangement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:escrowArrangement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:maximumDaysOfDisruption ] ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(viii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

