        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Asset common_domain_model:Basket common_domain_model:Index ) ] common_domain_model:Observable ) ] ;
            owl:onProperty common_domain_model:observable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:determinationMethodology ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:InformationSource ;
            owl:onProperty common_domain_model:informationSource ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
