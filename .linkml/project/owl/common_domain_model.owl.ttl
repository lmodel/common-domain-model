common_domain_model:PositionIdentifier a owl:Class ;
    rdfs:label "PositionIdentifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:identifierType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TradeIdentifierTypeEnum ;
            owl:onProperty common_domain_model:identifierType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:identifierType ],
        common_domain_model:Identifier ;
    skos:definition "Defines a position identifier as a special case of the generic identifier type, that also includes the position identifier class." ;
    skos:inScheme common_domain_model:cdm_event_common .

<https://w3id.org/lmodel/common-domain-model/PositionStatusEnum#Cancelled> a owl:Class ;
