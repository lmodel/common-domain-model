            owl:onProperty common_domain_model:optionsPriceValuation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:componentSecurityIndexAnnexFallback ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:optionsPriceValuation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:futuresPriceValuation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fPVFinalPriceElectionFallback ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:numberOfValuationDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fPVFinalPriceElectionFallback ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dividendValuationDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:numberOfValuationDates ] ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    skos:note "Rosetta condition: PositiveNumberOfValuationDates — if numberOfValuationDates exists then numberOfValuationDates > 0" .

common_domain_model:WarehouseIdentityEnum a owl:Class ;
    rdfs:label "WarehouseIdentityEnum" ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/WarehouseIdentityEnum#DTCC_TIW_Gold> .

common_domain_model:WeeklyRollConventionEnum a owl:Class ;
    rdfs:label "WeeklyRollConventionEnum" ;
    skos:definition "The enumerated values to specify the weekly roll day." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/WeeklyRollConventionEnum#TBILL> .

common_domain_model:WeightedAveragingObservation a owl:Class ;
    rdfs:label "WeightedAveragingObservation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:dateTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:weight ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:observationNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:observationNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:weight ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:weight ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:observationNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty common_domain_model:dateTime ] ;
    skos:definition "A single weighted averaging observation." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    skos:note "Rosetta condition: PositiveObservationNumber — if observationNumber exists then observationNumber >= 0",
        "Rosetta condition: PositiveWeight — weight >= 0.0",
        "Rosetta condition: WeightedAveragingObservationChoice — required choice dateTime, observationNumber" .

common_domain_model:acceleratedOrMatured a owl:DatatypeProperty ;
    rdfs:label "acceleratedOrMatured" ;
    rdfs:range xsd:boolean ;
    skos:definition "A deliverable obligation characteristic. An obligation at time of default is due to mature and due to be repaid, or as a result of downgrade/bankruptcy is due to be repaid as a result of an acceleration clause. ISDA 2003 Term: Accelerated or Matured." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:accountBeneficiary a owl:ObjectProperty ;
    rdfs:label "accountBeneficiary" ;
    rdfs:range common_domain_model:Party ;
    skos:closeMatch fpml_5_10:Account.accountBeneficiary ;
    skos:definition "A reference to the party beneficiary of the account." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:accountName a owl:DatatypeProperty ;
    rdfs:label "accountName" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Account.accountName ;
    skos:definition "The name by which the account is known." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_scheme true .

common_domain_model:accountNumber a owl:DatatypeProperty ;
    rdfs:label "accountNumber" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Account.accountNumber ;
    skos:definition "The account number." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_scheme true .

common_domain_model:accountReference a owl:ObjectProperty ;
    rdfs:label "accountReference" ;
    rdfs:range common_domain_model:Account ;
    skos:definition "Reference to an account." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:accountType a owl:ObjectProperty ;
    rdfs:label "accountType" ;
    rdfs:range common_domain_model:AccountTypeEnum ;
    skos:closeMatch fpml_5_10:Account.accountType ;
    skos:definition "The type of account, e.g. client, house." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_scheme true .

common_domain_model:accrualFactor a owl:ObjectProperty ;
    rdfs:label "accrualFactor" ;
    rdfs:range common_domain_model:AccrualFactor ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.accrualFactor ;
    skos:definition "The accrual rate and related terms, to adjust the price of an underlier impacted by a Corporate Action when economic impact consists in freezing the underlier price to last fixing and applying accruals for each remaining underlier price fixing date required i.e. for each, adjustedPrice = lastFixingPrice x (1 + accrualRate x DCF)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:accrueInterestOnUnsettledInterest a owl:DatatypeProperty ;
    rdfs:label "accrueInterestOnUnsettledInterest" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.accrueInterestOnUnsettledInterest ;
    skos:definition "Indicates whether interest accruing on unsettled interest amount is included (continues to be accrued) in the following period." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:acquiredSecurity a owl:ObjectProperty ;
    rdfs:label "acquiredSecurity" ;
    rdfs:range common_domain_model:Security ;
    skos:definition "Defines the underlier for the Acquired Company involved in Merger corporate action." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:acquiredSecurityPrice a owl:ObjectProperty ;
    rdfs:label "acquiredSecurityPrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "The price observation that relates to underlier for the Acquired Company." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:actingAs a owl:ObjectProperty ;
    rdfs:label "actingAs" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "Specifies the CounterpartyRoleEnum, e.g. either Party1 or Party2, that is associated to the party." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:action a owl:ObjectProperty ;
    rdfs:label "action" ;
    rdfs:range common_domain_model:ActionEnum ;
    skos:definition "Specifies whether the event is a new, a correction or a cancellation." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:activityDate a owl:DatatypeProperty ;
    rdfs:label "activityDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:ClosedState.activityDate ;
    skos:definition "The activity date on which the closing state took place, i.e. either the event date of the closing event (e.g. option exercise, contract early termination) or the contractual termination date." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:additionalAcknowledgements a owl:DatatypeProperty ;
    rdfs:label "additionalAcknowledgements" ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, then additional acknowledgements are applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:additionalBusinessDays a owl:ObjectProperty ;
    rdfs:label "additionalBusinessDays" ;
    rdfs:range common_domain_model:BusinessCenters ;
    skos:definition "Any additional business days that be applicable." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:additionalDisruptionEvents a owl:ObjectProperty ;
    rdfs:label "additionalDisruptionEvents" ;
    rdfs:range common_domain_model:AdditionalDisruptionEvents ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:additionalDividends a owl:DatatypeProperty ;
    rdfs:label "additionalDividends" ;
    rdfs:range xsd:boolean ;
    skos:definition "If present and true, then additional dividends are applicable." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:additionalFixedPayments a owl:ObjectProperty ;
    rdfs:label "additionalFixedPayments" ;
    rdfs:range common_domain_model:AdditionalFixedPayments ;
    skos:definition "Specifies the events that will give rise to the payment additional fixed payments." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:additionalRepresentation a owl:ObjectProperty ;
    rdfs:label "additionalRepresentation" ;
    rdfs:range common_domain_model:AdditionalRepresentation ;
    skos:closeMatch fpml_5_10:AdditionalRepresentations.additionalRepresentation ;
    skos:definition "The specification of the Additional Representation that may be applicable to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:additionalRightsEvent a owl:ObjectProperty ;
    rdfs:label "additionalRightsEvent" ;
    rdfs:range common_domain_model:AdditionalRightsEvent ;
    skos:definition "The Additional Rights Event election." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:additionalTerms a owl:DatatypeProperty ;
    rdfs:label "additionalTerms" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:ApplicableRegime.additionalTerms ;
    skos:definition "The bespoke Additional Type for the purposes of Covered Transactions (IM)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:additionalType a owl:ObjectProperty ;
    rdfs:label "additionalType" ;
    rdfs:range common_domain_model:AdditionalTypeEnum ;
    skos:closeMatch fpml_5_10:ApplicableRegime.additionalType ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(b)(B)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:addressForNotices a owl:ObjectProperty ;
    rdfs:label "addressForNotices" ;
    rdfs:range common_domain_model:DemandsAndNotices ;
    skos:definition "Specification of the address and other details for notices." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:addtlAttrbts a owl:ObjectProperty ;
    rdfs:label "addtlAttrbts" ;
    rdfs:range common_domain_model:AddtlAttrbts ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#AddtlAttrbts> .

common_domain_model:adjustableDate a owl:ObjectProperty ;
    rdfs:label "adjustableDate" ;
    rdfs:range common_domain_model:AdjustableDate ;
    skos:closeMatch fpml_5_10:AdjustableOrRelativeDate.adjustableDate ;
    skos:definition "A date that shall be subject to adjustment if it would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the date." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:adjustableOrRelativeDate a owl:ObjectProperty ;
    rdfs:label "adjustableOrRelativeDate" ;
    rdfs:range common_domain_model:AdjustableOrAdjustedOrRelativeDate ;
    skos:definition "A single settlement date subject to adjustment or specified as relative to another date (e.g. the trade date). This attribute was formerly part of 'SettlementTerms', which is now being harmonised to include a common 'SettlementDate', as inherited from 'SettlementBase'." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:adjustedEndDate a owl:DatatypeProperty ;
    rdfs:label "adjustedEndDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CalculationPeriodBase.adjustedEndDate ;
    skos:definition "The calculation period end date, adjusted according to any relevant business day convention." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:adjustedExtendedTerminationDate a owl:DatatypeProperty ;
    rdfs:label "adjustedExtendedTerminationDate" ;
    rdfs:range xsd:date ;
    skos:definition "The termination date if an extendible provision is exercised. This date should already be adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:adjustedFixingDate a owl:DatatypeProperty ;
    rdfs:label "adjustedFixingDate" ;
    rdfs:range xsd:date ;
    skos:definition "The adjusted fixing date, i.e. the actual date the rate is observed. The date should already be adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:adjustedFxSpotFixingDate a owl:DatatypeProperty ;
    rdfs:label "adjustedFxSpotFixingDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the FX spot rate is observed. This date should already be adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:adjustedPaymentDate a owl:DatatypeProperty ;
    rdfs:label "adjustedPaymentDate" ;
    rdfs:range xsd:date ;
    skos:definition "The adjusted payment date. This date should already be adjusted for any applicable business day convention. This component is not intended for use in trade confirmation but may be specified to allow the fee structure to also serve as a cashflow type component." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:adjustedRelevantSwapEffectiveDate a owl:DatatypeProperty ;
    rdfs:label "adjustedRelevantSwapEffectiveDate" ;
    rdfs:range xsd:date ;
    skos:definition "The effective date of the underlying swap associated with a given exercise date. This date should already be adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:adjustedStartDate a owl:DatatypeProperty ;
    rdfs:label "adjustedStartDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CalculationPeriodBase.adjustedStartDate ;
    skos:definition "The calculation period start date, adjusted according to any relevant business day convention." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:adjustmentFactor a owl:ObjectProperty ;
    rdfs:label "adjustmentFactor" ;
    rdfs:range common_domain_model:AdjustmentFactor ;
    skos:definition "Specifies any additional details e.g. further descriptions depending on the particular type of Corporate Action, adjustmentFactor, calculations" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:adjustmentRatio a owl:DatatypeProperty ;
    rdfs:label "adjustmentRatio" ;
    rdfs:range xsd:decimal ;
    skos:definition "The number that denotes the cumulative quantity of post-split shares issued to shareholders versus the quantity of pre-split shares previously issued to shareholders.  This number will be multiplied by existing shares in an equity derivative contract or other positions to determine the post-split number of shares.  With regard to any reference to price, the pre-split reference price will be divided by this number to determine the post-split reference price." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:agency a owl:ObjectProperty ;
    rdfs:label "agency" ;
    rdfs:range common_domain_model:CreditRatingAgencyEnum ;
    skos:definition "Specifies The credit agency to which the other variables (notation, scale, debt type) refer to." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:agencyRating a owl:ObjectProperty ;
    rdfs:label "agencyRating" ;
    rdfs:range common_domain_model:AgencyRatingCriteria ;
    skos:definition "The agency rating based on default risk and creditors claim in event of default associated with specific instrument." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:aggregateWeight a owl:DatatypeProperty ;
    rdfs:label "aggregateWeight" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculatedRateDetails.aggregateWeight ;
    skos:definition "The total weight of all the terms that went into the calculated rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:aggregation a owl:ObjectProperty ;
    rdfs:label "aggregation" ;
    rdfs:range common_domain_model:Aggregation ;
    skos:closeMatch fpml_5_10:CollateralSpecification.aggregation ;
    skos:definition "How does paragraph 5.4 (aggregation) apply to the GMSLA?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:aggregationParameters a owl:ObjectProperty ;
    rdfs:label "aggregationParameters" ;
    rdfs:range common_domain_model:AggregationParameters ;
    skos:definition "Describes the portfolio by describing how to aggregate all its relevant Events." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:aggregationType a owl:ObjectProperty ;
    rdfs:label "aggregationType" ;
    rdfs:range common_domain_model:AggregationSpecificationEnum ;
    skos:closeMatch fpml_5_10:Aggregation.aggregationType ;
    skos:definition "How is the mark to market value determined?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:agreedAmountBaseCurrency a owl:ObjectProperty ;
    rdfs:label "agreedAmountBaseCurrency" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "Indicates the amount that posting entity agrees to remit in response to margin call (in base currency)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:agreedDiscountRate a owl:DatatypeProperty ;
    rdfs:label "agreedDiscountRate" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CashCollateralValuationMethod.agreedDiscountRate ;
    skos:definition "This may be used to indicate the discount rate to be used for cash collateral for cash settlement purposes." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:agreementDate a owl:DatatypeProperty ;
    rdfs:label "agreementDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the legal agreement has been agreed between the parties. This corresponds to the Date of Deed in an English Law document." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:agreementMinimumTransferAmount a owl:ObjectProperty ;
    rdfs:label "agreementMinimumTransferAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "Specifies the collateral legal agreement minimum transfer amount in base currency." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:agreementName a owl:ObjectProperty ;
    rdfs:label "agreementName" ;
    rdfs:range common_domain_model:AgreementName ;
    skos:definition "The legal agreement name, e.g. Credit Support Annex for Variation Margin." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/AM_1_0#documentName> .

common_domain_model:agreementRounding a owl:ObjectProperty ;
    rdfs:label "agreementRounding" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "Specifies the collateral legal agreement rounding in base currency." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:agreementTerms a owl:ObjectProperty ;
    rdfs:label "agreementTerms" ;
    rdfs:range common_domain_model:AgreementTerms ;
    skos:definition "Specification of the content of the legal agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:agreementThreshold a owl:ObjectProperty ;
    rdfs:label "agreementThreshold" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "Specifies the collateral legal agreement threshold amount in base currency." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:agreementsRegardingHedging a owl:DatatypeProperty ;
    rdfs:label "agreementsRegardingHedging" ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, then agreements regarding hedging are applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:allDividends a owl:DatatypeProperty ;
    rdfs:label "allDividends" ;
    rdfs:range xsd:boolean ;
    skos:definition "Represents the European Master Confirmation value of 'All Dividends' which, when applicable, signifies that, for a given Ex-Date, the daily observed Share Price for that day is adjusted (reduced) by the cash dividend and/or the cash value of any non cash dividend per Share (including Extraordinary Dividends) declared by the Issuer. All Dividends in accordance with the ISDA 2002 Equity Derivatives Definitions." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:allGuarantees a owl:DatatypeProperty ;
    rdfs:label "allGuarantees" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether an obligation of the Reference Entity, guaranteed by the Reference Entity on behalf of a non-Affiliate, is to be considered an Obligation for the purpose of the transaction. It will be considered an obligation if allGuarantees is applicable (true) and not if allGuarantees is inapplicable (false). ISDA 2003 Term: All Guarantees." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:alphaContract a owl:ObjectProperty ;
    rdfs:label "alphaContract" ;
    rdfs:range common_domain_model:TradeState ;
    skos:closeMatch fpml_5_10:ClearingInstruction.alphaContract ;
    skos:definition "The contract that will be submitted to the clearing house for clearing. The contract should indicate that it should be cleared by assigning a clearing organisation as a party role." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:alternativeTerms a owl:DatatypeProperty ;
    rdfs:label "alternativeTerms" ;
    rdfs:range xsd:string ;
    skos:definition "The alternative dispute resolution procedure if specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:amountBaseCurrency a owl:ObjectProperty ;
    rdfs:label "amountBaseCurrency" ;
    rdfs:range common_domain_model:Money ;
    skos:closeMatch fpml_5_10:CollateralBalance.amountBaseCurrency ;
    skos:definition "Specifies the collateral balance amount in base currency determined within a collateral legal agreement, or defined for reporting purposes." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:amountIsInfinity a owl:DatatypeProperty ;
    rdfs:label "amountIsInfinity" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CSAMinimumTransferAmountVariableSet.amountIsInfinity ;
    skos:definition "A flag that defines the Minimum Transfer Amount (MTA) as Infinity." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:amountOfNetCapital a owl:ObjectProperty ;
    rdfs:label "amountOfNetCapital" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "The amount of net capital." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:amountRemaining a owl:DatatypeProperty ;
    rdfs:label "amountRemaining" ;
    rdfs:range xsd:decimal ;
    skos:definition "The limit remaining for the limit level and limit type. This does not take into account any pending trades. While the attribute is of type integer in FpML and the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:amountUtilized a owl:DatatypeProperty ;
    rdfs:label "amountUtilized" ;
    rdfs:range xsd:decimal ;
    skos:definition "The limit utilised by all the cleared trades for the limit level and limit type. While the attribute is of type integer in FpML and the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:announcementDate a owl:DatatypeProperty ;
    rdfs:label "announcementDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the corporate action is announced by the issuer." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:annualizationFactor a owl:DatatypeProperty ;
    rdfs:label "annualizationFactor" ;
    rdfs:range xsd:integer ;
    skos:definition "This specifies the numerator of an annualization factor. Frequently this number is equal to the number of observations of prices in a year e.g. 252." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:applicableCsa a owl:ObjectProperty ;
    rdfs:label "applicableCsa" ;
    rdfs:range common_domain_model:CsaTypeEnum ;
    skos:closeMatch fpml_5_10:CashCollateralValuationMethod.applicableCsa ;
    skos:definition "This may be used to specify what type of CSA (credit support annex/agreement) is to be used for cash settlement purposes." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:applicableTransfer a owl:DatatypeProperty ;
    rdfs:label "applicableTransfer" ;
    rdfs:range xsd:boolean ;
    skos:definition "The definition of 'Transfer' with respect to Other Eligible Support and Other Posted Support." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:applicableValue a owl:DatatypeProperty ;
    rdfs:label "applicableValue" ;
    rdfs:range xsd:boolean ;
    skos:definition "The definition of 'Value' with respect to Other Eligible Support and Other Posted Support." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:appliedRate a owl:DatatypeProperty ;
    rdfs:label "appliedRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The rate that was actually applied, after all calculations and treatments." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:approved a owl:DatatypeProperty ;
    rdfs:label "approved" ;
    rdfs:range xsd:boolean ;
    skos:definition "Flag denoting whether the workflow step is approved or not" ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:assetAgencyRating a owl:ObjectProperty ;
    rdfs:label "assetAgencyRating" ;
    rdfs:range common_domain_model:AgencyRatingCriteria ;
    skos:definition "Represents an agency rating based on default risk and creditors claim in event of default associated with specific instrument." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:assetFlowType a owl:ObjectProperty ;
    rdfs:label "assetFlowType" ;
    rdfs:range common_domain_model:ScheduledTransferEnum ;
    skos:closeMatch fpml_5_10:AssetFlow.assetFlowType ;
    skos:definition "Type of asset flow corresponding to a scheduled event." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:assignableLoan a owl:ObjectProperty ;
    rdfs:label "assignableLoan" ;
    rdfs:range common_domain_model:PCDeliverableObligationCharac ;
    skos:definition "A deliverable obligation characteristic. A loan that is freely assignable to a bank or financial institution without the consent of the Reference Entity or the guarantor, if any, of the loan (or the consent of the applicable borrower if a Reference Entity is guaranteeing the loan) or any agent. ISDA 2003 Term: Assignable Loan." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:attachmentPoint a owl:DatatypeProperty ;
    rdfs:label "attachmentPoint" ;
    rdfs:range xsd:decimal ;
    skos:definition "Lower bound percentage of the loss that the Tranche can endure, expressed as a decimal. An attachment point of 5% would be represented as 0.05. The difference between Attachment and Exhaustion points is called the width of the Tranche." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:auctionDate a owl:DatatypeProperty ;
    rdfs:label "auctionDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the auction is scheduled to occur." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:automaticEarlyTermination a owl:ObjectProperty ;
    rdfs:label "automaticEarlyTermination" ;
    rdfs:range common_domain_model:AutomaticEarlyTermination ;
    skos:definition "The specification of whether there is an automatic occurrence of an Early Termination Date in respect of Transactions upon the occurrence of certain bankruptcy / insolvency related events." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:automaticEarlyTerminationApplies a owl:ObjectProperty ;
    rdfs:label "automaticEarlyTerminationApplies" ;
    rdfs:range common_domain_model:ApplicabilityOfElectionEnum ;
    skos:definition "Does automatic early termination apply to the specified party?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:automaticEarlyTerminationInModifiedForm a owl:DatatypeProperty ;
    rdfs:label "automaticEarlyTerminationInModifiedForm" ;
    rdfs:range xsd:boolean ;
    skos:definition "Automatic early termination applies in a modified form only." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:automaticEarlyTerminationOther a owl:DatatypeProperty ;
    rdfs:label "automaticEarlyTerminationOther" ;
    rdfs:range xsd:string ;
    skos:definition "Optional string to capture any further information regarding the automatic early termination even of default." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:automaticEarlyTerminationRequiredDueToSystemOfLaw a owl:DatatypeProperty ;
    rdfs:label "automaticEarlyTerminationRequiredDueToSystemOfLaw" ;
    rdfs:range xsd:boolean ;
    skos:definition "Automatic early termination only applies if required due to system of law, otherwise it is not applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:automaticEarlyTerminationSpecifiedSeparatelyForEachPrinciple a owl:DatatypeProperty ;
    rdfs:label "automaticEarlyTerminationSpecifiedSeparatelyForEachPrinciple" ;
    rdfs:range xsd:boolean ;
    skos:definition "In the case where party is acting as an agent, is automatic early termination specified on a per principle basis?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:automaticExercise a owl:ObjectProperty ;
    rdfs:label "automaticExercise" ;
    rdfs:range common_domain_model:AutomaticExercise ;
    skos:definition "If automatic is specified, then the notional amount of the underlying swap not previously exercised under the swaption will be automatically exercised at the expiration time on the expiration date if at such time the buyer is in-the-money, provided that the difference between the settlement rate and the fixed rate under the relevant underlying swap is not less than the specified threshold rate. The term in-the-money is assumed to have the meaning defining in the 2000 ISDA Definitions, Section 17.4 In-the-money." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:automaticSetOff a owl:DatatypeProperty ;
    rdfs:label "automaticSetOff" ;
    rdfs:range xsd:boolean ;
    skos:definition "The Automatic Set-Off provision applies when the value is set to True." ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(l)\" name \"Modification to Obligors Rights and Remedies\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:automation a owl:ObjectProperty ;
    rdfs:label "automation" ;
    rdfs:range common_domain_model:ApplicabilityOfElectionEnum ;
    skos:definition "Are third party vendors allowed to automate the processing of loans in the event of default (Only relevant to 2010 GMSLAs)?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:availableInventoryType a owl:ObjectProperty ;
    rdfs:label "availableInventoryType" ;
    rdfs:range common_domain_model:AvailableInventoryTypeEnum ;
    skos:closeMatch fpml_5_10:AvailableInventory.availableInventoryType ;
    skos:definition "Defines the purpose of this inventory." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:averageTradingVolume a owl:ObjectProperty ;
    rdfs:label "averageTradingVolume" ;
    rdfs:range common_domain_model:AverageTradingVolume ;
    skos:definition "Specifies an average trading volume on an exchange in relation to Equity products." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:averagingDateTimes a owl:ObjectProperty ;
    rdfs:label "averagingDateTimes" ;
    rdfs:range common_domain_model:DateTimeList ;
    skos:closeMatch fpml_5_10:AveragingPeriod.averagingDateTimes ;
    skos:definition "An unweighted list of averaging observation date and times." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:averagingInOut a owl:ObjectProperty ;
    rdfs:label "averagingInOut" ;
    rdfs:range common_domain_model:AveragingInOutEnum ;
    skos:closeMatch fpml_5_10:AveragingFeature.averagingInOut ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:averagingMethodology a owl:ObjectProperty ;
    rdfs:label "averagingMethodology" ;
    rdfs:range common_domain_model:AveragingCalculation ;
    skos:definition "Identifies the aggregation method to use in the case where multiple observations are used to compute the reset value and the method is not defined in a payout." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:averagingObservations a owl:ObjectProperty ;
    rdfs:label "averagingObservations" ;
    rdfs:range common_domain_model:AveragingObservationList ;
    skos:closeMatch fpml_5_10:AveragingPeriod.averagingObservations ;
    skos:definition "A weighted list of averaging observation date and times." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:averagingPeriodFrequency a owl:ObjectProperty ;
    rdfs:label "averagingPeriodFrequency" ;
    rdfs:range common_domain_model:CalculationPeriodFrequency ;
    skos:closeMatch fpml_5_10:AveragingSchedule.averagingPeriodFrequency ;
    skos:definition "The frequency at which averaging period occurs with the regular part of the valuation schedule and their roll date convention." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:averagingPeriodIn a owl:ObjectProperty ;
    rdfs:label "averagingPeriodIn" ;
    rdfs:range common_domain_model:AveragingPeriod ;
    skos:closeMatch fpml_5_10:AveragingFeature.averagingPeriodIn ;
    skos:definition "The averaging in period." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:averagingPeriodOut a owl:ObjectProperty ;
    rdfs:label "averagingPeriodOut" ;
    rdfs:range common_domain_model:AveragingPeriod ;
    skos:closeMatch fpml_5_10:AveragingFeature.averagingPeriodOut ;
    skos:definition "The averaging out period." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:averagingStrikeFeature a owl:ObjectProperty ;
    rdfs:label "averagingStrikeFeature" ;
    rdfs:range common_domain_model:AveragingStrikeFeature ;
    skos:definition "Defines an  option strike that is calculated from an average of observed market prices." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:balanceOfFirstPeriod a owl:DatatypeProperty ;
    rdfs:label "balanceOfFirstPeriod" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CalculationPeriodFrequency.balanceOfFirstPeriod ;
    skos:definition "Indicates, when true, that that the first Calculation Period should run from the Effective Date to the end of the calendar period in which the Effective Date falls, e.g. Jan 15 - Jan 31 if the calculation periods are one month long and Effective Date is Jan 15. If false, the first Calculation Period should run from the Effective Date for one whole period, e.g. Jan 15 to Feb 14 if the calculation periods are one month long and Effective Date is Jan 15. Mostly used in Commmodity Swaps." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:bankHolidaysTreatment a owl:ObjectProperty ;
    rdfs:label "bankHolidaysTreatment" ;
    rdfs:range common_domain_model:BankHolidayTreatmentEnum ;
    skos:closeMatch fpml_5_10:AssetDeliveryProfile.bankHolidaysTreatment ;
    skos:definition "Specifies whether the dates defined include holidays or not." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:bankruptcy a owl:DatatypeProperty ;
    rdfs:label "bankruptcy" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. The reference entity has been dissolved or has become insolvent. It also covers events that may be a precursor to insolvency such as instigation of bankruptcy or insolvency proceedings. Sovereign trades are not subject to Bankruptcy as 'technically' a Sovereign cannot become bankrupt. ISDA 2003 Term: Bankruptcy." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:barrier a owl:ObjectProperty ;
    rdfs:label "barrier" ;
    rdfs:range common_domain_model:Barrier ;
    skos:definition "Specifies a barrier feature." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:baseCurrencyExposure a owl:ObjectProperty ;
    rdfs:label "baseCurrencyExposure" ;
    rdfs:range common_domain_model:MarginCallExposure ;
    skos:definition "Represents the current mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency), to be referenced in a margin call." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:baseCurrencyIfOriginalNotFreelyConvertible a owl:ObjectProperty ;
    rdfs:label "baseCurrencyIfOriginalNotFreelyConvertible" ;
    rdfs:range common_domain_model:CurrencyCodeEnum ;
    skos:closeMatch fpml_5_10:BaseCurrency.baseCurrencyIfOriginalNotFreelyConvertible ;
    skos:definition "If the base currency is not freely convertible, the fallback currency can be defined here." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:baseCurrencyMustBeFreelyConvertible a owl:DatatypeProperty ;
    rdfs:label "baseCurrencyMustBeFreelyConvertible" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:BaseCurrency.baseCurrencyMustBeFreelyConvertible ;
    skos:definition "The base currency that is defined must be freely convertible." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:baseCurrencyOther a owl:DatatypeProperty ;
    rdfs:label "baseCurrencyOther" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BaseAndEligibleCurrency.baseCurrencyOther ;
    skos:definition "Utilised where the clause data structure is not able to capture a material aspect of the clause." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    common_domain_model:metadata_scheme true .

common_domain_model:baseCurrencyTerminationCurrency a owl:DatatypeProperty ;
    rdfs:label "baseCurrencyTerminationCurrency" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:BaseAndEligibleCurrency.baseCurrencyTerminationCurrency ;
    skos:definition "A flag detailing whether the Base Currency is set to  the Termination Currency as defined in the related  Master Agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:baseValue a owl:DatatypeProperty ;
    rdfs:label "baseValue" ;
    rdfs:range xsd:decimal ;
    skos:definition "The 1st value in the arithmetic operation, which may be non-commutative in some cases: Subtract, Divide). This 1st operand is called 'baseValue' as it refers to the price anchor in the arithmetic operation: e.g. the clean price (Bond) or the spot rate (FX)." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:basketName a owl:DatatypeProperty ;
    rdfs:label "basketName" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BasketReferenceInformation.basketName ;
    skos:definition "The name of the basket expressed as a free format string. FpML does not define usage rules for this element." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:before a owl:ObjectProperty ;
    rdfs:label "before" ;
    rdfs:range common_domain_model:TradeState ;
    skos:definition "Specifies the trade state that will be acted on by the primitive event functions." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:belgianLawSecurityAgreement a owl:DatatypeProperty ;
    rdfs:label "belgianLawSecurityAgreement" ;
    rdfs:range xsd:boolean ;
    skos:definition "The qualification of whether the Belgian Law Security Agreement Addendum is deemed applicable by the parties (True) or not (False)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:benchmarkObligationDefault a owl:ObjectProperty ;
    rdfs:label "benchmarkObligationDefault" ;
    rdfs:range common_domain_model:FxBenchmarkObligationDefault ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(i)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:benchmarkObligationDefaultIsApplicable a owl:DatatypeProperty ;
    rdfs:label "benchmarkObligationDefaultIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:bespokeCalculationAgentTerms a owl:DatatypeProperty ;
    rdfs:label "bespokeCalculationAgentTerms" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CalculationAgentTerms.bespokeCalculationAgentTerms ;
    skos:definition "The Calculation Agent (IM) terms when specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:bespokeCalculationFormula a owl:DatatypeProperty ;
    rdfs:label "bespokeCalculationFormula" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.bespokeCalculationFormula ;
    skos:definition "To describe the formula used to calculate the Adjustment Factor." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:bespokeCreditSuppportDocument a owl:DatatypeProperty ;
    rdfs:label "bespokeCreditSuppportDocument" ;
    rdfs:range xsd:string ;
    skos:definition "Specification of a document when not captured under RelatedAgreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:bespokeCreditSuppportProvider a owl:DatatypeProperty ;
    rdfs:label "bespokeCreditSuppportProvider" ;
    rdfs:range xsd:string ;
    skos:definition "..." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:bespokeEscrowArrangements a owl:ObjectProperty ;
    rdfs:label "bespokeEscrowArrangements" ;
    rdfs:range common_domain_model:Clause ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:bespokeTransferTiming a owl:ObjectProperty ;
    rdfs:label "bespokeTransferTiming" ;
    rdfs:range common_domain_model:BespokeTransferTiming ;
    skos:definition "The time by which the transfer of collateral must take place when different from the Regular Settlement Day as a result of parties' election." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:bespokeTransferTimingTerms a owl:DatatypeProperty ;
    rdfs:label "bespokeTransferTimingTerms" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BespokeTransferTiming.bespokeTransferTimingTerms ;
    skos:definition "The bespoke transfer timing terms applicable to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:bond a owl:ObjectProperty ;
    rdfs:label "bond" ;
    rdfs:range common_domain_model:Security ;
    skos:closeMatch fpml_5_10:BondReference.bond ;
    skos:definition "Reference to a bond underlier." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:bondReference a owl:ObjectProperty ;
    rdfs:label "bondReference" ;
    rdfs:range common_domain_model:BondReference ;
    skos:definition "Reference to a bond underlier to represent an asset swap or Condition Precedent Bond." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:bothAffected a owl:DatatypeProperty ;
    rdfs:label "bothAffected" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies fallback Termination Currency where both parties are Affected Parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:bothAffectedTermCurrencyOption a owl:DatatypeProperty ;
    rdfs:label "bothAffectedTermCurrencyOption" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies termination currency where there are two Affected Parties and they cannot agree on the termination currency." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:boundary a owl:ObjectProperty ;
    rdfs:label "boundary" ;
    rdfs:range common_domain_model:CreditNotationBoundaryEnum ;
    skos:closeMatch fpml_5_10:AgencyRatingCriteria.boundary ;
    skos:definition "Indicates the boundary of a credit agency rating i.e minimum or maximum." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:boundedCorrelation a owl:ObjectProperty ;
    rdfs:label "boundedCorrelation" ;
    rdfs:range common_domain_model:NumberRange ;
    skos:definition "Describes correlation bounds, which form a cap and a floor on the realized correlation." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:bsisPts a owl:DatatypeProperty ;
    rdfs:label "bsisPts" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#BsisPts> .

common_domain_model:businessDateRange a owl:ObjectProperty ;
    rdfs:label "businessDateRange" ;
    rdfs:range common_domain_model:BusinessDateRange ;
    skos:definition "A range of contiguous business days. This attribute is meant to be merged with the 'settlementDate' at some future point once we refactor 'Date' to use a single complex type across the model. This attributes was formerly part of 'CashSettlementPaymentDate', as included into 'OptionCashSettlement' (which is now merged into a unique 'CashSettlementTerms' data type." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:businessDaysNotSpecified a owl:DatatypeProperty ;
    rdfs:label "businessDaysNotSpecified" ;
    rdfs:range xsd:boolean ;
    skos:definition "An explicit indication that a number of business days are not specified and therefore ISDA fallback provisions should apply." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:businessEvent a owl:ObjectProperty ;
    rdfs:label "businessEvent" ;
    rdfs:range common_domain_model:BusinessEvent ;
    skos:definition "Life cycle event for the step." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:buyerSeller a owl:ObjectProperty ;
    rdfs:label "buyerSeller" ;
    rdfs:range common_domain_model:BuyerSeller ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:buyr a owl:ObjectProperty ;
    rdfs:label "buyr" ;
    rdfs:range common_domain_model:Buyr ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Buyr> .

common_domain_model:cabEndDate a owl:DatatypeProperty ;
    rdfs:label "cabEndDate" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CollateralAccessBreach.cabEndDate ;
    skos:definition "The business days following the related Collateral Access Breach when the additional terms end." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:calculationAgentBusinessCenter a owl:DatatypeProperty ;
    rdfs:label "calculationAgentBusinessCenter" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CalculationAgent.calculationAgentBusinessCenter ;
    skos:definition "The city in which the office through which ISDA Calculation Agent is acting for purposes of the transaction is located The short-form confirm for a trade that is executed under a Sovereign or Asia Pacific Master Confirmation Agreement ( MCA ), does not need to specify the Calculation Agent. However, the confirm does need to specify the Calculation Agent City. This is due to the fact that the MCA sets the value for Calculation Agent but does not set the value for Calculation Agent City." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:calculationAgentDetermination a owl:ObjectProperty ;
    rdfs:label "calculationAgentDetermination" ;
    rdfs:range common_domain_model:CalculationAgent ;
    skos:definition "The calculation agent will decide the rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:calculationAgentParty a owl:ObjectProperty ;
    rdfs:label "calculationAgentParty" ;
    rdfs:range common_domain_model:AncillaryRoleEnum ;
    skos:closeMatch fpml_5_10:CalculationAgent.calculationAgentParty ;
    skos:definition "Specifies the party which is the ISDA Calculation Agent for the trade. If more than one party is referenced then the parties are assumed to be co-calculation agents, i.e. they have joint responsibility." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:calculationAgentPartyEnum a owl:ObjectProperty ;
    rdfs:label "calculationAgentPartyEnum" ;
    rdfs:range common_domain_model:PartyDeterminationEnum ;
    skos:closeMatch fpml_5_10:CalculationAgent.calculationAgentPartyEnum ;
    skos:definition "Specifies the ISDA calculation agent responsible for performing duties as defined in the applicable product definitions. For example, the Calculation Agent may be defined as being the Non-exercising Party." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:calculationBase a owl:ObjectProperty ;
    rdfs:label "calculationBase" ;
    rdfs:range common_domain_model:ObservationPeriodDatesEnum ;
    skos:definition "Whether the rate is calculated in advance, in arrears, or relative to a reset date." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:calculationDateTime a owl:DatatypeProperty ;
    rdfs:label "calculationDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Indicates the date when the exposure is calculated if different from valuation date." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:calculationDefaults a owl:ObjectProperty ;
    rdfs:label "calculationDefaults" ;
    rdfs:range common_domain_model:FloatingRateIndexCalculationDefaults ;
    skos:definition "Any calculation default values." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:calculationDetails a owl:ObjectProperty ;
    rdfs:label "calculationDetails" ;
    rdfs:range common_domain_model:CalculatedRateDetails ;
    skos:definition "Calculated rate details (observation dates, values, and weights)." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:calculationPeriodDatesAdjustments a owl:ObjectProperty ;
    rdfs:label "calculationPeriodDatesAdjustments" ;
    rdfs:range common_domain_model:BusinessDayAdjustments ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates.calculationPeriodDatesAdjustments ;
    skos:definition "The specification of the business day convention and financial business centers used for adjusting any calculation period date if it would otherwise fall on a day that is not a business day in the specified business center." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:calculationPeriodFrequency a owl:ObjectProperty ;
    rdfs:label "calculationPeriodFrequency" ;
    rdfs:range common_domain_model:CalculationPeriodFrequency ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates.calculationPeriodFrequency ;
    skos:definition "The frequency at which calculation period end dates occur with the regular part of the calculation period schedule and their roll date convention." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:calculationStyle a owl:ObjectProperty ;
    rdfs:label "calculationStyle" ;
    rdfs:range common_domain_model:InflationCalculationStyleEnum ;
    skos:definition "Indicates the style of how the inflation index calculates the payment (e.g. YearOnYear, ZeroCoupon)." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:calendarSpread a owl:ObjectProperty ;
    rdfs:label "calendarSpread" ;
    rdfs:range common_domain_model:CalendarSpread ;
    skos:definition "Definition of the later expiration date in a calendar spread." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:callAgreementType a owl:ObjectProperty ;
    rdfs:label "callAgreementType" ;
    rdfs:range common_domain_model:AgreementName ;
    skos:definition "Specifies the legal agreement type the margin call is generated from and governed by." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:callAmountInBaseCurrency a owl:ObjectProperty ;
    rdfs:label "callAmountInBaseCurrency" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "Specifies the amount of margin being called for which accounts for margin calculation inclusive of exposure, independent amount,threshold,collateral balance, MTA, rounding increments (in base currency detailed in supporting collateral agreement)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:callFunction a owl:DatatypeProperty ;
    rdfs:label "callFunction" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:callIdentifier a owl:ObjectProperty ;
    rdfs:label "callIdentifier" ;
    rdfs:range common_domain_model:Identifier ;
    skos:definition "Represents a unique Identifier for a margin call message, that can be referenced throughout all points of the process." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:cancelableProvision a owl:ObjectProperty ;
    rdfs:label "cancelableProvision" ;
    rdfs:range common_domain_model:CancelableProvision ;
    skos:definition "A provision that allows the specification of an embedded option within a swap giving the buyer of the option the right to terminate the swap, in whole or in part, on the early termination date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:cancelableProvisionAdjustedDates a owl:ObjectProperty ;
    rdfs:label "cancelableProvisionAdjustedDates" ;
    rdfs:range common_domain_model:CancelableProvisionAdjustedDates ;
    skos:closeMatch fpml_5_10:CancelableProvision.cancelableProvisionAdjustedDates ;
    skos:definition "The adjusted dates associated with a cancelable provision. These dates have been adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:canonicalUri a owl:DatatypeProperty ;
    rdfs:label "canonicalUri" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CodeListIdentification.canonicalUri ;
    skos:definition "Canonical URI which uniquely identifies all versions (collectively) of the referenced code list. Must be an absolute URI. Must not be used as a de facto location URI." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:canonicalVersionUri a owl:DatatypeProperty ;
    rdfs:label "canonicalVersionUri" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CodeListIdentification.canonicalVersionUri ;
    skos:definition "Canonical URI which uniquely identifies a specific version of the referenced code list. Must be an absolute URI. Must not be used as a de facto location URI." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:cash a owl:ObjectProperty ;
    rdfs:label "cash" ;
    rdfs:range common_domain_model:ValueCashEnum ;
    skos:definition "Details of how cash collateral is valued when resolving disputes." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:cashBalance a owl:ObjectProperty ;
    rdfs:label "cashBalance" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "The aggregate cost of proceeds." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:cashCollateral a owl:ObjectProperty ;
    rdfs:label "cashCollateral" ;
    rdfs:range common_domain_model:ValueCashEnum ;
    skos:closeMatch fpml_5_10:CollateralValueMethod.cashCollateral ;
    skos:definition "Details of how cash collateral is valued." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:cashCollateralCurrency a owl:DatatypeProperty ;
    rdfs:label "cashCollateralCurrency" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CashCollateralValuationMethod.cashCollateralCurrency ;
    skos:definition "This may be used to indicate the currency of cash collateral for cash settlement purposes." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:cashCollateralInterestRate a owl:DatatypeProperty ;
    rdfs:label "cashCollateralInterestRate" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CashCollateralValuationMethod.cashCollateralInterestRate ;
    skos:definition "This may be used to indicate the interest rate to be used for cash collateral for cash settlement purposes." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:cashCollateralTransferSettlementTime a owl:ObjectProperty ;
    rdfs:label "cashCollateralTransferSettlementTime" ;
    rdfs:range common_domain_model:CashCTSTimeEnum ;
    skos:definition "Details the day on which collateral is required to be transferred relative to the Notification Time." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:cashCollateralValuationMethod a owl:ObjectProperty ;
    rdfs:label "cashCollateralValuationMethod" ;
    rdfs:range common_domain_model:CashCollateralValuationMethod ;
    skos:definition "Specifies the parameters representing several mid-market valuation and replacement value methods." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:cashOrSecurityValue a owl:ObjectProperty ;
    rdfs:label "cashOrSecurityValue" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "The Base Currency Equivalent of Cash or Security." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:cashSettlementAmount a owl:ObjectProperty ;
    rdfs:label "cashSettlementAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:closeMatch fpml_5_10:CashSettlementTerms.cashSettlementAmount ;
    skos:definition "The amount paid by the seller to the buyer for cash settlement on the cash settlement date. If not otherwise specified, would typically be calculated as 100 (or the Reference Price) minus the price of the Reference Obligation (all expressed as a percentage) times Floating Rate Payer Calculation Amount. ISDA 2003 Term: Cash Settlement Amount." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:cashSettlementMethod a owl:ObjectProperty ;
    rdfs:label "cashSettlementMethod" ;
    rdfs:range common_domain_model:CashSettlementMethodEnum ;
    skos:closeMatch fpml_5_10:CashSettlementTerms.cashSettlementMethod ;
    skos:definition "Specifies the type of cash settlement method: cash price, yield curve etc." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:cashSettlementOnly a owl:DatatypeProperty ;
    rdfs:label "cashSettlementOnly" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Defined in the ISDA published Standard Terms Supplement for use with CDS Transactions on Leveraged Loans. ISDA 2003 Term: Cash Settlement Only." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:cashSettlementTermsReference a owl:ObjectProperty ;
    rdfs:label "cashSettlementTermsReference" ;
    rdfs:range common_domain_model:CashSettlementTerms ;
    skos:definition "Reference to the cash settlement terms applicable to this item." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_reference true .

common_domain_model:cashTransfer a owl:ObjectProperty ;
    rdfs:label "cashTransfer" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:ScheduledTransfer common_domain_model:UnscheduledTransfer ) ] common_domain_model:Transfer ) ] ;
    skos:definition "Specifies the cash transfer that can optionally be tied to an index transition event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:cashflowRepresentation a owl:ObjectProperty ;
    rdfs:label "cashflowRepresentation" ;
    rdfs:range common_domain_model:CashflowRepresentation ;
    skos:definition "The cashflow representation of the swap stream." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:cashflowsMatchParameters a owl:DatatypeProperty ;
    rdfs:label "cashflowsMatchParameters" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CashflowRepresentation.cashflowsMatchParameters ;
    skos:definition "A true/false flag to indicate whether the cashflows match the parametric definition of the stream, i.e. whether the cashflows could be regenerated from the parameters without loss of information." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:changeInLaw a owl:DatatypeProperty ;
    rdfs:label "changeInLaw" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.changeInLaw ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:childSecurity a owl:ObjectProperty ;
    rdfs:label "childSecurity" ;
    rdfs:range common_domain_model:Security ;
    skos:definition "Defines the underlier for the Child Company involved in Spin Off corporate action." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:childSecurityPrice a owl:ObjectProperty ;
    rdfs:label "childSecurityPrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "The price observation that relates to underlier for the Child Company." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:city a owl:DatatypeProperty ;
    rdfs:label "city" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Address.city ;
    skos:definition "The city component of the postal address." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:className a owl:DatatypeProperty ;
    rdfs:label "className" ;
    rdfs:range xsd:string ;
    skos:definition "The name defined by the classification system for a specific attribute in the taxonomy" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:clauseLibrary a owl:DatatypeProperty ;
    rdfs:label "clauseLibrary" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AgreementTerms.clauseLibrary ;
    skos:definition "Specification of whether the agreement terms have been negotiated using the clause library methodology." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:clearedPhysicalSettlement a owl:DatatypeProperty ;
    rdfs:label "clearedPhysicalSettlement" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies whether the swap resulting from physical settlement of the swaption transaction will clear through a clearing house. The meaning of Cleared Physical Settlement is defined in the 2006 ISDA Definitions, Section 15.2 (published in Supplement number 28)." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:clearerParty1 a owl:ObjectProperty ;
    rdfs:label "clearerParty1" ;
    rdfs:range common_domain_model:Party ;
    skos:closeMatch fpml_5_10:ClearingInstruction.clearerParty1 ;
    skos:definition "Optional party facing the CCP, acting as clearing member for party1." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:clearerParty2 a owl:ObjectProperty ;
    rdfs:label "clearerParty2" ;
    rdfs:range common_domain_model:Party ;
    skos:closeMatch fpml_5_10:ClearingInstruction.clearerParty2 ;
    skos:definition "Optional party facing the CCP, acting as clearing member for party2." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:clearingBroker a owl:ObjectProperty ;
    rdfs:label "clearingBroker" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "Indicates the name of the Clearing Broker FCM/DCM." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:clearingParty a owl:ObjectProperty ;
    rdfs:label "clearingParty" ;
    rdfs:range common_domain_model:Party ;
    skos:closeMatch fpml_5_10:ClearingInstruction.clearingParty ;
    skos:definition "The Central Counter party (CCP) that the contract will be submitted to for clearing." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:clearstreamAmendmentToJapaneseProvisions a owl:DatatypeProperty ;
    rdfs:label "clearstreamAmendmentToJapaneseProvisions" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specification of whether Clearstream Event amendment language is included (true) or excluded (false)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:clientAssetSourcebookAdditionalLanguage a owl:DatatypeProperty ;
    rdfs:label "clientAssetSourcebookAdditionalLanguage" ;
    rdfs:range xsd:string ;
    skos:definition "Details of language relating to Client Asset and Money Rules (CASS)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:clipSize a owl:DatatypeProperty ;
    rdfs:label "clipSize" ;
    rdfs:range xsd:integer ;
    skos:definition "This element is required in FpML, optional in CDM for the purpose of accommodating the CME data representation while making reference to the FpML one." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:clssfctnTp a owl:DatatypeProperty ;
    rdfs:label "clssfctnTp" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#ClssfctnTp> .

common_domain_model:codeShortId a owl:DatatypeProperty ;
    rdfs:label "codeShortId" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CodeListIdentification.codeShortId ;
    skos:definition "The name of the code list, e.g. business-center" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:collateralAccessBreach a owl:ObjectProperty ;
    rdfs:label "collateralAccessBreach" ;
    rdfs:range common_domain_model:CollateralAccessBreach ;
    skos:definition "The elections specific to Collateral Access Breach language." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:collateralAssetType a owl:ObjectProperty ;
    rdfs:label "collateralAssetType" ;
    rdfs:range common_domain_model:AssetType ;
    skos:definition "The asset product type." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:collateralBalanceStatus a owl:ObjectProperty ;
    rdfs:label "collateralBalanceStatus" ;
    rdfs:range common_domain_model:CollateralStatusEnum ;
    skos:closeMatch fpml_5_10:CollateralBalance.collateralBalanceStatus ;
    skos:definition "Defines the collateral balance breakdown of settlement status." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:collateralCriteria a owl:ObjectProperty ;
    rdfs:label "collateralCriteria" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllCriteria common_domain_model:AnyCriteria common_domain_model:NegativeCriteria common_domain_model:CollateralIssuerType common_domain_model:CollateralGuarantorType common_domain_model:AssetType common_domain_model:IssuerCountryOfOrigin common_domain_model:AssetCountryOfOrigin common_domain_model:CurrencyCodeEnum common_domain_model:IssuerName common_domain_model:IssuerAgencyRating common_domain_model:SovereignAgencyRating common_domain_model:AssetAgencyRating common_domain_model:AssetMaturity common_domain_model:SpecificAsset common_domain_model:CollateralTaxonomy common_domain_model:ListingExchange common_domain_model:ListingSector common_domain_model:IndexType common_domain_model:CounterpartyOwnIssuePermitted common_domain_model:DomesticCurrencyIssued ) ] common_domain_model:CollateralCriteria ) ] ;
    skos:closeMatch fpml_5_10:CollateralCriteriaBase.collateralCriteria ;
    skos:definition "The specific criteria that applies. It can be created using AND, OR and NOT logic, and both asset and issuer characteristics." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:collateralPositionStatus a owl:ObjectProperty ;
    rdfs:label "collateralPositionStatus" ;
    rdfs:range common_domain_model:CollateralStatusEnum ;
    skos:closeMatch fpml_5_10:CollateralPosition.collateralPositionStatus ;
    skos:definition "Indicates the collateral positions settlement status." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:collateralTransferAgreementElections a owl:ObjectProperty ;
    rdfs:label "collateralTransferAgreementElections" ;
    rdfs:range common_domain_model:CollateralTransferAgreementElections ;
    skos:closeMatch fpml_5_10:Agreement.collateralTransferAgreementElections ;
    skos:definition "Elections to specify a Collateral Transfer Agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:collateralTransferTiming a owl:ObjectProperty ;
    rdfs:label "collateralTransferTiming" ;
    rdfs:range common_domain_model:CollateralTransferTiming ;
    skos:definition "Specification of transfer / settlement timing for cash and securities collateral assuming that the notice is provided before the Notification Time (and with a 1LBD lag introduced if the notice is delivered after the Notification Time), and that securities allow for a further Local Business Day for transfer / settlement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:collateralTransferTimingDefinition a owl:ObjectProperty ;
    rdfs:label "collateralTransferTimingDefinition" ;
    rdfs:range common_domain_model:CollateralTransferTimingDefinition ;
    skos:closeMatch fpml_5_10:CollateralTransferTiming.collateralTransferTimingDefinition ;
    skos:definition "Bespoke language removing the pre-print requirement to transfer legal title of securities collateral through written instructions to the relevant depository institution or other securities intermediaries solely for the purposes of the 1994 New York Law Credit Support Annex." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:collateralType a owl:ObjectProperty ;
    rdfs:label "collateralType" ;
    rdfs:range common_domain_model:CollateralTypeEnum ;
    skos:closeMatch fpml_5_10:CollateralProvisions.collateralType ;
    skos:definition "Enumerates the collateral types which are accepted by the Seller." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/GMRA#marginType> .

common_domain_model:comments a owl:DatatypeProperty ;
    rdfs:label "comments" ;
    rdfs:range xsd:string ;
    skos:definition "Any additional comments that are deemed necessary. For example, which software version is required to open the document? Or, how does this resource relate to the others for this event?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:commoditiesAdditionalTerms a owl:DatatypeProperty ;
    rdfs:label "commoditiesAdditionalTerms" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:commodityCurve a owl:ObjectProperty ;
    rdfs:label "commodityCurve" ;
    rdfs:range common_domain_model:CommodityReferencePriceEnum ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:commodityInfoPublisher a owl:ObjectProperty ;
    rdfs:label "commodityInfoPublisher" ;
    rdfs:range common_domain_model:CommodityInformationPublisherEnum ;
    skos:closeMatch fpml_5_10:CommodityProductDefinition.commodityInfoPublisher ;
    skos:definition "Specifies the publication where the commodity prices can be found." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:commodityName a owl:DatatypeProperty ;
    rdfs:label "commodityName" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CommodityReferenceFramework.commodityName ;
    skos:definition "Identifies the commodity more specifically. Where possible, this should follow the naming convention used in the 2005 ISDA Commodity Definitions SubAnnex A, including the subCommodity and additional qualifiers, but should be limited to 256 characters or less." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:commodityPriceReturnTerms a owl:ObjectProperty ;
    rdfs:label "commodityPriceReturnTerms" ;
    rdfs:range common_domain_model:CommodityPriceReturnTerms ;
    skos:closeMatch fpml_5_10:CommodityPayout.commodityPriceReturnTerms ;
    skos:definition "Defines parameters in which the commodity price is assessed." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:commodityProductDefinition a owl:ObjectProperty ;
    rdfs:label "commodityProductDefinition" ;
    rdfs:range common_domain_model:CommodityProductDefinition ;
    skos:closeMatch fpml_5_10:Commodity.commodityProductDefinition ;
    skos:definition "Specifies the commodity underlier in the event that no ISDA Commodity Reference Benchmark exists." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:compositionOfCombinedConsideration a owl:DatatypeProperty ;
    rdfs:label "compositionOfCombinedConsideration" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:compounding a owl:DatatypeProperty ;
    rdfs:label "compounding" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:compoundingMethod a owl:ObjectProperty ;
    rdfs:label "compoundingMethod" ;
    rdfs:range common_domain_model:CompoundingMethodEnum ;
    skos:definition "If one or more calculation period contributes to a single payment amount this element specifies whether compounding is applicable and, if so, what compounding method is to be used. This element must only be included when more than one calculation period contributes to a single payment amount." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:compressibleSpread a owl:DatatypeProperty ;
    rdfs:label "compressibleSpread" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralAgreementFloatingRate.compressibleSpread ;
    skos:definition "Specifies how spreads should be applied in a low/negative rate environment.  If true, spread is applied only if rate is positive." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:concentrationLimitCriteria a owl:ObjectProperty ;
    rdfs:label "concentrationLimitCriteria" ;
    rdfs:range common_domain_model:ConcentrationLimitCriteria ;
    skos:definition "Specifies a set of criteria to describe the assets that the concentration limits apply to." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:concentrationLimitType a owl:ObjectProperty ;
    rdfs:label "concentrationLimitType" ;
    rdfs:range common_domain_model:ConcentrationLimitTypeEnum ;
    skos:definition "Specifies the type of concentration limit to be applied." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:conditionPrecedentBond a owl:DatatypeProperty ;
    rdfs:label "conditionPrecedentBond" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:BondReference.conditionPrecedentBond ;
    skos:definition "To indicate whether the Condition Precedent Bond is applicable. The swap contract is only valid if the bond is issued and if there is any dispute over the terms of fixed stream then the bond terms would be used." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:conditionsPrecedentElection a owl:ObjectProperty ;
    rdfs:label "conditionsPrecedentElection" ;
    rdfs:range common_domain_model:ExceptionEnum ;
    skos:definition "The election to specify whether the standard Conditions Precedent apply." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:consentRequiredLoan a owl:ObjectProperty ;
    rdfs:label "consentRequiredLoan" ;
    rdfs:range common_domain_model:PCDeliverableObligationCharac ;
    skos:definition "A deliverable obligation characteristic. A loan that is capable of being assigned with the consent of the Reference Entity or the guarantor, if any, of the loan or any agent. ISDA 2003 Term: Consent Required Loan." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:consistencyWithControlAgreement a owl:DatatypeProperty ;
    rdfs:label "consistencyWithControlAgreement" ;
    rdfs:range xsd:boolean ;
    skos:definition "Unless specified as inapplicable in the event of any inconsistency between this Deed and the Control Agreement, this Deed will prevail over the Control Agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:constituentWeight a owl:ObjectProperty ;
    rdfs:label "constituentWeight" ;
    rdfs:range common_domain_model:ConstituentWeight ;
    skos:definition "Describes the weight of each of the constituents within the basket. If not provided, it is assumed to be equal weighted." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:continuity a owl:DatatypeProperty ;
    rdfs:label "continuity" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Defined in the ISDA published Standard Terms Supplement for use with CDS Transactions on Leveraged Loans. ISDA 2003 Term: Continuity." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:contractFormation a owl:ObjectProperty ;
    rdfs:label "contractFormation" ;
    rdfs:range common_domain_model:ContractFormationInstruction ;
    skos:definition "Specifies instructions describing an contract formation primitive event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:contractualDefinitionType a owl:ObjectProperty ;
    rdfs:label "contractualDefinitionType" ;
    rdfs:range common_domain_model:ContractualDefinitionsEnum ;
    skos:definition "e.g. ISDA2021Definitions" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:contractualDefinitionVersion a owl:DatatypeProperty ;
    rdfs:label "contractualDefinitionVersion" ;
    rdfs:range xsd:string ;
    skos:definition "e.g. V1" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:contractualTermsSupplementType a owl:ObjectProperty ;
    rdfs:label "contractualTermsSupplementType" ;
    rdfs:range common_domain_model:ContractualSupplementTypeEnum ;
    skos:definition "Identifies the form of applicable contractual supplement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:controlAgreement a owl:ObjectProperty ;
    rdfs:label "controlAgreement" ;
    rdfs:range common_domain_model:ControlAgreement ;
    skos:definition "The party-specific election with respect to the control agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:controlAgreementAsCsd a owl:DatatypeProperty ;
    rdfs:label "controlAgreementAsCsd" ;
    rdfs:range xsd:boolean ;
    skos:definition "The identification of whether the Control Agreement is a Credit Support Document with respect to each party." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:controlAgreementNecEvent a owl:ObjectProperty ;
    rdfs:label "controlAgreementNecEvent" ;
    rdfs:range common_domain_model:ControlAgreementNecEvent ;
    skos:definition "The bespoke provisions that might be specified by the parties to the agreement applicable to a Notice of Exclusive Control Event." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:corporateAction a owl:ObjectProperty ;
    rdfs:label "corporateAction" ;
    rdfs:range common_domain_model:CorporateAction ;
    skos:definition "Specifies the necessary information to create a corporate action." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:correlationReturnTerms a owl:ObjectProperty ;
    rdfs:label "correlationReturnTerms" ;
    rdfs:range common_domain_model:CorrelationReturnTerms ;
    skos:definition "Return terms based upon the observed correlation between the components of the underlying basket." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:correlationStrikePrice a owl:ObjectProperty ;
    rdfs:label "correlationStrikePrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "Correlation Strike Price in accordance with the ISDA 2011 Equity Derivatives Definitions." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:counterpartyOwnIssuePermitted a owl:DatatypeProperty ;
    rdfs:label "counterpartyOwnIssuePermitted" ;
    rdfs:range xsd:boolean ;
    skos:definition "Represents a filter based on whether it is permitted for the underlying asset to be issued by the posting entity or part of their corporate family." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:counterpartyPosition a owl:ObjectProperty ;
    rdfs:label "counterpartyPosition" ;
    rdfs:range common_domain_model:CounterpartyPosition ;
    skos:definition "Represents the Position that has been effected by a business or life-cycle event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:counterpartyPositionBusinessEvent a owl:ObjectProperty ;
    rdfs:label "counterpartyPositionBusinessEvent" ;
    rdfs:range common_domain_model:CounterpartyPositionBusinessEvent ;
    skos:definition "Documents the life cycle event for a position." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:couponRate a owl:ObjectProperty ;
    rdfs:label "couponRate" ;
    rdfs:range common_domain_model:FixedRateSpecification ;
    skos:closeMatch fpml_5_10:BondReference.couponRate ;
    skos:definition "Specifies the coupon rate (expressed in percentage) of a fixed income security or convertible bond." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:creditAdditionalTerms a owl:DatatypeProperty ;
    rdfs:label "creditAdditionalTerms" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:creditAgreementDate a owl:DatatypeProperty ;
    rdfs:label "creditAgreementDate" ;
    rdfs:range xsd:date ;
    skos:definition "Specifies the credit agreement date is the closing date (the date where the agreement has been signed) for the loans in the credit agreement. Funding of the facilities occurs on (or sometimes a little after) the Credit Agreement date. This underlier attribute is used to help identify which of the company's outstanding loans are being referenced by knowing to which credit agreement it belongs. ISDA Standards Terms Supplement term: Date of Original Credit Agreement." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:creditEvent a owl:ObjectProperty ;
    rdfs:label "creditEvent" ;
    rdfs:range common_domain_model:CreditEvent ;
    skos:definition "Specifies the necessary information to create a credit event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:creditEventNotice a owl:ObjectProperty ;
    rdfs:label "creditEventNotice" ;
    rdfs:range common_domain_model:CreditEventNotice ;
    skos:definition "A specified condition to settlement. An irrevocable written or verbal notice that describes a credit event that has occurred. The notice is sent from the notifying party (either the buyer or the seller) to the counterparty. It provides information relevant to determining that a credit event has occurred. This is typically accompanied by Publicly Available Information. ISDA 2003 Term: Credit Event Notice." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:creditEventType a owl:ObjectProperty ;
    rdfs:label "creditEventType" ;
    rdfs:range common_domain_model:CreditEventTypeEnum ;
    skos:definition "The type of credit event taking place." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:creditEventsReference a owl:ObjectProperty ;
    rdfs:label "creditEventsReference" ;
    rdfs:range common_domain_model:CreditEvents ;
    skos:inScheme common_domain_model:cdm_observable_event ;
    common_domain_model:metadata_reference true .

common_domain_model:creditLimitInformation a owl:ObjectProperty ;
    rdfs:label "creditLimitInformation" ;
    rdfs:range common_domain_model:CreditLimitInformation ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:creditNotations a owl:ObjectProperty ;
    rdfs:label "creditNotations" ;
    rdfs:range common_domain_model:MultipleCreditNotations ;
    skos:definition "Specifies if several credit notations exist, alongside an 'any' or 'all' or all condition." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:creditRisk a owl:ObjectProperty ;
    rdfs:label "creditRisk" ;
    rdfs:range common_domain_model:CreditRiskEnum ;
    skos:definition "Indicates tranched or untranched credit risk." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:creditSupportAgreementElections a owl:ObjectProperty ;
    rdfs:label "creditSupportAgreementElections" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:CreditSupportAgreementInitialMarginElections common_domain_model:CreditSupportAgreementVariationMarginElections common_domain_model:CreditSupportAgreementLegacyElections ) ] common_domain_model:CreditSupportAgreementElections ) ] ;
    skos:closeMatch fpml_5_10:Agreement.creditSupportAgreementElections ;
    skos:definition "Elections to specify a Credit Support Annex or Credit Support Deed for Intial or Variation Margin." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:creditSupportDocumentTerms a owl:ObjectProperty ;
    rdfs:label "creditSupportDocumentTerms" ;
    rdfs:range common_domain_model:CreditSupportDocumentTermsEnum ;
    skos:definition "Specification of the Credit Support Document terms." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:creditSupportOffsets a owl:DatatypeProperty ;
    rdfs:label "creditSupportOffsets" ;
    rdfs:range xsd:boolean ;
    skos:definition "The specification of whether the standard Credit Support Offset provisions are applicable (true) or not applicable (false)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:creditWatch a owl:ObjectProperty ;
    rdfs:label "creditWatch" ;
    rdfs:range common_domain_model:CreditRatingCreditWatchEnum ;
    skos:definition "Indicates the potential direction of a short-term or long-term rating. It focuses on identifiable events and short-term trends that cause ratings to be placed under special surveillance." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:crossCurrency a owl:ObjectProperty ;
    rdfs:label "crossCurrency" ;
    rdfs:range common_domain_model:Composite ;
    skos:definition "If 'Cross-Currency' is specified as the Settlement Type in the relevant Transaction Supplement, an amount in the Settlement Currency, determined by the Calculation Agent as being equal to the number of Options exercised or deemed exercised, multiplied by: (Settlement Price – Strike Price) / (Strike Price – Settlement Price) x Multiplier x one unit of the Reference Currency converted into an amount in the Settlement Currency using the rate of exchange of the Settlement Currency as quoted on the Reference Price Source on the Valuation Date, provided that if the above is equal to a negative amount the Option Cash Settlement Amount shall be deemed to be zero." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:currency1 a owl:DatatypeProperty ;
    rdfs:label "currency1" ;
    rdfs:range xsd:string ;
    skos:definition "The first currency specified when a pair of currencies is to be evaluated." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:currency2 a owl:DatatypeProperty ;
    rdfs:label "currency2" ;
    rdfs:range xsd:string ;
    skos:definition "The second currency specified when a pair of currencies is to be evaluated." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:currencyReference a owl:DatatypeProperty ;
    rdfs:label "currencyReference" ;
    rdfs:range xsd:string ;
    skos:definition "Reference to a currency specified elsewhere in the document" ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_reference true .

common_domain_model:custodianCondition a owl:DatatypeProperty ;
    rdfs:label "custodianCondition" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies any additional conditions relevant to the Custodian of the respective parties as set out in the Holding and Using Posted Collateral clause." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:custodianEvent a owl:ObjectProperty ;
    rdfs:label "custodianEvent" ;
    rdfs:range common_domain_model:CustodianEvent ;
    skos:definition "Specifies if and until when a Custodian Event clause applies." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(m)(iii)\" name \"Custodian Event\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:custodianRisk a owl:ObjectProperty ;
    rdfs:label "custodianRisk" ;
    rdfs:range common_domain_model:CustodianRisk ;
    skos:definition "The qualification of the Custodian Risk." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"3 General Principles\" clause \"(n)(ii)\" name \"Custodian (IM) Risk\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:customLocation a owl:DatatypeProperty ;
    rdfs:label "customLocation" ;
    rdfs:range xsd:string ;
    skos:definition "The Calculation Date Location when specified a location which doesn't correspond to the FpML list of business centers or cannot be mapped to it." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:customMethodology a owl:DatatypeProperty ;
    rdfs:label "customMethodology" ;
    rdfs:range xsd:string ;
    skos:definition "The methodology according to which sensitivities will be computed, when specified through a custom election." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:customNotification a owl:DatatypeProperty ;
    rdfs:label "customNotification" ;
    rdfs:range xsd:string ;
    skos:definition "The Notification Time as a bespoke election." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:cutoffTime a owl:DatatypeProperty ;
    rdfs:label "cutoffTime" ;
    rdfs:range xsd:time ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.cutoffTime ;
    skos:definition "Specifies the time of day that interest needs to be confirmed by." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:dateAdjustmentsReference a owl:ObjectProperty ;
    rdfs:label "dateAdjustmentsReference" ;
    rdfs:range common_domain_model:BusinessDayAdjustments ;
    skos:closeMatch fpml_5_10:AdjustableDate.dateAdjustmentsReference ;
    skos:definition "A pointer style reference to date adjustments defined elsewhere in the document." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    common_domain_model:metadata_reference true .

common_domain_model:dateLocation a owl:ObjectProperty ;
    rdfs:label "dateLocation" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:closeMatch fpml_5_10:CalculationFrequency.dateLocation ;
    skos:definition "Specifies where is the time measured." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:dateOfBirth a owl:DatatypeProperty ;
    rdfs:label "dateOfBirth" ;
    rdfs:range xsd:date ;
    skos:definition "The natural person's date of birth." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:dateOfTimelyStatement a owl:ObjectProperty ;
    rdfs:label "dateOfTimelyStatement" ;
    rdfs:range common_domain_model:CustomisableOffset ;
    skos:definition "The parties' election to specify the number of days one party has effectively provided the Timely Statement to the other party." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:dateReference a owl:ObjectProperty ;
    rdfs:label "dateReference" ;
    rdfs:range common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Specification of the dividend date using an enumeration, with values such as the pay date, the ex-date or the record date." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dateRelativeTo a owl:DatatypeProperty ;
    rdfs:label "dateRelativeTo" ;
    rdfs:range xsd:date ;
    skos:definition "Specifies the anchor as an href attribute. The href attribute value is a pointer style reference to the element or component elsewhere in the document where the anchor date is defined." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    common_domain_model:metadata_reference true .

common_domain_model:dateRelativeToCalculationPeriodDates a owl:ObjectProperty ;
    rdfs:label "dateRelativeToCalculationPeriodDates" ;
    rdfs:range common_domain_model:DateRelativeToCalculationPeriodDates ;
    skos:definition "The calculation period references on which settlements in non-deliverable currency are due and will then have to be converted according to the terms specified through the other parts of the nonDeliverableSettlement structure. Implemented for Brazilian-CDI swaps where it will refer to the termination date of the appropriate leg." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:dateRelativeToPaymentDates a owl:ObjectProperty ;
    rdfs:label "dateRelativeToPaymentDates" ;
    rdfs:range common_domain_model:DateRelativeToPaymentDates ;
    skos:definition "The payment date references on which settlements in non-deliverable currency are due and will then have to be converted according to the terms specified through the other parts of the nonDeliverableSettlement structure." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:dateRelativeToValuationDates a owl:ObjectProperty ;
    rdfs:label "dateRelativeToValuationDates" ;
    rdfs:range common_domain_model:DateRelativeToValuationDates ;
    skos:definition "The calculation period references on which settlements in non-deliverable currency are due and will then have to be converted according to the terms specified through the other parts of the nonDeliverableSettlement structure. Implemented for Brazilian-CDI swaps where it will refer to the termination date of the appropriate leg." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:dayCountYearFraction a owl:DatatypeProperty ;
    rdfs:label "dayCountYearFraction" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculationPeriod.dayCountYearFraction ;
    skos:definition "The year fraction value of the calculation period, result of applying the ISDA rules for day count fraction defined in the ISDA Annex." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:dayDistribution a owl:ObjectProperty ;
    rdfs:label "dayDistribution" ;
    rdfs:range common_domain_model:DayDistributionEnum ;
    skos:definition "Denotes the method by which the pricing days are distributed across the pricing period." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:daysAfterCustodianEvent a owl:ObjectProperty ;
    rdfs:label "daysAfterCustodianEvent" ;
    rdfs:range common_domain_model:CustomisableOffset ;
    skos:definition "Election to specify the number of days after the occurrence of the Custodian Event/Collateral Management Event for the purpose of qualifying the CE/CME End Date." ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(m)(ii)\" name \"Collateral Manager Event\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(n)(iii)\" name \" Custodian Event\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(n)(iii)\" name \" Custodian Event\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:daysInLeapYearPeriod a owl:DatatypeProperty ;
    rdfs:label "daysInLeapYearPeriod" ;
    rdfs:range xsd:integer ;
    skos:closeMatch fpml_5_10:CalculationPeriodData.daysInLeapYearPeriod ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:daysInPeriod a owl:DatatypeProperty ;
    rdfs:label "daysInPeriod" ;
    rdfs:range xsd:integer ;
    skos:closeMatch fpml_5_10:CalculationPeriodData.daysInPeriod ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:daysInRangeAdjustment a owl:DatatypeProperty ;
    rdfs:label "daysInRangeAdjustment" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:BoundedVariance.daysInRangeAdjustment ;
    skos:definition "The contract specifies whether the notional should be scaled by the Number of Days in Range divided by the Expected N. The number of Days in Ranges refers to the number of returns that contribute to the realized volatility." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dealerOrCCP a owl:ObjectProperty ;
    rdfs:label "dealerOrCCP" ;
    rdfs:range common_domain_model:AncillaryEntity ;
    skos:definition "Holds an identifier for the reference entity that is agreed by both parties as a basis for cash settlement calculations. This could be a dealer from whom quotations are obtained by the calculation agent on the reference obligation for purposes of cash settlement in a credit event. ISDA 2003 Term: Dealer. This could be the clearing organization (CCP, DCO) to which the trade should be cleared, as applicable for cash-settled swaptions." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:debt a owl:ObjectProperty ;
    rdfs:label "debt" ;
    rdfs:range common_domain_model:CreditRatingDebt ;
    skos:definition "Specifies the credit rating debt type (e.g. long term, high yield, deposits, ...) associated with the credit rating notation and scale." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:debtTypes a owl:ObjectProperty ;
    rdfs:label "debtTypes" ;
    rdfs:range common_domain_model:MultipleDebtTypes ;
    skos:definition "Specifies if there are several debt types, alongside an 'any' or 'all' or all condition. As an example, Baa1 rating is required for any long term debt and deposit." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:deemedEffectiveNextLBD a owl:DatatypeProperty ;
    rdfs:label "deemedEffectiveNextLBD" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies if notice shall be deemed to be effective at the time such notice is actually received unless such notice is received on a day which is not a Local Business Day or after the Notification Time on any Local Business Day in which event such notice shall be deemed to be effective on the next succeeding Local Business Day. If deemed effective,'True'. If not deemed effective, or not stated,'False'." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:defaultRequirement a owl:ObjectProperty ;
    rdfs:label "defaultRequirement" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "In relation to certain credit events, serves as a threshold for Obligation Acceleration, Obligation Default, Repudiation/Moratorium and Restructuring. Market standard is USD 10,000,000 (JPY 1,000,000,000 for all Japanese Yen trades). This is applied on an aggregate or total basis across all Obligations of the Reference Entity. Used to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Default Requirement." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:definitionalSource a owl:DatatypeProperty ;
    rdfs:label "definitionalSource" ;
    rdfs:range xsd:string ;
    skos:definition "The source of an FRO, particularly if not a Contractual Definition (e.g. the broker rates matrix)." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:delisting a owl:ObjectProperty ;
    rdfs:label "delisting" ;
    rdfs:range common_domain_model:NationalizationOrInsolvencyOrDelistingEventEnum ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:deliverableObligations a owl:ObjectProperty ;
    rdfs:label "deliverableObligations" ;
    rdfs:range common_domain_model:DeliverableObligations ;
    skos:definition "This element contains all the ISDA terms relevant to defining the deliverable obligations." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:deliveryDateReference a owl:ObjectProperty ;
    rdfs:label "deliveryDateReference" ;
    rdfs:range common_domain_model:DeliveryDateParameters ;
    skos:closeMatch fpml_5_10:Commodity.deliveryDateReference ;
    skos:definition "Specifies the parameters for identifying the relevant contract date when the commodity reference price is a futures contract." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:deliveryDateRollConvention a owl:ObjectProperty ;
    rdfs:label "deliveryDateRollConvention" ;
    rdfs:range common_domain_model:Offset ;
    skos:definition "Specifies, for a Commodity Transaction that references a delivery date for a listed future, the day on which the specified future will roll to the next nearby month prior to the expiration of the referenced future. If the future will not roll at all - i.e. the price will be taken from the expiring contract, 0 should be specified here. If the future will roll to the next nearby on the last trading day - i.e. the price will be taken from the next nearby on the last trading day, then 1 should be specified and so on." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:deliveryDirection a owl:ObjectProperty ;
    rdfs:label "deliveryDirection" ;
    rdfs:range common_domain_model:RoundingModeEnum ;
    skos:closeMatch fpml_5_10:CollateralRounding.deliveryDirection ;
    skos:definition "The rounding rule applicable to the Delivery Amount (which can be (i) up to nearest; (ii) down to nearest)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:deliveryMethod a owl:ObjectProperty ;
    rdfs:label "deliveryMethod" ;
    rdfs:range common_domain_model:DeliveryMethodEnum ;
    skos:closeMatch fpml_5_10:AssetLeg.deliveryMethod ;
    skos:definition "Specifies a delivery method for the security transaction." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:deliveryOfCommitments a owl:DatatypeProperty ;
    rdfs:label "deliveryOfCommitments" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Defined in the ISDA published Standard Terms Supplement for use with CDS Transactions on Leveraged Loans. ISDA 2003 Term: Delivery of Commitments." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:deliveryPeriod a owl:ObjectProperty ;
    rdfs:label "deliveryPeriod" ;
    rdfs:range common_domain_model:CalculationScheduleDeliveryPeriods ;
    skos:definition "Period and time profile over which the delivery takes place." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:delta a owl:DatatypeProperty ;
    rdfs:label "delta" ;
    rdfs:range xsd:decimal ;
    skos:definition "The ratio of the change in the price of a derivative transaction to the change in the price of the underlying. This field is applicable only to options and swaptions." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:denominatedCurrency a owl:ObjectProperty ;
    rdfs:label "denominatedCurrency" ;
    rdfs:range common_domain_model:CurrencyCodeEnum ;
    skos:definition "The underlying asset denominated currency." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:deprecatedDate a owl:DatatypeProperty ;
    rdfs:label "deprecatedDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CodeValue.deprecatedDate ;
    skos:definition "When the code ceased to be valid for new uses" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:deprecationReason a owl:DatatypeProperty ;
    rdfs:label "deprecationReason" ;
    rdfs:range xsd:string ;
    skos:definition "Deprecation and Code Descriptions" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:derivInstrmAttrbts a owl:ObjectProperty ;
    rdfs:label "derivInstrmAttrbts" ;
    rdfs:range common_domain_model:DerivInstrmAttrbts ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#DerivInstrmAttrbts> .

common_domain_model:designatedMaturityApplicable a owl:DatatypeProperty ;
    rdfs:label "designatedMaturityApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:designatedPriority a owl:DatatypeProperty ;
    rdfs:label "designatedPriority" ;
    rdfs:range xsd:string ;
    skos:definition "Applies to Loan CDS, to indicate what lien level is appropriate for a deliverable obligation. Applies to European Loan CDS, to indicate the Ranking of the obligation. Example: a 2nd lien Loan CDS would imply that the deliverable obligations are 1st or 2nd lien loans." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit ;
    common_domain_model:metadata_scheme true .

common_domain_model:determinationMethodology a owl:ObjectProperty ;
    rdfs:label "determinationMethodology" ;
    rdfs:range common_domain_model:DeterminationMethodology ;
    skos:definition "Specifies the method according to which an amount or a date is determined." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:determinationRole a owl:ObjectProperty ;
    rdfs:label "determinationRole" ;
    rdfs:range common_domain_model:DeterminationRoleEnum ;
    skos:definition "Defines the enumerated values to specify the determination roles to the transaction. Such roles mostly address any determination that would be required when some Extraordinary Events would happen, for instance qualifying the effectiveness of such event, or when a calculation is required, etc. else any other kind of determination as need be. Yet for clarity, other kinds of determination may be covered by such roles, which are not necessarily restricted to the scope of Extarordinary Events, depending on particular product specifications e.g. for instance when Calculation Agent is mentioned as the Price Determination Method enumarated value, etc." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:determiningParty a owl:ObjectProperty ;
    rdfs:label "determiningParty" ;
    rdfs:range common_domain_model:AncillaryRoleEnum ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.determiningParty ;
    skos:definition "Specifies the party which determines additional disruption events." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:digitalAssetAdditionalTerms a owl:DatatypeProperty ;
    rdfs:label "digitalAssetAdditionalTerms" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:directLoanParticipation a owl:ObjectProperty ;
    rdfs:label "directLoanParticipation" ;
    rdfs:range common_domain_model:LoanParticipation ;
    skos:definition "A deliverable obligation characteristic. A loan with a participation agreement whereby the buyer is capable of creating, or procuring the creation of, a contractual right in favour of the seller that provides the seller with recourse to the participation seller for a specified share in any payments due under the relevant loan which are received by the participation seller. ISDA 2003 Term: Direct Loan Participation." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:directTime a owl:ObjectProperty ;
    rdfs:label "directTime" ;
    rdfs:range common_domain_model:TimeZone ;
    skos:definition "An absolute time value expressed in a specific time zone." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:discountingIndex a owl:ObjectProperty ;
    rdfs:label "discountingIndex" ;
    rdfs:range common_domain_model:FloatingRateIndexEnum ;
    skos:definition "It specifies the interest payable on collateral delivered under a CSA covering the trade." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:discountingMethod a owl:ObjectProperty ;
    rdfs:label "discountingMethod" ;
    rdfs:range common_domain_model:DiscountingMethod ;
    skos:definition "The parameters specifying any discounting conventions that may apply. This element must only be included if discounting applies." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:discountingType a owl:ObjectProperty ;
    rdfs:label "discountingType" ;
    rdfs:range common_domain_model:DiscountingTypeEnum ;
    skos:definition "The discounting method that is applicable." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:discrepancyClause a owl:DatatypeProperty ;
    rdfs:label "discrepancyClause" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:BondReference.discrepancyClause ;
    skos:definition "To indicate whether the Discrepancy Clause is applicable." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:disputeNotificationReference a owl:DatatypeProperty ;
    rdfs:label "disputeNotificationReference" ;
    rdfs:range xsd:boolean ;
    skos:definition "The determination of whether reference is made to dispute resolution notification timing in the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:disputedCashOrSecurityValue a owl:ObjectProperty ;
    rdfs:label "disputedCashOrSecurityValue" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "Paragraph 5. If a party (a 'Disputing Party') disputes the Value of any Posted Credit Support (IM)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:disruptionEvents a owl:ObjectProperty ;
    rdfs:label "disruptionEvents" ;
    rdfs:range common_domain_model:FxDisruptionEvents ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:distressedRatingsDowngrade a owl:DatatypeProperty ;
    rdfs:label "distressedRatingsDowngrade" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. Results from the fact that the rating of the reference obligation is down-graded to a distressed rating level. From a usage standpoint, this credit event is typically not applicable in case of RMBS trades." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:distributionAndInterestPayment a owl:ObjectProperty ;
    rdfs:label "distributionAndInterestPayment" ;
    rdfs:range common_domain_model:DistributionAndInterestPayment ;
    skos:definition "The Distributions and Interest Payment terms specified as part of the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:dividendAmountType a owl:ObjectProperty ;
    rdfs:label "dividendAmountType" ;
    rdfs:range common_domain_model:DividendAmountTypeEnum ;
    skos:definition "Specifies whether the dividend is paid with respect to the Dividend Period." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendApplicability a owl:ObjectProperty ;
    rdfs:label "dividendApplicability" ;
    rdfs:range common_domain_model:DividendApplicability ;
    skos:definition "The parameters which define whether dividends are applicable" ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendComposition a owl:ObjectProperty ;
    rdfs:label "dividendComposition" ;
    rdfs:range common_domain_model:DividendCompositionEnum ;
    skos:definition "Specifies how the composition of Dividends is to be determined." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendCurrency a owl:ObjectProperty ;
    rdfs:label "dividendCurrency" ;
    rdfs:range common_domain_model:DividendCurrency ;
    skos:definition "Specifies the currency in which the dividend will be denominated, e.g. the dividend currency, or a specified currency. This class is not specified as such in FpML, which makes use of the CurrencyAndDeterminationMethod.model to specify such terms." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendDate a owl:ObjectProperty ;
    rdfs:label "dividendDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_reference true .

common_domain_model:dividendDateReference a owl:ObjectProperty ;
    rdfs:label "dividendDateReference" ;
    rdfs:range common_domain_model:DividendDateReference ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendPaymentDate a owl:ObjectProperty ;
    rdfs:label "dividendPaymentDate" ;
    rdfs:range common_domain_model:DividendPaymentDate ;
    skos:definition "Specifies when the dividend will be paid to the receiver of the equity return. Has the meaning as defined in the ISDA 2002 Equity Derivatives Definitions. Is not applicable in the case of a dividend reinvestment election." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendRatio a owl:DatatypeProperty ;
    rdfs:label "dividendRatio" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.dividendRatio ;
    skos:definition "Multiplier value (e.g. 85 %, etc.) to calculate net dividend amount, given gross amount before taking into account the relevant fiscal features." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:dividendReinvestment a owl:DatatypeProperty ;
    rdfs:label "dividendReinvestment" ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean element that defines whether the dividend will be reinvested or not." ;
