common_domain_model:AdjustableOrRelativeDate a owl:Class ;
    rdfs:label "AdjustableOrRelativeDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableDate ;
            owl:onProperty common_domain_model:adjustableDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustedRelativeDateOffset ;
            owl:onProperty common_domain_model:relativeDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustableDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:relativeDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:relativeDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustableDate ] ;
    skos:closeMatch fpml_5_10:AdjustableOrRelativeDate ;
    skos:definition "A class giving the choice between defining a date as an explicit date together with applicable adjustments or as relative to some other (anchor) date." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: AdjustableOrRelativeDateChoice — required choice adjustableDate, relativeDate",
        "Rosetta func: ConvertToAdjustableOrAdjustedOrRelativeDate — Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrAdjustedOrRelativeDate",
        "Rosetta func: ConvertToAdjustableOrRelativeDate — Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrRelativeDate",
