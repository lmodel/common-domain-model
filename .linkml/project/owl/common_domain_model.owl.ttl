            owl:allValuesFrom common_domain_model:CreditEvents ;
            owl:onProperty common_domain_model:creditEvents ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:obligations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:floatingAmountEvents ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FloatingAmountEvents ;
            owl:onProperty common_domain_model:floatingAmountEvents ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:creditEvents ] ;
    skos:definition "A class to specify the terms for calculating a payout to protect the buyer of the swap in the case of a qualified credit event. These terms include the applicable credit events, the reference obligation, and in the case of a CDS on mortgage-backed securities, the floatingAmountEvents." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_key true .

