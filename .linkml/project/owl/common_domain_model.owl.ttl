common_domain_model:Money a owl:Class ;
    rdfs:label "Money" ;
    rdfs:subClassOf common_domain_model:Quantity ;
    skos:closeMatch gist:Magnitude ;
    skos:definition "Defines a monetary amount in a specified currency." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Rosetta condition: CurrencyUnitExists — unit -> currency exists" ;
    common_domain_model:metadata_key true .

