	rdfs:label "calculationBase" ;
	skos:definition "Whether the rate is calculated in advance, in arrears, or relative to a reset date." ;
	skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .
common_domain_model:calculationDateImTerms a owl:DatatypeProperty ;
	rdfs:label "calculationDateImTerms" ;
	skos:definition "The Additional Calculation Date terms for the purposes of Initial Margin." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:calculationDateLocation a owl:ObjectProperty .
