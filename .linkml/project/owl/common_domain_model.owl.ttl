            owl:onProperty common_domain_model:negativeCriteria ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:negativeCriteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
