    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:exclusiveJurisdiction a owl:DatatypeProperty ;
    rdfs:label "exclusiveJurisdiction" ;
    rdfs:range xsd:boolean ;
    skos:definition "Classification of optional exclusive jurisdiction terms." ;
