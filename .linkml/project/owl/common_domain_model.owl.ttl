	rdfs:label "UK_EMIRTypeA" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes cash in the form of money credited to an account in any currency, or similar claims for the repayment of money, such as money market deposits." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeB a owl:Class ;
	rdfs:label "UK_EMIRTypeB" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
