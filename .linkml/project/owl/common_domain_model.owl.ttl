	rdfs:label "CoveredTransactions" ;
	rdfs:subClassOf _:c14n1142 , _:c14n11892 , _:c14n1599 , _:c14n1652 , _:c14n2591 , _:c14n322 , _:c14n3874 , _:c14n3902 , _:c14n5702 , _:c14n7145 , _:c14n7356 , _:c14n7633 , _:c14n7755 ;
	skos:definition "Specification of Transactions covered by the legal agreement." ;
