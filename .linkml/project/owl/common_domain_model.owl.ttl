            owl:onProperty common_domain_model:fallbackToMandatoryMethodDays ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:applicableRegime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fallbackToMandatoryMethodDays ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ApplicableRegime ;
            owl:onProperty common_domain_model:applicableRegime ] ;
    skos:definition "A class to specify one or more regimes that may be specified as relevant to a legal agreement." ;
    skos:editorialNote "ISDA CSA_IM_2016 name \"Regime\"",
        "ISDA CSA_IM_2018 name \"Regime\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:ResolvablePriceQuantity a owl:Class ;
    rdfs:label "ResolvablePriceQuantity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:priceSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:reset ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:quantityReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:resolvedQuantity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:quantityMultiplier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:resolvedQuantity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:futureValueNotional ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:priceSchedule ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:quantityMultiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:quantitySchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FutureValueAmount ;
            owl:onProperty common_domain_model:futureValueNotional ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:quantityReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:reset ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ResolvablePriceQuantity ;
            owl:onProperty common_domain_model:quantityReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:futureValueNotional ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:QuantityMultiplier ;
            owl:onProperty common_domain_model:quantityMultiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Quantity ;
            owl:onProperty common_domain_model:resolvedQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NonNegativeQuantitySchedule ;
            owl:onProperty common_domain_model:quantitySchedule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:quantitySchedule ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:reset ] ;
    skos:definition "Generic class to specify the quantity for different payout legs in a contractual product, when that quantity can vary across payout legs or across time. A resolvable quantity can always be resolved into a single quantity from the quantity notation which has a corresponding asset identifier. In addition to the base case, where quantity is directly specified as a number as part of the quantity notation, the other use cases are: (i) quantity based on some pre-defined schedule (eg amortising notional), (ii) quantity based on some pre-defined events (eg resetting cross-currency notional), or quantity set as reference to another quantity (eg equity notional as no. securities x price)." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    skos:note "Rosetta condition: QuantityMultiplier — if quantityMultiplier exists then quantityReference -> reference exists" ;
    common_domain_model:metadata_key true .

common_domain_model:ReturnAmount a owl:Class ;
    rdfs:label "ReturnAmount" ;
