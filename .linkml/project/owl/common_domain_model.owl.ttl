_model:ProductGradeEnum\#Low-Sulphur-Jet , common_domain_model:ProductGradeEnum\#Low-Sulphur , common_domain_model:ProductGradeEnum\#Mars , common_domain_model:ProductGradeEnum\#Mixed-Sour-Blend , common_domain_model:ProductGradeEnum\#Mixed-Sweet-Blend , common_domain_model:ProductGradeEnum\#Murban , common_domain_model:ProductGradeEnum\#Natural-Gasoline , common_domain_model:ProductGradeEnum\#No.-2 , common_domain_model:ProductGradeEnum\#No.-6-0.3-Percent-HP , common_domain_model:ProductGradeEnum\#No.-6-0.3-Percent-LP , common_domain_model:ProductGradeEnum\#No.-6-0.3-Percent , common_domain_model:ProductGradeEnum\#No.-6-0.7-Percent , common_domain_model:ProductGradeEnum\#No.-6-1.0-Percent , common_domain_model:ProductGradeEnum\#No.-6-2.2-Percent , common_domain_model:ProductGradeEnum\#No.-6-3-Percent , common_domain_model:ProductGradeEnum\#Normal-Butane , common_domain_model:ProductGradeEnum\#North-Dakota-Light , common_domain_model:ProductGradeEnum\#Oman , common_domain_model:ProductGradeEnum\#Polymer-Grade , common_domain_model:ProductGradeEnum\#RBOB , common_domain_model:ProductGradeEnum\#Saharan , common_domain_model:ProductGradeEnum\#Sour , common_domain_model:ProductGradeEnum\#Southern-Green-Canyon , common_domain_model:ProductGradeEnum\#Tapis , common_domain_model:ProductGradeEnum\#Thunder-Horse , common_domain_model:ProductGradeEnum\#US-Regular-Unleaded , common_domain_model:ProductGradeEnum\#Ultra-Low-Sulphur , common_domain_model:ProductGradeEnum\#Urals-Sour , common_domain_model:ProductGradeEnum\#Urals , common_domain_model:ProductGradeEnum\#WTI , common_domain_model:ProductGradeEnum\#WTS , common_domain_model:ProductGradeEnum\#Western-Canadian-Select , common_domain_model:ProductGradeEnum\#Zuetina ;
