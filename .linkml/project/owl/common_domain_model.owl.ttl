common_domain_model:exercise a owl:ObjectProperty ;
    rdfs:label "exercise" ;
    rdfs:range common_domain_model:ExerciseInstruction ;
    skos:definition "Specifies instructions describing an exercise primitive event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:exerciseDate a owl:ObjectProperty ;
    rdfs:label "exerciseDate" ;
    rdfs:range common_domain_model:AdjustableOrAdjustedDate ;
    skos:definition "Specifies the date on which an option contained within the financial product would be exercised. The date may be omitted if the contractual product allows for only a single date of exercise (European exercise)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:exerciseFrequency a owl:ObjectProperty ;
    rdfs:label "exerciseFrequency" ;
    rdfs:range common_domain_model:Period ;
    skos:definition "The frequency of subsequent exercise dates in the exercise period following the earliest exercise date. An interval of 1 day should be used to indicate an American style exercise period." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:exerciseNoticeGiver a owl:ObjectProperty ;
    rdfs:label "exerciseNoticeGiver" ;
    rdfs:range common_domain_model:ExerciseNoticeGiverEnum ;
    skos:definition "Specifies the principal party of the trade that has the right to exercise." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:exerciseNoticeReceiver a owl:ObjectProperty ;
    rdfs:label "exerciseNoticeReceiver" ;
    rdfs:range common_domain_model:AncillaryRoleEnum ;
    skos:definition "Specifies the party to which notice of exercise should be given, e.g. by the buyer of the option. Although in many cases it is the buyer of the option who sends the exercise notice to the seller of the option, this component is reused, e.g. in case of OptionEarlyTermination, either or both parties have the right to exercise." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:exerciseOption a owl:ObjectProperty ;
    rdfs:label "exerciseOption" ;
    rdfs:range common_domain_model:OptionPayout ;
    skos:definition "Specifies the Option Payout being exercised on the trade." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:exerciseProcedure a owl:ObjectProperty ;
    rdfs:label "exerciseProcedure" ;
    rdfs:range common_domain_model:ExerciseProcedure ;
    skos:definition "The set of parameters defining the procedure associated with the exercise, e.g. manual exercise." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:exerciseQuantity a owl:ObjectProperty ;
    rdfs:label "exerciseQuantity" ;
    rdfs:range common_domain_model:PrimitiveInstruction ;
    skos:definition "Contains instructions for exercising the option including a quantity change, and optionally a transfer." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:exerciseTime a owl:ObjectProperty ;
    rdfs:label "exerciseTime" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:definition "Specifies the time at which an option contained within the financial product woulld be exercised. The time may be omitted if the contractual product allows for only a single time of exercise (European exercise). " ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:exhaustionPoint a owl:DatatypeProperty ;
    rdfs:label "exhaustionPoint" ;
    rdfs:range xsd:decimal ;
    skos:definition "Upper bound percentage of the loss that the Tranche can endure, expressed as a decimal. An exhaustion point of 5% would be represented as 0.05. The difference between Attachment and Exhaustion points is call the width of the Tranche." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:existingLoans a owl:ObjectProperty ;
    rdfs:label "existingLoans" ;
    rdfs:range common_domain_model:ApplicabilityOfElectionEnum ;
    skos:definition "Are existing loans covered in the event of default (Only relevant to 2010 GMSLAs)?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:expectedN a owl:DatatypeProperty ;
    rdfs:label "expectedN" ;
    rdfs:range xsd:integer ;
    skos:definition "Expected number of trading days." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:expirationDateTime a owl:DatatypeProperty ;
    rdfs:label "expirationDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:closeMatch fpml_5_10:AvailableInventoryRecord.expirationDateTime ;
    skos:definition "There may be a set period/time restriction associated to the security." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:expirationDateTwo a owl:ObjectProperty ;
    rdfs:label "expirationDateTwo" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:expirationTime a owl:ObjectProperty ;
    rdfs:label "expirationTime" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:definition "The latest time for exercise on expirationDate. It is made mandatory given that for all option styles, this field is required." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:expirationTimeType a owl:ObjectProperty ;
    rdfs:label "expirationTimeType" ;
    rdfs:range common_domain_model:ExpirationTimeTypeEnum ;
    skos:definition "The time of day at which the equity option expires, for example the official closing time of the exchange." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:exposure a owl:ObjectProperty ;
    rdfs:label "exposure" ;
    rdfs:range common_domain_model:ExposureScope ;
    skos:definition "Specification of amendments to the calculation of Exposure in terms of the Transactions covered." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:extendibleProvision a owl:ObjectProperty ;
    rdfs:label "extendibleProvision" ;
    rdfs:range common_domain_model:ExtendibleProvision ;
    skos:definition "A provision that allows the specification of an embedded option with a swap giving the buyer of the option the right to extend the swap, in whole or in part, to the extended termination date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:extendibleProvisionAdjustedDates a owl:ObjectProperty ;
    rdfs:label "extendibleProvisionAdjustedDates" ;
    rdfs:range common_domain_model:ExtendibleProvisionAdjustedDates ;
    skos:definition "The adjusted dates associated with an extendible provision. These dates have been adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:extensionFrequency a owl:ObjectProperty ;
    rdfs:label "extensionFrequency" ;
    rdfs:range common_domain_model:AdjustableRelativeOrPeriodicDates ;
    skos:definition "The frequency with which the evergreen contract will be extended if notice is not given." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:extensionPeriod a owl:ObjectProperty ;
    rdfs:label "extensionPeriod" ;
    rdfs:range common_domain_model:AdjustableRelativeOrPeriodicDates ;
    skos:definition "The period within which notice can be given that the contract will be extended." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:extensionTerm a owl:ObjectProperty ;
    rdfs:label "extensionTerm" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:definition "The length of each extension period relative to the effective date of the preceding contract." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:externalId a owl:DatatypeProperty ;
    rdfs:label "externalId" ;
    rdfs:range xsd:string ;
    skos:definition " The FRO name that is being mapped to/from." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:externalMappings a owl:ObjectProperty ;
    rdfs:label "externalMappings" ;
    rdfs:range common_domain_model:FloatingRateIndexExternalMappings ;
    skos:definition "Any mappings to other codes for this index." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:externalStandard a owl:DatatypeProperty ;
    rdfs:label "externalStandard" ;
    rdfs:range xsd:string ;
    skos:definition "The standard/version to which the map applies." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:extraordinaryDividendsParty a owl:ObjectProperty ;
    rdfs:label "extraordinaryDividendsParty" ;
    rdfs:range common_domain_model:AncillaryRoleEnum ;
    skos:definition "Specifies the party which determines if dividends are extraordinary in relation to normal levels." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:extraordinaryEvents a owl:ObjectProperty ;
    rdfs:label "extraordinaryEvents" ;
    rdfs:range common_domain_model:ExtraordinaryEvents ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:fPVFinalPriceElectionFallback a owl:ObjectProperty ;
    rdfs:label "fPVFinalPriceElectionFallback" ;
    rdfs:range common_domain_model:FPVFinalPriceElectionFallbackEnum ;
    skos:definition "Specifies the fallback provisions for Hedging Party in the determination of the Final Price." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:facilityType a owl:DatatypeProperty ;
    rdfs:label "facilityType" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the type of loan facility (letter of credit, revolving, ...)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:failureToDevliverIndemnityApplies a owl:ObjectProperty ;
    rdfs:label "failureToDevliverIndemnityApplies" ;
    rdfs:range common_domain_model:ApplicabilityOfElectionEnum ;
    skos:closeMatch fpml_5_10:CollateralSpecification.failureToDevliverIndemnityApplies ;
    skos:definition "Does paragraph 6.4 (indemnity for failure to redeliver Equivalent Non-Cash Collateral) apply to the GMSLA?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:failureToPayInterest a owl:DatatypeProperty ;
    rdfs:label "failureToPayInterest" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. Corresponds to the failure by the Reference Entity to pay an expected interest amount or the payment of an actual interest amount that is less than the expected interest amount. ISDA 2003 Term: Failure to Pay Interest." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:fallback a owl:DatatypeProperty ;
    rdfs:label "fallback" ;
    rdfs:range xsd:boolean ;
    skos:definition "Represents whether a fallback calculation method is applicable. 'True' if fallback calculation method is applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:fallbackAET a owl:DatatypeProperty ;
    rdfs:label "fallbackAET" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AutomaticEarlyTermination.fallbackAET ;
    skos:definition "Specifies whether automatic termination applies in the event of certain bankruptcy events." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:fallbackBondApplicable a owl:DatatypeProperty ;
    rdfs:label "fallbackBondApplicable" ;
    rdfs:range xsd:boolean ;
    skos:definition "The applicability of a fallback bond as defined in the 2006 ISDA Inflation Derivatives Definitions, sections 1.3 and 1.8." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:fallbackCurrency a owl:DatatypeProperty ;
    rdfs:label "fallbackCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies a single fallback Termination Currency should the stated currency not be freely available." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:fallbackExercise a owl:DatatypeProperty ;
    rdfs:label "fallbackExercise" ;
    rdfs:range xsd:boolean ;
    skos:definition "If fallback exercise is specified then the notional amount of the underlying swap, not previously exercised under the swaption, will be automatically exercised at the expiration time on the expiration date if at such time the buyer is in-the-money, provided that the difference between the settlement rate and the fixed rate under the relevant underlying swap is not less than one tenth of a percentage point (0.10% or 0.001). The term in-the-money is assumed to have the meaning defined in the 2000 ISDA Definitions, Section 17.4. In-the-money." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:fallbackRate a owl:ObjectProperty ;
    rdfs:label "fallbackRate" ;
    rdfs:range common_domain_model:FallbackRateParameters ;
    skos:definition "Definition of any fallback rate that may be applicable." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:fallbackSurveyValuationPostponement a owl:DatatypeProperty ;
    rdfs:label "fallbackSurveyValuationPostponement" ;
    rdfs:range xsd:boolean ;
    skos:definition "Request rate quotes from the market. This element is set as type Empty in FpML. When present, the FpML synonym is mapped to a value True in the CDM." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:fallbackToMandatoryMethodDays a owl:DatatypeProperty ;
    rdfs:label "fallbackToMandatoryMethodDays" ;
    rdfs:range xsd:decimal ;
    skos:definition "The specification of the number of days after effective delivery of notice that Mandatory method fallback applies. Specification is only required when one or more Regimes have Fall Back to Mandatory Method elected as a SIMM exception." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:feature a owl:ObjectProperty ;
    rdfs:label "feature" ;
    rdfs:range common_domain_model:OptionFeature ;
    skos:definition "The option feature, such as quanto, Asian, barrier, knock." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:featurePayment a owl:ObjectProperty ;
    rdfs:label "featurePayment" ;
    rdfs:range common_domain_model:FeaturePayment ;
    skos:definition "The feature payment, i.e. the payment made following trigger occurrence." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:feeAmount a owl:DatatypeProperty ;
    rdfs:label "feeAmount" ;
    rdfs:range xsd:decimal ;
    skos:definition "The amount of fee to be paid on exercise. The fee currency is that of the referenced notional." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:feeAmountSchedule a owl:ObjectProperty ;
    rdfs:label "feeAmountSchedule" ;
    rdfs:range common_domain_model:AmountSchedule ;
    skos:definition "The exercise fee amount schedule. The fees are expressed as currency amounts. The currency of the fee is assumed to be that of the notional schedule referenced." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:feeRate a owl:DatatypeProperty ;
    rdfs:label "feeRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "A fee represented as a percentage of some referenced notional. A percentage of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:feeRateSchedule a owl:ObjectProperty ;
    rdfs:label "feeRateSchedule" ;
    rdfs:range common_domain_model:Schedule ;
    skos:definition "The exercise free rate schedule. The fees are expressed as percentage rates of the notional being exercised. The currency of the fee is assumed to be that of the notional schedule referenced." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:finInstrm a owl:ObjectProperty ;
    rdfs:label "finInstrm" ;
    rdfs:range common_domain_model:FinInstrm ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#FinInstrm> .

common_domain_model:finInstrmGnlAttrbts a owl:ObjectProperty ;
    rdfs:label "finInstrmGnlAttrbts" ;
    rdfs:range common_domain_model:FinInstrmGnlAttrbts ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#FinInstrmGnlAttrbts> .

common_domain_model:finInstrmRptgTxRpt a owl:ObjectProperty ;
    rdfs:label "finInstrmRptgTxRpt" ;
    rdfs:range common_domain_model:FinInstrmRptgTxRpt ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#FinInstrmRptgTxRpt> .

common_domain_model:finalFixingDate a owl:ObjectProperty ;
    rdfs:label "finalFixingDate" ;
    rdfs:range common_domain_model:AdjustableDate ;
    skos:definition "This attribute is not part of the FpML ResetDate, and has been added as part of the CDM to support the credit derivatives final fixing date." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:finalPayment a owl:DatatypeProperty ;
    rdfs:label "finalPayment" ;
    rdfs:range xsd:boolean ;
    skos:definition "A true/false flag to indicate whether there is a final exchange of principal on the termination date." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:finalPaymentDate a owl:ObjectProperty ;
    rdfs:label "finalPaymentDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:definition "The last payment when specified as an adjustable or relative date, as in the FpML total return construct." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:finalPeriodFeeAdjustment a owl:ObjectProperty ;
    rdfs:label "finalPeriodFeeAdjustment" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "An optional adjustment to the rate for the last period of the evergreen i.e. the period from when notice is given to stop rolling the contract through to the termination date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:finalPrice a owl:ObjectProperty ;
    rdfs:label "finalPrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "The final price resulting from the auction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:finalPrincipalExchangeCalculation a owl:ObjectProperty ;
    rdfs:label "finalPrincipalExchangeCalculation" ;
    rdfs:range common_domain_model:FinalPrincipalExchangeCalculationEnum ;
    skos:definition "To be specified only for products that embed a redemption payment." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:finalPrincipalPayment a owl:ObjectProperty ;
    rdfs:label "finalPrincipalPayment" ;
    rdfs:range common_domain_model:PrincipalPayment ;
    skos:definition "Principal Payment at Trade maturity" ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:finalRateRounding a owl:ObjectProperty ;
    rdfs:label "finalRateRounding" ;
    rdfs:range common_domain_model:Rounding ;
    skos:definition "The rounding convention to apply to the final rate used in determination of a calculation period amount." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:finalValuationDate a owl:ObjectProperty ;
    rdfs:label "finalValuationDate" ;
    rdfs:range common_domain_model:PerformanceValuationDates ;
    skos:definition "Specifies the final valuation dates of the underlyer." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:financialUnit a owl:ObjectProperty ;
    rdfs:label "financialUnit" ;
    rdfs:range common_domain_model:FinancialUnitEnum ;
    skos:definition "Provides an enumerated value for financial units, generally used in the context of defining quantities for securities." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:firstCompoundingPeriodEndDate a owl:DatatypeProperty ;
    rdfs:label "firstCompoundingPeriodEndDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates.firstCompoundingPeriodEndDate ;
    skos:definition "The end date of the initial compounding period when compounding is applicable. It must only be specified when the compoundingMethod element is present and not equal to a value of None. This date may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:firstDefinedIn a owl:ObjectProperty ;
    rdfs:label "firstDefinedIn" ;
    rdfs:range common_domain_model:ContractualDefinition ;
    skos:definition "The supplement or version the FRO was first added to the 2006 Definitions or 2021 Floating Rate Matrix. (e.g. S52)" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:firstName a owl:DatatypeProperty ;
    rdfs:label "firstName" ;
    rdfs:range xsd:string ;
    skos:definition "The natural person's first name. It is optional in FpML." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:firstObservationDateOffset a owl:ObjectProperty ;
    rdfs:label "firstObservationDateOffset" ;
    rdfs:range common_domain_model:Offset ;
    skos:definition "Defines the offset of the series of pricing dates relative to the calculation period." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:firstOrSecondPeriod a owl:ObjectProperty ;
    rdfs:label "firstOrSecondPeriod" ;
    rdfs:range common_domain_model:DividendPeriodEnum ;
    skos:definition "2002 ISDA Equity Derivatives Definitions: Dividend Period as either the First Period or the Second Period. | " ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:firstPeriodStartDate a owl:ObjectProperty ;
    rdfs:label "firstPeriodStartDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates.firstPeriodStartDate ;
    skos:definition "The start date of the calculation period. FpML specifies that for interest rate swaps this date must only be specified if it is not equal to the effective date. It is always specified in the case of equity swaps and credit default swaps with periodic payments. This date may be subject to adjustment in accordance with a business day convention." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:fixedPaymentAmount a owl:ObjectProperty ;
    rdfs:label "fixedPaymentAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "A known fixed payment amount." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:fixedPrice a owl:ObjectProperty ;
    rdfs:label "fixedPrice" ;
    rdfs:range common_domain_model:FixedPrice ;
    skos:definition "Specifies the fixed price on which fixed forward payments are based." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:fixedSettlement a owl:DatatypeProperty ;
    rdfs:label "fixedSettlement" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CashSettlementTerms.fixedSettlement ;
    skos:definition "Used for Recovery Lock, to indicate whether fixed Settlement is Applicable or Not Applicable. If Buyer fails to deliver an effective Notice of Physical Settlement on or before the Buyer NOPS Cut-off Date, and if Seller fails to deliver an effective Seller NOPS on or before the Seller NOPS Cut-off Date, then either: (a) if Fixed Settlement is specified in the related Confirmation as not applicable, then the Seller NOPS Cut-off Date shall be the Termination Date; or (b) if Fixed Settlement is specified in the related Confirmation as applicable, then: (i) if the Fixed Settlement Amount is a positive number, Seller shall, subject to Section 3.1 (except for the requirement of satisfaction of the Notice of Physical Settlement Condition to Settlement), pay the Fixed Settlement Amount to Buyer on the Fixed Settlement Payment Date; and (ii) if the Fixed Settlement Amount is a negative number, Buyer shall, subject to Section 3.1 (except for the requirement of satisfaction of the Notice of Physical Settlement Condition to Settlement), pay the absolute value of the Fixed Settlement Amount to Seller on the Fixed Settlement Payment Date." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:fixingDate a owl:ObjectProperty ;
    rdfs:label "fixingDate" ;
    rdfs:range common_domain_model:AdjustableDate ;
    skos:definition "The date on which the fixing is scheduled to occur." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:fixingDates a owl:ObjectProperty ;
    rdfs:label "fixingDates" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:definition "The fixing dates are the dates on which the index values are observed. The fixing dates are specified by reference to the reset date through business days offset and an associated set of financial business centers. Normally these offset calculation rules will be those specified in the ISDA definition for the relevant floating rate index (ISDA's Floating Rate Option). However, non-standard offset calculation rules may apply for a trade if mutually agreed by the principal parties to the transaction." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:fixingOffset a owl:ObjectProperty ;
    rdfs:label "fixingOffset" ;
    rdfs:range common_domain_model:BusinessDayOffset ;
    skos:definition "Parameters defining the normal fixing offset (can vary by index tenor / designated maturity)." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:fixingOffsetDefinition a owl:DatatypeProperty ;
    rdfs:label "fixingOffsetDefinition" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BusinessDayOffset.fixingOffsetDefinition ;
    skos:definition "Legal text that underlies the Fixing Offset. ISDA Fixing Offset Definition. (e.g. One day that is either a Sydney Business Day or a Melbourne Business Day following the Reset Date)" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:fixingOffsetReason a owl:DatatypeProperty ;
    rdfs:label "fixingOffsetReason" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BusinessDayOffset.fixingOffsetReason ;
    skos:definition "Fixing Offset Reason" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:fixingPeriod a owl:ObjectProperty ;
    rdfs:label "fixingPeriod" ;
    rdfs:range common_domain_model:DateRange ;
    skos:definition "Period over which the underlying price is observed." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:fixingReason a owl:DatatypeProperty ;
    rdfs:label "fixingReason" ;
    rdfs:range xsd:string ;
    skos:definition "Fixing Reason" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:fixingTimeDefinition a owl:DatatypeProperty ;
    rdfs:label "fixingTimeDefinition" ;
    rdfs:range xsd:string ;
    skos:definition "Legal text that underlies the Fixing Time. ISDA Fixing Time Definition. (e.g. 09:30, Sydney time)." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:floatingAmount a owl:DatatypeProperty ;
    rdfs:label "floatingAmount" ;
    rdfs:range xsd:string ;
    skos:definition "Floating Amount Calculation" ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:floatingAmountEvents a owl:ObjectProperty ;
    rdfs:label "floatingAmountEvents" ;
    rdfs:range common_domain_model:FloatingAmountEvents ;
    skos:definition "This element contains the ISDA terms relating to the floating rate payment events and the implied additional fixed payments, applicable to the credit derivatives transactions on mortgage-backed securities with pay-as-you-go or physical settlement." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:floatingAmountProvisions a owl:ObjectProperty ;
    rdfs:label "floatingAmountProvisions" ;
    rdfs:range common_domain_model:FloatingAmountProvisions ;
    skos:definition "Specifies the floating amount provisions associated with the floatingAmountEvents." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:floatingRateDefinition a owl:ObjectProperty ;
    rdfs:label "floatingRateDefinition" ;
    rdfs:range common_domain_model:FloatingRateDefinition ;
    skos:closeMatch fpml_5_10:CalculationPeriod.floatingRateDefinition ;
    skos:definition "The floating rate reset information for the calculation period." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:forceMajeureOrActOfSState a owl:ObjectProperty ;
    rdfs:label "forceMajeureOrActOfSState" ;
    rdfs:range common_domain_model:FxForceMajeureOrActOfSStateEnum ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(c).(ii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:forecastAmount a owl:ObjectProperty ;
    rdfs:label "forecastAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:closeMatch fpml_5_10:CalculationPeriod.forecastAmount ;
    skos:definition "The amount representing the forecast of the accrued value of the calculation period. An intermediate value used to generate the forecastPaymentAmount in the PaymentCalculationPeriod." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:forecastPaymentAmount a owl:ObjectProperty ;
    rdfs:label "forecastPaymentAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "A monetary amount representing the forecast of the future value of the payment." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:foreignExchangeAdditionalTerms a owl:ObjectProperty ;
    rdfs:label "foreignExchangeAdditionalTerms" ;
    rdfs:range common_domain_model:FxAdditionalTerms ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:foreignOwnershipEvent a owl:DatatypeProperty ;
    rdfs:label "foreignOwnershipEvent" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.foreignOwnershipEvent ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:fpmlDescription a owl:DatatypeProperty ;
    rdfs:label "fpmlDescription" ;
    rdfs:range xsd:string ;
    skos:definition "FpML Description" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:frenchLawAddendum a owl:ObjectProperty ;
    rdfs:label "frenchLawAddendum" ;
    rdfs:range common_domain_model:FrenchLawAddendum ;
    skos:definition "The French Law Addendum Provisions specific to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:fro a owl:ObjectProperty ;
    rdfs:label "fro" ;
    rdfs:range common_domain_model:FloatingRateIndexIdentification ;
    skos:definition "The underlying FRO name and designated maturity." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:froType a owl:DatatypeProperty ;
    rdfs:label "froType" ;
    rdfs:range xsd:string ;
    skos:definition "FRO type (e.g. OIS)" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:fullNm a owl:DatatypeProperty ;
    rdfs:label "fullNm" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#FullNm> .

common_domain_model:futureValueNotional a owl:ObjectProperty ;
    rdfs:label "futureValueNotional" ;
    rdfs:range common_domain_model:FutureValueAmount ;
    skos:definition "The future value notional is specific to BRL CDI swaps, and is specified alongside the notional amount. The value is calculated as follows: Future Value Notional = Notional Amount * (1 + Fixed Rate) ^ (Fixed Rate Day Count Fraction). The currency should always match that expressed in the notional schedule. The value date should match the adjusted termination date." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:futuresPriceValuation a owl:DatatypeProperty ;
    rdfs:label "futuresPriceValuation" ;
    rdfs:range xsd:boolean ;
    skos:definition "The official settlement price as announced by the related exchange is applicable, in accordance with the ISDA 2002 definitions." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:fxFixingSchedule a owl:ObjectProperty ;
    rdfs:label "fxFixingSchedule" ;
    rdfs:range common_domain_model:AdjustableDates ;
    skos:definition "The date, when expressed as a schedule of date(s), on which the currency rate will be determined for the purpose of specifying the amount in deliverable currency. This attribute was formerly part of 'NonDeliverableSettlement', which is now being harmonised into a common 'CashSettlementTerms' that includes a 'ValuationDate'." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:fxHaircut a owl:DatatypeProperty ;
    rdfs:label "fxHaircut" ;
    rdfs:range xsd:string ;
    skos:definition "The alternative definition for FX haircut percentage that applies to each party and item of Eligible Collateral unless this item is denominated in a Major Currency or in the Base Currency." ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"13\" clause \"(c)(v)(B)\" name \"FX Haircut Percentage\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:fxLinkedNotionalAmount a owl:ObjectProperty ;
    rdfs:label "fxLinkedNotionalAmount" ;
    rdfs:range common_domain_model:FxLinkedNotionalAmount ;
    skos:closeMatch fpml_5_10:CalculationPeriod.fxLinkedNotionalAmount ;
    skos:definition "The amount that a cashflow will accrue interest on. This is the calculated amount of the FX linked - i.e. the other currency notional amount multiplied by the appropriate FX spot rate." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:fxLinkedNotionalSchedule a owl:ObjectProperty ;
    rdfs:label "fxLinkedNotionalSchedule" ;
    rdfs:range common_domain_model:FxLinkedNotionalSchedule ;
    skos:definition "Multiplier specified as an FX-linked schedule, e.g. for a resetting cross-currency swap.." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:generalInconvertibility a owl:ObjectProperty ;
    rdfs:label "generalInconvertibility" ;
    rdfs:range common_domain_model:GeneralInconvertibility ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(iii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:generalInconvertibilityIsApplicable a owl:DatatypeProperty ;
    rdfs:label "generalInconvertibilityIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:generalNonTransferability a owl:ObjectProperty ;
    rdfs:label "generalNonTransferability" ;
    rdfs:range common_domain_model:GeneralNonTransferability ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(iv)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:generalNonTransferabilityIsApplicable a owl:DatatypeProperty ;
    rdfs:label "generalNonTransferabilityIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:generalTerms a owl:ObjectProperty ;
    rdfs:label "generalTerms" ;
    rdfs:range common_domain_model:GeneralTerms ;
    skos:definition "The specification of the non-monetary terms for the Credit Derivative Transaction, including the buyer and seller and selected items from the ISDA 2014 Credit Definition article II, such as the reference obligation and related terms." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:global_ a owl:DatatypeProperty ;
    rdfs:label "global_" ;
    rdfs:range xsd:decimal ;
    skos:definition "Global credit limit utilisation amount, agnostic of long/short position direction." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:governmentalAuthorityDefault a owl:ObjectProperty ;
    rdfs:label "governmentalAuthorityDefault" ;
    rdfs:range common_domain_model:GovernmentalAuthorityDefault ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(v)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:governmentalAuthorityDefaultIsApplicable a owl:DatatypeProperty ;
    rdfs:label "governmentalAuthorityDefaultIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:governmentalIntervention a owl:DatatypeProperty ;
    rdfs:label "governmentalIntervention" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. A governmental intervention is an event resulting from an action by a governmental authority that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2014 Term: Governmental Intervention." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:gracePeriod a owl:ObjectProperty ;
    rdfs:label "gracePeriod" ;
    rdfs:range common_domain_model:Offset ;
    skos:definition "The number of calendar or business days after any due date that the reference entity has to fulfil its obligations before a failure to pay credit event is deemed to have occurred. ISDA 2003 Term: Grace Period." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:gracePeriodExtension a owl:ObjectProperty ;
    rdfs:label "gracePeriodExtension" ;
    rdfs:range common_domain_model:GracePeriodExtension ;
    skos:definition "If this element is specified, indicates whether or not a grace period extension is applicable. ISDA 2003 Term: Grace Period Extension Applicable." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:grossInitialMargin a owl:ObjectProperty ;
    rdfs:label "grossInitialMargin" ;
    rdfs:range common_domain_model:Money ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:guarantor a owl:ObjectProperty ;
    rdfs:label "guarantor" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "The party that guarantees by way of a contractual arrangement to pay the debts of an obligor if the obligor is unable to make the required payments itself. ISDA 2003 Term: Guarantor." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:guarantorReference a owl:DatatypeProperty ;
    rdfs:label "guarantorReference" ;
    rdfs:range xsd:string ;
    skos:definition "A pointer style reference to a reference entity defined elsewhere in the document. Used when the reference entity is the guarantor." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:guarantorType a owl:ObjectProperty ;
    rdfs:label "guarantorType" ;
    rdfs:range common_domain_model:CollateralEntityTypeEnum ;
    skos:definition "Specifies the origin of entity guaranteeing the collateral." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:haircutIndicator a owl:ObjectProperty ;
    rdfs:label "haircutIndicator" ;
    rdfs:range common_domain_model:HaircutIndicatorEnum ;
    skos:closeMatch fpml_5_10:CollateralBalance.haircutIndicator ;
    skos:definition "Indicates if the collateral balance amount is based on pre or post haircut, if a haircut is associated with the collateral asset" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:hasControlAgreementLanguage a owl:DatatypeProperty ;
    rdfs:label "hasControlAgreementLanguage" ;
    rdfs:range xsd:boolean ;
    skos:definition "Control Agreement language is specified when True." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:hedgingDisruption a owl:DatatypeProperty ;
    rdfs:label "hedgingDisruption" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.hedgingDisruption ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:history a owl:ObjectProperty ;
    rdfs:label "history" ;
    rdfs:range common_domain_model:FroHistory ;
    skos:definition "FRO History" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:holdingAndUsingPostedCollateral a owl:ObjectProperty ;
    rdfs:label "holdingAndUsingPostedCollateral" ;
    rdfs:range common_domain_model:HoldingAndUsingPostedCollateral ;
    skos:definition "The elections for the holding and using of posted collateral by the respective parties to the Credit Support Annex for Variation Margin." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:honorific a owl:DatatypeProperty ;
    rdfs:label "honorific" ;
    rdfs:range xsd:string ;
    skos:definition "An honorific title, such as Mr., Ms., Dr. etc." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:hourMinuteTime a owl:DatatypeProperty ;
    rdfs:label "hourMinuteTime" ;
    rdfs:range xsd:time ;
    skos:closeMatch fpml_5_10:BusinessCenterTime.hourMinuteTime ;
    skos:definition "A time specified in hh:mm:ss format where the second component must be '00', e.g. 11am would be represented as 11:00:00." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:hourminutetime a owl:DatatypeProperty ;
    rdfs:label "hourminutetime" ;
    rdfs:range xsd:time ;
    skos:definition "A time specified in a 24-hour notation, e.g. 3pm would be represented as 15:00." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:identification a owl:ObjectProperty ;
    rdfs:label "identification" ;
    rdfs:range common_domain_model:CodeListIdentification ;
    skos:closeMatch fpml_5_10:CodeList.identification ;
    skos:definition "Identification information about the code list" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:illegalityOrImpossibility a owl:ObjectProperty ;
    rdfs:label "illegalityOrImpossibility" ;
    rdfs:range common_domain_model:FxIllegalityOrImpossibilityEnum ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(c).(i)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:illiquidity a owl:ObjectProperty ;
    rdfs:label "illiquidity" ;
    rdfs:range common_domain_model:Illiquidity ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(vi)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:illiquidityIsApplicable a owl:DatatypeProperty ;
    rdfs:label "illiquidityIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(vi)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:illiquidityValuationDate a owl:ObjectProperty ;
    rdfs:label "illiquidityValuationDate" ;
    rdfs:range common_domain_model:AdjustedRelativeDateOffset ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:inBaseCurrency a owl:DatatypeProperty ;
    rdfs:label "inBaseCurrency" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralInterestCalculationParameters.inBaseCurrency ;
    skos:definition "If True, specifies that the interest transfers should be converted to base currency equivalent, or if False specifies that the transfer should be in the currency of the collateral." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:inLoan a owl:DatatypeProperty ;
    rdfs:label "inLoan" ;
    rdfs:range xsd:boolean ;
    skos:definition "YES / NO to flag FROs identified by the FpML Syndicated Loan WG as having underlying benchmark that may also be referenced in syndicated loans." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:includeAccrualInMarginCalc a owl:DatatypeProperty ;
    rdfs:label "includeAccrualInMarginCalc" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.includeAccrualInMarginCalc ;
    skos:definition "Indicates whether or not to include the open interest accrual in the margin calculation." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:inclusionDate a owl:DatatypeProperty ;
    rdfs:label "inclusionDate" ;
    rdfs:range xsd:date ;
    skos:definition "Includes any Transaction specified below that is entered into on or after the specified date." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:inconvertibilityOrNonTransferability a owl:ObjectProperty ;
    rdfs:label "inconvertibilityOrNonTransferability" ;
    rdfs:range common_domain_model:FxInconvertibilityOrNonTransferability ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(vii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:increasedCostOfHedging a owl:DatatypeProperty ;
    rdfs:label "increasedCostOfHedging" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.increasedCostOfHedging ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:increasedCostOfStockBorrow a owl:DatatypeProperty ;
    rdfs:label "increasedCostOfStockBorrow" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.increasedCostOfStockBorrow ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:incurredRecoveryApplicable a owl:DatatypeProperty ;
    rdfs:label "incurredRecoveryApplicable" ;
    rdfs:range xsd:boolean ;
    skos:definition "Outstanding Swap Notional Amount is defined at any time on any day, as the greater of: (a) Zero; If Incurred Recovery Amount Applicable: (b) The Original Swap Notional Amount minus the sum of all Incurred Loss Amounts and all Incurred Recovery Amounts (if any) determined under this Confirmation at or prior to such time.Incurred Recovery Amount not populated: (b) The Original Swap Notional Amount minus the sum of all Incurred Loss Amounts determined under this Confirmation at or prior to such time." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:indemnity a owl:DatatypeProperty ;
    rdfs:label "indemnity" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AutomaticEarlyTermination.indemnity ;
    skos:definition "Specifies whether indemnity applies in the event AET is applicable to one or both of the parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:independentAmountBalance a owl:ObjectProperty ;
    rdfs:label "independentAmountBalance" ;
    rdfs:range common_domain_model:CollateralBalance ;
    skos:definition "Represents additional credit support amount over and above mark to market value." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:indexAdjustmentEvents a owl:ObjectProperty ;
    rdfs:label "indexAdjustmentEvents" ;
    rdfs:range common_domain_model:IndexAdjustmentEvents ;
    skos:editorialNote "ISDA EquityDerivativesDefinitions_2002 section \"Adjustment to Indices\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:indexAnnexDate a owl:DatatypeProperty ;
    rdfs:label "indexAnnexDate" ;
    rdfs:range xsd:date ;
    skos:definition "A CDS index series annex date." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:indexAnnexSource a owl:ObjectProperty ;
    rdfs:label "indexAnnexSource" ;
    rdfs:range common_domain_model:IndexAnnexSourceEnum ;
    skos:definition "A CDS index series annex source." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:indexCancellation a owl:ObjectProperty ;
    rdfs:label "indexCancellation" ;
    rdfs:range common_domain_model:IndexEventConsequenceEnum ;
    skos:definition "Consequence of index cancellation." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:indexDisclaimer a owl:DatatypeProperty ;
    rdfs:label "indexDisclaimer" ;
    rdfs:range xsd:boolean ;
    skos:definition "If present and true, then index disclaimer is applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:indexDisruption a owl:ObjectProperty ;
    rdfs:label "indexDisruption" ;
    rdfs:range common_domain_model:IndexEventConsequenceEnum ;
    skos:definition "Consequence of index disruption." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:indexModification a owl:ObjectProperty ;
    rdfs:label "indexModification" ;
    rdfs:range common_domain_model:IndexEventConsequenceEnum ;
    skos:definition "Consequence of index modification." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:indexReferenceInformation a owl:ObjectProperty ;
    rdfs:label "indexReferenceInformation" ;
    rdfs:range common_domain_model:CreditIndex ;
    skos:definition "This attribute contains all the terms relevant to the underlying Index." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:indexSource a owl:DatatypeProperty ;
    rdfs:label "indexSource" ;
    rdfs:range xsd:string ;
    skos:definition "The reference source such as Reuters or Bloomberg. FpML specifies indexSource to be of type rateSourcePageScheme, but without specifying actual values." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:indexStyle a owl:ObjectProperty ;
    rdfs:label "indexStyle" ;
    rdfs:range common_domain_model:FloatingRateIndexStyleEnum ;
    skos:definition "The ISDA FRO style (e.g. term rate, swap rate, etc)." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:indexTransition a owl:ObjectProperty ;
    rdfs:label "indexTransition" ;
    rdfs:range common_domain_model:IndexTransitionInstruction ;
    skos:definition "Specifies inputs needed to process a Index Transition business event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:indirectLoanParticipation a owl:ObjectProperty ;
    rdfs:label "indirectLoanParticipation" ;
    rdfs:range common_domain_model:LoanParticipation ;
    skos:definition "ISDA 1999 Term: Indirect Loan Participation. NOTE: Only applicable as a deliverable obligation under ISDA Credit 1999." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:ineligibleCreditSupport a owl:ObjectProperty ;
    rdfs:label "ineligibleCreditSupport" ;
    rdfs:range common_domain_model:IneligibleCreditSupport ;
    skos:definition "The parties to which the provisions of the Credit Support Annex for Variation Margin will apply to." ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"13 \" clause \"(c)(iii)\" name \"Legally Ineligible Credit Support (VM\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:infinity a owl:DatatypeProperty ;
    rdfs:label "infinity" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies that the Threshold is Infinity. If 'True' then the threshold for the elective party is Infinity." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:inflationLag a owl:ObjectProperty ;
    rdfs:label "inflationLag" ;
    rdfs:range common_domain_model:Offset ;
    skos:definition "An off-setting period from the payment date which determines the reference period for which the inflation index is observed." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:inflationRateIndex a owl:ObjectProperty ;
    rdfs:label "inflationRateIndex" ;
    rdfs:range common_domain_model:InflationRateIndexEnum ;
    skos:definition "The reference index that is used to specify the inflation interest rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:initialDesignation a owl:ObjectProperty ;
    rdfs:label "initialDesignation" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "Election to specify the initial custodian." ;
    skos:editorialNote "ISDA CSA_VM_2016" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:initialFee a owl:ObjectProperty ;
    rdfs:label "initialFee" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:ScheduledTransfer common_domain_model:UnscheduledTransfer ) ] common_domain_model:Transfer ) ] ;
    skos:closeMatch fpml_5_10:CancelableProvision.initialFee ;
    skos:definition "An initial fee for the cancelable option." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:initialIndexLevel a owl:DatatypeProperty ;
    rdfs:label "initialIndexLevel" ;
    rdfs:range xsd:decimal ;
    skos:definition "Initial known index level for the first calculation period." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:initialPayment a owl:DatatypeProperty ;
    rdfs:label "initialPayment" ;
    rdfs:range xsd:boolean ;
    skos:definition "A true/false flag to indicate whether there is an initial exchange of principal on the effective date." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:initialPoints a owl:DatatypeProperty ;
    rdfs:label "initialPoints" ;
    rdfs:range xsd:decimal ;
    skos:definition "An optional element that contains the up-front points expressed as a percentage of the notional. An initialPoints value of 5% would be represented as 0.05. The initialPoints element is an alternative to marketFixedRate in quoting the traded level of a trade. When initialPoints is used, the traded level is the sum of fixedRate and initialPoints. The initialPoints is one of the items that are factored into the initialPayment calculation and is payable by the Buyer to the Seller. Note that initialPoints and marketFixedRate may both be present in the same document when both implied values are desired." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:initialPrincipalPayment a owl:ObjectProperty ;
    rdfs:label "initialPrincipalPayment" ;
    rdfs:range common_domain_model:PrincipalPayment ;
    skos:definition "Principal Payment made at Trade inception." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:initialValuationDate a owl:ObjectProperty ;
    rdfs:label "initialValuationDate" ;
    rdfs:range common_domain_model:PerformanceValuationDates ;
    skos:definition "Specifies the initial valuation dates of the underlyer." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:insolvencyFiling a owl:DatatypeProperty ;
    rdfs:label "insolvencyFiling" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.insolvencyFiling ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:instructionType a owl:ObjectProperty ;
    rdfs:label "instructionType" ;
    rdfs:range common_domain_model:MarginCallInstructionType ;
    skos:definition "Identifies the enumeration values to specify the call notification type, direction, specific action type." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:integralMultipleAmount a owl:DatatypeProperty ;
    rdfs:label "integralMultipleAmount" ;
    rdfs:range xsd:decimal ;
    skos:definition "A notional amount which restricts the amount of notional that can be exercised when partial exercise or multiple exercise is applicable. The integral multiple amount defines a lower limit of notional that can be exercised and also defines a unit multiple of notional that can be exercised, i.e. only integer multiples of this amount can be exercised." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:intendedSettlementDate a owl:ObjectProperty ;
    rdfs:label "intendedSettlementDate" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:definition "The intended settlement date of the recall, expressed as an offset against a relative date e.g. T+1. The best practice is that the borrower must make their best efforts to settle on T+1." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:interest a owl:ObjectProperty ;
    rdfs:label "interest" ;
    rdfs:range common_domain_model:DebtInterestEnum ;
    skos:definition "Specifies the general rule for periodic interest rate payment." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:interestAmountApplication a owl:ObjectProperty ;
    rdfs:label "interestAmountApplication" ;
    rdfs:range common_domain_model:InterestAmountApplication ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.interestAmountApplication ;
    skos:definition "The application of Interest Amount with respect to the Delivery Amount and the Return Amount." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:interestCalculationFrequency a owl:ObjectProperty ;
    rdfs:label "interestCalculationFrequency" ;
    rdfs:range common_domain_model:CalculationFrequency ;
    skos:closeMatch fpml_5_10:CollateralInterestParameters.interestCalculationFrequency ;
    skos:definition "Represents how often and when interest is calculated." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:interestCalculationParameters a owl:ObjectProperty ;
    rdfs:label "interestCalculationParameters" ;
    rdfs:range common_domain_model:CollateralInterestCalculationParameters ;
    skos:closeMatch fpml_5_10:CollateralInterestParameters.interestCalculationParameters ;
    skos:definition "Represents the basic interest calculation parameters." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:interestHandlingParameters a owl:ObjectProperty ;
    rdfs:label "interestHandlingParameters" ;
    rdfs:range common_domain_model:CollateralInterestHandlingParameters ;
    skos:closeMatch fpml_5_10:CollateralInterestParameters.interestHandlingParameters ;
    skos:definition "Represents the parameters describing how and when interest transfer occurs." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:interestPaymentHandling a owl:ObjectProperty ;
    rdfs:label "interestPaymentHandling" ;
    rdfs:range common_domain_model:CollateralInterestHandlingEnum ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.interestPaymentHandling ;
    skos:definition "Specifies how the collateral interest is to be handled." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:interestRate a owl:ObjectProperty ;
    rdfs:label "interestRate" ;
    rdfs:range common_domain_model:Price ;
    skos:closeMatch fpml_5_10:AvailableInventoryRecord.interestRate ;
    skos:definition "An optional element which can be used to hold a rate associated to this piece of availability." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:interestRateAdditionalTerms a owl:DatatypeProperty ;
    rdfs:label "interestRateAdditionalTerms" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:interestRateCurve a owl:ObjectProperty ;
    rdfs:label "interestRateCurve" ;
    rdfs:range common_domain_model:InterestRateCurve ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:interestRolloverLimit a owl:ObjectProperty ;
    rdfs:label "interestRolloverLimit" ;
    rdfs:range common_domain_model:NumberBound ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.interestRolloverLimit ;
    skos:definition "Specifies the level below which the interest will be rolled over." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:interestShortfall a owl:ObjectProperty ;
    rdfs:label "interestShortfall" ;
    rdfs:range common_domain_model:InterestShortFall ;
    skos:definition "A floating rate payment event. With respect to any Reference Obligation Payment Date, either (a) the non-payment of an Expected Interest Amount or (b) the payment of an Actual Interest Amount that is less than the Expected Interest Amount. ISDA 2003 Term: Interest Shortfall." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:interestShortfallCap a owl:ObjectProperty ;
    rdfs:label "interestShortfallCap" ;
    rdfs:range common_domain_model:InterestShortfallCapEnum ;
    skos:definition "Specifies the nature of the interest Shortfall cap (i.e. Fixed Cap or Variable Cap) in the case where it is applicable. ISDA 2003 Term: Interest Shortfall Cap." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:interestShortfallReimbursement a owl:DatatypeProperty ;
    rdfs:label "interestShortfallReimbursement" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalFixedPayments.interestShortfallReimbursement ;
    skos:definition "An additional Fixed Payment Event. Corresponds to the payment by or on behalf of the Issuer of an actual interest amount in respect to the reference obligation that is greater than the expected interest amount. ISDA 2003 Term: Interest Shortfall Reimbursement." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:interimValuationDate a owl:ObjectProperty ;
    rdfs:label "interimValuationDate" ;
    rdfs:range common_domain_model:PerformanceValuationDates ;
    skos:definition "Specifies the interim valuation dates of the underlyer." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:intermediatePayment a owl:DatatypeProperty ;
    rdfs:label "intermediatePayment" ;
    rdfs:range xsd:boolean ;
    skos:definition "A true/false flag to indicate whether there are intermediate or interim exchanges of principal during the term of the swap." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:intermediatePrincipalPayment a owl:ObjectProperty ;
    rdfs:label "intermediatePrincipalPayment" ;
    rdfs:range common_domain_model:AdjustableRelativeOrPeriodicDates ;
    skos:definition "Principal Payment as part of the Trade lifecycle e.g. as part of notional reset adjustements in a Cross Currency Swap with a varying notional leg." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:interpolationTerms a owl:ObjectProperty ;
    rdfs:label "interpolationTerms" ;
    rdfs:range common_domain_model:StubValue ;
    skos:closeMatch fpml_5_10:AccrualFactorCalculationTerms.interpolationTerms ;
    skos:definition "Describes the rate, tenor, period duration for the short and long stubs, when the accrualRate optionnaly results from an interpolation method." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:invstmtDcsnPrsn a owl:ObjectProperty ;
    rdfs:label "invstmtDcsnPrsn" ;
    rdfs:range common_domain_model:InvstmtDcsnPrsn ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#InvstmtDcsnPrsn> .

common_domain_model:invstmtPtyInd a owl:DatatypeProperty ;
    rdfs:label "invstmtPtyInd" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#InvstmtPtyInd> .

common_domain_model:isCreditSupportDocument a owl:DatatypeProperty ;
    rdfs:label "isCreditSupportDocument" ;
    rdfs:range xsd:boolean ;
    skos:definition "Unless specified as True, the Control Agreement is not a Credit Support Document under the agreement with respect to a party." ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"Paragraph 6\" clause \" (e) \" name \"The Control Agreement as a Credit Support Document\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:isEligible a owl:DatatypeProperty ;
    rdfs:label "isEligible" ;
    rdfs:range xsd:boolean ;
    skos:definition "a simple boolean which is set to true if the asset described in the EligibilityQuery input is eligible" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:isFirstPeriod a owl:DatatypeProperty ;
    rdfs:label "isFirstPeriod" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CalculationPeriodData.isFirstPeriod ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:isIncluded a owl:DatatypeProperty ;
    rdfs:label "isIncluded" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralTreatment.isIncluded ;
    skos:definition "A boolean attribute to specify whether collateral critieria are inclusion (True) or exclusion (False) criteria." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:isLastPeriod a owl:DatatypeProperty ;
    rdfs:label "isLastPeriod" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CalculationPeriodData.isLastPeriod ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:isOpenOffer a owl:DatatypeProperty ;
    rdfs:label "isOpenOffer" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:ClearingInstruction.isOpenOffer ;
    skos:definition "Open Offer" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:isRecallable a owl:DatatypeProperty ;
    rdfs:label "isRecallable" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the securities on loan can be recalled by the lender." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:isWeighted a owl:DatatypeProperty ;
    rdfs:label "isWeighted" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AveragingCalculationMethod.isWeighted ;
    skos:definition "Identifies whether the average values will be weighted or unweighted." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:isin a owl:DatatypeProperty ;
    rdfs:label "isin" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#ISIN> .

common_domain_model:isoCode a owl:ObjectProperty ;
    rdfs:label "isoCode" ;
    rdfs:range common_domain_model:FloatingRateIndexExternalMap ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:issuanceCutoffTime a owl:ObjectProperty ;
    rdfs:label "issuanceCutoffTime" ;
    rdfs:range common_domain_model:TimeZone ;
    skos:definition "The operational deadline on T+0 before which a recall must be requested. For the UK, best practice recommends that this would be 30 minutes before market close i.e. 16:00:00 GMT." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:issuer a owl:DatatypeProperty ;
    rdfs:label "issuer" ;
    rdfs:range xsd:string ;
    skos:definition "The identifier issuer, when specified explicitly alongside the identifier value (instead of being specified by reference to a party)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_identifier ;
    common_domain_model:metadata_scheme true .

common_domain_model:issuerAgencyRating a owl:ObjectProperty ;
    rdfs:label "issuerAgencyRating" ;
    rdfs:range common_domain_model:AgencyRatingCriteria ;
    skos:definition "Represents an agency rating based on default risk and creditors claim in event of default associated with asset issuer." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:issuerCountryOfOrigin a owl:ObjectProperty ;
    rdfs:label "issuerCountryOfOrigin" ;
    rdfs:range common_domain_model:ISOCountryCodeEnum ;
    skos:definition "Represents a filter on the issuing entity country of origin based on the ISO Standard 3166, which is the same as filtering by eligible Sovereigns." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:issuerReference a owl:ObjectProperty ;
    rdfs:label "issuerReference" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "The identifier issuer, when specified by reference to a party specified as part of the transaction." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_identifier ;
    common_domain_model:metadata_reference true .

common_domain_model:itemName a owl:DatatypeProperty ;
    rdfs:label "itemName" ;
    rdfs:range xsd:string ;
    skos:definition "In this initial iteration, this corresponds to the DTCC TIW element name." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:itemValue a owl:DatatypeProperty ;
    rdfs:label "itemValue" ;
    rdfs:range xsd:string ;
    skos:definition "In this initial iteration, this corresponds to the DTCC value." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:japaneseLawCsa a owl:ObjectProperty ;
    rdfs:label "japaneseLawCsa" ;
    rdfs:range common_domain_model:OtherAgreementTerms ;
    skos:definition "The bespoke definition of whether Japanese Law CSA (VM) are specified by the parties to the agreement." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(s)(ii)\" name \"Japanese Law CSA (VM)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:japaneseSecuritiesProvisions a owl:ObjectProperty ;
    rdfs:label "japaneseSecuritiesProvisions" ;
    rdfs:range common_domain_model:JapaneseSecuritiesProvisions ;
    skos:definition "The Japanese Securities Provisions election." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:juryWaiver a owl:DatatypeProperty ;
    rdfs:label "juryWaiver" ;
    rdfs:range xsd:boolean ;
    skos:definition "The Jury Waiver conditions specific to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:lag a owl:ObjectProperty ;
    rdfs:label "lag" ;
    rdfs:range common_domain_model:Lag ;
    skos:definition "The pricing period per calculation period if the pricing days do not wholly fall within the respective calculation period." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:lagDuration a owl:ObjectProperty ;
    rdfs:label "lagDuration" ;
    rdfs:range common_domain_model:Offset ;
    skos:definition "Defines the offset of the series of pricing dates relative to the calculation period." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:language a owl:DatatypeProperty ;
    rdfs:label "language" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the language of the resource, described using the ISO 639-2/T Code." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:lastFixingPriceBeforeAdjustment a owl:ObjectProperty ;
    rdfs:label "lastFixingPriceBeforeAdjustment" ;
    rdfs:range common_domain_model:Price ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.lastFixingPriceBeforeAdjustment ;
    skos:definition "The last fixing price of the Underlier affected by the CorporateAction, before any adjustment with regards to the CorporateAction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:lastPaymentDate a owl:DatatypeProperty ;
    rdfs:label "lastPaymentDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:ClosedState.lastPaymentDate ;
    skos:definition "The date associated with the last payment in relation to the artefact (e.g. contract) to which this closed state applies. As an example, in the case of an early termination event, it would be the settlement date of the associated fee, if applicable." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:lastUpdatedIn a owl:ObjectProperty ;
    rdfs:label "lastUpdatedIn" ;
    rdfs:range common_domain_model:ContractualDefinition ;
    skos:definition "The supplement or version the FRO was last updated in the 2006 Definitions or 2021 Floating Rate Matrix. (e.g. FRO-M-V1)" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:latestCancelationTime a owl:ObjectProperty ;
    rdfs:label "latestCancelationTime" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:closeMatch fpml_5_10:CancelableProvision.latestCancelationTime ;
    skos:definition "The latest time at which notice of cancelation can be given." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:legacyAlternative a owl:ObjectProperty ;
    rdfs:label "legacyAlternative" ;
    rdfs:range common_domain_model:LegacyResolutionAlternative ;
    skos:definition "Alternative procedures to those in the pre-print for resolving collateral related disputes." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:legacyConsent a owl:ObjectProperty ;
    rdfs:label "legacyConsent" ;
    rdfs:range common_domain_model:LegacyConsentEnum ;
    skos:definition "The process for substituting/exchanging one form of collateral held by a party for a different form of collateral, used with legacy agreements." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:legalAgreementIdentification a owl:ObjectProperty ;
    rdfs:label "legalAgreementIdentification" ;
    rdfs:range common_domain_model:LegalAgreementIdentification ;
    skos:definition "The type of legal agreement, identified via a set of composable attributes: agreementName, publisher, governing law and version, e.g. ISDA 2013 Standard Credit Support Annex English Law." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:legalEntity a owl:ObjectProperty ;
    rdfs:label "legalEntity" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:closeMatch fpml_5_10:AncillaryEntity.legalEntity ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:lei a owl:DatatypeProperty ;
    rdfs:label "lei" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#LEI> .

common_domain_model:length a owl:ObjectProperty ;
    rdfs:label "length" ;
    rdfs:range common_domain_model:ResourceLength ;
    skos:definition "Indicates the length of the resource. For example, if the resource were a PDF file, the length would be in pages." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:lengthUnit a owl:ObjectProperty ;
    rdfs:label "lengthUnit" ;
    rdfs:range common_domain_model:LengthUnitEnum ;
    skos:definition "The length unit of the resource. For example, pages (pdf, text documents) or time (audio, video files)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:lengthValue a owl:DatatypeProperty ;
    rdfs:label "lengthValue" ;
    rdfs:range xsd:decimal ;
    skos:definition "The length value of the resource." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:levelPercentage a owl:DatatypeProperty ;
    rdfs:label "levelPercentage" ;
    rdfs:range xsd:decimal ;
    skos:definition "The trigger level percentage." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:lien a owl:DatatypeProperty ;
    rdfs:label "lien" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the seniority level of the lien." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:limitAmount a owl:DatatypeProperty ;
    rdfs:label "limitAmount" ;
    rdfs:range xsd:decimal ;
    skos:definition "The total limit available for the limit level and limit type. While the attribute is of type integer in the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:limitImpactDueToTrade a owl:DatatypeProperty ;
    rdfs:label "limitImpactDueToTrade" ;
    rdfs:range xsd:decimal ;
    skos:definition "The limit utilized by this specific trade. While the attribute is of type integer in the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:limitLevel a owl:ObjectProperty ;
    rdfs:label "limitLevel" ;
    rdfs:range common_domain_model:LimitLevelEnum ;
    skos:definition "The level at which the limit is set: customer business, proprietary business or account level. This attribute is specified as a string as part of the CME clearing confirmation specification." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    common_domain_model:metadata_scheme true .

common_domain_model:limitType a owl:ObjectProperty ;
    rdfs:label "limitType" ;
    rdfs:range common_domain_model:CreditLimitTypeEnum ;
    skos:definition "Standard code to indicate which type of credit line is being referred to - i.e. IM, DV01, PV01, CS01, Notional, Clip Size, Notional, maximumOrderQuantity." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    common_domain_model:metadata_scheme true .

common_domain_model:limitedRightToConfirm a owl:DatatypeProperty ;
    rdfs:label "limitedRightToConfirm" ;
    rdfs:range xsd:boolean ;
    skos:definition "Has the meaning defined as part of the 1997 ISDA Government Bond Option Definitions, section 4.5 Limited Right to Confirm Exercise. If present, (i) the Seller may request the Buyer to confirm its intent if not done on or before the expiration time on the Expiration date (ii) specific rules will apply in relation to the settlement mode." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:linearInterpolationElection a owl:ObjectProperty ;
    rdfs:label "linearInterpolationElection" ;
    rdfs:range common_domain_model:InterpolationMethodEnum ;
    skos:definition "Per Part 1 Section 3, 'Floating Obligations', of the 2018 ISDA CDM Equity Confirmation. Para 3.3." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:listId a owl:ObjectProperty ;
    rdfs:label "listId" ;
    rdfs:range common_domain_model:Identifier ;
    skos:definition "The identifier for the list. In the case of a package transaction, this would be the package identifier. This attribute is mandatory to allow the list itself to be identified." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_identifier .

common_domain_model:loadType a owl:ObjectProperty ;
    rdfs:label "loadType" ;
    rdfs:range common_domain_model:LoadTypeEnum ;
    skos:closeMatch fpml_5_10:AssetDeliveryProfile.loadType ;
    skos:definition "Identification of the delivery profile." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:loan a owl:ObjectProperty ;
    rdfs:label "loan" ;
    rdfs:range common_domain_model:Loan ;
    skos:definition "Identifies the underlying asset when it is a loan." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:loansCanBeGrouped a owl:DatatypeProperty ;
    rdfs:label "loansCanBeGrouped" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:Aggregation.loansCanBeGrouped ;
    skos:definition "The mark to market can be defined separately for different groups of loans." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:localBusinessDay a owl:DatatypeProperty ;
    rdfs:label "localBusinessDay" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the Notification Time is precluded on the day being a local business day." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:localJurisdiction a owl:DatatypeProperty ;
    rdfs:label "localJurisdiction" ;
    rdfs:range xsd:string ;
    skos:definition "The ISO 3166 standard code for the country within which the postal address is located." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:locationIdentifierType a owl:ObjectProperty ;
    rdfs:label "locationIdentifierType" ;
    rdfs:range common_domain_model:CommodityLocationIdentifierTypeEnum ;
    skos:definition "Specifies the nature of a location identifier." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_identifier .

common_domain_model:locationUri a owl:DatatypeProperty ;
    rdfs:label "locationUri" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CodeListIdentification.locationUri ;
    skos:definition "Suggested retrieval location for this version, in genericode format. An application must signal an error to the user if a document retrieved using a LocationUri is not in genericode format." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:lockoutCalculation a owl:ObjectProperty ;
    rdfs:label "lockoutCalculation" ;
    rdfs:range common_domain_model:OffsetCalculation ;
    skos:definition "any lockout  parameters if applicable." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:longPosition a owl:DatatypeProperty ;
    rdfs:label "longPosition" ;
    rdfs:range xsd:decimal ;
    skos:definition "Credit limit utilisation attributable to long positions." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:lookbackCalculation a owl:ObjectProperty ;
    rdfs:label "lookbackCalculation" ;
    rdfs:range common_domain_model:OffsetCalculation ;
    skos:definition "any lookback  parameters if applicable." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:lossOfStockBorrow a owl:DatatypeProperty ;
    rdfs:label "lossOfStockBorrow" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalDisruptionEvents.lossOfStockBorrow ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:lowerBarrier a owl:DatatypeProperty ;
    rdfs:label "lowerBarrier" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:BoundedVariance.lowerBarrier ;
    skos:definition "All observations below this price level will be excluded from the variance calculation." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:mainPublication a owl:DatatypeProperty ;
    rdfs:label "mainPublication" ;
    rdfs:range xsd:string ;
    skos:definition "The current main publication source such as relevant web site or a government body. FpML specifies mainPublication to be of type mainPublicationSource, but without specifying actual values." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:makeWholeAmount a owl:ObjectProperty ;
    rdfs:label "makeWholeAmount" ;
    rdfs:range common_domain_model:MakeWholeAmount ;
    skos:definition "Amount to be paid by the buyer of the option if the option is exercised prior to the Early Call Date. (The market practice in the convertible bond option space being that the buyer should be penalised if he/she exercises the option early on.)" ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:mandatoryEarlyTermination a owl:ObjectProperty ;
    rdfs:label "mandatoryEarlyTermination" ;
    rdfs:range common_domain_model:MandatoryEarlyTermination ;
    skos:definition "A mandatory early termination provision to terminate the swap at fair value." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:mandatoryEarlyTerminationAdjustedDates a owl:ObjectProperty ;
    rdfs:label "mandatoryEarlyTerminationAdjustedDates" ;
    rdfs:range common_domain_model:MandatoryEarlyTerminationAdjustedDates ;
    skos:definition "The adjusted dates associated with a mandatory early termination provision. These dates have been adjusted for any applicable business day convention." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:mandatoryEarlyTerminationDate a owl:ObjectProperty ;
    rdfs:label "mandatoryEarlyTerminationDate" ;
    rdfs:range common_domain_model:AdjustableDate ;
    skos:definition "The early termination date associated with a mandatory early termination of a swap." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:mandatoryEarlyTerminationDateTenor a owl:ObjectProperty ;
    rdfs:label "mandatoryEarlyTerminationDateTenor" ;
    rdfs:range common_domain_model:Period ;
    skos:definition "Period after trade date of the mandatory early termination date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:manualExercise a owl:ObjectProperty ;
    rdfs:label "manualExercise" ;
    rdfs:range common_domain_model:ManualExercise ;
    skos:definition "Specifies that the notice of exercise must be given by the buyer to the seller or seller's agent." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:manufacturedIncomeRequirement a owl:ObjectProperty ;
    rdfs:label "manufacturedIncomeRequirement" ;
    rdfs:range common_domain_model:DividendPayoutRatio ;
    skos:definition "Specifies the proportion of the value of the dividend on the borrowed shares that the borrower is legally obligated to return to the lender." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:mappings a owl:ObjectProperty ;
    rdfs:label "mappings" ;
    rdfs:range common_domain_model:FloatingRateIndexMappings ;
    skos:definition "Any mappings to other FRos." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:mapsTo a owl:ObjectProperty ;
    rdfs:label "mapsTo" ;
    rdfs:range common_domain_model:FloatingRateIndexMap ;
    skos:definition "The successor FRO that this index maps to." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:marginCallAction a owl:ObjectProperty ;
    rdfs:label "marginCallAction" ;
    rdfs:range common_domain_model:MarginCallActionEnum ;
    skos:definition "Specifies the margin call action details, specified as either Delivery or Return." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:marginResponseType a owl:ObjectProperty ;
    rdfs:label "marginResponseType" ;
    rdfs:range common_domain_model:MarginCallResponseTypeEnum ;
    skos:definition "Indicates the response type, such as, is the margin call response a 'full' 'part' agreement or 'dispute'." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:marginType a owl:ObjectProperty ;
    rdfs:label "marginType" ;
    rdfs:range common_domain_model:CollateralMarginTypeEnum ;
    skos:closeMatch fpml_5_10:CollateralInterestParameters.marginType ;
    skos:definition "Specifies the type of margin for which interest is being calculated, if the parameters are different depending on type of margin (initial or variation)." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:markToMarketValue a owl:ObjectProperty ;
    rdfs:label "markToMarketValue" ;
    rdfs:range common_domain_model:Money ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:marketDisruption a owl:ObjectProperty ;
    rdfs:label "marketDisruption" ;
    rdfs:range common_domain_model:MarketDisruptionEnum ;
    skos:closeMatch fpml_5_10:AveragingPeriod.marketDisruption ;
    skos:definition "The market disruption event as defined by ISDA 2002 Definitions." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    common_domain_model:metadata_scheme true .

common_domain_model:marketFixedRate a owl:DatatypeProperty ;
    rdfs:label "marketFixedRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "An optional element that only has meaning in a credit index trade. This element contains the credit spread ('fair value') at which the trade was executed. Unlike the fixedRate of an index, the marketFixedRate varies over the life of the index depending on market conditions. The marketFixedRate is the price of the index as quoted by trading desks." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:marketPrice a owl:DatatypeProperty ;
    rdfs:label "marketPrice" ;
    rdfs:range xsd:decimal ;
    skos:definition "An optional element that only has meaning in a credit index trade. This element contains the price at which the trade was executed and is used instead of marketFixedRate on credit trades on certain indicies which are quoted using a price rather than a spread." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:masterAgreementElections a owl:ObjectProperty ;
    rdfs:label "masterAgreementElections" ;
    rdfs:range common_domain_model:MasterAgreementElections ;
    skos:closeMatch fpml_5_10:Agreement.masterAgreementElections ;
    skos:definition "A legal representation of the different possible master agreements" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:masterAgreementSchedule a owl:ObjectProperty ;
    rdfs:label "masterAgreementSchedule" ;
    rdfs:range common_domain_model:MasterAgreementSchedule ;
    skos:closeMatch fpml_5_10:Agreement.masterAgreementSchedule ;
    skos:definition "Elections to specify a Master Agreement Schedule." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:masterAgreementType a owl:ObjectProperty ;
    rdfs:label "masterAgreementType" ;
    rdfs:range common_domain_model:MasterAgreementTypeEnum ;
    skos:closeMatch fpml_5_10:AgreementName.masterAgreementType ;
    skos:definition "Specification of the master agreement type." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:materialChangeInCircumstance a owl:ObjectProperty ;
    rdfs:label "materialChangeInCircumstance" ;
    rdfs:range common_domain_model:MaterialChangeInCircumstance ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(viii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:materialChangeInCircumstanceIsApplicable a owl:DatatypeProperty ;
    rdfs:label "materialChangeInCircumstanceIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:materialDividend a owl:DatatypeProperty ;
    rdfs:label "materialDividend" ;
    rdfs:range xsd:boolean ;
    skos:definition "If present and true, then material non cash dividends are applicable." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:matrixSource a owl:ObjectProperty ;
    rdfs:label "matrixSource" ;
    rdfs:range common_domain_model:SettledEntityMatrixSourceEnum ;
    skos:definition "Relevant settled entity matrix source." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:matrixTerm a owl:ObjectProperty ;
    rdfs:label "matrixTerm" ;
    rdfs:range common_domain_model:MatrixTermEnum ;
    skos:definition "Defines any applicable key into the relevant matrix. For example, the Transaction Type would be the single term required for the Credit Derivatives Physical Settlement Matrix. This element should be omitted in the case of the 2000 ISDA Definitions Settlement Matrix for Early Termination and Swaptions." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:matrixType a owl:ObjectProperty ;
    rdfs:label "matrixType" ;
    rdfs:range common_domain_model:MatrixTypeEnum ;
    skos:definition "Identifies the form of applicable matrix." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:maturity a owl:DatatypeProperty ;
    rdfs:label "maturity" ;
    rdfs:range xsd:decimal ;
    skos:definition "Maturity in years" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:maturityExtension a owl:DatatypeProperty ;
    rdfs:label "maturityExtension" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. Results from the fact that the underlier fails to make principal payments as expected." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:maturityRange a owl:ObjectProperty ;
    rdfs:label "maturityRange" ;
    rdfs:range common_domain_model:PeriodRange ;
    skos:closeMatch fpml_5_10:AssetMaturity.maturityRange ;
    skos:definition "Represents a filter based on the underlying asset maturity." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:maturityType a owl:ObjectProperty ;
    rdfs:label "maturityType" ;
    rdfs:range common_domain_model:MaturityTypeEnum ;
    skos:closeMatch fpml_5_10:AssetMaturity.maturityType ;
    skos:definition "Specifies whether the maturity range is the remaining or original maturity." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:maximumBoundaryPercent a owl:DatatypeProperty ;
    rdfs:label "maximumBoundaryPercent" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:BoundedCorrelation.maximumBoundaryPercent ;
    skos:definition "Maximum Boundary as a percentage of the Strike Price." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:maximumDaysOfPostponement a owl:DatatypeProperty ;
    rdfs:label "maximumDaysOfPostponement" ;
    rdfs:range xsd:integer ;
    skos:definition "The maximum number of days to wait for a quote from the disrupted settlement rate option before proceeding to the next method." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:maximumMaturity a owl:ObjectProperty ;
    rdfs:label "maximumMaturity" ;
    rdfs:range common_domain_model:Period ;
    skos:definition "A deliverable obligation characteristic. An obligation that has a remaining maturity from the Physical Settlement Date of not greater than the period specified. ISDA 2003 Term: Maximum Maturity." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:meanAdjustment a owl:DatatypeProperty ;
    rdfs:label "meanAdjustment" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies whether Mean Adjustment is applicable or not in the calculation of the Realized Volatility, Variance or Correlation" ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:merger a owl:ObjectProperty ;
    rdfs:label "merger" ;
    rdfs:range common_domain_model:Merger ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.merger ;
    skos:definition "Defines the underlier for both the Purchaser Company and the Acquired Compagny involved in Spin Off corporate action, as well as the respective price observation for each." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:mergerEvents a owl:ObjectProperty ;
    rdfs:label "mergerEvents" ;
    rdfs:range common_domain_model:EquityCorporateEvents ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:messageId a owl:DatatypeProperty ;
    rdfs:label "messageId" ;
    rdfs:range xsd:string ;
    skos:definition "A unique identifier assigned to the message." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    common_domain_model:metadata_scheme true .

common_domain_model:methodology a owl:ObjectProperty ;
    rdfs:label "methodology" ;
    rdfs:range common_domain_model:AverageTradingVolumeMethodologyEnum ;
    skos:closeMatch fpml_5_10:AverageTradingVolume.methodology ;
    skos:definition "Indicates the type of equity average trading volume being stated (single) the highest amount on one exchange, or (consolidated) volumes across multiple exchanges." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:mimeType a owl:DatatypeProperty ;
    rdfs:label "mimeType" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates the type of media used to store the content. mimeType is used to determine the software product(s) that can read the content. MIME Types are described in RFC 2046." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:minimumAssets a owl:ObjectProperty ;
    rdfs:label "minimumAssets" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "The minimal level of assets requirement with respect to the custody agent." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:minimumBillingAmount a owl:ObjectProperty ;
    rdfs:label "minimumBillingAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "daily fee increments accrue until a threshold is crossed, at which point payment becomes due)" ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:minimumBoundaryPercent a owl:DatatypeProperty ;
    rdfs:label "minimumBoundaryPercent" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:BoundedCorrelation.minimumBoundaryPercent ;
    skos:definition "Minimum Boundary as a percentage of the Strike Price." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:minimumNotionalAmount a owl:DatatypeProperty ;
    rdfs:label "minimumNotionalAmount" ;
    rdfs:range xsd:decimal ;
    skos:definition "The minimum notional amount that can be exercised on a given exercise date. See multipleExercise." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:minimumQuotationAmount a owl:ObjectProperty ;
    rdfs:label "minimumQuotationAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "In the determination of a cash settlement amount, if weighted average quotations are to be obtained, the minimum quotation amount specifies a minimum intended threshold amount of outstanding principal balance of the reference obligation for which the quote should be obtained. If not specified, the ISDA definitions provide for a fallback amount of the lower of either USD 1,000,000 (or its equivalent in the relevant obligation currency) or the quotation amount. ISDA 2003 Term: Minimum Quotation Amount." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:minimumRating a owl:ObjectProperty ;
    rdfs:label "minimumRating" ;
    rdfs:range common_domain_model:CreditNotation ;
    skos:definition "The minimal rating requirement with respect to the custody agent." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:minimumTransferAmount a owl:ObjectProperty ;
    rdfs:label "minimumTransferAmount" ;
    rdfs:range common_domain_model:MinimumTransferAmount ;
    skos:definition "Represents the threshold specified in the agreement below which collateral need not be delivered, and represents the smallest incremental value of exposure that must be reached before the parties are obliged to transfer collateral." ;
    skos:editorialNote "ISDA CSA_English_1995",
        "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(d)(vi)(C)\" name \"Rounding\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(c)(vi)(C)\" name \"Rounding\"",
        "ISDA CSA_NewYork_1994",
        "ISDA CSA_VM_English_2016",
        "ISDA CSA_VM_NewYork_2016",
        "ISDA CSD_English_1995",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(c)(vi)(C)\" name \"Rounding\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:modifiedEquityDelivery a owl:DatatypeProperty ;
    rdfs:label "modifiedEquityDelivery" ;
    rdfs:range xsd:boolean ;
    skos:definition "Value of this attribute set to 'true' indicates that modified equity delivery is applicable." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:money a owl:ObjectProperty ;
    rdfs:label "money" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "The money amount to be used as the bound, e.g. 1,000 USD." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:multipleCreditEventNotices a owl:DatatypeProperty ;
    rdfs:label "multipleCreditEventNotices" ;
    rdfs:range xsd:boolean ;
    skos:definition "Presence of this element and value set to 'true' indicates that Section 3.9 of the 2003 Credit Derivatives Definitions shall apply. Absence of this element indicates that Section 3.9 shall not apply. NOTE: Not allowed under ISDA Credit 1999." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:multipleHolderObligation a owl:DatatypeProperty ;
    rdfs:label "multipleHolderObligation" ;
    rdfs:range xsd:boolean ;
    skos:definition "In relation to a restructuring credit event, unless multiple holder obligation is not specified restructurings are limited to multiple holder obligations. A multiple holder obligation means an obligation that is held by more than three holders that are not affiliates of each other and where at least two thirds of the holders must agree to the event that constitutes the restructuring credit event. ISDA 2003 Term: Multiple Holder Obligation." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:multipleValuationDates a owl:ObjectProperty ;
    rdfs:label "multipleValuationDates" ;
    rdfs:range common_domain_model:MultipleValuationDates ;
    skos:definition "Where multiple valuation dates are specified as being applicable for cash settlement, this element specifies (a) the number of applicable valuation dates, and (b) the number of business days after satisfaction of all conditions to settlement when the first such valuation date occurs, and (c) the number of business days thereafter of each successive valuation date. ISDA 2003 Term: Multiple Valuation Dates." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:multiplierValue a owl:DatatypeProperty ;
    rdfs:label "multiplierValue" ;
    rdfs:range xsd:decimal ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:mutualEarlyTermination a owl:DatatypeProperty ;
    rdfs:label "mutualEarlyTermination" ;
    rdfs:range xsd:boolean ;
    skos:definition "Used for specifying whether the Mutual Early Termination Right that is detailed in the Master Confirmation will apply." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:nationalization a owl:ObjectProperty ;
    rdfs:label "nationalization" ;
    rdfs:range common_domain_model:Nationalization ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(ix)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:nationalizationOrInsolvency a owl:ObjectProperty ;
    rdfs:label "nationalizationOrInsolvency" ;
    rdfs:range common_domain_model:NationalizationOrInsolvencyOrDelistingEventEnum ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:necEvent a owl:DatatypeProperty ;
    rdfs:label "necEvent" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates Control Agreement language related to delivery of a Notice of Exclusive Control." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:needsConsent a owl:DatatypeProperty ;
    rdfs:label "needsConsent" ;
    rdfs:range xsd:boolean ;
    skos:definition "The election as to whether the Pledgor/Obligor/Chargor/Security Provider must obtain the Secured Partys consent for any collateral substitution." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(f)(ii)\" name \"Consent\"",
        "ISDA CSA_VM_2016 paragraph \"13\" clause \"(f)(ii)\" name \"Consent\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:negativeCriteria a owl:ObjectProperty ;
    rdfs:label "negativeCriteria" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllCriteria common_domain_model:AnyCriteria common_domain_model:NegativeCriteria common_domain_model:CollateralIssuerType common_domain_model:CollateralGuarantorType common_domain_model:AssetType common_domain_model:IssuerCountryOfOrigin common_domain_model:AssetCountryOfOrigin common_domain_model:CurrencyCodeEnum common_domain_model:IssuerName common_domain_model:IssuerAgencyRating common_domain_model:SovereignAgencyRating common_domain_model:AssetAgencyRating common_domain_model:AssetMaturity common_domain_model:SpecificAsset common_domain_model:CollateralTaxonomy common_domain_model:ListingExchange common_domain_model:ListingSector common_domain_model:IndexType common_domain_model:CounterpartyOwnIssuePermitted common_domain_model:DomesticCurrencyIssued ) ] common_domain_model:CollateralCriteria ) ] ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:negativeInterest a owl:DatatypeProperty ;
    rdfs:label "negativeInterest" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralAgreementFloatingRate.negativeInterest ;
    skos:definition "Specifies how negative rates should be applied.  If rates go negative, should the payment be reversed (true) or zeroed out (false)?" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:negativeInterestRateTreatment a owl:ObjectProperty ;
    rdfs:label "negativeInterestRateTreatment" ;
    rdfs:range common_domain_model:NegativeInterestRateTreatmentEnum ;
    skos:definition "The specification of any provisions for calculating payment obligations when a floating rate is negative (either due to a quoted negative floating rate or by operation of a spread that is subtracted from the floating rate)." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:negativeTreatment a owl:ObjectProperty ;
    rdfs:label "negativeTreatment" ;
    rdfs:range common_domain_model:NegativeInterestRateTreatmentEnum ;
    skos:definition "How to handle negative interest rates." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:netInitialMargin a owl:ObjectProperty ;
    rdfs:label "netInitialMargin" ;
    rdfs:range common_domain_model:Money ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:netInterestWithMarginCalls a owl:DatatypeProperty ;
    rdfs:label "netInterestWithMarginCalls" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.netInterestWithMarginCalls ;
    skos:definition "Indicates whether the interest amount may be offset against any margin call deliver or return amounts?   (aka 'net payments' indicator)." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:netPostedAndHeldInterest a owl:DatatypeProperty ;
    rdfs:label "netPostedAndHeldInterest" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.netPostedAndHeldInterest ;
    skos:definition "Indicates whether to net Held and Posted Interest Payments (i.e. whether interest payable for a period can be netted with interest receivable)." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:nettingObligationsApply a owl:ObjectProperty ;
    rdfs:label "nettingObligationsApply" ;
    rdfs:range common_domain_model:ApplicabilityOfElectionEnum ;
    skos:closeMatch fpml_5_10:CollateralSpecification.nettingObligationsApply ;
    skos:definition "Does paragraph 5.6 (netting of obligations to deliver Collateral and redeliver Equivalent Collateral) apply to the GMSLA?" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:newTx a owl:ObjectProperty ;
    rdfs:label "newTx" ;
    rdfs:range common_domain_model:New ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#New> .

common_domain_model:nextEvent a owl:ObjectProperty ;
    rdfs:label "nextEvent" ;
    rdfs:range common_domain_model:EventInstruction ;
    skos:definition "The intended next event can be specified, even if the instructions are not known yet." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:noFaultTermination a owl:DatatypeProperty ;
    rdfs:label "noFaultTermination" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:nonCashDividendTreatment a owl:ObjectProperty ;
    rdfs:label "nonCashDividendTreatment" ;
    rdfs:range common_domain_model:NonCashDividendTreatmentEnum ;
    skos:definition "Specifies the treatment of Non-Cash Dividends." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:nonContractualObligations a owl:DatatypeProperty ;
    rdfs:label "nonContractualObligations" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specification of whether the Governing Law clause extends to Non-Contractual Obligations (True) or does not extend to Non-Contractual Obligations (False)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:nonDeliverableSubstituteIsApplicable a owl:DatatypeProperty ;
    rdfs:label "nonDeliverableSubstituteIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:nonReliance a owl:DatatypeProperty ;
    rdfs:label "nonReliance" ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, then non reliance is applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:nonStandardisedTerms a owl:DatatypeProperty ;
    rdfs:label "nonStandardisedTerms" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies, when boolean value is True, that additional economic terms exist that have not been included in the product representation." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:nonstandardSettlementRate a owl:ObjectProperty ;
    rdfs:label "nonstandardSettlementRate" ;
    rdfs:range common_domain_model:FxInformationSource ;
    skos:definition "Indicates that a non-standard rate source will be used for the fixing." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:notBearer a owl:DatatypeProperty ;
    rdfs:label "notBearer" ;
    rdfs:range xsd:boolean ;
    skos:definition "A deliverable obligation characteristic. Any obligation that is not a bearer instrument. This applies to Bonds only and is meant to avoid tax, fraud and security/delivery provisions that can potentially be associated with Bearer Bonds. ISDA 2003 Term: Not Bearer." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:notation a owl:DatatypeProperty ;
    rdfs:label "notation" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies The credit rating notation. As it varies among credit rating agencies, FpML doesn't specify a default scheme." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:noticePeriod a owl:ObjectProperty ;
    rdfs:label "noticePeriod" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:definition "The length of each evergreen extension period relative to the effective date of the preceding contract." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:notification a owl:ObjectProperty ;
    rdfs:label "notification" ;
    rdfs:range common_domain_model:CollateralInterestNotification ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.notification ;
    skos:definition "Specifies the terms describing notification requirements." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:notificationDayType a owl:ObjectProperty ;
    rdfs:label "notificationDayType" ;
    rdfs:range common_domain_model:DayTypeEnum ;
    skos:closeMatch fpml_5_10:CollateralInterestNotification.notificationDayType ;
    skos:definition "The type of days on which notification should occur." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:notional a owl:DatatypeProperty ;
    rdfs:label "notional" ;
    rdfs:range xsd:decimal ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:notionalAmountReference a owl:ObjectProperty ;
    rdfs:label "notionalAmountReference" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "A reference to the notional amount." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    common_domain_model:metadata_reference true .

common_domain_model:notionalCurrency a owl:DatatypeProperty ;
    rdfs:label "notionalCurrency" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:ntnlCcy a owl:DatatypeProperty ;
    rdfs:label "ntnlCcy" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#NtnlCcy> .

common_domain_model:numberOfObservationDates a owl:DatatypeProperty ;
    rdfs:label "numberOfObservationDates" ;
    rdfs:range xsd:integer ;
    skos:definition "The number of observation dates between observation start date and observation end date." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:numberOfSubstitutionsAllowed a owl:DatatypeProperty ;
    rdfs:label "numberOfSubstitutionsAllowed" ;
    rdfs:range xsd:integer ;
    skos:definition "Specifies if 1 or more substitutions are allowed." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:obligationAcceleration a owl:DatatypeProperty ;
    rdfs:label "obligationAcceleration" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. One or more of the obligations have been declared due and payable before they would otherwise have been due and payable as a result of, or on the basis of, the occurrence of a default, event of default or other similar condition or event other than failure to pay (preferred by the market over Obligation Default, because more definitive and encompasses the definition of Obligation Default - this is more favorable to the Seller). Subject to the default requirement amount. ISDA 2003 Term: Obligation Acceleration." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:obligationDefault a owl:DatatypeProperty ;
    rdfs:label "obligationDefault" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. One or more of the obligations have become capable of being declared due and payable before they would otherwise have been due and payable as a result of, or on the basis of, the occurrence of a default, event of default or other similar condition or event other than failure to pay. ISDA 2003 Term: Obligation Default." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:obligee a owl:ObjectProperty ;
    rdfs:label "obligee" ;
    rdfs:range common_domain_model:SecurityInterestObligeeEnum ;
    skos:definition "The party to whom obligations under the Master Agreement are owed and secured by the credit support arrangements." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:observationCapRate a owl:DatatypeProperty ;
    rdfs:label "observationCapRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "A daily observation cap rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:observationEvent a owl:ObjectProperty ;
    rdfs:label "observationEvent" ;
    rdfs:range common_domain_model:ObservationEvent ;
    skos:definition "Contains all information related to an observation." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:observationFloorRate a owl:DatatypeProperty ;
    rdfs:label "observationFloorRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "A daily observation floor rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:observationIdentifier a owl:ObjectProperty ;
    rdfs:label "observationIdentifier" ;
    rdfs:range common_domain_model:ObservationIdentifier ;
    skos:definition "Represents the observation was made i.e. how to uniquely identify the observed value among the population of all available market data." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:observationParameters a owl:ObjectProperty ;
    rdfs:label "observationParameters" ;
    rdfs:range common_domain_model:ObservationParameters ;
    skos:definition " any applicable observation parameters, such as daily caps or floors." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:observationReference a owl:DatatypeProperty ;
    rdfs:label "observationReference" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies an identification key for the market observation. This attribute can be used as a reference to assign weights to a series of dates defined in a parametricSchedule." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:observationSchedule a owl:ObjectProperty ;
    rdfs:label "observationSchedule" ;
    rdfs:range common_domain_model:ObservationSchedule ;
    skos:definition "Specifies a schedule of dates (non-parametric) on which market observations take place, and allows for the optional definition of weights where applicable.  When no weight is specified, then weight of each date is assumed to be 1.0" ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:observationShiftCalculation a owl:ObjectProperty ;
    rdfs:label "observationShiftCalculation" ;
    rdfs:range common_domain_model:ObservationShiftCalculation ;
    skos:definition "any obervation shift parameters if applicable." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:observedFxSpotRate a owl:DatatypeProperty ;
    rdfs:label "observedFxSpotRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The actual observed FX spot rate." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:observedRate a owl:DatatypeProperty ;
    rdfs:label "observedRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The actual observed rate before any required rate treatment is applied, e.g. before converting a rate quoted on a discount basis to an equivalent yield. An observed rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:observedValue a owl:ObjectProperty ;
    rdfs:label "observedValue" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "Specifies the observed value as a number." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:offsetMultiplier a owl:DatatypeProperty ;
    rdfs:label "offsetMultiplier" ;
    rdfs:range xsd:integer ;
    skos:definition "A time offset multiplier, e.g. 1, 2 or 3 etc. A negative value can be used when specifying a negative offset, e.g. -2 hours." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:offsetTimeUnit a owl:ObjectProperty ;
    rdfs:label "offsetTimeUnit" ;
    rdfs:range common_domain_model:TimeUnitEnum ;
    skos:definition "The unit of time for the offset (e.g., seconds, minutes, hours, days). " ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:onBehalfOf a owl:ObjectProperty ;
    rdfs:label "onBehalfOf" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:closeMatch fpml_5_10:AncillaryParty.onBehalfOf ;
    skos:definition "Optionally specifies the counterparty that the ancillary party is acting on behalf of." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:onFullReturn a owl:DatatypeProperty ;
    rdfs:label "onFullReturn" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.onFullReturn ;
    skos:definition "Indicates the option that accrued interest should be calculated and distributed when a full return of collateral occurs." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:onPartialReturn a owl:DatatypeProperty ;
    rdfs:label "onPartialReturn" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.onPartialReturn ;
    skos:definition "Indicates the option that accrued interest should be calculated and distributed when a partial return collateral occurs." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:openDateTime a owl:DatatypeProperty ;
    rdfs:label "openDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time when the position was opened." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:openUnits a owl:DatatypeProperty ;
    rdfs:label "openUnits" ;
    rdfs:range xsd:decimal ;
    skos:definition "The number of units (index or securities) that constitute the underlier of the swap. In the case of a basket swap, this element is used to reference both the number of basket units, and the number of each asset components of the basket when these are expressed in absolute terms." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:operand a owl:DatatypeProperty ;
    rdfs:label "operand" ;
    rdfs:range xsd:decimal ;
    skos:definition "The 2nd value in the arithmetic operation, which may be non-commutative in some cases: Subtract, Divide). The 2nd operand is called 'operand' to distinguish it from the 1st one which is the price anchor." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:operandType a owl:ObjectProperty ;
    rdfs:label "operandType" ;
    rdfs:range common_domain_model:PriceOperandEnum ;
    skos:definition "Optionally qualifies the type of operand: e.g. accrued or forward point." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:optionalEarlyTermination a owl:ObjectProperty ;
    rdfs:label "optionalEarlyTermination" ;
    rdfs:range common_domain_model:OptionalEarlyTermination ;
    skos:definition "An option for either or both parties to terminate the swap at fair value." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:optionalEarlyTerminationAdjustedDates a owl:ObjectProperty ;
    rdfs:label "optionalEarlyTerminationAdjustedDates" ;
    rdfs:range common_domain_model:OptionalEarlyTerminationAdjustedDates ;
    skos:definition "An early termination provision to terminate the trade at fair value where one or both parties have the right to decide on termination." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:optionalEarlyTerminationParameters a owl:ObjectProperty ;
    rdfs:label "optionalEarlyTerminationParameters" ;
    rdfs:range common_domain_model:ExercisePeriod ;
    skos:definition "Definition of the first early termination date and the frequency of the termination dates subsequent to that. American exercise is defined by having a frequency of one day." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:optionsExchangeDividends a owl:DatatypeProperty ;
    rdfs:label "optionsExchangeDividends" ;
    rdfs:range xsd:boolean ;
    skos:definition "If present and true, then options exchange dividends are applicable." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:optionsPriceValuation a owl:DatatypeProperty ;
    rdfs:label "optionsPriceValuation" ;
    rdfs:range xsd:boolean ;
    skos:definition "The official settlement price as announced by the related exchange is applicable, in accordance with the ISDA 2002 definitions" ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:ordinal a owl:DatatypeProperty ;
    rdfs:label "ordinal" ;
    rdfs:range xsd:integer ;
    skos:definition "In the case of multi-layered hierarchical classification systems such as commodity classification, the layer the value and className occupy in the classification hierarchy, where 1 represents the top-layer." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:ordrTrnsmssn a owl:ObjectProperty ;
    rdfs:label "ordrTrnsmssn" ;
    rdfs:range common_domain_model:OrdrTrnsmssn ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#OrdrTrnsmssn> .

common_domain_model:otherAgreement a owl:DatatypeProperty ;
    rdfs:label "otherAgreement" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:AgreementName.otherAgreement ;
    skos:definition "Definition of an agreement that is not enumerated in the CDM." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:otherAgreementType a owl:DatatypeProperty ;
    rdfs:label "otherAgreementType" ;
    rdfs:range xsd:string ;
    skos:definition "The agreement executed between the parties and intended to govern product-specific derivatives transactions between those parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:otherAssetType a owl:DatatypeProperty ;
    rdfs:label "otherAssetType" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:AssetType.otherAssetType ;
    skos:definition "Specifies the eligible asset type when not enumerated." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:otherCSA a owl:ObjectProperty ;
    rdfs:label "otherCSA" ;
    rdfs:range common_domain_model:OtherAgreementTerms ;
    skos:definition "The bespoke definition of Other CSA as specified by the parties to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:otherDetails a owl:DatatypeProperty ;
    rdfs:label "otherDetails" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Aggregation.otherDetails ;
    skos:definition "Any specfic elections that are not captured by the above options, such as grouping information." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .

common_domain_model:otherEligibleAndPostedSupport a owl:ObjectProperty ;
    rdfs:label "otherEligibleAndPostedSupport" ;
    rdfs:range common_domain_model:OtherEligibleAndPostedSupport ;
    skos:definition "The Other Eligible Support elections associated with margin agreements." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:otherEligibleSupport a owl:DatatypeProperty ;
    rdfs:label "otherEligibleSupport" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the Other Eligible Support conditions. If not specified, this election is deemed as not applicable." ;
    skos:editorialNote "ISDA CSA_IM_NewYork_2016",
        "ISDA CSA_IM_NewYork_2018",
        "ISDA CSA_NewYork_1994 paragraph \"13\" clause \"(b)(iii)\"",
        "ISDA CSA_VM_NewYork_2016",
        "ISDA CSD_English_1995 paragraph \"13\" clause \"(c)(iii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:otherProvisions a owl:DatatypeProperty ;
    rdfs:label "otherProvisions" ;
    rdfs:range xsd:string ;
    skos:definition "Other Custom Provisions of Custody Arrangements." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"3 General Principles\" clause \"(n)(vii)\" name \"Other Provisions\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:otherTerms a owl:DatatypeProperty ;
    rdfs:label "otherTerms" ;
    rdfs:range xsd:string ;
    skos:definition "The custom Resolution Time election that might be specified by the parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:outlook a owl:ObjectProperty ;
    rdfs:label "outlook" ;
    rdfs:range common_domain_model:CreditRatingOutlookEnum ;
    skos:definition "Assesses the potential direction of a long-term credit rating over the intermediate term, which is generally up to two years for investment grade and generally up to one year for speculative grade." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:overallExposure a owl:ObjectProperty ;
    rdfs:label "overallExposure" ;
    rdfs:range common_domain_model:Exposure ;
    skos:definition "Represents the whole overall mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:ownershipPartyReference a owl:ObjectProperty ;
    rdfs:label "ownershipPartyReference" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "A reference to the party that has ownership of this party role information. FpML specifies that For shared trade information, this attribute will reference the originator of the data (for example, an execution facility or clearing house)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:packageReference a owl:ObjectProperty ;
    rdfs:label "packageReference" ;
    rdfs:range common_domain_model:IdentifiedList ;
    skos:definition "A reference to the package linking the trade with other trades, in case the trade was executed as part of a package (hence this attribute is optional)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:parentSecurity a owl:ObjectProperty ;
    rdfs:label "parentSecurity" ;
    rdfs:range common_domain_model:Security ;
    skos:definition "Defines the underlier for the Parent Company involved in Spin Off corporate action." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:parentSecurityPrice a owl:ObjectProperty ;
    rdfs:label "parentSecurityPrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "The price observation that relates to underlier for the Parent Company." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:partialCashSettlement a owl:DatatypeProperty ;
    rdfs:label "partialCashSettlement" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies whether either 'Partial Cash Settlement of Assignable Loans', 'Partial Cash Settlement of Consent Required Loans' or 'Partial Cash Settlement of Participations' is applicable. If this element is specified and Assignable Loan is a Deliverable Obligation Characteristic, any Assignable Loan that is deliverable, but where a non-receipt of Consent by the Physical Settlement Date has occurred, the Loan can be cash settled rather than physically delivered. If this element is specified and Consent Required Loan is a Deliverable Obligation Characteristic, any Consent Required Loan that is deliverable, but where a non-receipt of Consent by the Physical Settlement Date has occurred, the Loan can be cash settled rather than physically delivered. If this element is specified and Direct Loan Participation is a Deliverable Obligation Characteristic, any Participation that is deliverable, but where this participation has not been effected (has not come into effect) by the Physical Settlement Date, the participation can be cash settled rather than physically delivered." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:party1 a owl:ObjectProperty ;
    rdfs:label "party1" ;
    rdfs:range common_domain_model:Party ;
    skos:closeMatch fpml_5_10:ClearingInstruction.party1 ;
    skos:definition "First party facing the CCP if it is clearing for its own account." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:party2 a owl:ObjectProperty ;
    rdfs:label "party2" ;
    rdfs:range common_domain_model:Party ;
    skos:closeMatch fpml_5_10:ClearingInstruction.party2 ;
    skos:definition "Second party facing the CCP if it is clearing for its own account." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:partyChange a owl:ObjectProperty ;
    rdfs:label "partyChange" ;
    rdfs:range common_domain_model:PartyChangeInstruction ;
    skos:definition "Specifies instructions describing a party change primitive event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:partyName a owl:DatatypeProperty ;
    rdfs:label "partyName" ;
    rdfs:range xsd:string ;
    skos:definition "The party name to which the workflow pertains to." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:partyOptionTerminationCurrency a owl:ObjectProperty ;
    rdfs:label "partyOptionTerminationCurrency" ;
    rdfs:range common_domain_model:PartyOptionTerminationCurrency ;
    skos:definition "Provides that the Termination Currency will be determined by reference to a contractual mechanism when closing out the Agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:passThrough a owl:ObjectProperty ;
    rdfs:label "passThrough" ;
    rdfs:range common_domain_model:PassThrough ;
    skos:definition "Specifies the rules for pass-through payments from the underlier, such as dividends." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:passThroughPercentage a owl:DatatypeProperty ;
    rdfs:label "passThroughPercentage" ;
    rdfs:range xsd:decimal ;
    skos:definition "Percentage of payments from the underlier which are passed through." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:payDate a owl:DatatypeProperty ;
    rdfs:label "payDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which resulting from the corporate action are delivered." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:payRelativeTo a owl:ObjectProperty ;
    rdfs:label "payRelativeTo" ;
    rdfs:range common_domain_model:PayRelativeToEnum ;
    skos:definition "Specifies whether the payments occur relative to each adjusted calculation period start date or end date, each reset date, valuation date or the last pricing date. Calculation period start date means relative to the start of the first calculation period contributing to a given payment. Similarly, calculation period end date means the end of the last calculation period contributing to a given payment. The valuation date is applicable for Brazilian-CDI and equity swaps." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:payer a owl:ObjectProperty ;
    rdfs:label "payer" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "Specifies the counterparty responsible for making the payments defined by this structure.  The party is one of the two principal parties to the transaction." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ERCCBestPractice#Seller>,
        <https://www.icmagroup.org/market-practice-and-regulatory-policy/GMRA#Seller> .

common_domain_model:payerAccountReference a owl:ObjectProperty ;
    rdfs:label "payerAccountReference" ;
    rdfs:range common_domain_model:Account ;
    skos:definition "A reference to the account responsible for making the payments defined by this structure." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:payerPartyReference a owl:ObjectProperty ;
    rdfs:label "payerPartyReference" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "The party responsible for making the payments defined by this structure." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:paymentAmount a owl:ObjectProperty ;
    rdfs:label "paymentAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "A fixed payment amount." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:paymentDateOffset a owl:ObjectProperty ;
    rdfs:label "paymentDateOffset" ;
    rdfs:range common_domain_model:Offset ;
    skos:definition "Only to be used when SharePayment has been specified in the dividendDateReference element. The number of Currency Business Days following the day on which the Issuer of the Shares pays the relevant dividend to holders of record of the Shares." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:paymentDateSchedule a owl:ObjectProperty ;
    rdfs:label "paymentDateSchedule" ;
    rdfs:range common_domain_model:PaymentDateSchedule ;
    skos:definition "The payment dates when specified as relative to a set of dates specified somewhere else in the instance document/transaction, e.g. the valuation dates as typically the case for equity swaps, or when specified as a calculation period schedule." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:paymentDatesAdjustments a owl:ObjectProperty ;
    rdfs:label "paymentDatesAdjustments" ;
    rdfs:range common_domain_model:BusinessDayAdjustments ;
    skos:definition "The definition of the business day convention and financial business centers used for adjusting the payment date if it would otherwise fall on a day that is not a business day in the specified business center." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:paymentDaysOffset a owl:ObjectProperty ;
    rdfs:label "paymentDaysOffset" ;
    rdfs:range common_domain_model:Offset ;
    skos:definition "If early payment or delayed payment is required, specifies the number of days offset that the payment occurs relative to what would otherwise be the unadjusted payment date. The offset can be specified in terms of either calendar or business days. Even in the case of a calendar days offset, the resulting payment date, adjusted for the specified calendar days offset, will still be adjusted in accordance with the specified payment dates adjustments. This element should only be included if early or delayed payment is applicable, i.e. if the periodMultiplier element value is not equal to zero. An early payment would be indicated by a negative periodMultiplier element value and a delayed payment (or payment lag) would be indicated by a positive periodMultiplier element value." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:paymentDiscounting a owl:ObjectProperty ;
    rdfs:label "paymentDiscounting" ;
    rdfs:range common_domain_model:PaymentDiscounting ;
    skos:closeMatch fpml_5_10:AssetFlowBase.paymentDiscounting ;
    skos:definition "FpML specifies the FpML PaymentDiscounting.model group for representing the discounting elements that can be associated with a payment." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:paymentFrequency a owl:ObjectProperty ;
    rdfs:label "paymentFrequency" ;
    rdfs:range common_domain_model:Frequency ;
    skos:definition "The frequency at which regular payment dates occur. If the payment frequency is equal to the frequency defined in the calculation period dates component then one calculation period contributes to each payment amount. If the payment frequency is less frequent than the frequency defined in the calculation period dates component then more than one calculation period will contribute to the payment amount. A payment frequency more frequent than the calculation period frequency or one that is not a multiple of the calculation period frequency is invalid. If the payment frequency is of value T (term), the period is defined by the effectiveDate and the terminationDate." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:paymentPercent a owl:DatatypeProperty ;
    rdfs:label "paymentPercent" ;
    rdfs:range xsd:decimal ;
    skos:definition "A percentage of the notional amount." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:paymentRequirement a owl:ObjectProperty ;
    rdfs:label "paymentRequirement" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "Specifies a threshold for the failure to pay credit event. Market standard is USD 1,000,000 (JPY 100,000,000 for Japanese Yen trades) or its equivalent in the relevant obligation currency. This is applied on an aggregate basis across all Obligations of the Reference Entity. Intended to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Payment Requirement" ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:paymentRule a owl:ObjectProperty ;
    rdfs:label "paymentRule" ;
    rdfs:range common_domain_model:PaymentRule ;
    skos:definition "The calculation rule." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:payoutReference a owl:ObjectProperty ;
    rdfs:label "payoutReference" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AssetPayout common_domain_model:CommodityPayout common_domain_model:CreditDefaultPayout common_domain_model:FixedPricePayout common_domain_model:InterestRatePayout common_domain_model:OptionPayout common_domain_model:PerformancePayout common_domain_model:SettlementPayout ) ] common_domain_model:Payout ) ] ;
    skos:definition "Represents the origin to the transfer as a reference for lineage purposes, whether it originated from trade level settlement terms or from payment terms on an economic payout." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:pending a owl:ObjectProperty ;
    rdfs:label "pending" ;
    rdfs:range common_domain_model:CreditLimitUtilisationPosition ;
    skos:definition "Credit limit utilisation attributable to pending unexecuted orders." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:perUnitOf a owl:ObjectProperty ;
    rdfs:label "perUnitOf" ;
    rdfs:range common_domain_model:UnitType ;
    skos:definition "Provides an attribute to define the unit of the thing being priced. For example, {amount, unitOfAmount, PerUnitOfAmount} = [10, EUR, Shares] = (10.00 EUR/SHARE) * (300,000 SHARES) = EUR 3,000,000.00 (Shares cancel out in the calculation)." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:percentageLimit a owl:ObjectProperty ;
    rdfs:label "percentageLimit" ;
    rdfs:range common_domain_model:NumberRange ;
    skos:definition "Specifies the perecentage of collateral limit represented as a decimal number - example 25% is 0.25." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:percentageRule a owl:ObjectProperty ;
    rdfs:label "percentageRule" ;
    rdfs:range common_domain_model:PercentageRule ;
    skos:definition "This attribute is not present as part of the FpML construct, as the payment rule is specialised by means of runtime type extension through the xsi:type." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:periodDatesAdjustments a owl:ObjectProperty ;
    rdfs:label "periodDatesAdjustments" ;
    rdfs:range common_domain_model:BusinessDayAdjustments ;
    skos:definition "The specification of the business day convention and financial business centers used for adjusting any calculation period date if it would otherwise fall on a day that is not a business day in the specified business center." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:periodFrequency a owl:ObjectProperty ;
    rdfs:label "periodFrequency" ;
    rdfs:range common_domain_model:CalculationPeriodFrequency ;
    skos:definition "The frequency at which calculation period end dates occur with the regular part of the calculation period schedule and their roll date convention." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:periodicDates a owl:ObjectProperty ;
    rdfs:label "periodicDates" ;
    rdfs:range common_domain_model:PeriodicDates ;
    skos:closeMatch fpml_5_10:AdjustableRelativeOrPeriodicDates.periodicDates ;
    skos:definition "A calculation period schedule." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:periodicSchedule a owl:ObjectProperty ;
    rdfs:label "periodicSchedule" ;
    rdfs:range common_domain_model:PeriodicDates ;
    skos:definition "Specifies the date range and frequency on which market observations take place.  Weights can be assigned to dates in the schedule by assigning the weight and corresponding observationReference in the observationSchedule." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:periodicity a owl:ObjectProperty ;
    rdfs:label "periodicity" ;
    rdfs:range common_domain_model:InterestAdjustmentPeriodicity ;
    skos:definition "The qualification of the Interest Adjustment periodicity." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:periods a owl:ObjectProperty ;
    rdfs:label "periods" ;
    rdfs:range common_domain_model:AssetDeliveryPeriods ;
    skos:closeMatch fpml_5_10:AssetDeliveryInformation.periods ;
    skos:definition "Defines the periods of delivery, including the delivery profile." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:personReference a owl:ObjectProperty ;
    rdfs:label "personReference" ;
    rdfs:range common_domain_model:NaturalPerson ;
    skos:definition "A reference to the natural person to whom the role refers to." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:physicalSettlementPeriod a owl:ObjectProperty ;
    rdfs:label "physicalSettlementPeriod" ;
    rdfs:range common_domain_model:PhysicalSettlementPeriod ;
    skos:definition "The number of business days used in the determination of the physical settlement date. The physical settlement date is this number of business days after all applicable conditions to settlement are satisfied. If a number of business days is not specified fallback provisions apply for determining the number of business days. If Section 8.5/8.6 of the 1999/2003 ISDA Definitions are to apply the businessDaysNotSpecified element should be included. If a specified number of business days are to apply these should be specified in the businessDays element. If Section 8.5/8.6 of the 1999/2003 ISDA Definitions are to apply but capped at a maximum number of business days then the maximum number should be specified in the maximumBusinessDays element. ISDA 2003 Term: Physical Settlement Period." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:physicalSettlementTerms a owl:ObjectProperty ;
    rdfs:label "physicalSettlementTerms" ;
    rdfs:range common_domain_model:PhysicalSettlementTerms ;
    skos:definition "Specifies the physical settlement terms which apply to the transaction." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:physicalSettlementTermsReference a owl:ObjectProperty ;
    rdfs:label "physicalSettlementTermsReference" ;
    rdfs:range common_domain_model:PhysicalSettlementTerms ;
    skos:definition "Reference to the physical settlement terms applicable to this item." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_reference true .

common_domain_model:pledgedAccount a owl:ObjectProperty ;
    rdfs:label "pledgedAccount" ;
    rdfs:range common_domain_model:Account ;
    skos:definition "The pledged account associated with the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:pledgeeRepresentativeRider a owl:ObjectProperty ;
    rdfs:label "pledgeeRepresentativeRider" ;
    rdfs:range common_domain_model:PledgeeRepresentativeRider ;
    skos:closeMatch fpml_5_10:CollateralTransferAgreementElections.pledgeeRepresentativeRider ;
    skos:definition "The terms of the Rider for the ISDA Euroclear 2019 Collateral Transfer Agreement with respect to the use of a Pledgee Representative attached to this Agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:portfolioState a owl:ObjectProperty ;
    rdfs:label "portfolioState" ;
    rdfs:range common_domain_model:PortfolioState ;
    skos:definition "Describes the state of the Portfolio as a list of Positions resulting from the aggregation." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:positionBase a owl:ObjectProperty ;
    rdfs:label "positionBase" ;
    rdfs:range common_domain_model:TradableProduct ;
    skos:definition "Encapsulates the core constituents that characterize a position." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:positionStatus a owl:ObjectProperty ;
    rdfs:label "positionStatus" ;
    rdfs:range common_domain_model:PositionStatusEnum ;
    skos:closeMatch fpml_5_10:AggregationParameters.positionStatus ;
    skos:definition "To aggregate based on position status (EXECUTED, SETTLED etc)" ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:postalCode a owl:DatatypeProperty ;
    rdfs:label "postalCode" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Address.postalCode ;
    skos:definition "The code, required for computerized mail sorting systems, that is allocated to a physical address by a national postal authority." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:predeterminedClearingOrganizationParty a owl:ObjectProperty ;
    rdfs:label "predeterminedClearingOrganizationParty" ;
    rdfs:range common_domain_model:AncillaryRoleEnum ;
    skos:definition "Specifies the clearing organization (CCP, DCO) to which the trade should be cleared." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:prescribedDocumentationAdjustment a owl:DatatypeProperty ;
    rdfs:label "prescribedDocumentationAdjustment" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CashCollateralValuationMethod.prescribedDocumentationAdjustment ;
    skos:definition "This may be used to indicate that 'prescribed documentation adjustment' is applicable." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:previousWorkflowStep a owl:ObjectProperty ;
    rdfs:label "previousWorkflowStep" ;
    rdfs:range common_domain_model:WorkflowStep ;
    skos:definition "Optional previous workflow step that provides lineage to workflow steps that precedes it." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    common_domain_model:metadata_reference true .

common_domain_model:pricMltplr a owl:DatatypeProperty ;
    rdfs:label "pricMltplr" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#PricMltplr> .

common_domain_model:priceComponent a owl:ObjectProperty ;
    rdfs:label "priceComponent" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "Denotes the price used to compute the valuation." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:priceExpression a owl:ObjectProperty ;
    rdfs:label "priceExpression" ;
    rdfs:range common_domain_model:PriceExpressionEnum ;
    skos:definition "(Optionally) Specifies whether the price is expressed in absolute or percentage terms." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:priceMateriality a owl:ObjectProperty ;
    rdfs:label "priceMateriality" ;
    rdfs:range common_domain_model:PriceMateriality ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(x)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:priceMaterialityIsApplicable a owl:DatatypeProperty ;
    rdfs:label "priceMaterialityIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:pricePublisher a owl:DatatypeProperty ;
    rdfs:label "pricePublisher" ;
    rdfs:range xsd:string ;
    skos:definition "Defines a publication in which the price can be found. (e.g Gas Daily, Platts Bloomberg. Commodity publishers can be found at this URL:  http://www.fpml.org/coding-scheme/commodity-information-provider>" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:priceQuoteType a owl:ObjectProperty ;
    rdfs:label "priceQuoteType" ;
    rdfs:range common_domain_model:QuotationSideEnum ;
    skos:closeMatch fpml_5_10:Commodity.priceQuoteType ;
    skos:definition "Describes the required quote type of the underlying price that will be observed. Example values include 'Bid, 'Ask', 'Settlement' (for a futures contract) and 'WeightedAverage' (for some published prices and indices)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:priceReturnTerms a owl:ObjectProperty ;
    rdfs:label "priceReturnTerms" ;
    rdfs:range common_domain_model:PriceReturnTerms ;
    skos:definition "Return terms based upon the underlier's observed price." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:priceSource a owl:ObjectProperty ;
    rdfs:label "priceSource" ;
    rdfs:range common_domain_model:PriceSource ;
    skos:closeMatch fpml_5_10:CommodityProductDefinition.priceSource ;
    skos:definition "Specifies a publication that provides the commodity price, including, where applicable the details of where in the publication the price is published.  Applicable when the commodity reference price is not a futures contract" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:priceSourceDisruptionIsApplicable a owl:DatatypeProperty ;
    rdfs:label "priceSourceDisruptionIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:priceSourceTime a owl:DatatypeProperty ;
    rdfs:label "priceSourceTime" ;
    rdfs:range xsd:time ;
    skos:definition "Specifies the time at which the price should be observed." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:priceSubType a owl:ObjectProperty ;
    rdfs:label "priceSubType" ;
    rdfs:range common_domain_model:PriceSubTypeEnum ;
    skos:definition "Allows further classification of the chosen price type." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:pricingDates a owl:ObjectProperty ;
    rdfs:label "pricingDates" ;
    rdfs:range common_domain_model:PricingDates ;
    skos:closeMatch fpml_5_10:CommodityPayout.pricingDates ;
    skos:definition "Specifies specific dates or parametric rules for the dates on which the price will be determined." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:pricingMethodElection a owl:ObjectProperty ;
    rdfs:label "pricingMethodElection" ;
    rdfs:range common_domain_model:PriceReturnTerms ;
    skos:definition "Per Part 1 Section 5, 'Pricing', of the 2018 ISDA CDM Equity Confirmation, Para 5.1." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:pricingTime a owl:ObjectProperty ;
    rdfs:label "pricingTime" ;
    rdfs:range common_domain_model:TimeZone ;
    skos:definition "The regional exchange close time for the underlying contract,including time zone, at which the trades should be priced. This provides an indication for which regional snapshot should be used for pricing primarily for Global markets where there are multiple regional close times." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:primaryAssetClass a owl:ObjectProperty ;
    rdfs:label "primaryAssetClass" ;
    rdfs:range common_domain_model:AssetClassEnum ;
    skos:definition "Classifies the most important risk class of the trade." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:primaryFxSpotRateSource a owl:ObjectProperty ;
    rdfs:label "primaryFxSpotRateSource" ;
    rdfs:range common_domain_model:InformationSource ;
    skos:definition "Specifies the primary source from which a rate should be observed." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:primaryObligor a owl:ObjectProperty ;
    rdfs:label "primaryObligor" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "The entity primarily responsible for repaying debt to a creditor as a result of borrowing or issuing bonds. ISDA 2003 Term: Primary Obligor." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:primaryObligorReference a owl:ObjectProperty ;
    rdfs:label "primaryObligorReference" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "A pointer style reference to a reference entity defined elsewhere in the document. Used when the reference entity is the primary obligor." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_reference true .

common_domain_model:primarySource a owl:ObjectProperty ;
    rdfs:label "primarySource" ;
    rdfs:range common_domain_model:InformationSource ;
    skos:definition "The primary source for where the rate observation will occur. Will typically be either a page or a reference bank published rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:primitiveInstruction a owl:ObjectProperty ;
    rdfs:label "primitiveInstruction" ;
    rdfs:range common_domain_model:PrimitiveInstruction ;
    skos:definition "Specifies the primitive instructions that will be used to call primitive event functions." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:principal a owl:ObjectProperty ;
    rdfs:label "principal" ;
    rdfs:range common_domain_model:DebtPrincipalEnum ;
    skos:definition "Specifies the general rule for repayment of principal." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:principalAmount a owl:ObjectProperty ;
    rdfs:label "principalAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "When known at the time the transaction is made, the cash amount to be paid." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:principalPayment a owl:ObjectProperty ;
    rdfs:label "principalPayment" ;
    rdfs:range common_domain_model:PrincipalPayments ;
    skos:definition "The specification of the principal exchange. Optional as only applicable in the case of cross-currency or zero-coupon swaps with a final payment." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:principalPaymentDate a owl:ObjectProperty ;
    rdfs:label "principalPaymentDate" ;
    rdfs:range common_domain_model:AdjustableDate ;
    skos:definition "The date where the PrincipalPayment shall be settled." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:principalPaymentSchedule a owl:ObjectProperty ;
    rdfs:label "principalPaymentSchedule" ;
    rdfs:range common_domain_model:PrincipalPaymentSchedule ;
    skos:definition "Describe dates schedules for Principal Exchanges and related role of the parties when known." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:principalShortfallReimbursement a owl:DatatypeProperty ;
    rdfs:label "principalShortfallReimbursement" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalFixedPayments.principalShortfallReimbursement ;
    skos:definition "An additional Fixed Payment Event. Corresponds to the payment by or on behalf of the Issuer of an actual principal amount in respect to the reference obligation that is greater than the expected principal amount. ISDA 2003 Term: Principal Shortfall Reimbursement." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:processedRate a owl:DatatypeProperty ;
    rdfs:label "processedRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The value of the rate after processing." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:processingDetails a owl:ObjectProperty ;
    rdfs:label "processingDetails" ;
    rdfs:range common_domain_model:FloatingRateProcessingDetails ;
    skos:definition "Details fo the floating rate treatment after the rate is observed or calculated.  This will include details of things like multipliers, spreads, caps and floors, and the raw and treated rates." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:processingParameters a owl:ObjectProperty ;
    rdfs:label "processingParameters" ;
    rdfs:range common_domain_model:FloatingRateProcessingParameters ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:propertyType a owl:ObjectProperty ;
    rdfs:label "propertyType" ;
    rdfs:range common_domain_model:PropertyTypeEnum ;
    skos:definition "Specifies the type of property when the security is linked to a property asset." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:proposedEvent a owl:ObjectProperty ;
    rdfs:label "proposedEvent" ;
    rdfs:range common_domain_model:EventInstruction ;
    skos:definition "The proposed event for a workflow step." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:protectionTermsReference a owl:ObjectProperty ;
    rdfs:label "protectionTermsReference" ;
    rdfs:range common_domain_model:ProtectionTerms ;
    skos:definition "Reference to the documentation terms applicable to this item." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_reference true .

common_domain_model:provider a owl:ObjectProperty ;
    rdfs:label "provider" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "The organisation that creates or maintains the Index." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:prtry a owl:DatatypeProperty ;
    rdfs:label "prtry" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Prtry> .

common_domain_model:publicationCalendar a owl:DatatypeProperty ;
    rdfs:label "publicationCalendar" ;
    rdfs:range xsd:string ;
    skos:definition "Publication Calendar (e.g. EUR-ICESWAP)" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:publisher a owl:ObjectProperty ;
    rdfs:label "publisher" ;
    rdfs:range common_domain_model:LegalAgreementPublisherEnum ;
    skos:definition "The legal agreement publisher, e.g. ISDA." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/AM_1_0#publisher> .

common_domain_model:purchaserSecurity a owl:ObjectProperty ;
    rdfs:label "purchaserSecurity" ;
    rdfs:range common_domain_model:Security ;
    skos:definition "Defines the underlier for the Purchaser Company involved in Merger corporate action." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:purchaserSecurityPrice a owl:ObjectProperty ;
    rdfs:label "purchaserSecurityPrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "The price observation that relates to underlier for the Purchaser Company." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:qty a owl:ObjectProperty ;
    rdfs:label "qty" ;
    rdfs:range common_domain_model:Qty ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Qty> .

common_domain_model:qualifyingParticipationSeller a owl:DatatypeProperty ;
    rdfs:label "qualifyingParticipationSeller" ;
    rdfs:range xsd:string ;
    skos:definition "If Direct Loan Participation is specified as a deliverable obligation characteristic, this specifies any requirements for the Qualifying Participation Seller. The requirements may be listed free-form. ISDA 2003 Term: Qualifying Participation Seller." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:quantityChange a owl:ObjectProperty ;
    rdfs:label "quantityChange" ;
    rdfs:range common_domain_model:QuantityChangeInstruction ;
    skos:definition "Specifies instructions describing an quantity change primitive event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:quantityMultiplier a owl:ObjectProperty ;
    rdfs:label "quantityMultiplier" ;
    rdfs:range common_domain_model:QuantityMultiplier ;
    skos:definition "Quantity multiplier is specified on top of a reference quantity and is used as a multiplying factor when resolving the quantity. A quantity multiplier can only exist when the resolvable quantity specifies a reference quantity." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:quantityReference a owl:ObjectProperty ;
    rdfs:label "quantityReference" ;
    rdfs:range common_domain_model:ResolvablePriceQuantity ;
    skos:definition "Reference quantity when resolvable quantity is defined as relative to another (resolvable) quantity. A resolvable quantity needs to contain either an absolute quantity or a reference to another (resolvable) quantity. This requirement is captured by a choice rule on the class." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    common_domain_model:metadata_reference true .

common_domain_model:quantitySchedule a owl:ObjectProperty ;
    rdfs:label "quantitySchedule" ;
    rdfs:range common_domain_model:NonNegativeQuantitySchedule ;
    skos:definition "A payout's quantity specified as a schedule, which may also contain a single value if that quantity is constant. There can only be a single quantity schedule applicable to a payout: e.g. the notional for an interest rate leg. The quantity must be specified outside of the payout in a PriceQuantity object and only referenced inside the payout using an address." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:quanto a owl:ObjectProperty ;
    rdfs:label "quanto" ;
    rdfs:range common_domain_model:Quanto ;
    skos:definition "If 'Quanto' is specified as the Settlement Type in the relevant Transaction Supplement, an amount, as determined by the Calculation Agent in accordance with the Section 8.2 of the Equity Definitions." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:quotationAmount a owl:ObjectProperty ;
    rdfs:label "quotationAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "In the determination of a cash settlement amount, if weighted average quotations are to be obtained, the quotation amount specifies an upper limit to the outstanding principal balance of the reference obligation for which the quote should be obtained. If not specified, the ISDA definitions provide for a fallback amount equal to the floating rate payer calculation amount. ISDA 2003 Term: Quotation Amount." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:quotationMethod a owl:ObjectProperty ;
    rdfs:label "quotationMethod" ;
    rdfs:range common_domain_model:QuotationRateTypeEnum ;
    skos:definition "The type of price quotations to be requested from dealers when determining the market value of the reference obligation for purposes of cash settlement, or which rate quote is to be observed for a fixing. For example, Bid, Offer, Mid-market or Exercising Party Pays. ISDA 2003 Term: Quotation Method. The meaning of Exercising Party Pays is defined in the 2000 ISDA Definitions, Section 17.2. Certain Definitions Relating to Cash Settlement, paragraph (j)." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:quotationStyle a owl:ObjectProperty ;
    rdfs:label "quotationStyle" ;
    rdfs:range common_domain_model:QuotationStyleEnum ;
    skos:definition "An optional element that contains the up-front points expressed as a percentage of the notional. An initialPoints value of 5% would be represented as 0.05. The initialPoints element is an alternative to marketFixedRate in quoting the traded level of a trade. When initialPoints is used, the traded level is the sum of fixedRate and initialPoints. The initialPoints is one of the items that are factored into the initialPayment calculation and is payable by the Buyer to the Seller. Note that initialPoints and marketFixedRate may both be present in the same document when both implied values are desired." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:quoteBasis a owl:ObjectProperty ;
    rdfs:label "quoteBasis" ;
    rdfs:range common_domain_model:QuoteBasisEnum ;
    skos:definition "The method by which the exchange rate is quoted." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:rate a owl:DatatypeProperty ;
    rdfs:label "rate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The rate of exchange between the two currencies of the leg of a deal. Must be specified with a quote basis." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:rateCutOffDaysOffset a owl:ObjectProperty ;
    rdfs:label "rateCutOffDaysOffset" ;
    rdfs:range common_domain_model:Offset ;
    skos:definition "Specifies the number of business days before the period end date when the rate cut-off date is assumed to apply. The financial business centers associated with determining the rate cut-off date are those specified in the reset dates adjustments. The rate cut-off number of days must be a negative integer (a value of zero would imply no rate cut off applies in which case the rateCutOffDaysOffset element should not be included). The relevant rate for each reset date in the period from, and including, a rate cut-off date to, but excluding, the next applicable period end date (or, in the case of the last calculation period, the termination date) will (solely for purposes of calculating the floating amount payable on the next applicable payment date) be deemed to be the relevant rate in effect on that rate cut-off date. For example, if rate cut-off days for a daily averaging deal is -2 business days, then the refix rate applied on (period end date - 2 days) will also be applied as the reset on (period end date - 1 day), i.e. the actual number of reset dates remains the same but from the rate cut-off date until the period end date, the same refix rate is applied. Note that in the case of several calculation periods contributing to a single payment, the rate cut-off is assumed only to apply to the final calculation period contributing to that payment. The day type associated with the offset must imply a business days offset." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:rateOption a owl:ObjectProperty ;
    rdfs:label "rateOption" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:FloatingRateIndex common_domain_model:InflationIndex ) ] common_domain_model:InterestRateIndex ) ] ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:rateReference a owl:ObjectProperty ;
    rdfs:label "rateReference" ;
    rdfs:range common_domain_model:RateObservation ;
    skos:definition "A pointer style reference to a floating rate component defined as part of a stub calculation period amount component. It is only required when it is necessary to distinguish two rate observations for the same fixing date which could occur when linear interpolation of two different rates occurs for a stub calculation period." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_reference true .

common_domain_model:rateSchedule a owl:ObjectProperty ;
    rdfs:label "rateSchedule" ;
    rdfs:range common_domain_model:RateSchedule ;
    skos:definition "The fixed rate or fixed rate schedule expressed as explicit fixed rates and dates. In the case of a schedule, the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:rateSource a owl:ObjectProperty ;
    rdfs:label "rateSource" ;
    rdfs:range common_domain_model:FloatingRateIndexEnum ;
    skos:definition "The rate source in the case of a variable cap." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:rateSpecification a owl:ObjectProperty ;
    rdfs:label "rateSpecification" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:FixedRateSpecification common_domain_model:FloatingRateSpecification common_domain_model:InflationRateSpecification ) ] common_domain_model:RateSpecification ) ] ;
    skos:definition "The specification of the rate value(s) applicable to the contract using either a floating rate calculation, a single fixed rate, a fixed rate schedule, or an inflation rate calculation." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:ratingPriorityResolution a owl:ObjectProperty ;
    rdfs:label "ratingPriorityResolution" ;
    rdfs:range common_domain_model:RatingPriorityResolutionEnum ;
    skos:closeMatch fpml_5_10:CollateralCriteriaBase.ratingPriorityResolution ;
    skos:definition "Denotes which Criteria has priority if more than one agency rating applies." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:ratingsXExposure a owl:ObjectProperty ;
    rdfs:label "ratingsXExposure" ;
    rdfs:range common_domain_model:LegacyIndependentAmountRatingsXExposure ;
    skos:definition "Indicates the Independent Amount is determined using both credit rating and exposure metrics." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:rawRate a owl:DatatypeProperty ;
    rdfs:label "rawRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The raw or untreated rate, prior to any of the rate treatments." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:realisedVarianceMethod a owl:ObjectProperty ;
    rdfs:label "realisedVarianceMethod" ;
    rdfs:range common_domain_model:RealisedVarianceMethodEnum ;
    skos:closeMatch fpml_5_10:BoundedVariance.realisedVarianceMethod ;
    skos:definition "The contract specifies which price must satisfy the boundary condition." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:recalculationOfValue a owl:ObjectProperty ;
    rdfs:label "recalculationOfValue" ;
    rdfs:range common_domain_model:RecalculationOfValue ;
    skos:definition "The elections to specify terms for recalculation of the market value of posted collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:recalculationOfValueElection a owl:ObjectProperty ;
    rdfs:label "recalculationOfValueElection" ;
    rdfs:range common_domain_model:RecalculationOfValueElectionEnum ;
    skos:definition "The procedure for Recalculation of Value." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:recalculationOfValueTerms a owl:DatatypeProperty ;
    rdfs:label "recalculationOfValueTerms" ;
    rdfs:range xsd:string ;
    skos:definition "Additional Recalculation of Value terms when specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:recallProvision a owl:ObjectProperty ;
    rdfs:label "recallProvision" ;
    rdfs:range common_domain_model:RecallProvision ;
    skos:definition "A provision defining criteria controlling the ability for a lender to recall securities it has lent out." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:receiver a owl:ObjectProperty ;
    rdfs:label "receiver" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "Specifies the party that receives the payments corresponding to this structure.  The party is one of the two counterparties to the transaction." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ERCCBestPractice#Buyer>,
        <https://www.icmagroup.org/market-practice-and-regulatory-policy/GMRA#Buyer> .

common_domain_model:receiverAccountReference a owl:ObjectProperty ;
    rdfs:label "receiverAccountReference" ;
    rdfs:range common_domain_model:Account ;
    skos:definition "A reference to the account that receives the payments corresponding to this structure." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:receiverPartyReference a owl:ObjectProperty ;
    rdfs:label "receiverPartyReference" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "The party that receives the payments corresponding to this structure." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:recordDate a owl:DatatypeProperty ;
    rdfs:label "recordDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the account phyical balance and related underlier ownership is recorded by the custodian." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:recordTransfer a owl:ObjectProperty ;
    rdfs:label "recordTransfer" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:ScheduledTransfer common_domain_model:UnscheduledTransfer ) ] common_domain_model:Transfer ) ] ;
    skos:closeMatch fpml_5_10:BillingRecord.recordTransfer ;
    skos:definition "The settlement terms for the billing record" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:recoveryPercent a owl:DatatypeProperty ;
    rdfs:label "recoveryPercent" ;
    rdfs:range xsd:decimal ;
    skos:definition "The percentage of the original value of the asset affected by the credit event that can be recovered." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:redemption a owl:ObjectProperty ;
    rdfs:label "redemption" ;
    rdfs:range common_domain_model:DebtRedemption ;
    skos:definition "Specifies the general rule for redemption of a debt security." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:refRate a owl:ObjectProperty ;
    rdfs:label "refRate" ;
    rdfs:range common_domain_model:RefRate ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#RefRate> .

common_domain_model:referenceBankId a owl:DatatypeProperty ;
    rdfs:label "referenceBankId" ;
    rdfs:range xsd:string ;
    skos:definition "An institution (party) identifier, e.g. a bank identifier code (BIC). FpML specifies a referenceBankIdScheme." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_scheme true .

common_domain_model:referenceBankName a owl:DatatypeProperty ;
    rdfs:label "referenceBankName" ;
    rdfs:range xsd:string ;
    skos:definition "The name of the institution (party). A free format string. FpML does not define usage rules for the element." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:referenceBanks a owl:ObjectProperty ;
    rdfs:label "referenceBanks" ;
    rdfs:range common_domain_model:ReferenceBanks ;
    skos:definition "A container for a set of reference institutions that may be called upon to provide rate quotations as part of the method to determine the applicable cash settlement amount. If institutions are not specified, it is assumed that reference institutions will be agreed between the parties on the exercise date, or in the case of swap transaction to which mandatory early termination is applicable, the cash settlement valuation date." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:referenceCurrency a owl:DatatypeProperty ;
    rdfs:label "referenceCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the reference currency of the trade." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    common_domain_model:metadata_scheme true .

common_domain_model:referenceFramework a owl:ObjectProperty ;
    rdfs:label "referenceFramework" ;
    rdfs:range common_domain_model:CommodityReferenceFramework ;
    skos:closeMatch fpml_5_10:CommodityProductDefinition.referenceFramework ;
    skos:definition "Specifies the type of commodity." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:referencePair a owl:ObjectProperty ;
    rdfs:label "referencePair" ;
    rdfs:range common_domain_model:ReferencePair ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:referencePolicy a owl:DatatypeProperty ;
    rdfs:label "referencePolicy" ;
    rdfs:range xsd:boolean ;
    skos:definition "Applicable to the transactions on mortgage-backed security, which can make use of a reference policy. Presence of the element with value set to 'true' indicates that the reference policy is applicable; absence implies that it is not." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:referencePool a owl:ObjectProperty ;
    rdfs:label "referencePool" ;
    rdfs:range common_domain_model:ReferencePool ;
    skos:closeMatch fpml_5_10:BasketReferenceInformation.referencePool ;
    skos:definition "This element contains all the reference pool items to define the reference entity and reference obligation(s) in the basket." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:referencePrice a owl:ObjectProperty ;
    rdfs:label "referencePrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "Used to determine (a) for physically settled trades, the Physical Settlement Amount, which equals the Floating Rate Payer Calculation Amount times the Reference Price and (b) for cash settled trades, the Cash Settlement Amount, which equals the greater of (i) the difference between the Reference Price and the Final Price and (ii) zero. ISDA 2003 Term: Reference Price." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:referenceSwapCurve a owl:ObjectProperty ;
    rdfs:label "referenceSwapCurve" ;
    rdfs:range common_domain_model:ReferenceSwapCurve ;
    skos:definition "Defines the strike of an option when expressed by reference to a swap curve (Typically the case for a convertible bond option)." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:regIMRole a owl:ObjectProperty ;
    rdfs:label "regIMRole" ;
    rdfs:range common_domain_model:RegIMRoleEnum ;
    skos:definition "Indicates the role of the party in an regulatory initial margin call instruction (i.e Pledgor party or Secured party)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:regMarginType a owl:ObjectProperty ;
    rdfs:label "regMarginType" ;
    rdfs:range common_domain_model:RegMarginTypeEnum ;
    skos:definition "Identifies margin type and if related regulatory mandate" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:regulatoryComplianceRepresentation a owl:DatatypeProperty ;
    rdfs:label "regulatoryComplianceRepresentation" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AdditionalRepresentations.regulatoryComplianceRepresentation ;
    skos:definition "The qualification of whether Additional Information related to Regulatory Compliance and Concentration Limits is applicable or not." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:rejected a owl:DatatypeProperty ;
    rdfs:label "rejected" ;
    rdfs:range xsd:boolean ;
    skos:definition "Flags this step as rejected." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:rejectedReason a owl:DatatypeProperty ;
    rdfs:label "rejectedReason" ;
    rdfs:range xsd:string ;
    skos:definition "Optional reason for rejecting the workflow step" ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:relatedExchange a owl:ObjectProperty ;
    rdfs:label "relatedExchange" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:closeMatch fpml_5_10:AssetBase.relatedExchange ;
    skos:definition "Provides the related Exchanges, if applicable." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:relationshipWithControlAgreement a owl:DatatypeProperty ;
    rdfs:label "relationshipWithControlAgreement" ;
    rdfs:range xsd:boolean ;
    skos:definition "Unless specified as inapplicable the parties recognise that the Control Agreement is a means by which the parties can perform their obligations." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:relativeDateAdjustments a owl:ObjectProperty ;
    rdfs:label "relativeDateAdjustments" ;
    rdfs:range common_domain_model:BusinessDayAdjustments ;
    skos:definition "The business day convention and financial business centers used for adjusting the relative date if it would otherwise fall on a day that is not a business date in the specified business centers." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:relativeDateOffset a owl:ObjectProperty ;
    rdfs:label "relativeDateOffset" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:relativeTime a owl:ObjectProperty ;
    rdfs:label "relativeTime" ;
    rdfs:range common_domain_model:RelativeTime ;
    skos:definition "A time value calculated relative to another reference time." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:releaseDate a owl:ObjectProperty ;
    rdfs:label "releaseDate" ;
    rdfs:range common_domain_model:CustomisableOffset ;
    skos:definition "Election to specify the number of days prior to the termination of the Control Agreement /Collateral Management Event for the purpose of qualifying the CE/CME End Date, in the case where advance notice is given." ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016",
        "ISDA CSA_IM_NewYork_2016",
        "ISDA CSD_IM_English_2016" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:relevantJurisdiction a owl:DatatypeProperty ;
    rdfs:label "relevantJurisdiction" ;
    rdfs:range xsd:string ;
    skos:definition "The ISO 3166 standard code for the country within which the postal address is located." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:relevantUnderlyingDate a owl:ObjectProperty ;
    rdfs:label "relevantUnderlyingDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDates ;
    skos:definition "The effective date on the underlying product if the option is exercised.  For example, for a swaption it is the swap effective date, for an option on an FX spot or forward it is the value date for settlement, and in an extendible/cancelable provision it is the swap termination date, which is the date on which the termination is effective.'" ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:relevantUnderlyingDateReference a owl:ObjectProperty ;
    rdfs:label "relevantUnderlyingDateReference" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDates ;
    skos:definition "Reference to the unadjusted cancellation effective dates." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    common_domain_model:metadata_reference true .

common_domain_model:replace a owl:DatatypeProperty ;
    rdfs:label "replace" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies whether the previous valuation tracks in the valuation history are removed (True) or kept (False)." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:representations a owl:ObjectProperty ;
    rdfs:label "representations" ;
    rdfs:range common_domain_model:Representations ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:repudiationMoratorium a owl:DatatypeProperty ;
    rdfs:label "repudiationMoratorium" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. The reference entity, or a governmental authority, either refuses to recognise or challenges the validity of one or more obligations of the reference entity, or imposes a moratorium thereby postponing payments on one or more of the obligations of the reference entity. Subject to the default requirement amount. ISDA 2003 Term: Repudiation/Moratorium." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:resetDates a owl:ObjectProperty ;
    rdfs:label "resetDates" ;
    rdfs:range common_domain_model:ResetDates ;
    skos:definition "The reset dates schedule, i.e. the dates on which the new observed index value is applied for each period and the interest rate hence begins to accrue." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:resetDatesAdjustments a owl:ObjectProperty ;
    rdfs:label "resetDatesAdjustments" ;
    rdfs:range common_domain_model:BusinessDayAdjustments ;
    skos:definition "The definition of the business day convention and financial business centers used for adjusting the reset date if it would otherwise fall on a day that is not a business day in the specified business center." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:resetFrequency a owl:ObjectProperty ;
    rdfs:label "resetFrequency" ;
    rdfs:range common_domain_model:ResetFrequency ;
    skos:definition "The frequency at which the reset dates occur. In the case of a weekly reset frequency, also specifies the day of the week that the reset occurs. If the reset frequency is greater than the calculation period frequency then this implies that more than one reset is established for each calculation period and some form of rate averaging is applicable." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:resetRelativeTo a owl:ObjectProperty ;
    rdfs:label "resetRelativeTo" ;
    rdfs:range common_domain_model:ResetRelativeToEnum ;
    skos:definition "Specifies whether the reset dates are determined with respect to each adjusted calculation period start date or adjusted calculation period end date. If the reset frequency is specified as daily this element must not be included." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:resetValue a owl:ObjectProperty ;
    rdfs:label "resetValue" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "Specifies the reset or fixing value. The fixing value could be a cash price, interest rate, or other value." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:resolutionTime a owl:ObjectProperty ;
    rdfs:label "resolutionTime" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:definition "The time by which the dispute needs to be resolved, failure of which would trigger a recalculation alongside a process that is specified as part of the agreement." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"3 General Principles\" clause \"(g)(i)\" name \"Resolution Time\"",
        "ISDA CSA_VM_2016 paragraph \"13\" clause \"(g)(i)\" name \"Resolution Time\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:resolvedQuantity a owl:ObjectProperty ;
    rdfs:label "resolvedQuantity" ;
    rdfs:range common_domain_model:Quantity ;
    skos:definition "A product's quantity as a single, non-negative amount.  When specified as part of a product definition, this quantity attribute would not be set.  Instead it is specified on the quantity notation along with an asset identifier matching this payout's asset identifier.  This allows the quantity to be resolved for a payout leg, which can then be specified here for convenience during data processing.  There needs to be at least one resolvable quantity across payout legs of a product to define an anchor that other payout quantities can refer to.  This attribute is ignored when mapping existing FpML messages." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:resourceId a owl:DatatypeProperty ;
    rdfs:label "resourceId" ;
    rdfs:range xsd:string ;
    skos:definition "The unique identifier of the resource within the event. FpML specifies this element of type resourceIdScheme but with no specified value." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:resourceType a owl:ObjectProperty ;
    rdfs:label "resourceType" ;
    rdfs:range common_domain_model:ResourceTypeEnum ;
    skos:definition "A description of the type of the resource, e.g. a confirmation." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:restrictTo a owl:ObjectProperty ;
    rdfs:label "restrictTo" ;
    rdfs:range common_domain_model:CollateralMarginTypeEnum ;
    skos:closeMatch fpml_5_10:CollateralCriteriaBase.restrictTo ;
    skos:definition "Restrict the criteria to only apply to a specific type of margin, ie IM or VM." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:restructuring a owl:ObjectProperty ;
    rdfs:label "restructuring" ;
    rdfs:range common_domain_model:Restructuring ;
    skos:definition "A credit event. A restructuring is an event that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2003 Term: Restructuring." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:restructuringType a owl:ObjectProperty ;
    rdfs:label "restructuringType" ;
    rdfs:range common_domain_model:RestructuringEnum ;
    skos:definition "Specifies the type of restructuring that is applicable." ;
    skos:inScheme common_domain_model:cdm_observable_event ;
    common_domain_model:metadata_scheme true .

common_domain_model:retrospectiveEffect a owl:ObjectProperty ;
    rdfs:label "retrospectiveEffect" ;
    rdfs:range common_domain_model:RetrospectiveEffect ;
    skos:definition "Specifies the retrospective effect exception to the regulatory regime clause of Initial Margin documents as either a normalized value specified as part of an enumeration or a customized value specified of type string." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13\" clause \"(b)(i)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:returnDirection a owl:ObjectProperty ;
    rdfs:label "returnDirection" ;
    rdfs:range common_domain_model:RoundingModeEnum ;
    skos:closeMatch fpml_5_10:CollateralRounding.returnDirection ;
    skos:definition "The rounding rule applicable to the Return Amount (which can be (i) up to nearest; (ii) down to nearest)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:returnTerms a owl:ObjectProperty ;
    rdfs:label "returnTerms" ;
    rdfs:range common_domain_model:ReturnTerms ;
    skos:definition "Specifies the type of return of a performance payout." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:returnType a owl:ObjectProperty ;
    rdfs:label "returnType" ;
    rdfs:range common_domain_model:ReturnTypeEnum ;
    skos:definition "The type of return associated with the equity swap." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:rightsSubscriptionPrice a owl:ObjectProperty ;
    rdfs:label "rightsSubscriptionPrice" ;
    rdfs:range common_domain_model:Price ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.rightsSubscriptionPrice ;
    skos:definition "The price to pay per each right." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:rollConvention a owl:ObjectProperty ;
    rdfs:label "rollConvention" ;
    rdfs:range common_domain_model:RollConventionEnum ;
    skos:closeMatch fpml_5_10:CalculationPeriodFrequency.rollConvention ;
    skos:definition "The roll convention specifies the period term as part of a periodic schedule, i.e. the calculation period end date within the regular part of the calculation period. The value could be a rule, e.g. IMM Settlement Dates, which is the 3rd Wednesday of the month, or it could be a specific day of the month, such as the first day of the applicable month. It is used in conjunction with a frequency and the regular period start date of a calculation period." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:rollFeature a owl:ObjectProperty ;
    rdfs:label "rollFeature" ;
    rdfs:range common_domain_model:RollFeature ;
    skos:closeMatch fpml_5_10:CommodityPriceReturnTerms.rollFeature ;
    skos:definition "Used in conjunction with an exchange-based pricing source. Identifies a way in which the futures contracts referenced will roll between periods. " ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:rollSourceCalendar a owl:ObjectProperty ;
    rdfs:label "rollSourceCalendar" ;
    rdfs:range common_domain_model:RollSourceCalendarEnum ;
    skos:definition "Used in conjunction with an exchange-based pricing source. Identifies a date source calendar from which the pricing dates and thus roll to the next contract will be based off (e.g. pricing is based on the NYMEX WTI First Nearby Futures Contract, if Future is chosen, the pricing will roll to the next futures contract on expiration, if ListedOption is chosen, the pricing will roll to the next futures contract on the Option expiration date which is three business days before the expiration of the NYMEX WTI futures contract.) Omitting this element will result in the default behavior expected with the pricing source described within the commodity element." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:roundToUnit a owl:ObjectProperty ;
    rdfs:label "roundToUnit" ;
    rdfs:range common_domain_model:TimeUnitEnum ;
    skos:definition "The time unit to which the value should be rounded (e.g., minute, hour, day)." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:roundingFrequency a owl:ObjectProperty ;
    rdfs:label "roundingFrequency" ;
    rdfs:range common_domain_model:RoundingFrequencyEnum ;
    skos:closeMatch fpml_5_10:CollateralInterestCalculationParameters.roundingFrequency ;
    skos:definition "Specifies when/how often is rounding applied?" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:rskRdcgTx a owl:DatatypeProperty ;
    rdfs:label "rskRdcgTx" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:AddtlAttrbts.rskRdcgTx ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#RskRdcgTx> .

common_domain_model:safekeepingPeriodExpiry a owl:ObjectProperty ;
    rdfs:label "safekeepingPeriodExpiry" ;
    rdfs:range common_domain_model:CustomisableOffset ;
    skos:definition "The parties' election to specify the number of days prior to the end of the safekeeping period (Clearstream CTA) purpose of qualifying the CE/CME End Date, in the case where advance notice is given." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:scale a owl:DatatypeProperty ;
    rdfs:label "scale" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the credit rating scale, with a typical distinction between short term, long term. FpML doesn't specify a default scheme, which is hence not specified as an enumeration as part of the CDM." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:scheduleBounds a owl:ObjectProperty ;
    rdfs:label "scheduleBounds" ;
    rdfs:range common_domain_model:DateRange ;
    skos:definition "The first and last dates of a schedule. This can be used to restrict the range of values in a reference series of dates." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:scheduleGridIMExposure a owl:ObjectProperty ;
    rdfs:label "scheduleGridIMExposure" ;
    rdfs:range common_domain_model:Exposure ;
    skos:definition "Represents Initial Margin (IM) exposure derived from schedule or Grid calculation." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:schmeNm a owl:ObjectProperty ;
    rdfs:label "schmeNm" ;
    rdfs:range common_domain_model:SchmeNm ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#SchmeNm> .

common_domain_model:scope a owl:ObjectProperty ;
    rdfs:label "scope" ;
    rdfs:range common_domain_model:ValuationScopeEnum ;
    skos:definition " Defines the scope of the valuation, what it applies to e.g. the collateral or the trade" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:sctiesFincgTxInd a owl:DatatypeProperty ;
    rdfs:label "sctiesFincgTxInd" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:AddtlAttrbts.sctiesFincgTxInd ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#SctiesFincgTxInd> .

common_domain_model:secondaryFxSpotRateSource a owl:ObjectProperty ;
    rdfs:label "secondaryFxSpotRateSource" ;
    rdfs:range common_domain_model:InformationSource ;
    skos:definition "Specifies an alternative, or secondary, source from which a rate should be observed." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:secondarySource a owl:ObjectProperty ;
    rdfs:label "secondarySource" ;
    rdfs:range common_domain_model:InformationSource ;
    skos:definition "An alternative, or secondary, source for where the rate observation will occur. Will typically be either a page or a reference bank published rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:secured a owl:ObjectProperty ;
    rdfs:label "secured" ;
    rdfs:range common_domain_model:SecuredDebt ;
    skos:definition "Specifies the type of secured debt." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:securedList a owl:DatatypeProperty ;
    rdfs:label "securedList" ;
    rdfs:range xsd:boolean ;
    skos:definition "With respect to any day, the list of Syndicated Secured Obligations of the Designated Priority of the Reference Entity published by Markit Group Limited or any successor thereto appointed by the Specified Dealers (the 'Secured List Publisher') on or most recently before such day, which list is currently available at [http://www.markit.com]. ISDA 2003 Term: Relevant Secured List." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:securities a owl:ObjectProperty ;
    rdfs:label "securities" ;
    rdfs:range common_domain_model:ValueSecuritiesEnum ;
    skos:definition "Details of how securities collateral is valued when resolving disputes." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:securitiesCollateral a owl:ObjectProperty ;
    rdfs:label "securitiesCollateral" ;
    rdfs:range common_domain_model:ValueSecuritiesEnum ;
    skos:closeMatch fpml_5_10:CollateralValueMethod.securitiesCollateral ;
    skos:definition "Details of how securities collateral is valued." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:securititesCollateralTransferSettlementTime a owl:ObjectProperty ;
    rdfs:label "securititesCollateralTransferSettlementTime" ;
    rdfs:range common_domain_model:SecuritiesCTSTimeEnum ;
    skos:definition "Details the day on which collateral is required to be transferred relative to the Notification Time." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:securityAgreementElections a owl:ObjectProperty ;
    rdfs:label "securityAgreementElections" ;
    rdfs:range common_domain_model:SecurityAgreementElections ;
    skos:closeMatch fpml_5_10:Agreement.securityAgreementElections ;
    skos:definition "Elections to specify a Security agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:securityProviderRightsEvent a owl:ObjectProperty ;
    rdfs:label "securityProviderRightsEvent" ;
    rdfs:range common_domain_model:SecurityProviderRightsEvent ;
    skos:definition "The bespoke provisions that might be specified by the parties to the agreement applicable to a Security Provider Rights Event." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:securityTakerRightsEvent a owl:ObjectProperty ;
    rdfs:label "securityTakerRightsEvent" ;
    rdfs:range common_domain_model:SecuredPartyRightsEvent ;
    skos:definition "The bespoke provisions that might be specified by the parties to the agreement applicable to a Security Taker Rights Event." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:segregatedCashAccount a owl:ObjectProperty ;
    rdfs:label "segregatedCashAccount" ;
    rdfs:range common_domain_model:Account ;
    skos:definition "The identification of the segregated cash account for the purpose of holding cash collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:segregatedSecurityAccount a owl:ObjectProperty ;
    rdfs:label "segregatedSecurityAccount" ;
    rdfs:range common_domain_model:Account ;
    skos:definition "The identification of the segregated security account for the purpose of holding security collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sellr a owl:ObjectProperty ;
    rdfs:label "sellr" ;
    rdfs:range common_domain_model:Sellr ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Sellr> .

common_domain_model:sensitivityToCommodity a owl:ObjectProperty ;
    rdfs:label "sensitivityToCommodity" ;
    rdfs:range common_domain_model:SensitivityMethodology ;
    skos:definition "The methodology to compute sensitivities to commodity indices for the purpose of Initial Margin agreements." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sensitivityToETFs a owl:ObjectProperty ;
    rdfs:label "sensitivityToETFs" ;
    rdfs:range common_domain_model:SensitivityMethodology ;
    skos:definition "Represents risk sensitivity calculated with respect to the value of an exchange-traded fund (ETF)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sensitivityToEquity a owl:ObjectProperty ;
    rdfs:label "sensitivityToEquity" ;
    rdfs:range common_domain_model:SensitivityToEquity ;
    skos:definition "The methodology to compute sensitivities to equity indices, funds and ETFs for the purpose of Initial Margin agreements." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sensitivityToFunds a owl:ObjectProperty ;
    rdfs:label "sensitivityToFunds" ;
    rdfs:range common_domain_model:SensitivityMethodology ;
    skos:definition "Represents risk sensitivity calculated with respect to the value of a fund, such as a mutual fund or collective investment vehicle." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sensitivityToIndices a owl:ObjectProperty ;
    rdfs:label "sensitivityToIndices" ;
    rdfs:range common_domain_model:SensitivityMethodology ;
    skos:definition "Represents risk sensitivity calculated with respect to the level of an equity or market index." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sentBy a owl:DatatypeProperty ;
    rdfs:label "sentBy" ;
    rdfs:range xsd:string ;
    skos:definition "The identifier for the originator of a message instance." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    common_domain_model:metadata_scheme true .

common_domain_model:servicingParty a owl:ObjectProperty ;
    rdfs:label "servicingParty" ;
    rdfs:range common_domain_model:Party ;
    skos:closeMatch fpml_5_10:Account.servicingParty ;
    skos:definition "The reference to the legal entity that services the account, i.e. in the books of which the account is held." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_reference true .

common_domain_model:settledEntityMatrix a owl:ObjectProperty ;
    rdfs:label "settledEntityMatrix" ;
    rdfs:range common_domain_model:SettledEntityMatrix ;
    skos:definition "Used to specify the Relevant Settled Entity Matrix when there are settled entities at the time of the trade." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:settlementCentre a owl:ObjectProperty ;
    rdfs:label "settlementCentre" ;
    rdfs:range common_domain_model:SettlementCentreEnum ;
    skos:definition "Optional settlement centre as an enumerated list: Euroclear, Clearstream." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:settlementCurrency a owl:DatatypeProperty ;
    rdfs:label "settlementCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "The settlement currency is to be specified when the Settlement Amount cannot be known in advance. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/GMRA#Contractual_Currency> ;
    common_domain_model:metadata_scheme true .

common_domain_model:settlementProvision a owl:ObjectProperty ;
    rdfs:label "settlementProvision" ;
    rdfs:range common_domain_model:SettlementProvision ;
    skos:definition "Optionally defines the parameters that regulate a settlement." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:settlementRateSource a owl:ObjectProperty ;
    rdfs:label "settlementRateSource" ;
    rdfs:range common_domain_model:FxSettlementRateSource ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:settlementType a owl:ObjectProperty ;
    rdfs:label "settlementType" ;
    rdfs:range common_domain_model:SettlementTypeEnum ;
    skos:definition "Whether the settlement will be cash, physical, by election, ..." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:shapingProvisions a owl:ObjectProperty ;
    rdfs:label "shapingProvisions" ;
    rdfs:range common_domain_model:ShapingProvision ;
    skos:definition "Defines the parameters that are necessary to 'shape' a settlement, i.e. break it down into smaller amounts." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:shareForCombined a owl:ObjectProperty ;
    rdfs:label "shareForCombined" ;
    rdfs:range common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "Shall occur if a Merger Event occurs and the consideration for the relevant Security consists solely of Combined Consideration." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:shareForOther a owl:ObjectProperty ;
    rdfs:label "shareForOther" ;
    rdfs:range common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "Shall occur if a Merger Event occurs and the consideration for the relevant Security consists solely of Other Consideration." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:shareForRightsRatio a owl:DatatypeProperty ;
    rdfs:label "shareForRightsRatio" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.shareForRightsRatio ;
    skos:definition "Multiple value, say 'M/N' where 'M' is the number of rights after the event, and 'N' of shares prior to the event. " ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:shareForShare a owl:ObjectProperty ;
    rdfs:label "shareForShare" ;
    rdfs:range common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "Shall occur if a Merger Event occurs and the consideration for the relevant Security consists solely of Combined Consideration." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:shareForShareRatio a owl:DatatypeProperty ;
    rdfs:label "shareForShareRatio" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.shareForShareRatio ;
    skos:definition "Multiple value, say 'M/N' where 'M' is the number of shares after the event and 'N' is the number of shares prior to the event. " ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:sharePriceDividendAdjustment a owl:DatatypeProperty ;
    rdfs:label "sharePriceDividendAdjustment" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether the price of shares is adjusted for dividends or not." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:shortName a owl:DatatypeProperty ;
    rdfs:label "shortName" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CodeListIdentification.shortName ;
    skos:definition "A short name (without whitespace) for the code list, e.g. businessCenterScheme" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:shortPosition a owl:DatatypeProperty ;
    rdfs:label "shortPosition" ;
    rdfs:range xsd:decimal ;
    skos:definition "Credit limit utilisation attributable to short positions." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:side a owl:ObjectProperty ;
    rdfs:label "side" ;
    rdfs:range common_domain_model:QuotationSideEnum ;
    skos:definition "The side (bid/mid/ask) of the measure." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:simmCalculationCurrency a owl:ObjectProperty ;
    rdfs:label "simmCalculationCurrency" ;
    rdfs:range common_domain_model:SimmCalculationCurrency ;
    skos:definition "The SIMM Calculation Currency, as specified for each of the parties to the CSA Initial Margin." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(ee)(3)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:simmException a owl:ObjectProperty ;
    rdfs:label "simmException" ;
    rdfs:range common_domain_model:SimmException ;
    skos:definition "The election for SIMM exception to the regulatory regime clause." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:simmExceptionApplicable a owl:ObjectProperty ;
    rdfs:label "simmExceptionApplicable" ;
    rdfs:range common_domain_model:SimmExceptionApplicableEnum ;
    skos:definition "The Standard Initial Margin model exception approach applicable when specified by the party according to one of the enumerated values." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:simmIMExposure a owl:ObjectProperty ;
    rdfs:label "simmIMExposure" ;
    rdfs:range common_domain_model:Exposure ;
    skos:definition "Represents Initial Margin (IM) exposure derived from ISDA SIMM calculation." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:simmVersion a owl:ObjectProperty ;
    rdfs:label "simmVersion" ;
    rdfs:range common_domain_model:SimmVersion ;
    skos:definition "The qualification of the ISDA SIMM version that is specified for all Covered Transactions." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(ee)(1)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:singlePostingParty a owl:ObjectProperty ;
    rdfs:label "singlePostingParty" ;
    rdfs:range common_domain_model:SinglePostingParty ;
    skos:definition "Where only a single  party is explicitly designated to post collateral, the party which is specified as the sole poster of collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:singleValuationDate a owl:ObjectProperty ;
    rdfs:label "singleValuationDate" ;
    rdfs:range common_domain_model:SingleValuationDate ;
    skos:definition "Where single valuation date is specified as being applicable for cash settlement, this element specifies the number of business days after satisfaction of all conditions to settlement when such valuation date occurs. ISDA 2003 Term: Single Valuation Date." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:sixtyBusinessDaySettlementCap a owl:DatatypeProperty ;
    rdfs:label "sixtyBusinessDaySettlementCap" ;
    rdfs:range xsd:boolean ;
    skos:definition "If this element is specified and set to 'true', for a transaction documented under the 2003 ISDA Credit Derivatives Definitions, has the effect of incorporating the language set forth below into the confirmation. The section references are to the 2003 ISDA Credit Derivatives Definitions. Notwithstanding Section 1.7 or any provisions of Sections 9.9 or 9.10 to the contrary, but without prejudice to Section 9.3 and (where applicable) Sections 9.4, 9.5 and 9.6, if the Termination Date has not occurred on or prior to the date that is 60 Business Days following the Physical Settlement Date, such 60th Business Day shall be deemed to be the Termination Date with respect to this Transaction except in relation to any portion of the Transaction (an 'Affected Portion') in respect of which: (1) a valid notice of Buy-in Price has been delivered that is effective fewer than three Business Days prior to such 60th Business Day, in which case the Termination Date for that Affected Portion shall be the third Business Day following the date on which such notice is effective; or (2) Buyer has purchased but not Delivered Deliverable Obligations validly specified by Seller pursuant to Section 9.10(b), in which case the Termination Date for that Affected Portion shall be the tenth Business Day following the date on which Seller validly specified such Deliverable Obligations to Buyer." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:sizeInBytes a owl:DatatypeProperty ;
    rdfs:label "sizeInBytes" ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates the size of the resource in bytes. It could be used by the end user to estimate the download time and storage needs." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:sourcePage a owl:DatatypeProperty ;
    rdfs:label "sourcePage" ;
    rdfs:range xsd:string ;
    skos:definition "A specific page for the source for obtaining a market data point. In FpML, this is specified as a scheme, rateSourcePageScheme, for which no coding Scheme or URI is specified." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:sourcePageHeading a owl:DatatypeProperty ;
    rdfs:label "sourcePageHeading" ;
    rdfs:range xsd:string ;
    skos:definition "The heading for the source on a given source page." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:sourceProvider a owl:ObjectProperty ;
    rdfs:label "sourceProvider" ;
    rdfs:range common_domain_model:InformationProviderEnum ;
    skos:definition "An information source for obtaining a market data point. For example Bloomberg, Reuters, Telerate, etc." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:sovereignAgencyRating a owl:ObjectProperty ;
    rdfs:label "sovereignAgencyRating" ;
    rdfs:range common_domain_model:AgencyRatingCriteria ;
    skos:definition "Represents an agency rating based on default risk of the country of the issuer." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:specialDividends a owl:DatatypeProperty ;
    rdfs:label "specialDividends" ;
    rdfs:range xsd:boolean ;
    skos:definition "Specifies the method according to which special dividends are determined." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:specificConsentLanguage a owl:DatatypeProperty ;
    rdfs:label "specificConsentLanguage" ;
    rdfs:range xsd:string ;
    skos:definition "Specific consent language might be specified by the parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:specificDate a owl:ObjectProperty ;
    rdfs:label "specificDate" ;
    rdfs:range common_domain_model:AmendmentEffectiveDateEnum ;
    skos:closeMatch fpml_5_10:AmendmentEffectiveDate.specificDate ;
    skos:definition "The effective date of the Amendment to Termination Currency when specified as relative to another date (e.g. the annex date)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:specificInconvertibility a owl:ObjectProperty ;
    rdfs:label "specificInconvertibility" ;
    rdfs:range common_domain_model:SpecificInconvertibility ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(xii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:specificInconvertibilityIsApplicable a owl:DatatypeProperty ;
    rdfs:label "specificInconvertibilityIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:specificNonTransferability a owl:ObjectProperty ;
    rdfs:label "specificNonTransferability" ;
    rdfs:range common_domain_model:SpecificNonTransferability ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(xiii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:specificNonTransferabilityIsApplicable a owl:DatatypeProperty ;
    rdfs:label "specificNonTransferabilityIsApplicable" ;
    rdfs:range xsd:boolean ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:specification a owl:ObjectProperty ;
    rdfs:label "specification" ;
    rdfs:range common_domain_model:EligibleCollateralSpecification ;
    skos:definition "a copy of the input EligbilityCollateralSpecification that was checked against the query" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:specifiedConditionOrAccessCondition a owl:ObjectProperty ;
    rdfs:label "specifiedConditionOrAccessCondition" ;
    rdfs:range common_domain_model:SpecifiedConditionOrAccessCondition ;
    skos:definition "Specifies the events elected by the parties that are deemed an Access Condition (for Initial Margin CSA) or a Specified Condition (for Variation Margin and Legacy CSA), which, if triggered, may temporarily or permanently suspend rights to rehypothecate, transfer, or substitute collateral." ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(f)(ii)\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(e)(ii)\"",
        "ISDA CSA_NewYork_1994 paragraph \"13\" clause \"(d)\" name \"Conditions Precedent and Secured Partys Rights and Remedies.\"",
        "ISDA CSA_VM_2016 paragraph \"13\" clause \"(e)\" name \"Conditions Precedent and Secured Partys Rights and Remedies.\"",
        "ISDA CSD_English_1995 paragraph \"13\" clause \"(e)\" name \"Conditions Precedent and Secured Partys Rights and Remedies.\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(e)(ii)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:specifiedEntityClause a owl:ObjectProperty ;
    rdfs:label "specifiedEntityClause" ;
    rdfs:range common_domain_model:SpecifiedEntityClauseEnum ;
    skos:definition "The Event of Default or Termination event for which Specified Entities terms are being defined." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:specifiedMethodology a owl:ObjectProperty ;
    rdfs:label "specifiedMethodology" ;
    rdfs:range common_domain_model:SensitivitiesEnum ;
    skos:definition "The methodology according to which sensitivities will be computed, when specified through a normalized election." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:spinOff a owl:ObjectProperty ;
    rdfs:label "spinOff" ;
    rdfs:range common_domain_model:SpinOff ;
    skos:closeMatch fpml_5_10:AdjustmentFactorCalculationTerms.spinOff ;
    skos:definition "Defines the underlier for both the Parent Company and the Child Compagny involved in Spin Off corporate action, as well as the respective price observation for each." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:split a owl:ObjectProperty ;
    rdfs:label "split" ;
    rdfs:range common_domain_model:SplitInstruction ;
    skos:definition "Specifies instructions to split a trade into multiple branches." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:splitTicket a owl:DatatypeProperty ;
    rdfs:label "splitTicket" ;
    rdfs:range xsd:boolean ;
    skos:definition "Typically applicable to the physical settlement of bond and convertible bond options. If present, means that the party required to deliver the bonds will divide those to be delivered as notifying party desires to facilitate delivery obligations." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:spreadAdjustment a owl:DatatypeProperty ;
    rdfs:label "spreadAdjustment" ;
    rdfs:range xsd:decimal ;
    skos:definition "The economic spread applied to the underlying fallback rate to replicate the original risky rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:spreadCalculationMethod a owl:ObjectProperty ;
    rdfs:label "spreadCalculationMethod" ;
    rdfs:range common_domain_model:SpreadCalculationMethodEnum ;
    skos:definition "Method by which spread is calculated. For example on an asset swap: 'ParPar' or 'Proceeds' may be the method indicated." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:spreadExclusiveCalculatedAMount a owl:DatatypeProperty ;
    rdfs:label "spreadExclusiveCalculatedAMount" ;
    rdfs:range xsd:decimal ;
    skos:definition "The amount of the cash flow excluding any spread, for subsequent processing." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:spreadExclusiveRate a owl:DatatypeProperty ;
    rdfs:label "spreadExclusiveRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The value of the processed rate without the spread applied, for subsequent compounding, etc." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate .

common_domain_model:spreadScheduleType a owl:ObjectProperty ;
    rdfs:label "spreadScheduleType" ;
    rdfs:range common_domain_model:SpreadScheduleTypeEnum ;
    skos:definition "An element which purpose is to identify a long or short spread value." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:standardPublicSources a owl:DatatypeProperty ;
    rdfs:label "standardPublicSources" ;
    rdfs:range xsd:boolean ;
    skos:definition "If this element is specified and set to 'true', indicates that ISDA defined Standard Public Sources are applicable." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:standardReferenceObligation a owl:DatatypeProperty ;
    rdfs:label "standardReferenceObligation" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates if the reference obligation is a Standard Reference Obligation. ISDA 2014 Term: Standard Reference Obligation." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:standardSettlementStyle a owl:ObjectProperty ;
    rdfs:label "standardSettlementStyle" ;
    rdfs:range common_domain_model:StandardSettlementStyleEnum ;
    skos:definition "Settlement Style." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:startTime a owl:DatatypeProperty ;
    rdfs:label "startTime" ;
    rdfs:range xsd:time ;
    skos:closeMatch fpml_5_10:AssetDeliveryProfileBlock.startTime ;
    skos:definition "The start time of the delivery interval for each block or shape." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:statedCurrency a owl:DatatypeProperty ;
    rdfs:label "statedCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies a single Termination Currency for the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:statedPartyCurrency a owl:DatatypeProperty ;
    rdfs:label "statedPartyCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies termination Currency." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:statedTerminationCurrency a owl:ObjectProperty ;
    rdfs:label "statedTerminationCurrency" ;
    rdfs:range common_domain_model:TerminationCurrencySelection ;
    skos:definition "Allows for specific Termination Currency(ies) and a fallback Termination Currency to be selected." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:stepDate a owl:DatatypeProperty ;
    rdfs:label "stepDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the associated stepValue becomes effective. This day may be subject to adjustment in accordance with a business day convention." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:stepUpProvision a owl:DatatypeProperty ;
    rdfs:label "stepUpProvision" ;
    rdfs:range xsd:boolean ;
    skos:definition "As specified by the ISDA Standard Terms Supplement for use with trades on mortgage-backed securities. The presence of the element with value set to 'true' signifies that the provision is applicable. If applicable, the applicable step-up terms are specified as part of that ISDA Standard Terms Supplement. From a usage standpoint, this provision is typically applicable in the case of RMBS and not applicable in case of CMBS trades." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:stepValue a owl:DatatypeProperty ;
    rdfs:label "stepValue" ;
    rdfs:range xsd:decimal ;
    skos:definition "The non-negative rate or amount which becomes effective on the associated stepDate. A rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:stockSplit a owl:ObjectProperty ;
    rdfs:label "stockSplit" ;
    rdfs:range common_domain_model:StockSplitInstruction ;
    skos:definition "Specifies inputs needed to process a Stock Split business event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:strategyFeature a owl:ObjectProperty ;
    rdfs:label "strategyFeature" ;
    rdfs:range common_domain_model:StrategyFeature ;
    skos:definition "Defines a simple strategy feature." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:strikeFactor a owl:DatatypeProperty ;
    rdfs:label "strikeFactor" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:AveragingFeature.strikeFactor ;
    skos:definition "The factor of strike." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:strikePrice a owl:ObjectProperty ;
    rdfs:label "strikePrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "Defines the strike of an option in the form of a price that could be a cash price, interestRate, or other types." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:strikeRate a owl:DatatypeProperty ;
    rdfs:label "strikeRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The rate for a cap or floor." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:strikeReference a owl:ObjectProperty ;
    rdfs:label "strikeReference" ;
    rdfs:range common_domain_model:FixedRateSpecification ;
    skos:definition "Defines the strike of an option in reference to the spread of the underlying swap (typical practice in the case of an option on a credit single name swaps)." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    common_domain_model:metadata_reference true .

common_domain_model:strikeSpread a owl:ObjectProperty ;
    rdfs:label "strikeSpread" ;
    rdfs:range common_domain_model:StrikeSpread ;
    skos:definition "Definition of the upper strike in a strike spread." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:string a owl:DatatypeProperty ;
    rdfs:label "string" ;
    rdfs:range xsd:string ;
    skos:definition "Provides extra information as string. In case the extra information is in XML format, a CDATA section must be placed around the source message to prevent its interpretation as XML content." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:stubAmount a owl:ObjectProperty ;
    rdfs:label "stubAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "An actual amount to apply for the initial or final stub period may have been agreed between the two parties. If an actual stub amount has been agreed then it would be included in this component." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:stubPeriod a owl:ObjectProperty ;
    rdfs:label "stubPeriod" ;
    rdfs:range common_domain_model:StubPeriod ;
    skos:definition "The stub calculation period amount parameters. This element must only be included if there is an initial or final stub calculation period. Even then, it must only be included if either the stub references a different floating rate tenor to the regular calculation periods, or if the stub is calculated as a linear interpolation of two different floating rate tenors, or if a specific stub rate or stub amount has been negotiated." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:stubRate a owl:DatatypeProperty ;
    rdfs:label "stubRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "An actual rate to apply for the initial or final stub period may have been agreed between the principal parties (in a similar way to how an initial rate may have been agreed for the first regular period). If an actual stub rate has been agreed then it would be included in this component. It will be a per annum rate, expressed as a decimal. A stub rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:submitgPty a owl:DatatypeProperty ;
    rdfs:label "submitgPty" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#SubmitgPty> .

common_domain_model:substitutionDateLanguage a owl:DatatypeProperty ;
    rdfs:label "substitutionDateLanguage" ;
    rdfs:range xsd:string ;
    skos:definition "Substitution Date has the meaning specified in Paragraph4(d)(ii), unless otherwise specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:substitutionProvision a owl:ObjectProperty ;
    rdfs:label "substitutionProvision" ;
    rdfs:range common_domain_model:UnderlierSubstitutionProvision ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:substitutionProvisions a owl:ObjectProperty ;
    rdfs:label "substitutionProvisions" ;
    rdfs:range common_domain_model:SubstitutionProvisions ;
    skos:closeMatch fpml_5_10:CollateralProvisions.substitutionProvisions ;
    skos:definition "The provisions for collateral substitutions such as how many and when they are allowed." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:suffix a owl:DatatypeProperty ;
    rdfs:label "suffix" ;
    rdfs:range xsd:string ;
    skos:definition "Name suffix, such as Jr., III, etc." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:summaryTransfer a owl:ObjectProperty ;
    rdfs:label "summaryTransfer" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:ScheduledTransfer common_domain_model:UnscheduledTransfer ) ] common_domain_model:Transfer ) ] ;
    skos:closeMatch fpml_5_10:BillingSummary.summaryTransfer ;
    skos:definition "The settlement terms for the billing summary" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:surname a owl:DatatypeProperty ;
    rdfs:label "surname" ;
    rdfs:range xsd:string ;
    skos:definition "The natural person's surname." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:swapStreamReference a owl:ObjectProperty ;
    rdfs:label "swapStreamReference" ;
    rdfs:range common_domain_model:InterestRatePayout ;
    skos:definition "Reference to the leg, where date adjustments may apply." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    common_domain_model:metadata_reference true .

common_domain_model:swapUnwindValue a owl:ObjectProperty ;
    rdfs:label "swapUnwindValue" ;
    rdfs:range common_domain_model:SwapCurveValuation ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:swp a owl:ObjectProperty ;
    rdfs:label "swp" ;
    rdfs:range common_domain_model:Swp ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Swp> .

common_domain_model:swpIn a owl:ObjectProperty ;
    rdfs:label "swpIn" ;
    rdfs:range common_domain_model:SwpIn ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#SwpIn> .

common_domain_model:swpOut a owl:ObjectProperty ;
    rdfs:label "swpOut" ;
    rdfs:range common_domain_model:SwpOut ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#SwpOut> .

common_domain_model:taxonomySource a owl:ObjectProperty ;
    rdfs:label "taxonomySource" ;
    rdfs:range common_domain_model:TaxonomySourceEnum ;
    skos:closeMatch fpml_5_10:CollateralTaxonomy.taxonomySource ;
    skos:definition "Specifies the taxonomy source." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:taxonomyValue a owl:ObjectProperty ;
    rdfs:label "taxonomyValue" ;
    rdfs:range common_domain_model:CollateralTaxonomyValue ;
    skos:closeMatch fpml_5_10:CollateralTaxonomy.taxonomyValue ;
    skos:definition "Specifies the taxonomy value." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:telephoneNumberType a owl:ObjectProperty ;
    rdfs:label "telephoneNumberType" ;
    rdfs:range common_domain_model:TelephoneTypeEnum ;
    skos:definition "The type of telephone number, e.g. work, mobile." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:tenderOfferEvents a owl:ObjectProperty ;
    rdfs:label "tenderOfferEvents" ;
    rdfs:range common_domain_model:EquityCorporateEvents ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:tenor a owl:ObjectProperty ;
    rdfs:label "tenor" ;
    rdfs:range common_domain_model:Period ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:tenorTillMaturity a owl:DatatypeProperty ;
    rdfs:label "tenorTillMaturity" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:AccrualFactorCalculationTerms.tenorTillMaturity ;
    skos:definition "The duration between last fixing date and the payment date of accruals, calculated in accordance with the appropriate DayCountFraction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:term a owl:ObjectProperty ;
    rdfs:label "term" ;
    rdfs:range common_domain_model:Term ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Term> .

common_domain_model:terminationCurrency a owl:ObjectProperty ;
    rdfs:label "terminationCurrency" ;
    rdfs:range common_domain_model:TerminationCurrency ;
    skos:definition "Specification of the currency in which the termination payment is made (including the process by which such currency is determined)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:terminationProvision a owl:ObjectProperty ;
    rdfs:label "terminationProvision" ;
    rdfs:range common_domain_model:TerminationProvision ;
    skos:definition "Contains optional provisions pertaining to the termination characteristics of a contract." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:terminationTime a owl:ObjectProperty ;
    rdfs:label "terminationTime" ;
    rdfs:range common_domain_model:DirectOrRelativeTime ;
    skos:definition "The time and zone of the last day of the terms of the trade. It can also be specified in relation to another time." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:terms a owl:DatatypeProperty ;
    rdfs:label "terms" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Clause.terms ;
    skos:definition "Content of this bespoke clause." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:termsChange a owl:ObjectProperty ;
    rdfs:label "termsChange" ;
    rdfs:range common_domain_model:TermsChangeInstruction ;
    skos:definition "Specifies instructions describing a terms change primitive event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:thresholdRate a owl:DatatypeProperty ;
    rdfs:label "thresholdRate" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:AutomaticExercise.thresholdRate ;
    skos:definition "A threshold rate. The threshold of 0.10% would be represented as 0.001" ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:timeRelativeTo a owl:ObjectProperty ;
    rdfs:label "timeRelativeTo" ;
    rdfs:range common_domain_model:TimeZone ;
    skos:definition "The reference time zone or base time from which the relative time is calculated." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    common_domain_model:metadata_reference true .

common_domain_model:timezone a owl:DatatypeProperty ;
    rdfs:label "timezone" ;
    rdfs:range xsd:string ;
    skos:definition "Any relevant time zone where specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:totalIneligibilityDate a owl:DatatypeProperty ;
    rdfs:label "totalIneligibilityDate" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the date from which all credit support provided by a party is treated as ineligible under the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:totalPosition a owl:DatatypeProperty ;
    rdfs:label "totalPosition" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:AggregationParameters.totalPosition ;
    skos:definition "Specifies whether to calculate total position to given date, or only daily position for the given date." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:totalRatio a owl:DatatypeProperty ;
    rdfs:label "totalRatio" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies the total actual dividend payout ratio associated with the equity underlier. A ratio of 90% should be expressed at 0.90." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:tradDt a owl:DatatypeProperty ;
    rdfs:label "tradDt" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#TradDt> .

common_domain_model:tradVn a owl:DatatypeProperty ;
    rdfs:label "tradVn" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#TradVn> .

common_domain_model:tradePortfolio a owl:ObjectProperty ;
    rdfs:label "tradePortfolio" ;
    rdfs:range common_domain_model:PortfolioState ;
    skos:definition "Represents a Portfolio that describes all the positions held at a given time, in various states which can be either traded, settled, etc., with lineage information to the previous state." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:tradeType a owl:ObjectProperty ;
    rdfs:label "tradeType" ;
    rdfs:range common_domain_model:AssetPayoutTradeTypeEnum ;
    skos:closeMatch fpml_5_10:AssetPayout.tradeType ;
    skos:definition "The trade type, eg repurchase transaction or buy/sell-back." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:tradgCpcty a owl:DatatypeProperty ;
    rdfs:label "tradgCpcty" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#TradgCpcty> .

common_domain_model:transactedPrice a owl:ObjectProperty ;
    rdfs:label "transactedPrice" ;
    rdfs:range common_domain_model:TransactedPrice ;
    skos:definition "The qualification of the price at which the contract has been transacted, in terms of market fixed rate, initial points, market price and/or quotation style. In FpML, those attributes are positioned as part of the fee leg." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:transactionAdditionalTerms a owl:ObjectProperty ;
    rdfs:label "transactionAdditionalTerms" ;
    rdfs:range common_domain_model:TransactionAdditionalTerms ;
    skos:closeMatch fpml_5_10:Agreement.transactionAdditionalTerms ;
    skos:definition "Any additional terms which mainly intend to specify the extraordinary events that may affect a trade and the related contractual rights and obligation of the parties when this happens" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:transferIneligibilityDate a owl:DatatypeProperty ;
    rdfs:label "transferIneligibilityDate" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies the date from which the transfer of credit support by a party is treated as ineligible under the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:transferSettlementTiming a owl:ObjectProperty ;
    rdfs:label "transferSettlementTiming" ;
    rdfs:range common_domain_model:TransferSettlementTiming ;
    skos:closeMatch fpml_5_10:CollateralTransferTiming.transferSettlementTiming ;
    skos:definition "Specification of transfer / settlement timing for cash and securities collateral assuming that the notice is provided before the Notification Time (and with a 1LBD lag introduced if the notice is delivered after the Notification Time), and that securities allow for a further Local Business Day for transfer / settlement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:transferSettlementType a owl:ObjectProperty ;
    rdfs:label "transferSettlementType" ;
    rdfs:range common_domain_model:TransferSettlementEnum ;
    skos:definition "The qualification as to how the transfer will settle, e.g. a DvP settlement." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:transferStatus a owl:ObjectProperty ;
    rdfs:label "transferStatus" ;
    rdfs:range common_domain_model:TransferStatusEnum ;
    skos:definition "Represents the State of the Transfer through its life-cycle." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:transferTimingProviso a owl:DatatypeProperty ;
    rdfs:label "transferTimingProviso" ;
    rdfs:range xsd:boolean ;
    skos:definition "The determination of whether transfer timing language is applicable or not." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:transferable a owl:DatatypeProperty ;
    rdfs:label "transferable" ;
    rdfs:range xsd:boolean ;
    skos:definition "A deliverable obligation characteristic. An obligation that is transferable to institutional investors without any contractual, statutory or regulatory restrictions. ISDA 2003 Term: Transferable." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:treatedForecastRate a owl:DatatypeProperty ;
    rdfs:label "treatedForecastRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The value representing the forecast rate after applying rate treatment rules. A value of 1% should be represented as 0.01." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:treatedRate a owl:DatatypeProperty ;
    rdfs:label "treatedRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The observed rate after any required rate treatment is applied. A treated rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:triggerDates a owl:ObjectProperty ;
    rdfs:label "triggerDates" ;
    rdfs:range common_domain_model:DateList ;
    skos:definition "The trigger Dates." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:triggerTimeType a owl:ObjectProperty ;
    rdfs:label "triggerTimeType" ;
    rdfs:range common_domain_model:TriggerTimeTypeEnum ;
    skos:definition "The valuation time type of knock condition." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:triggerType a owl:ObjectProperty ;
    rdfs:label "triggerType" ;
    rdfs:range common_domain_model:TriggerTypeEnum ;
    skos:definition "The Triggering condition." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:trnsmssnInd a owl:DatatypeProperty ;
    rdfs:label "trnsmssnInd" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#TrnsmssnInd> .

common_domain_model:trustSchemeAddendum a owl:DatatypeProperty ;
    rdfs:label "trustSchemeAddendum" ;
    rdfs:range xsd:boolean ;
    skos:definition "The qualification of whether Trust Scheme Addendum is applicable (True) or not applicable (False)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:txId a owl:DatatypeProperty ;
    rdfs:label "txId" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#TxId> .

common_domain_model:typeOfSwapElection a owl:ObjectProperty ;
    rdfs:label "typeOfSwapElection" ;
    rdfs:range common_domain_model:ReturnTypeEnum ;
    skos:definition "Per Part 1 Section 4, 'Dividend Obligations', of the 2018 ISDA CDM Equity Confirmation, Para 4.2 'Dividend Returns'." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:umbrellaAgreement a owl:ObjectProperty ;
    rdfs:label "umbrellaAgreement" ;
    rdfs:range common_domain_model:UmbrellaAgreement ;
    skos:definition "Specifies a set of legal entities which are part of a legal agreement beyond the two contracting parties to that agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:unadjustedEndDate a owl:DatatypeProperty ;
    rdfs:label "unadjustedEndDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CalculationPeriod.unadjustedEndDate ;
    skos:definition "The calculation end date, unadjusted." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:unadjustedPaymentDate a owl:DatatypeProperty ;
    rdfs:label "unadjustedPaymentDate" ;
    rdfs:range xsd:date ;
    skos:definition "The unadjusted payment date." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:unadjustedStartDate a owl:DatatypeProperty ;
    rdfs:label "unadjustedStartDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CalculationPeriod.unadjustedStartDate ;
    skos:definition "The calculation start date, unadjusted." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:undrlygInstrm a owl:ObjectProperty ;
    rdfs:label "undrlygInstrm" ;
    rdfs:range common_domain_model:UndrlygInstrm ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#UndrlygInstrm> .

common_domain_model:unknownReferenceObligation a owl:DatatypeProperty ;
    rdfs:label "unknownReferenceObligation" ;
    rdfs:range xsd:boolean ;
    skos:definition "Used to indicate that the Reference obligation associated with the Credit Default Swap is currently not known. This is not valid for Legal Confirmation purposes, but is valid for earlier stages in the trade life cycle (e.g. Broker Confirmation)." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:updateDate a owl:DatatypeProperty ;
    rdfs:label "updateDate" ;
    rdfs:range xsd:date ;
    skos:definition "The date the Floating Rate Option was last updated in the 2006 Definitions or 2021 Floating Rate Matrix. (e.g. 2021/06/11)" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:upperStrike a owl:ObjectProperty ;
    rdfs:label "upperStrike" ;
    rdfs:range common_domain_model:OptionStrike ;
    skos:definition "Upper strike in a strike spread." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:upperStrikeNumberOfOptions a owl:DatatypeProperty ;
    rdfs:label "upperStrikeNumberOfOptions" ;
    rdfs:range xsd:decimal ;
    skos:definition "Number of options at the upper strike price in a strike spread." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:url a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:range xsd:string ;
    skos:definition "Indicates where the resource can be found, as a URL that references the information on a web server accessible to the message recipient." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:useOfPostedCollateral a owl:DatatypeProperty ;
    rdfs:label "useOfPostedCollateral" ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether the party has the right to reuse, rehypothecate, or otherwise make use of the posted collateral. 'True' if the party has the right,'False' if the party does not have the right." ;
    skos:editorialNote "ISDA CSA_NewYork_1994 paragraph \"13\" clause \"(g)(ii)\"",
        "ISDA CSA_VM_2016 paragraph \"13\" clause \"(h)(ii)\" name \"Use of Posted Collateral (VM)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:utilization a owl:ObjectProperty ;
    rdfs:label "utilization" ;
    rdfs:range common_domain_model:CreditLimitUtilisation ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:val a owl:DatatypeProperty ;
    rdfs:label "val" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Val> .

common_domain_model:valuationDateLocation a owl:ObjectProperty ;
    rdfs:label "valuationDateLocation" ;
    rdfs:range common_domain_model:ValuationCalculationDateLocation ;
    skos:closeMatch fpml_5_10:CalculationAndTimingVariationMargin.valuationDateLocation ;
    skos:definition "The specified location where the credit exposure will be calculated by the respective parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:valuationDateTime a owl:DatatypeProperty ;
    rdfs:label "valuationDateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Indicates the valuation date of the exposure underlying the calculation." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:valuationPostponement a owl:ObjectProperty ;
    rdfs:label "valuationPostponement" ;
    rdfs:range common_domain_model:ValuationPostponement ;
    skos:definition "Specifies how long to wait to get a quote from a settlement rate option upon a price source disruption." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:valuationSource a owl:ObjectProperty ;
    rdfs:label "valuationSource" ;
    rdfs:range common_domain_model:ValuationSource ;
    skos:definition "The source for obtaining a valuation. This may come from some information source (e.g. Reuters), from a rate option fixing (e.g. FX fixing for cross-currency settlement), or from a set of reference banks. This is a mandatory attribute as the valuation method relies on one of those sources to be specified." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:valuationTerms a owl:ObjectProperty ;
    rdfs:label "valuationTerms" ;
    rdfs:range common_domain_model:ValuationTerms ;
    skos:definition "Contains all non-date valuation information." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:valuationTimeType a owl:ObjectProperty ;
    rdfs:label "valuationTimeType" ;
    rdfs:range common_domain_model:TimeTypeEnum ;
    skos:definition "The time of day at which the calculation agent values the underlying, for example the official closing time of the exchange." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:valuationTiming a owl:ObjectProperty ;
    rdfs:label "valuationTiming" ;
    rdfs:range common_domain_model:PriceTimingEnum ;
    skos:definition "Denotes when the valuation was sourced during a business day." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:valuationTreatment a owl:ObjectProperty ;
    rdfs:label "valuationTreatment" ;
    rdfs:range common_domain_model:CollateralValuationTreatment ;
    skos:closeMatch fpml_5_10:CollateralTreatment.valuationTreatment ;
    skos:definition "Specification of the valuation treatment for the specified collateral." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/GMRA#marginRatio> .

common_domain_model:valueLimit a owl:ObjectProperty ;
    rdfs:label "valueLimit" ;
    rdfs:range common_domain_model:MoneyRange ;
    skos:definition "Specifies the value of collateral limit represented as a range." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:varianceCapFloor a owl:ObjectProperty ;
    rdfs:label "varianceCapFloor" ;
    rdfs:range common_domain_model:VarianceCapFloor ;
    skos:definition "Contains possible barriers for variance products, both variance-based and underlier price based" ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:varianceReturnTerms a owl:ObjectProperty ;
    rdfs:label "varianceReturnTerms" ;
    rdfs:range common_domain_model:VarianceReturnTerms ;
    skos:definition "Return terms based upon the observed variance of the underlier's price." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:varianceStrikePrice a owl:ObjectProperty ;
    rdfs:label "varianceStrikePrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "Variance Strike Price in accordance with the ISDA 2011 Equity Derivatives Definitions." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:varyingNotionalCurrency a owl:DatatypeProperty ;
    rdfs:label "varyingNotionalCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "The currency of the varying notional amount, i.e. the notional amount being determined periodically based on observation of a spot currency exchange rate. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    common_domain_model:metadata_scheme true .

common_domain_model:varyingNotionalFixingDates a owl:ObjectProperty ;
    rdfs:label "varyingNotionalFixingDates" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:definition "The dates on which spot currency exchange rates are observed for purposes of determining the varying notional currency amount that will apply to a calculation period." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:varyingNotionalInterimExchangePaymentDates a owl:ObjectProperty ;
    rdfs:label "varyingNotionalInterimExchangePaymentDates" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:definition "The dates on which interim exchanges of notional are paid. Interim exchanges will arise as a result of changes in the spot currency exchange amount or changes in the constant notional schedule (e.g. amortisation)." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:vegaNotionalAmount a owl:ObjectProperty ;
    rdfs:label "vegaNotionalAmount" ;
    rdfs:range common_domain_model:NonNegativeQuantitySchedule ;
    skos:definition "Vega Notional represents the approximate gain/loss at maturity for a 1% difference between RVol (realised vol) and KVol (strike vol). It does not necessarily represent the Vega Risk of the trade." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:velocity a owl:ObjectProperty ;
    rdfs:label "velocity" ;
    rdfs:range common_domain_model:Velocity ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:vintage a owl:DatatypeProperty ;
    rdfs:label "vintage" ;
    rdfs:range xsd:integer ;
    skos:definition "In the case where successive definitions of the legal agreement have been developed, the vintage identification. This is typically (but not necessarily) done by referencing the year, e.g. 2013 in the case of the ISDA 2013 Standard Credit Support Annex." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/AM_1_0#csaVersion> .

common_domain_model:volatilityReturnTerms a owl:ObjectProperty ;
    rdfs:label "volatilityReturnTerms" ;
    rdfs:range common_domain_model:VolatilityReturnTerms ;
    skos:definition "Return terms based upon the observed volatility of the underlier's price." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:wacCapInterestProvision a owl:DatatypeProperty ;
    rdfs:label "wacCapInterestProvision" ;
    rdfs:range xsd:boolean ;
    skos:definition "As specified by the ISDA Supplement for use with trades on mortgage-backed securities, 'WAC Cap' means a weighted average coupon or weighted average rate cap provision (however defined in the Underlying Instruments) of the Underlying Instruments that limits, increases or decreases the interest rate or interest entitlement, as set out in the Underlying Instruments on the Effective Date without regard to any subsequent amendment The presence of the element with value set to 'true' signifies that the provision is applicable. From a usage standpoint, this provision is typically applicable in the case of CMBS and not applicable in case of RMBS trades." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:warehouseIdentity a owl:ObjectProperty ;
    rdfs:label "warehouseIdentity" ;
    rdfs:range common_domain_model:WarehouseIdentityEnum ;
    skos:definition "The identity of the warehouse, if any, that is executing that workflow step." ;
