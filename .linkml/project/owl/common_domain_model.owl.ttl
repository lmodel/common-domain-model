    rdfs:label "AsSpecified" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Represents any bespoke Additional Termination Event(s) that are set out in the related Specified Condition clause." .

<https://w3id.org/lmodel/common-domain-model/AdditionalTerminationEventEnum#FailureToNotifyNAV> a owl:Class ;
    rdfs:label "FailureToNotifyNAV" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Specifies an event where a party fails to notify the other of a decline in Net Asset Value by a specified amount over a specified period of time." .

<https://w3id.org/lmodel/common-domain-model/AdditionalTerminationEventEnum#InvestmentAdvisor> a owl:Class ;
    rdfs:label "InvestmentAdvisor" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Specifies an event where the investment advisor of a party ceases to act for the party." .

<https://w3id.org/lmodel/common-domain-model/AdditionalTerminationEventEnum#KeyPersons> a owl:Class ;
    rdfs:label "KeyPersons" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Specifies an event where a person deemed important to a party has departed." .

<https://w3id.org/lmodel/common-domain-model/AdditionalTerminationEventEnum#NAVDeclineTrigger> a owl:Class ;
    rdfs:label "NAVDeclineTrigger" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Specifies an event in which a partys Net Asset Value (NAV) has declined beyond a specified percentage or amount within a defined time period." .

<https://w3id.org/lmodel/common-domain-model/AdditionalTerminationEventEnum#NAVFloor> a owl:Class ;
    rdfs:label "NAVFloor" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Specifies an event in which a partys Net Asset Value (NAV) falls below a predetermined absolute value, regardless of the timeframe over which the decline occurs. This value sets a minimum acceptable NAV threshold expressed as either a percentage or amount." .

<https://w3id.org/lmodel/common-domain-model/AdditionalTerminationEventEnum#OperativeDocs> a owl:Class ;
    rdfs:label "OperativeDocs" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Specifies an event where a party delivers operative documents that are invalid, untrue or unenforceable." .

