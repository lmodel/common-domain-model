	rdfs:label "SupplementalMaterialEconomicTerms" ;
	rdfs:subClassOf common_domain_model:ResourceTypeEnum ;
	skos:definition "Document providing supplemental material economic terms to the FpML data representation. The initial intended usage is to fulfill the CFTC Part 45 rule requirement to report ‘Any other terms(s) of the swap matched or affirmed by the counterparties in verifying the swap’ when the reporting is done via the generic FpML representation." .
common_domain_model:ResourceTypeEnum\#TermSheet a owl:Class ;
