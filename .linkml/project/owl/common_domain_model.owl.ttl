common_domain_model:DayCountFractionEnum\#30\%2F360 a owl:Class ;
	rdfs:label "30/360" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "_30_360" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (vi), per 2006 ISDA Definitions, Section 4.16. Day Count Fraction, paragraph (f) or Annex to the 2000 ISDA Definitions (June 2000 Version), Section 4.16. Day Count Fraction, paragraph (e)." .
common_domain_model:DayCountFractionEnum\#30E\%2F360.ISDA a owl:Class ;
	rdfs:label "30E/360.ISDA" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "_30E_360_ISDA" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (viii), per 2006 ISDA Definitions, Section 4.16. Day Count Fraction, paragraph (h). Note the algorithm for this day count fraction under the 2006 ISDA Definitions is designed to yield the same results in practice as the version of the 30E/360 day count fraction defined in the 2000 ISDA Definitions. See Introduction to the 2006 ISDA Definitions for further information relating to this change." .
common_domain_model:DayCountFractionEnum\#30E\%2F360 a owl:Class ;
	rdfs:label "30E/360" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "_30E_360" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (vii), per 2006 ISDA Definitions, Section 4.16. Day Count Fraction, paragraph (g) or Annex to the 2000 ISDA Definitions (June 2000 Version), Section 4.16. Day Count Fraction, paragraph (f). Note that the algorithm defined for this day count fraction has changed between the 2000 ISDA Definitions and 2006 ISDA Definitions. See Introduction to the 2006 ISDA Definitions for further information relating to this change." .
common_domain_model:DayCountFractionEnum\#ACT\%2F360 a owl:Class ;
	rdfs:label "ACT/360" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "ACT_360" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (v), per 2006 ISDA Definitions, Section 4.16. Day Count Fraction, paragraph (e) or Annex to the 2000 ISDA Definitions (June 2000 Version), Section 4.16. Day Count Fraction, paragraph (d)." .
common_domain_model:DayCountFractionEnum\#ACT\%2F364 a owl:Class ;
	rdfs:label "ACT/364" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "ACT_364" ;
	skos:definition "Per CFTC definitions." .
common_domain_model:DayCountFractionEnum\#ACT\%2F365.FIXED a owl:Class ;
	rdfs:label "ACT/365.FIXED" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "ACT_365_FIXED" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (iv), per 2006 ISDA Definitions, Section 4.16. Day Count Fraction, paragraph (d) or Annex to the 2000 ISDA Definitions (June 2000 Version), Section 4.16. Day Count Fraction, paragraph (c)." .
common_domain_model:DayCountFractionEnum\#ACT\%2F365L a owl:Class ;
	rdfs:label "ACT/365L" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "ACT_365L" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (ix), per 2006 ISDA Definitions, Section 4.16. Day Count Fraction, paragraph (i)." .
common_domain_model:DayCountFractionEnum\#ACT\%2FACT.AFB a owl:Class ;
	rdfs:label "ACT/ACT.AFB" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "ACT_ACT_AFB" ;
	skos:definition "The Fixed/Floating Amount will be calculated in accordance with the 'BASE EXACT/EXACT' day count fraction, as defined in the 'Definitions Communes plusieurs Additifs Techniques' published by the Association Francaise des Banques in September 1994." .
common_domain_model:DayCountFractionEnum\#ACT\%2FACT.ICMA a owl:Class ;
	rdfs:label "ACT/ACT.ICMA" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "ACT_ACT_ICMA" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (iii), per 2006 ISDA Definitions, Section 4.16. Day Count Fraction, paragraph (c). This day count fraction code is applicable for transactions booked under the 2021 ISDA Definitions and the 2006 ISDA Definitions. Transactions under the 2000 ISDA Definitions should use the ACT/ACT.ISMA code instead." .
common_domain_model:DayCountFractionEnum\#ACT\%2FACT.ISDA a owl:Class ;
	rdfs:label "ACT/ACT.ISDA" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "ACT_ACT_ISDA" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (ii), per 2006 ISDA Definitions, Section 4.16. Day Count Fraction, paragraph (b) or Annex to the 2000 ISDA Definitions (June 2000 Version), Section 4.16. Day Count Fraction, paragraph (b). Note that going from FpML 2.0 Recommendation to the FpML 3.0 Trial Recommendation the code in FpML 2.0 'ACT/365.ISDA' became 'ACT/ACT.ISDA'." .
common_domain_model:DayCountFractionEnum\#ACT\%2FACT.ISMA a owl:Class ;
	rdfs:label "ACT/ACT.ISMA" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "ACT_ACT_ISMA" ;
	skos:definition "The Fixed/Floating Amount will be calculated in accordance with Rule 251 of the statutes, by-laws, rules and recommendations of the International Securities Market Association, as published in April 1999, as applied to straight and convertible bonds issued after December 31, 1998, as though the Fixed/Floating Amount were the interest coupon on such a bond. This day count fraction code is applicable for transactions booked under the 2000 ISDA Definitions. Transactions under the 2021 ISDA Definitions and the 2006 ISDA Definitions should use the ACT/ACT.ICMA code instead." .
common_domain_model:DayCountFractionEnum\#CAL\%2F252 a owl:Class ;
	rdfs:label "CAL/252" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "CAL_252" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (x). Supercedes BUS/252, the number of Business Days in the Calculation Period or Compounding Period in respect of which payment is being made divided by 252." .
common_domain_model:DayCountFractionEnum\#RBA\%20Bond\%20Basis a owl:Class ;
	rdfs:label "RBA Bond Basis" ;
	rdfs:subClassOf common_domain_model:DayCountFractionEnum ;
	skos:altLabel "RBA_BOND_BASIS" ;
	skos:definition "Per 2021 ISDA Definitions, Section 4.6.1 Day Count Fraction, paragraph (xi), the calculation mechanics are driven deterministically by the Calculation Period Frequency (i.e. 0.25 if it is three months, 0.5 if it is 6 months, 1 if it is a year), except that if the first Calculation Period or the final Calculation Period is less than the Calculation Period Frequency, Actual/Actual (ISDA) shall apply to that Calculation Period" .
