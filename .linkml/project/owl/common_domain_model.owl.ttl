            owl:onProperty common_domain_model:exposureMultiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DirectionRatingSet ;
            owl:onProperty common_domain_model:variableSet ] ;
    skos:definition "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

