common_domain_model:Observable a owl:Class ;
    rdfs:label "Observable" ;
    rdfs:subClassOf common_domain_model:BasketConstituent ;
    skos:definition "Specifies the object to be observed for a price, it could be an asset or a reference." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." .

common_domain_model:PartyRole a owl:Class ;
    rdfs:label "PartyRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:ownershipPartyReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:ownershipPartyReference ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PartyRoleEnum ;
            owl:onProperty common_domain_model:role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:ownershipPartyReference ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:role ] ;
    skos:definition "A class to specify the role(s) that party(ies) may have in relation to the execution, contract or other legal agreement." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:note "Rosetta func: FilterPartyRole — Filters the list of partyRoles based on the provided partyRoleEnum." ;
    common_domain_model:rosetta_functions "[{\"name\":\"FilterPartyRole\",\"description\":\"Filters the list of partyRoles based on the provided partyRoleEnum.\",\"inputs\":[{\"name\":\"partyRoles\",\"type\":\"PartyRole\",\"cardinality\":\"0..*\"},{\"name\":\"partyRoleEnum\",\"type\":\"PartyRoleEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredPartyRoles\",\"type\":\"PartyRole\",\"cardinality\":\"0..*\"}}]" .

