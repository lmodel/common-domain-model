        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:modifiedEquityDelivery ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:additionalTerm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:substitution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:modifiedEquityDelivery ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:indexReferenceInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:basketReferenceInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CreditIndex ;
            owl:onProperty common_domain_model:indexReferenceInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:indexReferenceInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:substitution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:basketReferenceInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BasketReferenceInformation ;
            owl:onProperty common_domain_model:basketReferenceInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:substitution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:referenceInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ReferenceInformation ;
            owl:onProperty common_domain_model:referenceInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:additionalTerm ] ;
    skos:definition " A class specifying a set of non-monetary terms for the Credit Derivative Transaction, including the buyer and seller and selected items from the ISDA 2014 Credit Definition article II, such as the reference obligation and related terms. The CDM GeneralTerms class corresponds to the FpML GeneralTerms complex type, except that the effectiveDate and scheduledTerminationDate have been positioned as part of the InterestRatePayout class in the CDM instead of in GeneralTerms." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    skos:note "Rosetta condition: BasketReferenceInformationNameOrId — if basketReferenceInformation exists then basketReferenceInformation -> basketName exists or basketReferenceInformation -> basketId exists",
        "Rosetta condition: FpML_cd_41 — if indexReferenceInformation -> tranche is absent then modifiedEquityDelivery is absent",
        "Rosetta condition: FpML_cd_42 — if basketReferenceInformation is absent then substitution is absent",
        "Rosetta condition: GeneralTermsChoice — required choice referenceInformation, indexReferenceInformation, basketReferenceInformation" .

