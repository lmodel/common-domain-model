            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:isSpecified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isSpecified ] ;
    skos:definition "A class to specify a related legal agreement. For example, ISDA 2016 Credit Support Annex for Initial Margin, paragraph 13, General Principles, (s): Other CSA and Japanese Law CSA (VM). | ISDA 2016 Credit Support Annex for Variation Margin, paragraph 13, (o): Other CSA." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    skos:note "Rosetta condition: LegalDocumentNotSpecified — if isSpecified = False then legalDocument is absent",
        "Rosetta condition: LegalDocumentSpecified — if isSpecified = True then legalDocument exists" .

common_domain_model:PayerReceiverEnum a owl:Class ;
