common_domain_model:Portfolio a owl:Class ;
    rdfs:label "Portfolio" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PortfolioState ;
            owl:onProperty common_domain_model:portfolioState ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:aggregationParameters ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:portfolioState ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:portfolioState ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AggregationParameters ;
            owl:onProperty common_domain_model:aggregationParameters ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:aggregationParameters ] ;
    skos:definition " A Portfolio represents an aggregation of multiple Positions, by describing the parameters that this Portfolio should be aggregated based on. The resulting PortfolioState is calculated using these aggregation parameters as inputs, by aggregating all the Events that are relevant to this Portfolio. The concept of Portfolio works at all levels in the model: from the highest for a given LegalEntity for instance, to the lowest to account for security substitutions in a secutity financing transaction. As such, Portfolio can be used either above or below the Contract level." ;
    skos:inScheme common_domain_model:cdm_event_position ;
    skos:note "Rosetta func: EvaluatePortfolioState — Function specification to evaluate a portfolio's aggregation parameters and return a new portfolio state containing aggregated positions." ;
    common_domain_model:rosetta_functions "[{\"name\":\"EvaluatePortfolioState\",\"description\":\"Function specification to evaluate a portfolio's aggregation parameters and return a new portfolio state containing aggregated positions.\",\"inputs\":[{\"name\":\"portfolio\",\"type\":\"Portfolio\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"portfolioState\",\"type\":\"PortfolioState\",\"cardinality\":\"1..1\"},\"code_implementation\":true}]" .

common_domain_model:PostedCreditSupportItem a owl:Class ;
    rdfs:label "PostedCreditSupportItem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:disputedCashOrSecurityValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:additionalHaircutPercentage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:haircutPercentage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:additionalHaircutPercentage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:haircutPercentage ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:disputedCashOrSecurityValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:cashOrSecurityValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fxHaircutPercentage ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:haircutPercentage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:additionalHaircutPercentage ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:cashOrSecurityValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:fxHaircutPercentage ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:disputedCashOrSecurityValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fxHaircutPercentage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:cashOrSecurityValue ] ;
    skos:definition "Posted Credit Support item with corresponding Valuation Percentage, FX Haircut Percentage and any related disputed Posted Credit Support valuation." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta func: DeliveryAmount",
        "Rosetta func: PostedCreditSupportItemAmount — Calculates the Value for the given Posted Credit Support item.",
        "Rosetta func: ReturnAmount",
        "Rosetta func: UndisputedAdjustedPostedCreditSupportAmount — Calculates the value for Undisputed Adjusted Posted Credit Support Item." ;
    common_domain_model:rosetta_functions "[{\"name\":\"PostedCreditSupportItemAmount\",\"description\":\"Calculates the Value for the given Posted Credit Support item.\",\"inputs\":[{\"name\":\"postedItem\",\"type\":\"PostedCreditSupportItem\",\"cardinality\":\"1..1\"},{\"name\":\"baseCurrency\",\"type\":\"string\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"Money\",\"cardinality\":\"1..1\"}},{\"name\":\"UndisputedAdjustedPostedCreditSupportAmount\",\"description\":\"Calculates the value for Undisputed Adjusted Posted Credit Support Item.\",\"inputs\":[{\"name\":\"postedCreditSupportItems\",\"type\":\"PostedCreditSupportItem\",\"cardinality\":\"0..*\"},{\"name\":\"priorDeliveryAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"priorReturnAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"disputedTransferredPostedCreditSupportAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"baseCurrency\",\"type\":\"string\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"Money\",\"cardinality\":\"1..1\"}},{\"name\":\"ReturnAmount\",\"inputs\":[{\"name\":\"postedCreditSupportItems\",\"type\":\"PostedCreditSupportItem\",\"cardinality\":\"0..*\"},{\"name\":\"priorDeliveryAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"priorReturnAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"disputedTransferredPostedCreditSupportAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"marginAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"threshold\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"marginApproach\",\"type\":\"MarginApproachEnum\",\"cardinality\":\"1..1\"},{\"name\":\"marginAmountIA\",\"type\":\"Money\",\"cardinality\":\"0..1\"},{\"name\":\"minimumTransferAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"rounding\",\"type\":\"CollateralRounding\",\"cardinality\":\"1..1\"},{\"name\":\"disputedReturnAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"baseCurrency\",\"type\":\"string\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"Money\",\"cardinality\":\"1..1\"}},{\"name\":\"DeliveryAmount\",\"inputs\":[{\"name\":\"postedCreditSupportItems\",\"type\":\"PostedCreditSupportItem\",\"cardinality\":\"0..*\"},{\"name\":\"priorDeliveryAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"priorReturnAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"disputedTransferredPostedCreditSupportAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"marginAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"threshold\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"marginApproach\",\"type\":\"MarginApproachEnum\",\"cardinality\":\"1..1\"},{\"name\":\"marginAmountIA\",\"type\":\"Money\",\"cardinality\":\"0..1\"},{\"name\":\"minimumTransferAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"rounding\",\"type\":\"CollateralRounding\",\"cardinality\":\"1..1\"},{\"name\":\"disputedDeliveryAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"baseCurrency\",\"type\":\"string\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"Money\",\"cardinality\":\"1..1\"}}]" .

