	rdfs:subClassOf _:c14n3478 , _:c14n356 , _:c14n4801 , _:c14n6672 , _:c14n7047 , _:c14n7901 ;
	skos:definition "The accrual rate and related terms, to adjust the price of an underlier impacted by a Corporate Action when economic impact consists in freezing the underlier price to the last fixing then applying accruals per each remaining underlier price fixing date required i.e. for each fixing date, adjustedPrice = lastFixingPrice x accrualFactor, where: accrualFactor = (1 + accrualRateValue x DCF)." ;
	skos:inScheme common_domain_model:cdm_event_common ;
	skos:note "Rosetta condition AccrualPriceIsRate is not stated in LinkML: value -> priceType = PriceTypeEnum -> InterestRate" .
