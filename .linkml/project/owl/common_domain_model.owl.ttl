    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:event a owl:ObjectProperty ;
    rdfs:label "event" ;
    rdfs:range common_domain_model:ZeroEventEnum ;
    skos:definition "Specifies the relevant trigger for the Threshold or Minimum Transfer Amount to fall to zero." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:eventCurrentAmount a owl:ObjectProperty ;
