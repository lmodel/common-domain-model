        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:FixedRateSpecification common_domain_model:FloatingRateSpecification common_domain_model:InflationRateSpecification ) ] common_domain_model:RateSpecification ) ] ;
            owl:onProperty common_domain_model:rateSpecification ],
