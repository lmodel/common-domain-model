	skos:inScheme common_domain_model:cdm_base_staticdata_party .
common_domain_model:AssetPartyRoleEnum\#Borrower a owl:Class ;
	rdfs:label "Borrower" ;
	rdfs:subClassOf common_domain_model:AssetPartyRoleEnum ;
	skos:definition "The entity that receives cash or assets from a lender with the expectation that cash or assets will be returned at a future agreed date and price." .
common_domain_model:AssetPartyRoleEnum\#Exchange a owl:Class ;
	rdfs:label "Exchange" ;
	rdfs:subClassOf common_domain_model:AssetPartyRoleEnum ;
	skos:definition "The exchange or platform where the security has been issued and the exchange has a direct economic role." .
common_domain_model:AssetPartyRoleEnum\#Issuer a owl:Class ;
	rdfs:label "Issuer" ;
	rdfs:subClassOf common_domain_model:AssetPartyRoleEnum ;
	skos:definition "The entity that issues a financial product and has the obligation to pay coupons, dividends and principal to the product holder." .
common_domain_model:AssetPartyRoleEnum\#Lender a owl:Class ;
	rdfs:label "Lender" ;
	rdfs:subClassOf common_domain_model:AssetPartyRoleEnum ;
	skos:definition "The entity that provides cash or assets to a borrower with the expectation that cash or assets will be returned at a future agreed date and price." .
common_domain_model:AssetPartyRoleEnum a owl:Class ;
	rdfs:label "AssetPartyRoleEnum" ;
	owl:unionOf _:c14n5621 ;
	skos:definition "The enumerated values that specify the role of a party with a direct obligation to the asset (i.e. Lender, Issuer)." ;
