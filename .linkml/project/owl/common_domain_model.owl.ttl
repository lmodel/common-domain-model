common_domain_model:EventTimestampQualificationEnum\#transactionCreationDateTime a owl:Class ;
	rdfs:label "transactionCreationDateTime" ;
	rdfs:subClassOf common_domain_model:EventTimestampQualificationEnum ;
	skos:definition "The date and time on which the transaction has been created. This timestamp is specified as such by the CME ClearPort Matched IRS Trade submission API specification: 'The transaction date time of the trade. Represents the date & time on which the trade was initially generated either by CME Clearing or firm. The transaction date time may be assigned by CME Clearing at the point the trade is reported as cleared. Transaction date time can also be provided by an external submitter of the trade at the point the trade is submitted.'" .
common_domain_model:EventTimestampQualificationEnum a owl:Class ;
	rdfs:label "EventTimestampQualificationEnum" ;
	owl:unionOf _:c14n6330 ;
	skos:definition "The enumeration values to qualify the timestamps that can be associated with a lifecycle event. The reason for such approach is that the experience of integrating the DTCC and CME data representations suggests that a wide set of timestamps are currently utilized among service providers, while there is not at present an objective set of criteria that could help suggest a defined set of timestamps as part of the CDM. Implementers are expected to evaluate the current enumeration values to determine whether those meet their requirements. If not, they are expected to engage with the CDM team to evaluate the addition of further value(s) to this enumeration, which will then participate to the development of a compendium for further evaluation at a later point in order to determine whether this modeling is appropriate." ;
	skos:inScheme common_domain_model:cdm_event_workflow ;
	linkml:permissible_values common_domain_model:EventTimestampQualificationEnum\#clearingConfirmationDateTime , common_domain_model:EventTimestampQualificationEnum\#clearingDateTime , common_domain_model:EventTimestampQualificationEnum\#clearingReceiptDateTime , common_domain_model:EventTimestampQualificationEnum\#clearingSubmissionDateTime , common_domain_model:EventTimestampQualificationEnum\#confirmationDateTime , common_domain_model:EventTimestampQualificationEnum\#eventCreationDateTime , common_domain_model:EventTimestampQualificationEnum\#eventExpirationDateTime , common_domain_model:EventTimestampQualificationEnum\#eventProcessingDateTime , common_domain_model:EventTimestampQualificationEnum\#eventSentDateTime , common_domain_model:EventTimestampQualificationEnum\#eventSubmittedDateTime , common_domain_model:EventTimestampQualificationEnum\#executionDateTime , common_domain_model:EventTimestampQualificationEnum\#transactionCreationDateTime .
