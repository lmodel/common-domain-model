common_domain_model:PaymentDates a owl:Class ;
    rdfs:label "PaymentDates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentFrequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:paymentDateSchedule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:firstPaymentDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:lastRegularPaymentDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Frequency ;
            owl:onProperty common_domain_model:paymentFrequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:lastRegularPaymentDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:firstPaymentDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Offset ;
            owl:onProperty common_domain_model:paymentDaysOffset ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PaymentDateSchedule ;
            owl:onProperty common_domain_model:paymentDateSchedule ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:paymentFrequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:lastRegularPaymentDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:paymentDatesAdjustments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:payRelativeTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:firstPaymentDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:payRelativeTo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDateSchedule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDaysOffset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDatesAdjustments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:paymentDatesAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PayRelativeToEnum ;
            owl:onProperty common_domain_model:payRelativeTo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:paymentDaysOffset ] ;
    skos:definition "Specifies the parameters to generate the payment date schedule, either through a parametric representation or by reference to specified dates." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    skos:note "Rosetta condition: FpML_ird_35_cd_31 — if firstPaymentDate exists and lastRegularPaymentDate exists then firstPaymentDate < lastRegularPaymentDate",
        "Rosetta condition: NonZeroPeriodMultiplier — if paymentDaysOffset exists then paymentDaysOffset -> periodMultiplier <> 0" ;
    common_domain_model:metadata_key true .

