    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/AveragingInOutEnum#Both>,
        <https://w3id.org/lmodel/common-domain-model/AveragingInOutEnum#In>,
        <https://w3id.org/lmodel/common-domain-model/AveragingInOutEnum#Out> .

common_domain_model:BasketConstituent a owl:Class ;
    rdfs:label "BasketConstituent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:interimValuationPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:finalValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:finalValuationPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NonNegativeQuantitySchedule ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:initialValuationPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialValuationPrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:interimValuationPrice ],
        common_domain_model:Observable ;
    skos:closeMatch fpml_5_10:BasketConstituent ;
    skos:definition "Identifies the constituents of the basket" ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Rosetta condition: BasketsOfBaskets — Basket is absent" .

common_domain_model:BespokeCalculationTime a owl:Class ;
    rdfs:label "BespokeCalculationTime" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:asCalculationAgent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:bespokeCalculationTimeTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:bespokeCalculationTimeTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:asCalculationAgent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:asCalculationAgent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:bespokeCalculationTimeTerms ] ;
    skos:closeMatch fpml_5_10:BespokeCalculationTime ;
    skos:definition "A class to specify additional Calculation Time terms for the purposes of Initial Margin." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta condition: AsCalculationAgentIm — if asCalculationAgent = True then bespokeCalculationTimeTerms is absent",
        "Rosetta condition: BespokeCalculationTimeTerms — if asCalculationAgent = False then bespokeCalculationTimeTerms exists" .

common_domain_model:CSAValuationDate a owl:Class ;
    rdfs:label "CSAValuationDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:frequency ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:additionalLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ValuationDateDateEnum ;
            owl:onProperty common_domain_model:date ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ValuationDateDayEnum ;
            owl:onProperty common_domain_model:day ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:date ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ValuationDateFrequencyEnum ;
            owl:onProperty common_domain_model:frequency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:calendarDay ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:day ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calendarDay ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:day ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:additionalLanguage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:calendarDay ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:additionalLanguage ] ;
    skos:closeMatch fpml_5_10:CSAValuationDate ;
    skos:definition "Specifies the date on which the value of collateral or exposure are calculated in accordance with the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta condition: AdditionalLanguage — if date is absent or frequency is absent then additionalLanguage exists",
        "Rosetta condition: CalendarDay — if date = ValuationDateDateEnum -> CalendarDay then calendarDay exists else calendarDay is absent" .

common_domain_model:CalculationFrequency a owl:Class ;
    rdfs:label "CalculationFrequency" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Period ;
            owl:onProperty common_domain_model:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dayOfMonth ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:dateLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenterTime ;
            owl:onProperty common_domain_model:dateLocation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:offsetDays ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:dayOfMonth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:weekOfMonth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:offsetDays ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:monthOfYear ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dayOfMonth ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dayOfWeek ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:monthOfYear ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:offsetDays ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessCenter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:weekOfMonth ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DayOfWeekEnum ;
            owl:onProperty common_domain_model:dayOfWeek ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:weekOfMonth ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dayOfWeek ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:monthOfYear ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:businessCenter ] ;
    skos:closeMatch fpml_5_10:CalculationFrequency ;
    skos:definition "Represents the parameters for describing how often something (such as collateral interest) is to be calculated." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: Dom — if dayOfMonth exists then dayOfMonth <= 31",
        "Rosetta condition: DomTerm — if dayOfMonth exists then (period -> period = PeriodEnum -> M)",
        "Rosetta condition: DowTerm — if dayOfWeek exists then (period -> period = PeriodEnum -> W)",
        "Rosetta condition: Moy — if monthOfYear exists then monthOfYear <= 12",
        "Rosetta condition: MoyTerm — if monthOfYear exists then (period -> period = PeriodEnum -> Y)",
        "Rosetta condition: Wom — if weekOfMonth exists then weekOfMonth <= 5",
        "Rosetta condition: WomTerm — if weekOfMonth exists then (period -> period = PeriodEnum -> M)" .

common_domain_model:CalculationValuationAgentPartyEnum a owl:Class ;
    rdfs:label "CalculationValuationAgentPartyEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party1> <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party2> <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#PartyMakingDemand> ) ;
    skos:definition "Specification of which party is calculating the value of collateral to be delivered or returned." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
