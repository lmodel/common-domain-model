common_domain_model:USCFTCPREligibleCollateralEnum a owl:Class ;
    rdfs:label "US_CFTC_PR_EligibleCollateralEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType1> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType2> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType3> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType4> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType5A> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType5B> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType6> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType7> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType8A> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType8B> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType8C> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType9> <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CTFC_PRType10> ) ;
    skos:definition "Identifies US Eligible Collateral Assets classification categories based on Uncleared Margin Rules published by the CFTC and the US Prudential Regulator. Note: While the same basic categories exist in the CFTC and US Prudential Regulators margin rules, the precise definitions or application of those rules could differ between the two rules." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum#US_CFTC_PRType1>,
