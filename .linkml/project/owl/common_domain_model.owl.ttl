common_domain_model:DividendTerms a owl:Class ;
    rdfs:label "DividendTerms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:minimumBillingAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:manufacturedIncomeRequirement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DividendPayoutRatio ;
            owl:onProperty common_domain_model:manufacturedIncomeRequirement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dividendEntitlement ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:manufacturedIncomeRequirement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:minimumBillingAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dividendEntitlement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DividendEntitlementEnum ;
            owl:onProperty common_domain_model:dividendEntitlement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:minimumBillingAmount ] ;
