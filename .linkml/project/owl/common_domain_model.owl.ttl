common_domain_model:PriceQuantity a owl:Class ;
	rdfs:label "PriceQuantity" ;
	rdfs:subClassOf _:c14n11197 , _:c14n1237 , _:c14n13374 , _:c14n14372 , _:c14n4240 , _:c14n4441 , _:c14n4876 , _:c14n5260 , _:c14n5525 , _:c14n5935 , _:c14n7812 ;
	skos:definition "Defines a settlement as an exchange between two parties of a specified quantity of an asset (the quantity) against a specified quantity of another asset (the price). The settlement is optional and can be either cash or physical. The quantity can additionally be specified in terms of one or more currency amounts. In the case of non-cash products, the settlement of the price/quantity would not be specified here and instead would be delegated to the product mechanics, as parameterised by the price/quantity values." ;
	skos:inScheme common_domain_model:cdm_observable_asset ;
	skos:note "Rosetta condition ArithmeticOperator is not stated in LinkML: if observable as InterestRateIndex exists and price exists then price -> arithmeticOperator exists" , "Rosetta condition InterestRateObservable is not stated in LinkML: InterestRateObservableCondition" , "Rosetta condition NonCurrencyQuantities is not stated in LinkML: (quantity count - quantity -> unit -> currency count) <= 1 or (observable as Commodity exists and quantity -> unit -> capacityUnit exists and (quantity count - quantity -> unit -> currency count) <= 2)" , "Rosetta condition PriceQuantityTriangulation is not stated in LinkML: PriceQuantityTriangulation (price, quantity) = True" ;
	common_domain_model:rosetta_metadata "key" .
common_domain_model:PriceReturnTerms a owl:Class ;
	rdfs:label "PriceReturnTerms" ;
	rdfs:subClassOf _:c14n10521 , _:c14n11879 , _:c14n13086 , _:c14n1393 , _:c14n4439 , _:c14n4546 , _:c14n5415 , _:c14n6016 , _:c14n6263 ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:PriceSchedule a owl:Class ;
	rdfs:label "PriceSchedule" ;
	rdfs:subClassOf common_domain_model:MeasureBase , _:c14n10526 , _:c14n1146 , _:c14n11777 , _:c14n11996 , _:c14n12266 , _:c14n13274 , _:c14n14115 , _:c14n14224 , _:c14n14493 , _:c14n1964 , _:c14n2333 , _:c14n2510 , _:c14n2640 , _:c14n3771 , _:c14n4092 , _:c14n4743 , _:c14n4771 , _:c14n5066 , _:c14n5456 , _:c14n5773 , _:c14n6874 , _:c14n7060 , _:c14n7895 , _:c14n8278 , _:c14n8368 , _:c14n9528 ;
	skos:definition "Specifies the price of a financial instrument in a trade as a schedule of measures. A price generically expresses the value of an exchange as a ratio: it measures the amount of one thing needed to be exchanged for 1 unit of another thing (e.g. cash in a specific currency in exchange for a bond or share). This generic representation can be used to support any type of financial price beyond just cash price: e.g. an interest rate, a foreign exchange rate, etc. This data type is generically based on a schedule and can also be used to represent a price as a single value." ;
	skos:inScheme common_domain_model:cdm_observable_asset ;
	skos:note "Rosetta condition AccruedInterest is not stated in LinkML: if composite -> operandType = AccruedInterest then priceType = AssetPrice" , "Rosetta condition CurrencyUnitForInterestRate is not stated in LinkML: if priceType = PriceTypeEnum -> InterestRate then unit -> currency exists" , "Rosetta condition DerivedQuantityCurrency is not stated in LinkML: if derivedQuantity exists and unit is absent then derivedQuantity -> unit -> currency exists" , "Rosetta condition DerivedQuantityMultiplier is not stated in LinkML: derivedQuantity -> multiplier is absent" , "Rosetta condition DerivedQuantityUnit is not stated in LinkML: if derivedQuantity exists and unit exists then derivedQuantity -> unit = unit" , "Rosetta condition ForwardPoint is not stated in LinkML: if composite -> operandType = ForwardPoint then priceType = ExchangeRate" , "Rosetta condition PositiveAssetPrice is not stated in LinkML: if (priceType = ExchangeRate or priceType = AssetPrice) and arithmeticOperator is absent then value > 0 or datedValue -> value all > 0" , "Rosetta condition PositivePremium is not stated in LinkML: if priceType = Premium then value > 0" , "Rosetta condition PositiveSpotRate is not stated in LinkML: if (priceType = ExchangeRate or priceType = AssetPrice) and composite -> baseValue exists then composite -> baseValue > 0" .
