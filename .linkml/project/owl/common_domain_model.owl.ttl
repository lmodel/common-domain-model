<https://w3id.org/lmodel/common-domain-model/AveragingCalculationMethodEnum#Arithmetic> a owl:Class ;
    rdfs:label "Arithmetic" ;
    rdfs:subClassOf common_domain_model:AveragingCalculationMethodEnum ;
    skos:definition "Refers to the calculation of an average by taking the sum of observations divided by the count of observations." .

<https://w3id.org/lmodel/common-domain-model/AveragingCalculationMethodEnum#Geometric> a owl:Class ;
    rdfs:label "Geometric" ;
    rdfs:subClassOf common_domain_model:AveragingCalculationMethodEnum ;
    skos:definition "Refers to the calculation of an average by taking the nth root of the product of n observations." .

<https://w3id.org/lmodel/common-domain-model/AveragingCalculationMethodEnum#Harmonic> a owl:Class ;
    rdfs:label "Harmonic" ;
    rdfs:subClassOf common_domain_model:AveragingCalculationMethodEnum ;
    skos:definition "Refers to the calculation of an average by taking the reciprocal of the arithmetic mean of the reciprocals of the observations." .

<https://w3id.org/lmodel/common-domain-model/AveragingInOutEnum#Both> a owl:Class ;
