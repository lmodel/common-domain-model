            owl:onProperty common_domain_model:contractualTermsSupplementType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:publicationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:contractualTermsSupplementType ] ;
    skos:definition "A contractual supplement (such as those published by ISDA) and its publication date that will apply to the trade." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:ControlAgreement a owl:Class ;
