    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CancellationEvent ;
            owl:onProperty common_domain_model:cancellationEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:cancellationEvent ] ;
    skos:definition "A data to:  define the adjusted dates for a cancelable provision on a swap transaction." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:CancellationEvent a owl:Class ;
    rdfs:label "CancellationEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:adjustedEarlyTerminationDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:adjustedExerciseDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustedEarlyTerminationDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
