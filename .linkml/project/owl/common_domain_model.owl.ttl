    rdfs:range common_domain_model:CollateralEquityIndexEnum ;
    skos:definition "An enumerated list for equity indices." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:equityUnderlierProvisions a owl:ObjectProperty ;
