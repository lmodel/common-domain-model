common_domain_model:BusinessCenterTime a owl:Class ;
	rdfs:label "BusinessCenterTime" ;
	rdfs:subClassOf _:c14n10851 , _:c14n11055 , _:c14n11456 , _:c14n1836 , _:c14n302 , _:c14n9328 ;
	skos:definition "A class for defining a time with respect to a business day calendar location. For example, 11:00:00 GBLO." ;
	skos:inScheme common_domain_model:cdm_base_datetime .
common_domain_model:BusinessCenters a owl:Class ;
	rdfs:label "BusinessCenters" ;
	rdfs:subClassOf _:c14n1047 , _:c14n12335 , _:c14n13800 , _:c14n2619 , _:c14n5007 , _:c14n7801 , _:c14n8280 , _:c14n8522 ;
	skos:definition "A class for specifying the business day calendar location used in determining whether a day is a business day or not, either by specifying this business center by reference to an enumerated list that is maintained by the FpML standard, or by reference to such specification when it exists elsewhere as part of the instance document. This class corresponds to the FpML BusinessCentersOrReference.model." ;
	skos:inScheme common_domain_model:cdm_base_datetime ;
	common_domain_model:rosetta_metadata "key" .
common_domain_model:BusinessDateRange a owl:Class ;
	rdfs:label "BusinessDateRange" ;
	rdfs:subClassOf common_domain_model:DateRange , _:c14n1035 , _:c14n2709 , _:c14n3744 , _:c14n4899 , _:c14n6125 , _:c14n6826 ;
	skos:definition "A class defining a range of contiguous business days by defining an unadjusted first date, an unadjusted last date and a business day convention and business centers for adjusting the first and last dates if they would otherwise fall on a non business day in the specified business centers. The days between the first and last date must also be good business days in the specified centers to be counted in the range." ;
	skos:inScheme common_domain_model:cdm_base_datetime .
common_domain_model:BusinessDayAdjustments a owl:Class ;
	rdfs:label "BusinessDayAdjustments" ;
	rdfs:subClassOf _:c14n12834 , _:c14n13945 , _:c14n14088 , _:c14n2950 , _:c14n5555 , _:c14n9260 ;
	skos:definition "A class defining the business day convention and financial business centers used for adjusting any relevant date if it would otherwise fall on a day that is not a business day in the specified business center." ;
	skos:inScheme common_domain_model:cdm_base_datetime ;
	common_domain_model:rosetta_metadata "key" .
common_domain_model:BusinessDayConventionEnum\#FOLLOWING a owl:Class ;
	rdfs:label "FOLLOWING" ;
	rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
	skos:definition "The non-business date will be adjusted to the first following day that is a business day" .
common_domain_model:BusinessDayConventionEnum\#FRN a owl:Class ;
	rdfs:label "FRN" ;
	rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
	skos:definition "Per 2000 ISDA Definitions, Section 4.11. FRN Convention; Eurodollar Convention. FRN is included here as a type of business day convention although it does not strictly fall within ISDA's definition of a Business Day Convention and does not conform to the simple definition given above." .
common_domain_model:BusinessDayConventionEnum\#MODFOLLOWING a owl:Class ;
	rdfs:label "MODFOLLOWING" ;
	rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
	skos:definition "The non-business date will be adjusted to the first following day that is a business day unless that day falls in the next calendar month, in which case that date will be the first preceding day that is a business day." .
common_domain_model:BusinessDayConventionEnum\#MODPRECEDING a owl:Class ;
	rdfs:label "MODPRECEDING" ;
	rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
	skos:definition "The non-business date will be adjusted to the first preceding day that is a business day unless that day falls in the previous calendar month, in which case that date will be the first following day that us a business day." .
common_domain_model:BusinessDayConventionEnum\#NEAREST a owl:Class ;
	rdfs:label "NEAREST" ;
	rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
	skos:definition "The non-business date will be adjusted to the nearest day that is a business day - i.e. if the non-business day falls on any day other than a Sunday or a Monday, it will be the first preceding day that is a business day, and will be the first following business day if it falls on a Sunday or a Monday." .
common_domain_model:BusinessDayConventionEnum\#NONE a owl:Class ;
	rdfs:label "NONE" ;
	rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
	skos:definition "The date will not be adjusted if it falls on a day that is not a business day." .
common_domain_model:BusinessDayConventionEnum\#NotApplicable a owl:Class ;
	rdfs:label "NotApplicable" ;
	rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
	skos:definition "The date adjustments conventions are defined elsewhere, so it is not required to specify them here." .
common_domain_model:BusinessDayConventionEnum\#PRECEDING a owl:Class ;
	rdfs:label "PRECEDING" ;
	rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
	skos:definition "The non-business day will be adjusted to the first preceding day that is a business day." .
common_domain_model:BusinessDayConventionEnum a owl:Class ;
	rdfs:label "BusinessDayConventionEnum" ;
	owl:unionOf _:c14n5205 ;
	skos:definition "The enumerated values to specify the convention for adjusting any relevant date if it would otherwise fall on a day that is not a valid business day." ;
	skos:inScheme common_domain_model:cdm_base_datetime ;
	linkml:permissible_values common_domain_model:BusinessDayConventionEnum\#FOLLOWING , common_domain_model:BusinessDayConventionEnum\#FRN , common_domain_model:BusinessDayConventionEnum\#MODFOLLOWING , common_domain_model:BusinessDayConventionEnum\#MODPRECEDING , common_domain_model:BusinessDayConventionEnum\#NEAREST , common_domain_model:BusinessDayConventionEnum\#NONE , common_domain_model:BusinessDayConventionEnum\#NotApplicable , common_domain_model:BusinessDayConventionEnum\#PRECEDING .
