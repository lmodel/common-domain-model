common_domain_model:CashSettlementTerms a owl:Class ;
    rdfs:label "CashSettlementTerms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:accruedInterest ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:valuationDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:cashSettlementAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:fixedSettlement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CashSettlementMethodEnum ;
            owl:onProperty common_domain_model:cashSettlementMethod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:accruedInterest ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:recoveryFactor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:valuationTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ValuationMethod ;
            owl:onProperty common_domain_model:valuationMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:cashSettlementMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:valuationMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:valuationDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ValuationDate ;
            owl:onProperty common_domain_model:valuationDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:cashSettlementAmount ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenterTime ;
            owl:onProperty common_domain_model:valuationTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:recoveryFactor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:valuationTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fixedSettlement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:valuationMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:cashSettlementAmount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fixedSettlement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:accruedInterest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:cashSettlementMethod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:recoveryFactor ] ;
    skos:closeMatch fpml_5_10:CashSettlementTerms ;
    skos:definition "Defines the terms required to compute and settle a cash settlement amount according to a fixing value, including the fixing source, fixing method and fixing date. In FpML, PhysicalSettlementTerms and CashSettlementTerms extend SettlementTerms. In the CDM, this extension paradigm has not been used because SettlementTerms class has been used for purposes related to securities transactions, while it is not used as such in the FpML standard (i.e. only as an abstract construct." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    skos:note "Rosetta condition: CashCollateralMethod — if valuationMethod -> cashCollateralValuationMethod exists then cashSettlementMethod = CashSettlementMethodEnum -> MidMarketIndicativeQuotations or cashSettlementMethod = CashSettlementMethodEnum -> MidMarketIndicativeQuotationsAlternate or cashSettlementMethod = CashSettlementMethodEnum -> MidMarketCalculationAgentDetermination or cashSettlementMethod = CashSettlementMethodEnum -> ReplacementValueFirmQuotations or cashSettlementMethod = CashSettlementMethodEnum -> ReplacementValueCalculationAgentDetermination",
        "Rosetta condition: CashSettlementTermsChoice — optional choice cashSettlementAmount, recoveryFactor",
        "Rosetta condition: FirmQuotationMethod — if valuationMethod -> cashCollateralValuationMethod -> prescribedDocumentationAdjustment exists then cashSettlementMethod = CashSettlementMethodEnum -> ReplacementValueFirmQuotations",
        "Rosetta condition: MidMarketValuationMethod — if (valuationMethod -> cashCollateralValuationMethod -> applicableCsa exists or valuationMethod -> cashCollateralValuationMethod -> agreedDiscountRate exists or valuationMethod -> cashCollateralValuationMethod -> cashCollateralInterestRate exists) then cashSettlementMethod = CashSettlementMethodEnum -> MidMarketIndicativeQuotations or cashSettlementMethod = CashSettlementMethodEnum -> MidMarketIndicativeQuotationsAlternate or cashSettlementMethod = CashSettlementMethodEnum -> MidMarketCalculationAgentDetermination",
        "Rosetta condition: RecoveryFactor — if recoveryFactor exists then recoveryFactor >= 0.0 and recoveryFactor <= 1.0",
        "Rosetta condition: ReplacementValueMethod — if valuationMethod -> cashCollateralValuationMethod -> protectedParty exists then cashSettlementMethod = CashSettlementMethodEnum -> ReplacementValueFirmQuotations or cashSettlementMethod = CashSettlementMethodEnum -> ReplacementValueCalculationAgentDetermination" ;
    common_domain_model:metadata_key true .

