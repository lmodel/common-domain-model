common_domain_model:VarianceReturnTerms a owl:Class ;
    rdfs:label "VarianceReturnTerms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:varianceStrikePrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Price ;
            owl:onProperty common_domain_model:volatilityStrikePrice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:varianceCapFloor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:varianceStrikePrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:VarianceCapFloor ;
            owl:onProperty common_domain_model:varianceCapFloor ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Price ;
            owl:onProperty common_domain_model:varianceStrikePrice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NonNegativeQuantitySchedule ;
            owl:onProperty common_domain_model:vegaNotionalAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:exchangeTradedContractNearest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:volatilityStrikePrice ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:volatilityCapFloor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:volatilityCapFloor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:volatilityStrikePrice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:vegaNotionalAmount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:vegaNotionalAmount ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:varianceCapFloor ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:VolatilityCapFloor ;
            owl:onProperty common_domain_model:volatilityCapFloor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:exchangeTradedContractNearest ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Asset common_domain_model:Basket common_domain_model:Index ) ] common_domain_model:Observable ) ] ;
            owl:onProperty common_domain_model:exchangeTradedContractNearest ],
        common_domain_model:ReturnTermsBase ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    skos:note "Rosetta condition: NonNegativeStrikePrice — if volatilityStrikePrice -> value exists then volatilityStrikePrice -> value >= 0 and if varianceStrikePrice -> value exists then varianceStrikePrice -> value >= 0",
        "Rosetta condition: Positive_VegaNotionalAmount — if vegaNotionalAmount -> value exists then vegaNotionalAmount -> value > 0",
        "Rosetta condition: ReferenceContract — if valuationTerms -> futuresPriceValuation = True then exchangeTradedContractNearest exists",
        "Rosetta condition: StrikePriceMustExist — required choice volatilityStrikePrice, varianceStrikePrice",
        "Rosetta condition: UnderlierMustBeListedDerivative — if exchangeTradedContractNearest exists then exchangeTradedContractNearest -> Asset -> Instrument -> ListedDerivative exists" .

