	skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .
common_domain_model:costOfSubstituteCalculationAgentIsBoreBy a owl:ObjectProperty ;
	rdfs:label "costOfSubstituteCalculationAgentIsBoreBy" ;
	skos:definition "A representation of who bears the cost of the substitute calculation agent." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .
