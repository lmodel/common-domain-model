            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:netInitialMargin ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:netInitialMargin ] ;
    skos:inScheme common_domain_model:cdm_margin_schedule ;
    skos:note "Rosetta condition: NonNegativeNetInitialMargin — netInitialMargin -> value >= 0",
        "Rosetta func: GetNetInitialMarginFromExposure — Computes the net initial margin, taking the gross initial margin result and the mark to market value for each trade in the portfolio." ;
    common_domain_model:rosetta_functions "[{\"name\":\"GetNetInitialMarginFromExposure\",\"description\":\"Computes the net initial margin, taking the gross initial margin result and the mark to market value for each trade in the portfolio.\",\"inputs\":[{\"name\":\"exposure\",\"type\":\"Exposure\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"initialMargin\",\"type\":\"StandardizedScheduleInitialMargin\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:StubCalculationPeriodAmount a owl:Class ;
    rdfs:label "StubCalculationPeriodAmount" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:finalStub ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:StubValue ;
            owl:onProperty common_domain_model:finalStub ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:finalStub ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialStub ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationPeriodDatesReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialStub ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:StubValue ;
            owl:onProperty common_domain_model:initialStub ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CalculationPeriodDates ;
            owl:onProperty common_domain_model:calculationPeriodDatesReference ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:calculationPeriodDatesReference ] ;
    skos:definition "A data defining:  how the initial or final stub calculation period amounts is calculated. For example, the rate to be applied to the initial or final stub calculation period may be the linear interpolation of two different tenors for the floating rate index specified in the calculation period amount component, e.g. A two month stub period may used the linear interpolation of a one month and three month floating rate. The different rate tenors would be specified in this component. Note that a maximum of two rate tenors can be specified. If a stub period uses a single index tenor and this is the same as that specified in the calculation period amount component then the initial stub or final stub component, as the case may be, must not be included." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

