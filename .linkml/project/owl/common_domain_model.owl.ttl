        <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeGiverEnum#Seller> .

common_domain_model:Exposure a owl:Class ;
    rdfs:label "Exposure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:aggregateValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:aggregateValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PortfolioState ;
            owl:onProperty common_domain_model:tradePortfolio ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:aggregateValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty common_domain_model:valuationDateTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:tradePortfolio ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty common_domain_model:calculationDateTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:calculationDateTime ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:valuationDateTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationDateTime ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:tradePortfolio ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:valuationDateTime ] ;
    skos:definition "Represents the current mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency)." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta func: Create_ExposureFromTrades — Builds an Exposure structure from a list of trades." ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_ExposureFromTrades\",\"description\":\"Builds an Exposure structure from a list of trades.\",\"inputs\":[{\"name\":\"trades\",\"type\":\"TradeState\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"exposure\",\"type\":\"Exposure\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:FixedPricePayout a owl:Class ;
    rdfs:label "FixedPricePayout" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CalculationSchedule ;
            owl:onProperty common_domain_model:schedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FixedPrice ;
            owl:onProperty common_domain_model:fixedPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:paymentDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PaymentDates ;
            owl:onProperty common_domain_model:paymentDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:schedule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fixedPrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:fixedPrice ],
        common_domain_model:PayoutBase ;
    skos:definition "Represents a fixed price payout. There is no underlier associated with this payout type and is based on fixed pricing per a given unit (e.g. in commodities price per barrel)" ;
    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Rosetta condition: Quantity — priceQuantity exists" .

