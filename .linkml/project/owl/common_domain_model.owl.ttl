common_domain_model:DeterminationMethodology a owl:Class ;
	rdfs:label "DeterminationMethodology" ;
	rdfs:subClassOf _:c14n14687 , _:c14n1962 , _:c14n5179 , _:c14n6230 , _:c14n6510 , _:c14n7653 ;
	skos:definition "Specifies the method according to which an amount or a date is determined." ;
	skos:inScheme common_domain_model:cdm_observable_event .
common_domain_model:DeterminationRoleEnum\#CalculationAgent a owl:Class ;
	rdfs:label "CalculationAgent" ;
	rdfs:subClassOf common_domain_model:DeterminationRoleEnum ;
	skos:definition "Specifies the party responsible for performing calculation agent duties as defined in the applicable product definition. As an indication, the role of Calculation Agent is key in regards of other roles, for mainly two reasons : first is that it is a fallback role i.e. whenever another role is not defined, then such role would be assumed by the Calculation Agent ; second is that related determination are not limited to Extraordinary Event per se i.e. any determinationr required in regards of Payout calculations for instance would fall on Calculation Agent, unless otherwise specified in Calculation Agent attached to Economic Terms." .
common_domain_model:DeterminationRoleEnum\#DeterminingParty a owl:Class ;
	rdfs:label "DeterminingParty" ;
	rdfs:subClassOf common_domain_model:DeterminationRoleEnum ;
	skos:definition "Specifies the party responsible for performing related HedgingParty duties as defined in the applicable product definition, notably in regards of particular Disruption Events or Early Termination Terms which may involve the calculation of a liquidation or compensation value amount." .
common_domain_model:DeterminationRoleEnum\#HedgingParty a owl:Class ;
	rdfs:label "HedgingParty" ;
	rdfs:subClassOf common_domain_model:DeterminationRoleEnum ;
	skos:definition "Specifies the party responsible for performing related HedgingParty duties as defined in the applicable product definition, notably in regards of particular Extraordinary Events or Price Determination Methods which involve hedging considerations." .
common_domain_model:DeterminationRoleEnum a owl:Class ;
	rdfs:label "DeterminationRoleEnum" ;
	owl:unionOf _:c14n11310 ;
	skos:definition "Defines the enumerated values to specify the determination roles to the transaction. Such roles mostly address any determination that would be required when some Extraordinary Events would happen, for instance qualifying the effectiveness of such event, or when a calculation is required, etc. else any other kind of determination as need be." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms ;
	linkml:permissible_values common_domain_model:DeterminationRoleEnum\#CalculationAgent , common_domain_model:DeterminationRoleEnum\#DeterminingParty , common_domain_model:DeterminationRoleEnum\#HedgingParty .
common_domain_model:DeterminationRolesAndTerms a owl:Class ;
	rdfs:label "DeterminationRolesAndTerms" ;
	rdfs:subClassOf _:c14n13 , _:c14n13079 , _:c14n13499 , _:c14n14591 , _:c14n14709 , _:c14n1694 , _:c14n2917 , _:c14n3498 , _:c14n6502 , _:c14n7057 , _:c14n741 , _:c14n8960 ;
	skos:definition "Defines the roles and related terms which document the agreement of parties about any determination requirements ; mostly about Extraordinary Events, without being necessarily restricted to such scope, as further specified in the particular product at stake e.g. for instance when Calculation Agent is mentioned as the Price Determination Method enumarated value, etc." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms ;
	skos:note "Rosetta condition DisputingPartyCannotHaveOriginalRole is not stated in LinkML: whoToDetermine all <> disputingParty" .
common_domain_model:DetermineUnadjustedCalculationPeriodInstruction a owl:Class ;
	rdfs:label "DetermineUnadjustedCalculationPeriodInstruction" ;
	rdfs:subClassOf _:c14n12841 , _:c14n2996 , _:c14n3573 , _:c14n6389 , _:c14n6971 , _:c14n7679 ;
	skos:definition "Instruction that contains the unadjusted calculation period." ;
	skos:inScheme common_domain_model:cdm_event_instructioncomposition_reset .
common_domain_model:DetermineUnadjustedObservationDatesInstruction a owl:Class ;
	rdfs:label "DetermineUnadjustedObservationDatesInstruction" ;
	rdfs:subClassOf _:c14n2914 , _:c14n539 , _:c14n9053 , _:c14n9497 , _:c14n9971 ;
	skos:definition "Instruction that holds the unadjusted observation dates." ;
	skos:inScheme common_domain_model:cdm_event_instructioncomposition_reset .
common_domain_model:DigitalAsset a owl:Class , owl:ObjectProperty ;
	rdfs:label "DigitalAsset" ;
	rdfs:subClassOf common_domain_model:AssetBase , _:c14n8918 ;
	skos:definition "An Asset that exists only in digital form, eg Bitcoin or Ethereum, that is not backed by other Assets; excludes the digital representation of other Assets, eg coins or Tokenised assets." , "An Asset that exists only in digital form, eg Bitcoin or Ethereum; excludes the digital representation of other Assets." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .
common_domain_model:DirectOrRelativeTime a owl:Class ;
	rdfs:label "DirectOrRelativeTime" ;
	rdfs:subClassOf _:c14n11743 , _:c14n12158 , _:c14n12598 , _:c14n13127 , _:c14n13232 , _:c14n13475 ;
	skos:definition "Represents a time definition that can be either an absolute (direct) time or a time calculated relative to another referenced time. Either one directTime or one relativeTime should be provided" ;
	skos:inScheme common_domain_model:cdm_base_datetime .
common_domain_model:DirectionRating a owl:Class , owl:ObjectProperty ;
	rdfs:label "DirectionRating" ;
	rdfs:subClassOf common_domain_model:CreditNotation , _:c14n13531 , _:c14n3772 , _:c14n5955 , _:c14n9978 ;
	skos:definition "A logical container to hold a defined set of related data. In this case the collation of Ratings Agency, Rating value and an associated direction." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:DirectionRatingMultiplier a owl:Class ;
	rdfs:label "DirectionRatingMultiplier" ;
	rdfs:subClassOf _:c14n11415 , _:c14n11924 , _:c14n13386 , _:c14n13390 , _:c14n2833 ;
	skos:definition "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:DirectionRatingSet a owl:Class ;
	rdfs:label "DirectionRatingSet" ;
	rdfs:subClassOf _:c14n13545 , _:c14n404 , _:c14n4690 , _:c14n5975 , _:c14n6168 , _:c14n7277 , _:c14n7604 , _:c14n9599 , _:c14n9692 , _:c14n9939 ;
	skos:definition "A logical container to hold a defined set of related data. In this case the collation of Ratings Agency, Rating value and an associated direction that are grouped by either AND or OR logic." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
	common_domain_model:rosetta_choice "true" .
common_domain_model:DiscountingMethod a owl:Class ;
	rdfs:label "DiscountingMethod" ;
	rdfs:subClassOf _:c14n10762 , _:c14n1315 , _:c14n13879 , _:c14n1748 , _:c14n3887 , _:c14n6767 , _:c14n6997 , _:c14n7299 , _:c14n949 ;
	skos:definition "A data defining: discounting information. The 2000 ISDA definitions, section 8.4. discounting (related to the calculation of a discounted fixed amount or floating amount) apply. This type must only be included if discounting applies." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:DiscountingTypeEnum\#AFMA a owl:Class ;
	rdfs:label "AFMA" ;
	rdfs:subClassOf common_domain_model:DiscountingTypeEnum ;
	skos:definition "As specified by the Australian Financial Markets Association (AFMA) OTC Financial Product Conventions. This discounting method should not be used for a trade documented under a legal framework where the 2006 ISDA Definitions have been incorporated." .
common_domain_model:DiscountingTypeEnum\#FRA a owl:Class ;
	rdfs:label "FRA" ;
	rdfs:subClassOf common_domain_model:DiscountingTypeEnum ;
	skos:definition "As specified by the 2006 ISDA Definitions, Section 8.4. Discounting, paragraph (b)." .
common_domain_model:DiscountingTypeEnum\#FRAYield a owl:Class ;
	rdfs:label "FRAYield" ;
	rdfs:subClassOf common_domain_model:DiscountingTypeEnum ;
	skos:definition "As specified by the 2006 ISDA Definitions, Section 8.4. Discounting, paragraph (e)." .
common_domain_model:DiscountingTypeEnum\#Standard a owl:Class ;
	rdfs:label "Standard" ;
	rdfs:subClassOf common_domain_model:DiscountingTypeEnum ;
	skos:definition "As specified by the 2006 ISDA Definitions, Section 8.4. Discounting, paragraph (a)." .
common_domain_model:DiscountingTypeEnum a owl:Class ;
	rdfs:label "DiscountingTypeEnum" ;
	owl:unionOf _:c14n10973 ;
	skos:definition "The enumerated values to specify the method of calculating discounted payment amounts. This enumerations combines the FpML DiscountingTypeEnum and FraDiscountingEnum enumerations." ;
	skos:inScheme common_domain_model:cdm_product_asset ;
	linkml:permissible_values common_domain_model:DiscountingTypeEnum\#AFMA , common_domain_model:DiscountingTypeEnum\#FRA , common_domain_model:DiscountingTypeEnum\#FRAYield , common_domain_model:DiscountingTypeEnum\#Standard .
