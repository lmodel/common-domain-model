	skos:definition "Specifies instructions to create a BusinessEvent." ;
	skos:inScheme common_domain_model:cdm_event_workflow .
common_domain_model:EventIntentEnum\#Allocation a owl:Class ;
	rdfs:label "Allocation" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to allocate one or more trades as part of an allocated block trade." .
common_domain_model:EventIntentEnum\#CashFlow a owl:Class ;
	rdfs:label "CashFlow" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to designate a stand-alone cash transfer as a result of Trade contracual terms e.g. incurred by payout for instance a Performance Amount or a Floating Rate Amount. The particular CashFlow at stake shall be further specified in priceTransferEnum or transferTypeEnum. For clarity, such intentEnum value shall not be used whenever a cash transfer is not stand-alone but is instead embedded in another Event as part of the composable modelling e.g. Decrease with Fees, Cross-Currency Notional Reset, etc. or any other Event whenever including a cash transfer with other features. For clarity, a principal payment related to a Principal Exhange is excluded as well, because a dedicated intentEnum value exists for this event i.e. PrincipalExchange value." .
common_domain_model:EventIntentEnum\#Clearing a owl:Class ;
	rdfs:label "Clearing" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to clear the contract." .
common_domain_model:EventIntentEnum\#Compression a owl:Class ;
	rdfs:label "Compression" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to compress multiple trades as part of a netting or compression event." .
common_domain_model:EventIntentEnum\#ContractFormation a owl:Class ;
	rdfs:label "ContractFormation" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to form a contract from an execution." .
common_domain_model:EventIntentEnum\#ContractTermsAmendment a owl:Class ;
	rdfs:label "ContractTermsAmendment" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to amend the terms of the contract through renegotiation." .
common_domain_model:EventIntentEnum\#CorporateActionAdjustment a owl:Class ;
	rdfs:label "CorporateActionAdjustment" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to take into effect the occurrence of a Corporate Action and the particular Corporate Action at stake shall be further specified in CorporateActionTypeEnum." .
common_domain_model:EventIntentEnum\#CreditEvent a owl:Class ;
	rdfs:label "CreditEvent" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to take into effect the occurrence of a Credit Event." .
common_domain_model:EventIntentEnum\#Decrease a owl:Class ;
	rdfs:label "Decrease" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to Decrease the quantity or notional of the contract." .
common_domain_model:EventIntentEnum\#EarlyTerminationProvision a owl:Class ;
	rdfs:label "EarlyTerminationProvision" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to fully unwind the Trade, as a result of the application of Trade contractual terms (e.g. an obligation to do so before Termination Date as part of any kind of Early Termination terms) as defined within the CDM EarlyTerminationProvision data type. Accordingly, increase and decrease of positions which result from negotiation by the parties shall not be designated by such intentEnum. For clarity, partial exercise of an option before its expiration date is excluded as well, though related to Trade contract terms, because a dedicated intentEnum value exists for this event i.e. OptionExercise value." .
common_domain_model:EventIntentEnum\#Increase a owl:Class ;
	rdfs:label "Increase" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to Increase the quantity or notional of the contract." .
common_domain_model:EventIntentEnum\#IndexTransition a owl:Class ;
	rdfs:label "IndexTransition" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to replace an interest rate index by another one during the life of a trade and add a transition spread on top of this index (and on top of the spreads already defined in the trade, if any)." .
common_domain_model:EventIntentEnum\#NotionalReset a owl:Class ;
	rdfs:label "NotionalReset" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to increase or to decrease the notional of the Trade, in accordance with Notional Reset features e.g. could apply for Cross Currency Swaps, Equity Performance Swaps, etc." .
common_domain_model:EventIntentEnum\#NotionalStep a owl:Class ;
	rdfs:label "NotionalStep" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to increase or to decrease the notional of the Trade, in accordance with Step features attached to a Payout Quantity." .
common_domain_model:EventIntentEnum\#Novation a owl:Class ;
	rdfs:label "Novation" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to novate the contract." .
common_domain_model:EventIntentEnum\#ObservationRecord a owl:Class ;
	rdfs:label "ObservationRecord" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to record any kind of stand-alone obervervations e.g. internal data recording, usage of CDM for recording and/or exchanging data as part of pricing 'consensus' processing, etc. For clarity, such intentEnum value shall not be used whenever an observation is not stand-alone but is instead embedded in another Event as part of the composable modelling e.g. CashFlow to which an observation of prices is associated, etc." .
common_domain_model:EventIntentEnum\#OptionExercise a owl:Class ;
	rdfs:label "OptionExercise" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to Exercise a contract that is made of one or several option payout legs. For clarity, such intentEnum value shall not be used whenever an optional right is exercised in relation with a Trade which composition includes other types of payout legs e.g. right to call or to cancel before Termination Date as part of any kind of Early Termination terms other than genuine bermuda or american style features described in option payout." .
common_domain_model:EventIntentEnum\#OptionalCancellation a owl:Class ;
	rdfs:label "OptionalCancellation" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to cancel the trade through exercise of an optional right as defined within the CDM OptionProvision data type." .
common_domain_model:EventIntentEnum\#OptionalExtension a owl:Class ;
	rdfs:label "OptionalExtension" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to extend the trade through exercise of an optional right as defined within the CDM OptionProvision data type." .
common_domain_model:EventIntentEnum\#PortfolioRebalancing a owl:Class ;
	rdfs:label "PortfolioRebalancing" ;
	rdfs:subClassOf common_domain_model:EventIntentEnum ;
	skos:definition "The intent is to rebalance a portfolio, by inserting new derivatives transactions into portfolios of participants to reduce risks linked to those trades. These are offsetting trades that rebalance relationships between different counterparties when it comes to exposure of portfolios to certain types of risk, such as interest rate risk." .
common_domain_model:EventIntentEnum\#PrincipalExchange a owl:Class ;
	rdfs:label "PrincipalExchange" ;
