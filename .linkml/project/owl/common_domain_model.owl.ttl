common_domain_model:CallingPartyEnum a owl:Class ;
    rdfs:label "CallingPartyEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#InitialBuyer> <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#InitialSeller> <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#Either> <https://w3id.org/lmodel/common-domain-model/CallingPartyEnum#AsDefinedInMasterAgreement> ) ;
