common_domain_model:FloatingRateProcessingDetails a owl:Class ;
    rdfs:label "FloatingRateProcessingDetails" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:processedRate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:processingParameters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:spreadExclusiveRate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:spreadExclusiveRate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:rawRate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FloatingRateProcessingParameters ;
            owl:onProperty common_domain_model:processingParameters ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:processedRate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:processedRate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:processingParameters ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:rawRate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:rawRate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:spreadExclusiveRate ] ;
    skos:definition "Type for reporting the details of the rate treatment.  This could potentially be replaced by the existing FloatingRateDefinition type , but this is slightly more detailed." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate ;
    skos:note "Rosetta func: ApplyFloatingRateProcessing — Perform rate treatments on floating rates, such as applying spreads, multipliers, caps and floors, rounding, and negative interest treatment. TODO: initialRate needs to be supported.  Also, to support compounding methods, it may be necessary to split the before spread and after spread values and return both, so that cashflows can be computed both ways. This may require this function to be redesigned or split into pieces (e.g. factor out the post-spread processing).  Rate treatments are described in Section 6 of the 2021 ISDA Definitions.  Negative treatment does not correctly support the case where compounded periods are applicable and will need to be enhanced for that case when compounding calculations are developed." ;
    common_domain_model:rosetta_functions "[{\"name\":\"ApplyFloatingRateProcessing\",\"description\":\"Perform rate treatments on floating rates, such as applying spreads, multipliers, caps and floors, rounding, and negative interest treatment. TODO: initialRate needs to be supported.  Also, to support compounding methods, it may be necessary to split the before spread and after spread values and return both, so that cashflows can be computed both ways. This may require this function to be redesigned or split into pieces (e.g. factor out the post-spread processing).  Rate treatments are described in Section 6 of the 2021 ISDA Definitions.  Negative treatment does not correctly support the case where compounded periods are applicable and will need to be enhanced for that case when compounding calculations are developed.\",\"inputs\":[{\"name\":\"processing\",\"type\":\"FloatingRateProcessingParameters\",\"cardinality\":\"1..1\"},{\"name\":\"rawRate\",\"type\":\"number\",\"cardinality\":\"1..1\"},{\"name\":\"calculationPeriod\",\"type\":\"CalculationPeriodBase\",\"cardinality\":\"1..1\"},{\"name\":\"isInitialPeriod\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"details\",\"type\":\"FloatingRateProcessingDetails\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:FloatingRateProcessingParameters a owl:Class ;
    rdfs:label "FloatingRateProcessingParameters" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Rounding ;
            owl:onProperty common_domain_model:rounding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:capRate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:rounding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:treatment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialRate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:negativeTreatment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:multiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:multiplier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:spread ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:rounding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:spread ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:capRate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:treatment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:floorRate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Price ;
            owl:onProperty common_domain_model:initialRate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:negativeTreatment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:floorRate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialRate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:spread ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NegativeInterestRateTreatmentEnum ;
            owl:onProperty common_domain_model:negativeTreatment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:multiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RateTreatmentEnum ;
            owl:onProperty common_domain_model:treatment ] ;
    skos:definition "Type to hold the processing parameters that should be or were used to calculate a floating amount.  These parameters can vary over a schedule so this type holds the acutal values applicable to this calculation." ;
    skos:inScheme common_domain_model:cdm_product_asset_floatingrate ;
    skos:note "Rosetta func: ApplyCapsAndFloors — Apply any cap or floor rate as a constraint on a regular swap rate, as discussed in the 2021 ISDA Definitions, section 6.5.8 and 6.5.9.",
        "Rosetta func: ApplyFloatingRatePostSpreadProcessing — Perform post-spread rate treatments on floating rates, such as applying caps and floors, rounding, and negative interest treatment.  TODOO:  initialRate needs to be supported.  Also, to support compounding methods, it may be necessary to split the before spread and after spread values and return both, so that cashflows can be computed both ways.  This may require this function to be redesigned or split into pieces (e.g. factor out the post-spread processing).",
        "Rosetta func: ApplyFloatingRateProcessing — Perform rate treatments on floating rates, such as applying spreads, multipliers, caps and floors, rounding, and negative interest treatment. TODO: initialRate needs to be supported.  Also, to support compounding methods, it may be necessary to split the before spread and after spread values and return both, so that cashflows can be computed both ways. This may require this function to be redesigned or split into pieces (e.g. factor out the post-spread processing).  Rate treatments are described in Section 6 of the 2021 ISDA Definitions.  Negative treatment does not correctly support the case where compounded periods are applicable and will need to be enhanced for that case when compounding calculations are developed.",
        "Rosetta func: GetFloatingRateProcessingParameters — Determine the processing parameters to use from the InterestRatePayout by looking them up if necessary from the corresponding schedules in the interest rate stream." ;
    common_domain_model:rosetta_functions "[{\"name\":\"GetFloatingRateProcessingParameters\",\"description\":\"Determine the processing parameters to use from the InterestRatePayout by looking them up if necessary from the corresponding schedules in the interest rate stream.\",\"inputs\":[{\"name\":\"interestRatePayout\",\"type\":\"InterestRatePayout\",\"cardinality\":\"1..1\"},{\"name\":\"calculationPeriod\",\"type\":\"CalculationPeriodBase\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"processingParameters\",\"type\":\"FloatingRateProcessingParameters\",\"cardinality\":\"1..1\"}},{\"name\":\"ApplyFloatingRateProcessing\",\"description\":\"Perform rate treatments on floating rates, such as applying spreads, multipliers, caps and floors, rounding, and negative interest treatment. TODO: initialRate needs to be supported.  Also, to support compounding methods, it may be necessary to split the before spread and after spread values and return both, so that cashflows can be computed both ways. This may require this function to be redesigned or split into pieces (e.g. factor out the post-spread processing).  Rate treatments are described in Section 6 of the 2021 ISDA Definitions.  Negative treatment does not correctly support the case where compounded periods are applicable and will need to be enhanced for that case when compounding calculations are developed.\",\"inputs\":[{\"name\":\"processing\",\"type\":\"FloatingRateProcessingParameters\",\"cardinality\":\"1..1\"},{\"name\":\"rawRate\",\"type\":\"number\",\"cardinality\":\"1..1\"},{\"name\":\"calculationPeriod\",\"type\":\"CalculationPeriodBase\",\"cardinality\":\"1..1\"},{\"name\":\"isInitialPeriod\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"details\",\"type\":\"FloatingRateProcessingDetails\",\"cardinality\":\"1..1\"}},{\"name\":\"ApplyFloatingRatePostSpreadProcessing\",\"description\":\"Perform post-spread rate treatments on floating rates, such as applying caps and floors, rounding, and negative interest treatment.  TODOO:  initialRate needs to be supported.  Also, to support compounding methods, it may be necessary to split the before spread and after spread values and return both, so that cashflows can be computed both ways.  This may require this function to be redesigned or split into pieces (e.g. factor out the post-spread processing).\",\"inputs\":[{\"name\":\"inputRate\",\"type\":\"number\",\"cardinality\":\"1..1\"},{\"name\":\"processing\",\"type\":\"FloatingRateProcessingParameters\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"processedRate\",\"type\":\"number\",\"cardinality\":\"1..1\"}},{\"name\":\"ApplyCapsAndFloors\",\"description\":\"Apply any cap or floor rate as a constraint on a regular swap rate, as discussed in the 2021 ISDA Definitions, section 6.5.8 and 6.5.9.\",\"inputs\":[{\"name\":\"processing\",\"type\":\"FloatingRateProcessingParameters\",\"cardinality\":\"1..1\"},{\"name\":\"inputRate\",\"type\":\"number\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"cappedAndFlooredRate\",\"type\":\"number\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:FrenchLawAddendum a owl:Class ;
    rdfs:label "FrenchLawAddendum" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FrenchLawAddendumElection ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyElection ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isApplicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:isApplicable ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:isApplicable ] ;
    skos:definition "A class to specify party specific elections when a Collateral Transfer Agreement is governed by French Law." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
