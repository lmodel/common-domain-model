        <https://w3id.org/lmodel/common-domain-model/ZeroEventEnum#TerminationEventAllAffectedTransactions> .

common_domain_model:additionalHaircutPercentage a owl:DatatypeProperty ;
    rdfs:label "additionalHaircutPercentage" ;
    rdfs:range xsd:decimal ;
    skos:definition "Percentage value of any additional haircut to be applied to a collateral asset,the percentage value is expressed as the discount haircut to the value of the collateral- as an example a 5% haircut would be expressed as 0.05." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:assetType a owl:ObjectProperty ;
    rdfs:label "assetType" ;
    rdfs:range common_domain_model:AssetTypeEnum ;
    skos:closeMatch fpml_5_10:AssetBase.assetType ;
    skos:definition "Specifies the type of asset." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:coveredTransactions a owl:ObjectProperty ;
    rdfs:label "coveredTransactions" ;
    rdfs:range common_domain_model:CoveredTransactions ;
    skos:definition "The specification of transactions covered by the terms of the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:creditNotation a owl:ObjectProperty ;
    rdfs:label "creditNotation" ;
    rdfs:range common_domain_model:CreditNotation ;
    skos:definition "Specifies only one credit notation is determined." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:dateTime a owl:DatatypeProperty ;
    rdfs:label "dateTime" ;
    rdfs:range xsd:dateTime ;
    skos:definition "The CDM specifies that the zoned date time is to be expressed in accordance with ISO 8601, either as UTC as an offset to UTC." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:dayOfWeek a owl:ObjectProperty ;
    rdfs:label "dayOfWeek" ;
    rdfs:range common_domain_model:DayOfWeekEnum ;
    skos:closeMatch fpml_5_10:CalculationFrequency.dayOfWeek ;
    skos:definition "Specifies the day of the week if used." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:floatingRate a owl:ObjectProperty ;
    rdfs:label "floatingRate" ;
    rdfs:range common_domain_model:StubFloatingRate ;
    skos:definition "The rates to be applied to the initial or final stub may be the linear interpolation of two different rates. While the majority of the time, the rate indices will be the same as that specified in the stream and only the tenor itself will be different, it is possible to specift two different rates. For example, a 2 month stub period may use the linear interpolation of a 1 month and 3 month rate. The different rates would be specified in this component. Note that a maximum of two rates can be specified. If a stub period uses the same floating rate index, including tenor, as the regular calculation periods then this should not be specified again within this component, i.e. the stub calculation period amount component may not need to be specified even if there is an initial or final stub period. If a stub period uses a different floating rate index compared to the regular calculation periods then this should be specified within this component. If specified here, they are likely to have id attributes, allowing them to be referenced from within the cashflows component." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:fundType a owl:ObjectProperty ;
    rdfs:label "fundType" ;
    rdfs:range common_domain_model:FundProductTypeEnum ;
    skos:definition "Identifies the type of fund." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:fxHaircutPercentage a owl:DatatypeProperty ;
    rdfs:label "fxHaircutPercentage" ;
    rdfs:range xsd:decimal ;
    skos:definition "FX Haircut Percentage means, for any item of Eligible Collateral (IM), the percentage specified in accordance with Paragraph 13." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:haircutPercentage a owl:DatatypeProperty ;
    rdfs:label "haircutPercentage" ;
    rdfs:range xsd:decimal ;
    skos:definition "Valuation Percentage means, for any item of Eligible Collateral (IM), the percentage specified in accordance with Paragraph 13." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:mismatchResolution a owl:ObjectProperty ;
    rdfs:label "mismatchResolution" ;
    rdfs:range common_domain_model:CreditNotationMismatchResolutionEnum ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:observationDate a owl:DatatypeProperty ;
    rdfs:label "observationDate" ;
    rdfs:range xsd:date ;
    skos:definition "Specifies the date value to use when resolving the market data." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:otherLanguage a owl:DatatypeProperty ;
    rdfs:label "otherLanguage" ;
    rdfs:range xsd:string ;
    skos:definition "Bespoke execution language to be included when specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:postingParty a owl:ObjectProperty ;
    rdfs:label "postingParty" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "The Posting Party for the purposes of One Way Provisions. It is specified in the case where the One Way Provision is deemed applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:referenceAgency a owl:ObjectProperty ;
    rdfs:label "referenceAgency" ;
    rdfs:range common_domain_model:CreditRatingAgencyEnum ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:timestamp a owl:DatatypeProperty ;
    rdfs:label "timestamp" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time of the last valuation marked to market, provided by the central counterparty (CCP) or calculated using the current or last available market price of the inputs." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:tradeReference a owl:ObjectProperty ;
    rdfs:label "tradeReference" ;
    rdfs:range common_domain_model:Trade ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:AdjustableDates a owl:Class ;
    rdfs:label "AdjustableDates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dateAdjustments ] ;
    skos:closeMatch fpml_5_10:AdjustableDates ;
    skos:definition "A class for defining a series of dates that shall be subject to adjustment if they would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the dates." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: AdjustedDate — if adjustedDate is absent then unadjustedDate exists and dateAdjustments exists",
        "Rosetta func: AdjustableDatesResolution — Prioritization of unadjustedDate over adjustedDate." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"AdjustableDatesResolution\",\"description\":\"Prioritization of unadjustedDate over adjustedDate.\",\"inputs\":[{\"name\":\"adjustableDates\",\"type\":\"AdjustableDates\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"0..*\"}}]" .

common_domain_model:AgencyRatingCriteria a owl:Class ;
    rdfs:label "AgencyRatingCriteria" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:referenceAgency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:mismatchResolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CreditNotationBoundaryEnum ;
            owl:onProperty common_domain_model:boundary ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:boundary ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CreditNotation ;
            owl:onProperty common_domain_model:creditNotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CreditRatingAgencyEnum ;
            owl:onProperty common_domain_model:referenceAgency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:creditNotation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:referenceAgency ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CreditNotationMismatchResolutionEnum ;
            owl:onProperty common_domain_model:mismatchResolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:boundary ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:creditNotation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:mismatchResolution ] ;
    skos:closeMatch fpml_5_10:AgencyRatingCriteria ;
    skos:definition "Represents a class to specify a credit notation." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:note "Rosetta condition: ReferenceAgency — if mismatchResolution = CreditNotationMismatchResolutionEnum -> ReferenceAgency then referenceAgency exists",
        "Rosetta func: CheckAgencyRating" ;
    common_domain_model:rosetta_functions "[{\"name\":\"CheckAgencyRating\",\"inputs\":[{\"name\":\"agencyRatings\",\"type\":\"AgencyRatingCriteria\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:AllEligibilityToHoldCollateralCriteria a owl:Class ;
    rdfs:label "AllEligibilityToHoldCollateralCriteria" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllEligibilityToHoldCollateralCriteria common_domain_model:AnyEligibilityToHoldCollateralCriteria common_domain_model:RatingAgencyValue common_domain_model:AmountOfNetCapital ) ] common_domain_model:EligibilityToHoldCollateralCriteria ) ] ;
            owl:onProperty common_domain_model:allCriteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:allCriteria ] ;
    skos:definition "Used to combine two or more Criteria using AND logic." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:AmountOfNetCapital a owl:Class ;
    rdfs:label "AmountOfNetCapital" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:amountOfNetCapital ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:amountOfNetCapital ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:amountOfNetCapital ] ;
    skos:definition "The amount of net capital." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:AnyEligibilityToHoldCollateralCriteria a owl:Class ;
    rdfs:label "AnyEligibilityToHoldCollateralCriteria" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:anyCriteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllEligibilityToHoldCollateralCriteria common_domain_model:AnyEligibilityToHoldCollateralCriteria common_domain_model:RatingAgencyValue common_domain_model:AmountOfNetCapital ) ] common_domain_model:EligibilityToHoldCollateralCriteria ) ] ;
            owl:onProperty common_domain_model:anyCriteria ] ;
    skos:definition "Used to combine two or more Criteria using OR logic." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:ArithmeticOperationEnum a owl:Class ;
    rdfs:label "ArithmeticOperationEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ArithmeticOperationEnum#Add> <https://w3id.org/lmodel/common-domain-model/ArithmeticOperationEnum#Subtract> <https://w3id.org/lmodel/common-domain-model/ArithmeticOperationEnum#Multiply> <https://w3id.org/lmodel/common-domain-model/ArithmeticOperationEnum#Divide> <https://w3id.org/lmodel/common-domain-model/ArithmeticOperationEnum#Max> <https://w3id.org/lmodel/common-domain-model/ArithmeticOperationEnum#Min> ) ;
