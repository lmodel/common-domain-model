            owl:onProperty common_domain_model:transferIneligibilityDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:specifiedParty ] ;
    skos:definition "Identifies collateral that has been designated as not meeting the eligibility criteria set out in the agreement." ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"13\" clause \"(c)(iii)\" name \"Legally Ineligible Credit Support (VM)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

<https://w3id.org/lmodel/common-domain-model/InflationCalculationMethodEnum#Ratio> a owl:Class ;
    rdfs:label "Ratio" ;
    rdfs:subClassOf common_domain_model:InflationCalculationMethodEnum ;
    skos:definition "(Inflation Index Final / Inflation Index Base). Inflation Index Final is inflation index for Reference Month that is the Lag number of months prior to Payment Date (subject to interpolation). Inflation Index Base subject to the Calculation Style. Used in inflation asset swaps to calculate the inflation coupons and principal exchange." .

<https://w3id.org/lmodel/common-domain-model/InflationCalculationMethodEnum#Return> a owl:Class ;
    rdfs:label "Return" ;
    rdfs:subClassOf common_domain_model:InflationCalculationMethodEnum ;
    skos:definition "(Inflation Index Final / Inflation Index Base -1). Inflation Index Final is the inflation index for Reference Month that is the Lag number of months prior to Payment Date (subject to interp). Inflation Index Base subject to the Calculation Style. Used in market standard ZC Inflation swaps." .

<https://w3id.org/lmodel/common-domain-model/InflationCalculationMethodEnum#Spread> a owl:Class ;
    rdfs:label "Spread" ;
    rdfs:subClassOf common_domain_model:InflationCalculationMethodEnum ;
    skos:definition "Inflation Index Final - Inflation Index Base). Inflation Index Final is Index for Ref month the Lag months prior to Payment Date (subject to interp). Inflation Index Base subject to the Calculation Style. Typically used for fixing locks." .

<https://w3id.org/lmodel/common-domain-model/InflationCalculationStyleEnum#YearOnYear> a owl:Class ;
    rdfs:label "YearOnYear" ;
    rdfs:subClassOf common_domain_model:InflationCalculationStyleEnum ;
    skos:definition "YearOnYear means Inflation Index Base is the inflation index for Reference Month that is 12 months prior to Inflation Index Final (subject to interpolation). Inflation Index Base is cashflow dependent." .

<https://w3id.org/lmodel/common-domain-model/InflationCalculationStyleEnum#ZeroCoupon> a owl:Class ;
    rdfs:label "ZeroCoupon" ;
    rdfs:subClassOf common_domain_model:InflationCalculationStyleEnum ;
    skos:definition "ZeroCoupon means Inflation Index Base used in the CalculationMethod is the inflation index for the Reference Month that is the lag number of months prior to Effective Date in the case of a swap, or Bond Interest Accrual Date in the case of an Asset Swap (subject to interpolation). Inflation Index Base has the same value for each inflation cashflow and Principal Exchange calculation within the trade." .

common_domain_model:InflationIndex a owl:Class ;
    rdfs:label "InflationIndex" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:inflationRateIndex ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:indexTenor ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:InflationRateIndexEnum ;
            owl:onProperty common_domain_model:inflationRateIndex ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Period ;
            owl:onProperty common_domain_model:indexTenor ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:inflationRateIndex ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:indexTenor ],
        common_domain_model:IndexBase ;
    skos:definition "Specification of an index that measures inflation in a specific market, e.g. the US Consumer Price Index." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Rosetta condition: InterestRateAssetClass — assetClass = AssetClassEnum -> InterestRate" .

