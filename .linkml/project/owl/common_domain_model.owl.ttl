<https://w3id.org/lmodel/common-domain-model/PriceSubTypeEnum#Fee> a owl:Class ;
    rdfs:label "Fee" ;
    rdfs:subClassOf common_domain_model:PriceSubTypeEnum ;
    skos:definition "The lending fee associated with borrowing a security." .

<https://w3id.org/lmodel/common-domain-model/PriceSubTypeEnum#Rebate> a owl:Class ;
    rdfs:label "Rebate" ;
    rdfs:subClassOf common_domain_model:PriceSubTypeEnum ;
    skos:definition "Denotes any rebate that is attributed to the cashflow. For example, where a lender will provide a rebate on the cash given to them by the borrower as collateral on a securities lending trade. " .

<https://w3id.org/lmodel/common-domain-model/PriceTimingEnum#ClosingPrice> a owl:Class ;
    rdfs:label "ClosingPrice" ;
    rdfs:subClassOf common_domain_model:PriceTimingEnum ;
    skos:definition "The last price anyone paid for a share of a product during the business hours of the exchange where the product is traded on a business day." .

<https://w3id.org/lmodel/common-domain-model/PriceTimingEnum#OpeningPrice> a owl:Class ;
    rdfs:label "OpeningPrice" ;
    rdfs:subClassOf common_domain_model:PriceTimingEnum ;
    skos:definition "The first price anyone paid for a share of a product during the business hours of the exchange where the product is traded on a business day." .

<https://w3id.org/lmodel/common-domain-model/PriceTypeEnum#AssetPrice> a owl:Class ;
    rdfs:label "AssetPrice" ;
    rdfs:subClassOf common_domain_model:PriceTypeEnum ;
    skos:definition "Denotes a price expressed as a cash amount in a given currency to purchase a unit of an asset (e.g. a security or a commodity)." .

<https://w3id.org/lmodel/common-domain-model/PriceTypeEnum#Correlation> a owl:Class ;
    rdfs:label "Correlation" ;
    rdfs:subClassOf common_domain_model:PriceTypeEnum ;
    skos:definition "Denotes a price expressed as the weighted average of all pairwise correlation coefficients." .

<https://w3id.org/lmodel/common-domain-model/PriceTypeEnum#Dividend> a owl:Class ;
    rdfs:label "Dividend" ;
    rdfs:subClassOf common_domain_model:PriceTypeEnum ;
    skos:definition "Denotes a price expressed as the dividend payment from a index or share." .

<https://w3id.org/lmodel/common-domain-model/PriceTypeEnum#ExchangeRate> a owl:Class ;
    rdfs:label "ExchangeRate" ;
    rdfs:subClassOf common_domain_model:PriceTypeEnum ;
    skos:definition "Denotes a rate to convert one currency or other measure of value to another. Foreign Exchange rates are represented in decimals, e.g. {amount, unitOfAmount, PerUnitOfAmount} = [1.23, USD, GBP] = USD 1.23 for every 1 GBP." .

<https://w3id.org/lmodel/common-domain-model/PriceTypeEnum#InterestRate> a owl:Class ;
    rdfs:label "InterestRate" ;
    rdfs:subClassOf common_domain_model:PriceTypeEnum ;
    skos:definition "Denotes a price expressed as a rate to be applied to quantity/notional amount and represented as decimal, e.g. {amount, unitOfAmount, PerUnitOfAmount} = [0.08, EUR, EUR] = 8%  of the EUR notional quantity/amount or 8 cents for every EUR of notional amount." .

<https://w3id.org/lmodel/common-domain-model/PriceTypeEnum#Premium> a owl:Class ;
    rdfs:label "Premium" ;
    rdfs:subClassOf common_domain_model:PriceTypeEnum ;
    skos:definition "Denotes the amount payable by the buyer to the seller for an option. The premium is paid on the specified premium payment date or on each premium payment date if specified." .

<https://w3id.org/lmodel/common-domain-model/PriceTypeEnum#Variance> a owl:Class ;
    rdfs:label "Variance" ;
    rdfs:subClassOf common_domain_model:PriceTypeEnum ;
    skos:definition "Denotes a price expressed as the the arithmetic average of the squared differences from the mean value of an observable price." .

<https://w3id.org/lmodel/common-domain-model/PriceTypeEnum#Volatility> a owl:Class ;
    rdfs:label "Volatility" ;
    rdfs:subClassOf common_domain_model:PriceTypeEnum ;
    skos:definition "Denotes a price expressed as the the square root of the arithmetic average of the squared differences from the mean value of an observable price." .

common_domain_model:PricingDates a owl:Class ;
    rdfs:label "PricingDates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableDates ;
            owl:onProperty common_domain_model:specifiedDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:parametricDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:parametricDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:specifiedDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ParametricDates ;
            owl:onProperty common_domain_model:parametricDates ] ;
    skos:definition "Specifies specific dates or parametric rules for the dates on which the price will be determined" ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:PrincipalPaymentSchedule a owl:Class ;
    rdfs:label "PrincipalPaymentSchedule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PrincipalPayment ;
            owl:onProperty common_domain_model:initialPrincipalPayment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialPrincipalPayment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:intermediatePrincipalPayment ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableRelativeOrPeriodicDates ;
            owl:onProperty common_domain_model:intermediatePrincipalPayment ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PrincipalPayment ;
            owl:onProperty common_domain_model:finalPrincipalPayment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:finalPrincipalPayment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:finalPrincipalPayment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:intermediatePrincipalPayment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialPrincipalPayment ] ;
    skos:definition "Describe dates schedules for Principal Exchanges and related role of the parties when known." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    skos:note "Rosetta condition: InitialPrincipalAmountExists — if initialPrincipalPayment exists then initialPrincipalPayment -> principalAmount exists or initialPrincipalPayment -> presentValuePrincipalAmount exists" .

common_domain_model:PrincipalPayments a owl:Class ;
    rdfs:label "PrincipalPayments" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:principalPaymentSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:intermediatePayment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:initialPayment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:intermediatePayment ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PrincipalPaymentSchedule ;
            owl:onProperty common_domain_model:principalPaymentSchedule ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:initialPayment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:varyingLegNotionalCurrency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:finalPayment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:principalPaymentSchedule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:intermediatePayment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:finalPayment ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:varyingLegNotionalCurrency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialPayment ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:finalPayment ] ;
    skos:definition "A class defining which principal exchanges occur for the stream." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    common_domain_model:metadata_key true .

