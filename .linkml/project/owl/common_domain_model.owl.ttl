common_domain_model:EligibilityQuery a owl:Class ;
    rdfs:label "EligibilityQuery" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:assetCountryOfOrigin ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:maturity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CollateralIssuerType ;
            owl:onProperty common_domain_model:issuerType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:assetCountryOfOrigin ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:maturity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalEntity ;
            owl:onProperty common_domain_model:issuerName ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CurrencyCodeEnum ;
            owl:onProperty common_domain_model:denominatedCurrency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:issuerName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:agencyRating ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:issuerType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:agencyRating ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:collateralAssetType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:collateralAssetType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:maturity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AgencyRatingCriteria ;
            owl:onProperty common_domain_model:agencyRating ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:issuerName ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:denominatedCurrency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:denominatedCurrency ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AssetType ;
            owl:onProperty common_domain_model:collateralAssetType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:issuerType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ISOCountryCodeEnum ;
            owl:onProperty common_domain_model:assetCountryOfOrigin ] ;
    skos:definition "Query to check against an EligibleCollateralSpecification" ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:note "Rosetta func: CheckAgencyRating",
        "Rosetta func: CheckAssetType",
        "Rosetta func: CheckCountryOfOrigin",
        "Rosetta func: CheckCriteria — This function takes a single criteria and evaluates it against the criteria.  This function handles the recursive use of AND and OR logic.",
        "Rosetta func: CheckDebtType",
        "Rosetta func: CheckDenominatedCurrency",
        "Rosetta func: CheckEligibilityByDetails — This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.",
        "Rosetta func: CheckIssuerName",
        "Rosetta func: CheckIssuerType",
        "Rosetta func: CheckMaturity" ;
    common_domain_model:rosetta_functions "[{\"name\":\"CheckEligibilityByDetails\",\"description\":\"This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.\",\"inputs\":[{\"name\":\"specification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"eligibilityResult\",\"type\":\"CheckEligibilityResult\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckCriteria\",\"description\":\"This function takes a single criteria and evaluates it against the criteria.  This function handles the recursive use of AND and OR logic.\",\"inputs\":[{\"name\":\"inputCriteria\",\"type\":\"CollateralCriteria\",\"cardinality\":\"1..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEligible\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckCountryOfOrigin\",\"inputs\":[{\"name\":\"countryOfOrigin\",\"type\":\"ISOCountryCodeEnum\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckAgencyRating\",\"inputs\":[{\"name\":\"agencyRatings\",\"type\":\"AgencyRatingCriteria\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckAssetType\",\"inputs\":[{\"name\":\"collateralAssetTypes\",\"type\":\"AssetType\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckDebtType\",\"inputs\":[{\"name\":\"collateralDebtTypes\",\"type\":\"DebtType\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckDenominatedCurrency\",\"inputs\":[{\"name\":\"denominatedCurrency\",\"type\":\"CurrencyCodeEnum\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckMaturity\",\"inputs\":[{\"name\":\"maturityRange\",\"type\":\"AssetMaturity\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckIssuerName\",\"inputs\":[{\"name\":\"issuerName\",\"type\":\"IssuerName\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckIssuerType\",\"inputs\":[{\"name\":\"issuerType\",\"type\":\"CollateralIssuerType\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:EligibleCollateralSpecification a owl:Class ;
    rdfs:label "EligibleCollateralSpecification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:partyRole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:counterparty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:criteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PartyRole ;
            owl:onProperty common_domain_model:partyRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Counterparty ;
            owl:onProperty common_domain_model:counterparty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Identifier ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllEligibilityToHoldCollateralCriteria common_domain_model:AnyEligibilityToHoldCollateralCriteria common_domain_model:RatingAgencyValue common_domain_model:AmountOfNetCapital ) ] common_domain_model:EligibleCollateralCriteria ) ] ;
            owl:onProperty common_domain_model:criteria ] ;
    skos:definition "Represents a set of criteria used to specify eligible collateral." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:note "Rosetta func: CheckEligibilityByDetails — This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.",
        "Rosetta func: CheckEligibilityForProduct",
        "Rosetta func: CloneEligibleCollateralWithChangedTreatment — Creates a new Eligible Collateral Specification based on an input specification but with one changed criteria and with one changed treatment." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"CloneEligibleCollateralWithChangedTreatment\",\"description\":\"Creates a new Eligible Collateral Specification based on an input specification but with one changed criteria and with one changed treatment.\",\"inputs\":[{\"name\":\"inputSpecification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"},{\"name\":\"changedCriteria\",\"type\":\"CollateralCriteria\",\"cardinality\":\"1..1\"},{\"name\":\"changedTreatment\",\"type\":\"CollateralTreatment\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"outputSpecification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckEligibilityForProduct\",\"inputs\":[{\"name\":\"specifications\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..*\"},{\"name\":\"product\",\"type\":\"TransferableProduct\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"eligibilityResult\",\"type\":\"CheckEligibilityResult\",\"cardinality\":\"0..1\"},\"code_implementation\":true},{\"name\":\"CheckEligibilityByDetails\",\"description\":\"This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.\",\"inputs\":[{\"name\":\"specification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"eligibilityResult\",\"type\":\"CheckEligibilityResult\",\"cardinality\":\"1..1\"}}]" .

