common_domain_model:Counterparty a owl:Class ;
    rdfs:label "Counterparty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:role ] ;
    skos:closeMatch gist:Assignment,
        oscal:ResponsibleParty ;
    skos:definition "Defines a counterparty enumerated value, e.g. Party1 or Party2, with an associated party reference. The product is agnostic to the actual parties to the transaction, with the party references abstracted away from the product definition and replaced by the CounterpartyEnum (e.g. values Party1 or Party2). The CounterpartyEnum can then be positioned in the product (e.g. to specify which counterparty is the payer, receiver etc) and this Counterparty type, which is positioned outside of the product definition, allows the CounterpartyEnum to be associated with an actual party reference." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:note "Rosetta func: ExtractCounterpartyByRole — Extracts from a list of Counterparty data types, the Counterparty that corresponds to the role i.e. Party1 or Party2." ;
    skos:relatedMatch iso29100:ThirdParty ;
    common_domain_model:rosetta_functions "[{\"name\":\"ExtractCounterpartyByRole\",\"description\":\"Extracts from a list of Counterparty data types, the Counterparty that corresponds to the role i.e. Party1 or Party2.\",\"inputs\":[{\"name\":\"counterparties\",\"type\":\"Counterparty\",\"cardinality\":\"1..*\"},{\"name\":\"roleEnumToExtract\",\"type\":\"CounterpartyRoleEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"counterparty\",\"type\":\"Counterparty\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:CreditDefaultPayout a owl:Class ;
    rdfs:label "CreditDefaultPayout" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
