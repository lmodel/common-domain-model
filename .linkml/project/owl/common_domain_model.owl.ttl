    rdfs:label "ISDA2010EquityEMEAInterdealer" ;
    rdfs:subClassOf common_domain_model:MasterConfirmationTypeEnum ;
    skos:definition "The ISDA 2010 EMEA EM Interdealer Master Equity Derivatives Confirmation Agreement applies." .

<http://www.fpml.org/coding-scheme/master-confirmation-type-7-7#ISDA2013VolatilitySwapAmericas> a owl:Class ;
    rdfs:label "ISDA2013VolatilitySwapAmericas" ;
    rdfs:subClassOf common_domain_model:MasterConfirmationTypeEnum ;
    skos:definition "The ISDA 2013 Americas Master Volatility Swap Confirmation Agreement applies." .

<http://www.fpml.org/coding-scheme/master-confirmation-type-7-7#ISDA2013VolatilitySwapAsiaExcludingJapan> a owl:Class ;
    rdfs:label "ISDA2013VolatilitySwapAsiaExcludingJapan" ;
    rdfs:subClassOf common_domain_model:MasterConfirmationTypeEnum ;
    skos:definition "The ISDA 2013 AEJ Master Volatility Swap Confirmation Agreement applies." .

<http://www.fpml.org/coding-scheme/master-confirmation-type-7-7#ISDA2013VolatilitySwapEuropean> a owl:Class ;
    rdfs:label "ISDA2013VolatilitySwapEuropean" ;
    rdfs:subClassOf common_domain_model:MasterConfirmationTypeEnum ;
    skos:definition "The ISDA 2013 European Volatility Swap Master Confirmation Agreement applies." .

<http://www.fpml.org/coding-scheme/master-confirmation-type-7-7#ISDA2013VolatilitySwapJapanese> a owl:Class ;
    rdfs:label "ISDA2013VolatilitySwapJapanese" ;
    rdfs:subClassOf common_domain_model:MasterConfirmationTypeEnum ;
    skos:definition "The ISDA 2013 Volatility Swap Japanese Confirmation Agreement applies." .

<http://www.fpml.org/coding-scheme/matrix-type-1-1#CreditDerivativesPhysicalSettlementMatrix> a owl:Class ;
    rdfs:label "CreditDerivativesPhysicalSettlementMatrix" ;
    rdfs:subClassOf common_domain_model:MatrixTypeEnum ;
    skos:definition "The ISDA-published Credit Derivatives Physical Settlement Matrix." .

<http://www.fpml.org/coding-scheme/matrix-type-1-1#EquityDerivativesMatrix> a owl:Class ;
    rdfs:label "EquityDerivativesMatrix" ;
    rdfs:subClassOf common_domain_model:MatrixTypeEnum ;
    skos:definition "The ISDA-published Equity Derivatives Matrix." .

<http://www.fpml.org/coding-scheme/matrix-type-1-1#SettlementMatrix> a owl:Class ;
    rdfs:label "SettlementMatrix" ;
    rdfs:subClassOf common_domain_model:MatrixTypeEnum ;
    skos:definition "The ISDA-published 2000 ISDA Definitions Settlement Matrix for Early Terminations and Swaptions." .

<http://www.fpml.org/coding-scheme/option-type-1-0#Straddle> a owl:Class ;
    rdfs:label "Straddle" ;
    rdfs:subClassOf common_domain_model:OptionTypeEnum ;
    skos:definition "A straddle strategy, which involves the simultaneous buying of a put and a call of the same underlier, at the same strike and same expiration date" .

<http://www.fpml.org/coding-scheme/party-role-4-0#Accountant> a owl:Class ;
    rdfs:label "Accountant" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization responsible for preparing the accounting for the trade." .

<http://www.fpml.org/coding-scheme/party-role-4-0#AllocationAgent> a owl:Class ;
    rdfs:label "AllocationAgent" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The organization responsible for supplying the allocations for a trade to be allocated to multiple accounts/organizations." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ArrangingBroker> a owl:Class ;
    rdfs:label "ArrangingBroker" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The organization that arranged the trade, i.e. brought together the counterparties.  Synonyms/Alternatives: Inter-dealer broker, agent." .

<http://www.fpml.org/coding-scheme/party-role-4-0#Beneficiary> a owl:Class ;
    rdfs:label "Beneficiary" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization that suffers the economic benefit of the trade.  The beneficiary may be distinct from the principal/counterparty - an example occurs when a hedge fund trades via a prime broker; in this case the principal is the prime broker, but the beneficiary is the hedge fund.  This can be represented as a payer/receiver account in the name of the hedge fund, but it is also possible to add the party role of 'Beneficiary' at the partyTradeInformation level." .

<http://www.fpml.org/coding-scheme/party-role-4-0#BookingParty> a owl:Class ;
    rdfs:label "BookingParty" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The entity for which the organization supporting the trade's processing has booked/recorded the trade. This is used in non-reporting workflows situations in which the trade doesn\\'t need to be reported but a firm still wants to specify their own side." .

<http://www.fpml.org/coding-scheme/party-role-4-0#Buyer> a owl:Class ;
    rdfs:label "Buyer" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Acquirer of the legal title to the financial instrument. In the case of an option, the buyer is the holder of the option. In the case of a swap or forward, the buyer will be determined by industry best practice.  This does not refer to an investor or investment manager or other organization on what is typically called  the 'Buy side'; for that, see the 'Client' role. Corresponds to 'Buyer' as defined in certain regulations such as ESMA MiFID II/MIFIR RTS 22 field 9." .

<http://www.fpml.org/coding-scheme/party-role-4-0#BuyerDecisionMaker> a owl:Class ;
    rdfs:label "BuyerDecisionMaker" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The party or person who, having legal authority to act on behalf of the trade counterparty acting as Buyer as defined in this coding scheme, made the decision to acquire the financial instrument. Corresponds to 'buyer decision maker' as defined in ESMA\\'s MIFIR RTS 23 report. This does not refer to the decision maker for what is traditionally called the 'Buy side'; for that, see the 'Client Decision Maker' role." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ClearingClient> a owl:Class ;
    rdfs:label "ClearingClient" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "An organization that clears trades through a clearing house, via a clearing broker (member of the clearing house) who acts as an agent on its behalf. The term 'client' refers to the organization\\'s role in the clearing process in relation to its clearing broker, and not whether it is a price maker or taker in the execution process." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ClearingExceptionParty> a owl:Class ;
    rdfs:label "ClearingExceptionParty" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "A party to the trade that claims a clearing exception, such as an end-user exception under Dodd-Frank Act provisions." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ClearingFirm> a owl:Class ;
    rdfs:label "ClearingFirm" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization that submits the trade to a clearing house on behalf of the principal. Synonyms/alternates: Futures Commission Merchant (FCM), Clearing Broker, Clearing Member Firm. Some implementations use 'Clearing Broker' as synonym." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ClearingOrganization> a owl:Class ;
    rdfs:label "ClearingOrganization" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The organization that acts as a central counterparty to clear a derivatives contract.  This is used to represent the role of Central Counterparties (CCPs) or Derivative Clearing Organizations (DCOs).  Sometimes called 'ClearingService'. Some implementations also use the term 'Clearer'." .

<http://www.fpml.org/coding-scheme/party-role-4-0#Client> a owl:Class ;
    rdfs:label "Client" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Client as defined under ESMA MIFIR. This is generally the investor or other client of an investment firm, and is synonymous with the Beneficiary in many circumstances." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ClientDecisionMaker> a owl:Class ;
    rdfs:label "ClientDecisionMaker" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The party or person who, having legal authority to act on behalf of a trade counterparty, made the decision to acquire or sell the financial instrument." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ConfirmationPlatform> a owl:Class ;
    rdfs:label "ConfirmationPlatform" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization serving as a financial intermediary for the purposes of electronic confirmation or providing services for post-processing of transactional data." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ContractualParty> a owl:Class ;
    rdfs:label "ContractualParty" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "A party to a contractual document.  If the intended usage relates to the context of the trade lifecycle, more specific annotations have been defined which might be more appropriate." .

<http://www.fpml.org/coding-scheme/party-role-4-0#CounterPartyAffiliate> a owl:Class ;
    rdfs:label "CounterPartyAffiliate" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization officially attached to the counterparty. e.g. partner, branch, subsidiary." .

<http://www.fpml.org/coding-scheme/party-role-4-0#CounterPartyUltimateParent> a owl:Class ;
    rdfs:label "CounterPartyUltimateParent" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The topmost entity or organization, within the corporate hierarchy, responsible for the reporting party." .

<http://www.fpml.org/coding-scheme/party-role-4-0#Counterparty> a owl:Class ;
    rdfs:label "Counterparty" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "An economic counterparty to the trade. Synonym: principal." .

<http://www.fpml.org/coding-scheme/party-role-4-0#CreditSupportProvider> a owl:Class ;
    rdfs:label "CreditSupportProvider" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization that enhances the credit of another organization (similar to guarantor, but may not fully guarantee the obligation)." .

<http://www.fpml.org/coding-scheme/party-role-4-0#Custodian> a owl:Class ;
    rdfs:label "Custodian" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization that maintains custody of the asset represented by the trade on behalf of the owner/principal." .

<http://www.fpml.org/coding-scheme/party-role-4-0#DataSubmitter> a owl:Class ;
    rdfs:label "DataSubmitter" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Entity submitting the transaction report to the competent authority." .

<http://www.fpml.org/coding-scheme/party-role-4-0#DisputingParty> a owl:Class ;
    rdfs:label "DisputingParty" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization that is disputing the trade or transaction." .

<http://www.fpml.org/coding-scheme/party-role-4-0#DocumentRepository> a owl:Class ;
    rdfs:label "DocumentRepository" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "A marketplace organization which purpose is to maintain document records.  If the intended usage relates to the context of the trade lifecycle, more specific annotations have been defined which might be more appropriate." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ExecutingBroker> a owl:Class ;
    rdfs:label "ExecutingBroker" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The (generally sell-side) organization that executed the trade; the price-making party." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ExecutingEntity> a owl:Class ;
    rdfs:label "ExecutingEntity" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Entity executing the transaction.  If the transaction is executed directly by the reporting party, it will be the reporting party.  If it is executed by an execution agent or an affiliated party on behalf of the reporting party, it will be that affiliate or agent." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ExecutionAgent> a owl:Class ;
    rdfs:label "ExecutionAgent" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The (generally buy-side) organization that acts to execute trades on behalf of an investor. Typically this is an investment manager or asset manager, and also makes the investment decisions for the investor. If required, a separate InvestmentDecision role can be specified to distinguish that the party making the investment decision is different." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ExecutionFacility> a owl:Class ;
    rdfs:label "ExecutionFacility" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The facility, exchange, or market where the trade was executed. Synonym: Swap Execution Facility, Designated Contract Market, Execution Venue." .

<http://www.fpml.org/coding-scheme/party-role-4-0#Guarantor> a owl:Class ;
    rdfs:label "Guarantor" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization that backs (guarantees) the credit risk of the trade." .

<http://www.fpml.org/coding-scheme/party-role-4-0#OrderTransmitter> a owl:Class ;
    rdfs:label "OrderTransmitter" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The entity transmitting the order to the reporting firm. Synonym: Transmitting Firm." .

<http://www.fpml.org/coding-scheme/party-role-4-0#PrimeBroker> a owl:Class ;
    rdfs:label "PrimeBroker" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The organization that takes on or took on the credit risk for this trade by stepping in between the two economic parties (without a central counterparty clearing mechanism)." .

<http://www.fpml.org/coding-scheme/party-role-4-0#PriorTradeRepository> a owl:Class ;
    rdfs:label "PriorTradeRepository" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The trade repository at which the trade was reported previous to the current trade repository." .

<http://www.fpml.org/coding-scheme/party-role-4-0#PublicationVenue> a owl:Class ;
    rdfs:label "PublicationVenue" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The reporting service (whether trade repository, market data service, or exchange/facility/venue data distribution service) that published the report of this trade." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ReportingParty> a owl:Class ;
    rdfs:label "ReportingParty" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The party with the regulatory responsibility to report this trade." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ReportingPartyAffiliate> a owl:Class ;
    rdfs:label "ReportingPartyAffiliate" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "Organization officially attached to the reporting party  e.g. partner, branch, subsidiary." .

<http://www.fpml.org/coding-scheme/party-role-4-0#ReportingPartyUltimateParent> a owl:Class ;
    rdfs:label "ReportingPartyUltimateParent" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The topmost entity or organization, within the corporate hierarchy, responsible for the reporting party." .

<http://www.fpml.org/coding-scheme/party-role-4-0#Seller> a owl:Class ;
    rdfs:label "Seller" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "A counterparty in a trade, which performs in one of the following capacities: 1) it transfers or agrees to transfer in the future an instrument or title to that instrument in exchange for payment, 2) it writes a derivatives instrument such as an option or a swap in which it provides risk protection to the buyer. This does not refer to the broker/dealer or other organization on what is typically called  the 'Sell side'; for that, see the 'Executing Broker' role. Corresponds to 'Seller' as defined in certain regulations such as ESMA MiFID II/MIFIR RTS 22 field 16." .

<http://www.fpml.org/coding-scheme/party-role-4-0#SellerDecisionMaker> a owl:Class ;
    rdfs:label "SellerDecisionMaker" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The party or person who, having legal authority to act on behalf of the trade counterparty acting as Seller as defined in this coding scheme, made the decision to sell the financial instrument. Corresponds to 'seller decision maker' as defined in ESMA\\'s MIFIR RTS 23 report. This does not refer to the decision maker for what is traditionally called the 'Sell side'; for that, see the 'Trader' person role." .

<http://www.fpml.org/coding-scheme/party-role-4-0#SettlementAgent> a owl:Class ;
    rdfs:label "SettlementAgent" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The organization that makes or receives payments on behalf of the given principal party." .

<http://www.fpml.org/coding-scheme/party-role-4-0#TradeRepository> a owl:Class ;
    rdfs:label "TradeRepository" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "An organization that maintains records of the trade for regulatory reporting purposes." .

<http://www.fpml.org/coding-scheme/party-role-4-0#TradeSource> a owl:Class ;
    rdfs:label "TradeSource" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The organization that originally supplied the record of the trade. In the context of regulatory reporting, it is the submitter of the trade record to a regulator or TR." .

<http://www.fpml.org/coding-scheme/party-role-4-0#TradingManager> a owl:Class ;
    rdfs:label "TradingManager" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "The entity responsible for managing the assets/investments of this party.  Synonym:  Asset Manager, Investment Manager, Trading Advisory." .

<http://www.fpml.org/coding-scheme/party-role-4-0#TradingPartner> a owl:Class ;
    rdfs:label "TradingPartner" ;
    rdfs:subClassOf common_domain_model:PartyRoleEnum ;
    skos:definition "An entity with which this party trades from time to time, ie. with which it acts as a counterparty on some transactions.   This role is used for static reference data, not individual transactions." .

<http://www.fpml.org/coding-scheme/resource-type-1-1#Confirmation> a owl:Class ;
    rdfs:label "Confirmation" ;
    rdfs:subClassOf common_domain_model:ResourceTypeEnum ;
    skos:definition "Document describing the legal terms of a transaction." .

<http://www.fpml.org/coding-scheme/resource-type-1-1#SupplementalMaterialEconomicTerms> a owl:Class ;
    rdfs:label "SupplementalMaterialEconomicTerms" ;
    rdfs:subClassOf common_domain_model:ResourceTypeEnum ;
    skos:definition "Document providing supplemental material economic terms to the FpML data representation. The initial intended usage is to fulfill the CFTC Part 45 rule requirement to report ‘Any other terms(s) of the swap matched or affirmed by the counterparties in verifying the swap’ when the reporting is done via the generic FpML representation." .

<http://www.fpml.org/coding-scheme/resource-type-1-1#TermSheet> a owl:Class ;
    rdfs:label "TermSheet" ;
    rdfs:subClassOf common_domain_model:ResourceTypeEnum ;
    skos:definition "Document describing the economic characteristics of a transaction." .

<http://www.fpml.org/coding-scheme/restructuring-1-1#ModModR> a owl:Class ;
    rdfs:label "ModModR" ;
    rdfs:subClassOf common_domain_model:RestructuringEnum ;
    skos:definition "Restructuring (Section 4.7) and Modified Restructuring Maturity Limitation and Conditionally Transferable Obligation (2014 Definitions: Section 3.31, 2003 Definitions: 2.32) apply." .

<http://www.fpml.org/coding-scheme/restructuring-1-1#ModR> a owl:Class ;
    rdfs:label "ModR" ;
    rdfs:subClassOf common_domain_model:RestructuringEnum ;
    skos:definition "Restructuring (Section 4.7) and Restructuring Maturity Limitation and Fully Transferable Obligation (2014 Definitions: Section 3.31, 2003 Definitions: 2.32) apply." .

<http://www.fpml.org/coding-scheme/restructuring-1-1#R> a owl:Class ;
    rdfs:label "R" ;
    rdfs:subClassOf common_domain_model:RestructuringEnum ;
    skos:definition "Restructuring as defined in the applicable ISDA Credit Derivatives Definitions. (2003 or 2014)." .

<http://www.fpml.org/coding-scheme/settled-entity-matrix-source-1-0#ConfirmationAnnex> a owl:Class ;
    rdfs:label "ConfirmationAnnex" ;
    rdfs:subClassOf common_domain_model:SettledEntityMatrixSourceEnum ;
    skos:definition "The Relevant Settled Entity Matrix shall be the list agreed for this purpose by the parties. The list is not included as part of the electronic confirmation." .

<http://www.fpml.org/coding-scheme/settled-entity-matrix-source-1-0#NotApplicable> a owl:Class ;
    rdfs:label "NotApplicable" ;
    rdfs:subClassOf common_domain_model:SettledEntityMatrixSourceEnum ;
    skos:definition "The term is not applicable." .

<http://www.fpml.org/coding-scheme/settled-entity-matrix-source-1-0#Publisher> a owl:Class ;
    rdfs:label "Publisher" ;
    rdfs:subClassOf common_domain_model:SettledEntityMatrixSourceEnum ;
    skos:definition "The Settled Entity Matrix published by the Index Publisher." .

<http://www.fpml.org/coding-scheme/spread-schedule-type-1-0#Long> a owl:Class ;
    rdfs:label "Long" ;
    rdfs:subClassOf common_domain_model:SpreadScheduleTypeEnum ;
    skos:definition "Represents a Long Spread Schedule. Spread schedules defined as 'Long' will be applied to Long Positions." .

<http://www.fpml.org/coding-scheme/spread-schedule-type-1-0#Short> a owl:Class ;
    rdfs:label "Short" ;
    rdfs:subClassOf common_domain_model:SpreadScheduleTypeEnum ;
    skos:definition "Represents a Short Spread Schedule. Spread schedules defined as 'Short' will be applied to Short Positions." .

common_domain_model:AccrualFactor a owl:Class ;
    rdfs:label "AccrualFactor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:calculationTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AccrualFactorCalculationTerms ;
            owl:onProperty common_domain_model:calculationTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationTerms ] ;
    skos:closeMatch fpml_5_10:AccrualFactor ;
    skos:definition "The accrual rate and related terms, to adjust the price of an underlier impacted by a Corporate Action when economic impact consists in freezing the underlier price to the last fixing then applying accruals per each remaining underlier price fixing date required i.e. for each fixing date, adjustedPrice = lastFixingPrice x accrualFactor, where: accrualFactor = (1 + accrualRateValue x DCF)." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: AccrualPriceIsRate — value -> priceType = PriceTypeEnum -> InterestRate" .

<https://w3id.org/lmodel/common-domain-model/ActionEnum#Cancel> a owl:Class ;
    rdfs:label "Cancel" ;
    rdfs:subClassOf common_domain_model:ActionEnum ;
    skos:definition "A cancellation of a prior instance of the transaction event. The eventIdentifier has an associated version greater than 1." .

<https://w3id.org/lmodel/common-domain-model/ActionEnum#Correct> a owl:Class ;
    rdfs:label "Correct" ;
    rdfs:subClassOf common_domain_model:ActionEnum ;
    skos:definition "A correction of a prior instance of the transaction event. The eventIdentifier has an associated version greater than 1." .

<https://w3id.org/lmodel/common-domain-model/ActionEnum#New> a owl:Class ;
    rdfs:label "New" ;
    rdfs:subClassOf common_domain_model:ActionEnum ;
    skos:definition "A new instance of a transaction event, which is also characterized by the fact that the eventIdentifier has an associated version 1." .

common_domain_model:AdditionalFixedPayments a owl:Class ;
    rdfs:label "AdditionalFixedPayments" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:interestShortfallReimbursement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:principalShortfallReimbursement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:writedownReimbursement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:principalShortfallReimbursement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:interestShortfallReimbursement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:principalShortfallReimbursement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:interestShortfallReimbursement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:writedownReimbursement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:writedownReimbursement ] ;
    skos:closeMatch fpml_5_10:AdditionalFixedPayments ;
    skos:definition "A class to specify the events that will give rise to the payment additional fixed payments." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:AdditionalRepresentation a owl:Class ;
    rdfs:label "AdditionalRepresentation" ;
