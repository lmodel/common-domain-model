            owl:allValuesFrom common_domain_model:PriceTypeEnum ;
            owl:onProperty common_domain_model:priceType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:priceType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSubTypeEnum ;
            owl:onProperty common_domain_model:priceSubType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:composite ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ArithmeticOperationEnum ;
            owl:onProperty common_domain_model:arithmeticOperator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:priceExpression ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:arithmeticOperator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:perUnitOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:perUnitOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:arithmeticOperator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:premiumType ],
        common_domain_model:MeasureSchedule ;
    skos:definition "Specifies the price of a financial instrument in a trade as a schedule of measures. A price generically expresses the value of an exchange as a ratio: it measures the amount of one thing needed to be exchanged for 1 unit of another thing (e.g. cash in a specific currency in exchange for a bond or share). This generic representation can be used to support any type of financial price beyond just cash price: e.g. an interest rate, a foreign exchange rate, etc. This data type is generically based on a schedule and can also be used to represent a price as a single value." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Rosetta condition: AccruedInterest — if composite -> operandType = AccruedInterest then priceType = AssetPrice",
        "Rosetta condition: ArithmeticOperator — arithmeticOperator <> Subtract and arithmeticOperator <> Divide",
        "Rosetta condition: Choice — optional choice arithmeticOperator, composite",
        "Rosetta condition: CurrencyUnitForInterestRate — if priceType = PriceTypeEnum -> InterestRate then unit -> currency exists",
        "Rosetta condition: ForwardPoint — if composite -> operandType = ForwardPoint then priceType = ExchangeRate",
        "Rosetta condition: InterestRateFeeType — if priceSubType = Fee or priceSubType = Rebate then priceType = InterestRate",
        "Rosetta condition: PositiveAssetPrice — if (priceType = ExchangeRate or priceType = AssetPrice) and arithmeticOperator is absent then value > 0 or datedValue -> value all > 0",
        "Rosetta condition: PositivePremium — if priceType = Premium then value > 0",
        "Rosetta condition: PositiveSpotRate — if (priceType = ExchangeRate or priceType = AssetPrice) and composite -> baseValue exists then composite -> baseValue > 0",
        "Rosetta condition: Premium — if premiumType exists then priceType = Premium",
        "Rosetta condition: SpreadPrice — if arithmeticOperator = Add then priceType = AssetPrice or priceType = InterestRate",
        "Rosetta condition: UnitOfAmountExists — if priceType = Variance or priceType = Volatility or priceType = Correlation then unit is absent and perUnitOf is absent else unit exists and perUnitOf exists",
        "Rosetta func: FilterPrice — Filter list of prices based on price type." ;
    common_domain_model:rosetta_functions "[{\"name\":\"FilterPrice\",\"description\":\"Filter list of prices based on price type.\",\"inputs\":[{\"name\":\"prices\",\"type\":\"PriceSchedule\",\"cardinality\":\"0..*\"},{\"name\":\"priceType\",\"type\":\"PriceTypeEnum\",\"cardinality\":\"1..1\"},{\"name\":\"arithmeticOperators\",\"type\":\"ArithmeticOperationEnum\",\"cardinality\":\"0..*\"},{\"name\":\"priceExpression\",\"type\":\"PriceExpressionEnum\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"price\",\"type\":\"PriceSchedule\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:RelativeDateOffset a owl:Class ;
    rdfs:label "RelativeDateOffset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessCenters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessCentersReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dateRelativeTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenters ;
            owl:onProperty common_domain_model:businessCenters ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayConventionEnum ;
            owl:onProperty common_domain_model:businessDayConvention ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateRelativeTo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessDayConvention ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenters ;
            owl:onProperty common_domain_model:businessCentersReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:dateRelativeTo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessCenters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessCentersReference ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:businessDayConvention ],
        common_domain_model:Offset ;
    skos:definition "A class defining a date (referred to as the derived date) as a relative offset from another date (referred to as the anchor date). If the anchor date is itself an adjustable date then the offset is assumed to be calculated from the adjusted anchor date. A number of different scenarios can be supported, namely; 1) the derived date may simply be a number of calendar periods (days, weeks, months or years) preceding or following the anchor date; 2) the unadjusted derived date may be a number of calendar periods (days, weeks, months or years) preceding or following the anchor date with the resulting unadjusted derived date subject to adjustment in accordance with a specified business day convention, i.e. the derived date must fall on a good business day; 3) the derived date may be a number of business days preceding or following the anchor date. Note that the businessDayConvention specifies any required adjustment to the unadjusted derived date. A negative or positive value in the periodMultiplier indicates whether the unadjusted derived precedes or follows the anchor date. The businessDayConvention should contain a value NONE if the day type element contains a value of Business (since specifying a negative or positive business days offset would already guarantee that the derived date would fall on a good business day in the specified business centers)." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

