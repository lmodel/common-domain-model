common_domain_model:WorkflowStep a owl:Class ;
    rdfs:label "WorkflowStep" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:action ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:WorkflowState ;
            owl:onProperty common_domain_model:workflowState ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Lineage ;
            owl:onProperty common_domain_model:lineage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:creditLimitInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:eventIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CreditLimitInformation ;
            owl:onProperty common_domain_model:creditLimitInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:creditLimitInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:nextEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Account ;
            owl:onProperty common_domain_model:account ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:messageInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:account ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:counterpartyPositionBusinessEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:approval ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:workflowState ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:rejected ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:lineage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:counterpartyPositionBusinessEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ActionEnum ;
            owl:onProperty common_domain_model:action ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:proposedEvent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:rejected ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:workflowState ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessEvent ;
            owl:onProperty common_domain_model:businessEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MessageInformation ;
            owl:onProperty common_domain_model:messageInformation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:action ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:nextEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EventInstruction ;
            owl:onProperty common_domain_model:proposedEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Identifier ;
            owl:onProperty common_domain_model:eventIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:lineage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:previousWorkflowStep ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyPositionBusinessEvent ;
            owl:onProperty common_domain_model:counterpartyPositionBusinessEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:previousWorkflowStep ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:timestamp ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:rejected ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EventInstruction ;
            owl:onProperty common_domain_model:nextEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:proposedEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EventTimestamp ;
            owl:onProperty common_domain_model:timestamp ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:messageInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:WorkflowStep ;
            owl:onProperty common_domain_model:previousWorkflowStep ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:WorkflowStepApproval ;
            owl:onProperty common_domain_model:approval ] ;
    skos:definition "A workflow step represents the state of a business event. The workflow step contains a reference to a previous WorkflowStep in order to preserve lineage. A workflow step is accepted if it contains a business event, proposed if proposedEvent is present and is rejected if the rejected flag is set." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    skos:note "Rosetta condition: CounterpartyPositionBusinessEventOrBusinessEventOrProposedEventChoice — required choice counterpartyPositionBusinessEvent, businessEvent, proposedEvent",
        "Rosetta condition: WorkflowStepStatus — (businessEvent exists and nextEvent -> instruction is absent and rejected is absent) or (nextEvent -> instruction exists and businessEvent is absent and rejected is absent) or (rejected exists and businessEvent is absent and nextEvent is absent) or (proposedEvent exists and nextEvent is absent and rejected is absent) or (previousWorkflowStep exists and action = ActionEnum -> Cancel)",
        "Rosetta func: Create_AcceptedWorkflowStep — Represents the acceptance of a proposed instruction that results in a workflow step containing a business event, message details, identifiers, event timestamps, parties and accounts. The previous workflow step input must exist to provide workflow lineage. The instruction from the previous workflow step should be used with a [creation BusinessEvent] function to create the input business event passed into this function e.g. PartyChangeInstruction from the previous step is used with Create_PartyChange to produce the business event which should used as an input to this step.",
        "Rosetta func: Create_AcceptedWorkflowStepFromInstruction — Represents the acceptance of a proposed instruction that results in a workflow step containing a business event, message details, identifiers, event timestamps, parties and accounts. The previous workflow step input must exist to provide workflow lineage. The instruction from the previous workflow step should be used with a [creation BusinessEvent] function to create the input business event passed into this function e.g. PartyChangeInstruction from the previous step is used with Create_PartyChange to produce the business event which should used as an input to this step.",
        "Rosetta func: Create_ProposedWorkflowStep — Represents the proposal to create a business event that results in a workflow step containing an instruction, message details, identifiers, event timestamps, parties and accounts. The optional previous workflow step input provides workflow lineage to where there has been a correction or cancellation to the proposed step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New.",
        "Rosetta func: Create_RejectedWorkflowStep — Represents the rejection of a proposed instruction that results in a workflow step containing the rejection flag, message details, identifiers, event timestamps, parties and accounts involved in the step. The previous workflow step input must exist to provide workflow lineage. This function will be further developed to provide the reasons for rejection.",
        "Rosetta func: Create_Workflow — Function to create a Workflow from a list of WorkflowStep.",
        "Rosetta func: Create_WorkflowStep — Function to create a workflow step with a business event and associated details about the message, identifiers, event timestamps, parties and accounts involved in the step. The function should be used when there is already a fully formed business event with the action set to signify that the step is new, or a correction/cancellation of a previous step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> New, New -> Correct, New -> Cancel, Correct -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_WorkflowStep\",\"description\":\"Function to create a workflow step with a business event and associated details about the message, identifiers, event timestamps, parties and accounts involved in the step. The function should be used when there is already a fully formed business event with the action set to signify that the step is new, or a correction/cancellation of a previous step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> New, New -> Correct, New -> Cancel, Correct -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New.\",\"inputs\":[{\"name\":\"messageInformation\",\"type\":\"MessageInformation\",\"cardinality\":\"0..1\"},{\"name\":\"timestamp\",\"type\":\"EventTimestamp\",\"cardinality\":\"1..*\"},{\"name\":\"eventIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"1..*\"},{\"name\":\"party\",\"type\":\"Party\",\"cardinality\":\"0..*\"},{\"name\":\"account\",\"type\":\"Account\",\"cardinality\":\"0..*\"},{\"name\":\"previousWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"0..1\"},{\"name\":\"action\",\"type\":\"ActionEnum\",\"cardinality\":\"1..1\"},{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"workflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_AcceptedWorkflowStep\",\"description\":\"Represents the acceptance of a proposed instruction that results in a workflow step containing a business event, message details, identifiers, event timestamps, parties and accounts. The previous workflow step input must exist to provide workflow lineage. The instruction from the previous workflow step should be used with a [creation BusinessEvent] function to create the input business event passed into this function e.g. PartyChangeInstruction from the previous step is used with Create_PartyChange to produce the business event which should used as an input to this step.\",\"inputs\":[{\"name\":\"messageInformation\",\"type\":\"MessageInformation\",\"cardinality\":\"0..1\"},{\"name\":\"timestamp\",\"type\":\"EventTimestamp\",\"cardinality\":\"1..*\"},{\"name\":\"eventIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"1..*\"},{\"name\":\"party\",\"type\":\"Party\",\"cardinality\":\"0..*\"},{\"name\":\"account\",\"type\":\"Account\",\"cardinality\":\"0..*\"},{\"name\":\"proposedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"},{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"acceptedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_AcceptedWorkflowStepFromInstruction\",\"description\":\"Represents the acceptance of a proposed instruction that results in a workflow step containing a business event, message details, identifiers, event timestamps, parties and accounts. The previous workflow step input must exist to provide workflow lineage. The instruction from the previous workflow step should be used with a [creation BusinessEvent] function to create the input business event passed into this function e.g. PartyChangeInstruction from the previous step is used with Create_PartyChange to produce the business event which should used as an input to this step.\",\"inputs\":[{\"name\":\"proposedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"acceptedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_ProposedWorkflowStep\",\"description\":\"Represents the proposal to create a business event that results in a workflow step containing an instruction, message details, identifiers, event timestamps, parties and accounts. The optional previous workflow step input provides workflow lineage to where there has been a correction or cancellation to the proposed step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New.\",\"inputs\":[{\"name\":\"messageInformation\",\"type\":\"MessageInformation\",\"cardinality\":\"0..1\"},{\"name\":\"timestamp\",\"type\":\"EventTimestamp\",\"cardinality\":\"1..*\"},{\"name\":\"eventIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"1..*\"},{\"name\":\"party\",\"type\":\"Party\",\"cardinality\":\"0..*\"},{\"name\":\"account\",\"type\":\"Account\",\"cardinality\":\"0..*\"},{\"name\":\"previousWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"0..1\"},{\"name\":\"action\",\"type\":\"ActionEnum\",\"cardinality\":\"1..1\"},{\"name\":\"proposedEvent\",\"type\":\"EventInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"approval\",\"type\":\"WorkflowStepApproval\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"proposedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_RejectedWorkflowStep\",\"description\":\"Represents the rejection of a proposed instruction that results in a workflow step containing the rejection flag, message details, identifiers, event timestamps, parties and accounts involved in the step. The previous workflow step input must exist to provide workflow lineage. This function will be further developed to provide the reasons for rejection.\",\"inputs\":[{\"name\":\"messageInformation\",\"type\":\"MessageInformation\",\"cardinality\":\"0..1\"},{\"name\":\"timestamp\",\"type\":\"EventTimestamp\",\"cardinality\":\"1..*\"},{\"name\":\"eventIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"1..*\"},{\"name\":\"proposedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"rejectedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_Workflow\",\"description\":\"Function to create a Workflow from a list of WorkflowStep.\",\"inputs\":[{\"name\":\"steps\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..*\"}],\"output\":{\"name\":\"workflow\",\"type\":\"Workflow\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:accruedInterest a owl:DatatypeProperty ;
    rdfs:label "accruedInterest" ;
    rdfs:range xsd:boolean ;
    skos:closeMatch fpml_5_10:CashSettlementTerms.accruedInterest ;
    skos:definition "Indicates whether accrued interest is included (true) or not (false). For cash settlement this specifies whether quotations should be obtained inclusive or not of accrued interest. For physical settlement this specifies whether the buyer should deliver the obligation with an outstanding principal balance that includes or excludes accrued interest. ISDA 2003 Term: Include/Exclude Accrued Interest." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:acctOwnr a owl:ObjectProperty ;
    rdfs:label "acctOwnr" ;
    rdfs:range common_domain_model:AcctOwnr ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#AcctOwnr> .

common_domain_model:additionalRegime a owl:DatatypeProperty ;
    rdfs:label "additionalRegime" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:ApplicableRegime.additionalRegime ;
    skos:definition "The additional regulatory regime as specified by the parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

