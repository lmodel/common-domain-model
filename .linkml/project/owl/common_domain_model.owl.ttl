common_domain_model:entityType a owl:ObjectProperty ;
    rdfs:label "entityType" ;
    rdfs:range common_domain_model:EntityTypeEnum ;
    skos:definition "Defines the reference entity types corresponding to a list of types in the ISDA First to Default documentation." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:equityAdditionalTerms a owl:ObjectProperty ;
    rdfs:label "equityAdditionalTerms" ;
    rdfs:range common_domain_model:EquityAdditionalTerms ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:equityCashSettlementDates a owl:ObjectProperty ;
