    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." .

common_domain_model:RatingAgencyValue a owl:Class ;
    rdfs:label "RatingAgencyValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:ratingType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RatingTypeEnum ;
            owl:onProperty common_domain_model:ratingType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:ratingType ],
        common_domain_model:CreditNotation ;
    skos:definition "A logical container designed to hold a set of related data. In this case the Rating Agency, Rating Value and Rating Type." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta condition: AgencyValueType — ((agency exists and notation exists and ratingType exists) or (agency is absent and notation is absent and ratingType is absent)) and (scale is absent and debt is absent and outlook is absent and creditWatch is absent)" .

common_domain_model:ScheduledTransfer a owl:Class ;
    rdfs:label "ScheduledTransfer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AssetPayout common_domain_model:CommodityPayout common_domain_model:CreditDefaultPayout common_domain_model:FixedPricePayout common_domain_model:InterestRatePayout common_domain_model:OptionPayout common_domain_model:PerformancePayout common_domain_model:SettlementPayout ) ] common_domain_model:Payout ) ] ;
            owl:onProperty common_domain_model:payoutReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:corporateActionTransferType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:transferType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CorporateActionTypeEnum ;
            owl:onProperty common_domain_model:corporateActionTransferType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:corporateActionTransferType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:payoutReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ScheduledTransferEnum ;
            owl:onProperty common_domain_model:transferType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:transferType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:payoutReference ],
        common_domain_model:TransferBase ;
    skos:definition "A scheduled transfer built into the contract." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: CorporateActionTransferTypeExists — if transferType = ScheduledTransferEnum -> CorporateAction then corporateActionTransferType exists" .

common_domain_model:Transfer a owl:Class ;
    rdfs:label "Transfer" ;
    skos:definition "The type of transfer." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." .

common_domain_model:ValueSecuritiesEnum a owl:Class ;
    rdfs:label "ValueSecuritiesEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ValueSecuritiesEnum#BidPricePercentage> <https://w3id.org/lmodel/common-domain-model/ValueSecuritiesEnum#BidPricePercentageLessHaircut> <https://w3id.org/lmodel/common-domain-model/ValueSecuritiesEnum#MidPricePercentage> <https://w3id.org/lmodel/common-domain-model/ValueSecuritiesEnum#MidPricePercentageLessHaircut> <https://w3id.org/lmodel/common-domain-model/ValueSecuritiesEnum#Other> ) ;
