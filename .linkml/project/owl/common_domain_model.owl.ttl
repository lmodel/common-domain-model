common_domain_model:CurrencyCodeEnum a owl:Class ;
    rdfs:label "CurrencyCodeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#CNH> <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#CNT> <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#GGP> <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#IMP> <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#JEP> <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#KID> <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#MCF> <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#SML> <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#VAL> ) ;
    skos:definition "Union of the enumerated values defined by the International Standards Organization (ISO) and the FpML nonISOCurrencyScheme which consists of offshore and historical currencies (https://www.fpml.org/coding-scheme/non-iso-currency), as of 28-Oct-2016." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#CNH>,
        <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#CNT>,
        <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#GGP>,
        <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#IMP>,
        <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#JEP>,
        <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#KID>,
        <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#MCF>,
        <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#SML>,
        <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum#VAL> .

common_domain_model:TimeZone a owl:Class ;
    rdfs:label "TimeZone" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:location ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:time ;
            owl:onProperty common_domain_model:time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:location ] ;
    skos:definition "The time alongside with the timezone location information. This class makes use of the FpML TimezoneLocation construct." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta func: TimeZoneFromBusinessCenterTime — Function to resolve a time passed as BusinessCenterTime into a TimeZone time." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"TimeZoneFromBusinessCenterTime\",\"description\":\"Function to resolve a time passed as BusinessCenterTime into a TimeZone time.\",\"inputs\":[{\"name\":\"time\",\"type\":\"BusinessCenterTime\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"TimeZone\",\"cardinality\":\"1..1\"},\"code_implementation\":true}]" .

common_domain_model:businessCenters a owl:ObjectProperty ;
    rdfs:label "businessCenters" ;
    rdfs:range common_domain_model:BusinessCenters ;
    skos:closeMatch fpml_5_10:BusinessDateRange.businessCenters ;
    skos:definition "The business center(s), specified either explicitly or by reference to those specified somewhere else in the instance document." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:floatingRateIndex a owl:ObjectProperty ;
    rdfs:label "floatingRateIndex" ;
    rdfs:range common_domain_model:FloatingRateIndexEnum ;
    skos:definition "The reference index that is used to specify the floating interest rate." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:valuationDate a owl:ObjectProperty ;
    rdfs:label "valuationDate" ;
    rdfs:range common_domain_model:CSAValuationDate ;
    skos:closeMatch fpml_5_10:CalculationAndTimingLegacy.valuationDate ;
    skos:definition "Details of the days on which calculations are to be made to determine the Delivery Amount and/or Return Amount." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:adjustedDate a owl:DatatypeProperty ;
    rdfs:label "adjustedDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:AdjustableDate.adjustedDate ;
    skos:definition "The date once the adjustment has been performed. (Note that this date may change if the business center holidays change)." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:partyRole a owl:ObjectProperty ;
    rdfs:label "partyRole" ;
    rdfs:range common_domain_model:PartyRole ;
    skos:definition "Specifies an additional party roles to be added on to the new transaction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:period a owl:ObjectProperty ;
    rdfs:label "period" ;
    rdfs:range common_domain_model:PeriodExtendedEnum ;
    skos:definition "A time period, e.g. a day, week, month, year or term of the stream." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:BusinessDayAdjustments a owl:Class ;
    rdfs:label "BusinessDayAdjustments" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessCenters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessCenters ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:businessDayConvention ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenters ;
            owl:onProperty common_domain_model:businessCenters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessDayConvention ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayConventionEnum ;
            owl:onProperty common_domain_model:businessDayConvention ] ;
    skos:closeMatch fpml_5_10:BusinessDayAdjustments ;
    skos:definition "A class defining the business day convention and financial business centers used for adjusting any relevant date if it would otherwise fall on a day that is not a business day in the specified business center." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    common_domain_model:metadata_key true .

