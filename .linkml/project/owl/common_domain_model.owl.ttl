    common_domain_model:rosetta_functions "[{\"name\":\"CheckMaturity\",\"inputs\":[{\"name\":\"maturityRange\",\"type\":\"AssetMaturity\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}}]" .

