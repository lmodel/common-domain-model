common_domain_model:Party a owl:Class ;
    rdfs:label "Party" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NaturalPerson ;
            owl:onProperty common_domain_model:person ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Account ;
            owl:onProperty common_domain_model:account ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:account ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ContactInformation ;
            owl:onProperty common_domain_model:contactInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessUnit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:account ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PartyIdentifier ;
            owl:onProperty common_domain_model:partyId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:contactInformation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:contactInformation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NaturalPersonRole ;
            owl:onProperty common_domain_model:personRole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:person ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:personRole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessUnit ;
            owl:onProperty common_domain_model:businessUnit ] ;
    skos:broadMatch iso29100:PrivacyStakeholder ;
    skos:closeMatch spdx:Agent,
        gist:Organization,
        oscal:Party ;
    skos:definition "A class to specify a party, without a qualification as to whether this party is a legal entity or a natural person, although the model provides the ability to associate a person (or set of persons) to a party, which use case would imply that such party would be a legal entity (even if not formally specified as such). " ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:note "Rosetta func: ReplaceParty — Removes the old party, and adds the new party." ;
    skos:relatedMatch gist:Person ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"ReplaceParty\",\"description\":\"Removes the old party, and adds the new party.\",\"inputs\":[{\"name\":\"parties\",\"type\":\"Party\",\"cardinality\":\"0..*\"},{\"name\":\"oldParty\",\"type\":\"Party\",\"cardinality\":\"1..1\"},{\"name\":\"newParty\",\"type\":\"Party\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"updatedParties\",\"type\":\"Party\",\"cardinality\":\"0..*\"}}]" .

