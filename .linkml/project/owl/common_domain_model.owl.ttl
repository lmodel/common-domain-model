common_domain_model:TradeLot a owl:Class ;
    rdfs:label "TradeLot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Identifier ;
            owl:onProperty common_domain_model:lotIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:lotIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:priceQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceQuantity ;
            owl:onProperty common_domain_model:priceQuantity ] ;
    skos:definition "Specifies the price and quantity of a trade lot, where the same product could be traded multiple times with the same counterparty but in different lots (at a different date, in a different quantity and at a different price). One trade lot combined with a product definition specifies the entire economics of a trade. The lifecycle mechanics of each such trade lot (e.g. cashflow payments) is independent of the other lots." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Rosetta func: AddTradeLot — Add a TradeLot to an existing list of TradeLots.",
        "Rosetta func: CompareTradeLot — Compare the Quantity in TradeLot 1 to the Quantity (with the same unit of amount) in TradeLot 2, based on the CompareOp enum.",
        "Rosetta func: CompareTradeLotToAmount — Compare the Quantity amount in TradeLot to the given amount (regardless of unit of amount), based on the CompareOp enum.",
        "Rosetta func: FilterTradeLot — Filter list of TradeLot based on TradeLot->lotIdentifier.",
        "Rosetta func: PriceQuantityTriangulation — Defines all the scenarios which triangulation can be helpful validation between Prices and Quantities.",
        "Rosetta func: ReplaceTradeLot — Replace TradeLot in with matching TradeLot->lotIdentifier." ;
    common_domain_model:rosetta_functions "[{\"name\":\"FilterTradeLot\",\"description\":\"Filter list of TradeLot based on TradeLot->lotIdentifier.\",\"inputs\":[{\"name\":\"tradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"},{\"name\":\"lotIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"filteredTradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"}},{\"name\":\"AddTradeLot\",\"description\":\"Add a TradeLot to an existing list of TradeLots.\",\"inputs\":[{\"name\":\"tradableProduct\",\"type\":\"TradableProduct\",\"cardinality\":\"1..1\"},{\"name\":\"newTradeLot\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"updatedTradableProduct\",\"type\":\"TradableProduct\",\"cardinality\":\"1..1\"}},{\"name\":\"ReplaceTradeLot\",\"description\":\"Replace TradeLot in with matching TradeLot->lotIdentifier.\",\"inputs\":[{\"name\":\"tradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"},{\"name\":\"newTradeLot\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"mergedTradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"}},{\"name\":\"CompareTradeLot\",\"description\":\"Compare the Quantity in TradeLot 1 to the Quantity (with the same unit of amount) in TradeLot 2, based on the CompareOp enum.\",\"inputs\":[{\"name\":\"tradeLot1\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"},{\"name\":\"op\",\"type\":\"CompareOp\",\"cardinality\":\"1..1\"},{\"name\":\"tradeLot2\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CompareTradeLotToAmount\",\"description\":\"Compare the Quantity amount in TradeLot to the given amount (regardless of unit of amount), based on the CompareOp enum.\",\"inputs\":[{\"name\":\"tradeLot\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"},{\"name\":\"op\",\"type\":\"CompareOp\",\"cardinality\":\"1..1\"},{\"name\":\"amount\",\"type\":\"number\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"PriceQuantityTriangulation\",\"description\":\"Defines all the scenarios which triangulation can be helpful validation between Prices and Quantities.\",\"inputs\":[{\"name\":\"tradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"success\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:Tranche a owl:Class ;
    rdfs:label "Tranche" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:attachmentPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:exhaustionPoint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:attachmentPoint ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:exhaustionPoint ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:incurredRecoveryApplicable ],
