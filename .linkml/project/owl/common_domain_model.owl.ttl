common_domain_model:IndexTransitionInstruction a owl:Class ;
    rdfs:label "IndexTransitionInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:cashTransfer ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:ScheduledTransfer common_domain_model:UnscheduledTransfer ) ] common_domain_model:Transfer ) ] ;
            owl:onProperty common_domain_model:cashTransfer ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:cashTransfer ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:priceQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceQuantity ;
            owl:onProperty common_domain_model:priceQuantity ] ;
    skos:definition "Defines the information needed to create a Index Transition Business Event." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: PriceQuantity — priceQuantity -> price -> priceType contains PriceTypeEnum -> InterestRate and priceQuantity -> observable -> Index -> InterestRateIndex exists and priceQuantity -> quantity is absent",
        "Rosetta func: Create_IndexTransitionTermsChange — Function specification to create a terms change that contains changes to the floating rate indexes and adds an adjustment spread to any existing spread." ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_IndexTransitionTermsChange\",\"description\":\"Function specification to create a terms change that contains changes to the floating rate indexes and adds an adjustment spread to any existing spread.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"IndexTransitionInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"termsChange\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:Indx a owl:Class ;
