common_domain_model:Frequency a owl:Class ;
    rdfs:label "Frequency" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:periodMultiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:periodMultiplier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:periodMultiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PeriodExtendedEnum ;
            owl:onProperty common_domain_model:period ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:period ] ;
    skos:definition "A class for defining a date frequency, e.g. one day, three months, through the combination of an integer value and a standardized period value that is specified as part of an enumeration." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: PositivePeriodMultiplier — periodMultiplier > 0",
        "Rosetta condition: TermPeriod — if period = PeriodExtendedEnum -> T then periodMultiplier = 1" ;
    common_domain_model:metadata_key true .

