	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:breakdown a owl:ObjectProperty ;
	rdfs:label "breakdown" ;
	skos:definition "Each split breakdown specifies the set of primitive instructions to be applied to a single branch of that split. N split breakdowns result in N output trades, which include the original trade. Instructions for how to handle the original trade (e.g. if it must be closed) must be specified in one of the breakdowns." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:brokerConfirmationType a owl:ObjectProperty .
common_domain_model:businessCenter a owl:ObjectProperty .
common_domain_model:businessCenters a owl:ObjectProperty .
common_domain_model:businessCentersReference a owl:ObjectProperty .
common_domain_model:businessDateRange a owl:ObjectProperty ;
	rdfs:label "businessDateRange" ;
	skos:definition "A range of contiguous business days. This attribute is meant to be merged with the 'settlementDate' at some future point once we refactor 'Date' to use a single complex type across the model. This attributes was formerly part of 'CashSettlementPaymentDate', as included into 'OptionCashSettlement' (which is now merged into a unique 'CashSettlementTerms' data type." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:businessDayConvention a owl:ObjectProperty .
common_domain_model:businessDays a owl:DatatypeProperty .
common_domain_model:businessDaysNotSpecified a owl:DatatypeProperty ;
	rdfs:label "businessDaysNotSpecified" ;
	skos:definition "An explicit indication that a number of business days are not specified and therefore ISDA fallback provisions should apply." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:businessDaysThereafter a owl:DatatypeProperty ;
	rdfs:label "businessDaysThereafter" ;
	skos:definition "The number of business days between successive valuation dates when multiple valuation dates are applicable for cash settlement. ISDA 2003 Term: Business Days thereafter." ;
	skos:inScheme common_domain_model:cdm_observable_asset .
common_domain_model:businessEvent a owl:ObjectProperty ;
	rdfs:label "businessEvent" ;
	skos:definition "Life cycle event for the step." ;
	skos:inScheme common_domain_model:cdm_event_workflow .
common_domain_model:businessUnit a owl:ObjectProperty ;
	rdfs:label "businessUnit" ;
