        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:specifiedParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:transferIneligibilityDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:totalIneligibilityDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
