        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:finalFixingDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fixingDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CalculationPeriodDates ;
            owl:onProperty common_domain_model:calculationPeriodDatesReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialFixingDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
