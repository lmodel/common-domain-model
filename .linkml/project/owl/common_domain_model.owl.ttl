common_domain_model:ExerciseNotice a owl:Class ;
    rdfs:label "ExerciseNotice" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:exerciseNoticeGiver ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AncillaryRoleEnum ;
            owl:onProperty common_domain_model:exerciseNoticeReceiver ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ExerciseNoticeGiverEnum ;
            owl:onProperty common_domain_model:exerciseNoticeGiver ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:businessCenter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:exerciseNoticeReceiver ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:exerciseNoticeGiver ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:businessCenter ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:exerciseNoticeReceiver ] ;
    skos:definition "Defines to whom and where notice of execution should be given. The exerciseNoticeGiver refers to one or both of the principal parties of the trade. If present the exerciseNoticeReceiver refers to a party, other than the principal party, to whom notice should be given." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:FloatingRateIndexCalculationMethodEnum a owl:Class ;
    rdfs:label "FloatingRateIndexCalculationMethodEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexCalculationMethodEnum#OISCompound> <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexCalculationMethodEnum#Average> <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexCalculationMethodEnum#Compounded> <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexCalculationMethodEnum#AllInCompounded> ) ;
