common_domain_model:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies the value of the measure as a number. Optional because in a measure vector or schedule, this single value may be omitted." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:currency a owl:DatatypeProperty ;
    rdfs:label "currency" ;
    rdfs:range xsd:string ;
    skos:definition "Defines the currency to be used as a unit for a price, quantity, or other purpose." ;
    skos:inScheme common_domain_model:cdm_base_math ;
    common_domain_model:metadata_scheme true .

common_domain_model:partyElection a owl:ObjectProperty ;
    rdfs:label "partyElection" ;
    rdfs:range common_domain_model:AdditionalRepresentationElection ;
    skos:closeMatch fpml_5_10:AdditionalRepresentation.partyElection ;
    skos:definition "A qualification as to whether the Additional Representation is applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

