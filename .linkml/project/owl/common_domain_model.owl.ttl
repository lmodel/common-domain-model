common_domain_model:PriceComposite a owl:Class ;
    rdfs:label "PriceComposite" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:baseValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceOperandEnum ;
            owl:onProperty common_domain_model:operandType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:operandType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:operandType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:operand ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:operand ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:arithmeticOperator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:baseValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ArithmeticOperationEnum ;
            owl:onProperty common_domain_model:arithmeticOperator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:operand ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:arithmeticOperator ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:baseValue ] ;
    skos:definition "Defines the inputs required to calculate a price as a simple composite of 2 other values. The inputs consist of 2 numbers and a simple arithmetic operator. This generic data type applies to a variety of use cases where a price is obtained by simple composition, e.g. dirty = clean + accrued (Bond), forward rate = spot rate + forward point (FX) etc." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Rosetta condition: ArithmeticOperator — if operandType = PriceOperandEnum -> ForwardPoint or operandType = PriceOperandEnum -> AccruedInterest then arithmeticOperator = ArithmeticOperationEnum -> Add or arithmeticOperator = ArithmeticOperationEnum -> Subtract" .

<https://w3id.org/lmodel/common-domain-model/PriceExpressionEnum#AbsoluteTerms> a owl:Class ;
    rdfs:label "AbsoluteTerms" ;
    rdfs:subClassOf common_domain_model:PriceExpressionEnum ;
    skos:definition "The price is expressed as an absolute amount." .

<https://w3id.org/lmodel/common-domain-model/PriceExpressionEnum#ParValueFraction> a owl:Class ;
    rdfs:label "ParValueFraction" ;
    rdfs:subClassOf common_domain_model:PriceExpressionEnum ;
    skos:definition "Denotes a price expressed in percentage of face value with fractions which is used for quoting bonds, e.g. 101 3/8 indicates that the buyer will pay 101.375 of the face value." .

<https://w3id.org/lmodel/common-domain-model/PriceExpressionEnum#PerOption> a owl:Class ;
    rdfs:label "PerOption" ;
    rdfs:subClassOf common_domain_model:PriceExpressionEnum ;
    skos:definition "Denotes a price expressed per number of options." .

<https://w3id.org/lmodel/common-domain-model/PriceExpressionEnum#PercentageOfNotional> a owl:Class ;
    rdfs:label "PercentageOfNotional" ;
    rdfs:subClassOf common_domain_model:PriceExpressionEnum ;
    skos:definition "The price is expressed in percentage of the notional amount." .

common_domain_model:PriceMateriality a owl:Class ;
    rdfs:label "PriceMateriality" ;
    rdfs:seeAlso isda:FXandCurrencyOptionsDefintions_1998 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:escrowArrangement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:priceMaterialityIsApplicable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fallbackReferencePrice ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fallbackReferencePrice ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:priceMaterialityIsApplicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EscrowArrangement ;
            owl:onProperty common_domain_model:escrowArrangement ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:priceMaterialityIsApplicable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:escrowArrangement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SettlementRateOption ;
            owl:onProperty common_domain_model:fallbackReferencePrice ] ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(x)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

