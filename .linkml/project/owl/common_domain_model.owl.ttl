	rdfs:label "controlAgreementNecEvent" ;
	skos:definition "The bespoke provisions that might be specified by the parties to the agreement applicable to a Notice of Exclusive Control Event." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:controlAgreementNecEventElection a owl:ObjectProperty ;
	rdfs:label "controlAgreementNecEventElection" ;
	skos:definition "Indicates party specific Control Agreement language related to delivery of a Notice of Exclusive Control." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:conversionFactor a owl:DatatypeProperty .
common_domain_model:copyTo a owl:DatatypeProperty ;
	rdfs:label "copyTo" ;
	skos:definition "A unique identifier (within the specified coding scheme) giving the details of some party to whom a copy of this message will be sent for reference." ;
	skos:inScheme common_domain_model:cdm_event_workflow ;
	common_domain_model:rosetta_metadata "scheme" .
