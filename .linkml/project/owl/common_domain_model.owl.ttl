        <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Submitted>,
        <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Terminated>,
        <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Uncertain>,
        <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Unconfirmed> .

common_domain_model:nonDeliverableSubstitute a owl:ObjectProperty ;
    rdfs:label "nonDeliverableSubstitute" ;
    rdfs:range common_domain_model:NonDeliverableSubstitute ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:product a owl:ObjectProperty ;
    rdfs:label "product" ;
    rdfs:range common_domain_model:NonTransferableProduct ;
    skos:definition "Defines the financial product to be executed and contract formed." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:unadjustedDate a owl:DatatypeProperty ;
    rdfs:label "unadjustedDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:AdjustableDate.unadjustedDate ;
    skos:definition "A date subject to adjustment. While in FpML this date is required, this cardinality constraint has been relaxed as part of the CDM in order to support the FRA representation, which effective and termination dates are specified in FpML as adjusted dates." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:Account a owl:Class ;
    rdfs:label "Account" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:accountBeneficiary ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:accountBeneficiary ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:accountName ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:servicingParty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:accountName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:accountNumber ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:servicingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AccountTypeEnum ;
            owl:onProperty common_domain_model:accountType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:accountName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:accountType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:accountType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:accountNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:servicingParty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:partyReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:accountNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:accountBeneficiary ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:partyReference ] ;
    skos:closeMatch gist:Account,
        fpml_5_10:Account ;
    skos:definition "A class to specify an account as an account number alongside, optionally. an account name, an account type, an account beneficiary and a servicing party." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_key true .

