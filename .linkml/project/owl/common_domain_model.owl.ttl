common_domain_model:ProductIdTypeEnum\#BBGID a owl:Class ;
	rdfs:label "BBGID" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Published by Bloomberg, the BBGID is a 12-digit alphanumeric randomly generated ID covering active and non-active securities." .
common_domain_model:ProductIdTypeEnum\#BBGTICKER a owl:Class ;
	rdfs:label "BBGTICKER" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Published by Bloomberg as a short code to identify publicly trades shares of a particular stock on a specific exchange." .
common_domain_model:ProductIdTypeEnum\#CUSIP a owl:Class ;
	rdfs:label "CUSIP" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Derived from the Committee on Uniform Security Identification Procedures, CUSIPs are 9-character identifiers that capture an issue’s important differentiating characteristics for issuers and their financial instruments in the U.S. and Canada." .
common_domain_model:ProductIdTypeEnum\#FIGI a owl:Class ;
	rdfs:label "FIGI" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Issued under the guidelines of the Object Management Group, the Financial Instrument Global Identifier (FIGI) is a 12 character, alphanumeric, randomly generated ID covering hundreds of millions of active and inactive instruments. The identifier acts as a Uniform Resource Identifier (URI) to link to a set of metadata that uniquely and clearly describes the instrument." .
common_domain_model:ProductIdTypeEnum\#ISDACRP a owl:Class ;
	rdfs:label "ISDACRP" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Issued by the International Swaps Dealers Association as a string representing a Commodity Reference Price used for purposes of determining a relevant price for an underlying commodity in an OTC derivatives contract." .
common_domain_model:ProductIdTypeEnum\#ISIN a owl:Class ;
	rdfs:label "ISIN" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Issued by The International Securities Identification Number (ISIN) Organization, the ISIN is a 12-character alpha-numerical code used to uniformly identify a security for trading and settlement purposes. Securities with which ISINs can be used include debt securities, such as notes or bonds as well shares, such as common stock or shares of a fund, options, derivatives, and futures. The ISIN structure is defined in ISO 6166." .
common_domain_model:ProductIdTypeEnum\#Name a owl:Class ;
	rdfs:label "Name" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "The name of the product." .
common_domain_model:ProductIdTypeEnum\#Other a owl:Class ;
	rdfs:label "Other" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Used when the source is not otherwise in this enumerated list because it is internal or other reasons. The source can be identified in the scheme which is part of the identifier attribute." .
common_domain_model:ProductIdTypeEnum\#REDID a owl:Class ;
	rdfs:label "REDID" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Assigned by S&P Global Market Intelligence, REDID (Reference Entity Data Identifier) is a unique alphanumeric code to reference entities, primarily utilized within the credit derivatives market for the standardized identification of underlying entities." .
common_domain_model:ProductIdTypeEnum\#RIC a owl:Class ;
	rdfs:label "RIC" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Issued by Refinitiv (formerly Reuters), the Reuters Instrument Codes(RIC) uniquely identifies financial instruments, including where they are traded." .
common_domain_model:ProductIdTypeEnum\#SEDOL a owl:Class ;
	rdfs:label "SEDOL" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Assigned by the London Stock Exchange, the Stock Exchange Daily Official List (SEDOL) is a list of security identifiers used in the United Kingdom and Ireland for clearing purposes. SEDOLs serve as the National Securities Identifying Number for all securities issued in the United Kingdom and are therefore part of the security's ISIN as well." .
common_domain_model:ProductIdTypeEnum\#Sicovam a owl:Class ;
	rdfs:label "Sicovam" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Issued by the French Société Interprofessionnelle pour la Compensation des Valeurs Mobilières (SICOVAM) to identify French securities listed on French stock exchanges." .
common_domain_model:ProductIdTypeEnum\#UPI a owl:Class ;
	rdfs:label "UPI" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Assigned by the Derivatives Service Bureau Ltd (DSB), the Unique Product Identifier (UPI) is a unique code to describe an over-the-counter (OTC) derivatives product. The UPI is used for identifying the product in transaction reporting data." .
common_domain_model:ProductIdTypeEnum\#Valoren a owl:Class ;
	rdfs:label "Valoren" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Assigned by SIX Financial Information, Valoren is a unique numerical identification number typically ranging from six to nine digits primarily traded in Switzerland, Liechtenstein, and Belgium. This code enables the identification of securities such as stocks, bonds, and investment funds within these markets." .
common_domain_model:ProductIdTypeEnum\#Wertpapier a owl:Class ;
	rdfs:label "Wertpapier" ;
	rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
	skos:definition "Issued by the Institute for the Issuance and Administration of Securities in Germany (Securities Information), the Wertpapierkennnummer (WKN, WPKN, WPK or simply Wert) consists of six digits or capital letters (excluding I and O), and no check digit. It is used to identify German securities." .
common_domain_model:ProductIdTypeEnum a owl:Class ;
	rdfs:label "ProductIdTypeEnum" ;
	owl:unionOf _:c14n8197 ;
	skos:definition "Provides the enumerated values to specify the product identifier source." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
	linkml:permissible_values common_domain_model:ProductIdTypeEnum\#BBGID , common_domain_model:ProductIdTypeEnum\#BBGTICKER , common_domain_model:ProductIdTypeEnum\#CUSIP , common_domain_model:ProductIdTypeEnum\#FIGI , common_domain_model:ProductIdTypeEnum\#ISDACRP , common_domain_model:ProductIdTypeEnum\#ISIN , common_domain_model:ProductIdTypeEnum\#Name , common_domain_model:ProductIdTypeEnum\#Other , common_domain_model:ProductIdTypeEnum\#REDID , common_domain_model:ProductIdTypeEnum\#RIC , common_domain_model:ProductIdTypeEnum\#SEDOL , common_domain_model:ProductIdTypeEnum\#Sicovam , common_domain_model:ProductIdTypeEnum\#UPI , common_domain_model:ProductIdTypeEnum\#Valoren , common_domain_model:ProductIdTypeEnum\#Wertpapier .
common_domain_model:ProductIdentifier a owl:Class ;
	rdfs:label "ProductIdentifier" ;
	rdfs:subClassOf _:c14n13630 , _:c14n2852 , _:c14n3724 , _:c14n4270 , _:c14n5987 , _:c14n836 ;
	skos:definition "Comprises an identifier and a source. The associated metadata key denotes the ability to associate a hash value to the ProductIdentifier instantiations for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
	common_domain_model:rosetta_metadata "key" .
common_domain_model:ProductTaxonomy a owl:Class ;
	rdfs:label "ProductTaxonomy" ;
	rdfs:subClassOf common_domain_model:Taxonomy , _:c14n11352 , _:c14n13908 , _:c14n14320 , _:c14n3542 , _:c14n7990 , _:c14n9 ;
	skos:definition "Specifies the product taxonomy, which is composed of a taxonomy value and a taxonomy source." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .
common_domain_model:PropertyTypeEnum\#Commercial a owl:Class ;
	rdfs:label "Commercial" ;
	rdfs:subClassOf common_domain_model:PropertyTypeEnum ;
	skos:definition "Commercial property." .
common_domain_model:PropertyTypeEnum\#Residential a owl:Class ;
	rdfs:label "Residential" ;
	rdfs:subClassOf common_domain_model:PropertyTypeEnum ;
	skos:definition "Residential property." .
common_domain_model:PropertyTypeEnum a owl:Class ;
	rdfs:label "PropertyTypeEnum" ;
	owl:unionOf _:c14n5821 ;
	skos:definition "Specifies different types of property." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
	linkml:permissible_values common_domain_model:PropertyTypeEnum\#Commercial , common_domain_model:PropertyTypeEnum\#Residential .
common_domain_model:ProtectionTerms a owl:Class ;
	rdfs:label "ProtectionTerms" ;
	rdfs:subClassOf _:c14n11288 , _:c14n12031 , _:c14n1361 , _:c14n14096 , _:c14n233 , _:c14n2717 , _:c14n3515 , _:c14n3808 , _:c14n645 ;
	skos:definition "A class to specify the terms for calculating a payout to protect the buyer of the swap in the case of a qualified credit event. These terms include the applicable credit events, the reference obligation, and in the case of a CDS on mortgage-backed securities, the floatingAmountEvents." ;
	skos:inScheme common_domain_model:cdm_product_asset ;
	common_domain_model:rosetta_metadata "key" .
common_domain_model:PubliclyAvailableInformation a owl:Class ;
	rdfs:label "PubliclyAvailableInformation" ;
	rdfs:subClassOf _:c14n1470 , _:c14n2670 , _:c14n5296 , _:c14n5352 , _:c14n6534 , _:c14n6861 , _:c14n7981 , _:c14n8702 , _:c14n9458 ;
	skos:inScheme common_domain_model:cdm_observable_event .
common_domain_model:PutCallEnum\#Call a owl:Class ;
	rdfs:label "Call" ;
	rdfs:subClassOf common_domain_model:PutCallEnum ;
	skos:definition "A call option gives the holder the right to buy the underlying asset by a certain date for a certain price." .
common_domain_model:PutCallEnum\#Put a owl:Class ;
	rdfs:label "Put" ;
	rdfs:subClassOf common_domain_model:PutCallEnum ;
	skos:definition "A put option gives the holder the right to sell the underlying asset by a certain date for a certain price." .
common_domain_model:PutCallEnum a owl:Class ;
	rdfs:label "PutCallEnum" ;
	owl:unionOf _:c14n5061 ;
	skos:definition "The enumerated values to specify the types of listed derivative options." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
	linkml:permissible_values common_domain_model:PutCallEnum\#Call , common_domain_model:PutCallEnum\#Put .
common_domain_model:QuantifierEnum\#All a owl:Class ;
	rdfs:label "All" ;
	rdfs:subClassOf common_domain_model:QuantifierEnum ;
	skos:definition "Specifies that the condition in the scope of the quantifier is true of every member of the domain i.e. every one of the elements in scope." .
common_domain_model:QuantifierEnum\#Any a owl:Class ;
	rdfs:label "Any" ;
	rdfs:subClassOf common_domain_model:QuantifierEnum ;
	skos:definition "Specifies that the condition in the scope of the quantifier is true of at least one member of the domain i.e. one or more of the elements in scope." .
common_domain_model:QuantifierEnum a owl:Class ;
	rdfs:label "QuantifierEnum" ;
	owl:unionOf _:c14n3016 ;
	skos:definition "Represents the enumerated values to specify a logical quantification, i.e. either All or Any." ;
	skos:inScheme common_domain_model:cdm_base_math ;
	linkml:permissible_values common_domain_model:QuantifierEnum\#All , common_domain_model:QuantifierEnum\#Any .
common_domain_model:Quantity a owl:Class ;
	rdfs:label "Quantity" ;
	rdfs:subClassOf common_domain_model:QuantitySchedule , _:c14n1024 , _:c14n10684 , _:c14n11875 , _:c14n1929 , _:c14n2137 , _:c14n4568 ;
	skos:definition "Specifies a quantity as a single value to be associated to a financial product, for example a transfer amount resulting from a trade. This data type extends QuantitySchedule and requires that only the single value exists." ;
	skos:inScheme common_domain_model:cdm_base_math ;
	skos:note "Rosetta condition DatedValueIsAbsent is not stated in LinkML: datedValue is absent and total -> datedValue is absent" .
common_domain_model:QuantityChangeDirectionEnum\#Decrease a owl:Class ;
	rdfs:label "Decrease" ;
	rdfs:subClassOf common_domain_model:QuantityChangeDirectionEnum ;
	skos:definition "When the quantity should go down by the specified amount." .
common_domain_model:QuantityChangeDirectionEnum\#Increase a owl:Class ;
	rdfs:label "Increase" ;
	rdfs:subClassOf common_domain_model:QuantityChangeDirectionEnum ;
	skos:definition "When the quantity should go up by the specified amount." .
common_domain_model:QuantityChangeDirectionEnum\#Replace a owl:Class ;
	rdfs:label "Replace" ;
	rdfs:subClassOf common_domain_model:QuantityChangeDirectionEnum ;
	skos:definition "When the quantity should be replaced by the specified amount." .
common_domain_model:QuantityChangeDirectionEnum a owl:Class ;
	rdfs:label "QuantityChangeDirectionEnum" ;
	owl:unionOf _:c14n14272 ;
	skos:definition "Specifies whether a quantity change is an increase, a decrease or a replacement, whereby the quantity is always specified as a positive number." ;
	skos:inScheme common_domain_model:cdm_base_math ;
	linkml:permissible_values common_domain_model:QuantityChangeDirectionEnum\#Decrease , common_domain_model:QuantityChangeDirectionEnum\#Increase , common_domain_model:QuantityChangeDirectionEnum\#Replace .
common_domain_model:QuantityChangeInstruction a owl:Class ;
	rdfs:label "QuantityChangeInstruction" ;
	rdfs:subClassOf _:c14n11308 , _:c14n13685 , _:c14n14219 , _:c14n14548 , _:c14n2603 , _:c14n4533 , _:c14n7641 ;
	skos:definition "Instructions required to create a Quantity Change Primitive Event, which can be either an increase, a decrease or a replacement. An increase adds a new trade lot to the original trade, whereas a decrease subtracts from an existing trade lot's quantity. A replacement updates the quantity of an existing trade lot to the new value." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:QuantityMultiplier a owl:Class ;
	rdfs:label "QuantityMultiplier" ;
	rdfs:subClassOf _:c14n10852 , _:c14n12740 , _:c14n2194 , _:c14n5102 , _:c14n6379 , _:c14n7104 , _:c14n9739 ;
	skos:definition "Class to specify a mechanism for a quantity to be set as a multiplier to another (reference) quantity, based on a price observation. At the moment this class only supports FX or Equity-linked notional and re-uses existing building blocks for those 2 cases, until such time when component can be made more generic. This captures the case of resetting cross-currency swaps and resetting equity swaps." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:QuantitySchedule a owl:Class ;
	rdfs:label "QuantitySchedule" ;
	rdfs:subClassOf common_domain_model:MeasureBase , _:c14n11590 , _:c14n11668 , _:c14n12026 , _:c14n13311 , _:c14n13700 , _:c14n1401 , _:c14n1521 , _:c14n2416 , _:c14n3157 , _:c14n3317 , _:c14n3344 , _:c14n6859 , _:c14n9183 ;
	skos:definition "Specifies a quantity schedule to be associated to a financial product to represent a trade amount. This data type extends MeasureBase with several unit or multiplier attributes that are used to define financial quantities. This data type is generically based on a schedule and can also be used to represent a quantity as a single value." ;
	skos:inScheme common_domain_model:cdm_base_math .
common_domain_model:Quanto a owl:Class ;
	rdfs:label "Quanto" ;
	rdfs:subClassOf _:c14n13351 , _:c14n14341 , _:c14n3262 , _:c14n7406 , _:c14n7818 , _:c14n7833 , _:c14n8520 , _:c14n9294 ;
	skos:definition "Determines the currency rate that the seller of the equity amounts will apply at each valuation date for converting the respective amounts into a currency that is different from the currency denomination of the underlier." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:QuasiGovernmentIssuerType a owl:Class ;
	rdfs:label "QuasiGovernmentIssuerType" ;
	rdfs:subClassOf _:c14n10221 , _:c14n1405 , _:c14n2761 , _:c14n544 , _:c14n6729 , _:c14n7980 ;
	skos:definition "Represents a class to allow specification of different types of Quasi Government collateral." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
	skos:note "Rosetta condition NonSovereignEntityRecourse is not stated in LinkML: if sovereignRecourse exists then sovereignEntity = False" .
common_domain_model:QuotationRateTypeEnum\#Ask a owl:Class ;
	rdfs:label "Ask" ;
