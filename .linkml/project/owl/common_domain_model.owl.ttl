<https://w3id.org/lmodel/common-domain-model/RepoDurationEnum#Overnight> a owl:Class ;
    rdfs:label "Overnight" ;
    rdfs:subClassOf common_domain_model:RepoDurationEnum ;
    skos:definition "Indicates that a contract is classified as overnight, meaning that there is one business day difference between the start and end date of the contract. Business rule: When the repo is overnight, the number of business days between the spot and forward value dates must be one. Forward leg must be specified." .

<https://w3id.org/lmodel/common-domain-model/RepoDurationEnum#Term> a owl:Class ;
    rdfs:label "Term" ;
    rdfs:subClassOf common_domain_model:RepoDurationEnum ;
    skos:definition "Indicates that a contract is a regular term contract, with a start date and an end date. Business rule: When the repo is 'Term', both spot and forward legs must be specified." .

