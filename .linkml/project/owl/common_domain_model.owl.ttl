        <https://w3id.org/lmodel/common-domain-model/AssetIdTypeEnum#CurrencyCode>,
        <https://w3id.org/lmodel/common-domain-model/AssetIdTypeEnum#ExchangeCode> .

common_domain_model:AssetPayoutTradeTypeEnum a owl:Class ;
    rdfs:label "AssetPayoutTradeTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AssetPayoutTradeTypeEnum#Repo> <https://w3id.org/lmodel/common-domain-model/AssetPayoutTradeTypeEnum#BuySellBack> <https://w3id.org/lmodel/common-domain-model/AssetPayoutTradeTypeEnum#SecurityLending> ) ;
    skos:definition "An enumerator to differentiate the different trade types used in securities finance and modelled on an AssetPayout." ;
