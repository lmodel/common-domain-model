    rdfs:subClassOf common_domain_model:CreditSeniorityEnum ;
    skos:definition "Subordinate, Lower Tier 2 (RED Tier Code: SUBLT2)." .

<http://www.fpml.org/coding-scheme/credit-seniority-2-3#SubTier1> a owl:Class ;
