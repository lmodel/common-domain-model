common_domain_model:CollateralIssuerType a owl:Class ;
    rdfs:label "CollateralIssuerType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:regionalGovernmentType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:specialPurposeVehicleType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:supraNationalType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:quasiGovernmentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:specialPurposeVehicleType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SupraNationalIssuerTypeEnum ;
            owl:onProperty common_domain_model:supraNationalType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:supraNationalType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RegionalGovernmentIssuerType ;
            owl:onProperty common_domain_model:regionalGovernmentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:QuasiGovernmentIssuerType ;
            owl:onProperty common_domain_model:quasiGovernmentType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:issuerType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SpecialPurposeVehicleIssuerType ;
            owl:onProperty common_domain_model:specialPurposeVehicleType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CollateralEntityTypeEnum ;
            owl:onProperty common_domain_model:issuerType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:quasiGovernmentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:regionalGovernmentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:issuerType ] ;
    skos:closeMatch fpml_5_10:CollateralIssuerType ;
    skos:definition "Represents a class to allow specification of the type of entity issuing the collateral." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    skos:note "Rosetta condition: QuasiGovernmentSubType — if issuerType <> QuasiGovernment then quasiGovernmentType is absent",
        "Rosetta condition: RegionalGovernmentSubType — if issuerType <> RegionalGovernment then regionalGovernmentType is absent",
        "Rosetta condition: SpecialPurposeVehicleSubType — if issuerType <> SpecialPurposeVehicle then specialPurposeVehicleType is absent",
        "Rosetta condition: SupraNationalSubType — if issuerType <> SupraNational then supraNationalType is absent" .

