	rdfs:label "executionVenue" ;
	skos:definition "Represents the venue on which a trade was executed." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:exercise a owl:ObjectProperty ;
	rdfs:label "exercise" ;
	skos:definition "Specifies instructions describing an exercise primitive event." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:exerciseDate a owl:ObjectProperty ;
	rdfs:label "exerciseDate" ;
	skos:definition "Specifies the date on which an option contained within the financial product would be exercised. The date may be omitted if the contractual product allows for only a single date of exercise (European exercise)." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:exerciseDates a owl:ObjectProperty ;
	rdfs:label "exerciseDates" ;
	skos:definition "The dates that define the Bermuda option exercise dates and the expiration date. The last specified date is assumed to be the expiration date. The dates can either be specified as a series of explicit dates and associated adjustments or as a series of dates defined relative to another schedule of dates, for example, the calculation period start dates. Where a relative series of dates are defined the first and last possible exercise dates can be separately specified." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:exerciseFee a owl:ObjectProperty ;
	rdfs:label "exerciseFee" ;
	skos:definition "A fee to be paid on exercise. This could be represented as an amount or a rate and notional reference on which to apply the rate." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:exerciseFeeSchedule a owl:ObjectProperty ;
	rdfs:label "exerciseFeeSchedule" ;
	skos:definition "The fees associated with an exercise date. The fees are conditional on the exercise occurring. The fees can be specified as actual currency amounts or as percentages of the notional amount being exercised." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:exerciseFrequency a owl:ObjectProperty ;
	rdfs:label "exerciseFrequency" ;
	skos:definition "The frequency of subsequent exercise dates in the exercise period following the earliest exercise date. An interval of 1 day should be used to indicate an American style exercise period." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:exerciseNotice a owl:ObjectProperty .
common_domain_model:exerciseNoticeGiver a owl:ObjectProperty ;
	rdfs:label "exerciseNoticeGiver" ;
	skos:definition "Specifies the principal party of the trade that has the right to exercise." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:exerciseNoticeReceiver a owl:ObjectProperty ;
	rdfs:label "exerciseNoticeReceiver" ;
	skos:definition "Specifies the party to which notice of exercise should be given, e.g. by the buyer of the option. Although in many cases it is the buyer of the option who sends the exercise notice to the seller of the option, this component is reused, e.g. in case of OptionEarlyTermination, either or both parties have the right to exercise." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:exerciseOption a owl:ObjectProperty ;
	rdfs:label "exerciseOption" ;
	skos:definition "The Payout being exercised on the trade." ;
	skos:inScheme common_domain_model:cdm_event_common ;
	common_domain_model:rosetta_metadata "reference" .
common_domain_model:exerciseProcedure a owl:ObjectProperty ;
	rdfs:label "exerciseProcedure" ;
	skos:definition "The set of parameters defining the procedure associated with the exercise, e.g. manual exercise." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:exerciseQuantity a owl:ObjectProperty ;
	rdfs:label "exerciseQuantity" ;
	skos:definition "Contains instructions for exercising the option including a quantity change, and optionally a transfer." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:exerciseTerms a owl:ObjectProperty .
common_domain_model:exerciseTime a owl:ObjectProperty ;
	rdfs:label "exerciseTime" ;
	skos:definition "Specifies the time at which an option contained within the financial product woulld be exercised. The time may be omitted if the contractual product allows for only a single time of exercise (European exercise)." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:exhaustionPoint a owl:DatatypeProperty ;
	rdfs:label "exhaustionPoint" ;
	skos:definition "Upper bound percentage of the loss that the Tranche can endure, expressed as a decimal. An exhaustion point of 5% would be represented as 0.05. The difference between Attachment and Exhaustion points is call the width of the Tranche." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:existingLoans a owl:ObjectProperty ;
	rdfs:label "existingLoans" ;
	skos:definition "Are existing loans covered in the event of default (Only relevant to 2010 GMSLAs)?" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .
common_domain_model:expectedN a owl:DatatypeProperty ;
	rdfs:label "expectedN" ;
	skos:definition "Expected number of trading days." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:expirationDate a owl:ObjectProperty .
common_domain_model:expirationDateTime a owl:DatatypeProperty ;
	rdfs:label "expirationDateTime" ;
	skos:definition "There may be a set period/time restriction associated to the security." ;
	skos:inScheme common_domain_model:cdm_event_position .
common_domain_model:expirationDateTwo a owl:ObjectProperty ;
	rdfs:label "expirationDateTwo" ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:expirationTime a owl:ObjectProperty ;
	rdfs:label "expirationTime" ;
	skos:definition "The latest time for exercise on expirationDate. It is made mandatory given that for all option styles, this field is required." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:expirationTimeType a owl:ObjectProperty ;
	rdfs:label "expirationTimeType" ;
	skos:definition "The time of day at which the equity option expires, for example the official closing time of the exchange." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:exposure a owl:ObjectProperty ;
	rdfs:label "exposure" ;
	skos:definition "Specification of amendments to the calculation of Exposure in terms of the Transactions covered." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:exposureMultiplier a owl:DatatypeProperty .
common_domain_model:extendibleProvision a owl:ObjectProperty ;
	rdfs:label "extendibleProvision" ;
	skos:definition "A provision that allows the specification of an embedded option with a swap giving the buyer of the option the right to extend the swap, in whole or in part, to the extended termination date." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:extendibleProvisionAdjustedDates a owl:ObjectProperty ;
	rdfs:label "extendibleProvisionAdjustedDates" ;
	skos:definition "The adjusted dates associated with an extendible provision. These dates have been adjusted for any applicable business day convention." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:extensionEvent a owl:ObjectProperty ;
	rdfs:label "extensionEvent" ;
	skos:definition "The adjusted dates associated with a single extendible exercise date." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:extensionFrequency a owl:ObjectProperty ;
	rdfs:label "extensionFrequency" ;
	skos:definition "The frequency with which the evergreen contract will be extended if notice is not given." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:extensionPeriod a owl:ObjectProperty ;
	rdfs:label "extensionPeriod" ;
	skos:definition "The period within which notice can be given that the contract will be extended." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:extensionTerm a owl:ObjectProperty ;
	rdfs:label "extensionTerm" ;
	skos:definition "The length of each extension period relative to the effective date of the preceding contract." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:externalId a owl:DatatypeProperty ;
	rdfs:label "externalId" ;
	skos:definition "The FRO name that is being mapped to/from." ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:externalMappings a owl:ObjectProperty ;
	rdfs:label "externalMappings" ;
	skos:definition "Any mappings to other codes for this index." ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:externalStandard a owl:DatatypeProperty ;
	rdfs:label "externalStandard" ;
	skos:definition "The standard/version to which the map applies." ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:extraordinaryDividendsParty a owl:ObjectProperty ;
	rdfs:label "extraordinaryDividendsParty" ;
	skos:definition "Specifies the party which determines if dividends are extraordinary in relation to normal levels." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:extraordinaryEvents a owl:ObjectProperty ;
	rdfs:label "extraordinaryEvents" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .
common_domain_model:fPVFinalPriceElectionFallback a owl:ObjectProperty ;
	rdfs:label "fPVFinalPriceElectionFallback" ;
	skos:definition "Specifies the fallback provisions for Hedging Party in the determination of the Final Price." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:facilityType a owl:DatatypeProperty ;
	rdfs:label "facilityType" ;
	skos:definition "Specifies the type of loan facility (letter of credit, revolving, ...)." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
	common_domain_model:rosetta_metadata "scheme" .
common_domain_model:failureToDeliver a owl:DatatypeProperty .
common_domain_model:failureToDevliverIndemnityApplies a owl:ObjectProperty ;
	rdfs:label "failureToDevliverIndemnityApplies" ;
	skos:definition "Does paragraph 6.4 (indemnity for failure to redeliver Equivalent Non-Cash Collateral) apply to the GMSLA?" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_master_isla .
common_domain_model:failureToPay a owl:DatatypeProperty , owl:ObjectProperty .
common_domain_model:failureToPayEarlyTermination a owl:DatatypeProperty ;
	rdfs:label "failureToPayEarlyTermination" ;
	skos:definition "A boolean attribute to specify whether Failure to Pay Early Termination language in the agreement is deemed applicable or not." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:failureToPayInterest a owl:DatatypeProperty ;
	rdfs:label "failureToPayInterest" ;
	skos:definition "A credit event. Corresponds to the failure by the Reference Entity to pay an expected interest amount or the payment of an actual interest amount that is less than the expected interest amount. ISDA 2003 Term: Failure to Pay Interest." ;
	skos:inScheme common_domain_model:cdm_observable_event .
common_domain_model:failureToPayPrincipal a owl:DatatypeProperty .
common_domain_model:fallBackSettlementRateOption a owl:ObjectProperty ;
	rdfs:label "fallBackSettlementRateOption" ;
	skos:definition "This settlement rate option will be used in its place." ;
	skos:inScheme common_domain_model:cdm_observable_asset ;
	common_domain_model:rosetta_metadata "scheme" .
common_domain_model:fallback a owl:DatatypeProperty ;
	rdfs:label "fallback" ;
	skos:definition "Represents whether a fallback calculation method is applicable. 'True' if fallback calculation method is applicable." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:fallbackAET a owl:DatatypeProperty ;
	rdfs:label "fallbackAET" ;
	skos:definition "Specifies whether automatic termination applies in the event of certain bankruptcy events." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .
common_domain_model:fallbackBondApplicable a owl:DatatypeProperty ;
	rdfs:label "fallbackBondApplicable" ;
	skos:definition "The applicability of a fallback bond as defined in the 2006 ISDA Inflation Derivatives Definitions, sections 1.3 and 1.8." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:fallbackCurrency a owl:DatatypeProperty ;
	rdfs:label "fallbackCurrency" ;
	skos:definition "Specifies a single fallback Termination Currency should the stated currency not be freely available." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .
common_domain_model:fallbackExercise a owl:DatatypeProperty ;
	rdfs:label "fallbackExercise" ;
	skos:definition "If fallback exercise is specified then the notional amount of the underlying swap, not previously exercised under the swaption, will be automatically exercised at the expiration time on the expiration date if at such time the buyer is in-the-money, provided that the difference between the settlement rate and the fixed rate under the relevant underlying swap is not less than one tenth of a percentage point (0.10% or 0.001). The term in-the-money is assumed to have the meaning defined in the 2000 ISDA Definitions, Section 17.4. In-the-money." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:fallbackLanguageBespokeTerms a owl:ObjectProperty .
common_domain_model:fallbackRate a owl:ObjectProperty ;
	rdfs:label "fallbackRate" ;
	skos:definition "Definition of any fallback rate that may be applicable." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:fallbackReferencePrice a owl:ObjectProperty .
common_domain_model:fallbackSurveyValuationPostponement a owl:DatatypeProperty ;
	rdfs:label "fallbackSurveyValuationPostponement" ;
	skos:definition "Request rate quotes from the market. This element is set as type Empty in FpML. When present, the FpML synonym is mapped to a value True in the CDM." ;
	skos:inScheme common_domain_model:cdm_observable_asset .
common_domain_model:fallbackToMandatoryMethodDays a owl:DatatypeProperty ;
	rdfs:label "fallbackToMandatoryMethodDays" ;
	skos:definition "The specification of the number of days after effective delivery of notice that Mandatory method fallback applies. Specification is only required when one or more Regimes have Fall Back to Mandatory Method elected as a SIMM exception." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:feature a owl:ObjectProperty ;
	rdfs:label "feature" ;
	skos:definition "The option feature, such as quanto, Asian, barrier, knock." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:featurePayment a owl:ObjectProperty ;
	rdfs:label "featurePayment" ;
	skos:definition "The feature payment, i.e. the payment made following trigger occurrence." ;
	skos:inScheme common_domain_model:cdm_observable_event .
common_domain_model:feeAmount a owl:DatatypeProperty ;
	rdfs:label "feeAmount" ;
	skos:definition "The amount of fee to be paid on exercise. The fee currency is that of the referenced notional." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:feeAmountSchedule a owl:ObjectProperty ;
	rdfs:label "feeAmountSchedule" ;
	skos:definition "The exercise fee amount schedule. The fees are expressed as currency amounts. The currency of the fee is assumed to be that of the notional schedule referenced." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:feePaymentDate a owl:ObjectProperty .
common_domain_model:feeRate a owl:DatatypeProperty ;
	rdfs:label "feeRate" ;
	skos:definition "A fee represented as a percentage of some referenced notional. A percentage of 5% would be represented as 0.05." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:feeRateSchedule a owl:ObjectProperty ;
	rdfs:label "feeRateSchedule" ;
	skos:definition "The exercise free rate schedule. The fees are expressed as percentage rates of the notional being exercised. The currency of the fee is assumed to be that of the notional schedule referenced." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:finalCalculationPeriodDateAdjustment a owl:ObjectProperty ;
	rdfs:label "finalCalculationPeriodDateAdjustment" ;
	skos:definition "Business date convention adjustment to final payment period per leg (swapStream) upon exercise event. The adjustments can be made in-line with leg level BDC's or they can be specified separately." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:finalFixingDate a owl:ObjectProperty ;
	rdfs:label "finalFixingDate" ;
	skos:definition "This attribute is not part of the FpML ResetDate, and has been added as part of the CDM to support the credit derivatives final fixing date." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:finalPayment a owl:DatatypeProperty ;
	rdfs:label "finalPayment" ;
	skos:definition "A true/false flag to indicate whether there is a final exchange of principal on the termination date." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:finalPaymentDate a owl:ObjectProperty ;
	rdfs:label "finalPaymentDate" ;
	skos:definition "The last payment when specified as an adjustable or relative date, as in the FpML total return construct." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:finalPeriodFeeAdjustment a owl:ObjectProperty ;
	rdfs:label "finalPeriodFeeAdjustment" ;
	skos:definition "An optional adjustment to the rate for the last period of the evergreen i.e. the period from when notice is given to stop rolling the contract through to the termination date." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:finalPrice a owl:ObjectProperty ;
	rdfs:label "finalPrice" ;
	skos:definition "The final price resulting from the auction." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:finalPrincipalExchangeCalculation a owl:ObjectProperty ;
	rdfs:label "finalPrincipalExchangeCalculation" ;
	skos:definition "To be specified only for products that embed a redemption payment." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:finalPrincipalPayment a owl:ObjectProperty ;
	rdfs:label "finalPrincipalPayment" ;
	skos:definition "Principal Payment at Trade maturity" ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:finalRateRounding a owl:ObjectProperty ;
	rdfs:label "finalRateRounding" ;
	skos:definition "The rounding convention to apply to the final rate used in determination of a calculation period amount." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:finalReturns a owl:ObjectProperty .
common_domain_model:finalStub a owl:ObjectProperty .
common_domain_model:finalValuationDate a owl:ObjectProperty ;
	rdfs:label "finalValuationDate" ;
	skos:definition "Specifies the final valuation dates of the underlyer." ;
	skos:inScheme common_domain_model:cdm_observable_asset .
common_domain_model:finalValuationPrice a owl:ObjectProperty .
common_domain_model:financialUnit a owl:ObjectProperty ;
	rdfs:label "financialUnit" ;
	skos:definition "Provides an enumerated value for financial units, generally used in the context of defining quantities for securities." ;
	skos:inScheme common_domain_model:cdm_base_math .
common_domain_model:firstCompoundingPeriodEndDate a owl:DatatypeProperty ;
	rdfs:label "firstCompoundingPeriodEndDate" ;
	skos:definition "The end date of the initial compounding period when compounding is applicable. It must only be specified when the compoundingMethod element is present and not equal to a value of None. This date may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:firstDefinedIn a owl:ObjectProperty ;
	rdfs:label "firstDefinedIn" ;
	skos:definition "The supplement or version the FRO was first added to the 2006 Definitions or 2021 Floating Rate Matrix. (e.g. S52)" ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:firstName a owl:DatatypeProperty ;
	rdfs:label "firstName" ;
	skos:definition "The natural person's first name. It is optional in FpML." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_party .
common_domain_model:firstObservationDateOffset a owl:ObjectProperty ;
	rdfs:label "firstObservationDateOffset" ;
	skos:definition "Defines the offset of the series of pricing dates relative to the calculation period." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:firstOrSecondPeriod a owl:ObjectProperty ;
	rdfs:label "firstOrSecondPeriod" ;
	skos:definition "2002 ISDA Equity Derivatives Definitions: Dividend Period as either the First Period or the Second Period. |" ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:firstPaymentDate a owl:DatatypeProperty ;
	rdfs:label "firstPaymentDate" ;
	skos:definition "The first unadjusted payment date. This day may be subject to adjustment in accordance with any business day convention specified in paymentDatesAdjustments. This element must only be included if there is an initial stub. This date will normally correspond to an unadjusted calculation period start or end date. This is true even if early or delayed payment is specified to be applicable since the actual first payment date will be the specified number of days before or after the applicable adjusted calculation period start or end date with the resulting payment date then being adjusted in accordance with any business day convention specified in paymentDatesAdjustments." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:firstPeriodStartDate a owl:ObjectProperty ;
	rdfs:label "firstPeriodStartDate" ;
	skos:definition "The start date of the calculation period. FpML specifies that for interest rate swaps this date must only be specified if it is not equal to the effective date. It is always specified in the case of equity swaps and credit default swaps with periodic payments. This date may be subject to adjustment in accordance with a business day convention." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:firstRegularPeriodStartDate a owl:DatatypeProperty ;
	rdfs:label "firstRegularPeriodStartDate" ;
	skos:definition "The start date of the regular part of the calculation period schedule. It must only be specified if there is an initial stub calculation period. This day may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:fixedAmount a owl:DatatypeProperty , owl:ObjectProperty .
common_domain_model:fixedPaymentAmount a owl:ObjectProperty ;
	rdfs:label "fixedPaymentAmount" ;
	skos:definition "A known fixed payment amount." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:fixedPrice a owl:ObjectProperty ;
	rdfs:label "fixedPrice" ;
	skos:definition "Specifies the fixed price on which fixed forward payments are based." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:fixedRate a owl:DatatypeProperty .
common_domain_model:fixedSettlement a owl:DatatypeProperty ;
	rdfs:label "fixedSettlement" ;
	skos:definition "Used for Recovery Lock, to indicate whether fixed Settlement is Applicable or Not Applicable. If Buyer fails to deliver an effective Notice of Physical Settlement on or before the Buyer NOPS Cut-off Date, and if Seller fails to deliver an effective Seller NOPS on or before the Seller NOPS Cut-off Date, then either: (a) if Fixed Settlement is specified in the related Confirmation as not applicable, then the Seller NOPS Cut-off Date shall be the Termination Date; or (b) if Fixed Settlement is specified in the related Confirmation as applicable, then: (i) if the Fixed Settlement Amount is a positive number, Seller shall, subject to Section 3.1 (except for the requirement of satisfaction of the Notice of Physical Settlement Condition to Settlement), pay the Fixed Settlement Amount to Buyer on the Fixed Settlement Payment Date; and (ii) if the Fixed Settlement Amount is a negative number, Buyer shall, subject to Section 3.1 (except for the requirement of satisfaction of the Notice of Physical Settlement Condition to Settlement), pay the absolute value of the Fixed Settlement Amount to Seller on the Fixed Settlement Payment Date." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:fixing a owl:ObjectProperty ;
	rdfs:label "fixing" ;
	skos:definition "The default fixing details." ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:fixingDate a owl:ObjectProperty ;
	rdfs:label "fixingDate" ;
	skos:definition "The date on which the fixing is scheduled to occur." ;
	skos:inScheme common_domain_model:cdm_observable_asset .
common_domain_model:fixingDates a owl:ObjectProperty ;
	rdfs:label "fixingDates" ;
	skos:definition "The fixing dates are the dates on which the index values are observed. The fixing dates are specified by reference to the reset date through business days offset and an associated set of financial business centers. Normally these offset calculation rules will be those specified in the ISDA definition for the relevant floating rate index (ISDA's Floating Rate Option). However, non-standard offset calculation rules may apply for a trade if mutually agreed by the principal parties to the transaction." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:fixingOffset a owl:ObjectProperty ;
	rdfs:label "fixingOffset" ;
	skos:definition "Parameters defining the normal fixing offset (can vary by index tenor / designated maturity)." ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:fixingOffsetDefinition a owl:DatatypeProperty ;
	rdfs:label "fixingOffsetDefinition" ;
	skos:definition "Legal text that underlies the Fixing Offset. ISDA Fixing Offset Definition. (e.g. One day that is either a Sydney Business Day or a Melbourne Business Day following the Reset Date)" ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:fixingOffsetReason a owl:DatatypeProperty ;
	rdfs:label "fixingOffsetReason" ;
	skos:definition "Fixing Offset Reason" ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:fixingPeriod a owl:ObjectProperty ;
	rdfs:label "fixingPeriod" ;
	skos:definition "Period over which the underlying price is observed." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:fixingReason a owl:DatatypeProperty ;
	rdfs:label "fixingReason" ;
	skos:definition "Fixing Reason" ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:fixingTime a owl:ObjectProperty .
common_domain_model:fixingTimeDefinition a owl:DatatypeProperty ;
	rdfs:label "fixingTimeDefinition" ;
	skos:definition "Legal text that underlies the Fixing Time. ISDA Fixing Time Definition. (e.g. 09:30, Sydney time)." ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:floatingAmount a owl:DatatypeProperty ;
	rdfs:label "floatingAmount" ;
	skos:definition "Floating Amount Calculation" ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:floatingAmountEvents a owl:ObjectProperty ;
	rdfs:label "floatingAmountEvents" ;
	skos:definition "This element contains the ISDA terms relating to the floating rate payment events and the implied additional fixed payments, applicable to the credit derivatives transactions on mortgage-backed securities with pay-as-you-go or physical settlement." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:floatingAmountProvisions a owl:ObjectProperty ;
	rdfs:label "floatingAmountProvisions" ;
	skos:definition "Specifies the floating amount provisions associated with the floatingAmountEvents." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:floatingRate a owl:DatatypeProperty , owl:ObjectProperty .
common_domain_model:floatingRateDefinition a owl:ObjectProperty ;
	rdfs:label "floatingRateDefinition" ;
	skos:definition "The floating rate reset information for the calculation period." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:floatingRateIndex a owl:ObjectProperty .
common_domain_model:floatingRateIndexData a owl:ObjectProperty ;
	rdfs:label "floatingRateIndexData" ;
	skos:inScheme common_domain_model:cdm_event_instructioncomposition_reset .
common_domain_model:floatingRateMultiplier a owl:DatatypeProperty ;
	rdfs:label "floatingRateMultiplier" ;
	skos:definition "A rate multiplier to apply to the floating rate. The multiplier can be a positive or negative decimal. This element should only be included if the multiplier is not equal to 1 (one)." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:floatingRateMultiplierSchedule a owl:ObjectProperty .
common_domain_model:floatingRateOptionData a owl:ObjectProperty ;
	rdfs:label "floatingRateOptionData" ;
	skos:definition "The specific day count fraction, fixings, and lookback parameters associated with the chosen index." ;
	skos:inScheme common_domain_model:cdm_event_instructioncomposition_reset .
common_domain_model:floorRate a owl:DatatypeProperty , owl:ObjectProperty .
common_domain_model:floorRateSchedule a owl:ObjectProperty .
common_domain_model:followUpConfirmation a owl:DatatypeProperty .
common_domain_model:forceMajeureOrActOfSState a owl:ObjectProperty ;
	rdfs:label "forceMajeureOrActOfSState" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms ;
	common_domain_model:doc_reference "ISDA FXandCurrencyOptionsDefintions_1998 section 5.1.(c).(ii)" .
common_domain_model:forecastAmount a owl:ObjectProperty ;
	rdfs:label "forecastAmount" ;
	skos:definition "The amount representing the forecast of the accrued value of the calculation period. An intermediate value used to generate the forecastPaymentAmount in the PaymentCalculationPeriod." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:forecastPaymentAmount a owl:ObjectProperty ;
	rdfs:label "forecastPaymentAmount" ;
	skos:definition "A monetary amount representing the forecast of the future value of the payment." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:forecastRate a owl:DatatypeProperty .
common_domain_model:foreignExchangeAdditionalTerms a owl:ObjectProperty ;
	rdfs:label "foreignExchangeAdditionalTerms" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .
common_domain_model:foreignOwnershipEvent a owl:DatatypeProperty ;
	rdfs:label "foreignOwnershipEvent" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .
common_domain_model:fpmlDescription a owl:DatatypeProperty ;
	rdfs:label "fpmlDescription" ;
	skos:definition "FpML Description" ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:frenchLawAddendum a owl:ObjectProperty ;
	rdfs:label "frenchLawAddendum" ;
	skos:definition "The French Law Addendum Provisions specific to the agreement." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:frequency a owl:ObjectProperty .
common_domain_model:fro a owl:ObjectProperty ;
	rdfs:label "fro" ;
	skos:definition "The underlying FRO name and designated maturity." ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:froType a owl:DatatypeProperty ;
	rdfs:label "froType" ;
	skos:definition "FRO type (e.g. OIS)" ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:fullDischarge a owl:DatatypeProperty .
common_domain_model:fullFaithAndCreditObLiability a owl:DatatypeProperty .
common_domain_model:fundType a owl:ObjectProperty .
common_domain_model:furtherDetails a owl:DatatypeProperty ;
	rdfs:label "furtherDetails" ;
	skos:definition "Further Details on the Additional Termination Events that apply to the party." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .
common_domain_model:futureValueNotional a owl:ObjectProperty ;
	rdfs:label "futureValueNotional" ;
	skos:definition "The future value notional is specific to BRL CDI swaps, and is specified alongside the notional amount. The value is calculated as follows: Future Value Notional = Notional Amount * (1 + Fixed Rate) ^ (Fixed Rate Day Count Fraction). The currency should always match that expressed in the notional schedule. The value date should match the adjusted termination date." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:futuresPriceValuation a owl:DatatypeProperty ;
	rdfs:label "futuresPriceValuation" ;
	skos:definition "The official settlement price as announced by the related exchange is applicable, in accordance with the ISDA 2002 definitions." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:fxDesignatedCurrency a owl:DatatypeProperty ;
	rdfs:label "fxDesignatedCurrency" ;
	skos:definition "When specified, the reference currency for the purpose of specifying the FX Haircut relating to a posting obligation. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
	common_domain_model:rosetta_metadata "scheme" .
common_domain_model:fxFeature a owl:ObjectProperty .
common_domain_model:fxFixingDate a owl:ObjectProperty .
common_domain_model:fxFixingSchedule a owl:ObjectProperty ;
	rdfs:label "fxFixingSchedule" ;
	skos:definition "The date, when expressed as a schedule of date(s), on which the currency rate will be determined for the purpose of specifying the amount in deliverable currency. This attribute was formerly part of 'NonDeliverableSettlement', which is now being harmonised into a common 'CashSettlementTerms' that includes a 'ValuationDate'." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:fxHaircut a owl:DatatypeProperty ;
	rdfs:label "fxHaircut" ;
	skos:definition "The alternative definition for FX haircut percentage that applies to each party and item of Eligible Collateral unless this item is denominated in a Major Currency or in the Base Currency." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
	common_domain_model:doc_reference "ISDA CSA_VM_2016 paragraph 13 clause (c)(v)(B) name FX Haircut Percentage" .
common_domain_model:fxHaircutCurrency a owl:ObjectProperty .
common_domain_model:fxHaircutPercentage a owl:DatatypeProperty .
common_domain_model:fxLinkedNotionalAmount a owl:ObjectProperty ;
	rdfs:label "fxLinkedNotionalAmount" ;
	skos:definition "The amount that a cashflow will accrue interest on. This is the calculated amount of the FX linked - i.e. the other currency notional amount multiplied by the appropriate FX spot rate." ;
	skos:inScheme common_domain_model:cdm_product_common_schedule .
common_domain_model:fxLinkedNotionalSchedule a owl:ObjectProperty ;
	rdfs:label "fxLinkedNotionalSchedule" ;
	skos:definition "Multiplier specified as an FX-linked schedule, e.g. for a resetting cross-currency swap.." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:fxRate a owl:ObjectProperty ;
	rdfs:label "fxRate" ;
	skos:definition "Specifies a currency conversion rate." ;
	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:fxSpotRateSource a owl:ObjectProperty .
common_domain_model:generalFundObligationLiability a owl:DatatypeProperty .
common_domain_model:generalInconvertibility a owl:ObjectProperty ;
	rdfs:label "generalInconvertibility" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms ;
	common_domain_model:doc_reference "ISDA FXandCurrencyOptionsDefintions_1998 section 5.1.(d).(iii)" .
common_domain_model:generalInconvertibilityIsApplicable a owl:DatatypeProperty ;
	rdfs:label "generalInconvertibilityIsApplicable" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .
common_domain_model:generalNonTransferability a owl:ObjectProperty ;
	rdfs:label "generalNonTransferability" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms ;
	common_domain_model:doc_reference "ISDA FXandCurrencyOptionsDefintions_1998 section 5.1.(d).(iv)" .
common_domain_model:generalNonTransferabilityIsApplicable a owl:DatatypeProperty ;
	rdfs:label "generalNonTransferabilityIsApplicable" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .
common_domain_model:generalSimmElections a owl:ObjectProperty .
common_domain_model:generalTerms a owl:ObjectProperty ;
	rdfs:label "generalTerms" ;
	skos:definition "The specification of the non-monetary terms for the Credit Derivative Transaction, including the buyer and seller and selected items from the ISDA 2014 Credit Definition article II, such as the reference obligation and related terms." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:global a owl:DatatypeProperty ;
	rdfs:label "global" ;
	skos:definition "Global credit limit utilisation amount, agnostic of long/short position direction." ;
	skos:inScheme common_domain_model:cdm_event_workflow .
common_domain_model:governingLaw a owl:ObjectProperty .
common_domain_model:governingLawIfOther a owl:DatatypeProperty ;
	rdfs:label "governingLawIfOther" ;
	skos:definition "Specifies the governing law if the choice on the enumerated list is 'Other'." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .
common_domain_model:governmentalAuthorityDefault a owl:ObjectProperty ;
	rdfs:label "governmentalAuthorityDefault" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms ;
	common_domain_model:doc_reference "ISDA FXandCurrencyOptionsDefintions_1998 section 5.1.(d).(v)" .
common_domain_model:governmentalAuthorityDefaultIsApplicable a owl:DatatypeProperty ;
	rdfs:label "governmentalAuthorityDefaultIsApplicable" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .
common_domain_model:governmentalIntervention a owl:DatatypeProperty ;
	rdfs:label "governmentalIntervention" ;
	skos:definition "A credit event. A governmental intervention is an event resulting from an action by a governmental authority that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2014 Term: Governmental Intervention." ;
	skos:inScheme common_domain_model:cdm_observable_event .
common_domain_model:gracePeriod a owl:ObjectProperty ;
	rdfs:label "gracePeriod" ;
	skos:definition "The number of calendar or business days after any due date that the reference entity has to fulfil its obligations before a failure to pay credit event is deemed to have occurred. ISDA 2003 Term: Grace Period." ;
	skos:inScheme common_domain_model:cdm_observable_event .
common_domain_model:gracePeriodExtension a owl:ObjectProperty ;
	rdfs:label "gracePeriodExtension" ;
	skos:definition "If this element is specified, indicates whether or not a grace period extension is applicable. ISDA 2003 Term: Grace Period Extension Applicable." ;
	skos:inScheme common_domain_model:cdm_observable_event .
common_domain_model:grossInitialMargin a owl:ObjectProperty ;
	rdfs:label "grossInitialMargin" ;
	skos:inScheme common_domain_model:cdm_margin_schedule .
common_domain_model:growthFactor a owl:DatatypeProperty ;
	rdfs:label "growthFactor" ;
	skos:definition "The daily growth factors, showing the weighted rates divided by the day count basis plus one, giving how much the value grows for each step in the calculation." ;
	skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .
common_domain_model:guarantor a owl:ObjectProperty ;
	rdfs:label "guarantor" ;
	skos:definition "The party that guarantees by way of a contractual arrangement to pay the debts of an obligor if the obligor is unable to make the required payments itself. ISDA 2003 Term: Guarantor." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:guarantorReference a owl:DatatypeProperty ;
	rdfs:label "guarantorReference" ;
	skos:definition "A pointer style reference to a reference entity defined elsewhere in the document. Used when the reference entity is the guarantor." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:guarantorType a owl:ObjectProperty ;
	rdfs:label "guarantorType" ;
	skos:definition "Specifies the origin of entity guaranteeing the collateral." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .
common_domain_model:haircutIndicator a owl:ObjectProperty ;
	rdfs:label "haircutIndicator" ;
	skos:definition "Indicates if the collateral balance amount is based on pre or post haircut, if a haircut is associated with the collateral asset" ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:haircutPercentage a owl:DatatypeProperty .
common_domain_model:hasControlAgreementLanguage a owl:DatatypeProperty ;
	rdfs:label "hasControlAgreementLanguage" ;
	skos:definition "Control Agreement language is specified when True." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:hedgingDisruption a owl:DatatypeProperty ;
	rdfs:label "hedgingDisruption" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .
common_domain_model:highestLowestVariableSet a owl:ObjectProperty ;
	rdfs:label "highestLowestVariableSet" ;
	skos:definition "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier where highest or lowest of the associated credit ratings are used when determining the applicable Independent Amount." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:history a owl:ObjectProperty ;
	rdfs:label "history" ;
	skos:definition "FRO History" ;
	skos:inScheme common_domain_model:cdm_observable_asset_fro .
common_domain_model:holdingAndUsingPostedCollateral a owl:ObjectProperty ;
	rdfs:label "holdingAndUsingPostedCollateral" ;
	skos:definition "The elections for the holding and using of posted collateral by the respective parties to the Credit Support Annex for Variation Margin." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:honorific a owl:DatatypeProperty ;
	rdfs:label "honorific" ;
	skos:definition "An honorific title, such as Mr., Ms., Dr. etc." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_party .
common_domain_model:hourMinuteTime a owl:DatatypeProperty ;
	rdfs:label "hourMinuteTime" ;
	skos:definition "A time specified in hh:mm:ss format where the second component must be '00', e.g. 11am would be represented as 11:00:00." ;
	skos:inScheme common_domain_model:cdm_base_datetime .
common_domain_model:hourminutetime a owl:DatatypeProperty ;
	rdfs:label "hourminutetime" ;
	skos:definition "A time specified in a 24-hour notation, e.g. 3pm would be represented as 15:00." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:icmaGmra a owl:ObjectProperty ;
	rdfs:label "icmaGmra" ;
	skos:definition "The set of elections that define a GMRA." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_master .
common_domain_model:identification a owl:ObjectProperty ;
	rdfs:label "identification" ;
	skos:definition "Identification information about the code list" ;
	skos:inScheme common_domain_model:cdm_base_staticdata_codelist .
common_domain_model:identifiedCrossCurrencySwap a owl:DatatypeProperty .
common_domain_model:identifier a owl:DatatypeProperty , owl:ObjectProperty .
common_domain_model:identifierType a owl:DatatypeProperty , owl:ObjectProperty .
