	skos:inScheme common_domain_model:cdm_product_template .
common_domain_model:PayRelativeToEnum\#CalculationPeriodEndDate a owl:Class ;
	rdfs:label "CalculationPeriodEndDate" ;
	rdfs:subClassOf common_domain_model:PayRelativeToEnum ;
	skos:definition "Payments will occur relative to the last day of each calculation period." .
common_domain_model:PayRelativeToEnum\#CalculationPeriodStartDate a owl:Class ;
	rdfs:label "CalculationPeriodStartDate" ;
	rdfs:subClassOf common_domain_model:PayRelativeToEnum ;
	skos:definition "Payments will occur relative to the first day of each calculation period." .
common_domain_model:PayRelativeToEnum\#LastPricingDate a owl:Class ;
	rdfs:label "LastPricingDate" ;
	rdfs:subClassOf common_domain_model:PayRelativeToEnum ;
	skos:definition "Payments will occur relative to the last Pricing Date of each Calculation Period." .
common_domain_model:PayRelativeToEnum\#ResetDate a owl:Class ;
	rdfs:label "ResetDate" ;
	rdfs:subClassOf common_domain_model:PayRelativeToEnum ;
	skos:definition "Payments will occur relative to the reset date." .
common_domain_model:PayRelativeToEnum\#ValuationDate a owl:Class ;
	rdfs:label "ValuationDate" ;
	rdfs:subClassOf common_domain_model:PayRelativeToEnum ;
	skos:definition "Payments will occur relative to the valuation date." .
