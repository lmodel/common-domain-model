            owl:onProperty common_domain_model:lowerBound ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:lowerBound ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PeriodBound ;
            owl:onProperty common_domain_model:upperBound ] ;
    skos:definition "Indicates The period range defined as either a lower and upper period bound, or both." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: AtLeastOneOf — lowerBound exists or upperBound exists" .

