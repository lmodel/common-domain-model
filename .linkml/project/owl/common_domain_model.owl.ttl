common_domain_model:CollateralCriteriaBase a owl:Class ;
    rdfs:label "CollateralCriteriaBase" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllCriteria common_domain_model:AnyCriteria common_domain_model:NegativeCriteria common_domain_model:CollateralIssuerType common_domain_model:CollateralGuarantorType common_domain_model:AssetType common_domain_model:IssuerCountryOfOrigin common_domain_model:AssetCountryOfOrigin common_domain_model:CurrencyCodeEnum common_domain_model:IssuerName common_domain_model:IssuerAgencyRating common_domain_model:SovereignAgencyRating common_domain_model:AssetAgencyRating common_domain_model:AssetMaturity common_domain_model:SpecificAsset common_domain_model:CollateralTaxonomy common_domain_model:ListingExchange common_domain_model:ListingSector common_domain_model:IndexType common_domain_model:CounterpartyOwnIssuePermitted common_domain_model:DomesticCurrencyIssued ) ] common_domain_model:CollateralCriteria ) ] ;
            owl:onProperty common_domain_model:collateralCriteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CollateralMarginTypeEnum ;
            owl:onProperty common_domain_model:restrictTo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:restrictTo ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:collateralCriteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:appliesTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RatingPriorityResolutionEnum ;
            owl:onProperty common_domain_model:ratingPriorityResolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:restrictTo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:ratingPriorityResolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:appliesTo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:collateralCriteria ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:ratingPriorityResolution ] ;
    skos:closeMatch fpml_5_10:CollateralCriteriaBase ;
    skos:definition "Represents a set of criteria used to specify and describe collateral." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

