common_domain_model:PriceTypeEnum\#ExchangeRate a owl:Class ;
	rdfs:label "ExchangeRate" ;
	rdfs:subClassOf common_domain_model:PriceTypeEnum ;
	skos:definition "Denotes a rate to convert one currency or other measure of value to another. Foreign Exchange rates are represented in decimals, e.g. {amount, unitOfAmount, PerUnitOfAmount} = [1.23, USD, GBP] = USD 1.23 for every 1 GBP." .
common_domain_model:PriceTypeEnum\#InterestRate a owl:Class ;
	rdfs:label "InterestRate" ;
	rdfs:subClassOf common_domain_model:PriceTypeEnum ;
	skos:definition "Denotes a price expressed as a rate to be applied to quantity/notional amount and represented as decimal, e.g. {amount, unitOfAmount, PerUnitOfAmount} = [0.08, EUR, EUR] = 8% of the EUR notional quantity/amount or 8 cents for every EUR of notional amount." ;
	common_domain_model:doc_reference "ICMA GMRA namingConvention Pricing Rate | ICMA ERCCBestPractice namingConvention Pricing Rate" .
common_domain_model:PriceTypeEnum\#Premium a owl:Class ;
	rdfs:label "Premium" ;
	rdfs:subClassOf common_domain_model:PriceTypeEnum ;
	skos:definition "Denotes the amount payable by the buyer to the seller for an option. The premium is paid on the specified premium payment date or on each premium payment date if specified." .
common_domain_model:PriceTypeEnum\#Variance a owl:Class ;
	rdfs:label "Variance" ;
	rdfs:subClassOf common_domain_model:PriceTypeEnum ;
	skos:definition "Denotes a price expressed as the the arithmetic average of the squared differences from the mean value of an observable price." .
common_domain_model:PriceTypeEnum\#Volatility a owl:Class ;
	rdfs:label "Volatility" ;
	rdfs:subClassOf common_domain_model:PriceTypeEnum ;
	skos:definition "Denotes a price expressed as the the square root of the arithmetic average of the squared differences from the mean value of an observable price." .
common_domain_model:PriceTypeEnum a owl:Class ;
	rdfs:label "PriceTypeEnum" ;
	owl:unionOf _:c14n9533 ;
	skos:definition "Provides enumerated values for types of prices in the Price data type in order to explain how to interpret the amount and use it in calculations." ;
	skos:inScheme common_domain_model:cdm_observable_asset ;
	linkml:permissible_values common_domain_model:PriceTypeEnum\#AssetPrice , common_domain_model:PriceTypeEnum\#Correlation , common_domain_model:PriceTypeEnum\#Dividend , common_domain_model:PriceTypeEnum\#ExchangeRate , common_domain_model:PriceTypeEnum\#InterestRate , common_domain_model:PriceTypeEnum\#Premium , common_domain_model:PriceTypeEnum\#Variance , common_domain_model:PriceTypeEnum\#Volatility .
