common_domain_model:appropriatedCollateralValuation a owl:ObjectProperty ;
    rdfs:label "appropriatedCollateralValuation" ;
    rdfs:range common_domain_model:AppropriatedCollateralValuation ;
    skos:definition "The election for the Valuation of Appropriate Collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:arithmeticOperator a owl:ObjectProperty ;
    rdfs:label "arithmeticOperator" ;
    rdfs:range common_domain_model:ArithmeticOperationEnum ;
    skos:definition "Specifies the arithmetic operator via an enumeration." ;
