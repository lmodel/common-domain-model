common_domain_model:SettlementTerms a owl:Class ;
	rdfs:label "SettlementTerms" ;
	rdfs:subClassOf common_domain_model:SettlementBase , _:c14n1161 , _:c14n11988 , _:c14n3551 , _:c14n6007 , _:c14n9054 ;
	skos:definition "Specifies the settlement terms, which can either be cash, physical, or fx-based cash-settlement. This class can be used for the settlement of options and forwards, cash transactions (e.g. securities or foreign exchange), or in case of credit event." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
