common_domain_model:DividendPayoutRatio a owl:Class ;
    rdfs:label "DividendPayoutRatio" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:nonCashRatio ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:basketConstituent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:nonCashRatio ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:cashRatio ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BasketConstituent ;
            owl:onProperty common_domain_model:basketConstituent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:cashRatio ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:nonCashRatio ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:cashRatio ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:totalRatio ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:totalRatio ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:totalRatio ] ;
    skos:definition "A class describing the dividend payout ratio associated with an equity underlier. In certain cases the actual ratio is not known on trade inception, and only general conditions are then specified." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    skos:note "Rosetta condition: DividendPayoutRatioCash — if cashRatio exists then cashRatio >= 0 and totalRatio <= 1",
        "Rosetta condition: DividendPayoutRatioNonCash — if nonCashRatio exists then nonCashRatio >= 0 and totalRatio <= 1",
        "Rosetta condition: DividendPayoutRatioTotal — totalRatio >= 0 and totalRatio <= 1" .

common_domain_model:EligibilityToHoldCollateralCriteria a owl:Class ;
    rdfs:label "EligibilityToHoldCollateralCriteria" ;
    skos:definition "Defines a set of Criteria required by the party and its custodian to hold the other party's Posted Collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." .

