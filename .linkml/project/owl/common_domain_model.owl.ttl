common_domain_model:PriceQuantity a owl:Class ;
    rdfs:label "PriceQuantity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSchedule ;
            owl:onProperty common_domain_model:price ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:observable ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Asset common_domain_model:Basket common_domain_model:Index ) ] common_domain_model:Observable ) ] ;
            owl:onProperty common_domain_model:observable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NonNegativeQuantitySchedule ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:price ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:observable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:quantity ] ;
    skos:definition "Defines a settlement as an exchange between two parties of a specified quantity of an asset (the quantity) against a specified quantity of another asset (the price). The settlement is optional and can be either cash or physical. The quantity can additionally be specified in terms of one or more currency amounts. In the case of non-cash products, the settlement of the price/quantity would not be specified here and instead would be delegated to the product mechanics, as parameterised by the price/quantity values." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    skos:note "Rosetta condition: ArithmeticOperator — if observable -> Index -> InterestRateIndex exists and price exists then price -> arithmeticOperator exists",
        "Rosetta condition: InterestRateObservable — InterestRateObservableCondition",
        "Rosetta condition: NonCurrencyQuantities — (quantity count - quantity -> unit -> currency count) <= 1 or (observable -> Asset -> Commodity exists and quantity -> unit -> capacityUnit exists and (quantity count - quantity -> unit -> currency count) <= 2)",
        "Rosetta func: InterestRateObservableCondition — Implementation for PriceQuantity.InterestRateObservable condition." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"InterestRateObservableCondition\",\"description\":\"Implementation for PriceQuantity.InterestRateObservable condition.\",\"inputs\":[{\"name\":\"pq\",\"type\":\"PriceQuantity\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"valid\",\"type\":\"boolean\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:RatingPriorityResolutionEnum a owl:Class ;
