    skos:definition "The Spot Rate for a Rate Calculation Date will be the Vietnamese Dong/U.S. Dollar spot rate expressed as the amount of Vietnamese Dong per one U.S. Dollar, for settlement in two Business Days which appears on Reuters Screen VNDFIX=VN Page under the caption 'Spot' and to the right of the caption 'Average' at approximately 11:00 am, Hanoi time, on that Rate Calculation Date." .

<https://w3id.org/lmodel/common-domain-model/SettlementRateOptionEnum#VND_SFEMC_INDICATIVE_SURVEY_RATE_VND03> a owl:Class ;
    rdfs:label "VND_SFEMC_INDICATIVE_SURVEY_RATE_VND03" ;
    rdfs:subClassOf common_domain_model:SettlementRateOptionEnum ;
    skos:altLabel "VND.SFEMC.INDICATIVE.SURVEY.RATE/VND03" ;
    skos:definition "The Spot Rate for a Rate Calculation Date will be the Vietnamese Dong/U.S. Dollar Specified Rate for U.S. Dollars, expressed as the amount of Vietnamese Dong per one U.S. Dollar, for settlement in two Business Days, as published on SFEMC's website (www.sfemc.org) at approximately 3:30 p.m., Singapore time, or as soon as thereafter as practicable, on that Rate Calculation Date. The Spot Rate shall be calculated by SFEMC (or a service provider SFEMC may select in its sole discretion) pursuant to the SFEMC VND Indicative Survey Methodology (which means a methodology, dated as of July 14, 2008, as amended from time to time, for a centralized industry-wide survey of financial institutions that are active participants in the Vietnamese Dong/U.S. Dollar markets for the purpose of determining the SFEMC VND Indicative Survey Rate)." .

<https://w3id.org/lmodel/common-domain-model/SettlementTypeEnum#Cash> a owl:Class ;
    rdfs:label "Cash" ;
    rdfs:subClassOf common_domain_model:SettlementTypeEnum ;
    skos:definition "The intrinsic value of the option will be delivered by way of a cash settlement amount determined, (i) by reference to the differential between the strike price and the settlement price; or (ii) in accordance with a bilateral agreement between the parties." .

<https://w3id.org/lmodel/common-domain-model/SettlementTypeEnum#CashOrPhysical> a owl:Class ;
    rdfs:label "CashOrPhysical" ;
    rdfs:subClassOf common_domain_model:SettlementTypeEnum ;
    skos:definition "Allow use of either Cash or Physical settlement without prior Election." .

<https://w3id.org/lmodel/common-domain-model/SettlementTypeEnum#Election> a owl:Class ;
    rdfs:label "Election" ;
    rdfs:subClassOf common_domain_model:SettlementTypeEnum ;
    skos:definition "Allow Election of either Cash or Physical settlement." .

<https://w3id.org/lmodel/common-domain-model/SettlementTypeEnum#Physical> a owl:Class ;
    rdfs:label "Physical" ;
    rdfs:subClassOf common_domain_model:SettlementTypeEnum ;
    skos:definition "The securities underlying the transaction will be delivered by (i) in the case of a call, the seller to the buyer, or (ii) in the case of a put, the buyer to the seller versus a settlement amount equivalent to the strike price per share." .

common_domain_model:ShapingProvision a owl:Class ;
    rdfs:label "ShapingProvision" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:shapeSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Money ;
            owl:onProperty common_domain_model:shapeSchedule ] ;
    skos:definition "Defines the applicable settlement limits that may require a settlement to be 'shaped', i.e. broken-down into smaller amounts." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

<https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum#AlternativeObligation> a owl:Class ;
    rdfs:label "AlternativeObligation" ;
    rdfs:subClassOf common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "The trade continues such that the underlying now consists of the New Shares and/or the Other Consideration, if any, and the proceeds of any redemption, if any, that the holder of the underlying Shares would have been entitled to." .

<https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum#CalculationAgent> a owl:Class ;
    rdfs:label "CalculationAgent" ;
    rdfs:subClassOf common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "The Calculation Agent will determine what adjustment is required to offset any change to the economics of the trade. If the Calculation Agent cannot achieve this, the trade goes to Cancellation and Payment with the Calculation Agent deciding on the value of the cancellation fee. Adjustments may not be made to account solely for changes in volatility, expected dividends, stock loan rate or liquidity." .

<https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum#CancellationAndPayment> a owl:Class ;
    rdfs:label "CancellationAndPayment" ;
    rdfs:subClassOf common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "The trade is cancelled and a cancellation fee will be paid by one party to the other." .

<https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum#Component> a owl:Class ;
    rdfs:label "Component" ;
    rdfs:subClassOf common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "If this is a Share-for-Combined merger event (Shares are replaced with New Shares and Other Consideration), then different treatment can be applied to each component if the parties have specified this." .

<https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum#ModifiedCalculationAgent> a owl:Class ;
    rdfs:label "ModifiedCalculationAgent" ;
    rdfs:subClassOf common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "The Calculation Agent will determine what adjustment is required to offset any change to the economics of the trade. If the Calculation Agent cannot achieve this, the trade goes to Cancellation and Payment with the Calculation Agent deciding on the value of the cancellation fee. Adjustments to account for changes in volatility, expected dividends, stock loan rate or liquidity are allowed." .

<https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum#OptionsExchange> a owl:Class ;
    rdfs:label "OptionsExchange" ;
    rdfs:subClassOf common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "The trade will be adjusted by the Calculation Agent in accordance with the adjustments made by any exchange on which options on the underlying are listed." .

<https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum#PartialCancellationAndPayment> a owl:Class ;
    rdfs:label "PartialCancellationAndPayment" ;
    rdfs:subClassOf common_domain_model:ShareExtraordinaryEventEnum ;
    skos:definition "Applies to Basket Transactions. The portion of the Basket made up by the affected Share will be cancelled and a cancellation fee will be paid from one party to the other. The remainder of the trade continues." .

common_domain_model:SimmCalculationCurrency a owl:Class ;
