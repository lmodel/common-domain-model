common_domain_model:ValuationInstruction a owl:Class ;
    rdfs:label "ValuationInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Valuation ;
            owl:onProperty common_domain_model:valuation ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:valuation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:replace ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:replace ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:replace ] ;
    skos:definition "Specifies inputs needed to process a valuation." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta func: Create_Valuation — Function specification to incorporate a new assessment of the valuation in the valuation history of a given trade state." ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_Valuation\",\"description\":\"Function specification to incorporate a new assessment of the valuation in the valuation history of a given trade state.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"ValuationInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"before\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"after\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" .

