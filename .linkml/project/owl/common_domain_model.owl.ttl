common_domain_model:MasterAgreementClauseVariant a owl:Class ;
    rdfs:label "MasterAgreementClauseVariant" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MasterAgreementVariantIdentifierEnum ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:variableSet ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:otherParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MasterAgreementVariableSet ;
            owl:onProperty common_domain_model:variableSet ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:counterparty ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PartyRoleEnum ;
            owl:onProperty common_domain_model:otherParty ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:counterparty ] ;
    skos:definition "Sets the details for a specific variant associated to a clause in a Master Agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master .

common_domain_model:MasterAgreementDatedAsOfDate a owl:Class ;
    rdfs:label "MasterAgreementDatedAsOfDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:additionalLanguage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:masterAgreementDatedAsOfDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:additionalLanguage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:masterAgreementDatedAsOfDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:additionalLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:masterAgreementDatedAsOfDate ] ;
