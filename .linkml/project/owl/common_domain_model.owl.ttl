	rdfs:subClassOf _:c14n10717 , _:c14n10905 , _:c14n10995 , _:c14n11953 , _:c14n12005 , _:c14n12453 , _:c14n13081 , _:c14n13157 , _:c14n13485 , _:c14n14042 , _:c14n14334 , _:c14n14693 , _:c14n1685 , _:c14n2076 , _:c14n2479 , _:c14n3367 , _:c14n3697 , _:c14n3752 , _:c14n3942 , _:c14n4606 , _:c14n4965 , _:c14n5275 , _:c14n5589 , _:c14n5977 , _:c14n630 , _:c14n6499 , _:c14n6578 , _:c14n6613 , _:c14n6777 , _:c14n6991 , _:c14n7325 , _:c14n9063 , _:c14n9109 ;
	skos:definition "The definitive state object for the Reset process. It acts as a cumulative 'Golden Record,' storing every data point captured from Step 1 (Index Collection) through Step 7 (Final Calculation) to ensure deterministic processing." ;
	skos:inScheme common_domain_model:cdm_event_instructioncomposition , common_domain_model:cdm_event_instructioncomposition_reset .
