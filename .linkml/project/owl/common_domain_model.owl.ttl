common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeC a owl:Class ;
	rdfs:label "UK_EMIRTypeC" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
