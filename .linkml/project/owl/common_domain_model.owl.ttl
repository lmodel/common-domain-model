	skos:inScheme common_domain_model:cdm_observable_asset ;
	common_domain_model:rosetta_metadata "scheme" .
common_domain_model:cashCollateralTransferSettlementTime a owl:ObjectProperty ;
	rdfs:label "cashCollateralTransferSettlementTime" ;
	skos:definition "Details the day on which collateral is required to be transferred relative to the Notification Time." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:cashCollateralValuationMethod a owl:ObjectProperty ;
	rdfs:label "cashCollateralValuationMethod" ;
	skos:definition "Specifies the parameters representing several mid-market valuation and replacement value methods." ;
	skos:inScheme common_domain_model:cdm_observable_asset .
common_domain_model:cashOrSecurityValue a owl:ObjectProperty ;
	rdfs:label "cashOrSecurityValue" ;
	skos:definition "The Base Currency Equivalent of Cash or Security." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_csa .
common_domain_model:cashRatio a owl:DatatypeProperty ;
	rdfs:label "cashRatio" ;
	skos:definition "Specifies the cash actual dividend payout ratio associated with the equity underlier. A ratio of 90% should be expressed at 0.90." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:cashSettlement a owl:ObjectProperty .
common_domain_model:cashSettlementAmount a owl:ObjectProperty ;
	rdfs:label "cashSettlementAmount" ;
	skos:definition "The amount paid by the seller to the buyer for cash settlement on the cash settlement date. If not otherwise specified, would typically be calculated as 100 (or the Reference Price) minus the price of the Reference Obligation (all expressed as a percentage) times Floating Rate Payer Calculation Amount. ISDA 2003 Term: Cash Settlement Amount." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:cashSettlementBusinessDays a owl:DatatypeProperty ;
	rdfs:label "cashSettlementBusinessDays" ;
	skos:definition "The number of business days used in the determination of the cash settlement payment date. If a cash settlement amount is specified, the cash settlement payment date will be this number of business days following the calculation of the final price. If a cash settlement amount is not specified, the cash settlement payment date will be this number of business days after all conditions to settlement are satisfied. ISDA 2003 Term: Cash Settlement Date. This attribute was formerly part of 'CashSettlementTerms' as used for credit event settlement, which now includes a common 'SettlementDate' attribute." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:cashSettlementCentre a owl:ObjectProperty ;
	rdfs:label "cashSettlementCentre" ;
	skos:definition "Specifies the settlement centre of cash." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:cashSettlementDay a owl:DatatypeProperty .
common_domain_model:cashSettlementMethod a owl:ObjectProperty ;
	rdfs:label "cashSettlementMethod" ;
	skos:definition "Specifies the type of cash settlement method: cash price, yield curve etc." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:cashSettlementOnly a owl:DatatypeProperty ;
	rdfs:label "cashSettlementOnly" ;
	skos:definition "An obligation and deliverable obligation characteristic. Defined in the ISDA published Standard Terms Supplement for use with CDS Transactions on Leveraged Loans. ISDA 2003 Term: Cash Settlement Only." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .
common_domain_model:cashSettlementTerms a owl:ObjectProperty ;
	rdfs:label "cashSettlementTerms" ;
	skos:definition "Specifies the parameters associated with the cash settlement procedure." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:cashSettlementTermsReference a owl:ObjectProperty ;
	rdfs:label "cashSettlementTermsReference" ;
	skos:definition "Reference to the cash settlement terms applicable to this item." ;
	skos:inScheme common_domain_model:cdm_product_asset ;
	common_domain_model:rosetta_metadata "reference" .
common_domain_model:cashTransfer a owl:ObjectProperty ;
	rdfs:label "cashTransfer" ;
	skos:definition "Specifies the cash transfer that can optionally be tied to an index transition event." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:cashflowRepresentation a owl:ObjectProperty ;
	rdfs:label "cashflowRepresentation" ;
	skos:definition "The cashflow representation of the swap stream." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:cashflowsMatchParameters a owl:DatatypeProperty ;
	rdfs:label "cashflowsMatchParameters" ;
	skos:definition "A true/false flag to indicate whether the cashflows match the parametric definition of the stream, i.e. whether the cashflows could be regenerated from the parameters without loss of information." ;
	skos:inScheme common_domain_model:cdm_product_asset .
common_domain_model:category a owl:ObjectProperty .
common_domain_model:change a owl:ObjectProperty ;
	rdfs:label "change" ;
	skos:definition "Quantity by which the trade is being increased, decreased or replaced, and the price at which such quantity change is agreed. The quantity change should always be specified as a positive number, with the direction (increase/decrease/replacement) being specified by the direction enumeration. A fee can also be associated to the quantity change by specifying a Price component of type CashPrice, including the corresponding settlement date and direction." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:changeInLaw a owl:DatatypeProperty ;
	rdfs:label "changeInLaw" ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .
common_domain_model:childSecurity a owl:ObjectProperty ;
	rdfs:label "childSecurity" ;
	skos:definition "Defines the underlier for the Child Company involved in Spin Off corporate action." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:childSecurityPrice a owl:ObjectProperty ;
	rdfs:label "childSecurityPrice" ;
	skos:definition "The price observation that relates to underlier for the Child Company." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:city a owl:DatatypeProperty ;
	rdfs:label "city" ;
	skos:definition "The city component of the postal address." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_party .
common_domain_model:className a owl:DatatypeProperty ;
	rdfs:label "className" ;
	skos:definition "The name defined by the classification system for a specific attribute in the taxonomy" ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .
common_domain_model:classification a owl:ObjectProperty ;
	rdfs:label "classification" ;
	skos:definition "Specifies the taxonomy value as a set of class names and values for each class." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .
common_domain_model:clause a owl:ObjectProperty ;
	rdfs:label "clause" ;
	skos:definition "Clauses that have had elections made against them in this Agreement. There must be at least one clause defined in the agreement." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_clauselibrary .
common_domain_model:clauseLibrary a owl:DatatypeProperty ;
	rdfs:label "clauseLibrary" ;
	skos:definition "Specification of whether the agreement terms have been negotiated using the clause library methodology." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_common .
common_domain_model:clauseLibrarySchedule a owl:ObjectProperty ;
	rdfs:label "clauseLibrarySchedule" ;
	skos:definition "Elections specified through a Clause Library." ;
	skos:inScheme common_domain_model:cdm_legaldocumentation_common .
common_domain_model:clearedPhysicalSettlement a owl:DatatypeProperty ;
	rdfs:label "clearedPhysicalSettlement" ;
	skos:definition "Specifies whether the swap resulting from physical settlement of the swaption transaction will clear through a clearing house. The meaning of Cleared Physical Settlement is defined in the 2006 ISDA Definitions, Section 15.2 (published in Supplement number 28)." ;
	skos:inScheme common_domain_model:cdm_product_common_settlement .
common_domain_model:clearerParty1 a owl:ObjectProperty ;
	rdfs:label "clearerParty1" ;
	skos:definition "Optional party facing the CCP, acting as clearing member for party1." ;
	skos:inScheme common_domain_model:cdm_event_common .
common_domain_model:clearerParty2 a owl:ObjectProperty ;
	rdfs:label "clearerParty2" ;
	skos:definition "Optional party facing the CCP, acting as clearing member for party2." ;
