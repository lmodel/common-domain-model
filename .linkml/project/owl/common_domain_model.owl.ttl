common_domain_model:Offset a owl:Class ;
    rdfs:label "Offset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dayType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DayTypeEnum ;
            owl:onProperty common_domain_model:dayType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dayType ],
        common_domain_model:Period ;
    skos:definition "A class defining an offset used in calculating a new date relative to a reference date, e.g. calendar days, business days, commodity Business days, etc." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: DayType — if period <> PeriodEnum -> D or periodMultiplier = 0 then dayType is absent" .

