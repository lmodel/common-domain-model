	skos:inScheme common_domain_model:cdm_event_instructioncomposition ;
	skos:note "Rosetta condition CompositionStateByType is not stated in LinkML: if instructionCompositionType = ResetInstruction then (compositionState switch ResetInstructionState then True) = True" , "Rosetta condition InstructionCompositionType is not stated in LinkML: compositionStep -> compositionStepInstruction -> instructionCompositionType all = instructionCompositionType" ;
	common_domain_model:rosetta_root_type "true" .
