    common_domain_model:rosetta_functions "[{\"name\":\"FilterRelatedPartyByRole\",\"description\":\"Filters the list of RelatedParty based on the provided partyRoleEnum.\",\"inputs\":[{\"name\":\"relatedParties\",\"type\":\"RelatedParty\",\"cardinality\":\"0..*\"},{\"name\":\"partyRoleEnum\",\"type\":\"PartyRoleEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredRelatedParties\",\"type\":\"RelatedParty\",\"cardinality\":\"0..*\"}}]" .

common_domain_model:ReturnInstruction a owl:Class ;
