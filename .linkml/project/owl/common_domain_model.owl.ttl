common_domain_model:BusinessDateRange a owl:Class ;
    rdfs:label "BusinessDateRange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessCenters ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenters ;
            owl:onProperty common_domain_model:businessCenters ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayConventionEnum ;
            owl:onProperty common_domain_model:businessDayConvention ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessDayConvention ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:businessDayConvention ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessCenters ],
        common_domain_model:DateRange ;
    skos:closeMatch fpml_5_10:BusinessDateRange ;
    skos:definition "A class defining a range of contiguous business days by defining an unadjusted first date, an unadjusted last date and a business day convention and business centers for adjusting the first and last dates if they would otherwise fall on a non business day in the specified business centers. The days between the first and last date must also be good business days in the specified centers to be counted in the range." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#FOLLOWING> a owl:Class ;
    rdfs:label "FOLLOWING" ;
    rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
    skos:definition "The non-business date will be adjusted to the first following day that is a business day" .

<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#FRN> a owl:Class ;
    rdfs:label "FRN" ;
    rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
    skos:definition "Per 2000 ISDA Definitions, Section 4.11. FRN Convention; Eurodollar Convention. FRN is included here as a type of business day convention although it does not strictly fall within ISDA's definition of a Business Day Convention and does not conform to the simple definition given above." .

<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#MODFOLLOWING> a owl:Class ;
    rdfs:label "MODFOLLOWING" ;
    rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
    skos:definition "The non-business date will be adjusted to the first following day that is a business day unless that day falls in the next calendar month, in which case that date will be the first preceding day that is a business day." .

<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#MODPRECEDING> a owl:Class ;
    rdfs:label "MODPRECEDING" ;
    rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
    skos:definition "The non-business date will be adjusted to the first preceding day that is a business day unless that day falls in the previous calendar month, in which case that date will be the first following day that us a business day." .

<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NEAREST> a owl:Class ;
    rdfs:label "NEAREST" ;
    rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
    skos:definition "The non-business date will be adjusted to the nearest day that is a business day - i.e. if the non-business day falls on any day other than a Sunday or a Monday, it will be the first preceding day that is a business day, and will be the first following business day if it falls on a Sunday or a Monday." .

<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NONE> a owl:Class ;
    rdfs:label "NONE" ;
    rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
    skos:definition "The date will not be adjusted if it falls on a day that is not a business day." .

<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#NotApplicable> a owl:Class ;
    rdfs:label "NotApplicable" ;
    rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
    skos:definition "The date adjustments conventions are defined elsewhere, so it is not required to specify them here." .

<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum#PRECEDING> a owl:Class ;
    rdfs:label "PRECEDING" ;
    rdfs:subClassOf common_domain_model:BusinessDayConventionEnum ;
    skos:definition "The non-business day will be adjusted to the first preceding day that is a business day." .

common_domain_model:BusinessEvent a owl:Class ;
    rdfs:label "BusinessEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TradeState ;
            owl:onProperty common_domain_model:after ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:eventQualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:after ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:eventQualifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:eventQualifier ],
        common_domain_model:EventInstruction ;
    skos:closeMatch gist:Event,
        fpml_5_10:BusinessEvent ;
    skos:definition "A business event represents a life cycle event of a trade. The combination of the state changes results in a qualifiable life cycle event. An example of a Business Event is a PartialTermination which is a defined by a quantity change primitive event." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: EventDate — eventDate exists",
        "Rosetta func: Create_BusinessEvent — Creates a business event from instructions containing primitive instructions and optionally a trade state.",
        "Rosetta func: Create_Return — Defines the process of partially or fully returning a Security Lending Transaction.",
        "Rosetta func: ExtractAfterTrade",
        "Rosetta func: ExtractBeforeEconomicTerms",
        "Rosetta func: ExtractBeforeTrade",
        "Rosetta func: ExtractOpenEconomicTerms",
        "Rosetta func: Qualify_Substitution — Qualification of a collateral substitution event." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_Return\",\"description\":\"Defines the process of partially or fully returning a Security Lending Transaction.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"},{\"name\":\"returnInstruction\",\"type\":\"ReturnInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"returnDate\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"returnEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}},{\"name\":\"Qualify_Substitution\",\"description\":\"Qualification of a collateral substitution event.\",\"inputs\":[{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"is_event\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_BusinessEvent\",\"description\":\"Creates a business event from instructions containing primitive instructions and optionally a trade state.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"Instruction\",\"cardinality\":\"1..*\"},{\"name\":\"intent\",\"type\":\"EventIntentEnum\",\"cardinality\":\"0..1\"},{\"name\":\"eventDate\",\"type\":\"date\",\"cardinality\":\"1..1\"},{\"name\":\"effectiveDate\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}},{\"name\":\"ExtractBeforeEconomicTerms\",\"inputs\":[{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"economicTerms\",\"type\":\"EconomicTerms\",\"cardinality\":\"0..1\"}},{\"name\":\"ExtractOpenEconomicTerms\",\"inputs\":[{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"economicTerms\",\"type\":\"EconomicTerms\",\"cardinality\":\"0..1\"}},{\"name\":\"ExtractBeforeTrade\",\"inputs\":[{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"trade\",\"type\":\"Trade\",\"cardinality\":\"0..1\"}},{\"name\":\"ExtractAfterTrade\",\"inputs\":[{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"trade\",\"type\":\"Trade\",\"cardinality\":\"0..1\"}}]" .

