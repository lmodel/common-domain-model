common_domain_model:FloatingRateIndexProcessingTypeEnum a owl:Class ;
    rdfs:label "FloatingRateIndexProcessingTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#Screen> <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#CompoundIndex> <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#OIS> <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#OvernightAvg> <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#Modular> <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexProcessingTypeEnum#RefBanks> ) ;
