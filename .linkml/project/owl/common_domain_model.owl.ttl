common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeD a owl:Class ;
	rdfs:label "UK_EMIRTypeD" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by United Kingdom regional governments or local authorities whose exposures are treated as exposures to the central government of the United Kingdom in accordance with Article 115(2) of Regulation (EU) No 575/2013." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeE a owl:Class ;
	rdfs:label "UK_EMIRTypeE" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by United Kingdom public sector entities whose exposures are treated as exposures to the central government, regional government or local authority of the United Kingdom in accordance with Article 116(4) of Regulation (EU) No 575/2013." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeF a owl:Class ;
	rdfs:label "UK_EMIRTypeF" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by United Kingdom regional governments or local authorities other than those referred to in (TypeD)." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeG a owl:Class ;
	rdfs:label "UK_EMIRTypeG" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by United Kingdom public sector entities other than those referred to in (TypeE)." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeH a owl:Class ;
	rdfs:label "UK_EMIRTypeH" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by multilateral development banks listed in Article 117(2) of Regulation (EU) No 575/2013." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeI a owl:Class ;
	rdfs:label "UK_EMIRTypeI" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by the international organisations listed in Article 118 of Regulation (EU) No 575/2013." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeJ a owl:Class ;
	rdfs:label "UK_EMIRTypeJ" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by third countries' governments or central banks." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeK a owl:Class ;
	rdfs:label "UK_EMIRTypeK" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by third countries' regional governments or local authorities that meet the requirements of (TypeD) and (TypeE)." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeL a owl:Class ;
	rdfs:label "UK_EMIRTypeL" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by third countries' regional governments or local authorities other than those referred to in (TypeD) and (TypeE)." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeM a owl:Class ;
	rdfs:label "UK_EMIRTypeM" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes debt securities issued by credit institutions or investment firms including bonds admitted to the register of regulated covered bonds maintained under Regulation 7(1)(b) of the Regulated Covered Bonds Regulations 2008 (SI 2008/346)." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeN a owl:Class ;
	rdfs:label "UK_EMIRTypeN" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes corporate bonds." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeO a owl:Class ;
	rdfs:label "UK_EMIRTypeO" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes the most senior tranche of a securitisation, as defined in Article 4(61) of Regulation (EU) No 575/2013, that is not a re-securitisation as defined in Article 4(63) of that Regulation." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeP a owl:Class ;
	rdfs:label "UK_EMIRTypeP" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes convertible bonds provided that they can be converted only into equities which are included in an index specified pursuant to point (a) of Article 197 (8) of Regulation (EU) No 575/2013." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeQ a owl:Class ;
	rdfs:label "UK_EMIRTypeQ" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes equities included in an index specified pursuant to point (a) of Article 197(8) of Regulation (EU) No 575/2013." .
common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeR a owl:Class ;
	rdfs:label "UK_EMIRTypeR" ;
	rdfs:subClassOf common_domain_model:UKEMIREligibleCollateralEnum ;
	skos:definition "Denotes shares or units in undertakings for UK UCITS, provided that the conditions set out in Article 5 of EU Regulation 2016/2251 (as modified by the Technical Standards (European Market Infrastructure) (EU Exit) (No. 3) Instrument 2019) are met." .
common_domain_model:UKEMIREligibleCollateralEnum a owl:Class ;
	rdfs:label "UK_EMIR_EligibleCollateralEnum" ;
	owl:unionOf _:c14n7070 ;
	skos:definition "Identifies United Kingdom Eligible Collateral Assets classification categories based on UK Onshored EMIR Uncleared Margin Rules. Eligible Collateral asset classes for both initial margin (IM) and variation margin (VM) posted and collected between specified entities. Please note: UK EMIR regulation will detail which eligible collateral assets classes apply to each type of entity pairing (counterparty) and which apply to posting of IM and VM." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
	linkml:permissible_values common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeA , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeB , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeC , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeD , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeE , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeF , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeG , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeH , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeI , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeJ , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeK , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeL , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeM , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeN , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeO , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeP , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeQ , common_domain_model:UKEMIREligibleCollateralEnum\#UK_EMIRTypeR .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType1 a owl:Class ;
	rdfs:label "US_CFTC_PRType1" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes immediately available cash funds denominated in USD, a major currency, a currency of settlement for the uncleared swap." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType2 a owl:Class ;
	rdfs:label "US_CFTC_PRType2" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a security that is issued by, or unconditionally guaranteed as to the timely payment of principal and interest by, the U.S. Department of the Treasury." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType3 a owl:Class ;
	rdfs:label "US_CFTC_PRType3" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a security that is issued by, or unconditionally guaranteed as to the timely payment of principal and interest by, a U.S. government agency (other than the U.S. Department of Treasury) whose obligations are fully guaranteed by the full faith and credit of the United States government." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType4 a owl:Class ;
	rdfs:label "US_CFTC_PRType4" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a security that is issued by, or fully guaranteed as to the payment of principal and interest by, the European Central Bank or a sovereign entity that is assigned no higher than a 20 percent risk weight under the capital rules applicable to swap dealers subject to regulation by a prudential regulator." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType5A a owl:Class ;
	rdfs:label "US_CFTC_PRType5A" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a publicly traded debt security issued by, or an asset-backed security fully guaranteed as to the timely payment of principal and interest by, a U.S. Government-sponsored enterprise that is operating with capital support or another form of direct financial assistance received from the U.S. government that enables the repayments of the U.S. Government-sponsored enterprise's eligible securities." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType5B a owl:Class ;
	rdfs:label "US_CFTC_PRType5B" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a publicly traded debt security, but not an asset backed security, that is investment grade and issued by a U.S. Government-sponsored enterprise that is not operating with capital support or another form of direct financial assistance received from the U.S. government." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType6 a owl:Class ;
	rdfs:label "US_CFTC_PRType6" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a security that is issued by, or fully guaranteed as to the payment of principal and interest by, the Bank for International Settlements, the International Monetary Fund, or a multilateral development bank." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType7 a owl:Class ;
	rdfs:label "US_CFTC_PRType7" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes publicly-traded debt, but not an asset backed security, that is investment grade and is not a debt security issued by a U.S. Government-sponsored enterprise. This category excludes a security issued by a non-bank financial institution supervised by the board of governors of the Federal Reserve System under Title I of the Dodd-Frank Wall Street Reform and Consumer Protection Act. This category also excludes a security issued by any of the following entities, by a company that would be any of the following entities if it were the organized under the laws of the United States or any State, or in either case by an affiliate of such an entity: the party posting the collateral, a bank holding company, a savings and loan holding company, a U.S. intermediate holding company, a foreign bank, a depositary institution, a securities holding company, a broker, a dealer, a futures commission merchant, a swap dealer, or a security-based swap dealer." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType8A a owl:Class ;
	rdfs:label "US_CFTC_PRType8A" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a publicly traded common equity security that is included in the Standard & Poor's Composite 500 Index or related indexes. This category excludes a security issued by a non-bank financial institution supervised by the board of governors of the Federal Reserve System under Title I of the Dodd-Frank Wall Street Reform and Consumer Protection Act. This category also excludes a security issued by any of the following entities, by a company that would be any of the following entities if it were the organized under the laws of the United States or any State, or in either case by an affiliate of such an entity: the party posting the collateral, a bank holding company, a savings and loan holding company, a U.S. intermediate holding company, a foreign bank, a depositary institution, a securities holding company, a broker, a dealer, a futures commission merchant, a swap dealer, or a security-based swap dealer." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType8B a owl:Class ;
	rdfs:label "US_CFTC_PRType8B" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a publicly traded common equity security that is included in the Standard & Poor's Composite 1500 Index or related indexes. This category excludes a security issued by a non-bank financial institution supervised by the board of governors of the Federal Reserve System under Title I of the Dodd-Frank Wall Street Reform and Consumer Protection Act. This category also excludes a security issued by any of the following entities, by a company that would be any of the following entities if it were the organized under the laws of the United States or any State, or in either case by an affiliate of such an entity: the party posting the collateral, a bank holding company, a savings and loan holding company, a U.S. intermediate holding company, a foreign bank, a depositary institution, a securities holding company, a broker, a dealer, a futures commission merchant, a swap dealer, or a security-based swap dealer." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType8C a owl:Class ;
	rdfs:label "US_CFTC_PRType8C" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes a publicly traded common equity security that is included in an index that a regulated swap entity's supervisor in a foreign jurisdiction recognizes for purposes of including publicly traded common equity as initial margin under applicable regulatory policy, if held in that foreign jurisdiction. This category excludes a security issued by a non-bank financial institution supervised by the board of governors of the Federal Reserve System under Title I of the Dodd-Frank Wall Street Reform and Consumer Protection Act. This category also excludes a security issued by any of the following entities, by a company that would be any of the following entities if it were the organized under the laws of the United States or any State, or in either case by an affiliate of such an entity: the party posting the collateral, a bank holding company, a savings and loan holding company, a U.S. intermediate holding company, a foreign bank, a depositary institution, a securities holding company, a broker, a dealer, a futures commission merchant, a swap dealer, or a security-based swap dealer." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CFTC_PRType9 a owl:Class ;
	rdfs:label "US_CFTC_PRType9" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes securities in the form of redeemable securities in a pooled investment fund representing the security-holder's proportional interest in the fund's net assets and that are issued and redeemed only on the basis of the market value of the fund's net assets prepared each business day after the security-holder makes its investment commitment or redemption request to the fund, if the fund's investments are limited to the following: (A) securities that are issued by, or unconditionally guaranteed as to the timely payment of principal and interest by, the U.S. Department of the Treasury, and immediately-available cash funds denominated in U.S. dollars; or (B) securities denominated in a common currency and issued by, or fully guaranteed as to the payment of principal and interest by, the European Central Bank or a sovereign entity that is assigned no higher than a 20 percent risk weight under the capital rules applicable to swap dealers subject to regulation by a prudential regulator, and immediately-available cash funds denominated in the same currency; and (C) assets of the fund may not be transferred through securities lending, securities borrowing, repurchase agreements, reverse repurchase agreements, or other means that involve the fund having rights to acquire the same or similar assets from the transferee." .
common_domain_model:USCFTCPREligibleCollateralEnum\#US_CTFC_PRType10 a owl:Class ;
	rdfs:label "US_CTFC_PRType10" ;
	rdfs:subClassOf common_domain_model:USCFTCPREligibleCollateralEnum ;
	skos:definition "Denotes Gold." .
common_domain_model:USCFTCPREligibleCollateralEnum a owl:Class ;
	rdfs:label "US_CFTC_PR_EligibleCollateralEnum" ;
	owl:unionOf _:c14n8589 ;
	skos:definition "Identifies US Eligible Collateral Assets classification categories based on Uncleared Margin Rules published by the CFTC and the US Prudential Regulator. Note: While the same basic categories exist in the CFTC and US Prudential Regulators margin rules, the precise definitions or application of those rules could differ between the two rules." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
