    rdfs:label "ExerciseNoticeGiverEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeGiverEnum#Buyer> <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeGiverEnum#Seller> <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeGiverEnum#Both> <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeGiverEnum#AsSpecifiedInMasterAgreement> ) ;
    skos:definition "Defines the principal party to the trade that has the right to exercise." ;
