common_domain_model:ContractFormationInstruction a owl:Class ;
    rdfs:label "ContractFormationInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:legalAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalAgreement ;
            owl:onProperty common_domain_model:legalAgreement ] ;
    skos:definition "Specifies instructions to create a fully formed contract, with optional legal agreements." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: ExecutedAgreements — if legalAgreement exists then legalAgreement -> agreementDate exists",
        "Rosetta func: Create_ContractFormation — Function specification that represents an executed trade for a contractual product that has been affirmed (or confirmed) by the two parties. The formed contract can reference a legal agreement for instance a master agreement, by using the optional legalAgreement input.",
        "Rosetta func: Create_ContractFormationInstruction" ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_ContractFormationInstruction\",\"inputs\":[{\"name\":\"legalAgreement\",\"type\":\"LegalAgreement\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"instruction\",\"type\":\"ContractFormationInstruction\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_ContractFormation\",\"description\":\"Function specification that represents an executed trade for a contractual product that has been affirmed (or confirmed) by the two parties. The formed contract can reference a legal agreement for instance a master agreement, by using the optional legalAgreement input.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"ContractFormationInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"execution\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"contractFormation\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" .

