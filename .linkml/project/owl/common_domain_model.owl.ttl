    rdfs:subClassOf common_domain_model:RollSourceCalendarEnum .

<https://w3id.org/lmodel/common-domain-model/RoundingDirectionEnum#Down> a owl:Class ;
    rdfs:label "Down" ;
    rdfs:subClassOf common_domain_model:RoundingDirectionEnum ;
    skos:definition "A fractional number will be rounded down to the specified number of decimal places (the precision). For example, 5.29 and 5.25 rounded down to 1 decimal place are 5.2 and 5.2 respectively." .

<https://w3id.org/lmodel/common-domain-model/RoundingDirectionEnum#Nearest> a owl:Class ;
    rdfs:label "Nearest" ;
    rdfs:subClassOf common_domain_model:RoundingDirectionEnum ;
    skos:definition "A fractional number will be rounded either up or down to the specified number of decimal places (the precision) depending on its value. For example, 5.24 would be rounded down to 5.2 and 5.25 would be rounded up to 5.3 if a precision of 1 decimal place were specified." .

<https://w3id.org/lmodel/common-domain-model/RoundingDirectionEnum#Up> a owl:Class ;
    rdfs:label "Up" ;
    rdfs:subClassOf common_domain_model:RoundingDirectionEnum ;
    skos:definition "A fractional number will be rounded up to the specified number of decimal places (the precision). For example, 5.21 and 5.25 rounded up to 1 decimal place are 5.3 and 5.3 respectively." .

<https://w3id.org/lmodel/common-domain-model/RoundingFrequencyEnum#Daily> a owl:Class ;
    rdfs:label "Daily" ;
    rdfs:subClassOf common_domain_model:RoundingFrequencyEnum ;
    skos:definition "Rounding is done on each day" .

<https://w3id.org/lmodel/common-domain-model/RoundingFrequencyEnum#PeriodEnd> a owl:Class ;
    rdfs:label "PeriodEnd" ;
    rdfs:subClassOf common_domain_model:RoundingFrequencyEnum ;
    skos:definition "Rounding is done only at the end of the period" .

<https://w3id.org/lmodel/common-domain-model/RoundingModeEnum#Down> a owl:Class ;
    rdfs:label "Down" ;
    rdfs:subClassOf common_domain_model:RoundingModeEnum ;
    skos:definition "A number will be rounded down to the specified nearest number. For example, 529 rounded down to the nearest 10 is 520." .

<https://w3id.org/lmodel/common-domain-model/RoundingModeEnum#Up> a owl:Class ;
    rdfs:label "Up" ;
    rdfs:subClassOf common_domain_model:RoundingModeEnum ;
    skos:definition "A number will be rounded up to the specified nearest number. For example, 521 rounded up to the nearest 10 is 530." .

common_domain_model:SchedulePeriod a owl:Class ;
    rdfs:label "SchedulePeriod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:paymentDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:fixingPeriod ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:calculationPeriod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:deliveryPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fixingPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:deliveryPeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:calculationPeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DateRange ;
            owl:onProperty common_domain_model:calculationPeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:paymentDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CalculationScheduleDeliveryPeriods ;
            owl:onProperty common_domain_model:deliveryPeriod ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DateRange ;
            owl:onProperty common_domain_model:fixingPeriod ] ;
    skos:definition "A class that defines the period of a schedule. The period contains a set of start and end dates, quantities, fixing, and pricing data." ;
    skos:inScheme common_domain_model:cdm_product_template .

