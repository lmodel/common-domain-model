<http://www.fpml.org/coding-scheme/delivery-method-1-0#DeliveryVersusPayment> a owl:Class ;
    rdfs:label "DeliveryVersusPayment" ;
    rdfs:subClassOf common_domain_model:DeliveryMethodEnum ;
    skos:definition "Indicates that a securities delivery must be made against payment in simultaneous transmissions and stipulate each other." .

<http://www.fpml.org/coding-scheme/delivery-method-1-0#FreeOfPayment> a owl:Class ;
    rdfs:label "FreeOfPayment" ;
    rdfs:subClassOf common_domain_model:DeliveryMethodEnum ;
    skos:definition "Indicates that a securities delivery can be made without a simultaneous cash payment in exchange and not depending on if payment obligations are fulfilled or not and vice versa." .

<http://www.fpml.org/coding-scheme/delivery-method-1-0#PreDelivery> a owl:Class ;
    rdfs:label "PreDelivery" ;
    rdfs:subClassOf common_domain_model:DeliveryMethodEnum ;
    skos:definition "Indicates that a securities delivery must be made in full before the payment for the securities; fulfillment of payment obligations depends on securities delivery obligations fulfillment." .

<http://www.fpml.org/coding-scheme/delivery-method-1-0#PrePayment> a owl:Class ;
    rdfs:label "PrePayment" ;
    rdfs:subClassOf common_domain_model:DeliveryMethodEnum ;
    skos:definition "Indicates that a payment in full amount must be made before the securities delivery; fulfillment of securities delivery obligations depends on payment obligations fulfillment." .

