    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CollateralManagementAgreementElection.collateralManagementAgreement ;
    skos:definition "The designated Collateral Management Agreement with respect to the elective party as the Obligee." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:collateralPortfolio a owl:ObjectProperty ;
    rdfs:label "collateralPortfolio" ;
    rdfs:range common_domain_model:CollateralPortfolio ;
    skos:definition "Represents attributes to define the details of collateral assets within a collateral portfolio to be used in margin call messaging and contribute to collateral balances e.g securities in a collateral account recorded by the principal as held or posted." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:componentSecurityIndexAnnexFallback a owl:DatatypeProperty ;
    rdfs:label "componentSecurityIndexAnnexFallback" ;
    rdfs:range xsd:boolean ;
    skos:definition "For an index option transaction, a flag to indicate whether a relevant Component Security Index Annex is applicable to the transaction." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:composite a owl:ObjectProperty ;
    rdfs:label "composite" ;
    rdfs:range common_domain_model:PriceComposite ;
    skos:definition "(Optionally) Specifies the underlying price components if the price can be expressed as a composite: e.g. dirty price = clean price + accrued." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:condition a owl:ObjectProperty ;
    rdfs:label "condition" ;
    rdfs:range common_domain_model:QuantifierEnum ;
    skos:definition "An enumerated element, to qualify whether All or Any credit notation applies." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:conditionsPrecedent a owl:ObjectProperty ;
    rdfs:label "conditionsPrecedent" ;
    rdfs:range common_domain_model:ConditionsPrecedent ;
    skos:definition "The set of elections that may overwrite the default Condition Precedent provision, and the set of provisions that are deemed Access Condition." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:contractDetails a owl:ObjectProperty ;
    rdfs:label "contractDetails" ;
    rdfs:range common_domain_model:ContractDetails ;
    skos:definition "Represents information specific to trades involving contractual products." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:contractualDefinitionIdentifier a owl:ObjectProperty ;
    rdfs:label "contractualDefinitionIdentifier" ;
    rdfs:range common_domain_model:ContractualDefinitionIdentifier ;
    skos:definition "Contractual Definition Identifier in which the code is published. Includes Document Type and Document Version" ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:conversionFactor a owl:DatatypeProperty ;
    rdfs:label "conversionFactor" ;
    rdfs:range xsd:decimal ;
    skos:definition "Defines the conversion applied if the quantity unit on contract is different from unit on referenced underlier." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:corporateActionIntent a owl:ObjectProperty ;
    rdfs:label "corporateActionIntent" ;
    rdfs:range common_domain_model:CorporateActionTypeEnum ;
    skos:definition "The intent of a corporate action on the position." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Address.country ;
    skos:definition "The ISO 3166 standard code for the country within which the postal address is located." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_scheme true .

common_domain_model:creditEvents a owl:ObjectProperty ;
    rdfs:label "creditEvents" ;
    rdfs:range common_domain_model:CreditEvents ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:ctryOfBrnch a owl:DatatypeProperty ;
    rdfs:label "ctryOfBrnch" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#CtryOfBrnch> .

common_domain_model:custodian a owl:ObjectProperty ;
    rdfs:label "custodian" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "The custody agent. While CreateiQ only specifies the custodian's name, specifying the legal entity as part of the CDM is deemed more appropriate, while this will still provide the ability to accommodate situations where only the entity name is available, as the entityId attribute is optional as part of the LegalEntity class." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:deliveryInLieuRight a owl:DatatypeProperty ;
    rdfs:label "deliveryInLieuRight" ;
    rdfs:range xsd:boolean ;
    skos:definition "Delivery In Lieu rights." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:deliveryTerm a owl:DatatypeProperty ;
    rdfs:label "deliveryTerm" ;
    rdfs:range xsd:string ;
    skos:definition "Also called contract month or delivery month. However, it's not always a month. It is usually expressed using a code, e.g. Z23 would be the Dec 2023 contract, (Z = December). For crude oil, the corresponding contract might be called CLZ23. Optional as this can be uniquely identified in the identifier." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:demandsAndNotices a owl:ObjectProperty ;
    rdfs:label "demandsAndNotices" ;
    rdfs:range common_domain_model:DemandsAndNotices ;
    skos:definition "The optional specification of address where the demands, specifications and notices will be communicated to for each of the parties to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:designatedMaturity a owl:DatatypeProperty ;
    rdfs:label "designatedMaturity" ;
    rdfs:range xsd:string ;
    skos:definition "Allows a designed maturity to be specified for the fixing time." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:direction a owl:ObjectProperty ;
    rdfs:label "direction" ;
    rdfs:range common_domain_model:QuantityChangeDirectionEnum ;
    skos:definition "Direction of the quantity change specified as either an increase, decrease or replacement." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:disputeResolution a owl:ObjectProperty ;
    rdfs:label "disputeResolution" ;
    rdfs:range common_domain_model:DisputeResolution ;
    skos:definition "The election terms under which a party disputes (i) the Calculation Agents calculation of a Delivery Amount or a Return Amount, or (ii) the Value of any Transfer of Eligible Credit Support or Posted Credit Support." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:disputingParty a owl:ObjectProperty ;
    rdfs:label "disputingParty" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "Where the party who is not granted with the substitution role at least has a right to dispute the determination given by the counterparty with such role. As an example, a given PartyA is the unique Counterparty with the Role of WhoMaySubstitute, yet PartyB could be Disputing Party in regard of such Role." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:dividendEntitlement a owl:ObjectProperty ;
    rdfs:label "dividendEntitlement" ;
    rdfs:range common_domain_model:DividendEntitlementEnum ;
    skos:definition "Defines the date on which the receiver of the equity return is entitled to the dividend." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendObservation a owl:ObjectProperty ;
    rdfs:label "dividendObservation" ;
    rdfs:range common_domain_model:PriceSchedule ;
    skos:definition "To record observations of dividends." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:dividendTerms a owl:ObjectProperty ;
    rdfs:label "dividendTerms" ;
    rdfs:range common_domain_model:DividendTerms ;
    skos:definition "Specifies the dividend requirements if applicable." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:economicTerms a owl:ObjectProperty ;
    rdfs:label "economicTerms" ;
    rdfs:range common_domain_model:EconomicTerms ;
    skos:definition "The price forming features, including payouts and provisions." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:effectiveTime a owl:ObjectProperty ;
    rdfs:label "effectiveTime" ;
    rdfs:range common_domain_model:TimeZone ;
    skos:definition "The time and zone of the date in which the event contractually takes effect." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:eligibleCollateral a owl:ObjectProperty ;
    rdfs:label "eligibleCollateral" ;
    rdfs:range common_domain_model:EligibleCollateralCriteria ;
    skos:definition "The eligible collateral as specified in relation to the pledgor/chargor/obligor(s) posting obligation." ;
    skos:editorialNote "ISDA CSA_IM_2016 name \"Eligible Credit Support (IM) Schedule\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:eligibleCreditSupport a owl:ObjectProperty ;
    rdfs:label "eligibleCreditSupport" ;
    rdfs:range common_domain_model:EligibleCreditSupport ;
    skos:definition "Specification of the Eligible Collateral or Credit Support applicable to the Agreement." ;
    skos:editorialNote "ISDA CSA_English_1995",
        "ISDA CSA_NewYork_1994",
        "ISDA CSA_VM_English_2016",
        "ISDA CSA_VM_NewYork_2016",
        "ISDA CSD_English_1995" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:eventCurrency a owl:ObjectProperty ;
    rdfs:label "eventCurrency" ;
    rdfs:range common_domain_model:EventCurrency ;
    skos:definition "Additional Provisions for a Confirmation of an FX or Currency Option Transaction." ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:eventDate a owl:DatatypeProperty ;
    rdfs:label "eventDate" ;
    rdfs:range xsd:date ;
    skos:definition "Specifies the date on which the event is taking place. This date is equal to the trade date in the case of a simple execution.  However it can be different from the trade date, for example in the case of a partial termination." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:exchangeDate a owl:DatatypeProperty ;
    rdfs:label "exchangeDate" ;
    rdfs:range xsd:string ;
    skos:definition "The bespoke exchange date terms that might be specified by the parties to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:exchangeTradedContractNearest a owl:ObjectProperty ;
    rdfs:label "exchangeTradedContractNearest" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Asset common_domain_model:Basket common_domain_model:Index ) ] common_domain_model:Observable ) ] ;
    skos:definition "Specification of the exchange traded contract nearest." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:exposureMultiplier a owl:DatatypeProperty ;
    rdfs:label "exposureMultiplier" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies the multiplier applied to exposure based on the credit rating of the rated party." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:failureToDeliver a owl:DatatypeProperty ;
    rdfs:label "failureToDeliver" ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, failure to deliver is applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:failureToPay a owl:DatatypeProperty ;
    rdfs:label "failureToPay" ;
    rdfs:range xsd:boolean ;
    skos:definition "The failure to pay election." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:failureToPayPrincipal a owl:DatatypeProperty ;
    rdfs:label "failureToPayPrincipal" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. Corresponds to the failure by the Reference Entity to pay an expected principal amount or the payment of an actual principal amount that is less than the expected principal amount. ISDA 2003 Term: Failure to Pay Principal." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:fallbackLanguageBespokeTerms a owl:ObjectProperty ;
    rdfs:label "fallbackLanguageBespokeTerms" ;
    rdfs:range common_domain_model:Clause ;
    skos:definition "Where parties may optionnaly describe any extra bespoke agreements about fallback procedure attached to a particular determination role. This fallback bespoke paragraph would typically address topics such as : delay for the Disputing Party to notify a disagreement when receiving a determination from the Calculation Agent ; Independent Third Party Dealers election terms e.g. number of Dealers to be jointly elected by the counterparties ; delay for joint election of Dealers by the counterparties ; further fallback election procedure in case of disagreement between parties to jointly elect all the Dealers e.g. typically each party designates 1 Dealer, each a Party Representant, which thus result in 2 Dealers in charge of joint election of 3 other Dealers who will be the final ones to provide the response, each a Final Dealer ; delay for joint election of the Final Dealers by the Party Representants ; fees repartition e.g. typically cost and fees incurred by the election of Dealers are equally shared by the parties ; etc." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:feePaymentDate a owl:ObjectProperty ;
    rdfs:label "feePaymentDate" ;
    rdfs:range common_domain_model:RelativeDateOffset ;
    skos:definition "The date on which exercise fee(s) will be paid. It is specified as a relative date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:finalReturns a owl:ObjectProperty ;
    rdfs:label "finalReturns" ;
    rdfs:range common_domain_model:FinalReturns ;
    skos:definition "A clause providing that final return collateral is to be provided without consideration of any Minimum Transfer Amount and collateral haircut." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:finalStub a owl:ObjectProperty ;
    rdfs:label "finalStub" ;
    rdfs:range common_domain_model:StubValue ;
    skos:definition "Specifies how the final stub amount is calculated. A single floating rate tenor different to that used for the regular part of the calculation periods schedule may be specified, or two floating tenors may be specified. If two floating rate tenors are specified then Linear Interpolation (in accordance with the 2000 ISDA Definitions, Section 8.3. Interpolation) is assumed to apply. Alternatively, an actual known stub rate or stub amount may be specified." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:finalValuationPrice a owl:ObjectProperty ;
    rdfs:label "finalValuationPrice" ;
    rdfs:range common_domain_model:PriceSchedule ;
    skos:closeMatch fpml_5_10:BasketConstituent.finalValuationPrice ;
    skos:definition "Specifies a final price schedule to be associated to an individual underlier that is a basket constituent. The multiple cardinality is aligned to the one of the PriceQuantity->price that this price is referencing." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:floatingRateMultiplierSchedule a owl:ObjectProperty ;
    rdfs:label "floatingRateMultiplierSchedule" ;
    rdfs:range common_domain_model:RateSchedule ;
    skos:definition "A rate multiplier or multiplier schedule to apply to the floating rate. A multiplier schedule is expressed as explicit multipliers and dates. In the case of a schedule, the step dates may be subject to adjustment in accordance with any adjustments specified in the calculationPeriodDatesAdjustments. The multiplier can be a positive or negative decimal. This element should only be included if the multiplier is not equal to 1 (one) for the term of the stream." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:forecastRate a owl:DatatypeProperty ;
    rdfs:label "forecastRate" ;
    rdfs:range xsd:decimal ;
    skos:definition "The value representing the forecast rate used to calculate the forecast future value of the accrual period.A value of 1% should be represented as 0.01." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:fullDischarge a owl:DatatypeProperty ;
    rdfs:label "fullDischarge" ;
    rdfs:range xsd:boolean ;
    skos:definition "Full Discharge condition." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:fullFaithAndCreditObLiability a owl:DatatypeProperty ;
    rdfs:label "fullFaithAndCreditObLiability" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Defined in the ISDA published additional provisions for U.S. Municipal as Reference Entity. ISDA 2003 Term: Full Faith and Credit Obligation Liability." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:fxFixingDate a owl:ObjectProperty ;
    rdfs:label "fxFixingDate" ;
    rdfs:range common_domain_model:FxFixingDate ;
    skos:definition "The date on which the currency rate will be determined for the purpose of specifying the amount in deliverable currency. This attribute was formerly part of 'NonDeliverableSettlement', which is now being harmonised into a common 'CashSettlementTerms' that includes a 'ValuationDate'." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:generalFundObligationLiability a owl:DatatypeProperty ;
    rdfs:label "generalFundObligationLiability" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Defined in the ISDA published additional provisions for U.S. Municipal as Reference Entity. ISDA 2003 Term: General Fund Obligation Liability." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:generalSimmElections a owl:ObjectProperty ;
    rdfs:label "generalSimmElections" ;
    rdfs:range common_domain_model:GeneralSimmElections ;
    skos:definition "The specification of the ISDA SIMM Method for all Covered Transactions with respect to all Regimes." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:governingLaw a owl:ObjectProperty ;
    rdfs:label "governingLaw" ;
    rdfs:range common_domain_model:GoverningLawEnum ;
    skos:definition "Represents the law governing the trade and associated contractual product terms." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:id a owl:ObjectProperty ;
    rdfs:label "id" ;
    rdfs:range common_domain_model:Id ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Id> .

common_domain_model:identifiedCrossCurrencySwap a owl:DatatypeProperty ;
    rdfs:label "identifiedCrossCurrencySwap" ;
    rdfs:range xsd:boolean ;
    skos:definition "The qualification of whether cross-currency swaps need to be identified in the Confirmation so that the obligations to exchange principal be disregarded for the purpose of determining the Delivery Amount or Return Amount." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:impliedWritedown a owl:DatatypeProperty ;
    rdfs:label "impliedWritedown" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. Results from the fact that losses occur to the underlying instruments that do not result in reductions of the outstanding principal of the reference obligation." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:independentAmount a owl:ObjectProperty ;
    rdfs:label "independentAmount" ;
    rdfs:range common_domain_model:LegacyIndependentAmount ;
    skos:definition "Specifies the additional amount of collateral that is required to be delivered by a party irrespective of the mark-to-market exposure under the related Transactions. It may take the form of a fixed amount or may be determined using ratings." ;
    skos:editorialNote "ISDA CSA_English_1995",
        "ISDA CSA_IM_NewYork_2016",
        "ISDA CSA_NewYork_1994",
        "ISDA CSA_VM_English_2016",
        "ISDA CSA_VM_NewYork_2016",
        "ISDA CSD_English_1995",
        "ISDA CSD_IM_English_2016" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:indx a owl:ObjectProperty ;
    rdfs:label "indx" ;
    rdfs:range common_domain_model:Indx ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Indx> .

common_domain_model:initialFixingDate a owl:ObjectProperty ;
    rdfs:label "initialFixingDate" ;
    rdfs:range common_domain_model:InitialFixingDate ;
    skos:definition "The initial fixing date." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:initialRate a owl:ObjectProperty ;
    rdfs:label "initialRate" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "The initial floating rate reset agreed between the principal parties involved in the trade. This is assumed to be the first required reset rate for the first regular calculation period. It should only be included when the rate is not equal to the rate published on the source implied by the floating rate index. An initial rate of 5% would be represented as 0.05." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:initialStub a owl:ObjectProperty ;
    rdfs:label "initialStub" ;
    rdfs:range common_domain_model:StubValue ;
    skos:definition "Specifies how the initial stub amount is calculated. A single floating rate tenor different to that used for the regular part of the calculation periods schedule may be specified, or two floating tenors may be specified. If two floating rate tenors are specified then Linear Interpolation (in accordance with the 2000 ISDA Definitions, Section 8.3. Interpolation) is assumed to apply. Alternatively, an actual known stub rate or stub amount may be specified." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:initialValuationPrice a owl:ObjectProperty ;
    rdfs:label "initialValuationPrice" ;
    rdfs:range common_domain_model:PriceSchedule ;
    skos:closeMatch fpml_5_10:BasketConstituent.initialValuationPrice ;
    skos:definition "Specifies an initial price schedule to be associated to an individual underlier that is a basket constituent. The multiple cardinality is aligned to the one of the PriceQuantity->price that this price is referencing." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:intent a owl:ObjectProperty ;
    rdfs:label "intent" ;
    rdfs:range common_domain_model:PositionEventIntentEnum ;
    skos:definition "The intent attribute is meant to be specified when the event qualification cannot be programmatically inferred from the event features. As a result it is only associated with those primitives that can give way to such ambiguity, the quantityChange being one of those." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:interimValuationPrice a owl:ObjectProperty ;
    rdfs:label "interimValuationPrice" ;
    rdfs:range common_domain_model:PriceSchedule ;
    skos:closeMatch fpml_5_10:BasketConstituent.interimValuationPrice ;
    skos:definition "Specifies an interim price schedule to be associated to an individual underlier that is a basket constituent. The multiple cardinality is aligned to the one of the PriceQuantity->price that this price is referencing." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:interpolationMethod a owl:ObjectProperty ;
    rdfs:label "interpolationMethod" ;
    rdfs:range common_domain_model:InterpolationMethodEnum ;
    skos:definition "The type of interpolation method that the calculation agent reserves the right to use." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:interpretationTerms a owl:DatatypeProperty ;
    rdfs:label "interpretationTerms" ;
    rdfs:range xsd:string ;
    skos:definition "The bespoke provision that might be specified by the parties to the agreement applicable to Interpretations." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:issuerName a owl:ObjectProperty ;
    rdfs:label "issuerName" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "Specifies the issuing entity name or LEI." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:lineage a owl:ObjectProperty ;
    rdfs:label "lineage" ;
    rdfs:range common_domain_model:Lineage ;
    skos:definition "Pointer to the previous PortfolioState and new Event(s) leading to the current (new) state. Previous PortfolioState in the Lineage can be Null in case this is the start of the chain of Events." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:listed a owl:DatatypeProperty ;
    rdfs:label "listed" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Indicates whether or not the obligation is quoted, listed or ordinarily purchased and sold on an exchange. ISDA 2003 Term: Listed." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:masterAgreementDatedAsOfDate a owl:ObjectProperty ;
    rdfs:label "masterAgreementDatedAsOfDate" ;
    rdfs:range common_domain_model:MasterAgreementDatedAsOfDate ;
    skos:definition "Defines the dates agreed by the parties as the date of the Credit Support Annex or Credit Support Deed." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:messageInformation a owl:ObjectProperty ;
    rdfs:label "messageInformation" ;
    rdfs:range common_domain_model:MessageInformation ;
    skos:closeMatch fpml_5_10:AvailableInventory.messageInformation ;
    skos:definition "Allows details related to the availability messaging use case to be defined" ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:method a owl:ObjectProperty ;
    rdfs:label "method" ;
    rdfs:range common_domain_model:ValuationTypeEnum ;
    skos:definition "Method used for the valuation of the transaction by the valuation party." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:minimumAmount a owl:ObjectProperty ;
    rdfs:label "minimumAmount" ;
    rdfs:range common_domain_model:Quantity ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:minimumFee a owl:ObjectProperty ;
    rdfs:label "minimumFee" ;
    rdfs:range common_domain_model:Money ;
    skos:closeMatch fpml_5_10:BillingRecord.minimumFee ;
    skos:definition "Indicates the minimum fee amount applied to the billing record, if any." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:minimumTransferAmountAmendment a owl:ObjectProperty ;
    rdfs:label "minimumTransferAmountAmendment" ;
    rdfs:range common_domain_model:MinimumTransferAmountAmendment ;
    skos:definition "The bespoke provision that might be specified by the parties to the agreement applicable to Minimum Transfer Amount.  Unless specified the definition of Minimum Transfer Amount in any Other Regulatory CSA has the meaning specified in such Other Regulatory CSA." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:multipleExchangeIndexAnnexFallback a owl:DatatypeProperty ;
    rdfs:label "multipleExchangeIndexAnnexFallback" ;
    rdfs:range xsd:boolean ;
    skos:definition "For an index option transaction, a flag to indicate whether a relevant Multiple Exchange Index Annex is applicable to the transaction. This annex defines additional provisions which are applicable where an index is comprised of component securities that are traded on multiple exchanges." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:multiplier a owl:ObjectProperty ;
    rdfs:label "multiplier" ;
    rdfs:range common_domain_model:Measure ;
    skos:definition "Defines an optional number that the quantity should be multiplied by to derive a total quantity. This number is associated to a unit. For example in the case of the Coal (API2) CIF ARA (ARGUS-McCloskey) Futures Contract on the CME, where the unit would be contracts, the multiplier value would 1,000 and the mulitiplier unit would be 1,000 MT (Metric Tons)." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:nm a owl:DatatypeProperty ;
    rdfs:label "nm" ;
    rdfs:range xsd:string ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Nm> .

common_domain_model:noRating a owl:DatatypeProperty ;
    rdfs:label "noRating" ;
    rdfs:range xsd:boolean ;
    skos:definition "What conditions apply where a party has no rating." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:noReferenceObligation a owl:DatatypeProperty ;
    rdfs:label "noReferenceObligation" ;
    rdfs:range xsd:boolean ;
    skos:definition "Used to indicate that there is no Reference Obligation associated with this Credit Default Swap and that there will never be one." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:notContingent a owl:DatatypeProperty ;
    rdfs:label "notContingent" ;
    rdfs:range xsd:boolean ;
    skos:definition "OTE: Only allowed as an obligation characteristic under ISDA Credit 1999. In essence Not Contingent means the repayment of principal cannot be dependent on a formula/index, i.e. to prevent the risk of being delivered an instrument that may never pay any element of principal, and to ensure that the obligation is interest bearing (on a regular schedule). ISDA 2003 Term: Not Contingent." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:notDomesticCurrency a owl:ObjectProperty ;
    rdfs:label "notDomesticCurrency" ;
    rdfs:range common_domain_model:NotDomesticCurrency ;
    skos:definition "An obligation and deliverable obligation characteristic. Any obligation that is payable in any currency other than the domestic currency. Domestic currency is either the currency so specified or, if no currency is specified, the currency of (a) the reference entity, if the reference entity is a sovereign, or (b) the jurisdiction in which the relevant reference entity is organised, if the reference entity is not a sovereign. ISDA 2003 Term: Not Domestic Currency." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:notDomesticIssuance a owl:DatatypeProperty ;
    rdfs:label "notDomesticIssuance" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Any obligation other than an obligation that was intended to be offered for sale primarily in the domestic market of the relevant Reference Entity. This specifies that the obligation must be an internationally recognised bond. ISDA 2003 Term: Not Domestic Issuance." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:notDomesticLaw a owl:DatatypeProperty ;
    rdfs:label "notDomesticLaw" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. If the reference entity is a Sovereign, this means any obligation that is not subject to the laws of the reference entity. If the reference entity is not a sovereign, this means any obligation that is not subject to the laws of the jurisdiction of the reference entity. ISDA 2003 Term: Not Domestic Law." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:notRatedBy a owl:ObjectProperty ;
    rdfs:label "notRatedBy" ;
    rdfs:range common_domain_model:NotRatedByEnum ;
    skos:definition "Defines where conditions apply if no Rating where ratings may not exist." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:notSovereignLender a owl:DatatypeProperty ;
    rdfs:label "notSovereignLender" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Any obligation that is not primarily (majority) owed to a Sovereign or Supranational Organisation. ISDA 2003 Term: Not Sovereign Lender." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:notSubordinated a owl:DatatypeProperty ;
    rdfs:label "notSubordinated" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. An obligation that ranks at least equal with the most senior Reference Obligation in priority of payment or, if no Reference Obligation is specified in the related Confirmation, the obligations of the Reference Entity that are senior. ISDA 2003 Term: Not Subordinated." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:notionalAmount a owl:DatatypeProperty ;
    rdfs:label "notionalAmount" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculationPeriod.notionalAmount ;
    skos:definition "The amount that a cashflow will accrue interest on." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:number a owl:DatatypeProperty ;
    rdfs:label "number" ;
    rdfs:range xsd:decimal ;
    skos:definition "The number to be used as the bound, e.g. 5." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:numberOfRatingAgencies a owl:ObjectProperty ;
    rdfs:label "numberOfRatingAgencies" ;
    rdfs:range common_domain_model:NumberOfRatingAgenciesEnum ;
    skos:definition "Defines the number of Rating Agencies that the Party must be rated by." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:obligations a owl:ObjectProperty ;
    rdfs:label "obligations" ;
    rdfs:range common_domain_model:SecurityInterestObligationsEnum ;
    skos:definition "A description of any additional obligations secured by the credit support arrangements." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:observable a owl:ObjectProperty ;
    rdfs:label "observable" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Asset common_domain_model:Basket common_domain_model:Index ) ] common_domain_model:Observable ) ] ;
    skos:definition "Specifies the object to be observed for a price, it could be an asset or an index. The cardinality is optional as some quantity / price cases have no observable (e.g. a fixed rate in a given currency)." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:observationDates a owl:DatatypeProperty ;
    rdfs:label "observationDates" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:CalculatedRateObservations.observationDates ;
    skos:definition "The observation date upon which the rate is observed." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:offset a owl:ObjectProperty ;
    rdfs:label "offset" ;
    rdfs:range common_domain_model:Offset ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:oneWayProvisions a owl:ObjectProperty ;
    rdfs:label "oneWayProvisions" ;
    rdfs:range common_domain_model:OneWayProvisions ;
    skos:definition "The determination of whether the One Way Provisions are applicable (true) or not applicable (false)." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:othReferenceEntityObligations a owl:DatatypeProperty ;
    rdfs:label "othReferenceEntityObligations" ;
    rdfs:range xsd:string ;
    skos:definition "This element is used to specify any other obligations of a reference entity in both obligations and deliverable obligations. The obligations can be specified free-form. ISDA 2003 Term: Other Obligations of a Reference Entity." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:otherEligibleSupportIM a owl:DatatypeProperty ;
    rdfs:label "otherEligibleSupportIM" ;
    rdfs:range xsd:string ;
    skos:definition "The Other Eligible Support election. If not specified, this election is deemed as not applicable." ;
    skos:editorialNote "ISDA CSA_IM_NewYork_2016",
        "ISDA CSA_IM_NewYork_2018" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:otherParty a owl:ObjectProperty ;
    rdfs:label "otherParty" ;
    rdfs:range common_domain_model:PartyRole ;
    skos:definition "The role(s) that other party(ies) may have in relation to the legal agreement, further to the contractual parties." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:othr a owl:ObjectProperty ;
    rdfs:label "othr" ;
    rdfs:range common_domain_model:Othr ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Othr> .

common_domain_model:packageInformation a owl:ObjectProperty ;
    rdfs:label "packageInformation" ;
    rdfs:range common_domain_model:IdentifiedList ;
    skos:definition "Specifies the package information in case the business event represents several trades executed as a package (hence this attribute is optional). The package information is only instantiated once at the business event level to preserve referential integrity, whereas individual trades make reference to it to identify that they are part of a package." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:parametricDates a owl:ObjectProperty ;
    rdfs:label "parametricDates" ;
    rdfs:range common_domain_model:ParametricDates ;
    skos:definition "Specifies parametric terms to determine which days within a given calculation period the price would be observed. Typically associated with Commodities. " ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:paymentDelay a owl:DatatypeProperty ;
    rdfs:label "paymentDelay" ;
    rdfs:range xsd:boolean ;
    skos:definition "Applicable to CDS on MBS to specify whether payment delays are applicable to the fixed Amount. RMBS typically have a payment delay of 5 days between the coupon date of the reference obligation and the payment date of the synthetic swap. CMBS do not, on the other hand, with both payment dates being on the 25th of each month." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:payout a owl:ObjectProperty ;
    rdfs:label "payout" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AssetPayout common_domain_model:CommodityPayout common_domain_model:CreditDefaultPayout common_domain_model:FixedPricePayout common_domain_model:InterestRatePayout common_domain_model:OptionPayout common_domain_model:PerformancePayout common_domain_model:SettlementPayout ) ] common_domain_model:Payout ) ] ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:postingObligations a owl:ObjectProperty ;
    rdfs:label "postingObligations" ;
    rdfs:range common_domain_model:PostingObligations ;
    skos:definition "The security providers posting obligations." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:presentValueAmount a owl:ObjectProperty ;
    rdfs:label "presentValueAmount" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "A monetary amount representing the present value of the forecast payment." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:pric a owl:ObjectProperty ;
    rdfs:label "pric" ;
    rdfs:range common_domain_model:Pric ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Pric> .

common_domain_model:priceSourceDisruption a owl:ObjectProperty ;
    rdfs:label "priceSourceDisruption" ;
    rdfs:range common_domain_model:FxPriceSourceDisruption ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.1.(d).(xi)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:priceTimeIntervalQuantity a owl:ObjectProperty ;
    rdfs:label "priceTimeIntervalQuantity" ;
    rdfs:range common_domain_model:Price ;
    skos:closeMatch fpml_5_10:CalculationScheduleDeliveryPeriods.priceTimeIntervalQuantity ;
    skos:definition "Price per quantity per delivery time interval." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:productClass a owl:ObjectProperty ;
    rdfs:label "productClass" ;
    rdfs:range common_domain_model:StandardizedScheduleProductClassEnum ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:productQualifier a owl:DatatypeProperty ;
    rdfs:label "productQualifier" ;
    rdfs:range xsd:string ;
    skos:definition "Derived from the product payout features using a CDM product qualification function that determines the product type based on the product payout features." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:prsn a owl:ObjectProperty ;
    rdfs:label "prsn" ;
    rdfs:range common_domain_model:Prsn ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Prsn> .

common_domain_model:rateRecordDate a owl:DatatypeProperty ;
    rdfs:label "rateRecordDate" ;
    rdfs:range xsd:date ;
    skos:definition "Specifies the 'Rate Record Day' for a Fallback rate.  Fallback rate fixing processes typically set the fixing rate in arrears, i.e., the Fallback Rate corresponding to a Rate Record Date is set at the end of the interest accural period.  When this applies, Reset->resetDate occurs at the end of the interest period, and the Reset->rateRecordDate occurs near the start of the interest period.  The Reset->rateRecordDate and Reset->observations->observationIdentifier->observationDate will differ if a Fallback rate is unavailable on the Rate Record Date, and the latest previous available rate is used as the observation." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:rateTreatment a owl:ObjectProperty ;
    rdfs:label "rateTreatment" ;
    rdfs:range common_domain_model:RateTreatmentEnum ;
    skos:definition "The specification of any rate conversion which needs to be applied to the observed rate before being used in any calculations. The two common conversions are for securities quoted on a bank discount basis which will need to be converted to either a Money Market Yield or Bond Equivalent Yield. See the Annex to the 2000 ISDA Definitions, Section 7.3. Certain General Definitions Relating to Floating Rate Options, paragraphs (g) and (h) for definitions of these terms." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:receivingParty a owl:ObjectProperty ;
    rdfs:label "receivingParty" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "The party receiving the invoice" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:recordEndDate a owl:DatatypeProperty ;
    rdfs:label "recordEndDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:BillingRecordInstruction.recordEndDate ;
    skos:definition "The ending date of the period described by this record" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:recordStartDate a owl:DatatypeProperty ;
    rdfs:label "recordStartDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:BillingRecordInstruction.recordStartDate ;
    skos:definition "The starting date of the period described by this record" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:referenceEntity a owl:ObjectProperty ;
    rdfs:label "referenceEntity" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "The corporate or sovereign entity which is subject to the swap transaction and any successor that assumes all or substantially all of its contractual and other obligations. Reference Entities cannot be senior or subordinated. It is the obligations of the Reference Entities that can be senior or subordinated. ISDA 2014 Credit definitions article II section 2.1: `Reference Entity` means the entity specified as such in the related Confirmation." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:referenceInformation a owl:ObjectProperty ;
    rdfs:label "referenceInformation" ;
    rdfs:range common_domain_model:ReferenceInformation ;
    skos:definition "The reference entity, part of a credit basket, impacted by the credit event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:relativeDates a owl:ObjectProperty ;
    rdfs:label "relativeDates" ;
    rdfs:range common_domain_model:RelativeDates ;
    skos:closeMatch fpml_5_10:AdjustableOrRelativeDates.relativeDates ;
    skos:definition "A series of dates specified as some offset to another series of dates (the anchor dates)." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:reset a owl:ObjectProperty ;
    rdfs:label "reset" ;
    rdfs:range common_domain_model:ResetInstruction ;
    skos:definition "Specifies instructions describing a reset event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:revenueObligationLiability a owl:DatatypeProperty ;
    rdfs:label "revenueObligationLiability" ;
    rdfs:range xsd:boolean ;
    skos:definition "An obligation and deliverable obligation characteristic. Defined in the ISDA published additional provisions for U.S. Municipal as Reference Entity. ISDA 2003 Term: Revenue Obligation Liability." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:rightsEvent a owl:DatatypeProperty ;
    rdfs:label "rightsEvent" ;
    rdfs:range xsd:boolean ;
    skos:definition "A boolean attribute to specify whether a Secured Party Rights Event will only occur upon the occurrence of one or more of the event specified in a Control Agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:rightsEvents a owl:ObjectProperty ;
    rdfs:label "rightsEvents" ;
    rdfs:range common_domain_model:RightsEvents ;
    skos:definition "The bespoke provisions that might be specified by the parties to the agreement to specify the rights of Security Taker and/or Security Provider when an Early Termination or Access Condition event has occurred." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:roundingDirection a owl:ObjectProperty ;
    rdfs:label "roundingDirection" ;
    rdfs:range common_domain_model:RoundingDirectionEnum ;
    skos:definition "The direction in which rounding is performed (e.g., up, down, or to the nearest value)." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:securedType a owl:ObjectProperty ;
    rdfs:label "securedType" ;
    rdfs:range common_domain_model:SecuredTypeEnum ;
    skos:definition "Specifies the type of secured debt product." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:securitiesSettlementDay a owl:DatatypeProperty ;
    rdfs:label "securitiesSettlementDay" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CalculationAndTimingInitialMargin.securitiesSettlementDay ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"12\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:security a owl:ObjectProperty ;
    rdfs:label "security" ;
    rdfs:range common_domain_model:Security ;
    skos:definition "The security details." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:securityInterestForObligations a owl:ObjectProperty ;
    rdfs:label "securityInterestForObligations" ;
    rdfs:range common_domain_model:SecurityInterestForObligations ;
    skos:definition "The party to whom obligations under the Master Agreement are owed and secured by the credit support arrangements. Applicable to 1994 NY CSA, 1995 English Law CSD and 2016 New York Law VM CSA." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sendingParty a owl:ObjectProperty ;
    rdfs:label "sendingParty" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "The party issuing the invoice" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:seniority a owl:ObjectProperty ;
    rdfs:label "seniority" ;
    rdfs:range common_domain_model:DebtSeniorityEnum ;
    skos:definition "Specifies the order of repayment in the event of a sale or bankruptcy of the issuer or a related party (eg guarantor)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:sensitivityMethodologies a owl:ObjectProperty ;
    rdfs:label "sensitivityMethodologies" ;
    rdfs:range common_domain_model:SensitivityMethodologies ;
    skos:definition "The specification of methodologies to compute sensitivities specific to the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:settlementTerms a owl:ObjectProperty ;
    rdfs:label "settlementTerms" ;
    rdfs:range common_domain_model:SettlementTerms ;
    skos:definition "Per Part 1 Section 8, 'Settlement', of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:sngl a owl:ObjectProperty ;
    rdfs:label "sngl" ;
    rdfs:range common_domain_model:Sngl ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Sngl> .

common_domain_model:specifiedCurrency a owl:ObjectProperty ;
    rdfs:label "specifiedCurrency" ;
    rdfs:range common_domain_model:SpecifiedCurrency ;
    skos:definition "An obligation and deliverable obligation characteristic. The currency or currencies in which an obligation or deliverable obligation must be payable. ISDA 2003 Term: Specified Currency." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_credit .

common_domain_model:specifiedEntityTerms a owl:ObjectProperty ;
    rdfs:label "specifiedEntityTerms" ;
    rdfs:range common_domain_model:SpecifiedEntityTermsEnum ;
    skos:definition "The specified entity terms for the Event of Default or Termination Event specified." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:specifiedValue a owl:ObjectProperty ;
    rdfs:label "specifiedValue" ;
    rdfs:range common_domain_model:SpecifiedValueEnum ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.4.(w)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:standardElection a owl:ObjectProperty ;
    rdfs:label "standardElection" ;
    rdfs:range common_domain_model:InterestAdjustmentPeriodicityEnum ;
    skos:definition "The Interest Adjustment periodicity when specified through a standardized election." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:standardisedException a owl:ObjectProperty ;
    rdfs:label "standardisedException" ;
    rdfs:range common_domain_model:ExceptionEnum ;
    skos:definition "The Standard Initial Margin Model exception when specified by the party according to one of the enumerated values." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:summaryAmountType a owl:ObjectProperty ;
    rdfs:label "summaryAmountType" ;
    rdfs:range common_domain_model:RecordAmountTypeEnum ;
    skos:definition "The account level for the billing summary." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:terminationCurrencyAmendment a owl:ObjectProperty ;
    rdfs:label "terminationCurrencyAmendment" ;
    rdfs:range common_domain_model:TerminationCurrencyAmendment ;
    skos:definition "The bespoke provision that might be specified by the parties to the agreement applicable to Termination Currency.  Unless specified the definition of Termination Currency has the meaning specified in the Schedule to the ISDA Master Agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:terminationDate a owl:ObjectProperty ;
    rdfs:label "terminationDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates.terminationDate ;
    skos:definition "The last day of the terms of the trade. This date may be subject to adjustments in accordance with the business day convention. It can also be specified in relation to another scheduled date (e.g. the last payment date)." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:totalVolatilityCap a owl:DatatypeProperty ;
    rdfs:label "totalVolatilityCap" ;
    rdfs:range xsd:decimal ;
    skos:definition "Volatility Cap Amount in accordance with the ISDA 2011 Equity Derivatives Definitions. This means the Volatility Cap Amount election is a number." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:trade a owl:ObjectProperty ;
    rdfs:label "trade" ;
    rdfs:range common_domain_model:Trade ;
    skos:definition "Represents the Trade that has been effected by a business or life-cycle event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:tradeDate a owl:DatatypeProperty ;
    rdfs:label "tradeDate" ;
    rdfs:range xsd:date ;
    skos:definition "Denotes the trade/execution date." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:tradeTime a owl:ObjectProperty ;
    rdfs:label "tradeTime" ;
    rdfs:range common_domain_model:TimeZone ;
    skos:definition "Denotes the trade time and timezone as agreed by the parties to the trade." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:transfer a owl:ObjectProperty ;
    rdfs:label "transfer" ;
    rdfs:range common_domain_model:TransferInstruction ;
    skos:definition "Specifies instructions describing a transfer primitive event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:trigger a owl:ObjectProperty ;
    rdfs:label "trigger" ;
    rdfs:range common_domain_model:Trigger ;
    skos:definition "The trigger level" ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:tx a owl:ObjectProperty ;
    rdfs:label "tx" ;
    rdfs:range common_domain_model:Tx ;
    skos:inScheme common_domain_model:cdm_regulation ;
    skos:relatedMatch <https://www.icmagroup.org/market-practice-and-regulatory-policy/ISO20022#Tx> .

common_domain_model:unadjustedVarianceCap a owl:DatatypeProperty ;
    rdfs:label "unadjustedVarianceCap" ;
    rdfs:range xsd:decimal ;
    skos:definition "For use when varianceCap is applicable. Contains the scaling factor of the Variance Cap that can differ on a trade-by-trade basis in the European market. For example, a Variance Cap of 2.5^2 x Variance Strike Price has an unadjustedVarianceCap of 2.5." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:valuationMethod a owl:ObjectProperty ;
    rdfs:label "valuationMethod" ;
    rdfs:range common_domain_model:ValuationMethodEnum ;
    skos:definition "The ISDA defined methodology for determining the final price of the reference obligation for purposes of cash settlement. (ISDA 2003 Term: Valuation Method). For example, Market, Highest etc." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:valueDate a owl:DatatypeProperty ;
    rdfs:label "valueDate" ;
    rdfs:range xsd:date ;
    skos:definition "Adjusted value date of the future value amount." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:volatilityCapFloor a owl:ObjectProperty ;
    rdfs:label "volatilityCapFloor" ;
    rdfs:range common_domain_model:VolatilityCapFloor ;
    skos:definition "Contains containing volatility-based barriers" ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:volatilityStrikePrice a owl:ObjectProperty ;
    rdfs:label "volatilityStrikePrice" ;
    rdfs:range common_domain_model:Price ;
    skos:definition "Volatility Strike Price in accordance with the ISDA 2011 Equity Derivatives Definitions." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:weatherUnit a owl:ObjectProperty ;
    rdfs:label "weatherUnit" ;
    rdfs:range common_domain_model:WeatherUnitEnum ;
    skos:definition "Provides an enumerated values for a weather unit, generally used in the context of defining quantities for commodities." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:weight a owl:DatatypeProperty ;
    rdfs:label "weight" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies the degree of importance of the observation." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:writedown a owl:DatatypeProperty ;
    rdfs:label "writedown" ;
    rdfs:range xsd:boolean ;
    skos:definition "A credit event. Results from the fact that the underlier writes down its outstanding principal amount." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:yearFraction a owl:DatatypeProperty ;
    rdfs:label "yearFraction" ;
    rdfs:range xsd:decimal ;
    skos:definition "The fraction of a year that this calculation represents, according to the day count fraction method." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:AdditionalTypeEnum a owl:Class ;
    rdfs:label "AdditionalTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#NotApplicable> <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#EquityOptionOrIndexOption> <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#Other> ) ;
    skos:definition "The enumerated values to specify the Additional Type of transaction that can require the collection or delivery of initial margin under a given regulatory regime for the purposes of Covered Transactions." ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(b)(B)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#EquityOptionOrIndexOption>,
        <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#NotApplicable>,
        <https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum#Other> .

common_domain_model:AdjustableOrRelativeDates a owl:Class ;
    rdfs:label "AdjustableOrRelativeDates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:relativeDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:relativeDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableDates ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RelativeDates ;
            owl:onProperty common_domain_model:relativeDates ] ;
    skos:closeMatch fpml_5_10:AdjustableOrRelativeDates ;
    skos:definition "A class giving the choice between defining a series of dates as an explicit list of dates together with applicable adjustments or as relative to some other series of (anchor) dates." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: AdjustableOrRelativeDatesChoice — required choice adjustableDates, relativeDates" ;
    common_domain_model:metadata_key true .

common_domain_model:AgreementName a owl:Class ;
    rdfs:label "AgreementName" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:otherAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalAgreementTypeEnum ;
            owl:onProperty common_domain_model:agreementType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:contractualTermsSupplement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:masterAgreementType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:masterAgreementType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ContractualMatrix ;
            owl:onProperty common_domain_model:contractualMatrix ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:agreementType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:masterConfirmationType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MasterConfirmationAnnexTypeEnum ;
            owl:onProperty common_domain_model:masterConfirmationAnnexType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:creditSupportAgreementMarginType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:masterConfirmationAnnexType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:agreementType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ContractualTermsSupplement ;
            owl:onProperty common_domain_model:contractualTermsSupplement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CreditSupportAgreementTypeEnum ;
            owl:onProperty common_domain_model:creditSupportAgreementType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:otherAgreement ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:creditSupportAgreementMarginType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MasterAgreementTypeEnum ;
            owl:onProperty common_domain_model:masterAgreementType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MasterConfirmationTypeEnum ;
            owl:onProperty common_domain_model:masterConfirmationType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BrokerConfirmationTypeEnum ;
            owl:onProperty common_domain_model:brokerConfirmationType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:otherAgreement ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CollateralMarginTypeEnum ;
            owl:onProperty common_domain_model:creditSupportAgreementMarginType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:brokerConfirmationType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:masterConfirmationAnnexType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:contractualMatrix ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ContractualDefinitionsEnum ;
            owl:onProperty common_domain_model:contractualDefinitionsType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:brokerConfirmationType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:creditSupportAgreementType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:masterConfirmationType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:contractualDefinitionsType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:creditSupportAgreementType ] ;
    skos:closeMatch fpml_5_10:AgreementName ;
    skos:definition "Specifies the agreement name through an agreement type and optional detailed sub agreement type." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    skos:note "Rosetta condition: AgreementType — if agreementType <> LegalAgreementTypeEnum -> Other then otherAgreement is absent else if agreementType <> LegalAgreementTypeEnum -> MasterAgreement then masterAgreementType is absent else if agreementType <> LegalAgreementTypeEnum -> MasterConfirmation then masterConfirmationType is absent and masterConfirmationAnnexType is absent else if agreementType <> LegalAgreementTypeEnum -> Confirmation then contractualDefinitionsType is absent and contractualTermsSupplement is absent and contractualMatrix is absent",
        "Rosetta condition: CSAMarginType — if creditSupportAgreementMarginType exists then creditSupportAgreementType exists",
        "Rosetta condition: CreditSupportAgreement — if agreementType = LegalAgreementTypeEnum -> CreditSupportAgreement then creditSupportAgreementType exists",
        "Rosetta condition: MasterConfirmation — if masterConfirmationAnnexType exists then masterConfirmationType exists" .

common_domain_model:AveragingCalculation a owl:Class ;
    rdfs:label "AveragingCalculation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:precision ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AveragingCalculationMethod ;
            owl:onProperty common_domain_model:averagingMethod ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:averagingMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:precision ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Rounding ;
            owl:onProperty common_domain_model:precision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:averagingMethod ] ;
    skos:closeMatch fpml_5_10:AveragingCalculation ;
    skos:definition "Defines parameters for use in cases when a valuation or other term is based on an average of market observations." ;
