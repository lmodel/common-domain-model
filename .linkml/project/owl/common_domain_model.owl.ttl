            owl:onProperty common_domain_model:determinationRole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:disputingParty ] ;
    skos:definition "Defines the roles and related terms which document the agreement of parties about any determination requirements ; mostly about Extraordinary Events, without being necessarily restricted to such scope, as further specified in the particular product at stake e.g. for instance when Calculation Agent is mentioned as the Price Determination Method enumarated value, etc." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms ;
    skos:note "Rosetta condition: DisputingPartyCannotHaveOriginalRole — whoToDetermine all <> disputingParty" .

common_domain_model:DigitalAsset a owl:Class ;
    rdfs:label "DigitalAsset" ;
    rdfs:subClassOf common_domain_model:AssetBase ;
    skos:definition "An Asset that exists only in digital form, eg Bitcoin or Ethereum, that is not backed by other Assets; excludes the digital representation of other Assets, eg coins or Tokenised assets." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    skos:note "Rosetta condition: AssetType — assetType = Other" .

common_domain_model:DirectOrRelativeTime a owl:Class ;
