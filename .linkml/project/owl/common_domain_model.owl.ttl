	rdfs:label "Furthest_Estimate" ;
	rdfs:subClassOf common_domain_model:PayeeOfSubstituteCalculationAgentEnum ;
	skos:definition "The party whose calculations were further away from those of the substitute" .
common_domain_model:PayeeOfSubstituteCalculationAgentEnum\#Other a owl:Class ;
	rdfs:label "Other" ;
	rdfs:subClassOf common_domain_model:PayeeOfSubstituteCalculationAgentEnum ;
	skos:definition "Other (to be specified)" .
