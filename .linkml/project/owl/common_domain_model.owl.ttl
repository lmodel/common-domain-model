    rdfs:label "Penultimate" ;
    rdfs:subClassOf common_domain_model:DayDistributionEnum .

<https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#FRI> a owl:Class ;
    rdfs:label "FRI" ;
    rdfs:subClassOf common_domain_model:DayOfWeekEnum ;
    skos:definition "Friday" .

<https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#MON> a owl:Class ;
