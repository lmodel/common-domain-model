    rdfs:label "RatingsDowngradeOrWithdrawalParty1" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Specifies an event where Party 1 experiences a downgrade beyond a predetermined level, or has their credit rating withdrawn or suspended." .

<https://w3id.org/lmodel/common-domain-model/AdditionalTerminationEventEnum#RatingsDowngradeOrWithdrawalParty2> a owl:Class ;
    rdfs:label "RatingsDowngradeOrWithdrawalParty2" ;
    rdfs:subClassOf common_domain_model:AdditionalTerminationEventEnum ;
    skos:definition "Specifies an event where Party 2 experiences a downgrade beyond a predetermined level, or has their credit rating withdrawn or suspended." .

