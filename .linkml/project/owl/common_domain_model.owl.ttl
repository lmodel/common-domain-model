    rdfs:label "ValuationTimeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ValuationTimeEnum#CloseOfBusiness> <https://w3id.org/lmodel/common-domain-model/ValuationTimeEnum#SpecificTime> <https://w3id.org/lmodel/common-domain-model/ValuationTimeEnum#AsSelected> ) ;
