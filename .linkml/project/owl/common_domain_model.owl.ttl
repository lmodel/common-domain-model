	skos:definition "An individual piece of available inventory. This represents a single security and its associated criteria. The criteria are used to describe any restrictions on the securities." ;
	skos:inScheme common_domain_model:cdm_event_position ;
	skos:note "Rosetta condition InterestRate is not stated in LinkML: if interestRate exists then interestRate -> priceType = PriceTypeEnum -> InterestRate" , "Rosetta condition ValidPartyRole is not stated in LinkML: IsValidPartyRole (partyRole, [PartyRoleEnum -> AgentLender, PartyRoleEnum -> BeneficialOwner, PartyRoleEnum -> Custodian, PartyRoleEnum -> Lender])" .
