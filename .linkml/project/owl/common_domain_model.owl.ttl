common_domain_model:AssetFlowBase a owl:Class ;
    rdfs:label "AssetFlowBase" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Cash common_domain_model:Commodity common_domain_model:DigitalAsset common_domain_model:Instrument ) ] common_domain_model:Asset ) ] ;
            owl:onProperty common_domain_model:asset ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:NonNegativeQuantity ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:asset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:asset ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:settlementDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDiscounting ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:paymentDiscounting ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PaymentDiscounting ;
            owl:onProperty common_domain_model:paymentDiscounting ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:quantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrAdjustedOrRelativeDate ;
            owl:onProperty common_domain_model:settlementDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:settlementDate ] ;
    skos:closeMatch fpml_5_10:AssetFlowBase ;
    skos:definition "Defines the basic parameters of an asset transfer, e.g. a cashflow: what (the asset), how much (the quantity) and when (the settlement date)." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    skos:note "Rosetta condition: QuantityUnitExists — if asset -> Cash exists then quantity -> unit -> currency exists else if asset -> Commodity exists then quantity -> unit -> capacityUnit exists else if asset -> Instrument exists then quantity -> unit -> financialUnit exists" .

