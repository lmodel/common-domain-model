        <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#Party2>,
        <https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum#PartyMakingDemand> .

common_domain_model:CallTypeEnum a owl:Class ;
