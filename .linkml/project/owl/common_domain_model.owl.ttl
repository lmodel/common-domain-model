common_domain_model:businessDays a owl:DatatypeProperty ;
    rdfs:label "businessDays" ;
    rdfs:range xsd:integer ;
    skos:definition "A number of business days. Its precise meaning is dependant on the context in which this element is used. ISDA 2003 Term: Business Day." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:discountFactor a owl:DatatypeProperty ;
    rdfs:label "discountFactor" ;
    rdfs:range xsd:decimal ;
    skos:definition "A decimal value representing the discount factor used to calculate the present value of cash flow." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:issuerType a owl:ObjectProperty ;
    rdfs:label "issuerType" ;
    rdfs:range common_domain_model:CollateralEntityTypeEnum ;
    skos:closeMatch fpml_5_10:CollateralIssuerType.issuerType ;
    skos:definition "Specifies the origin of entity issuing the collateral." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:periodMultiplier a owl:DatatypeProperty ;
    rdfs:label "periodMultiplier" ;
    rdfs:range xsd:integer ;
    skos:definition "A time period multiplier, e.g. 1, 2, or 3. If the period value is T (Term) then period multiplier must contain the value 1." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:priceQuantity a owl:ObjectProperty ;
    rdfs:label "priceQuantity" ;
    rdfs:range common_domain_model:PriceQuantity ;
    skos:definition "Defines the prices (e.g. spread, equity price, FX rate), quantities (e.g. currency amount, no. shares) and settlement terms (e.g. initial fee, broker fee, up-front cds payment or option premium settlement) associated with the constituents of the transacted product." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:substitution a owl:ObjectProperty ;
    rdfs:label "substitution" ;
    rdfs:range common_domain_model:Substitution ;
    skos:definition "The conditions under which the Security Provider can substitute posted collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:AdjustableDate a owl:Class ;
    rdfs:label "AdjustableDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateAdjustmentsReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:dateAdjustmentsReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dateAdjustmentsReference ] ;
    skos:closeMatch fpml_5_10:AdjustableDate ;
    skos:definition "A class for defining a date that shall be subject to adjustment if it would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the date." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: AdjustableDateChoice — optional choice dateAdjustments, dateAdjustmentsReference",
        "Rosetta func: AdjustableDateResolution — Prioritization of unadjustedDate over adjustedDate." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"AdjustableDateResolution\",\"description\":\"Prioritization of unadjustedDate over adjustedDate.\",\"inputs\":[{\"name\":\"adjustableDate\",\"type\":\"AdjustableDate\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:AdjustableRelativeOrPeriodicDates a owl:Class ;
    rdfs:label "AdjustableRelativeOrPeriodicDates" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:periodicDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PeriodicDates ;
            owl:onProperty common_domain_model:periodicDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:relativeDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableDates ;
            owl:onProperty common_domain_model:adjustableDates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:relativeDates ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RelativeDates ;
            owl:onProperty common_domain_model:relativeDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:periodicDates ] ;
    skos:closeMatch fpml_5_10:AdjustableRelativeOrPeriodicDates ;
    skos:definition "A class giving the choice between defining a series of dates as an explicit list of dates together with applicable adjustments or as relative to some other series of (anchor) dates, or as a calculation period schedule." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: AdjustableRelativeOrPeriodicDatesChoice — required choice adjustableDates, relativeDates, periodicDates",
        "Rosetta func: ResolveAdjustableDates" ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"ResolveAdjustableDates\",\"inputs\":[{\"name\":\"adjustableRelativeOrPeriodicDates\",\"type\":\"AdjustableRelativeOrPeriodicDates\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"adjustedDates\",\"type\":\"date\",\"cardinality\":\"0..*\"},\"code_implementation\":true}]" .

