common_domain_model:CommodityPriceReturnTerms a owl:Class ;
    rdfs:label "CommodityPriceReturnTerms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:rollFeature ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:spread ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:conversionFactor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:spread ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Rounding ;
            owl:onProperty common_domain_model:rounding ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SpreadSchedule ;
            owl:onProperty common_domain_model:spread ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:conversionFactor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:conversionFactor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:rollFeature ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:rounding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:rounding ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RollFeature ;
            owl:onProperty common_domain_model:rollFeature ] ;
    skos:closeMatch fpml_5_10:CommodityPriceReturnTerms ;
    skos:definition "Defines parameters in which the commodity price is assessed." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:CommodityProductDefinition a owl:Class ;
    rdfs:label "CommodityProductDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:exchangeId ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceSource ;
            owl:onProperty common_domain_model:priceSource ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:referenceFramework ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:priceSource ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:referenceFramework ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CommodityInformationPublisherEnum ;
            owl:onProperty common_domain_model:commodityInfoPublisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:commodityInfoPublisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CommodityReferenceFramework ;
            owl:onProperty common_domain_model:referenceFramework ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:commodityInfoPublisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:priceSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:exchangeId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:exchangeId ] ;
    skos:closeMatch fpml_5_10:CommodityProductDefinition ;
    skos:definition "Specifies the commodity underlier in the event that no ISDA Commodity Reference Price exists." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    skos:note "Rosetta condition: CommodityProductDefinitionChoice — optional choice exchangeId, priceSource" .

common_domain_model:CommodityReferenceFramework a owl:Class ;
    rdfs:label "CommodityReferenceFramework" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:weatherUnit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:capacityUnit ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CapacityUnitEnum ;
            owl:onProperty common_domain_model:capacityUnit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:capacityUnit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:commodityName ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:currency ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:currency ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:commodityName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:currency ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:commodityName ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:WeatherUnitEnum ;
            owl:onProperty common_domain_model:weatherUnit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:weatherUnit ] ;
    skos:closeMatch fpml_5_10:CommodityReferenceFramework ;
    skos:definition "Specifies the type of commodity." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    skos:note "Rosetta condition: CommodityReferenceFrameworkChoice — optional choice capacityUnit, weatherUnit" .

