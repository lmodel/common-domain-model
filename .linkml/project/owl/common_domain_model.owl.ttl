<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#BBGID> a owl:Class ;
    rdfs:label "BBGID" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Published by Bloomberg, the BBGID is a 12-digit alphanumeric randomly generated ID covering active and non-active securities." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#BBGTICKER> a owl:Class ;
    rdfs:label "BBGTICKER" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Published by Bloomberg as a short code to identify publicly trades shares of a particular stock on a specific exchange." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#CUSIP> a owl:Class ;
    rdfs:label "CUSIP" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Derived from the Committee on Uniform Security Identification Procedures, CUSIPs are 9-character identifiers that capture an issue’s important differentiating characteristics for issuers and their financial instruments in the U.S. and Canada." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#FIGI> a owl:Class ;
    rdfs:label "FIGI" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Issued under the guidelines of the Object Management Group, the Financial Instrument Global Identifier (FIGI) is a 12 character, alphanumeric, randomly generated ID covering hundreds of millions of active and inactive instruments. The identifier acts as a Uniform Resource Identifier (URI) to link to a set of metadata that uniquely and clearly describes the instrument." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#ISDACRP> a owl:Class ;
    rdfs:label "ISDACRP" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Issued by the International Swaps Dealers Association as a string representing a Commodity Reference Price used for purposes of determining a relevant price for an underlying commodity in an OTC derivatives contract." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#ISIN> a owl:Class ;
    rdfs:label "ISIN" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Issued by The International Securities Identification Number (ISIN) Organization, the ISIN is a 12-character alpha-numerical code used to uniformly identify a security for trading and settlement purposes. Securities with which ISINs can be used include debt securities, such as notes or bonds as well shares, such as common stock or shares of a fund, options, derivatives, and futures. The ISIN structure is defined in ISO 6166." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#Name> a owl:Class ;
    rdfs:label "Name" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "The name of the product." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#Other> a owl:Class ;
    rdfs:label "Other" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Used when the source is not otherwise in this enumerated list because it is internal or other reasons.  The source can be identified in the scheme which is part of the identifier attribute." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#REDID> a owl:Class ;
    rdfs:label "REDID" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Assigned by S&P Global Market Intelligence, REDID (Reference Entity Data Identifier) is a unique alphanumeric code to reference entities, primarily utilized within the credit derivatives market for the standardized identification of underlying entities." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#RIC> a owl:Class ;
    rdfs:label "RIC" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Issued by Refinitiv (formerly Reuters), the Reuters Instrument Codes(RIC) uniquely identifies financial instruments, including where they are traded." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#SEDOL> a owl:Class ;
    rdfs:label "SEDOL" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Assigned by the London Stock Exchange, the Stock Exchange Daily Official List (SEDOL) is a list of security identifiers used in the United Kingdom and Ireland for clearing purposes.  SEDOLs serve as the National Securities Identifying Number for all securities issued in the United Kingdom and are therefore part of the security's ISIN as well." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#Sicovam> a owl:Class ;
    rdfs:label "Sicovam" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Issued by the French Société Interprofessionnelle pour la Compensation des Valeurs Mobilières (SICOVAM) to identify French securities listed on French stock exchanges." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#UPI> a owl:Class ;
    rdfs:label "UPI" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Assigned by the Derivatives Service Bureau Ltd (DSB), the Unique Product Identifier (UPI) is a unique code to describe an over-the-counter (OTC) derivatives product.  The UPI is used for identifying the product in transaction reporting data." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#Valoren> a owl:Class ;
    rdfs:label "Valoren" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Assigned by SIX Financial Information, Valoren is a unique numerical identification number typically ranging from six to nine digits primarily traded in Switzerland, Liechtenstein, and Belgium. This code enables the identification of securities such as stocks, bonds, and investment funds within these markets." .

<https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum#Wertpapier> a owl:Class ;
    rdfs:label "Wertpapier" ;
    rdfs:subClassOf common_domain_model:ProductIdTypeEnum ;
    skos:definition "Issued by the Institute for the Issuance and Administration of Securities in Germany (Securities Information), the Wertpapierkennnummer (WKN, WPKN, WPK or simply Wert) consists of six digits or capital letters (excluding I and O), and no check digit. It is used to identify German securities." .

<https://w3id.org/lmodel/common-domain-model/PropertyTypeEnum#Commercial> a owl:Class ;
    rdfs:label "Commercial" ;
    rdfs:subClassOf common_domain_model:PropertyTypeEnum ;
    skos:definition "Commercial property." .

<https://w3id.org/lmodel/common-domain-model/PropertyTypeEnum#Residential> a owl:Class ;
    rdfs:label "Residential" ;
    rdfs:subClassOf common_domain_model:PropertyTypeEnum ;
    skos:definition "Residential property." .

common_domain_model:PubliclyAvailableInformation a owl:Class ;
    rdfs:label "PubliclyAvailableInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:standardPublicSources ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:publicSource ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:standardPublicSources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:publicSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:specifiedNumber ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:specifiedNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:specifiedNumber ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:standardPublicSources ] ;
    skos:inScheme common_domain_model:cdm_observable_event ;
    skos:note "Rosetta condition: PositiveSpecifiedNumber — if specifiedNumber exists then specifiedNumber >= 0",
        "Rosetta condition: SourceChoice — required choice standardPublicSources, publicSource" .

<https://w3id.org/lmodel/common-domain-model/PutCallEnum#Call> a owl:Class ;
    rdfs:label "Call" ;
    rdfs:subClassOf common_domain_model:PutCallEnum ;
    skos:definition "A call option gives the holder the right to buy the underlying asset by a certain date for a certain price." .

<https://w3id.org/lmodel/common-domain-model/PutCallEnum#Put> a owl:Class ;
    rdfs:label "Put" ;
    rdfs:subClassOf common_domain_model:PutCallEnum ;
    skos:definition "A put option gives the holder the right to sell the underlying asset by a certain date for a certain price." .

common_domain_model:Qty a owl:Class ;
    rdfs:label "Qty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:unit ] ;
    skos:inScheme common_domain_model:cdm_regulation .

<https://w3id.org/lmodel/common-domain-model/QuantifierEnum#All> a owl:Class ;
    rdfs:label "All" ;
    rdfs:subClassOf common_domain_model:QuantifierEnum ;
    skos:definition "Specifies that the condition in the scope of the quantifier is true of every member of the domain i.e. every one of the elements in scope." .

<https://w3id.org/lmodel/common-domain-model/QuantifierEnum#Any> a owl:Class ;
    rdfs:label "Any" ;
    rdfs:subClassOf common_domain_model:QuantifierEnum ;
    skos:definition "Specifies that the condition in the scope of the quantifier is true of at least one member of the domain i.e. one or more of the elements in scope." .

<https://w3id.org/lmodel/common-domain-model/QuantityChangeDirectionEnum#Decrease> a owl:Class ;
    rdfs:label "Decrease" ;
    rdfs:subClassOf common_domain_model:QuantityChangeDirectionEnum ;
    skos:definition "When the quantity should go down by the specified amount." .

<https://w3id.org/lmodel/common-domain-model/QuantityChangeDirectionEnum#Increase> a owl:Class ;
    rdfs:label "Increase" ;
    rdfs:subClassOf common_domain_model:QuantityChangeDirectionEnum ;
    skos:definition "When the quantity should go up by the specified amount." .

<https://w3id.org/lmodel/common-domain-model/QuantityChangeDirectionEnum#Replace> a owl:Class ;
    rdfs:label "Replace" ;
    rdfs:subClassOf common_domain_model:QuantityChangeDirectionEnum ;
    skos:definition "When the quantity should be replaced by the specified amount." .

common_domain_model:QuantityChangeInstruction a owl:Class ;
    rdfs:label "QuantityChangeInstruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:QuantityChangeDirectionEnum ;
            owl:onProperty common_domain_model:direction ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:change ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Identifier ;
            owl:onProperty common_domain_model:lotIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PriceQuantity ;
            owl:onProperty common_domain_model:change ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:lotIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:direction ] ;
    skos:definition "Instructions required to create a Quantity Change Primitive Event, which can be either an increase, a decrease or a replacement. An increase adds a new trade lot to the original trade, whereas a decrease subtracts from an existing trade lot's quantity. A replacement updates the quantity of an existing trade lot to the new value." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta func: Create_OnDemandRateChangePriceChangeInstruction — Creates a price change instruction for an on-demand rate change, based on a new rate provided as a single number by matching it to a single rate price.",
        "Rosetta func: Create_QuantityChange — A specification of the inputs, outputs and constraints when calculating the after state of a Quantity Change Primitive Event" ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_QuantityChange\",\"description\":\"A specification of the inputs, outputs and constraints when calculating the after state of a Quantity Change Primitive Event\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"QuantityChangeInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"quantityChange\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_OnDemandRateChangePriceChangeInstruction\",\"description\":\"Creates a price change instruction for an on-demand rate change, based on a new rate provided as a single number by matching it to a single rate price.\",\"inputs\":[{\"name\":\"priceQuantity\",\"type\":\"PriceQuantity\",\"cardinality\":\"1..*\"},{\"name\":\"newRate\",\"type\":\"number\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"quantityChangeInstruction\",\"type\":\"QuantityChangeInstruction\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:QuantityMultiplier a owl:Class ;
    rdfs:label "QuantityMultiplier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:multiplierValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty common_domain_model:multiplierValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:multiplierValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fxLinkedNotionalSchedule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fxLinkedNotionalSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FxLinkedNotionalSchedule ;
            owl:onProperty common_domain_model:fxLinkedNotionalSchedule ] ;
    skos:definition " Class to specify a mechanism for a quantity to be set as a multiplier to another (reference) quantity, based on a price observation. At the moment this class only supports FX or Equity-linked notional and re-uses existing building blocks for those 2 cases, until such time when component can be made more generic. This captures the case of resetting cross-currency swaps and resetting equity swaps." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:QuantitySchedule a owl:Class ;
    rdfs:label "QuantitySchedule" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Measure ;
            owl:onProperty common_domain_model:multiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:multiplier ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Frequency ;
            owl:onProperty common_domain_model:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:frequency ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:multiplier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:frequency ],
        common_domain_model:MeasureSchedule ;
    skos:definition "Specifies a quantity schedule to be associated to a financial product to represent a trade amount. This data type extends MeasureSchedule with several unit or multiplier attributes that are used to define financial quantities. This data type is generically based on a schedule and can also be used to represent a quantity as a single value." ;
    skos:inScheme common_domain_model:cdm_base_math ;
    skos:note "Rosetta condition: Quantity_multiplier — if multiplier exists then multiplier -> value >= 0.0",
        "Rosetta condition: UnitOfAmountExists — unit exists",
        "Rosetta func: FilterQuantityByCurrency — Filter list of quantities based on unit type.",
        "Rosetta func: FilterQuantityByCurrencyExists — Filter list of quantities based on unit type.",
        "Rosetta func: FilterQuantityByFinancialUnit — Filter list of quantities based on unit type." ;
    common_domain_model:rosetta_functions "[{\"name\":\"FilterQuantityByCurrency\",\"description\":\"Filter list of quantities based on unit type.\",\"inputs\":[{\"name\":\"quantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"},{\"name\":\"currency\",\"type\":\"string\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredQuantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"}},{\"name\":\"FilterQuantityByCurrencyExists\",\"description\":\"Filter list of quantities based on unit type.\",\"inputs\":[{\"name\":\"quantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"filteredQuantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"}},{\"name\":\"FilterQuantityByFinancialUnit\",\"description\":\"Filter list of quantities based on unit type.\",\"inputs\":[{\"name\":\"quantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"},{\"name\":\"financialUnit\",\"type\":\"FinancialUnitEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredQuantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"}}]" .

common_domain_model:Quanto a owl:Class ;
    rdfs:label "Quanto" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:fxSpotRateSource ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fxSpotRateSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenterTime ;
            owl:onProperty common_domain_model:fixingTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FxRate ;
            owl:onProperty common_domain_model:fxRate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FxSpotRateSource ;
            owl:onProperty common_domain_model:fxSpotRateSource ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fxRate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fixingTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fixingTime ] ;
    skos:definition "Determines the currency rate that the seller of the equity amounts will apply at each valuation date for converting the respective amounts into a currency that is different from the currency denomination of the underlier." ;
    skos:inScheme common_domain_model:cdm_product_template .

<https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum#Ask> a owl:Class ;
    rdfs:label "Ask" ;
    rdfs:subClassOf common_domain_model:QuotationRateTypeEnum ;
    skos:definition "An ask rate." .

<https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum#Bid> a owl:Class ;
    rdfs:label "Bid" ;
    rdfs:subClassOf common_domain_model:QuotationRateTypeEnum ;
    skos:definition "A bid rate." .

<https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum#ExercisingPartyPays> a owl:Class ;
    rdfs:label "ExercisingPartyPays" ;
    rdfs:subClassOf common_domain_model:QuotationRateTypeEnum ;
    skos:definition "If optional early termination is applicable to a swap transaction, the rate, which may be a bid or ask rate, which would result, if seller is in-the-money, in the higher absolute value of the cash settlement amount, or, is seller is out-of-the-money, in the lower absolute value of the cash settlement amount." .

<https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum#Mid> a owl:Class ;
    rdfs:label "Mid" ;
    rdfs:subClassOf common_domain_model:QuotationRateTypeEnum ;
    skos:definition "A mid-market rate." .

<https://w3id.org/lmodel/common-domain-model/QuotationSideEnum#Afternoon> a owl:Class ;
