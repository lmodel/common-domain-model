    rdfs:label "Trade" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:collateral ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ExecutionDetails ;
            owl:onProperty common_domain_model:executionDetails ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:tradeTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:partyRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Collateral ;
            owl:onProperty common_domain_model:collateral ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:tradeDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:clearedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Party ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:clearedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Account ;
            owl:onProperty common_domain_model:account ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:collateral ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:tradeTime ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:executionDetails ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:tradeDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:tradeIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:executionDetails ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:contractDetails ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:tradeDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TimeZone ;
            owl:onProperty common_domain_model:tradeTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:party ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PartyRole ;
            owl:onProperty common_domain_model:partyRole ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:clearedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:contractDetails ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ContractDetails ;
            owl:onProperty common_domain_model:contractDetails ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:account ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TradeIdentifier ;
            owl:onProperty common_domain_model:tradeIdentifier ],
        common_domain_model:TradableProduct ;
    skos:closeMatch gist:Transaction ;
    skos:definition "Defines the output of a financial transaction between parties - a Business Event. A Trade impacts the financial position (i.e. the balance sheet) of involved parties." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: AdditionalFixedPaymentsMortgages — if ((product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation -> security -> securityType any = Debt and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation -> security -> debtType -> debtEconomics -> secured -> securedType any = AssetBacked) or contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualTermsSupplement -> contractualTermsSupplementType contains ContractualSupplementTypeEnum -> CDSonMBS) and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> floatingAmountEvents exists then (product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> floatingAmountEvents -> additionalFixedPayments -> interestShortfallReimbursement exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> floatingAmountEvents -> additionalFixedPayments -> principalShortfallReimbursement exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> floatingAmountEvents -> additionalFixedPayments -> writedownReimbursement exists)",
        "Rosetta condition: BarrierDerterminationAgent — if partyRole -> role contains PartyRoleEnum -> BarrierDeterminationAgent then FilterPartyRole(partyRole, PartyRoleEnum -> BarrierDeterminationAgent) count <= 1",
        "Rosetta condition: ClearedDate — if clearedDate exists then clearedDate >= tradeDate",
        "Rosetta condition: CreditEventsMortgages — if ((product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation -> security -> securityType any = Debt and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation -> security -> debtType -> debtEconomics -> secured -> securedType any = AssetBacked) or contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualTermsSupplement -> contractualTermsSupplementType contains ContractualSupplementTypeEnum -> CDSonMBS) and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents exists then (product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> failureToPayPrincipal exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> failureToPayInterest exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> distressedRatingsDowngrade exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> maturityExtension exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> writedown exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> impliedWritedown exists)",
        "Rosetta condition: CreditEventsPhysicalSettlementMatrix — if (contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType all <> MatrixTypeEnum -> CreditDerivativesPhysicalSettlementMatrix or contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType is absent) and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents exists then (product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> bankruptcy exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> obligationDefault exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> obligationAcceleration exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> repudiationMoratorium exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> governmentalIntervention exists)",
        "Rosetta condition: DeliverableObligationsPhysicalSettlementMatrix — if (contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType all <> MatrixTypeEnum -> CreditDerivativesPhysicalSettlementMatrix or contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType is absent) and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations exists then (product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notSubordinated exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> specifiedCurrency exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notSovereignLender exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notDomesticCurrency exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notDomesticLaw exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notContingent exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notDomesticIssuance exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> assignableLoan exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> consentRequiredLoan exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> transferable exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> maximumMaturity exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notBearer exists) and (product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> fullFaithAndCreditObLiability exists or product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> generalFundObligationLiability exists or product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> revenueObligationLiability exists)",
        "Rosetta condition: DeterminingParty — if partyRole -> role contains PartyRoleEnum -> DeterminingParty then FilterPartyRole(partyRole, PartyRoleEnum -> DeterminingParty) count <= 2",
        "Rosetta condition: DisruptionEventsDeterminingParty — if contractDetails -> documentation -> agreementTerms -> agreement -> transactionAdditionalTerms -> equityAdditionalTerms -> extraordinaryEvents -> additionalDisruptionEvents -> determiningParty exists then ancillaryParty -> role contains AncillaryRoleEnum -> DisruptionEventsDeterminingParty and if ancillaryParty -> role contains AncillaryRoleEnum -> DisruptionEventsDeterminingParty then contractDetails -> documentation -> agreementTerms -> agreement -> transactionAdditionalTerms -> equityAdditionalTerms -> extraordinaryEvents -> additionalDisruptionEvents -> determiningParty exists",
        "Rosetta condition: ExtraordinaryEvents — if contractDetails -> documentation -> agreementTerms -> agreement -> transactionAdditionalTerms -> equityAdditionalTerms -> extraordinaryEvents exists then (product -> economicTerms -> payout -> PerformancePayout -> returnTerms -> priceReturnTerms exists or product -> economicTerms -> payout -> OptionPayout exists) and Qualify_AssetClass_Equity(product -> economicTerms)",
        "Rosetta condition: FloatingAmountEventsMortgages — if ((product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation -> security -> securityType any = Debt and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referenceObligation -> security -> debtType -> debtEconomics -> secured -> securedType any = AssetBacked) or contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualTermsSupplement -> contractualTermsSupplementType contains ContractualSupplementTypeEnum -> CDSonMBS) and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> floatingAmountEvents exists then (product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> floatingAmountEvents -> failureToPayPrincipal exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> floatingAmountEvents -> writedown exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> floatingAmountEvents -> impliedWritedown exists)",
        "Rosetta condition: FpML_cd_1 — if product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation exists then tradeDate < product -> economicTerms -> effectiveDate -> adjustableDate -> unadjustedDate or tradeDate < product -> economicTerms -> effectiveDate -> adjustableDate -> adjustedDate",
        "Rosetta condition: FpML_cd_11 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> masterConfirmationType is absent and contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation exists and contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualDefinitionsType any = ContractualDefinitionsEnum -> ISDA2003CreditDerivatives then product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> allGuarantees exists",
        "Rosetta condition: FpML_cd_19 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualDefinitionsType any = ContractualDefinitionsEnum -> ISDA1999CreditDerivatives then product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> creditEventNotice -> businessCenter is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> restructuring -> multipleHolderObligation is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> restructuring -> multipleCreditEventNotices is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> allGuarantees is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> indexReferenceInformation is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> substitution is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> modifiedEquityDelivery is absent",
        "Rosetta condition: FpML_cd_20 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualDefinitionsType any = ContractualDefinitionsEnum -> ISDA2003CreditDerivatives then product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations -> notContingent is absent",
        "Rosetta condition: FpML_cd_23 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> masterConfirmationType is absent and contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation exists then product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> cashSettlementTerms exists or product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms exists",
        "Rosetta condition: FpML_cd_24 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> masterConfirmationType is absent and contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation exists then product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> creditEventNotice exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations exists and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation -> referencePrice exists",
        "Rosetta condition: FpML_cd_25 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> masterConfirmationType is absent and contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms exists then product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> settlementCurrency exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> physicalSettlementPeriod exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> escrow exists and product -> economicTerms -> payout -> CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> accruedInterest exists",
        "Rosetta condition: FpML_cd_32 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> masterConfirmationType is absent and contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation exists and product -> economicTerms -> payout -> InterestRatePayout -> priceQuantity exists and tradeLot -> priceQuantity -> quantity -> value exists then product -> economicTerms -> payout -> InterestRatePayout -> dayCountFraction exists",
        "Rosetta condition: FpML_cd_7 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> masterConfirmationType is absent and contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation exists then product -> economicTerms -> payout -> InterestRatePayout -> calculationPeriodDates -> effectiveDate -> adjustableDate -> dateAdjustments exists or tradeDate < product -> economicTerms -> effectiveDate -> adjustableDate -> adjustedDate",
        "Rosetta condition: FpML_cd_8 — if contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> masterConfirmationType is absent and contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix is absent and product -> economicTerms -> payout -> CreditDefaultPayout -> generalTerms -> referenceInformation exists then product -> economicTerms -> terminationDate -> adjustableDate -> dateAdjustments exists",
        "Rosetta condition: FpML_ird_8 — if product -> economicTerms -> payout -> InterestRatePayout exists then FpmlIrd8(item, account) = True",
        "Rosetta condition: HedgingParty — if partyRole -> role contains PartyRoleEnum -> HedgingParty then FilterPartyRole(partyRole, PartyRoleEnum -> HedgingParty) count <= 2",
        "Rosetta condition: ObligationsPhysicalSettlementMatrix — if (contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType all <> MatrixTypeEnum -> CreditDerivativesPhysicalSettlementMatrix or contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType is absent) and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations exists then (product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations -> notSubordinated exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations -> notSovereignLender exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations -> notDomesticLaw exists and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations -> notDomesticIssuance exists) and (product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations -> fullFaithAndCreditObLiability exists or product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations -> generalFundObligationLiability exists or product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> obligations -> revenueObligationLiability exists)",
        "Rosetta condition: PackageTrade — if executionDetails -> packageReference exists then executionDetails -> packageReference -> componentId -> assignedIdentifier contains tradeIdentifier -> assignedIdentifier",
        "Rosetta condition: RestructuringPhysicalSettlementMatrix — if (contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType all <> MatrixTypeEnum -> CreditDerivativesPhysicalSettlementMatrix or contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType is absent) and product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> restructuring exists then product -> economicTerms -> payout -> CreditDefaultPayout -> protectionTerms -> creditEvents -> restructuring -> multipleHolderObligation exists",
        "Rosetta condition: SettlementPayout — if SettlementPayoutOnlyExists(product -> economicTerms -> payout) then partyRole -> role contains PartyRoleEnum -> Buyer and partyRole -> role contains PartyRoleEnum -> Seller and tradeLot -> priceQuantity -> price exists",
        "Rosetta func: EquityPerformance — Part 1 Section 12 of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap, Para 75. 'Equity Performance' means, in respect of an Equity Cash Settlement Date, an amount in the Settlement Currency determined by the Calculation Agent as of the Equity Valuation Date to which the Equity Cash Settlement Amount relates, pursuant to the following formula: Equity Performance = (Rate Of Return)  Equity Notional Amount.",
        "Rosetta func: ExtractAfterTrade",
        "Rosetta func: ExtractBeforeTrade",
        "Rosetta func: TradeNoExecutionDetails" ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"EquityPerformance\",\"description\":\"Part 1 Section 12 of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap, Para 75. 'Equity Performance' means, in respect of an Equity Cash Settlement Date, an amount in the Settlement Currency determined by the Calculation Agent as of the Equity Valuation Date to which the Equity Cash Settlement Amount relates, pursuant to the following formula: Equity Performance = (Rate Of Return)  Equity Notional Amount.\",\"inputs\":[{\"name\":\"trade\",\"type\":\"Trade\",\"cardinality\":\"1..1\"},{\"name\":\"observation\",\"type\":\"Price\",\"cardinality\":\"1..1\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"equityPerformance\",\"type\":\"number\",\"cardinality\":\"1..1\"}},{\"name\":\"TradeNoExecutionDetails\",\"inputs\":[{\"name\":\"trade\",\"type\":\"Trade\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"newTrade\",\"type\":\"Trade\",\"cardinality\":\"1..1\"}},{\"name\":\"ExtractBeforeTrade\",\"inputs\":[{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"trade\",\"type\":\"Trade\",\"cardinality\":\"0..1\"}},{\"name\":\"ExtractAfterTrade\",\"inputs\":[{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"trade\",\"type\":\"Trade\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:TradeIdentifier a owl:Class ;
    rdfs:label "TradeIdentifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:identifierType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TradeIdentifierTypeEnum ;
            owl:onProperty common_domain_model:identifierType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:identifierType ],
        common_domain_model:Identifier ;
    skos:definition "Defines a trade identifier as a special case of the generic identifier type, that also includes the trade identifier class." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta func: Create_PartyChange — Defines the logic for changing one of the counterparties on a trade. A new trade identifier must be specified as a change of party results in a new trade. An ancillary party can also be specified, for instance to refer to the original executing party on the new trade." ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_PartyChange\",\"description\":\"Defines the logic for changing one of the counterparties on a trade. A new trade identifier must be specified as a change of party results in a new trade. An ancillary party can also be specified, for instance to refer to the original executing party on the new trade.\",\"inputs\":[{\"name\":\"counterparty\",\"type\":\"Counterparty\",\"cardinality\":\"1..1\"},{\"name\":\"ancillaryParty\",\"type\":\"AncillaryParty\",\"cardinality\":\"0..1\"},{\"name\":\"partyRole\",\"type\":\"PartyRole\",\"cardinality\":\"0..1\"},{\"name\":\"tradeId\",\"type\":\"TradeIdentifier\",\"cardinality\":\"1..*\"},{\"name\":\"originalTrade\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"newTrade\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" .

common_domain_model:TransferStatusEnum a owl:Class ;
    rdfs:label "TransferStatusEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Disputed> <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Instructed> <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Pending> <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Settled> <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Netted> ) ;
    skos:definition "The enumeration values to specify the transfer status." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Disputed>,
        <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Instructed>,
        <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Netted>,
        <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Pending>,
        <https://w3id.org/lmodel/common-domain-model/TransferStatusEnum#Settled> .

common_domain_model:TriggerTypeEnum a owl:Class ;
    rdfs:label "TriggerTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#EqualOrLess> <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#EqualOrGreater> <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#Equal> <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#Less> <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#Greater> ) ;
    skos:definition "The enumerated values to specify whether an option will trigger or expire depending upon whether the spot rate is above or below the barrier rate." ;
    skos:inScheme common_domain_model:cdm_observable_event ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#Equal>,
        <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#EqualOrGreater>,
        <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#EqualOrLess>,
        <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#Greater>,
        <https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum#Less> .

common_domain_model:ValuationDateFrequencyEnum a owl:Class ;
    rdfs:label "ValuationDateFrequencyEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#Daily> <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#Weekly> <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#Fortnightly> <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#Monthly> <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#AsAgreed> <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#AsSelected> ) ;
    skos:definition "The regularity of the event for the Valuation Date." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#AsAgreed>,
        <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#AsSelected>,
        <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#Daily>,
        <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#Fortnightly>,
        <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#Monthly>,
        <https://w3id.org/lmodel/common-domain-model/ValuationDateFrequencyEnum#Weekly> .

common_domain_model:ValuationTimeDayEnum a owl:Class ;
    rdfs:label "ValuationTimeDayEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#PreviousLocalBusinessDay> <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#PreviousLocalBusinessDayMarket> <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#PreviousLocalBusinessDayCityOfAgent> <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#ValuationDate> <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#AsSelected> ) ;
    skos:definition "The day at which the value of the collateral and obligations to transfer or return collateral are to be calculated relative to the Valuation Date." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#AsSelected>,
        <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#PreviousLocalBusinessDay>,
        <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#PreviousLocalBusinessDayCityOfAgent>,
        <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#PreviousLocalBusinessDayMarket>,
        <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum#ValuationDate> .

common_domain_model:day a owl:ObjectProperty ;
    rdfs:label "day" ;
    rdfs:range common_domain_model:ValuationTimeDayEnum ;
    skos:definition "The day in respect of which the Valuation Time is being specified. If not specified, addional language must be used to define the methodology." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:exchange a owl:ObjectProperty ;
    rdfs:label "exchange" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:closeMatch fpml_5_10:AssetBase.exchange ;
    skos:definition "If the Asset is listed, defines the public exchange of the listing." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:executionLocation a owl:ObjectProperty ;
    rdfs:label "executionLocation" ;
    rdfs:range common_domain_model:ExecutionLocationEnum ;
    skos:definition "The execution location of the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:expirationDate a owl:ObjectProperty ;
    rdfs:label "expirationDate" ;
    rdfs:range common_domain_model:AdjustableOrRelativeDate ;
    skos:closeMatch fpml_5_10:CancelableProvision.expirationDate ;
    skos:definition "The last day within the term of the contract that cancelation is allowed." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:frequency a owl:ObjectProperty ;
    rdfs:label "frequency" ;
    rdfs:range common_domain_model:Frequency ;
    skos:definition "Defines the frequency to be used when defining a quantity. For example a quantity may be specified as a number of barrels of oil per day, which needs multiplying by the number of days in the relevant period to get the total quantity as a number of barrels." ;
    skos:inScheme common_domain_model:cdm_base_math .

common_domain_model:fxFeature a owl:ObjectProperty ;
    rdfs:label "fxFeature" ;
    rdfs:range common_domain_model:FxFeature ;
    skos:closeMatch fpml_5_10:CommodityPayout.fxFeature ;
    skos:definition "Defines quanto or composite FX features that are included in the swap leg." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    rdfs:range xsd:string ;
    skos:definition "FpML specifies the timezoneLocationScheme by reference to the Time Zone Database (a.k.a. tz database) maintained by IANA, the Internet Assigned Numbers Authority." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    common_domain_model:metadata_scheme true .

common_domain_model:lotIdentifier a owl:ObjectProperty ;
    rdfs:label "lotIdentifier" ;
    rdfs:range common_domain_model:Identifier ;
    skos:definition "Lot Identifier associated with the transaction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:observationTime a owl:ObjectProperty ;
    rdfs:label "observationTime" ;
    rdfs:range common_domain_model:TimeZone ;
    skos:definition "Represents the time and time-zone." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:optionType a owl:ObjectProperty ;
    rdfs:label "optionType" ;
    rdfs:range common_domain_model:PutCallEnum ;
    skos:definition "The type of option, ie Put or Call. Left empty if it is a Future." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:sovereignRecourse a owl:DatatypeProperty ;
    rdfs:label "sovereignRecourse" ;
    rdfs:range xsd:boolean ;
    skos:definition "Applies to non-sovereign entity (e.g. separate legal personality from sovereign).  True if entity has recourse to sovereign (e.g. debt guaranteed by government).  False if entity does not have recourse to sovereign." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:strike a owl:DatatypeProperty ;
    rdfs:label "strike" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies the strike of the option." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:transferType a owl:ObjectProperty ;
    rdfs:label "transferType" ;
    rdfs:range common_domain_model:UnscheduledTransferEnum ;
    skos:definition "Specifies the type of unscheduled transfer." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:AssetBase a owl:Class ;
    rdfs:label "AssetBase" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AssetTypeEnum ;
            owl:onProperty common_domain_model:assetType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalEntity ;
            owl:onProperty common_domain_model:relatedExchange ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:assetType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:relatedExchange ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:taxonomy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:isExchangeListed ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:isExchangeListed ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:exchange ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AssetIdentifier ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:assetType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isExchangeListed ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:exchange ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:LegalEntity ;
            owl:onProperty common_domain_model:exchange ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Taxonomy ;
            owl:onProperty common_domain_model:taxonomy ] ;
    skos:closeMatch fpml_5_10:AssetBase ;
    skos:definition "The base data type to specify common attributes for all Assets." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    skos:note "Rosetta condition: ExchangeListed — if exchange exists then isExchangeListed",
        "Rosetta condition: RelatedExchange — if exchange is absent then relatedExchange is absent" .

common_domain_model:ClosedStateEnum a owl:Class ;
    rdfs:label "ClosedStateEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Allocated> <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Cancelled> <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Exercised> <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Expired> <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Matured> <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Novated> <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Terminated> ) ;
    skos:definition "The enumerated values to specify what led to the contract or execution closure." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Allocated>,
        <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Cancelled>,
        <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Exercised>,
        <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Expired>,
        <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Matured>,
        <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Novated>,
        <https://w3id.org/lmodel/common-domain-model/ClosedStateEnum#Terminated> .

common_domain_model:CollateralMarginTypeEnum a owl:Class ;
    rdfs:label "CollateralMarginTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/CollateralMarginTypeEnum#VariationMargin> <https://w3id.org/lmodel/common-domain-model/CollateralMarginTypeEnum#InitialMargin> ) ;
    skos:definition "The enumerated values to specify the type of margin for which a legal agreement is named." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/CollateralMarginTypeEnum#InitialMargin>,
        <https://w3id.org/lmodel/common-domain-model/CollateralMarginTypeEnum#VariationMargin> .

common_domain_model:ContactInformation a owl:Class ;
    rdfs:label "ContactInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Address ;
            owl:onProperty common_domain_model:address ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:webPage ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TelephoneNumber ;
            owl:onProperty common_domain_model:telephone ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:telephone ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:email ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:webPage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:address ] ;
    skos:closeMatch gist:ElectronicAddress,
        oscal:Location ;
    skos:definition "A class to specify contact information associated with a party: telephone, postal/street address, email and web page." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    skos:relatedMatch iso29100:PersonallyIdentifiableInformation .

common_domain_model:CreditLimitTypeEnum a owl:Class ;
    rdfs:label "CreditLimitTypeEnum" ;
    owl:unionOf ( <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#CS01> <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#DV01> <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#IM> <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#Notional> <https://w3id.org/lmodel/common-domain-model/CreditLimitTypeEnum#NPV> <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#PV01> ) ;
    skos:definition "The enumeration values to qualify the type of credit limits." ;
    skos:exactMatch fpml:credit-limit-type ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    linkml:permissible_values <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#CS01>,
        <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#DV01>,
        <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#IM>,
        <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#Notional>,
        <http://www.fpml.org/coding-scheme/credit-limit-type-1-1#PV01>,
        <https://w3id.org/lmodel/common-domain-model/CreditLimitTypeEnum#NPV> .

common_domain_model:DividendAmountTypeEnum a owl:Class ;
    rdfs:label "DividendAmountTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/DividendAmountTypeEnum#RecordAmount> <https://w3id.org/lmodel/common-domain-model/DividendAmountTypeEnum#ExAmount> <https://w3id.org/lmodel/common-domain-model/DividendAmountTypeEnum#PaidAmount> <https://w3id.org/lmodel/common-domain-model/DividendAmountTypeEnum#AsSpecifiedInMasterConfirmation> ) ;
    skos:definition "The enumerated values to specify whether the dividend is paid with respect to the Dividend Period." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/DividendAmountTypeEnum#AsSpecifiedInMasterConfirmation>,
        <https://w3id.org/lmodel/common-domain-model/DividendAmountTypeEnum#ExAmount>,
        <https://w3id.org/lmodel/common-domain-model/DividendAmountTypeEnum#PaidAmount>,
        <https://w3id.org/lmodel/common-domain-model/DividendAmountTypeEnum#RecordAmount> .

common_domain_model:EligibleCollateralCriteria a owl:Class ;
    rdfs:label "EligibleCollateralCriteria" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:treatment ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CollateralTreatment ;
            owl:onProperty common_domain_model:treatment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:treatment ],
        common_domain_model:CollateralCriteriaBase ;
    skos:definition "Represents a set of criteria used to specify eligible collateral." ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    skos:note "Rosetta condition: AverageTradingVolumeEquityOnly — if treatment -> concentrationLimit -> concentrationLimitCriteria -> averageTradingVolume exists then CriteriaMatchesSecurityType(collateralCriteria, Equity) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType( item -> concentrationLimitCriteria -> collateralCriteria, Equity )) all = True",
        "Rosetta condition: ConcentrationLimitTypeIssueOSAmountDebtOnly — if treatment -> concentrationLimit -> concentrationLimitCriteria -> concentrationLimitType only-element = ConcentrationLimitTypeEnum -> IssueOutstandingAmount then CriteriaMatchesSecurityType(collateralCriteria, Debt) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType( item -> concentrationLimitCriteria -> collateralCriteria, Debt )) all = True",
        "Rosetta condition: ConcentrationLimitTypeMarketCapEquityOnly — if treatment -> concentrationLimit -> concentrationLimitCriteria -> concentrationLimitType only-element = ConcentrationLimitTypeEnum -> MarketCapitalisation then CriteriaMatchesSecurityType(collateralCriteria, Equity) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType( item -> concentrationLimitCriteria -> collateralCriteria, Equity )) all = True" ;
    skos:relatedMatch gist:Specification .

common_domain_model:ExerciseTerms a owl:Class ;
    rdfs:label "ExerciseTerms" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ExerciseFeeSchedule ;
            owl:onProperty common_domain_model:exerciseFeeSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:commencementDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PartialExercise ;
            owl:onProperty common_domain_model:partialExercise ],
        [ a owl:Restriction ;
