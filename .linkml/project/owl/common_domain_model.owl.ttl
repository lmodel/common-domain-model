common_domain_model:DiscountingTypeEnum a owl:Class ;
    rdfs:label "DiscountingTypeEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/DiscountingTypeEnum#Standard> <https://w3id.org/lmodel/common-domain-model/DiscountingTypeEnum#FRA> <https://w3id.org/lmodel/common-domain-model/DiscountingTypeEnum#FRAYield> <https://w3id.org/lmodel/common-domain-model/DiscountingTypeEnum#AFMA> ) ;
    skos:definition "The enumerated values to specify the method of calculating discounted payment amounts. This enumerations combines the FpML DiscountingTypeEnum and FraDiscountingEnum enumerations." ;
