common_domain_model:InitialFixingDate a owl:Class ;
    rdfs:label "InitialFixingDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialFixingDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialFixingDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:relativeDateOffset ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RelativeDateOffset ;
            owl:onProperty common_domain_model:relativeDateOffset ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:initialFixingDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:relativeDateOffset ] ;
    skos:definition "A CDM class which purpose is to specify the initial fixing date either alongside the FpML interest rate specification as an offset of another date, or alongside the credit derivative specification as an unadjusted date." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:Instruction a owl:Class ;
    rdfs:label "Instruction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:before ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:primitiveInstruction ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TradeState ;
            owl:onProperty common_domain_model:before ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:primitiveInstruction ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:PrimitiveInstruction ;
            owl:onProperty common_domain_model:primitiveInstruction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:before ] ;
    skos:definition "Instruction to a function that will be used to perform a business event" ;
    skos:inScheme common_domain_model:cdm_event_common ;
    skos:note "Rosetta condition: ExclusiveSplitPrimitive — if primitiveInstruction -> split exists then primitiveInstruction -> split only exists",
        "Rosetta condition: NewTrade — (if primitiveInstruction -> execution exists then before is absent else True) and (if before is absent then primitiveInstruction -> execution exists else True)",
        "Rosetta func: Create_BusinessEvent — Creates a business event from instructions containing primitive instructions and optionally a trade state.",
        "Rosetta func: Create_PairOffInstruction — Creates a set of instructions to pair-off a set of trades based on a pair reference. A package component is created based on that pair reference and the list of identifiers for the underlying trades. That package component is then added onto the execution details of every underlying trade. The existing trades are not terminated." ;
    common_domain_model:rosetta_functions "[{\"name\":\"Create_PairOffInstruction\",\"description\":\"Creates a set of instructions to pair-off a set of trades based on a pair reference. A package component is created based on that pair reference and the list of identifiers for the underlying trades. That package component is then added onto the execution details of every underlying trade. The existing trades are not terminated.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"2..*\"},{\"name\":\"pairReference\",\"type\":\"Identifier\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"instruction\",\"type\":\"Instruction\",\"cardinality\":\"1..*\"}},{\"name\":\"Create_BusinessEvent\",\"description\":\"Creates a business event from instructions containing primitive instructions and optionally a trade state.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"Instruction\",\"cardinality\":\"1..*\"},{\"name\":\"intent\",\"type\":\"EventIntentEnum\",\"cardinality\":\"0..1\"},{\"name\":\"eventDate\",\"type\":\"date\",\"cardinality\":\"1..1\"},{\"name\":\"effectiveDate\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"businessEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}}]" .

