common_domain_model:DividendDateReference a owl:Class ;
    rdfs:label "DividendDateReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:paymentDateOffset ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:paymentDateOffset ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:dateReference ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Offset ;
            owl:onProperty common_domain_model:paymentDateOffset ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DividendDateReferenceEnum ;
            owl:onProperty common_domain_model:dateReference ] ;
    skos:definition "A class to specify the dividend date by reference to another date, with the ability to apply and offset. This class doesn't exist in FpML and is meant to simplify the choice constraint associated with the DividendPaymentDate class." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    skos:note "Rosetta condition: PaymentDateOffset — if paymentDateOffset exists then dateReference = DividendDateReferenceEnum -> SharePayment" .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#AdHocDate> a owl:Class ;
    rdfs:label "AdHocDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "The dividend date will be specified ad-hoc by the parties, typically on the dividend ex-date." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CashSettlePaymentDateExDiv> a owl:Class ;
    rdfs:label "CashSettlePaymentDateExDiv" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "If 'Dividend Payment Date(s)' is specified in the Transaction Supplement as 'Cash Settlement Payment Date – Ex Dividend'', then the Dividend Payment Date in respect of a Dividend Amount shall be the Cash Settlement Payment Date relating to the end of the Dividend Period during which the Shares commenced trading 'ex' the relevant dividend on the Exchange." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CashSettlePaymentDateIssuerPayment> a owl:Class ;
    rdfs:label "CashSettlePaymentDateIssuerPayment" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "If 'Dividend Payment Date(s)' is specified in the Transaction Supplement as 'Cash Settlement Payment Date – Issuer Payment', then the Dividend Payment Date in respect of a Dividend Amount shall be the Cash Settlement Payment Date relating to the end of the Dividend Period during which the issuer pays the relevant dividend to a holder of record provided that in the case where the Equity Amount Payer is the party specified to be the sole Hedging Party and the Hedging Party has not received the Dividend Amount by such date, then the date falling a number of Currency Business Days as specified in the Cash Settlement Payment Date after actual receipt by the Hedging Party of the Received Ex Amount or Paid Ex Amount (as applicable)." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CashSettlementPaymentDate> a owl:Class ;
    rdfs:label "CashSettlementPaymentDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "If 'Dividend Payment Date(s)' is specified in the Transaction Supplement as 'Cash Settlement Payment Date', then the Dividend Payment Date in respect of a Dividend Amount shall be the Cash Settlement Payment Date relating to the end of the Dividend Period during which the Shares commenced trading 'ex' the relevant dividend on the Exchange." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeEquityExDiv> a owl:Class ;
    rdfs:label "CumulativeEquityExDiv" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of dividends which go ex, paid on next following Equity Payment Date, which is immediately following the Dividend Period during which the Shares commence trading ex-dividend on the Exchange." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeEquityExDivBeforeReset> a owl:Class ;
    rdfs:label "CumulativeEquityExDivBeforeReset" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of paid dividends, paid on next following Equity Payment Date, which is immediately following the Dividend Ex Date, unless the Dividend Ex Date is between the Equity Valuation and Payment Date in which case the dividend is deferred to the following Equity Payment Date" .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeEquityPaid> a owl:Class ;
    rdfs:label "CumulativeEquityPaid" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of paid dividends, paid on next following Equity Payment Date, which is immediately following the Dividend Period during which the dividend is paid by the Issuer to the holders of record of a Share." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeEquityPaidBeforeReset> a owl:Class ;
    rdfs:label "CumulativeEquityPaidBeforeReset" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of paid dividends, paid on next following Equity Payment Date, which is immediately following the Dividend Pay Date, unless the Dividend Pay Date is between the Equity Valuation and Payment Date (not including the Valuation Date) in which case the dividend is deferred to the following Equity Payment Date" .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeEquityPaidInclReset> a owl:Class ;
    rdfs:label "CumulativeEquityPaidInclReset" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of paid dividends, paid on next following Equity Payment Date, which is immediately following the Dividend Pay Date, unless the Dividend Pay Date is between the Equity Valuation and Payment Date (including the Valuation Date) in which case the dividend is deferred to the following Equity Payment Date" .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeInterestExDiv> a owl:Class ;
    rdfs:label "CumulativeInterestExDiv" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of dividends which go ex, paid on next following Interest Payment Date, which is immediately following the Dividend Period during which the Shares commence trading ex-dividend on the Exchange, or where the date on which the Shares commence trading ex-dividend is a Payment Date, such Payment Date." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeInterestPaid> a owl:Class ;
    rdfs:label "CumulativeInterestPaid" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of paid dividends, paid on next following Interest Payment Date, which is immediately following the Dividend Period during which the dividend is paid by the Issuer to the holders of record of a Share." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeInterestPaidBeforeReset> a owl:Class ;
    rdfs:label "CumulativeInterestPaidBeforeReset" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of paid dividends, paid on next following Interest Payment Date, which is immediately following the Dividend Pay Date, unless the Dividend Pay Date is between the Equity Valuation and Payment Date (not including the Valuation Date) in which case the dividend is deferred to the following Interest Payment Date." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#CumulativeInterestPaidInclReset> a owl:Class ;
    rdfs:label "CumulativeInterestPaidInclReset" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Total of paid dividends, paid on next following Interest Payment Date, which is immediately following the Dividend Pay Date, unless the Dividend Pay Date is between the Equity Valuation and Payment Date (including the Valuation Date) in which case the dividend is deferred to the following Interest Payment Date." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#DividendPaymentDate> a owl:Class ;
    rdfs:label "DividendPaymentDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Date on which the dividend will be paid by the issuer." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#DividendValuationDate> a owl:Class ;
    rdfs:label "DividendValuationDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "In respect of each Dividend Period, the relevant Dividend Valuation Date." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#EquityPaymentDate> a owl:Class ;
    rdfs:label "EquityPaymentDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Equity payment date of the swap." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#ExDate> a owl:Class ;
    rdfs:label "ExDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Date on which a holder of the security is entitled to the dividend." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#FloatingAmountPaymentDate> a owl:Class ;
    rdfs:label "FloatingAmountPaymentDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "If 'Dividend Payment Date(s)' is specified in the Transaction Supplement as 'Floating Amount Payment Date', then the Dividend Payment Date in respect of a Dividend Amount shall be the first Payment Date falling at least one Settlement Cycle after the date that the Shares have commenced trading 'ex' the relevant dividend on the Exchange." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#FollowingPaymentDate> a owl:Class ;
    rdfs:label "FollowingPaymentDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "The next payment date of the swap." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#RecordDate> a owl:Class ;
    rdfs:label "RecordDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Date on which the dividend will be recorded in the books of the paying agent." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#SharePayment> a owl:Class ;
    rdfs:label "SharePayment" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "If 'Dividend Payment Date(s)' is specified in the Transaction Supplement as 'Share Payment', then the Dividend Payment Date in respect of a Dividend Amount shall fall on a date on or before the date that is two (or any other number that is specified in the Transaction Supplement) Currency Business Days following the day on which the Issuer of the Shares pays the relevant dividend to holders of record of the Shares." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#TerminationDate> a owl:Class ;
    rdfs:label "TerminationDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Termination date of the swap." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#TradeDate> a owl:Class ;
    rdfs:label "TradeDate" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Trade date of the swap" .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#UnwindExDiv> a owl:Class ;
    rdfs:label "UnwindExDiv" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Pays a fraction of the total on each Unwind Trade Settlement Date which occurs after the Dividend Ex Date, until trade is fully unwound." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#UnwindOrEquityExDiv> a owl:Class ;
    rdfs:label "UnwindOrEquityExDiv" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Pays a fraction of the Dividend Amount on each Unwind Trade Settlement Date which occurs after the Dividend Ex Date, until position is fully unwound OR on the next Equity Pay Date after the Dividend Pay Date. This will be whichever date comes first or a combination of both." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#UnwindOrEquityPaid> a owl:Class ;
    rdfs:label "UnwindOrEquityPaid" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Pays a fraction of the Dividend Amount on each Unwind Trade Settlement Date which occurs after the Dividend Pay Date, until position is fully unwound OR on the next Equity Pay Date after the Dividend Pay Date. This will be whichever date comes first or a combination of both." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#UnwindOrInterestExDiv> a owl:Class ;
    rdfs:label "UnwindOrInterestExDiv" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Pays a fraction of the Dividend Amount on each Unwind Trade Settlement Date which occurs after the Dividend Ex Date, until position is fully unwound OR on the next Interest Pay Date after the Dividend Ex Date. This will be whichever date comes first or a combination of both." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#UnwindOrInterestPaid> a owl:Class ;
    rdfs:label "UnwindOrInterestPaid" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Pays a fraction of the Dividend Amount on each Unwind Trade Settlement Date which occurs after the Dividend Pay Date, until position is fully unwound OR on the next Interest Pay Date after the Dividend Pay Date. This will be whichever date comes first or a combination of both." .

<https://w3id.org/lmodel/common-domain-model/DividendDateReferenceEnum#UnwindPaid> a owl:Class ;
    rdfs:label "UnwindPaid" ;
    rdfs:subClassOf common_domain_model:DividendDateReferenceEnum ;
    skos:definition "Pays a fraction of the total on each Unwind Trade Settlement Date which occurs after the Dividend Pay Date, until trade is fully unwound." .

<https://w3id.org/lmodel/common-domain-model/DividendEntitlementEnum#ExDate> a owl:Class ;
    rdfs:label "ExDate" ;
    rdfs:subClassOf common_domain_model:DividendEntitlementEnum ;
    skos:definition "Dividend entitlement is on the dividend ex-date." .

<https://w3id.org/lmodel/common-domain-model/DividendEntitlementEnum#RecordDate> a owl:Class ;
    rdfs:label "RecordDate" ;
    rdfs:subClassOf common_domain_model:DividendEntitlementEnum ;
    skos:definition "Dividend entitlement is on the dividend record date." .

common_domain_model:DividendPeriod a owl:Class ;
    rdfs:label "DividendPeriod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:startDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:dividendPaymentDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:startDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:basketConstituent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dividendValuationDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DividendPaymentDate ;
            owl:onProperty common_domain_model:endDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dividendPaymentDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:endDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:dividendValuationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:endDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DividendPaymentDate ;
            owl:onProperty common_domain_model:dividendPaymentDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DividendPaymentDate ;
            owl:onProperty common_domain_model:startDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dividendValuationDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BasketConstituent ;
