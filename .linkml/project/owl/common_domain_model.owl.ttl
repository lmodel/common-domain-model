common_domain_model:UnderlierSubstitutionProvision a owl:Class ;
    rdfs:label "UnderlierSubstitutionProvision" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:disputingParty ],
        [ a owl:Restriction ;
