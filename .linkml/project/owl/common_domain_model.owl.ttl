common_domain_model:asset a owl:ObjectProperty ;
    rdfs:label "asset" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:Cash common_domain_model:Commodity common_domain_model:DigitalAsset common_domain_model:Instrument ) ] common_domain_model:Asset ) ] ;
    skos:definition "The asset that underlies the position." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:assetCountryOfOrigin a owl:ObjectProperty ;
    rdfs:label "assetCountryOfOrigin" ;
    rdfs:range common_domain_model:ISOCountryCodeEnum ;
