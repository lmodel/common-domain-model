            owl:onProperty common_domain_model:followUpConfirmation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:earliestDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:expirationDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:expirationDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:exerciseTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:initialFee ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:finalCalculationPeriodDateAdjustment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:exerciseNotice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CallingPartyEnum ;
            owl:onProperty common_domain_model:callingParty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:latestCancelationTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:latestCancelationTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:initialFee ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Period ;
            owl:onProperty common_domain_model:effectivePeriod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:callingParty ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenterTime ;
            owl:onProperty common_domain_model:latestCancelationTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:ScheduledTransfer common_domain_model:UnscheduledTransfer ) ] common_domain_model:Transfer ) ] ;
            owl:onProperty common_domain_model:initialFee ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDates ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:exerciseNotice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ExerciseNotice ;
            owl:onProperty common_domain_model:exerciseNotice ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:ExerciseTerms ;
            owl:onProperty common_domain_model:exerciseTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:callingParty ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectivePeriod ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:exerciseTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:followUpConfirmation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:earliestCancellationTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:earliestCancellationTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FinalCalculationPeriodDateAdjustment ;
            owl:onProperty common_domain_model:finalCalculationPeriodDateAdjustment ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdjustableOrRelativeDate ;
            owl:onProperty common_domain_model:earliestDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CancelableProvisionAdjustedDates ;
            owl:onProperty common_domain_model:cancelableProvisionAdjustedDates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectiveDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:expirationDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenterTime ;
            owl:onProperty common_domain_model:earliestCancellationTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:followUpConfirmation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:earliestDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:effectivePeriod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:cancelableProvisionAdjustedDates ],
        common_domain_model:BuyerSeller ;
    skos:closeMatch fpml_5_10:CancelableProvision ;
    skos:definition "A data defining:  the right of a party to cancel a swap transaction on the specified exercise dates. The provision is for 'walk-away' cancellation (i.e. the fair value of the swap is not paid). A fee payable on exercise can be specified. As a difference from the FpML construct, the canonical model extends the BuyerSeller class." ;
    skos:inScheme common_domain_model:cdm_product_template ;
    skos:note "Rosetta condition: CancelableProvisionExerciseNoticeReceiverParty — if exerciseNotice -> exerciseNoticeReceiver exists then exerciseNotice -> exerciseNoticeReceiver = AncillaryRoleEnum -> ExerciseNoticeReceiverPartyCancelableProvision",
        "Rosetta condition: EffectiveDate — optional choice effectiveDate, effectivePeriod" .

common_domain_model:CancelableProvisionAdjustedDates a owl:Class ;
