            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:whoToDetermine ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:whoToDetermine ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:determinationRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DeterminationRoleEnum ;
            owl:onProperty common_domain_model:determinationRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Clause ;
            owl:onProperty common_domain_model:fallbackLanguageBespokeTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:disputingParty ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fallbackLanguageBespokeTerms ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CounterpartyRoleEnum ;
            owl:onProperty common_domain_model:disputingParty ],
