common_domain_model:address a owl:ObjectProperty ;
    rdfs:label "address" ;
    rdfs:range common_domain_model:Address ;
    skos:definition "The street/postal address." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:agreementSet a owl:ObjectProperty ;
    rdfs:label "agreementSet" ;
    rdfs:range common_domain_model:UmbrellaAgreementSet ;
    skos:definition "The language associated with the umbrella agreement, and which applies to all the parties to the umbrella agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:allDirectionRating a owl:ObjectProperty ;
    rdfs:label "allDirectionRating" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllDirectionRating common_domain_model:AnyDirectionRating common_domain_model:DirectionRating ) ] common_domain_model:DirectionRatingSet ) ] ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:anyDirectionRating a owl:ObjectProperty ;
    rdfs:label "anyDirectionRating" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:AllDirectionRating common_domain_model:AnyDirectionRating common_domain_model:DirectionRating ) ] common_domain_model:DirectionRatingSet ) ] ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:applicableParty a owl:ObjectProperty ;
    rdfs:label "applicableParty" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:closeMatch fpml_5_10:AdditionalTerminationEvent.applicableParty ;
    skos:definition "Whether the additional termination event is applicable for the relevant party." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:applicableRegime a owl:ObjectProperty ;
    rdfs:label "applicableRegime" ;
    rdfs:range common_domain_model:ApplicableRegime ;
    skos:definition "A class to specify the regime(s) that parties to a legal agreement, such as the ISDA 2016 and 2018 CSA for Initial Margin, might agree to apply to one or both parties when acting as collateral taker, and specific terms associated with that application." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:appliesTo a owl:ObjectProperty ;
    rdfs:label "appliesTo" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:closeMatch fpml_5_10:CollateralCriteriaBase.appliesTo ;
    skos:definition "Specifies which of the two counterparties the criteria applies to (either one or both counterparties). This attribute is optional, in case the applicable party is already specified elsewhere within a party election." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:approval a owl:ObjectProperty ;
    rdfs:label "approval" ;
    rdfs:range common_domain_model:WorkflowStepApproval ;
    skos:definition "Optional party approvals for the current workflow step. A workflow step can have any number of parties associated to it, thus this object is represented as a list. All parties that are expected to provide approval should have an item in this list that references them." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:assetLeg a owl:ObjectProperty ;
    rdfs:label "assetLeg" ;
    rdfs:range common_domain_model:AssetLeg ;
    skos:closeMatch fpml_5_10:AssetPayout.assetLeg ;
    skos:definition "Defines each asset movement as a buy/sell at different dates, typically 1 near leg and 1 far leg in a securities financing transaction." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:assignedIdentifier a owl:ObjectProperty ;
    rdfs:label "assignedIdentifier" ;
    rdfs:range common_domain_model:AssignedIdentifier ;
    skos:definition "The identifier value. This level of indirection between the issuer and the identifier and its version provides the ability to associate multiple identifiers to one issuer, consistently with the FpML PartyTradeIdentifier." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_identifier .

common_domain_model:attachment a owl:ObjectProperty ;
    rdfs:label "attachment" ;
    rdfs:range common_domain_model:Resource ;
    skos:definition "A human readable document, for example a confirmation." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:availableInventoryRecord a owl:ObjectProperty ;
    rdfs:label "availableInventoryRecord" ;
    rdfs:range common_domain_model:AvailableInventoryRecord ;
    skos:closeMatch fpml_5_10:AvailableInventory.availableInventoryRecord ;
    skos:definition "An array holding the list of inventory being described. Each element in the inventoryRecord array represents an individual piece of inventory i.e. a security." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:averagingObservation a owl:ObjectProperty ;
    rdfs:label "averagingObservation" ;
    rdfs:range common_domain_model:WeightedAveragingObservation ;
    skos:definition "A single weighted averaging observation." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:basketId a owl:DatatypeProperty ;
    rdfs:label "basketId" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:BasketReferenceInformation.basketId ;
    skos:definition "A CDS basket identifier." ;
    skos:inScheme common_domain_model:cdm_product_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:bespokeCoveredTransactions a owl:DatatypeProperty ;
    rdfs:label "bespokeCoveredTransactions" ;
    rdfs:range xsd:string ;
    skos:definition "Covered Transactions when not expressed using the ISDA taxonomy." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:billingRecord a owl:ObjectProperty ;
    rdfs:label "billingRecord" ;
    rdfs:range common_domain_model:BillingRecord ;
    skos:definition "The billing records contained within the invoice" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:billingRecordInstruction a owl:ObjectProperty ;
    rdfs:label "billingRecordInstruction" ;
    rdfs:range common_domain_model:BillingRecordInstruction ;
    skos:closeMatch fpml_5_10:BillingInstruction.billingRecordInstruction ;
    skos:definition "Instructions for creating the billing records contained within the invoice" ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:block a owl:ObjectProperty ;
    rdfs:label "block" ;
    rdfs:range common_domain_model:AssetDeliveryProfileBlock ;
    skos:closeMatch fpml_5_10:AssetDeliveryProfile.block ;
    skos:definition "Defines a delivery profile block, including start and end time, days of the week, duration, delivery capacity and price time interval quantity." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:borrower a owl:ObjectProperty ;
    rdfs:label "borrower" ;
    rdfs:range common_domain_model:LegalEntity ;
    skos:definition "Specifies the borrower. There can be more than one borrower. It is meant to be used in the event that there is no Bloomberg Id or the Secured List isn't applicable." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:branch a owl:DatatypeProperty ;
    rdfs:label "branch" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the specific branch entered into by the relevant party." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:breakdown a owl:ObjectProperty ;
    rdfs:label "breakdown" ;
    rdfs:range common_domain_model:PrimitiveInstruction ;
    skos:definition "Each split breakdown specifies the set of primitive instructions to be applied to a single branch of that split. N split breakdowns result in N output trades, which include the original trade. Instructions for how to handle the original trade (e.g. if it must be closed) must be specified in one of the breakdowns." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:businessUnit a owl:ObjectProperty ;
    rdfs:label "businessUnit" ;
    rdfs:range common_domain_model:BusinessUnit ;
    skos:definition "Optional organization unit information used to describe the organization units (e.g. trading desks) involved in a transaction or business process, incl. the contact information (when relevant)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:cancellationEvent a owl:ObjectProperty ;
    rdfs:label "cancellationEvent" ;
    rdfs:range common_domain_model:CancellationEvent ;
    skos:definition "The adjusted dates for an individual cancellation date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:cashSettlementTerms a owl:ObjectProperty ;
    rdfs:label "cashSettlementTerms" ;
    rdfs:range common_domain_model:CashSettlementTerms ;
    skos:definition "Specifies the parameters associated with the cash settlement procedure." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:change a owl:ObjectProperty ;
    rdfs:label "change" ;
    rdfs:range common_domain_model:PriceQuantity ;
    skos:definition "Quantity by which the trade is being increased, decreased or replaced, and the price at which such quantity change is agreed. The quantity change should always be specified as a positive number, with the direction (increase/decrease/replacement) being specified by the direction enumeration. A fee can also be associated to the quantity change by specifying a Price component of type CashPrice, including the corresponding settlement date and direction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:classification a owl:ObjectProperty ;
    rdfs:label "classification" ;
    rdfs:range common_domain_model:TaxonomyClassification ;
    skos:definition "Specifies the taxonomy value as a set of class names and values for each class." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:clause a owl:ObjectProperty ;
    rdfs:label "clause" ;
    rdfs:range common_domain_model:MasterAgreementClause ;
    skos:definition "Clauses that have had elections made against them in this Master Agreement. There must be at least one clause defined in the agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master .

common_domain_model:codes a owl:ObjectProperty ;
    rdfs:label "codes" ;
    rdfs:range common_domain_model:CodeValue ;
    skos:closeMatch fpml_5_10:CodeList.codes ;
    skos:definition "Code values" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_codelist .

common_domain_model:collateralBalance a owl:ObjectProperty ;
    rdfs:label "collateralBalance" ;
    rdfs:range common_domain_model:CollateralBalance ;
    skos:closeMatch fpml_5_10:CollateralPortfolio.collateralBalance ;
    skos:definition "Represents the populated or calculated collateral aggregate balance amount for the collateral portfolio." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:collateralPosition a owl:ObjectProperty ;
    rdfs:label "collateralPosition" ;
    rdfs:range common_domain_model:CollateralPosition ;
    skos:closeMatch fpml_5_10:CollateralPortfolio.collateralPosition ;
    skos:definition "Specifies the individual components of the collateral positions in the collateral portfolio." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:collateralPositionComponent a owl:ObjectProperty ;
    rdfs:label "collateralPositionComponent" ;
    rdfs:range common_domain_model:CollateralPosition ;
    skos:definition "Specifies the collateral to be moved and its direction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:commodityBusinessCalendar a owl:ObjectProperty ;
    rdfs:label "commodityBusinessCalendar" ;
    rdfs:range common_domain_model:CommodityBusinessCalendarEnum ;
    skos:closeMatch fpml_5_10:BusinessCenters.commodityBusinessCalendar ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    common_domain_model:metadata_scheme true .

common_domain_model:commodityGrade a owl:ObjectProperty ;
    rdfs:label "commodityGrade" ;
    rdfs:range common_domain_model:ProductGradeEnum ;
    skos:closeMatch fpml_5_10:AssetDeliveryInformation.commodityGrade ;
    skos:definition "Grade of product being delivered (e.g., grade of oil)." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:componentId a owl:ObjectProperty ;
    rdfs:label "componentId" ;
    rdfs:range common_domain_model:Identifier ;
    skos:definition "Identifiers for each component of the list. Since the data type is used to link multiple identified objects together, at least 2 components are required in the list. Creating an identified list with only 1 identified component has been deemed unnecessary, because it would just create a redundant identifier." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_identifier .

common_domain_model:compoundedGrowth a owl:DatatypeProperty ;
    rdfs:label "compoundedGrowth" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculatedRateDetails.compoundedGrowth ;
    skos:definition "The compounding curve, showing how the initial value grew during the calculation period." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:concentrationLimit a owl:ObjectProperty ;
    rdfs:label "concentrationLimit" ;
    rdfs:range common_domain_model:ConcentrationLimit ;
    skos:closeMatch fpml_5_10:CollateralTreatment.concentrationLimit ;
    skos:definition "Specification of concentration limits applicable to the collateral criteria." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:contractualDefinitionsType a owl:ObjectProperty ;
    rdfs:label "contractualDefinitionsType" ;
    rdfs:range common_domain_model:ContractualDefinitionsEnum ;
    skos:closeMatch fpml_5_10:AgreementName.contractualDefinitionsType ;
    skos:definition "The definitions such as those published by ISDA that will define the terms of the trade." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:contractualMatrix a owl:ObjectProperty ;
    rdfs:label "contractualMatrix" ;
    rdfs:range common_domain_model:ContractualMatrix ;
    skos:closeMatch fpml_5_10:AgreementName.contractualMatrix ;
    skos:definition "A reference to a contractual matrix of elected terms/values (such as those published by ISDA) that shall be deemed to apply to the trade. The applicable matrix is identified by reference to a name and optionally a publication date. Depending on the structure of the matrix, an additional term (specified in the matrixTerm element) may be required to further identify a subset of applicable terms/values within the matrix." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:contractualParty a owl:ObjectProperty ;
    rdfs:label "contractualParty" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "The two contractual parties to the legal agreement, which reference information is positioned as part of the partyInformation attribute." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common ;
    common_domain_model:metadata_reference true .

common_domain_model:contractualTermsSupplement a owl:ObjectProperty ;
    rdfs:label "contractualTermsSupplement" ;
    rdfs:range common_domain_model:ContractualTermsSupplement ;
    skos:closeMatch fpml_5_10:AgreementName.contractualTermsSupplement ;
    skos:definition "A contractual supplement (such as those published by ISDA) that will apply to the trade." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:controlAgreementNecEventElection a owl:ObjectProperty ;
    rdfs:label "controlAgreementNecEventElection" ;
    rdfs:range common_domain_model:ControlAgreementNecEventElection ;
    skos:definition "Indicates party specific Control Agreement language related to delivery of a Notice of Exclusive Control." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:copyTo a owl:DatatypeProperty ;
    rdfs:label "copyTo" ;
    rdfs:range xsd:string ;
    skos:definition "A unique identifier (within the specified coding scheme) giving the details of some party to whom a copy of this message will be sent for reference." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    common_domain_model:metadata_scheme true .

common_domain_model:creditSupportDocumentElection a owl:ObjectProperty ;
    rdfs:label "creditSupportDocumentElection" ;
    rdfs:range common_domain_model:CreditSupportDocumentElection ;
    skos:definition "The party election of Credit Support Document(s), if any." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:creditSupportDocumentTypes a owl:ObjectProperty ;
    rdfs:label "creditSupportDocumentTypes" ;
    rdfs:range common_domain_model:LegalAgreementIdentification ;
    skos:definition "If a Credit Support Document is specified but not yet in CDM representation, it can still be captured. This argument should be used if the creditSupportDocument argument cannot be used due to not being able to represent the document fully in CDM format." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:creditSupportProviderElection a owl:ObjectProperty ;
    rdfs:label "creditSupportProviderElection" ;
    rdfs:range common_domain_model:CreditSupportProviderElection ;
    skos:definition "The party election of Credit Support Provider(s), if any." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:customisedWorkflow a owl:ObjectProperty ;
    rdfs:label "customisedWorkflow" ;
    rdfs:range common_domain_model:CustomisedWorkflow ;
    skos:definition "Non-standardized data in a generic form." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:debtEconomics a owl:ObjectProperty ;
    rdfs:label "debtEconomics" ;
    rdfs:range common_domain_model:DebtEconomics ;
    skos:definition "Specifies selected financial terms of a debt security." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:dividendPayoutRatio a owl:ObjectProperty ;
    rdfs:label "dividendPayoutRatio" ;
    rdfs:range common_domain_model:DividendPayoutRatio ;
    skos:definition "Specifies the dividend payout ratio associated with each underlier. In FpML 5.10 the payout is positioned at the underlier level, although there is an intent to reconsider this approach and position it at the leg level. This is approach adopted by the CDM." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:dividendPeriod a owl:ObjectProperty ;
    rdfs:label "dividendPeriod" ;
    rdfs:range common_domain_model:DividendPeriod ;
    skos:definition "One to many time bounded dividend payment periods, each with a dividend payment date per period." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:documentIdentifier a owl:ObjectProperty ;
    rdfs:label "documentIdentifier" ;
    rdfs:range common_domain_model:Identifier ;
    skos:definition "While FpML specifies the document identifier with a value and an associated scheme, the CDM makes use of the Identifier, which has an explicit issuer. The issuer of this identifier is not necessarily the same as the party reference." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    common_domain_model:metadata_scheme true .

common_domain_model:documentation a owl:ObjectProperty ;
    rdfs:label "documentation" ;
    rdfs:range common_domain_model:LegalAgreement ;
    skos:definition "Represents the legal document(s) that governs a trade and associated contractual product terms, either as a reference to such documents when specified as part of the CDM, or through identification of some of the key terms of those documents, such as the type of document, the document identifier, the publisher, the document vintage and the agreement date." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:earlyTerminationEvent a owl:ObjectProperty ;
    rdfs:label "earlyTerminationEvent" ;
    rdfs:range common_domain_model:EarlyTerminationEvent ;
    skos:definition "The adjusted dates associated with an individual early termination date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:eligibleCountry a owl:DatatypeProperty ;
    rdfs:label "eligibleCountry" ;
    rdfs:range xsd:string ;
    skos:definition "The restrictions that might be required by a party and its custodian in terms of country(ies) where the other party's collateral can be held." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    common_domain_model:metadata_scheme true .

common_domain_model:eligibleCurrency a owl:ObjectProperty ;
    rdfs:label "eligibleCurrency" ;
    rdfs:range common_domain_model:ISOCurrencyCodeEnum ;
    skos:closeMatch fpml_5_10:BaseAndEligibleCurrency.eligibleCurrency ;
    skos:definition "A definition of a currency agreed by the parties, typically to indicate the currencies of eligible cash collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:range xsd:string ;
    skos:definition "The email address." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:entityIdentifier a owl:ObjectProperty ;
    rdfs:label "entityIdentifier" ;
    rdfs:range common_domain_model:EntityIdentifier ;
    skos:definition "A legal entity identifier with a source (e.g. RED entity code)." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:eu_EMIR_EligibleCollateral a owl:ObjectProperty ;
    rdfs:label "eu_EMIR_EligibleCollateral" ;
    rdfs:range common_domain_model:EUEMIREligibleCollateralEnum ;
    skos:closeMatch fpml_5_10:CollateralTaxonomyValue.eu_EMIR_EligibleCollateral ;
    skos:definition "Identifies European Union Eligible Collateral Assets classification categories based on EMIR Uncleared Margin Rules. Eligible Collateral asset classes for both initial margin (IM) and variation margin (VM) posted and collected between specified entities. Please note: EMIR regulation will detail which eligible collateral assets classes apply to each type of entity pairing (counterparty) and which apply to posting of IM and VM" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:eventCurrencyBuyerSeller a owl:ObjectProperty ;
    rdfs:label "eventCurrencyBuyerSeller" ;
    rdfs:range common_domain_model:BuyerSeller ;
    skos:definition "Unless otherwised specified, the Buyer is the party to which the Event Currency Amount is owed on the Settlement Date and the Seller is the party which owes the Event Currency Amount on the Settlement Date." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:eventIdentifier a owl:ObjectProperty ;
    rdfs:label "eventIdentifier" ;
    rdfs:range common_domain_model:Identifier ;
    skos:definition "The identifier(s) that uniquely identify a lifecycle event. The unbounded cardinality is meant to provide the ability to associate identifiers that are issued by distinct parties. As an example, each of the parties to the event may choose to associate their own identifiers to the event." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:eventReference a owl:ObjectProperty ;
    rdfs:label "eventReference" ;
    rdfs:range common_domain_model:WorkflowStep ;
    skos:definition "The reference to the instantiation of an Event object, either through a globalKey or an xml-derived id/href mechanism. The definition associated to the Lineage class provides more details with respect to those referencing approaches, their expected usage and available implementation." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:excludedProducts a owl:ObjectProperty ;
    rdfs:label "excludedProducts" ;
    rdfs:range common_domain_model:ExcludedProducts ;
    skos:definition "Description of the relevant derivative transactions excluded from the calculation of exposure." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:excludedReferenceEntity a owl:ObjectProperty ;
    rdfs:label "excludedReferenceEntity" ;
    rdfs:range common_domain_model:ReferenceInformation ;
    skos:definition "Excluded reference entity." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:extensionEvent a owl:ObjectProperty ;
    rdfs:label "extensionEvent" ;
    rdfs:range common_domain_model:ExtensionEvent ;
    skos:definition "The adjusted dates associated with a single extendible exercise date." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:fallBackSettlementRateOption a owl:ObjectProperty ;
    rdfs:label "fallBackSettlementRateOption" ;
    rdfs:range common_domain_model:SettlementRateOptionEnum ;
    skos:definition "This settlement rate option will be used in its place." ;
    skos:inScheme common_domain_model:cdm_observable_asset ;
    common_domain_model:metadata_scheme true .

common_domain_model:finalCalculationPeriodDateAdjustment a owl:ObjectProperty ;
    rdfs:label "finalCalculationPeriodDateAdjustment" ;
    rdfs:range common_domain_model:FinalCalculationPeriodDateAdjustment ;
    skos:closeMatch fpml_5_10:CancelableProvision.finalCalculationPeriodDateAdjustment ;
    skos:definition "Business date convention adjustment to final payment period per leg (swapStream) upon exercise event. The adjustments can be made in-line with leg level BDC's or they can be specified separately." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:fixing a owl:ObjectProperty ;
    rdfs:label "fixing" ;
    rdfs:range common_domain_model:FloatingRateIndexFixingDetails ;
    skos:definition "The default fixing details." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:fxRate a owl:ObjectProperty ;
    rdfs:label "fxRate" ;
    rdfs:range common_domain_model:FxRate ;
    skos:definition "Specifies a currency conversion rate." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:growthFactor a owl:DatatypeProperty ;
    rdfs:label "growthFactor" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculatedRateDetails.growthFactor ;
    skos:definition "The daily growth factors, showing the weighted rates divided by the day count basis plus one, giving how much the value grows for each step in the calculation." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:index_ a owl:ObjectProperty ;
    rdfs:label "index_" ;
    rdfs:range common_domain_model:FloatingRateIndexEnum ;
    skos:definition " The FRO name that is being mapped to/from." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:initial a owl:DatatypeProperty ;
    rdfs:label "initial" ;
    rdfs:range xsd:string ;
    skos:definition "The natural person's middle initial(s). If a middle initial is provided then a name should be absent." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:instruction a owl:ObjectProperty ;
    rdfs:label "instruction" ;
    rdfs:range common_domain_model:Instruction ;
    skos:definition "Specifies the instructions to create the Business Event." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:interestParameters a owl:ObjectProperty ;
    rdfs:label "interestParameters" ;
    rdfs:range common_domain_model:CollateralInterestParameters ;
    skos:definition "Represents the interest parameters for the various currencies, margin types, posting parties." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:interimPaymentDates a owl:ObjectProperty ;
    rdfs:label "interimPaymentDates" ;
    rdfs:range common_domain_model:AdjustableRelativeOrPeriodicDates ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:inventoryRecord a owl:ObjectProperty ;
    rdfs:label "inventoryRecord" ;
    rdfs:range common_domain_model:InventoryRecord ;
    skos:definition "An array holding the list of inventory being described. Each element in the inventoryRecord array represents an individual piece of inventory i.e. a security." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:knockIn a owl:ObjectProperty ;
    rdfs:label "knockIn" ;
    rdfs:range common_domain_model:TriggerEvent ;
    skos:closeMatch fpml_5_10:Barrier.knockIn ;
    skos:definition "The option only becomes active when a predetermined trigger level is breached." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:knockOut a owl:ObjectProperty ;
    rdfs:label "knockOut" ;
    rdfs:range common_domain_model:TriggerEvent ;
    skos:closeMatch fpml_5_10:Barrier.knockOut ;
    skos:definition "The option becomes null and void when a predetermined trigger level is breached." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:level a owl:ObjectProperty ;
    rdfs:label "level" ;
    rdfs:range common_domain_model:PriceSchedule ;
    skos:definition "The trigger level." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:limitApplicable a owl:ObjectProperty ;
    rdfs:label "limitApplicable" ;
    rdfs:range common_domain_model:LimitApplicableExtended ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:majorCurrency a owl:DatatypeProperty ;
    rdfs:label "majorCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "The additional currencies that are specified as Major Currency for the purpose of applying the FX Haircut Percentage." ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"13\" clause \"(c)(v)(B)\" name \"FX Haircut Percentage\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    common_domain_model:metadata_scheme true .

common_domain_model:mapsFrom a owl:ObjectProperty ;
    rdfs:label "mapsFrom" ;
    rdfs:range common_domain_model:FloatingRateIndexMap ;
    skos:definition "The predecessor FRO(s) that this index maps to." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:marginCallResponseAction a owl:ObjectProperty ;
    rdfs:label "marginCallResponseAction" ;
    rdfs:range common_domain_model:MarginCallResponseAction ;
    skos:definition "Specifies the margin call action details, including collateral to be moved and direction." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:matchingEligibleCriteria a owl:ObjectProperty ;
    rdfs:label "matchingEligibleCriteria" ;
    rdfs:range common_domain_model:EligibleCollateralCriteria ;
    skos:definition "if there was a match, this will be the one or more criteria that were supplied in the EligbilityCollateralSpecification which matched with the query input" ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:middleName a owl:DatatypeProperty ;
    rdfs:label "middleName" ;
    rdfs:range xsd:string ;
    skos:definition "The natural person's middle name(s). If a middle name is provided then an initial should be absent." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:naturalPerson a owl:ObjectProperty ;
    rdfs:label "naturalPerson" ;
    rdfs:range common_domain_model:NaturalPerson ;
    skos:definition "Optional information about people involved in a transaction or business process." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:nonEnumeratedTaxonomyValue a owl:DatatypeProperty ;
    rdfs:label "nonEnumeratedTaxonomyValue" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CollateralTaxonomyValue.nonEnumeratedTaxonomyValue ;
    skos:definition "Identifies the taxonomy value when not specified as an enumeration." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:notifyingParty a owl:ObjectProperty ;
    rdfs:label "notifyingParty" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "The notifying party is the party that notifies the other party when a credit event has occurred by means of a credit event notice. If more than one party is referenced as being the notifying party then either party may notify the other of a credit event occurring. ISDA 2003 Term: Notifying Party." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:observedRates a owl:DatatypeProperty ;
    rdfs:label "observedRates" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculatedRateObservations.observedRates ;
    skos:definition "The value observed for that date" ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:parties a owl:ObjectProperty ;
    rdfs:label "parties" ;
    rdfs:range common_domain_model:Party ;
    skos:definition "Defines all parties to that execution, including agents and brokers." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:partyCustomisedWorkflow a owl:ObjectProperty ;
    rdfs:label "partyCustomisedWorkflow" ;
    rdfs:range common_domain_model:PartyCustomisedWorkflow ;
    skos:definition "Workflow data that is specific to certain market participants and is expressed as part of the CDM in a very generic manner, which can be party-specific. The initial use cases have been derived from the CME clearing and the DTCC TIW submissions." ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:partyId a owl:ObjectProperty ;
    rdfs:label "partyId" ;
    rdfs:range common_domain_model:PartyIdentifier ;
    skos:definition "The identifier associated with a party, e.g. the 20 digits LEI code." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:partyRoles a owl:ObjectProperty ;
    rdfs:label "partyRoles" ;
    rdfs:range common_domain_model:PartyRole ;
    skos:definition "Defines the role(s) that party(ies) may have in relation to the execution." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:passThroughItem a owl:ObjectProperty ;
    rdfs:label "passThroughItem" ;
    rdfs:range common_domain_model:PassThroughItem ;
    skos:definition "One to many pass through payment items." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:paymentBusinessCenter a owl:DatatypeProperty ;
    rdfs:label "paymentBusinessCenter" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CollateralInterestHandlingParameters.paymentBusinessCenter ;
    skos:definition "Specifies applicable business centers for payments." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:paymentCalculationPeriod a owl:ObjectProperty ;
    rdfs:label "paymentCalculationPeriod" ;
    rdfs:range common_domain_model:PaymentCalculationPeriod ;
    skos:closeMatch fpml_5_10:CashflowRepresentation.paymentCalculationPeriod ;
    skos:definition "The adjusted payment date and associated calculation period parameters required to calculate the actual or projected payment amount. A list of payment calculation period elements may be ordered in the document by ascending adjusted payment date. An FpML document containing an unordered list of payment calculation periods is still regarded as a conformant document." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:paymentDatesReference a owl:ObjectProperty ;
    rdfs:label "paymentDatesReference" ;
    rdfs:range common_domain_model:PaymentDates ;
    skos:definition "A set of href pointers to payment dates defined somewhere else in the document." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    common_domain_model:metadata_reference true .

common_domain_model:paymentDetail a owl:ObjectProperty ;
    rdfs:label "paymentDetail" ;
    rdfs:range common_domain_model:PaymentDetail ;
    skos:definition "An attribute that specifies a payment as the combination of a payment amount, a payment date and an associated payment calculation rule." ;
    skos:inScheme common_domain_model:cdm_product_collateral .

common_domain_model:person a owl:ObjectProperty ;
    rdfs:label "person" ;
    rdfs:range common_domain_model:NaturalPerson ;
    skos:definition "The person(s) who might be associated with the party as part of the execution, contract or legal document." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:personId a owl:ObjectProperty ;
    rdfs:label "personId" ;
    rdfs:range common_domain_model:PersonIdentifier ;
    skos:definition "The identifier associated with a person, e.g. the internal identification code." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party ;
    common_domain_model:metadata_scheme true .

common_domain_model:personRole a owl:ObjectProperty ;
    rdfs:label "personRole" ;
    rdfs:range common_domain_model:NaturalPersonRole ;
    skos:definition "The role of the person(s) " ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:portfolioReturnTerms a owl:ObjectProperty ;
    rdfs:label "portfolioReturnTerms" ;
    rdfs:range common_domain_model:PortfolioReturnTerms ;
    skos:definition "Specifies an individual type of return of a Performance Payout, when such individual return is part of an aggregation of multiple similar returns, at Performance Payout level" ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:portfolioStateReference a owl:ObjectProperty ;
    rdfs:label "portfolioStateReference" ;
    rdfs:range common_domain_model:PortfolioState ;
    skos:definition "The reference to the previous state of a Portfolio, in a chain of Events leading up to a build of that Portfolio as the holding of Product(s) in specific Quantity(ies). As part of the PortfolioState object, a pointer to the previous PortfolioState is provided through a Lineage object, together with pointer(s) to the Event or set of Events leading up to the current (new) state." ;
    skos:inScheme common_domain_model:cdm_event_common ;
    common_domain_model:metadata_reference true .

common_domain_model:positionIdentifier a owl:ObjectProperty ;
    rdfs:label "positionIdentifier" ;
    rdfs:range common_domain_model:PositionIdentifier ;
    skos:definition "Represents the identifier(s) that uniquely identify a position for an identity issuer. A position can include multiple identifiers, for example an internal position identifer and a UTI (Unique Trade Identifier)." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:positions a owl:ObjectProperty ;
    rdfs:label "positions" ;
    rdfs:range common_domain_model:Position ;
    skos:definition "The list of positions, each containing a Quantity and a Product." ;
    skos:inScheme common_domain_model:cdm_event_position .

common_domain_model:priceSchedule a owl:ObjectProperty ;
    rdfs:label "priceSchedule" ;
    rdfs:range common_domain_model:PriceSchedule ;
    skos:definition "A payout's price specified as a schedule, which may also contain a single value if that price is constant. There may be multiple prices specified for a single payout: e.g. a floating interest rate leg may specify a spread, a cap and/or floor and a multiplier. The price must be specified outside of the payout in a PriceQuantity object and only referenced inside the payout using an address." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:processedRates a owl:DatatypeProperty ;
    rdfs:label "processedRates" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculatedRateObservations.processedRates ;
    skos:definition "The value after any processing, such as application of caps or floors." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:profile a owl:ObjectProperty ;
    rdfs:label "profile" ;
    rdfs:range common_domain_model:AssetDeliveryProfile ;
    skos:closeMatch fpml_5_10:AssetDeliveryPeriods.profile ;
    skos:definition "Defines the delivery profile of the asset, including the load type and the delivery intervals." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:protectedParty a owl:ObjectProperty ;
    rdfs:label "protectedParty" ;
    rdfs:range common_domain_model:PartyDeterminationEnum ;
    skos:closeMatch fpml_5_10:CashCollateralValuationMethod.protectedParty ;
    skos:definition "This may be used to specify which party is protected (e.g. under Replacement Value cash settlement methods)." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:protectionTerms a owl:ObjectProperty ;
    rdfs:label "protectionTerms" ;
    rdfs:range common_domain_model:ProtectionTerms ;
    skos:definition "Specifies the terms for calculating a payout to protect the buyer of the swap in the case of a qualified credit event. These terms include the applicable credit events, the reference obligation, and in the case of a CDS on mortgage-backed securities, the floatingAmountEvents." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:publicSource a owl:DatatypeProperty ;
    rdfs:label "publicSource" ;
    rdfs:range xsd:string ;
    skos:definition "A public information source, e.g. a particular newspaper or electronic news service, that may publish relevant information used in the determination of whether or not a credit event has occurred. ISDA 2003 Term: Public Source." ;
    skos:inScheme common_domain_model:cdm_observable_event .

common_domain_model:rateObservation a owl:ObjectProperty ;
    rdfs:label "rateObservation" ;
    rdfs:range common_domain_model:RateObservation ;
    skos:definition "The details of a particular rate observation, including the fixing date and observed rate. A list of rate observation elements may be ordered in the document by ascending adjusted fixing date. An FpML document containing an unordered list of rate observations is still regarded as a conformant document." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:recallNonCashCollateralDescription a owl:ObjectProperty ;
    rdfs:label "recallNonCashCollateralDescription" ;
    rdfs:range common_domain_model:EligibleCollateralCriteria ;
    skos:definition "Specifies the details to describe or identify non-cash collateral eligible assets for recall purposes." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:referenceBank a owl:ObjectProperty ;
    rdfs:label "referenceBank" ;
    rdfs:range common_domain_model:ReferenceBank ;
    skos:definition "An institution (party) identified by means of a coding scheme and an optional name." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:referencePoolItem a owl:ObjectProperty ;
    rdfs:label "referencePoolItem" ;
    rdfs:range common_domain_model:ReferencePoolItem ;
    skos:definition "This type contains all the constituent weight and reference information." ;
    skos:inScheme common_domain_model:cdm_product_asset .

common_domain_model:relatedAgreements a owl:ObjectProperty ;
    rdfs:label "relatedAgreements" ;
    rdfs:range common_domain_model:LegalAgreement ;
    skos:definition "Specifies the agreement(s) that govern the agreement, either as a reference to such agreements when specified as part of the CDM, or through identification of some of the key terms of those agreements, such as the type of agreement, the publisher, the vintage, the agreement identifier and the agreement date." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:relevantAffiliate a owl:ObjectProperty ;
    rdfs:label "relevantAffiliate" ;
    rdfs:range common_domain_model:AncillaryEntity ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:replacementTradeIdentifier a owl:ObjectProperty ;
    rdfs:label "replacementTradeIdentifier" ;
    rdfs:range common_domain_model:TradeIdentifier ;
    skos:definition "Specifies the trade identifier to apply to the replacement trade for physical exercise." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:resetHistory a owl:ObjectProperty ;
    rdfs:label "resetHistory" ;
    rdfs:range common_domain_model:Reset ;
    skos:definition "Represents the updated Trade attributes which can change as the result of a reset event. Only the changed values are captured, leaving the remaining data attributes empty. See Create_Reset function for further details on how TradeState is used in the Reset event. The TradeState data type is used to maintain backwards compatibility with the current Reset mechanism." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:resets a owl:ObjectProperty ;
    rdfs:label "resets" ;
    rdfs:range common_domain_model:Reset ;
    skos:closeMatch fpml_5_10:CalculateTransferInstruction.resets ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:schedulePeriod a owl:ObjectProperty ;
    rdfs:label "schedulePeriod" ;
    rdfs:range common_domain_model:SchedulePeriod ;
    skos:definition "Defines a period of a calculation schedule structure." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:secondaryAssetClass a owl:ObjectProperty ;
    rdfs:label "secondaryAssetClass" ;
    rdfs:range common_domain_model:AssetClassEnum ;
    skos:definition " Classifies additional risk classes of the trade, if any." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    common_domain_model:metadata_scheme true .

common_domain_model:sector a owl:DatatypeProperty ;
    rdfs:label "sector" ;
    rdfs:range xsd:string ;
    skos:definition "Represents a filter based on an industry sector defined under a system for classifying industry types such as Global Industry Classification Standard (GICS) and North American Industry Classification System (NAICS)" ;
    skos:inScheme common_domain_model:cdm_product_collateral ;
    common_domain_model:metadata_scheme true .

common_domain_model:securedPartyRightsEventElection a owl:ObjectProperty ;
    rdfs:label "securedPartyRightsEventElection" ;
    rdfs:range common_domain_model:SecuredPartyRightsEventElection ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:securityProvider a owl:ObjectProperty ;
    rdfs:label "securityProvider" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "The security provider party(ies) to which the posting obligations apply to, which can be either one of the parties to the legal agreement, or both of those." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:sentTo a owl:DatatypeProperty ;
    rdfs:label "sentTo" ;
    rdfs:range xsd:string ;
    skos:definition "The identifier(s) for the recipient(s) of a message instance." ;
    skos:inScheme common_domain_model:cdm_event_workflow ;
    common_domain_model:metadata_scheme true .

common_domain_model:shapeSchedule a owl:ObjectProperty ;
    rdfs:label "shapeSchedule" ;
    rdfs:range common_domain_model:Money ;
    skos:definition "Defines applicable settlement limits in each currency." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:specifiedAdditionalTerminationEvent a owl:DatatypeProperty ;
    rdfs:label "specifiedAdditionalTerminationEvent" ;
    rdfs:range xsd:string ;
    skos:definition "Specifies any bespoke Additional Termination Event(s) that are set out in the related Specified Condition clause." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:specifiedDates a owl:ObjectProperty ;
    rdfs:label "specifiedDates" ;
    rdfs:range common_domain_model:AdjustableDates ;
    skos:definition "Defines specified dates on which the price will be determined." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:specifiedEntities a owl:ObjectProperty ;
    rdfs:label "specifiedEntities" ;
    rdfs:range common_domain_model:SpecifiedEntities ;
    skos:definition "A provision that allows each party to specify its Specified Entities for certain Events of Default and Termination Events." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master_isda .

common_domain_model:specifiedOrAccessCondition a owl:ObjectProperty ;
    rdfs:label "specifiedOrAccessCondition" ;
    rdfs:range common_domain_model:CSASpecifiedOrAccessConditionEnum ;
    skos:definition "Specifies events that may temporarily or permanently suspend a partys rights to rehypothecate, transfer, or substitute collateral." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:specifiedParty a owl:ObjectProperty ;
    rdfs:label "specifiedParty" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "Identifies a party designated in the agreement for the purpose of applying particular rights, obligations, or elections." ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"13\" clause \"(c)(iii)\" name \"Legally Ineligible Credit Support (VM)\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:steps a owl:ObjectProperty ;
    rdfs:label "steps" ;
    rdfs:range common_domain_model:WorkflowStep ;
    skos:inScheme common_domain_model:cdm_event_workflow .

common_domain_model:street a owl:DatatypeProperty ;
    rdfs:label "street" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Address.street ;
    skos:definition "The set of street and building number information that identifies a postal address within a city." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:stubPeriodType a owl:ObjectProperty ;
    rdfs:label "stubPeriodType" ;
    rdfs:range common_domain_model:StubPeriodTypeEnum ;
    skos:closeMatch fpml_5_10:CalculationPeriodDates.stubPeriodType ;
    skos:definition "Method to allocate any irregular period remaining after regular periods have been allocated between the effective and termination date. The multiplicity of 2 allows the possibility of expressing the type for both an initial and final stub at the same time." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule .

common_domain_model:subcomponents a owl:ObjectProperty ;
    rdfs:label "subcomponents" ;
    rdfs:range common_domain_model:Clause ;
    skos:closeMatch fpml_5_10:Clause.subcomponents ;
    skos:definition "Additional hierarchical components of the clause if relevant." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:substitutionBeSpokeTerms a owl:ObjectProperty ;
    rdfs:label "substitutionBeSpokeTerms" ;
    rdfs:range common_domain_model:Clause ;
    skos:definition "Where parties describe any substitution terms e.g. for instance the election criteria for an Asset to be eligible as the Substitute Asset to the prior Affected Asset in terms of sector of activity, currency, market capitalisation, liquidity, volatility, or any additional features that parties would agree to take into considerations, etc." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:substitutionTriggerEvents a owl:ObjectProperty ;
    rdfs:label "substitutionTriggerEvents" ;
    rdfs:range common_domain_model:ExtraordinaryEvents ;
    skos:definition "Where the parties may optionnally explictly specify the list of Events to be considered as a trigger for a Substitution." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:supportedDefinition a owl:ObjectProperty ;
    rdfs:label "supportedDefinition" ;
    rdfs:range common_domain_model:ContractualDefinition ;
    skos:definition "The definition version or versions supported by the FRO." ;
    skos:inScheme common_domain_model:cdm_observable_asset_fro .

common_domain_model:telephone a owl:ObjectProperty ;
    rdfs:label "telephone" ;
    rdfs:range common_domain_model:TelephoneNumber ;
    skos:definition "The telephone number." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:tradeId a owl:ObjectProperty ;
    rdfs:label "tradeId" ;
    rdfs:range common_domain_model:TradeIdentifier ;
    skos:definition "The identifier to be assigned to the new trade post change of party." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:tradeInfo a owl:ObjectProperty ;
    rdfs:label "tradeInfo" ;
    rdfs:range common_domain_model:StandardizedScheduleTradeInfo ;
    skos:inScheme common_domain_model:cdm_margin_schedule .

common_domain_model:tradeLot a owl:ObjectProperty ;
    rdfs:label "tradeLot" ;
    rdfs:range common_domain_model:TradeLot ;
    skos:definition "Specifies the price, quantity and effective date of each trade lot, when the same product may be traded multiple times in different lots with the same counterparty. In a trade increase, a new trade lot is added to the list, with the corresponding effective date. In a trade decrease, the existing trade lot(s) are decreased of the corresponding quantity (and an unwind fee may have to be settled). The multiple cardinality and the ability to increase existing trades is used for Equity Swaps in particular." ;
    skos:inScheme common_domain_model:cdm_product_template .

common_domain_model:transferHistory a owl:ObjectProperty ;
    rdfs:label "transferHistory" ;
    rdfs:range common_domain_model:TransferState ;
    skos:definition "Represents the updated Trade attributes which can change as the result of a transfer event." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:transferState a owl:ObjectProperty ;
    rdfs:label "transferState" ;
    rdfs:range common_domain_model:TransferState ;
    skos:definition "Specifies the terms and state of a transfers." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:uk_EMIR_EligibleCollateral a owl:ObjectProperty ;
    rdfs:label "uk_EMIR_EligibleCollateral" ;
    rdfs:range common_domain_model:UKEMIREligibleCollateralEnum ;
    skos:closeMatch fpml_5_10:CollateralTaxonomyValue.uk_EMIR_EligibleCollateral ;
    skos:definition "Identifies United Kingdom Eligible Collateral Assets classification categories based on UK Onshored EMIR Uncleared Margin Rules Eligible Collateral asset classes for both initial margin (IM) and variation margin (VM) posted and collected between specified entities. Please note: UK EMIR regulation will detail which eligible collateral assets classes apply to each type of entity pairing (counterparty) and which apply to posting of IM and VM." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:us_CFTC_PR_EligibleCollateral a owl:ObjectProperty ;
    rdfs:label "us_CFTC_PR_EligibleCollateral" ;
    rdfs:range common_domain_model:USCFTCPREligibleCollateralEnum ;
    skos:closeMatch fpml_5_10:CollateralTaxonomyValue.us_CFTC_PR_EligibleCollateral ;
    skos:definition "Identifies US Eligible Collateral Assets classification categories based on Uncleared Margin Rules published by the CFTC and the US Prudential Regulator. Note: While the same basic categories exist in the CFTC and US Prudential Regulators’ margin rules, the precise definitions or application of those rules could differ between the two rules." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:valuationDatesReference a owl:ObjectProperty ;
    rdfs:label "valuationDatesReference" ;
    rdfs:range common_domain_model:PerformanceValuationDates ;
    skos:definition "A set of href pointers to valuation period dates defined somewhere else in the document." ;
    skos:inScheme common_domain_model:cdm_product_common_schedule ;
    common_domain_model:metadata_reference true .

common_domain_model:variant a owl:ObjectProperty ;
    rdfs:label "variant" ;
    rdfs:range common_domain_model:MasterAgreementClauseVariant ;
    skos:definition "Allows multiple variants to be defined for a clause. This needs to be an array as some clauses can specify different variants for different parties. At least one variant must be specified for a clause." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_master .

common_domain_model:varyingLegNotionalCurrency a owl:DatatypeProperty ;
    rdfs:label "varyingLegNotionalCurrency" ;
    rdfs:range xsd:string ;
    skos:definition "Indicate the Payout legs which nominal amount may vary in regards of FX Fixing dates as determined in the product terms." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement .

common_domain_model:webPage a owl:DatatypeProperty ;
    rdfs:label "webPage" ;
    rdfs:range xsd:string ;
    skos:definition "The web page. This attribute is not specified as part of the FpML ContactInformation complex type." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_party .

common_domain_model:weightedRates a owl:DatatypeProperty ;
    rdfs:label "weightedRates" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CalculatedRateDetails.weightedRates ;
    skos:definition "The weighted value of each observation." ;
    skos:inScheme common_domain_model:cdm_observable_asset_calculatedrate .

common_domain_model:whoMaySubstitute a owl:ObjectProperty ;
    rdfs:label "whoMaySubstitute" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "Designates which Counterparty to the transaction who has the right to trigger a substitution or to provide related determination e.g. for instance to qualify the effectiveness of an Event which may be a trigger for substitution, determine the replacement Share to substitute, etc. ; cardinality of this object is 2, in case parties jointly have this role." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction .

common_domain_model:whoToDetermine a owl:ObjectProperty ;
    rdfs:label "whoToDetermine" ;
    rdfs:range common_domain_model:CounterpartyRoleEnum ;
    skos:definition "Designates which Counterparty to the transaction is granted with the particular role ; cardinality of this object is 2, in case parties are both having the same role e.g. jointly CalculationAgent, jointly Determining Party, etc. " ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:AcctOwnr a owl:Class ;
    rdfs:label "AcctOwnr" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Id ;
            owl:onProperty common_domain_model:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:id ] ;
    skos:inScheme common_domain_model:cdm_regulation .

common_domain_model:AdditionalRepresentations a owl:Class ;
    rdfs:label "AdditionalRepresentations" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:regulatoryComplianceRepresentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:regulatoryComplianceRepresentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:regulatoryComplianceRepresentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:additionalRepresentation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:additionalRepresentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:AdditionalRepresentation ;
            owl:onProperty common_domain_model:additionalRepresentation ] ;
    skos:closeMatch fpml_5_10:AdditionalRepresentations ;
    skos:definition "A class to specify Additional Representations that may be applicable to an agreement." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:AdditionalRightsEvent a owl:Class ;
    rdfs:label "AdditionalRightsEvent" ;
    rdfs:seeAlso isda:CSA_IM_Japanese_2016,
        isda:CSA_IM_NewYork_2016,
        isda:CSD_IM_English_2016 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty common_domain_model:isApplicable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:qualification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:isApplicable ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:qualification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:isApplicable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:qualification ] ;
    skos:closeMatch fpml_5_10:AdditionalRightsEvent ;
    skos:definition "A class to specify the Pledgor/Obligor/Chargor Additional Rights Event election." ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(k)\" name \"Obligor Additional Rights Event\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(k)\" name \"Pledgor Additional Rights Event\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(k)\" name \"Chargor Additional Rights Event\"" ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa ;
    skos:note "Rosetta condition: Qualification — if qualification exists then isApplicable = True" .

common_domain_model:AdjustableOrAdjustedDate a owl:Class ;
    rdfs:label "AdjustableOrAdjustedDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:unadjustedDate ] ;
    skos:closeMatch fpml_5_10:AdjustableOrAdjustedDate ;
    skos:definition "A class for defining a date that shall be subject to adjustment if it would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the date." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: AdjustedDate — if adjustedDate is absent then unadjustedDate exists and dateAdjustments exists" ;
    common_domain_model:metadata_key true .

common_domain_model:AdjustableOrAdjustedOrRelativeDate a owl:Class ;
    rdfs:label "AdjustableOrAdjustedOrRelativeDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessDayAdjustments ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:relativeDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:adjustedDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:relativeDate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:unadjustedDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:RelativeDateOffset ;
            owl:onProperty common_domain_model:relativeDate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:dateAdjustments ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty common_domain_model:unadjustedDate ] ;
    skos:closeMatch fpml_5_10:AdjustableOrAdjustedOrRelativeDate ;
    skos:definition "This Rosetta class specifies the date as either an unadjusted, adjusted or relative date. It supplements the features of the AdjustableOrAdjustedDate to support the credit default swap option premium, which uses the relative date construct." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: AdjustedDate — adjustedDate exists or relativeDate exists or unadjustedDate exists or (unadjustedDate exists and dateAdjustments exists and adjustedDate is absent)",
        "Rosetta func: AdjustableOrAdjustedOrRelativeDateResolution — Prioritization of unadjustedDate over adjustedDate.",
        "Rosetta func: ConvertToAdjustableOrAdjustedOrRelativeDate — Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrAdjustedOrRelativeDate",
        "Rosetta func: ConvertToAdjustableOrRelativeDate — Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrRelativeDate" ;
    common_domain_model:rosetta_functions "[{\"name\":\"ConvertToAdjustableOrRelativeDate\",\"description\":\"Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrRelativeDate\",\"inputs\":[{\"name\":\"adjustableOrAdjustedOrRelativeDate\",\"type\":\"AdjustableOrAdjustedOrRelativeDate\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"adjustableOrRelativeDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"0..1\"}},{\"name\":\"ConvertToAdjustableOrAdjustedOrRelativeDate\",\"description\":\"Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrAdjustedOrRelativeDate\",\"inputs\":[{\"name\":\"adjustableOrRelativeDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"adjustableOrAdjustedOrRelativeDate\",\"type\":\"AdjustableOrAdjustedOrRelativeDate\",\"cardinality\":\"0..1\"}},{\"name\":\"AdjustableOrAdjustedOrRelativeDateResolution\",\"description\":\"Prioritization of unadjustedDate over adjustedDate.\",\"inputs\":[{\"name\":\"adjustableDate\",\"type\":\"AdjustableOrAdjustedOrRelativeDate\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"0..1\"}}]" .

common_domain_model:Agreement a owl:Class ;
    rdfs:label "Agreement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CollateralTransferAgreementElections ;
            owl:onProperty common_domain_model:collateralTransferAgreementElections ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SecurityAgreementElections ;
            owl:onProperty common_domain_model:securityAgreementElections ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:masterAgreementElections ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( common_domain_model:CreditSupportAgreementInitialMarginElections common_domain_model:CreditSupportAgreementVariationMarginElections common_domain_model:CreditSupportAgreementLegacyElections ) ] common_domain_model:CreditSupportAgreementElections ) ] ;
            owl:onProperty common_domain_model:creditSupportAgreementElections ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MasterAgreementSchedule ;
            owl:onProperty common_domain_model:masterAgreementSchedule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:securityAgreementElections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:securityAgreementElections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:masterAgreementElections ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:creditSupportAgreementElections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:transactionAdditionalTerms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:transactionAdditionalTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:collateralTransferAgreementElections ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:masterAgreementSchedule ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:TransactionAdditionalTerms ;
            owl:onProperty common_domain_model:transactionAdditionalTerms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:masterAgreementSchedule ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:collateralTransferAgreementElections ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:MasterAgreementElections ;
            owl:onProperty common_domain_model:masterAgreementElections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:creditSupportAgreementElections ] ;
    skos:closeMatch fpml_5_10:Agreement ;
    skos:definition "Specification of the standard set of terms that define a legal agreement." ;
    skos:exactMatch gist:Agreement ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_common .

common_domain_model:AssetDeliveryPeriods a owl:Class ;
    rdfs:label "AssetDeliveryPeriods" ;
