common_domain_model:UnscheduledTransferEnum a owl:Class ;
    rdfs:label "UnscheduledTransferEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Recall> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Return> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Assignment> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#BrokerageCommission> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Increase> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Novation> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#PartialTermination> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Premium> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Renegotiation> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Termination> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Upfront> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#CreditEvent> <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#CorporateAction> ) ;
    skos:definition "The qualification of the type of ad-hoc transfers and cash flows that can be associated with contracts and their lifecycle events." ;
    skos:inScheme common_domain_model:cdm_product_common_settlement ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Assignment>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#BrokerageCommission>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#CorporateAction>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#CreditEvent>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Increase>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Novation>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#PartialTermination>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Premium>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Recall>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Renegotiation>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Return>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Termination>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransferEnum#Upfront> .

common_domain_model:additionalBespokeTerms a owl:DatatypeProperty ;
    rdfs:label "additionalBespokeTerms" ;
    rdfs:range xsd:string ;
    skos:definition "Any additional terms that might be specified applicable." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:businessDayConvention a owl:ObjectProperty ;
    rdfs:label "businessDayConvention" ;
    rdfs:range common_domain_model:BusinessDayConventionEnum ;
    skos:closeMatch fpml_5_10:BusinessDateRange.businessDayConvention ;
    skos:definition "The convention for adjusting a date if it would otherwise fall on a day that is not a business day, as specified by an ISDA convention (e.g. Following, Precedent)." ;
    skos:inScheme common_domain_model:cdm_base_datetime .

common_domain_model:deliveryAmount a owl:DatatypeProperty ;
    rdfs:label "deliveryAmount" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CollateralRounding.deliveryAmount ;
    skos:definition "The nearest integral multiple of Base Currency units to which the Delivery Amount will be rounded in accordance with the specified rounding direction." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:Commodity.description ;
    skos:definition "Provides additional information about the commodity underlier." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

common_domain_model:fallbackReferencePrice a owl:ObjectProperty ;
    rdfs:label "fallbackReferencePrice" ;
    rdfs:range common_domain_model:SettlementRateOption ;
    skos:definition "The method, prioritised by the order it is listed in this element, to get a replacement rate for the disrupted settlement rate option." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_transaction_additionalterms .

common_domain_model:fixingTime a owl:ObjectProperty ;
    rdfs:label "fixingTime" ;
    rdfs:range common_domain_model:BusinessCenterTime ;
    skos:definition "The time that the fixing will be taken along with a business center to define the time zone." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

common_domain_model:notificationTime a owl:ObjectProperty ;
    rdfs:label "notificationTime" ;
    rdfs:range common_domain_model:NotificationTime ;
    skos:definition "The time by which a demand for the Transfer of Eligible Credit Support (IM) or Posted Credit Support (IM) needs to be made in order for the transfer to take place in accordance with the Transfer Timing provisions." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:other a owl:DatatypeProperty ;
    rdfs:label "other" ;
    rdfs:range xsd:string ;
    skos:closeMatch fpml_5_10:CollateralRounding.other ;
    skos:definition "Utilised where the clause data structure is not able to capture a material aspect of the clause." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:ratedParty a owl:ObjectProperty ;
    rdfs:label "ratedParty" ;
    rdfs:range common_domain_model:RatedPartyEnum ;
    skos:definition "The party to which a rating applies." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:resetDate a owl:DatatypeProperty ;
    rdfs:label "resetDate" ;
    rdfs:range xsd:date ;
    skos:definition "Specifies the date on which the reset is occuring." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:returnAmount a owl:DatatypeProperty ;
    rdfs:label "returnAmount" ;
    rdfs:range xsd:decimal ;
    skos:closeMatch fpml_5_10:CollateralRounding.returnAmount ;
    skos:definition "The nearest integral multiple of Base Currency units to which the Return Amount will be rounded in accordance with the specified rounding direction." ;
    skos:inScheme common_domain_model:cdm_legaldocumentation_csa .

common_domain_model:settlementDate a owl:DatatypeProperty ;
    rdfs:label "settlementDate" ;
    rdfs:range xsd:date ;
    skos:closeMatch fpml_5_10:BillingRecordInstruction.settlementDate ;
    skos:definition "The date for settlement of the transfer." ;
    skos:inScheme common_domain_model:cdm_event_common .

common_domain_model:BusinessCenters a owl:Class ;
    rdfs:label "BusinessCenters" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:CommodityBusinessCalendarEnum ;
            owl:onProperty common_domain_model:commodityBusinessCalendar ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:businessCenter ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessCenter ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:businessCentersReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:businessCentersReference ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:BusinessCenters ;
            owl:onProperty common_domain_model:businessCentersReference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:commodityBusinessCalendar ] ;
    skos:closeMatch fpml_5_10:BusinessCenters ;
    skos:definition "A class for specifying the business day calendar location used in determining whether a day is a business day or not, either by specifying this business center by reference to an enumerated list that is maintained by the FpML standard, or by reference to such specification when it exists elsewhere as part of the instance document. This class corresponds to the FpML BusinessCentersOrReference.model." ;
    skos:inScheme common_domain_model:cdm_base_datetime ;
    skos:note "Rosetta condition: BusinessCentersChoice — required choice businessCenter, businessCentersReference, commodityBusinessCalendar",
        "Rosetta func: GetAllBusinessCenters — Returns a merged list of BusinessCenter codes for the supplied BusinessCenters." ;
    common_domain_model:metadata_key true ;
    common_domain_model:rosetta_functions "[{\"name\":\"GetAllBusinessCenters\",\"description\":\"Returns a merged list of BusinessCenter codes for the supplied BusinessCenters.\",\"inputs\":[{\"name\":\"businessCenters\",\"type\":\"BusinessCenters\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"businessCenterCodes\",\"type\":\"BusinessCenter\",\"cardinality\":\"0..*\"}}]" .

common_domain_model:Security a owl:Class ;
    rdfs:label "Security" ;
    rdfs:seeAlso icma:GMRA ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:debtType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:fundType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:fundType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:EquityType ;
            owl:onProperty common_domain_model:equityType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:equityType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:debtType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DebtType ;
            owl:onProperty common_domain_model:debtType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SecurityTypeEnum ;
            owl:onProperty common_domain_model:securityType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:equityType ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:FundProductTypeEnum ;
            owl:onProperty common_domain_model:fundType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:securityType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:securityType ],
        common_domain_model:InstrumentBase ;
    skos:definition "Identifies a security by referencing an identifier and by specifying the sector." ;
    skos:editorialNote "ICMA GMRA namingConvention \"Purchased Security\"" ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common ;
    skos:note "Rosetta condition: AssetType — assetType = Security",
        "Rosetta condition: DebtSubType — if securityType <> Debt then debtType is absent",
        "Rosetta condition: EquitySubType — if securityType <> Equity then equityType is absent",
        "Rosetta condition: FundSubType — if securityType <> Fund then fundType is absent" .

common_domain_model:WorkflowStatusEnum a owl:Class ;
    rdfs:label "WorkflowStatusEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Accepted> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Alleged> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Amended> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Cancelled> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Certain> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Cleared> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Pending> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Rejected> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Submitted> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Terminated> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Uncertain> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Unconfirmed> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Affirmed> <https://w3id.org/lmodel/common-domain-model/WorkflowStatusEnum#Confirmed> ) ;
