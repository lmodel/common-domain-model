            owl:onProperty common_domain_model:sourcePageHeading ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:sourcePageHeading ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:InformationProviderEnum ;
            owl:onProperty common_domain_model:sourceProvider ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:sourceProvider ] ;
    skos:definition "A class defining the source for a piece of information (e.g. a rate fix or an FX fixing). The attribute names have been adjusted from FpML to address the fact that the information is not limited to rates." ;
    skos:inScheme common_domain_model:cdm_observable_asset .

