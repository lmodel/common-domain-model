common_domain_model:PartyRoleEnum\#ArrangingBroker a owl:Class ;
	rdfs:label "ArrangingBroker" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The organization that arranged the trade, i.e. brought together the counterparties. Synonyms/Alternatives: Inter-dealer broker, agent." .
common_domain_model:PartyRoleEnum\#BarrierDeterminationAgent a owl:Class ;
	rdfs:label "BarrierDeterminationAgent" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party specified in the related confirmation as Barrier Determination Agent." .
common_domain_model:PartyRoleEnum\#BeneficialOwner a owl:Class ;
	rdfs:label "BeneficialOwner" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party that lends out securities under stock lending arrangements via an Agent Lender." .
common_domain_model:PartyRoleEnum\#Beneficiary a owl:Class ;
	rdfs:label "Beneficiary" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization that suffers the economic benefit of the trade. The beneficiary may be distinct from the principal/counterparty - an example occurs when a hedge fund trades via a prime broker; in this case the principal is the prime broker, but the beneficiary is the hedge fund. This can be represented as a payer/receiver account in the name of the hedge fund, but it is also possible to add the party role of 'Beneficiary' at the partyTradeInformation level." .
common_domain_model:PartyRoleEnum\#BookingParty a owl:Class ;
	rdfs:label "BookingParty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The entity for which the organization supporting the trade's processing has booked/recorded the trade. This is used in non-reporting workflows situations in which the trade doesn\\'t need to be reported but a firm still wants to specify their own side." .
common_domain_model:PartyRoleEnum\#Borrower a owl:Class ;
	rdfs:label "Borrower" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party that borrows securities under stock lending arrangements." .
common_domain_model:PartyRoleEnum\#Buyer a owl:Class ;
	rdfs:label "Buyer" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Acquirer of the legal title to the financial instrument. In the case of an option, the buyer is the holder of the option. In the case of a swap or forward, the buyer will be determined by industry best practice. This does not refer to an investor or investment manager or other organization on what is typically called the 'Buy side'; for that, see the 'Client' role. Corresponds to 'Buyer' as defined in certain regulations such as ESMA MiFID II/MIFIR RTS 22 field 9." .
common_domain_model:PartyRoleEnum\#BuyerDecisionMaker a owl:Class ;
	rdfs:label "BuyerDecisionMaker" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party or person who, having legal authority to act on behalf of the trade counterparty acting as Buyer as defined in this coding scheme, made the decision to acquire the financial instrument. Corresponds to 'buyer decision maker' as defined in ESMA\\'s MIFIR RTS 23 report. This does not refer to the decision maker for what is traditionally called the 'Buy side'; for that, see the 'Client Decision Maker' role." .
common_domain_model:PartyRoleEnum\#Chargor a owl:Class ;
	rdfs:label "Chargor" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party that provides credit support under English Law." .
common_domain_model:PartyRoleEnum\#ClearingClient a owl:Class ;
	rdfs:label "ClearingClient" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "An organization that clears trades through a clearing house, via a clearing broker (member of the clearing house) who acts as an agent on its behalf. The term 'client' refers to the organization\\'s role in the clearing process in relation to its clearing broker, and not whether it is a price maker or taker in the execution process." .
common_domain_model:PartyRoleEnum\#ClearingExceptionParty a owl:Class ;
	rdfs:label "ClearingExceptionParty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "A party to the trade that claims a clearing exception, such as an end-user exception under Dodd-Frank Act provisions." .
common_domain_model:PartyRoleEnum\#ClearingFirm a owl:Class ;
	rdfs:label "ClearingFirm" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization that submits the trade to a clearing house on behalf of the principal. Synonyms/alternates: Futures Commission Merchant (FCM), Clearing Broker, Clearing Member Firm. Some implementations use 'Clearing Broker' as synonym." .
common_domain_model:PartyRoleEnum\#ClearingOrganization a owl:Class ;
	rdfs:label "ClearingOrganization" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The organization that acts as a central counterparty to clear a derivatives contract. This is used to represent the role of Central Counterparties (CCPs) or Derivative Clearing Organizations (DCOs). Sometimes called 'ClearingService'. Some implementations also use the term 'Clearer'." .
common_domain_model:PartyRoleEnum\#Client a owl:Class ;
	rdfs:label "Client" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Client as defined under ESMA MIFIR. This is generally the investor or other client of an investment firm, and is synonymous with the Beneficiary in many circumstances." .
common_domain_model:PartyRoleEnum\#ClientDecisionMaker a owl:Class ;
	rdfs:label "ClientDecisionMaker" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party or person who, having legal authority to act on behalf of a trade counterparty, made the decision to acquire or sell the financial instrument." .
common_domain_model:PartyRoleEnum\#ConfirmationPlatform a owl:Class ;
	rdfs:label "ConfirmationPlatform" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization serving as a financial intermediary for the purposes of electronic confirmation or providing services for post-processing of transactional data." .
common_domain_model:PartyRoleEnum\#ContractualParty a owl:Class ;
	rdfs:label "ContractualParty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "A party to a contractual document. If the intended usage relates to the context of the trade lifecycle, more specific annotations have been defined which might be more appropriate." .
common_domain_model:PartyRoleEnum\#CounterPartyAffiliate a owl:Class ;
	rdfs:label "CounterPartyAffiliate" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization officially attached to the counterparty. e.g. partner, branch, subsidiary." .
common_domain_model:PartyRoleEnum\#CounterPartyUltimateParent a owl:Class ;
	rdfs:label "CounterPartyUltimateParent" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The topmost entity or organization, within the corporate hierarchy, responsible for the reporting party." .
common_domain_model:PartyRoleEnum\#Counterparty a owl:Class ;
	rdfs:label "Counterparty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "An economic counterparty to the trade. Synonym: principal." .
common_domain_model:PartyRoleEnum\#CreditSupportProvider a owl:Class ;
	rdfs:label "CreditSupportProvider" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization that enhances the credit of another organization (similar to guarantor, but may not fully guarantee the obligation)." .
common_domain_model:PartyRoleEnum\#Custodian a owl:Class ;
	rdfs:label "Custodian" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization that maintains custody of the asset represented by the trade on behalf of the owner/principal." .
common_domain_model:PartyRoleEnum\#DataSubmitter a owl:Class ;
	rdfs:label "DataSubmitter" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Entity submitting the transaction report to the competent authority." .
common_domain_model:PartyRoleEnum\#DeterminingParty a owl:Class ;
	rdfs:label "DeterminingParty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party referenced is specified in the contract confirmation as Determination Party." .
common_domain_model:PartyRoleEnum\#DisputingParty a owl:Class ;
	rdfs:label "DisputingParty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization that is disputing the trade or transaction." .
common_domain_model:PartyRoleEnum\#DocumentRepository a owl:Class ;
	rdfs:label "DocumentRepository" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "A marketplace organization which purpose is to maintain document records. If the intended usage relates to the context of the trade lifecycle, more specific annotations have been defined which might be more appropriate." .
common_domain_model:PartyRoleEnum\#ExecutingBroker a owl:Class ;
	rdfs:label "ExecutingBroker" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The (generally sell-side) organization that executed the trade; the price-making party." .
common_domain_model:PartyRoleEnum\#ExecutingEntity a owl:Class ;
	rdfs:label "ExecutingEntity" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Entity executing the transaction. If the transaction is executed directly by the reporting party, it will be the reporting party. If it is executed by an execution agent or an affiliated party on behalf of the reporting party, it will be that affiliate or agent." .
common_domain_model:PartyRoleEnum\#ExecutionAgent a owl:Class ;
	rdfs:label "ExecutionAgent" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The (generally buy-side) organization that acts to execute trades on behalf of an investor. Typically this is an investment manager or asset manager, and also makes the investment decisions for the investor. If required, a separate InvestmentDecision role can be specified to distinguish that the party making the investment decision is different." .
common_domain_model:PartyRoleEnum\#ExecutionFacility a owl:Class ;
	rdfs:label "ExecutionFacility" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The facility, exchange, or market where the trade was executed. Synonym: Swap Execution Facility, Designated Contract Market, Execution Venue." .
common_domain_model:PartyRoleEnum\#Guarantor a owl:Class ;
	rdfs:label "Guarantor" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization that backs (guarantees) the credit risk of the trade." .
common_domain_model:PartyRoleEnum\#HedgingParty a owl:Class ;
	rdfs:label "HedgingParty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The ISDA Hedging Party that is specified in the related confirmation as Hedging, or if no Hedging Party is specified, either party to the contract." .
common_domain_model:PartyRoleEnum\#Lender a owl:Class ;
	rdfs:label "Lender" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party that lends out securities under stock lending arrangements as principal." .
common_domain_model:PartyRoleEnum\#MarginAffiliate a owl:Class ;
	rdfs:label "MarginAffiliate" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Margin affiliate as defined by U.S. margin and capital rules §23.151." .
common_domain_model:PartyRoleEnum\#OrderTransmitter a owl:Class ;
	rdfs:label "OrderTransmitter" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The entity transmitting the order to the reporting firm. Synonym: Transmitting Firm." .
common_domain_model:PartyRoleEnum\#PTRRServiceProvider a owl:Class ;
	rdfs:label "PTRRServiceProvider" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party that acts as either a portfolio compression or portfolio rebalancing service provider, as defined under ESMA MIFIR" .
common_domain_model:PartyRoleEnum\#Pledgor a owl:Class ;
	rdfs:label "Pledgor" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party that provides credit support under New York Law." .
common_domain_model:PartyRoleEnum\#PrimeBroker a owl:Class ;
	rdfs:label "PrimeBroker" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The organization that takes on or took on the credit risk for this trade by stepping in between the two economic parties (without a central counterparty clearing mechanism)." .
common_domain_model:PartyRoleEnum\#PriorTradeRepository a owl:Class ;
	rdfs:label "PriorTradeRepository" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The trade repository at which the trade was reported previous to the current trade repository." .
common_domain_model:PartyRoleEnum\#PublicationVenue a owl:Class ;
	rdfs:label "PublicationVenue" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The reporting service (whether trade repository, market data service, or exchange/facility/venue data distribution service) that published the report of this trade." .
common_domain_model:PartyRoleEnum\#ReportingParty a owl:Class ;
	rdfs:label "ReportingParty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party with the regulatory responsibility to report this trade." .
common_domain_model:PartyRoleEnum\#ReportingPartyAffiliate a owl:Class ;
	rdfs:label "ReportingPartyAffiliate" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "Organization officially attached to the reporting party e.g. partner, branch, subsidiary." .
common_domain_model:PartyRoleEnum\#ReportingPartyUltimateParent a owl:Class ;
	rdfs:label "ReportingPartyUltimateParent" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The topmost entity or organization, within the corporate hierarchy, responsible for the reporting party." .
common_domain_model:PartyRoleEnum\#SecuredParty a owl:Class ;
	rdfs:label "SecuredParty" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party that receives credit support under New York or English Law." .
common_domain_model:PartyRoleEnum\#Seller a owl:Class ;
	rdfs:label "Seller" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "A counterparty in a trade, which performs in one of the following capacities: 1) it transfers or agrees to transfer in the future an instrument or title to that instrument in exchange for payment, 2) it writes a derivatives instrument such as an option or a swap in which it provides risk protection to the buyer. This does not refer to the broker/dealer or other organization on what is typically called the 'Sell side'; for that, see the 'Executing Broker' role. Corresponds to 'Seller' as defined in certain regulations such as ESMA MiFID II/MIFIR RTS 22 field 16." .
common_domain_model:PartyRoleEnum\#SellerDecisionMaker a owl:Class ;
	rdfs:label "SellerDecisionMaker" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The party or person who, having legal authority to act on behalf of the trade counterparty acting as Seller as defined in this coding scheme, made the decision to sell the financial instrument. Corresponds to 'seller decision maker' as defined in ESMA\\'s MIFIR RTS 23 report. This does not refer to the decision maker for what is traditionally called the 'Sell side'; for that, see the 'Trader' person role." .
common_domain_model:PartyRoleEnum\#SettlementAgent a owl:Class ;
	rdfs:label "SettlementAgent" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The organization that makes or receives payments on behalf of the given principal party." .
common_domain_model:PartyRoleEnum\#ThirdPartyCustodian a owl:Class ;
	rdfs:label "ThirdPartyCustodian" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "A third-party providing custody, settlement, segregation and reporting services." .
common_domain_model:PartyRoleEnum\#TradeRepository a owl:Class ;
	rdfs:label "TradeRepository" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "An organization that maintains records of the trade for regulatory reporting purposes." .
common_domain_model:PartyRoleEnum\#TradeSource a owl:Class ;
	rdfs:label "TradeSource" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The organization that originally supplied the record of the trade. In the context of regulatory reporting, it is the submitter of the trade record to a regulator or TR." .
common_domain_model:PartyRoleEnum\#TradingManager a owl:Class ;
	rdfs:label "TradingManager" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "The entity responsible for managing the assets/investments of this party. Synonym: Asset Manager, Investment Manager, Trading Advisory." .
common_domain_model:PartyRoleEnum\#TradingPartner a owl:Class ;
	rdfs:label "TradingPartner" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "An entity with which this party trades from time to time, ie. with which it acts as a counterparty on some transactions. This role is used for static reference data, not individual transactions." .
common_domain_model:PartyRoleEnum\#TripartyAgent a owl:Class ;
	rdfs:label "TripartyAgent" ;
	rdfs:subClassOf common_domain_model:PartyRoleEnum ;
	skos:definition "A third party entity that acts as an intermediary and provides automated clearing, settlement, allocation, valuation and reporting services." .
common_domain_model:PartyRoleEnum a owl:Class ;
	rdfs:label "PartyRoleEnum" ;
	owl:unionOf _:c14n3038 ;
	skos:definition "The enumerated values for the party role. The enumerated values go beyond the FpML partyRoleScheme as they also include elements that are part of the FpML Trade, such as the Barrier Determination Agent and the Hedging Party." ;
	skos:inScheme common_domain_model:cdm_base_staticdata_party ;
	linkml:permissible_values common_domain_model:PartyRoleEnum\#Accountant , common_domain_model:PartyRoleEnum\#AgentLender , common_domain_model:PartyRoleEnum\#AllocationAgent , common_domain_model:PartyRoleEnum\#ArrangingBroker , common_domain_model:PartyRoleEnum\#BarrierDeterminationAgent , common_domain_model:PartyRoleEnum\#BeneficialOwner , common_domain_model:PartyRoleEnum\#Beneficiary , common_domain_model:PartyRoleEnum\#BookingParty , common_domain_model:PartyRoleEnum\#Borrower , common_domain_model:PartyRoleEnum\#Buyer , common_domain_model:PartyRoleEnum\#BuyerDecisionMaker , common_domain_model:PartyRoleEnum\#Chargor , common_domain_model:PartyRoleEnum\#ClearingClient , common_domain_model:PartyRoleEnum\#ClearingExceptionParty , common_domain_model:PartyRoleEnum\#ClearingFirm , common_domain_model:PartyRoleEnum\#ClearingOrganization , common_domain_model:PartyRoleEnum\#Client , common_domain_model:PartyRoleEnum\#ClientDecisionMaker , common_domain_model:PartyRoleEnum\#ConfirmationPlatform , common_domain_model:PartyRoleEnum\#ContractualParty , common_domain_model:PartyRoleEnum\#CounterPartyAffiliate , common_domain_model:PartyRoleEnum\#CounterPartyUltimateParent , common_domain_model:PartyRoleEnum\#Counterparty , common_domain_model:PartyRoleEnum\#CreditSupportProvider , common_domain_model:PartyRoleEnum\#Custodian , common_domain_model:PartyRoleEnum\#DataSubmitter , common_domain_model:PartyRoleEnum\#DeterminingParty , common_domain_model:PartyRoleEnum\#DisputingParty , common_domain_model:PartyRoleEnum\#DocumentRepository , common_domain_model:PartyRoleEnum\#ExecutingBroker , common_domain_model:PartyRoleEnum\#ExecutingEntity , common_domain_model:PartyRoleEnum\#ExecutionAgent , common_domain_model:PartyRoleEnum\#ExecutionFacility , common_domain_model:PartyRoleEnum\#Guarantor , common_domain_model:PartyRoleEnum\#HedgingParty , common_domain_model:PartyRoleEnum\#Lender , common_domain_model:PartyRoleEnum\#MarginAffiliate , common_domain_model:PartyRoleEnum\#OrderTransmitter , common_domain_model:PartyRoleEnum\#PTRRServiceProvider , common_domain_model:PartyRoleEnum\#Pledgor , common_domain_model:PartyRoleEnum\#PrimeBroker , common_domain_model:PartyRoleEnum\#PriorTradeRepository , common_domain_model:PartyRoleEnum\#PublicationVenue , common_domain_model:PartyRoleEnum\#ReportingParty , common_domain_model:PartyRoleEnum\#ReportingPartyAffiliate , common_domain_model:PartyRoleEnum\#ReportingPartyUltimateParent , common_domain_model:PartyRoleEnum\#SecuredParty , common_domain_model:PartyRoleEnum\#Seller , common_domain_model:PartyRoleEnum\#SellerDecisionMaker , common_domain_model:PartyRoleEnum\#SettlementAgent , common_domain_model:PartyRoleEnum\#ThirdPartyCustodian , common_domain_model:PartyRoleEnum\#TradeRepository , common_domain_model:PartyRoleEnum\#TradeSource , common_domain_model:PartyRoleEnum\#TradingManager , common_domain_model:PartyRoleEnum\#TradingPartner , common_domain_model:PartyRoleEnum\#TripartyAgent .
