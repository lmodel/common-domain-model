        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:Clause ;
            owl:onProperty common_domain_model:subcomponents ] ;
    skos:closeMatch fpml_5_10:Clause ;
    skos:definition "A type for documenting additional clause that cannot yet be represented with the model and yet needed for a digital representation of the agreement." ;
