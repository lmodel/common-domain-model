common_domain_model:SecurityLocate a owl:Class ;
    rdfs:label "SecurityLocate" ;
    rdfs:subClassOf common_domain_model:AvailableInventory ;
    skos:definition "A locate is an approval from a broker that needs to be obtained prior to effecting a short sale in an equity security. Similar to security availability, a borrower can request a single or multiple securities, but at least one must be requested." ;
    skos:inScheme common_domain_model:cdm_event_position ;
    skos:note "Rosetta condition: RequestOneSecurityMinimum — availableInventoryRecord exists" .

common_domain_model:StandardizedScheduleInitialMargin a owl:Class ;
    rdfs:label "StandardizedScheduleInitialMargin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:netInitialMargin ],
