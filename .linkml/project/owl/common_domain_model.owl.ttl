    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/AssetPayoutTradeTypeEnum#BuySellBack>,
        <https://w3id.org/lmodel/common-domain-model/AssetPayoutTradeTypeEnum#Repo>,
        <https://w3id.org/lmodel/common-domain-model/AssetPayoutTradeTypeEnum#SecurityLending> .

common_domain_model:AssignedIdentifier a owl:Class ;
    rdfs:label "AssignedIdentifier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty common_domain_model:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty common_domain_model:version ] ;
    skos:closeMatch spdx:ExternalIdentifier,
        gist:ID,
        fpml_5_10:AssignedIdentifier ;
    skos:definition "A class to specify the identifier value and its associated version." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_identifier .

common_domain_model:AveragingInOutEnum a owl:Class ;
    rdfs:label "AveragingInOutEnum" ;
    owl:unionOf ( <https://w3id.org/lmodel/common-domain-model/AveragingInOutEnum#In> <https://w3id.org/lmodel/common-domain-model/AveragingInOutEnum#Out> <https://w3id.org/lmodel/common-domain-model/AveragingInOutEnum#Both> ) ;
    skos:definition "The enumerated values to specify the type of averaging used in an Asian option." ;
