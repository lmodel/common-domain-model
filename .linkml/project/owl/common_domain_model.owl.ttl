<https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#SAT> a owl:Class ;
    rdfs:label "SAT" ;
    rdfs:subClassOf common_domain_model:DayOfWeekEnum ;
    skos:definition "Saturday" .

<https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#SUN> a owl:Class ;
    rdfs:label "SUN" ;
    rdfs:subClassOf common_domain_model:DayOfWeekEnum ;
    skos:definition "Sunday" .

<https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#THU> a owl:Class ;
    rdfs:label "THU" ;
    rdfs:subClassOf common_domain_model:DayOfWeekEnum ;
    skos:definition "Thursday" .

<https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#TUE> a owl:Class ;
    rdfs:label "TUE" ;
    rdfs:subClassOf common_domain_model:DayOfWeekEnum ;
    skos:definition "Tuesday" .

<https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum#WED> a owl:Class ;
    rdfs:label "WED" ;
    rdfs:subClassOf common_domain_model:DayOfWeekEnum ;
    skos:definition "Wednesday" .

<https://w3id.org/lmodel/common-domain-model/DayTypeEnum#Business> a owl:Class ;
    rdfs:label "Business" ;
    rdfs:subClassOf common_domain_model:DayTypeEnum ;
    skos:definition "Applies when calculating the number of days between two dates the count includes only business days." .

<https://w3id.org/lmodel/common-domain-model/DayTypeEnum#Calendar> a owl:Class ;
    rdfs:label "Calendar" ;
    rdfs:subClassOf common_domain_model:DayTypeEnum ;
    skos:definition "Applies when calculating the number of days between two dates the count includes all calendar days." .

<https://w3id.org/lmodel/common-domain-model/DayTypeEnum#CurrencyBusiness> a owl:Class ;
    rdfs:label "CurrencyBusiness" ;
    rdfs:subClassOf common_domain_model:DayTypeEnum ;
    skos:definition "Applies when calculating the number of days between two dates the count includes only currency business days." .

<https://w3id.org/lmodel/common-domain-model/DayTypeEnum#ExchangeBusiness> a owl:Class ;
    rdfs:label "ExchangeBusiness" ;
    rdfs:subClassOf common_domain_model:DayTypeEnum ;
    skos:definition "Applies when calculating the number of days between two dates the count includes only stock exchange business days." .

<https://w3id.org/lmodel/common-domain-model/DayTypeEnum#ScheduledTradingDay> a owl:Class ;
    rdfs:label "ScheduledTradingDay" ;
    rdfs:subClassOf common_domain_model:DayTypeEnum ;
    skos:definition "Applies when calculating the number of days between two dates the count includes only scheduled trading days." .

common_domain_model:DebtEconomics a owl:Class ;
    rdfs:label "DebtEconomics" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:redemption ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:seniority ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:SecuredDebt ;
            owl:onProperty common_domain_model:secured ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DebtSeniorityEnum ;
            owl:onProperty common_domain_model:seniority ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:redemption ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:interest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:principal ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DebtRedemption ;
            owl:onProperty common_domain_model:redemption ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:secured ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DebtInterestEnum ;
            owl:onProperty common_domain_model:interest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:seniority ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:interest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty common_domain_model:secured ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty common_domain_model:principal ],
        [ a owl:Restriction ;
            owl:allValuesFrom common_domain_model:DebtPrincipalEnum ;
            owl:onProperty common_domain_model:principal ] ;
    skos:definition "Specifies selected economics of a debt security." ;
    skos:inScheme common_domain_model:cdm_base_staticdata_asset_common .

<https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#Fixed> a owl:Class ;
    rdfs:label "Fixed" ;
    rdfs:subClassOf common_domain_model:DebtInterestEnum ;
    skos:definition "Denotes payment calculated with reference to a fixed interest rate." .

<https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#Floating> a owl:Class ;
    rdfs:label "Floating" ;
    rdfs:subClassOf common_domain_model:DebtInterestEnum ;
    skos:definition "Denotes payment calculated with reference to a floating interest rate." .

<https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#IndexLinked> a owl:Class ;
    rdfs:label "IndexLinked" ;
    rdfs:subClassOf common_domain_model:DebtInterestEnum ;
    skos:definition "Denotes payment calculated with reference to one or more price or other indices (other than inflation rates)." .

<https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InflationLinked> a owl:Class ;
    rdfs:label "InflationLinked" ;
    rdfs:subClassOf common_domain_model:DebtInterestEnum ;
    skos:definition "Denotes payment calculated with reference to one or more specified inflation rates." .

<https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InterestOnly> a owl:Class ;
    rdfs:label "InterestOnly" ;
    rdfs:subClassOf common_domain_model:DebtInterestEnum ;
    skos:definition "Denotes a stripped bond representing only the interest component." .

<https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#InverseFloating> a owl:Class ;
    rdfs:label "InverseFloating" ;
    rdfs:subClassOf common_domain_model:DebtInterestEnum ;
    skos:definition "Denotes payment calculated with reference to the inverse of a floating interest rate." .

<https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#OtherStructured> a owl:Class ;
    rdfs:label "OtherStructured" ;
    rdfs:subClassOf common_domain_model:DebtInterestEnum ;
    skos:definition "Denotes payment calculated with reference to other underlyings (not being floating interest rates, inflation rates or indices) or with a non-linear relationship to floating interest rates, inflation rates or indices." .

<https://w3id.org/lmodel/common-domain-model/DebtInterestEnum#ZeroCoupon> a owl:Class ;
    rdfs:label "ZeroCoupon" ;
    rdfs:subClassOf common_domain_model:DebtInterestEnum ;
    skos:definition "Denotes a zero coupon bond that does not pay intetrest." .

<https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum#Amortising> a owl:Class ;
    rdfs:label "Amortising" ;
    rdfs:subClassOf common_domain_model:DebtPrincipalEnum ;
    skos:definition "Denotes that the principal on the debt is paid down regularly, along with its interest expense over the life of the debt instrument.  Includes amortising instruments with a bullet balance repayment at maturity." .

<https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum#Bullet> a owl:Class ;
    rdfs:label "Bullet" ;
    rdfs:subClassOf common_domain_model:DebtPrincipalEnum ;
    skos:definition "Denotes that the principal is paid all at once on maturity of the debt insrument. Bullet debt instruments cannot be redeemed early by an issuer, which means they are non-callable." .

<https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum#Callable> a owl:Class ;
    rdfs:label "Callable" ;
    rdfs:subClassOf common_domain_model:DebtPrincipalEnum ;
    skos:definition "Denotes that the principal on the debt can be repaid early, in whole or in part, at the option of the issuer." .

<https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum#IndexLinked> a owl:Class ;
    rdfs:label "IndexLinked" ;
    rdfs:subClassOf common_domain_model:DebtPrincipalEnum ;
    skos:definition "Denotes that the  principal on the debt is calculated with reference to one or more price or other indices (other than inflation rates)." .

<https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum#InflationLinked> a owl:Class ;
    rdfs:label "InflationLinked" ;
    rdfs:subClassOf common_domain_model:DebtPrincipalEnum ;
    skos:definition "Denotes that the principal on the debt is calculated with reference to one or more specified inflation rates." .

<https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum#OtherStructured> a owl:Class ;
    rdfs:label "OtherStructured" ;
    rdfs:subClassOf common_domain_model:DebtPrincipalEnum ;
    skos:definition "Denotes that the  principal on the debt is calculated with reference to other underlyings (not being floating interest rates, inflation rates or indices) or with a non-linear relationship to floating interest rates, inflation rates or indices." .

<https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum#PrincipalOnly> a owl:Class ;
    rdfs:label "PrincipalOnly" ;
    rdfs:subClassOf common_domain_model:DebtPrincipalEnum ;
    skos:definition "Denotes a stripped bond representing only the principal component." .

<https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum#Puttable> a owl:Class ;
    rdfs:label "Puttable" ;
    rdfs:subClassOf common_domain_model:DebtPrincipalEnum ;
    skos:definition "Denotes that the principal on the debt can be repaid early, in whole or in part, at the option of the holder." .

<https://w3id.org/lmodel/common-domain-model/DebtSeniorityEnum#Secured> a owl:Class ;
    rdfs:label "Secured" ;
    rdfs:subClassOf common_domain_model:DebtSeniorityEnum ;
    skos:definition "Denotes debt which is secured over assets of the issuer or a related party (eg guarantor)." .

<https://w3id.org/lmodel/common-domain-model/DebtSeniorityEnum#Senior> a owl:Class ;
    rdfs:label "Senior" ;
    rdfs:subClassOf common_domain_model:DebtSeniorityEnum ;
    skos:definition "Denotes debt  which ranks pari passu with all other unsecured creditors of the issuer." .

<https://w3id.org/lmodel/common-domain-model/DebtSeniorityEnum#Subordinated> a owl:Class ;
    rdfs:label "Subordinated" ;
    rdfs:subClassOf common_domain_model:DebtSeniorityEnum ;
    skos:definition "Denotes debt  owed to an unsecured creditor that in the event of a liquidation can only be paid after the claims of secured and senior creditors have been met." .

