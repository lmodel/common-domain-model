    {
      "name": "AdditionalTerminationEventEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AdditionalTerminationEventEnum",
      "description": "Specifies the types of events found in the related Master Agreement that may lead to the early termination of the Master Agreement, including suspension of the affected party's rights to rehypothecate, transfer, or substitute collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "FailureToNotifyNAV",
          "description": "Specifies an event where a party fails to notify the other of a decline in Net Asset Value by a specified amount over a specified period of time."
        },
        {
          "text": "InvestmentAdvisor",
          "description": "Specifies an event where the investment advisor of a party ceases to act for the party."
        },
        {
          "text": "KeyPersons",
          "description": "Specifies an event where a person deemed important to a party has departed."
        },
        {
          "text": "NAVDeclineTrigger",
          "description": "Specifies an event in which a partys Net Asset Value (NAV) has declined beyond a specified percentage or amount within a defined time period."
        },
        {
          "text": "NAVFloor",
          "description": "Specifies an event in which a partys Net Asset Value (NAV) falls below a predetermined absolute value, regardless of the timeframe over which the decline occurs. This value sets a minimum acceptable NAV threshold expressed as either a percentage or amount."
        },
        {
          "text": "OperativeDocs",
          "description": "Specifies an event where a party delivers operative documents that are invalid, untrue or unenforceable."
        },
        {
          "text": "RatingsDowngradeOrWithdrawalParty1",
          "description": "Specifies an event where Party 1 experiences a downgrade beyond a predetermined level, or has their credit rating withdrawn or suspended."
        },
        {
          "text": "RatingsDowngradeOrWithdrawalParty2",
          "description": "Specifies an event where Party 2 experiences a downgrade beyond a predetermined level, or has their credit rating withdrawn or suspended."
        },
        {
          "text": "AsApplicable",
          "description": "Represents the Additional Termination Event(s) in the related Master Agreement."
        },
        {
          "text": "AsSpecified",
          "description": "Represents any bespoke Additional Termination Event(s) that are set out in the related Specified Condition clause."
        }
      ]
    },
    {
      "name": "AdditionalTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AdditionalTypeEnum",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 paragraph 13 General Principles clause (b)(B)"
        }
      ],
      "description": "The enumerated values to specify the Additional Type of transaction that can require the collection or delivery of initial margin under a given regulatory regime for the purposes of Covered Transactions.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "NotApplicable",
          "description": "No Additional Type of transaction is applicable to the regulatory regulatory regime."
        },
        {
          "text": "EquityOptionOrIndexOption",
          "description": "Single stock equity option or index option transaction as referred to in the transitional provisions (if any) of the EMIR RTS."
        },
        {
          "text": "Other"
        }
      ]
    },
    {
      "name": "AmendmentEffectiveDateEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDateEnum",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 paragraph 13 General Principles clause (t)"
        }
      ],
      "description": "The enumerated values to specify the effective date of the Amendment to Termination Currency when specified as a specific date (e.g. the annex date).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "AnnexDate",
          "description": "The effective date corresponds to the Annex date."
        },
        {
          "text": "DeedDate",
          "description": "The effective date corresponds to the Deed date."
        },
        {
          "text": "AgreementDate",
          "description": "The effective date corresponds to the Agreement date."
        },
        {
          "text": "AmendmentEffectiveDate",
          "description": "The effective date corresponds to the Amendment Effective Date (IM)."
        }
      ]
    },
    {
      "name": "CSASpecifiedOrAccessConditionEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CSASpecifiedOrAccessConditionEnum",
      "description": "Specifies the types of events in the related Master Agreement that, when triggered, could temporarily or permanently suspend rights to rehypothecate, transfer or substitute collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "Illegality",
          "description": "Specifies an event where a party is unable to comply with its obligations under the Master Agreement because to do so would be unlawful."
        },
        {
          "text": "TaxEvent",
          "description": "Specifies an event where a party experiences changes in tax laws incurring further tax liability."
        },
        {
          "text": "TaxEventUponMerger",
          "description": "Specifies an event where a party incurs tax liability due to a merger."
        },
        {
          "text": "CreditEventUponMerger",
          "description": "Specifies an event where a party merges and the new entity becomes materially less creditworthy than the original."
        },
        {
          "text": "AdditionalTerminationEvents",
          "description": "Specifies events which could trigger rights to early termination."
        },
        {
          "text": "ForceMajeureEvent",
          "description": "Specifies an event beyond the control of one or both of the parties which prevents or renders it impossible to fulfill their obligations to the other party."
        },
        {
          "text": "PotentialTerminationEvents",
          "description": "Specifies a potential event that could trigger rights to early termination."
        }
      ]
    },
    {
      "name": "CalculationValuationAgentPartyEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationValuationAgentPartyEnum",
      "description": "Specification of which party is calculating the value of collateral to be delivered or returned.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "Party 1",
          "description": "Party 1 will calculate the value of collateral to be delivered or returned.",
          "aliases": [
            "Party1"
          ]
        },
        {
          "text": "Party 2",
          "description": "Party 2 will calculate the value of collateral to be delivered or returned.",
          "aliases": [
            "Party2"
          ]
        },
        {
          "text": "Party Making the Demand",
          "description": "The party making the demand will calculate the value of collateral to be delivered or returned.",
          "aliases": [
            "PartyMakingDemand"
          ]
        }
      ]
    },
    {
      "name": "CashCTSTimeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CashCTSTimeEnum",
      "description": "Details the day on which cash collateral is required to be transferred relative to the Notification Time.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "Same",
          "description": "The cash collateral should be transferred on the same day."
        },
        {
          "text": "Next",
          "description": "The cash collateral should be transferred on the next day."
        },
        {
          "text": "First Local Business Day",
          "description": "The cash collateral should be transferred on the first local business day.",
          "aliases": [
            "FirstLBD"
          ]
        },
        {
          "text": "Second Local Business Day",
          "description": "The cash collateral should be transferred on the second local business day.",
          "aliases": [
            "SecondLBD"
          ]
        },
        {
          "text": "Other",
          "description": "Exception value."
        }
      ]
    },
