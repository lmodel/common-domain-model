    {
      "name": "PerformanceValuationDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PerformanceValuationDates",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Defines how and when a performance type option or performance type swap is to be valued.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "performanceValuationDates__determinationMethod",
        "performanceValuationDates__valuationDates",
        "performanceValuationDates__valuationDate",
        "performanceValuationDates__valuationTime",
        "performanceValuationDates__valuationTimeType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "determinationMethod",
          "description": "Specifies the method according to which an amount or a date is determined.",
          "range": "DeterminationMethodEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationDates",
          "description": "2018 ISDA CDM Equity Confirmation for Security Equity Swap: Pricing Date",
          "range": "AdjustableRelativeOrPeriodicDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationDate",
          "description": "2018 ISDA CDM Equity Confirmation for Security Equity Swap: Pricing Date",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationTime",
          "description": "The specific time of day at which the calculation agent values the underlying. The SpecificTime is the only case when the valuationTime (time + business center location e.g. 10:00:00 USNY) should be provided. You should be able to provide just the valuationTime without valuationTimeType, which infer that this is a specific time.",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationTimeType",
          "description": "The time of day at which the calculation agent values the underlying, for example the official closing time of the exchange.",
          "range": "TimeTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PerformanceValuationDates",
      "@type": "ClassDefinition"
    },
    {
      "name": "Price",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Price",
      "description": "Specifies a price as a single value to be associated to a financial product. This data type extends PriceSchedule and requires that only the amount value exists.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "is_a": "PriceSchedule",
      "slots": [
        "schedule__value",
        "schedule__datedValue",
        "MeasureBase_unit",
        "priceSchedule__perUnitOf",
        "priceSchedule__priceType",
        "priceSchedule__priceSubType",
        "priceSchedule__priceExpression",
        "priceSchedule__composite",
        "priceSchedule__arithmeticOperator",
        "priceSchedule__premiumType",
        "priceSchedule__derivedQuantity"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Price",
      "none_of": [
        {
          "description": "From PriceSchedule. ArithmeticOperator: Operator must not be subtract or divide.",
          "slot_conditions": [
            {
              "name": "arithmeticOperator",
              "value_presence": "PRESENT",
              "equals_string": "Subtract",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "From PriceSchedule. ArithmeticOperator: Operator must not be subtract or divide.",
          "slot_conditions": [
            {
              "name": "arithmeticOperator",
              "value_presence": "PRESENT",
              "equals_string": "Divide",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "all_of": [
        {
          "description": "From Schedule. ValueExists: A schedule may be specified as a single value or as a set of date-value pairs. Both attributes may be specified, in which case the single amount number is the initial value.",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "value",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "datedValue",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "From PriceSchedule. Choice: The price can be specified mutually exclusively as an operator (e.g. a spread or multiplier) or a composite.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "arithmeticOperator",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "composite",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "arithmeticOperator",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "composite",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "AmountOnlyExists: The amount must exist when the price represents a single value, and steps must be absent.",
          "slot_conditions": [
            {
              "name": "value",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            },
            {
              "name": "datedValue",
              "value_presence": "ABSENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PriceComposite",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PriceComposite",
      "description": "Defines the inputs required to calculate a price as a simple composite of 2 other values. The inputs consist of 2 numbers and a simple arithmetic operator. This generic data type applies to a variety of use cases where a price is obtained by simple composition, e.g. dirty = clean + accrued (Bond), forward rate = spot rate + forward point (FX) etc.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "priceComposite__baseValue",
        "priceComposite__operand",
        "priceComposite__arithmeticOperator",
        "priceComposite__operandType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "baseValue",
          "description": "The 1st value in the arithmetic operation, which may be non-commutative in some cases: Subtract, Divide). This 1st operand is called 'baseValue' as it refers to the price anchor in the arithmetic operation: e.g. the clean price (Bond) or the spot rate (FX).",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "operand",
          "description": "The 2nd value in the arithmetic operation, which may be non-commutative in some cases: Subtract, Divide). The 2nd operand is called 'operand' to distinguish it from the 1st one which is the price anchor.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "arithmeticOperator",
          "description": "Specifies the arithmetic operator via an enumeration.",
          "range": "ArithmeticOperationEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "operandType",
          "description": "Optionally qualifies the type of operand: e.g. accrued or forward point.",
          "range": "PriceOperandEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PriceComposite",
      "rules": [
        {
          "preconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "operandType",
                    "value_presence": "PRESENT",
                    "equals_string": "ForwardPoint",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "operandType",
                    "value_presence": "PRESENT",
                    "equals_string": "AccruedInterest",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "arithmeticOperator",
                    "equals_string": "Add",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "arithmeticOperator",
                    "equals_string": "Subtract",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ArithmeticOperator: If operand type is accrued or forward point, then operator must be either add or subtract.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PriceQuantity",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PriceQuantity",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Defines a settlement as an exchange between two parties of a specified quantity of an asset (the quantity) against a specified quantity of another asset (the price). The settlement is optional and can be either cash or physical. The quantity can additionally be specified in terms of one or more currency amounts. In the case of non-cash products, the settlement of the price/quantity would not be specified here and instead would be delegated to the product mechanics, as parameterised by the price/quantity values.",
      "comments": [
        "Rosetta condition NonCurrencyQuantities is not stated in LinkML: (quantity count - quantity -> unit -> currency count) <= 1 or (observable as Commodity exists and quantity -> unit -> capacityUnit exists and (quantity count - quantity -> unit -> currency count) <= 2)",
        "Rosetta condition ArithmeticOperator is not stated in LinkML: if observable as InterestRateIndex exists and price exists then price -> arithmeticOperator exists",
        "Rosetta condition InterestRateObservable is not stated in LinkML: InterestRateObservableCondition",
        "Rosetta condition PriceQuantityTriangulation is not stated in LinkML: PriceQuantityTriangulation (price, quantity) = True"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "priceQuantity__price",
        "priceQuantity__quantity",
        "priceQuantity__observable",
        "priceQuantity__effectiveDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "price",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "location",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies a price to be used for trade amounts and other purposes.",
          "range": "PriceSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "quantity",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "location",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies a quantity to be associated with an event, for example a trade amount.",
          "range": "NonNegativeQuantitySchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "observable",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "location",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the object to be observed for a price, it could be an asset or an index. The cardinality is optional as some quantity / price cases have no observable (e.g. a fixed rate in a given currency).",
          "range": "Observable",
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "Specifies the date at which the price and quantity become effective. This day may be subject to adjustment in accordance with a business day convention, or could be specified as relative to a trade date, for instance. Optional cardinality, as the effective date is usually specified in the product definition, so it may only need to be specified as part of the PriceQuantity in an increase/decrease scenario for an existing trade.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PriceQuantity",
      "@type": "ClassDefinition"
    },
    {
      "name": "PriceSchedule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PriceSchedule",
      "description": "Specifies the price of a financial instrument in a trade as a schedule of measures. A price generically expresses the value of an exchange as a ratio: it measures the amount of one thing needed to be exchanged for 1 unit of another thing (e.g. cash in a specific currency in exchange for a bond or share). This generic representation can be used to support any type of financial price beyond just cash price: e.g. an interest rate, a foreign exchange rate, etc. This data type is generically based on a schedule and can also be used to represent a price as a single value.",
      "comments": [
        "Rosetta condition PositiveAssetPrice is not stated in LinkML: if (priceType = ExchangeRate or priceType = AssetPrice) and arithmeticOperator is absent then value > 0 or datedValue -> value all > 0",
        "Rosetta condition PositiveSpotRate is not stated in LinkML: if (priceType = ExchangeRate or priceType = AssetPrice) and composite -> baseValue exists then composite -> baseValue > 0",
        "Rosetta condition PositivePremium is not stated in LinkML: if priceType = Premium then value > 0",
        "Rosetta condition CurrencyUnitForInterestRate is not stated in LinkML: if priceType = PriceTypeEnum -> InterestRate then unit -> currency exists",
        "Rosetta condition ForwardPoint is not stated in LinkML: if composite -> operandType = ForwardPoint then priceType = ExchangeRate",
        "Rosetta condition AccruedInterest is not stated in LinkML: if composite -> operandType = AccruedInterest then priceType = AssetPrice",
        "Rosetta condition DerivedQuantityMultiplier is not stated in LinkML: derivedQuantity -> multiplier is absent",
        "Rosetta condition DerivedQuantityUnit is not stated in LinkML: if derivedQuantity exists and unit exists then derivedQuantity -> unit = unit",
        "Rosetta condition DerivedQuantityCurrency is not stated in LinkML: if derivedQuantity exists and unit is absent then derivedQuantity -> unit -> currency exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "is_a": "MeasureBase",
      "slots": [
        "schedule__value",
        "schedule__datedValue",
        "MeasureBase_unit",
        "priceSchedule__perUnitOf",
        "priceSchedule__priceType",
        "priceSchedule__priceSubType",
        "priceSchedule__priceExpression",
        "priceSchedule__composite",
        "priceSchedule__arithmeticOperator",
        "priceSchedule__premiumType",
        "priceSchedule__derivedQuantity"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "perUnitOf",
          "description": "Provides an attribute to define the unit of the thing being priced. For example, {amount, unitOfAmount, PerUnitOfAmount} = [10, EUR, Shares] = (10.00 EUR/SHARE) * (300,000 SHARES) = EUR 3,000,000.00 (Shares cancel out in the calculation).",
          "range": "UnitType",
          "@type": "SlotDefinition"
        },
        {
          "name": "priceType",
          "description": "Specifies the price type as an enumeration: interest rate, exchange rate, asset price etc. This attribute is mandatory so that prices can always be clasiffied according to their type. The price type implies some constraints on the price's units.",
          "range": "PriceTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "priceSubType",
          "description": "Allows further classification of the chosen price type.",
          "range": "PriceSubTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "priceExpression",
          "description": "(Optionally) Specifies whether the price is expressed in absolute or percentage terms.",
          "range": "PriceExpressionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "composite",
          "description": "(Optionally) Specifies the underlying price components if the price can be expressed as a composite: e.g. dirty price = clean price + accrued.",
          "range": "PriceComposite",
          "@type": "SlotDefinition"
        },
        {
          "name": "arithmeticOperator",
          "description": "(Optionally) When the price is to be understood as an operator to apply to an observable, i.e. a spread, multiplier or min/max.",
          "range": "ArithmeticOperationEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "premiumType",
          "description": "(Optionally) Additional attribute that can further define any premium to the price.",
          "range": "PremiumTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "derivedQuantity",
          "description": "Specifies the derived quantity associated with the price. For instance when the price is an asset price expressed in a currency, the primary quantity is the asset's quantity while the derived quantity is the corresponding monetary amount in that currency. When the price is an exchange rate, both the primary quantity and the derived quantity are monetary amounts, in the 2 currencies of the exchange rate.",
          "range": "NonNegativeQuantitySchedule",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PriceSchedule",
      "rules": [
        {
          "preconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "priceType",
                    "equals_string": "Variance",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "priceType",
                    "equals_string": "Volatility",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "priceType",
                    "equals_string": "Correlation",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "unit",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "perUnitOf",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "elseconditions": {
            "slot_conditions": [
              {
                "name": "unit",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "perUnitOf",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "UnitOfAmountExists: Requires that a unit of amount must be specified for price unless price type is Variance, Volatility or Correlation.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "premiumType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "priceType",
                "equals_string": "Premium",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Premium: If we are applying a premium to the price then we must define this as a premium in priceType.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "arithmeticOperator",
                "value_presence": "PRESENT",
                "equals_string": "Add",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "priceType",
                    "equals_string": "AssetPrice",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "priceType",
                    "equals_string": "InterestRate",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "SpreadPrice: A spread type can only be specified when the price type is an asset price or an interest rate.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "priceSubType",
                    "value_presence": "PRESENT",
                    "equals_string": "Fee",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "priceSubType",
                    "value_presence": "PRESENT",
                    "equals_string": "Rebate",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "priceType",
                "equals_string": "InterestRate",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "InterestRateFeeType: If a lending fee or rebate fee is specified then the price type must be InterestRate.",
          "@type": "ClassRule"
        }
      ],
      "none_of": [
        {
          "description": "ArithmeticOperator: Operator must not be subtract or divide.",
          "slot_conditions": [
            {
              "name": "arithmeticOperator",
              "value_presence": "PRESENT",
              "equals_string": "Subtract",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "ArithmeticOperator: Operator must not be subtract or divide.",
          "slot_conditions": [
            {
              "name": "arithmeticOperator",
              "value_presence": "PRESENT",
              "equals_string": "Divide",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "all_of": [
        {
          "description": "From Schedule. ValueExists: A schedule may be specified as a single value or as a set of date-value pairs. Both attributes may be specified, in which case the single amount number is the initial value.",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "value",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "datedValue",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "Choice: The price can be specified mutually exclusively as an operator (e.g. a spread or multiplier) or a composite.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "arithmeticOperator",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "composite",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "arithmeticOperator",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "composite",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PriceSourceDisruption",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PriceSourceDisruption",
      "description": "A data defining: the parameters used to get a price quote to replace the settlement rate option that is disrupted.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "priceSourceDisruption__fallbackReferencePrice"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "fallbackReferencePrice",
          "description": "The method, prioritised by the order it is listed in this element, to get a replacement rate for the disrupted settlement rate option.",
          "range": "FallbackReferencePrice",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PriceSourceDisruption",
      "@type": "ClassDefinition"
    },
    {
      "name": "QuotedCurrencyPair",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/QuotedCurrencyPair",
      "description": "A class that describes the composition of a rate that has been quoted or is to be quoted. This includes the two currencies and the quotation relationship between the two currencies and is used as a building block throughout the FX specification.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "quotedCurrencyPair__currency1",
        "quotedCurrencyPair__currency2",
        "quotedCurrencyPair__quoteBasis"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "currency1",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The first currency specified when a pair of currencies is to be evaluated.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "currency2",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The second currency specified when a pair of currencies is to be evaluated.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "quoteBasis",
          "description": "The method by which the exchange rate is quoted.",
          "range": "QuoteBasisEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/QuotedCurrencyPair",
      "@type": "ClassDefinition"
    },
    {
      "name": "RateObservation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RateObservation",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class defining parameters associated with an individual observation or fixing. This class forms part of the cashflow representation of a stream.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "rateObservation__resetDate",
        "rateObservation__adjustedFixingDate",
        "rateObservation__observedRate",
        "rateObservation__treatedRate",
        "rateObservation__observationWeight",
        "rateObservation__rateReference",
        "rateObservation__forecastRate",
        "rateObservation__treatedForecastRate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "resetDate",
          "description": "The reset date.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedFixingDate",
          "description": "The adjusted fixing date, i.e. the actual date the rate is observed. The date should already be adjusted for any applicable business day convention.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "observedRate",
          "description": "The actual observed rate before any required rate treatment is applied, e.g. before converting a rate quoted on a discount basis to an equivalent yield. An observed rate of 5% would be represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "treatedRate",
          "description": "The observed rate after any required rate treatment is applied. A treated rate of 5% would be represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "observationWeight",
          "description": "The number of days weighting to be associated with the rate observation, i.e. the number of days such rate is in effect. This is applicable in the case of a weighted average method of calculation where more than one reset date is established for a single calculation period.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "rateReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A pointer style reference to a floating rate component defined as part of a stub calculation period amount component. It is only required when it is necessary to distinguish two rate observations for the same fixing date which could occur when linear interpolation of two different rates occurs for a stub calculation period.",
          "range": "RateObservation",
          "@type": "SlotDefinition"
        },
        {
          "name": "forecastRate",
          "description": "The value representing the forecast rate used to calculate the forecast future value of the accrual period.A value of 1% should be represented as 0.01.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "treatedForecastRate",
          "description": "The value representing the forecast rate after applying rate treatment rules. A value of 1% should be represented as 0.01.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/RateObservation",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "observationWeight",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "observationWeight",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PositiveObservationWeight: FpML specifies observationWeight as a positive integer.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ReferenceSwapCurve",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ReferenceSwapCurve",
      "description": "A complex type used to specify the option and convertible bond option strike when expressed in reference to a swap curve.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "referenceSwapCurve__swapUnwindValue",
        "referenceSwapCurve__makeWholeAmount"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "swapUnwindValue",
          "range": "SwapCurveValuation",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "makeWholeAmount",
          "description": "Amount to be paid by the buyer of the option if the option is exercised prior to the Early Call Date. (The market practice in the convertible bond option space being that the buyer should be penalised if he/she exercises the option early on.)",
          "range": "MakeWholeAmount",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ReferenceSwapCurve",
      "@type": "ClassDefinition"
    },
    {
      "name": "SingleValuationDate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SingleValuationDate",
      "description": "A class to specify the number of business days after satisfaction of all conditions to settlement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "singleValuationDate__businessDays"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "businessDays",
          "description": "A number of business days. Its precise meaning is dependant on the context in which this element is used. ISDA 2003 Term: Business Day.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SingleValuationDate",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "businessDays",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "businessDays",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NonNegativeBusinessDays: FpML specifies businessDays as a NonNegativeInteger.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "SwapCurveValuation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SwapCurveValuation",
      "description": "A class to specify a valuation swap curve, which is used as part of the strike construct for the bond and convertible bond options.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "swapCurveValuation__floatingRateIndex",
        "swapCurveValuation__indexTenor",
        "swapCurveValuation__spread",
        "swapCurveValuation__side"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "floatingRateIndex",
          "range": "FloatingRateIndexEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "indexTenor",
          "description": "The ISDA Designated Maturity, i.e. the tenor of the floating rate.",
          "range": "Period",
          "@type": "SlotDefinition"
        },
        {
          "name": "spread",
          "description": "Spread in basis points over the floating rate index.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "side",
          "description": "The side (bid/mid/ask) of the measure.",
          "range": "QuotationSideEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SwapCurveValuation",
      "@type": "ClassDefinition"
    },
    {
      "name": "TransactedPrice",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TransactedPrice",
      "description": "A class to represent the transacted price attributes that are positioned as part of the FpML FeeLeg.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "transactedPrice__marketFixedRate",
        "transactedPrice__initialPoints",
        "transactedPrice__marketPrice",
        "transactedPrice__quotationStyle"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "marketFixedRate",
          "description": "An optional element that only has meaning in a credit index trade. This element contains the credit spread ('fair value') at which the trade was executed. Unlike the fixedRate of an index, the marketFixedRate varies over the life of the index depending on market conditions. The marketFixedRate is the price of the index as quoted by trading desks.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "initialPoints",
          "description": "An optional element that contains the up-front points expressed as a percentage of the notional. An initialPoints value of 5% would be represented as 0.05. The initialPoints element is an alternative to marketFixedRate in quoting the traded level of a trade. When initialPoints is used, the traded level is the sum of fixedRate and initialPoints. The initialPoints is one of the items that are factored into the initialPayment calculation and is payable by the Buyer to the Seller. Note that initialPoints and marketFixedRate may both be present in the same document when both implied values are desired.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "marketPrice",
          "description": "An optional element that only has meaning in a credit index trade. This element contains the price at which the trade was executed and is used instead of marketFixedRate on credit trades on certain indicies which are quoted using a price rather than a spread.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "quotationStyle",
          "description": "An optional element that contains the up-front points expressed as a percentage of the notional. An initialPoints value of 5% would be represented as 0.05. The initialPoints element is an alternative to marketFixedRate in quoting the traded level of a trade. When initialPoints is used, the traded level is the sum of fixedRate and initialPoints. The initialPoints is one of the items that are factored into the initialPayment calculation and is payable by the Buyer to the Seller. Note that initialPoints and marketFixedRate may both be present in the same document when both implied values are desired.",
          "range": "QuotationStyleEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TransactedPrice",
      "@type": "ClassDefinition"
    },
    {
      "name": "ValuationDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ValuationDates",
      "description": "Defines how and when a performance type option or performance type swap is to be valued, including initial, interim and final valuation dates.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "valuationDates__initialValuationDate",
        "valuationDates__interimValuationDate",
        "valuationDates__finalValuationDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
