    {
      "name": "CalculationCurrencyElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationCurrencyElection",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 paragraph 13 General Principles clause (ee)(3",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify the ISDA SIMM Calculation Currency.",
      "comments": [
        "Rosetta condition BaseCurrency is not stated in LinkML: if isBaseCurrency = True then currency is absent else currency exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "calculationCurrencyElection__party",
        "calculationCurrencyElection__isBaseCurrency",
        "calculationCurrencyElection__currency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "party",
          "description": "The party which the SIMM Calculation Currency qualification applies to.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "isBaseCurrency",
          "description": "The SIMM Calculation Currency (also known as SIMM Reporting Currency) means the Base Currency when True. It means a different currency when False. In that latter case, the SIMM Calculation Currency is specified as part of the currency attribute.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The currency in which the ISDA SIMM Calculation is denominated, when different from the Base Currency. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculationCurrencyElection",
      "@type": "ClassDefinition"
    },
