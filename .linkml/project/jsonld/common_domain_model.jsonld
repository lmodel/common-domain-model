        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PrimitiveInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "QuantityChangeInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/QuantityChangeInstruction",
      "description": "Instructions required to create a Quantity Change Primitive Event, which can be either an increase, a decrease or a replacement. An increase adds a new trade lot to the original trade, whereas a decrease subtracts from an existing trade lot's quantity. A replacement updates the quantity of an existing trade lot to the new value.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "quantityChangeInstruction__change",
        "quantityChangeInstruction__direction",
        "quantityChangeInstruction__lotIdentifier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "change",
          "description": "Quantity by which the trade is being increased, decreased or replaced, and the price at which such quantity change is agreed. The quantity change should always be specified as a positive number, with the direction (increase/decrease/replacement) being specified by the direction enumeration. A fee can also be associated to the quantity change by specifying a Price component of type CashPrice, including the corresponding settlement date and direction.",
          "range": "PriceQuantity",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "direction",
          "description": "Direction of the quantity change specified as either an increase, decrease or replacement.",
          "range": "QuantityChangeDirectionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "lotIdentifier",
          "description": "Identifier for the new lot (in case of increase) or for the existing lot to be changed(in case of decrease or replacement). This optional attribute is mandatory in case of a decrease or replacement if the initial trade state contains multiple trade lots.",
          "range": "Identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/QuantityChangeInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "Reset",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Reset",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Defines the reset value or fixing value produced in cashflow calculations, during the life-cycle of a financial instrument. The reset process defined in Create_Reset function joins product definition details with observations to compute the reset value.",
      "comments": [
        "Rosetta condition AveragingMethodologyExists is not stated in LinkML: if observations count > 1 then averagingMethodology exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "reset__resetValue",
        "reset__resetDate",
        "reset__rateRecordDate",
        "reset__observations",
        "reset__averagingMethodology"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "resetValue",
          "description": "Specifies the reset or fixing value. The fixing value could be a cash price, interest rate, or other value.",
          "range": "Price",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "resetDate",
          "description": "Specifies the date on which the reset occurred.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "rateRecordDate",
          "description": "Specifies the 'Rate Record Day' for a Fallback rate. Fallback rate fixing processes typically set the fixing rate in arrears, i.e., the Fallback Rate corresponding to a Rate Record Date is set at the end of the interest accural period. When this applies, Reset->resetDate occurs at the end of the interest period, and the Reset->rateRecordDate occurs near the start of the interest period. The Reset->rateRecordDate and Reset->observations->observationIdentifier->observationDate will differ if a Fallback rate is unavailable on the Rate Record Date, and the latest previous available rate is used as the observation.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "observations",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Represents an audit of the observations used to produce the reset value. If multiple observations were necessary to produce the reset value, the aggregation method should be defined on the payout.",
          "range": "Observation",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "averagingMethodology",
          "description": "Identifies the aggregation method to use in the case where multiple observations are used to compute the reset value and the method is not defined in a payout.",
          "range": "AveragingCalculation",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Reset",
      "@type": "ClassDefinition"
    },
    {
      "name": "ResetInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ResetInstruction",
      "description": "Defines the information needed to execute a Reset Business Event.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "resetInstruction__reset"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "reset",
          "description": "Specifies the terms of the Reset.",
          "range": "Reset",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ResetInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "ReturnInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ReturnInstruction",
