    {
      "name": "RestructuringEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RestructuringEnum",
      "description": "The enumerated values to specify the form of the restructuring credit event that is applicable to the credit default swap.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "permissible_values": [
        {
          "text": "ModModR",
          "description": "Restructuring (Section 4.7) and Modified Restructuring Maturity Limitation and Conditionally Transferable Obligation (2014 Definitions: Section 3.31, 2003 Definitions: 2.32) apply."
        },
        {
          "text": "ModR",
          "description": "Restructuring (Section 4.7) and Restructuring Maturity Limitation and Fully Transferable Obligation (2014 Definitions: Section 3.31, 2003 Definitions: 2.32) apply."
        },
        {
          "text": "R",
          "description": "Restructuring as defined in the applicable ISDA Credit Derivatives Definitions. (2003 or 2014)."
        }
      ]
    },
    {
      "name": "ShareExtraordinaryEventEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum",
      "description": "The enumerated values to specify the consequences of extraordinary events relating to the underlying.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "permissible_values": [
        {
          "text": "AlternativeObligation",
          "description": "The trade continues such that the underlying now consists of the New Shares and/or the Other Consideration, if any, and the proceeds of any redemption, if any, that the holder of the underlying Shares would have been entitled to."
        },
        {
          "text": "CancellationAndPayment",
          "description": "The trade is cancelled and a cancellation fee will be paid by one party to the other."
        },
        {
          "text": "OptionsExchange",
          "description": "The trade will be adjusted by the Calculation Agent in accordance with the adjustments made by any exchange on which options on the underlying are listed."
        },
        {
          "text": "CalculationAgent",
          "description": "The Calculation Agent will determine what adjustment is required to offset any change to the economics of the trade. If the Calculation Agent cannot achieve this, the trade goes to Cancellation and Payment with the Calculation Agent deciding on the value of the cancellation fee. Adjustments may not be made to account solely for changes in volatility, expected dividends, stock loan rate or liquidity."
        },
        {
          "text": "ModifiedCalculationAgent",
          "description": "The Calculation Agent will determine what adjustment is required to offset any change to the economics of the trade. If the Calculation Agent cannot achieve this, the trade goes to Cancellation and Payment with the Calculation Agent deciding on the value of the cancellation fee. Adjustments to account for changes in volatility, expected dividends, stock loan rate or liquidity are allowed."
        },
        {
          "text": "PartialCancellationAndPayment",
          "description": "Applies to Basket Transactions. The portion of the Basket made up by the affected Share will be cancelled and a cancellation fee will be paid from one party to the other. The remainder of the trade continues."
        },
        {
          "text": "Component",
          "description": "If this is a Share-for-Combined merger event (Shares are replaced with New Shares and Other Consideration), then different treatment can be applied to each component if the parties have specified this."
        }
      ]
    },
    {
      "name": "TriggerTimeTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TriggerTimeTypeEnum",
      "description": "The enumerated values to specify the time of day which would be considered for valuing the knock event.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "permissible_values": [
        {
          "text": "Closing",
          "description": "The close of trading on a day would be considered for valuation."
        },
        {
          "text": "Anytime",
          "description": "At any time during the Knock Determination period (continuous barrier)."
        }
      ]
    },
    {
      "name": "TriggerTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TriggerTypeEnum",
      "description": "The enumerated values to specify whether an option will trigger or expire depending upon whether the spot rate is above or below the barrier rate.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "permissible_values": [
        {
          "text": "EqualOrLess",
          "description": "The underlier price must be equal to or less than the Trigger level."
        },
        {
          "text": "EqualOrGreater",
          "description": "The underlier price must be equal to or greater than the Trigger level."
        },
        {
          "text": "Equal",
          "description": "The underlier price must be equal to the Trigger level."
        },
        {
          "text": "Less",
          "description": "The underlier price must be less than the Trigger level."
        },
        {
          "text": "Greater",
          "description": "The underlier price must be greater than the Trigger level."
        }
      ]
    },
    {
      "name": "BankHolidayTreatmentEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/BankHolidayTreatmentEnum",
      "description": "Defines whether the bank holidays are treated as weekdays or weekends in terms of delivery profile in the context of commodity products, in particular those with peak or off-peak delivery profiles.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "permissible_values": [
        {
          "text": "AsWeekday",
          "description": "Bank holidays treated as weekdays."
        },
        {
          "text": "AsWeekend",
          "description": "Bank holidays treated as weekends."
        }
      ]
    },
    {
      "name": "CompoundingMethodEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CompoundingMethodEnum",
      "description": "The enumerated values to specify the type of compounding, e.g. flat, straight.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "permissible_values": [
        {
          "text": "Flat",
          "description": "Flat compounding. Compounding excludes the spread. Note that the first compounding period has it's interest calculated including any spread then subsequent periods compound this at a rate excluding the spread."
        },
        {
          "text": "None",
          "description": "No compounding is to be applied."
        },
        {
          "text": "Straight",
          "description": "Straight compounding. Compounding includes the spread."
        },
        {
          "text": "SpreadExclusive",
          "description": "Spread Exclusive compounding."
        }
      ]
    },
    {
      "name": "CreditSeniorityEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditSeniorityEnum",
      "annotations": [
