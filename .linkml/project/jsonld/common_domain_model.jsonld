          "description": "The calculation rule.",
          "range": "PaymentRule",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentAmount",
          "description": "A fixed payment amount.",
          "range": "Money",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PaymentDetail",
      "@type": "ClassDefinition"
