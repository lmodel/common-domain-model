    {
      "name": "AverageTradingVolume",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AverageTradingVolume",
      "description": "Represents the average trading volume of an Equity product upon an exchange or set of exchanges.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "averageTradingVolume__period",
        "averageTradingVolume__methodology"
      ],
