              "value": "address \"pointsTo\"=PriceQuantity->observable",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the object to be observed for a price, it could be an asset or a reference.",
          "range": "Observable",
          "@type": "SlotDefinition"
        },
        {
          "name": "Product",
          "description": "Enables either a TransferableProduct or a NonTransferableProduct to be used in an underlier.",
          "range": "Product",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Underlier",
      "all_of": [
