      "@type": "ClassDefinition"
    },
    {
      "name": "FinalCalculationPeriodDateAdjustment",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FinalCalculationPeriodDateAdjustment",
      "description": "A data to: define business date convention adjustment to final payment period per leg.",
      "comments": [
        "Rosetta condition IsInterestRatePayout is not stated in LinkML: if swapStreamReference exists then swapStreamReference switch InterestRatePayout then item exists, default False"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "finalCalculationPeriodDateAdjustment__relevantUnderlyingDateReference",
        "finalCalculationPeriodDateAdjustment__swapStreamReference",
        "finalCalculationPeriodDateAdjustment__businessDayConvention"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "relevantUnderlyingDateReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to the unadjusted cancellation effective dates.",
          "range": "AdjustableOrRelativeDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "swapStreamReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to the leg, where date adjustments may apply.",
          "range": "Payout",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "businessDayConvention",
          "description": "Override business date convention. This takes precedence over leg level information.",
          "range": "BusinessDayConventionEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FinalCalculationPeriodDateAdjustment",
      "@type": "ClassDefinition"
    },
    {
      "name": "FxLinkedNotionalAmount",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FxLinkedNotionalAmount",
      "description": "A data to: describe the cashflow representation for FX linked notionals.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "fxLinkedNotionalAmount__resetDate",
        "fxLinkedNotionalAmount__adjustedFxSpotFixingDate",
        "fxLinkedNotionalAmount__observedFxSpotRate",
        "fxLinkedNotionalAmount__notionalAmount"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "resetDate",
          "description": "The reset date.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedFxSpotFixingDate",
          "description": "The date on which the FX spot rate is observed. This date should already be adjusted for any applicable business day convention.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "observedFxSpotRate",
          "description": "The actual observed FX spot rate.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "notionalAmount",
          "description": "The calculation period notional amount.",
          "range": "decimal",
