    {
      "name": "AdditionalRightsEvent",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AdditionalRightsEvent",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSD_IM_English_2016 paragraph 13 General Principles clause (k) name Chargor Additional Rights Event | ISDA CSA_IM_Japanese_2016 paragraph 13 General Principles clause (k) name Obligor Additional Rights Event | ISDA CSA_IM_NewYork_2016 paragraph 13 General Principles clause (k) name Pledgor Additional Rights Event",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify the Pledgor/Obligor/Chargor Additional Rights Event election.",
      "comments": [
        "Rosetta condition Qualification is not stated in LinkML: if qualification exists then isApplicable = True"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "additionalRightsEvent__isApplicable",
        "additionalRightsEvent__qualification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "isApplicable",
          "description": "The Pledgor Additional Rights Event election is applicable when True, and not applicable when False.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "qualification",
          "description": "The qualification of the Pledgor Additional Rights Event election, when specified.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AdditionalRightsEvent",
      "@type": "ClassDefinition"
    },
    {
      "name": "AdditionalType",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AdditionalType",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 paragraph 13 General Principles clause (b)(B)",
          "@type": "Annotation"
        }
      ],
      "description": "The specification of the Additional Type of transaction that can require the collection or delivery of initial margin under a given regulatory regime for the purposes of Covered Transactions.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "additionalType__standardValue",
        "additionalType__customValue"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "standardValue",
          "description": "The qualification of the Additional Type of transaction that can require the collection or delivery of initial margin when specified as a standard value.",
          "range": "AdditionalTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "customValue",
          "description": "The qualification of the Additional Type of transaction that can require the collection or delivery of initial margin when specified as a custom value by the parties to the legal agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AdditionalType",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "standardValue",
                "equals_string": "Other",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "customValue",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CustomValue: The specification of a custom value by the parties to the legal agreement takes place alongside the qualification of the `Other` value as part of the AdditionalTypeEnum.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "standardValue",
                    "value_presence": "PRESENT",
                    "equals_string": "Other",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "customValue",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "StandardValue: The specification of a standard value by the parties to the legal agreement is done through the qualification of a value distinct than `Other` as part of the AdditionalTypeEnum, and implies that the customerValue is not being qualified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
