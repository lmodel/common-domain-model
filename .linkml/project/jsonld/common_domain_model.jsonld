    {
      "name": "CompoundingTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CompoundingTypeEnum",
      "description": "The enumerated values to specify how the compounding calculation is done",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "permissible_values": [
        {
          "text": "None",
          "description": "Compounding is not applicable"
        },
        {
          "text": "Business",
          "description": "Compounding is done only on business days, i.e. not compounded each day on weekends or holidays."
        },
        {
          "text": "Calendar",
          "description": "Compounding is done on each calendar day."
        }
      ]
    },
    {
      "name": "DayOfWeekEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum",
      "description": "The enumerated values to specify a day of the seven-day week.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "permissible_values": [
        {
          "text": "MON",
          "description": "Monday"
        },
        {
          "text": "TUE",
          "description": "Tuesday"
        },
        {
          "text": "WED",
          "description": "Wednesday"
        },
        {
          "text": "THU",
          "description": "Thursday"
        },
        {
          "text": "FRI",
          "description": "Friday"
        },
        {
          "text": "SAT",
          "description": "Saturday"
        },
        {
          "text": "SUN",
          "description": "Sunday"
        }
      ]
    },
    {
      "name": "DayTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DayTypeEnum",
      "description": "Lists the enumerated values to specify the day type classification used in counting the number of days between two dates.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "permissible_values": [
        {
          "text": "Business",
          "description": "Applies when calculating the number of days between two dates the count includes only business days."
        },
        {
          "text": "Calendar",
          "description": "Applies when calculating the number of days between two dates the count includes all calendar days."
        },
        {
          "text": "CurrencyBusiness",
          "description": "Applies when calculating the number of days between two dates the count includes only currency business days."
        },
        {
          "text": "ExchangeBusiness",
          "description": "Applies when calculating the number of days between two dates the count includes only stock exchange business days."
        },
        {
          "text": "ScheduledTradingDay",
          "description": "Applies when calculating the number of days between two dates the count includes only scheduled trading days."
        }
      ]
    },
    {
      "name": "PeriodEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PeriodEnum",
      "description": "The enumerated values to specify the period, e.g. day, week.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "permissible_values": [
        {
          "text": "D",
          "description": "Day"
        },
        {
          "text": "W",
          "description": "Week"
        },
        {
          "text": "M",
          "description": "Month"
        },
        {
