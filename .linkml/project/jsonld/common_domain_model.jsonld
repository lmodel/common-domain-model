    {
      "name": "CollateralValueMethod",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralValueMethod",
      "description": "Details how particular types of collateral are valued (other than in respect of a default).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "collateralValueMethod__cashCollateral",
        "collateralValueMethod__securitiesCollateral",
        "collateralValueMethod__additionalLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cashCollateral",
          "description": "Details of how cash collateral is valued.",
          "range": "ValueCashEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "securitiesCollateral",
          "description": "Details of how securities collateral is valued.",
          "range": "ValueSecuritiesEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalLanguage",
          "description": "The additional language that might be specified by the parties to the legal agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralValueMethod",
      "rules": [
        {
          "preconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "cashCollateral",
                    "value_presence": "PRESENT",
                    "equals_string": "Other",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "securitiesCollateral",
                    "value_presence": "PRESENT",
                    "equals_string": "Other",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "additionalLanguage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "OtherValues: Additional language is required when 'Other' values are used.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ConditionsPrecedent",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ConditionsPrecedent",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 paragraph 4 clause (a) | ISDA CSA_VM_2016 paragraph 4 clause (a) | ISDA CSD_IM_English_2016 paragraph 13 General Principles clause (e) name  Conditions Precedent | ISDA CSD_IM_English_2018 paragraph 13 General Principles clause (e) name  Conditions Precedent | ISDA CSA_IM_Japanese_2016 paragraph 13 General Principles clause (f) name  Conditions Precedent | ISDA CSA_IM_NewYork_2016 paragraph 13 General Principles clause (e) name  Conditions Precedent | ISDA CSA_VM_2016 paragraph 13 clause (e) name Conditions Precedent and Secured Partys Rights and Remedies | ISDA CSD_English_1995 paragraph 13 clause (e) name Conditions Precedent and Secured Partys Rights and Remedies. | ISDA CSA_NewYork_1994 paragraph 13 clause (d) name Conditions Precedent and Secured Partys Rights and Remedies.",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify the two set of elections that may overwrite the default Condition Precedent provision.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "conditionsPrecedent__conditionsPrecedentElection",
        "conditionsPrecedent__customProvision",
        "conditionsPrecedent__specifiedConditionOrAccessCondition"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "conditionsPrecedentElection",
          "description": "The election to specify whether the standard Conditions Precedent apply.",
          "range": "ExceptionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "customProvision",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ISDA CSA_IM_2016 paragraph 4 clause (a) | ISDA CSA_VM_2016 paragraph 4 clause (a) | ISDA CSD_IM_English_2016 paragraph 13 General Principles clause (e)(i) | ISDA CSA_IM_Japanese_2016 paragraph 13 General Principles clause (f)(i) | ISDA CSA_IM_NewYork_2016 paragraph 13 General Principles clause (e)(i) | ISDA CSA_VM_2016 paragraph 13 name Conditions Precedent and Secured Partys Rights and Remedies",
              "@type": "Annotation"
            }
          ],
          "description": "The custom provisions that might be specified by the parties to the agreement for the purpose of overwriting the default Condition Precedent provision specified in the CSA.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "specifiedConditionOrAccessCondition",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ISDA CSD_English_1995 paragraph 13 clause (e) name Conditions Precedent and Secured Partys Rights and Remedies. | ISDA CSA_NewYork_1994 paragraph 13 clause (d) name Conditions Precedent and Secured Partys Rights and Remedies. | ISDA CSD_IM_English_2016 paragraph 13 General Principles clause (e)(ii) | ISDA CSA_IM_Japanese_2016 paragraph 13 General Principles clause (f)(ii) | ISDA CSA_IM_NewYork_2016 paragraph 13 General Principles clause (e)(ii) | ISDA CSA_VM_2016 paragraph 13 clause (e) name Conditions Precedent and Secured Partys Rights and Remedies.",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the events elected by the parties that are deemed an Access Condition (for Initial Margin CSA) or a Specified Condition (for Variation Margin and Legacy CSA), which, if triggered, may temporarily or permanently suspend rights to rehypothecate, transfer, or substitute collateral.",
          "range": "SpecifiedConditionOrAccessCondition",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ConditionsPrecedent",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "customProvision",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "conditionsPrecedentElection",
                "value_presence": "PRESENT",
                "equals_string": "Other",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CustomProvision: When a Custom Provision is specified then the Conditions Precedent Election should be absent.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
