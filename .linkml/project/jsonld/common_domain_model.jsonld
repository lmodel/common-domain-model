        "assetBase__party",
        "assetBase__partyRole",
        "assetBase__ancillaryPartyRole",
        "assetBase__assetType",
        "basket__basketConstituent"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "basketConstituent",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "location",
              "@type": "Annotation"
            }
          ],
          "description": "Identifies the constituents of the basket",
          "range": "BasketConstituent",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Basket",
      "all_of": [
        {
          "description": "AssetType: Asset type must be Security.",
          "slot_conditions": [
            {
              "name": "assetType",
              "equals_string": "Security",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "BasketConstituent",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/BasketConstituent",
      "description": "Identifies the constituents of the basket",
      "comments": [
        "Rosetta condition BasketsOfBaskets is not stated in LinkML: observable as Basket is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "basketConstituent__observable",
        "basketConstituent__quantity",
        "basketConstituent__initialValuationPrice",
        "basketConstituent__interimValuationPrice",
        "basketConstituent__finalValuationPrice"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "observable",
          "description": "Specifies the object to be observed for a price, it could be an asset or a reference, within the context of a Basket",
          "range": "Observable",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "quantity",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->quantity",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies a quantity schedule to be associated to an individual underlier that is a basket constituent. The multiple cardinality is aligned to the one of the PriceQuantity->quantity that this quantity is referencing.",
          "range": "NonNegativeQuantitySchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "initialValuationPrice",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->price",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies an initial price schedule to be associated to an individual underlier that is a basket constituent. The multiple cardinality is aligned to the one of the PriceQuantity->price that this price is referencing.",
          "range": "PriceSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "interimValuationPrice",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->price",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies an interim price schedule to be associated to an individual underlier that is a basket constituent. The multiple cardinality is aligned to the one of the PriceQuantity->price that this price is referencing.",
          "range": "PriceSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "finalValuationPrice",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->price",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies a final price schedule to be associated to an individual underlier that is a basket constituent. The multiple cardinality is aligned to the one of the PriceQuantity->price that this price is referencing.",
          "range": "PriceSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/BasketConstituent",
      "@type": "ClassDefinition"
    },
    {
      "name": "CalculationAgent",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationAgent",
      "description": "A class defining the ISDA calculation agent responsible for performing duties as defined in the applicable product definitions.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "calculationAgent__calculationAgentParty",
        "calculationAgent__calculationAgentPartyEnum",
        "calculationAgent__calculationAgentBusinessCenter"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "calculationAgentParty",
          "description": "Specifies the party which is the ISDA Calculation Agent for the trade. If more than one party is referenced then the parties are assumed to be co-calculation agents, i.e. they have joint responsibility.",
          "range": "AncillaryRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationAgentPartyEnum",
          "description": "Specifies the ISDA calculation agent responsible for performing duties as defined in the applicable product definitions. For example, the Calculation Agent may be defined as being the Non-exercising Party.",
          "range": "PartyDeterminationEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationAgentBusinessCenter",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The city in which the office through which ISDA Calculation Agent is acting for purposes of the transaction is located The short-form confirm for a trade that is executed under a Sovereign or Asia Pacific Master Confirmation Agreement ( MCA ), does not need to specify the Calculation Agent. However, the confirm does need to specify the Calculation Agent City. This is due to the fact that the MCA sets the value for Calculation Agent but does not set the value for Calculation Agent City.",
          "range": "BusinessCenter",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculationAgent",
      "all_of": [
        {
          "description": "CalculationAgentChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "calculationAgentParty",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "calculationAgentPartyEnum",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "calculationAgentParty",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "calculationAgentPartyEnum",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CashCollateralValuationMethod",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CashCollateralValuationMethod",
      "description": "This type is a generic structure that can represent the parameters of several mid-market valuation and replacement value methods described in the 2021 ISDA Definitions.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "cashCollateralValuationMethod__applicableCsa",
        "cashCollateralValuationMethod__cashCollateralCurrency",
        "cashCollateralValuationMethod__cashCollateralInterestRate",
        "cashCollateralValuationMethod__agreedDiscountRate",
        "cashCollateralValuationMethod__protectedParty",
        "cashCollateralValuationMethod__prescribedDocumentationAdjustment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicableCsa",
          "description": "This may be used to specify what type of CSA (credit support annex/agreement) is to be used for cash settlement purposes.",
          "range": "CsaTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "cashCollateralCurrency",
          "description": "This may be used to indicate the currency of cash collateral for cash settlement purposes.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "cashCollateralInterestRate",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "This may be used to indicate the interest rate to be used for cash collateral for cash settlement purposes.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "agreedDiscountRate",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "This may be used to indicate the discount rate to be used for cash collateral for cash settlement purposes.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "protectedParty",
          "description": "This may be used to specify which party is protected (e.g. under Replacement Value cash settlement methods).",
          "range": "PartyDeterminationEnum",
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "prescribedDocumentationAdjustment",
          "description": "This may be used to indicate that 'prescribed documentation adjustment' is applicable.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CashCollateralValuationMethod",
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditIndex",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditIndex",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Specification of an index based on credit risk, typically composed using corporate debt instruments in a region or industry sector, e.g. the iTraxx indices.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "is_a": "IndexBase",
      "slots": [
        "assetBase__identifier",
        "assetBase__taxonomy",
        "assetBase__isExchangeListed",
        "assetBase__party",
        "assetBase__partyRole",
        "assetBase__ancillaryPartyRole",
        "assetBase__assetType",
        "IndexBase_name",
        "indexBase__provider",
        "indexBase__assetClass",
        "creditIndex__indexSeries",
        "creditIndex__indexAnnexVersion",
        "creditIndex__indexAnnexDate",
        "creditIndex__indexAnnexSource",
        "creditIndex__excludedReferenceEntity",
        "creditIndex__tranche",
        "creditIndex__settledEntityMatrix",
        "creditIndex__indexFactor",
        "creditIndex__seniority"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "indexSeries",
          "description": "A CDS index series identifier, e.g. 1, 2, 3 etc.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "indexAnnexVersion",
          "description": "A CDS index series version identifier, e.g. 1, 2, 3 etc.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "indexAnnexDate",
          "description": "A CDS index series annex date.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "indexAnnexSource",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "A CDS index series annex source.",
          "range": "IndexAnnexSourceEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "excludedReferenceEntity",
          "description": "Excluded reference entity.",
          "range": "ReferenceInformation",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tranche",
          "description": "This element contains CDS tranche terms.",
          "range": "Tranche",
          "@type": "SlotDefinition"
        },
        {
          "name": "settledEntityMatrix",
          "description": "Used to specify the Relevant Settled Entity Matrix when there are settled entities at the time of the trade.",
          "range": "SettledEntityMatrix",
          "@type": "SlotDefinition"
        },
        {
          "name": "indexFactor",
          "description": "Index Factor is the index version factor or percent, expressed as an absolute decimal value between 0 and 1, that multiplied by the original notional amount yields the notional amount covered by the seller of protection.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "seniority",
          "description": "Seniority of debt instruments comprising the index.",
          "range": "CreditSeniorityEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditIndex",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "indexSeries",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "indexSeries",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "IndexSeries: FpML specifies the type associated to indexSeries as a positive integer.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "indexAnnexVersion",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "indexAnnexVersion",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "IndexAnnexVersion: FpML specifies the type associated to indexVersion as a positive integer.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "indexFactor",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "all_of": [
              {
                "slot_conditions": [
                  {
                    "name": "indexFactor",
                    "minimum_value": 0,
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "indexFactor",
                    "maximum_value": 1,
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "IndexFactor: Index factor is expressed as a decimal and should be a positive number between o and 1.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "From IndexBase. AssetType: Asset type must be Other.",
          "slot_conditions": [
            {
              "name": "assetType",
              "equals_string": "Other",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "CreditAssetClass: The asset class must be Credit.",
          "slot_conditions": [
            {
              "name": "assetClass",
              "value_presence": "PRESENT",
              "equals_string": "Credit",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditNotation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditNotation",
      "description": "Represents a class to specify the credit notation as the combination of agency, notation, scale and debt type qualifications.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "creditNotation__agency",
        "creditNotation__notation",
        "creditNotation__scale",
        "creditNotation__debt",
        "creditNotation__outlook",
        "creditNotation__creditWatch"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "agency",
          "description": "Specifies The credit agency to which the other variables (notation, scale, debt type) refer to.",
          "range": "CreditRatingAgencyEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "notation",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies The credit rating notation. As it varies among credit rating agencies, FpML doesn't specify a default scheme.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "scale",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the credit rating scale, with a typical distinction between short term, long term. FpML doesn't specify a default scheme, which is hence not specified as an enumeration as part of the CDM.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "debt",
          "description": "Specifies the credit rating debt type (e.g. long term, high yield, deposits, ...) associated with the credit rating notation and scale.",
          "range": "CreditRatingDebt",
          "@type": "SlotDefinition"
        },
        {
          "name": "outlook",
          "description": "Assesses the potential direction of a long-term credit rating over the intermediate term, which is generally up to two years for investment grade and generally up to one year for speculative grade.",
          "range": "CreditRatingOutlookEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "creditWatch",
          "description": "Indicates the potential direction of a short-term or long-term rating. It focuses on identifiable events and short-term trends that cause ratings to be placed under special surveillance.",
          "range": "CreditRatingCreditWatchEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditNotation",
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditNotations",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditNotations",
      "description": "Represents the credit rating notation higher level construct, which provides the ability to specify multiple rating notations.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "creditNotations__creditNotation",
        "creditNotations__creditNotations"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "creditNotation",
          "description": "Specifies only one credit notation is determined.",
          "range": "CreditNotation",
          "@type": "SlotDefinition"
        },
        {
          "name": "creditNotations",
          "description": "Specifies if several credit notations exist, alongside an 'any' or 'all' or all condition.",
          "range": "MultipleCreditNotations",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditNotations",
      "all_of": [
        {
          "description": "Unnamed condition (one-of)",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "creditNotation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "creditNotations",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditRatingDebt",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditRatingDebt",
      "description": "Specifies the credit rating debt type(s) associated with the credit rating notation and scale. When several debt types are specified, they must be qualified through an 'any' or 'all'.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "creditRatingDebt__debtType",
        "creditRatingDebt__debtTypes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "debtType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies when there is only one debt type. FpML doesn't specify values in relation to the associated scheme, which is hence not specified as an enumeration as part of the CDM.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "debtTypes",
          "description": "Specifies if there are several debt types, alongside an 'any' or 'all' or all condition. As an example, Baa1 rating is required for any long term debt and deposit.",
