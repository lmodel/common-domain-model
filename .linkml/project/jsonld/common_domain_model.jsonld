        },
        {
          "name": "triggerType",
          "description": "The Triggering condition.",
          "range": "TriggerTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "triggerTimeType",
          "description": "The valuation time type of knock condition.",
          "range": "TriggerTimeTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Trigger",
      "all_of": [
        {
          "description": "Choice1: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "level",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "creditEvents",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "creditEventsReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
