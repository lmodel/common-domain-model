    {
      "name": "Workflow",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Workflow",
      "description": "A collection of workflow steps which together make up an entire workflow sequence.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "workflow__steps"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "steps",
          "range": "WorkflowStep",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Workflow",
      "@type": "ClassDefinition"
    },
    {
      "name": "WorkflowState",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/WorkflowState",
      "description": "A class to specify workflow information, which is conceptually applicable to all lifecycle events.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "workflowState__workflowStatus",
        "workflowState__comment",
        "workflowState__partyCustomisedWorkflow",
        "workflowState__warehouseIdentity"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "workflowStatus",
          "description": "The workflow status indicator, e.g. Accepted, Rejected, ...",
          "range": "WorkflowStatusEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "comment",
          "description": "A comment field to be associated with the workflow, e.g. to specify why a transaction event was rejected by a party.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "partyCustomisedWorkflow",
          "description": "Workflow data that is specific to certain market participants and is expressed as part of the CDM in a very generic manner, which can be party-specific. The initial use cases have been derived from the CME clearing and the DTCC TIW submissions.",
          "range": "PartyCustomisedWorkflow",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "warehouseIdentity",
          "description": "The identity of the warehouse, if any, that is executing that workflow step.",
          "range": "WarehouseIdentityEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/WorkflowState",
      "@type": "ClassDefinition"
    },
    {
      "name": "WorkflowStep",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/WorkflowStep",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A workflow step represents the state of a business event. The workflow step contains a reference to a previous WorkflowStep in order to preserve lineage. A workflow step is accepted if it contains a business event, proposed if proposedEvent is present and is rejected if the rejected flag is set.",
      "comments": [
        "Rosetta condition WorkflowStepStatus is not stated in LinkML: (businessEvent exists and nextEvent -> instruction is absent and rejected is absent) or (nextEvent -> instruction exists and businessEvent is absent and rejected is absent) or (rejected exists and businessEvent is absent and nextEvent is absent) or (proposedEvent exists and nextEvent is absent and rejected is absent) or (previousWorkflowStep exists and action = ActionEnum -> Cancel)"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "WorkflowStep_timestamp",
        "workflowStep__businessEvent",
        "workflowStep__counterpartyPositionBusinessEvent",
        "workflowStep__proposedEvent",
        "workflowStep__rejected",
        "workflowStep__approval",
        "workflowStep__previousWorkflowStep",
        "workflowStep__nextEvent",
        "workflowStep__messageInformation",
        "workflowStep__eventIdentifier",
        "workflowStep__action",
        "workflowStep__party",
        "workflowStep__account",
        "workflowStep__creditLimitInformation",
        "workflowStep__workflowState"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "businessEvent",
          "description": "Life cycle event for the step.",
          "range": "BusinessEvent",
          "@type": "SlotDefinition"
        },
        {
          "name": "counterpartyPositionBusinessEvent",
          "description": "Documents the life cycle event for a position.",
          "range": "CounterpartyPositionBusinessEvent",
          "@type": "SlotDefinition"
        },
        {
          "name": "proposedEvent",
          "description": "The proposed event for a workflow step.",
          "range": "EventInstruction",
          "@type": "SlotDefinition"
        },
        {
          "name": "rejected",
          "description": "Flags this step as rejected.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "approval",
          "description": "Optional party approvals for the current workflow step. A workflow step can have any number of parties associated to it, thus this object is represented as a list. All parties that are expected to provide approval should have an item in this list that references them.",
          "range": "WorkflowStepApproval",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "previousWorkflowStep",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Optional previous workflow step that provides lineage to workflow steps that precedes it.",
          "range": "WorkflowStep",
          "@type": "SlotDefinition"
        },
        {
          "name": "nextEvent",
          "description": "The intended next event can be specified, even if the instructions are not known yet.",
          "range": "EventInstruction",
          "@type": "SlotDefinition"
        },
        {
          "name": "messageInformation",
          "description": "Contains all information pertaining the FpML messaging header",
          "range": "MessageInformation",
          "@type": "SlotDefinition"
        },
        {
          "name": "eventIdentifier",
          "description": "The identifier(s) that uniquely identify a lifecycle event. The unbounded cardinality is meant to provide the ability to associate identifiers that are issued by distinct parties. As an example, each of the parties to the event may choose to associate their own identifiers to the event.",
          "range": "Identifier",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "action",
          "description": "Specifies whether the event is a new, a correction or a cancellation.",
          "range": "ActionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "description": "The specification of the event parties. This attribute is optional, as not applicable to certain events (e.g. most of the observations).",
          "range": "Party",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "account",
          "description": "Optional account information that could be associated to the event.",
          "range": "Account",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "creditLimitInformation",
          "range": "CreditLimitInformation",
          "@type": "SlotDefinition"
        },
        {
          "name": "workflowState",
          "description": "The event workflow information, i.e. the workflow status, the associated comment and the partyCustomisedWorkflow which purpose is to provide the ability to associate custom workflow information to the CDM.",
          "range": "WorkflowState",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/WorkflowStep",
      "all_of": [
        {
          "description": "CounterpartyPositionBusinessEventOrBusinessEventOrProposedEventChoice: Choice rule to control that either positionBusinessEvent is present, businessEvent is present or proposedEvent is present, but not more than one at the same time.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "counterpartyPositionBusinessEvent",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "businessEvent",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "proposedEvent",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "WorkflowStepApproval",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/WorkflowStepApproval",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Party approvals associated to the current WorkflowStep.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "WorkflowStepApproval_timestamp",
        "workflowStepApproval__approved",
        "workflowStepApproval__party",
        "workflowStepApproval__rejectedReason"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "approved",
          "description": "Flag denoting whether the workflow step is approved or not",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to the Party who is approving/rejecting this workflow step",
          "range": "Party",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "rejectedReason",
          "description": "Optional reason for rejecting the workflow step",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/WorkflowStepApproval",
      "@type": "ClassDefinition"
    },
    {
      "name": "ClauseLibraryClause",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ClauseLibraryClause",
      "description": "Defines clauses that make up the Agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_clauselibrary",
      "slots": [
        "ClauseLibraryClause_name",
        "clauseLibraryClause__identifier",
        "clauseLibraryClause__counterparty",
        "clauseLibraryClause__otherParty",
        "clauseLibraryClause__variant"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "Unique identifier for the clause.",
          "range": "AssignedIdentifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "counterparty",
          "description": "Optional counterparty role. This can be used where a clause needs to be assigned to a specific party on the agreement based upon their role i.e. Party A or Party B.",
          "range": "CounterpartyRoleEnum",
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "otherParty",
          "description": "Optional party. This can be required for umbrella agreements where a clause may need to be assigned to a specific party who may or may not be on the agreement.",
          "range": "PartyRoleEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "variant",
          "description": "Allows multiple variants to be defined for a clause. This needs to be an array as some clauses can specify different variants for different parties. At least one variant must be specified for a clause.",
          "range": "ClauseLibraryClauseVariant",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ClauseLibraryClause",
      "@type": "ClassDefinition"
    },
    {
      "name": "ClauseLibraryClauseVariant",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ClauseLibraryClauseVariant",
      "description": "Sets the details for a specific variant associated to a clause in the Agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_clauselibrary",
      "slots": [
        "ClauseLibraryClauseVariant_name",
        "clauseLibraryClauseVariant__identifier",
        "clauseLibraryClauseVariant__counterparty",
        "clauseLibraryClauseVariant__otherParty",
        "clauseLibraryClauseVariant__variableSet"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "Unique identifier for this variant.",
          "range": "AssignedIdentifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "counterparty",
          "description": "Optional counterparty role. This can be used where a clause needs to assign a different variant to the different parties on the agreement based upon their role i.e. Party A or Party B.",
          "range": "CounterpartyRoleEnum",
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "otherParty",
          "description": "Optional party. This can be used where a clause needs to assign different variants to different parties who may or may not be on the agreement.",
          "range": "PartyRoleEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "variableSet",
          "description": "For some variants of some clauses additional details are required to work out what has been elected. This array can be used to define the name and value of these variables. Please refer to the agreement documentation for more details of the variables that are available for any clause.",
          "range": "ClauseLibraryVariableSet",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ClauseLibraryClauseVariant",
      "@type": "ClassDefinition"
    },
    {
      "name": "ClauseLibrarySchedule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ClauseLibrarySchedule",
      "description": "The set of elections which specify an Agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_clauselibrary",
      "slots": [
        "clauseLibrarySchedule__clause"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "clause",
          "description": "Clauses that have had elections made against them in this Agreement. There must be at least one clause defined in the agreement.",
          "range": "ClauseLibraryClause",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ClauseLibrarySchedule",
      "@type": "ClassDefinition"
    },
    {
      "name": "ClauseLibraryVariableSet",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ClauseLibraryVariableSet",
      "description": "Defines a type where additional variables associated to clauses and their variants can be described.",
      "comments": [
        "Rosetta condition VariableSetNesting is not stated in LinkML: if variableSet -> variableSet exists then variableSet -> variableSet -> variableSet is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_clauselibrary",
      "slots": [
        "ClauseLibraryVariableSet_name",
        "clauseLibraryVariableSet__variableSet",
        "clauseLibraryVariableSet__value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "variableSet",
          "description": "For some variants a table of variables is required. To support this use case we need to be able to specify variables within variables. Including a variable set here gives us infinite nesting opportunities - realistically we are only ever expecting that a table would need to be defined for any particular clause, so we would expect two levels of nesting as a maximum i.e. variableSet->variableSet->name/value.",
          "range": "ClauseLibraryVariableSet",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "value",
          "description": "The value for this variable.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ClauseLibraryVariableSet",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "variableSet",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "name",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "value",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "VariableSetExists: If we have a variableSet then we must not have any name/value pairs at this level.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "name",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "value",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NameMustExist: If we have a name then we must also have a value.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "value",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "name",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ValueMustExist: If we have a value then we must also have a name.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Agreement",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Agreement",
      "description": "Specification of the standard set of terms that define a legal agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "agreement__creditSupportAgreementElections",
        "agreement__collateralTransferAgreementElections",
        "agreement__securityAgreementElections",
        "agreement__clauseLibrarySchedule",
        "agreement__transactionAdditionalTerms",
        "agreement__masterAgreementElections"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "creditSupportAgreementElections",
          "description": "Elections to specify a Credit Support Annex or Credit Support Deed for Intial or Variation Margin.",
          "range": "CreditSupportAgreementElections",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralTransferAgreementElections",
          "description": "Elections to specify a Collateral Transfer Agreement.",
          "range": "CollateralTransferAgreementElections",
          "@type": "SlotDefinition"
        },
        {
          "name": "securityAgreementElections",
          "description": "Elections to specify a Security agreement.",
          "range": "SecurityAgreementElections",
          "@type": "SlotDefinition"
        },
        {
          "name": "clauseLibrarySchedule",
          "description": "Elections specified through a Clause Library.",
          "range": "ClauseLibrarySchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "transactionAdditionalTerms",
          "description": "Any additional terms which mainly intend to specify the extraordinary events that may affect a trade and the related contractual rights and obligation of the parties when this happens",
          "range": "TransactionAdditionalTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "masterAgreementElections",
          "description": "A legal representation of the different possible master agreements",
          "range": "MasterAgreementElections",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Agreement",
      "all_of": [
        {
          "description": "Unnamed condition (one-of)",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "creditSupportAgreementElections",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "collateralTransferAgreementElections",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "securityAgreementElections",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "clauseLibrarySchedule",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "transactionAdditionalTerms",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "masterAgreementElections",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "AgreementName",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AgreementName",
      "description": "Specifies the agreement name through an agreement type and optional detailed sub agreement type.",
      "comments": [
        "Rosetta condition AgreementType is not stated in LinkML: if agreementType <> LegalAgreementTypeEnum -> Other then otherAgreement is absent else if agreementType <> LegalAgreementTypeEnum -> MasterAgreement then masterAgreementType is absent else if agreementType <> LegalAgreementTypeEnum -> MasterConfirmation then masterConfirmationType is absent and masterConfirmationAnnexType is absent else if agreementType <> LegalAgreementTypeEnum -> Confirmation then contractualDefinitionsType is absent and contractualTermsSupplement is absent and contractualMatrix is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "agreementName__agreementType",
        "agreementName__creditSupportAgreementType",
        "agreementName__creditSupportAgreementMarginType",
        "agreementName__contractualDefinitionsType",
        "agreementName__contractualTermsSupplement",
        "agreementName__contractualMatrix",
        "agreementName__masterAgreementType",
        "agreementName__masterConfirmationType",
        "agreementName__masterConfirmationAnnexType",
        "agreementName__otherAgreement",
        "agreementName__brokerConfirmationType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "agreementType",
          "description": "Specification of the legal agreement type.",
          "range": "LegalAgreementTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "creditSupportAgreementType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specification of the credit support agreement type.",
          "range": "CreditSupportAgreementTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "creditSupportAgreementMarginType",
          "description": "specifies the type of margin for which a legal agreement is named.",
          "range": "CollateralMarginTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "contractualDefinitionsType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The definitions such as those published by ISDA that will define the terms of the trade.",
          "range": "ContractualDefinitionsEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "contractualTermsSupplement",
          "description": "A contractual supplement (such as those published by ISDA) that will apply to the trade.",
          "range": "ContractualTermsSupplement",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "contractualMatrix",
          "description": "A reference to a contractual matrix of elected terms/values (such as those published by ISDA) that shall be deemed to apply to the trade. The applicable matrix is identified by reference to a name and optionally a publication date. Depending on the structure of the matrix, an additional term (specified in the matrixTerm element) may be required to further identify a subset of applicable terms/values within the matrix.",
          "range": "ContractualMatrix",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "masterAgreementType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specification of the master agreement type.",
          "range": "MasterAgreementTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "masterConfirmationType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The type of master confirmation executed between the parties.",
          "range": "MasterConfirmationTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "masterConfirmationAnnexType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The type of master confirmation annex executed between the parties.",
          "range": "MasterConfirmationAnnexTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "otherAgreement",
          "description": "Definition of an agreement that is not enumerated in the CDM.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "brokerConfirmationType",
          "range": "BrokerConfirmationTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AgreementName",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "agreementType",
                "equals_string": "CreditSupportAgreement",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "creditSupportAgreementType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CreditSupportAgreement: A condition to ensure that the credit supoort agreement type is specified when required.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "masterConfirmationAnnexType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "masterConfirmationType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "MasterConfirmation: If a master confirmation annex type is specified a master confirmation type must exist.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "creditSupportAgreementMarginType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "creditSupportAgreementType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CSAMarginType: A condition to ensure that CSA margin type is only specified if a credit support agreemnt type is specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "AgreementTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AgreementTerms",
      "description": "Specification of the content of a legal agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "agreementTerms__agreement",
        "agreementTerms__clauseLibrary",
        "agreementTerms__counterparty"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "agreement",
          "description": "Specification of the standard set of terms that define a legal agreement.",
          "range": "Agreement",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "clauseLibrary",
          "description": "Specification of whether the agreement terms have been negotiated using the clause library methodology.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "counterparty",
          "description": "Specification of the roles of the counterparties to the agreement.",
          "range": "Counterparty",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AgreementTerms",
      "@type": "ClassDefinition"
    },
    {
      "name": "ContactInformationElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ContactInformationElection",
      "description": "Specifies the party reference and the associated contact information.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "contactInformationElection__partyReference",
        "contactInformationElection__primaryContactInformation"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "partyReference",
          "description": "The party to which the election and details apply.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "primaryContactInformation",
          "description": "The main notice/address information of the party.",
          "range": "ContactInformation",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ContactInformationElection",
      "@type": "ClassDefinition"
    },
    {
      "name": "ContractualMatrix",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ContractualMatrix",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "contractualMatrix__matrixType",
        "contractualMatrix__matrixTerm"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "matrixType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Identifies the form of applicable matrix.",
          "range": "MatrixTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "matrixTerm",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Defines any applicable key into the relevant matrix. For example, the Transaction Type would be the single term required for the Credit Derivatives Physical Settlement Matrix. This element should be omitted in the case of the 2000 ISDA Definitions Settlement Matrix for Early Termination and Swaptions.",
          "range": "MatrixTermEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ContractualMatrix",
      "@type": "ClassDefinition"
    },
    {
      "name": "ContractualTermsSupplement",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ContractualTermsSupplement",
      "description": "A contractual supplement (such as those published by ISDA) and its publication date that will apply to the trade.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "contractualTermsSupplement__contractualTermsSupplementType",
        "contractualTermsSupplement__publicationDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "contractualTermsSupplementType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Identifies the form of applicable contractual supplement.",
          "range": "ContractualSupplementTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "publicationDate",
          "description": "Specifies the publication date of the applicable version of the contractual supplement.",
          "range": "date",
          "@type": "SlotDefinition"
