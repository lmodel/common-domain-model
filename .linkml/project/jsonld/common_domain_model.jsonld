            }
          ],
          "description": "An identifier that has been created to identify the agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "otherAgreementType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The agreement executed between the parties and intended to govern product-specific derivatives transactions between those parties.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "date",
          "description": "The date on which the agreement was signed.",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/OtherAgreement",
      "@type": "ClassDefinition"
    },
    {
      "name": "OtherAgreementTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/OtherAgreementTerms",
      "description": "A class to specify a related legal agreement. For example, ISDA 2016 Credit Support Annex for Initial Margin, paragraph 13, General Principles, (s): Other CSA and Japanese Law CSA (VM). | ISDA 2016 Credit Support Annex for Variation Margin, paragraph 13, (o): Other CSA.",
      "comments": [
        "Rosetta condition LegalDocumentNotSpecified is not stated in LinkML: if isSpecified = False then legalDocument is absent",
        "Rosetta condition LegalDocumentSpecified is not stated in LinkML: if isSpecified = True then legalDocument exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "otherAgreementTerms__isSpecified",
        "otherAgreementTerms__legalDocument"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "isSpecified",
          "description": "The qualification of whether some other related agreement is specified (True) or not (False).",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "legalDocument",
          "description": "The specification of this other agreement, when the qualification is True.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/OtherAgreementTerms",
      "@type": "ClassDefinition"
    },
    {
      "name": "Resource",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Resource",
      "description": "Describes the resource that contains the media representation of a business event (i.e used for stating the Publicly Available Information). For example, can describe a file or a URL that represents the event. This type is an extended version of a type defined by RIXML (www.rixml.org). Rosetta restricts the FpML implementation by not providing the ability to associated a document in hexadecimalBinary or base64Binary until such time that actual use cases will come up.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "Resource_name",
        "Resource_url",
        "resource__resourceId",
        "resource__resourceType",
        "resource__language",
        "resource__sizeInBytes",
        "resource__length",
        "resource__mimeType",
        "resource__comments",
        "resource__string"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "resourceId",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The unique identifier of the resource within the event. FpML specifies this element of type resourceIdScheme but with no specified value.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "resourceType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "A description of the type of the resource, e.g. a confirmation.",
          "range": "ResourceTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "language",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Indicates the language of the resource, described using the ISO 639-2/T Code.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "sizeInBytes",
          "description": "Indicates the size of the resource in bytes. It could be used by the end user to estimate the download time and storage needs.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "length",
          "description": "Indicates the length of the resource. For example, if the resource were a PDF file, the length would be in pages.",
          "range": "ResourceLength",
          "@type": "SlotDefinition"
        },
        {
          "name": "mimeType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Indicates the type of media used to store the content. mimeType is used to determine the software product(s) that can read the content. MIME Types are described in RFC 2046.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "comments",
          "description": "Any additional comments that are deemed necessary. For example, which software version is required to open the document? Or, how does this resource relate to the others for this event?",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "string",
          "description": "Provides extra information as string. In case the extra information is in XML format, a CDATA section must be placed around the source message to prevent its interpretation as XML content.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Resource",
      "all_of": [
        {
          "description": "ResourceChoice: Choice rule to represent an FpML choice construct. Note that FpML also provides the ability to have hexadecimalBinary or base64Binary, which have not been implemented in Rosetta until we see actual use cases.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "string",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "url",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "string",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "url",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ResourceLength",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ResourceLength",
      "description": "A class to indicate the length of the resource.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "resourceLength__lengthUnit",
        "resourceLength__lengthValue"
      ],
      "slot_usage": {},
