      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ScheduledTransfer",
          "description": "A transfer created from a scheduled event on a contract, e.g. Coupon, Dividend Return, Fixed Rate Return",
          "range": "ScheduledTransfer",
          "@type": "SlotDefinition"
        },
        {
          "name": "UnscheduledTransfer",
          "description": "An ad-hoc transfer instigated by a party to the contract e.g. Recall, Return.",
          "range": "UnscheduledTransfer",
          "@type": "SlotDefinition"
        },
        {
          "name": "ContingentTransfer",
          "description": "A transfer created from a contingent event on a contract, e.g. Corporate Action, Credit Event or Exercise",
          "range": "ContingentTransfer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Transfer",
      "all_of": [
        {
          "description": "OneOf: A choice type holds exactly one of its options.",
