        {
          "tag": "rosetta_choice",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "A data type to specify the fixed interest rate, floating interest rate or inflation rate.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "rateSpecification__FixedRateSpecification",
        "rateSpecification__FloatingRateSpecification",
        "rateSpecification__InflationRateSpecification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "FixedRateSpecification",
          "description": "The fixed rate or fixed rate specification expressed as explicit fixed rates and dates.",
          "range": "FixedRateSpecification",
          "@type": "SlotDefinition"
        },
        {
          "name": "FloatingRateSpecification",
          "description": "The floating interest rate specification, which includes the definition of the floating rate index. the tenor, the initial value, and, when applicable, the spread, the rounding convention, the averaging method and the negative interest rate treatment.",
          "range": "FloatingRateSpecification",
          "@type": "SlotDefinition"
        },
        {
          "name": "InflationRateSpecification",
          "description": "An inflation rate calculation definition.",
          "range": "InflationRateSpecification",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/RateSpecification",
      "all_of": [
        {
          "description": "OneOf: A choice type holds exactly one of its options.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "FixedRateSpecification",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "FloatingRateSpecification",
                  "value_presence": "PRESENT",
