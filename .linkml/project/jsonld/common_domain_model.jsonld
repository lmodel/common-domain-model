    {
      "name": "CancelableProvision",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CancelableProvision",
      "description": "A data defining: the right of a party to cancel a swap transaction on the specified exercise dates. The provision is for 'walk-away' cancellation (i.e. the fair value of the swap is not paid). A fee payable on exercise can be specified. As a difference from the FpML construct, the canonical model extends the BuyerSeller class.",
      "comments": [
        "Rosetta condition CancelableProvisionExerciseNoticeReceiverParty is not stated in LinkML: if exerciseNotice -> exerciseNoticeReceiver exists then exerciseNotice -> exerciseNoticeReceiver = AncillaryRoleEnum -> ExerciseNoticeReceiverPartyCancelableProvision"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "is_a": "BuyerSeller",
      "slots": [
        "buyerSeller__buyer",
        "buyerSeller__seller",
        "cancelableProvision__exerciseNotice",
        "cancelableProvision__followUpConfirmation",
        "cancelableProvision__cancelableProvisionAdjustedDates",
        "cancelableProvision__finalCalculationPeriodDateAdjustment",
        "cancelableProvision__initialFee",
        "cancelableProvision__callingParty",
        "cancelableProvision__earliestDate",
        "cancelableProvision__expirationDate",
        "cancelableProvision__effectiveDate",
        "cancelableProvision__effectivePeriod",
        "cancelableProvision__earliestCancellationTime",
        "cancelableProvision__latestCancelationTime",
        "cancelableProvision__exerciseTerms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "exerciseNotice",
          "description": "Definition of the party to whom notice of exercise should be given.",
          "range": "ExerciseNotice",
          "@type": "SlotDefinition"
        },
        {
          "name": "followUpConfirmation",
          "description": "A flag to indicate whether follow-up confirmation of exercise (written or electronic) is required following telephonic notice by the buyer to the seller or seller's agent.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cancelableProvisionAdjustedDates",
          "description": "The adjusted dates associated with a cancelable provision. These dates have been adjusted for any applicable business day convention.",
          "range": "CancelableProvisionAdjustedDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "finalCalculationPeriodDateAdjustment",
          "description": "Business date convention adjustment to final payment period per leg (swapStream) upon exercise event. The adjustments can be made in-line with leg level BDC's or they can be specified separately.",
          "range": "FinalCalculationPeriodDateAdjustment",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "initialFee",
          "description": "An initial fee for the cancelable option.",
          "range": "Transfer",
          "@type": "SlotDefinition"
        },
        {
          "name": "callingParty",
          "description": "The party with right to exercise a cancellation. Allows for buyer, seller or either.",
          "range": "CallingPartyEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "earliestDate",
          "description": "The first day when cancelation is permitted to take effect. A party may give notice prior to this date and taken together with the effective period would be necessary to cancel on this date.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "expirationDate",
          "description": "The last day within the term of the contract that cancelation is allowed.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "The effective date if cancelation is invoked otherwise the cancellation period defines the cancellation date.",
          "range": "AdjustableOrRelativeDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "effectivePeriod",
          "description": "Effective period for cancelation when notice is given. This is the period after notice is given that cancellation becomes effecticve.",
          "range": "Period",
          "@type": "SlotDefinition"
        },
        {
          "name": "earliestCancellationTime",
          "description": "The earliest time in a business day that notice of cancelation can be given.",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "latestCancelationTime",
          "description": "The latest time at which notice of cancelation can be given.",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseTerms",
          "description": "The exercise terms associated with the cancelable provision, including details such as exercise style, exercise fees, and any other relevant conditions or terms governing the cancellation of the swap transaction.",
          "range": "ExerciseTerms",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CancelableProvision",
      "all_of": [
        {
          "description": "EffectiveDate: Must select one of predefined cancellation types of effectiveDate or effectivePeriod.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "effectiveDate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "effectivePeriod",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "effectiveDate",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "effectivePeriod",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
