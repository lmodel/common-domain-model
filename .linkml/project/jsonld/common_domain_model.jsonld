      "name": "Substitution",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Substitution",
      "description": "A class to specify the conditions under which the Security Provider can substitute posted collateral. The details required for 'Legacy' agreements are substantially different to those required for newer agreements; where the agreement is a 1994 or 1995 CSA, or 1995 CSD, the legacyConsent attribute needs to be used which contains additional values beyond a simple true/false value.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "substitution__partyElection"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "partyElection",
          "description": "Party specific elections for substitution of posted collateral.",
          "range": "SubstitutionPartyElection",
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Substitution",
      "@type": "ClassDefinition"
    },
    {
      "name": "SubstitutionPartyElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SubstitutionPartyElection",
      "description": "Party specific elections for substitution of posted collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "substitutionPartyElection__party",
        "substitutionPartyElection__needsConsent",
        "substitutionPartyElection__substitutionDateLanguage",
        "substitutionPartyElection__specificConsentLanguage",
        "substitutionPartyElection__legacyConsent"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "party",
          "description": "The party that is acting as the Pledgor/Obligor/Chargor/Security Provider.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "needsConsent",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ISDA CSA_IM_2016 paragraph 13 General Principles clause (f)(ii) name Consent | ISDA CSA_VM_2016 paragraph 13 clause (f)(ii) name Consent",
              "@type": "Annotation"
            }
          ],
          "description": "The election as to whether the Pledgor/Obligor/Chargor/Security Provider must obtain the Secured Partys consent for any collateral substitution.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "substitutionDateLanguage",
          "description": "Substitution Date has the meaning specified in Paragraph4(d)(ii), unless otherwise specified.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "specificConsentLanguage",
          "description": "Specific consent language might be specified by the parties.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "legacyConsent",
          "description": "The process for substituting/exchanging one form of collateral held by a party for a different form of collateral, used with legacy agreements.",
          "range": "LegacyConsentEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SubstitutionPartyElection",
      "@type": "ClassDefinition"
    },
    {
      "name": "TerminationCurrencyAmendment",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TerminationCurrencyAmendment",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 paragraph 13 General Principles clause (t) name Amendment to Termination Currency.",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify the Amendment to Termination Currency elections by the parties to the agreement.",
      "comments": [
        "Rosetta condition Applicability is not stated in LinkML: if isApplicable = False then effectiveDate is absent and partyElection is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "terminationCurrencyAmendment__isApplicable",
        "terminationCurrencyAmendment__effectiveDate",
        "terminationCurrencyAmendment__partyElection"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "isApplicable",
          "description": "The qualification of whether the Amendment to Termination Currency is deemed applicable by the parties (True) or not (False).",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "The effective date of the Amendment to Termination Currency. This date can be specified as either an actual date, a specific date (e.g. the annex date) or as a custom provision.",
          "range": "AmendmentEffectiveDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "partyElection",
          "description": "The parties' Amendment Currency election.",
          "range": "TerminationCurrencyElection",
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TerminationCurrencyAmendment",
      "@type": "ClassDefinition"
    },
    {
      "name": "TerminationCurrencyElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TerminationCurrencyElection",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 paragraph 13 General Principles clause (t)(A) & (B)",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify the Amendment to Termination Currency election by the parties to the agreement.",
      "comments": [
        "Rosetta condition CurrencyElection is not stated in LinkML: if isSpecified = False then currency is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "terminationCurrencyElection__party",
        "terminationCurrencyElection__isSpecified",
        "terminationCurrencyElection__currency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "party",
          "description": "The elective party.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "isSpecified",
          "description": "The qualification of whether the Termination Currency is specified in this document (True) or in an Eligible Support Credit Support (IM) Schedule (False).",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The Termination Currency associated with the party that referenced as part of this class. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TerminationCurrencyElection",
      "@type": "ClassDefinition"
    },
    {
      "name": "Threshold",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Threshold",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_NewYork_1994 name Threshold | ISDA CSA_English_1995 name Threshold | ISDA CSD_English_1995 name Threshold | ISDA CSA_VM_English_2016 name Threshold | ISDA CSA_VM_NewYork_2016 name Threshold",
          "@type": "Annotation"
        }
      ],
      "description": "Represents the amount of unsecured risk that a party is willing to tolerate without holding any posted collateral provided by the other party.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "threshold__partyElection"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "partyElection",
          "description": "The party specific election for the threshold clause.",
          "range": "ThresholdElection",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Threshold",
      "@type": "ClassDefinition"
    },
    {
      "name": "ThresholdElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ThresholdElection",
      "description": "Specifies whether the threshold is rating based, a fixed amount, or infinity.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "thresholdElection__party",
        "thresholdElection__fixedAmount",
        "thresholdElection__ratingsBased",
        "thresholdElection__infinity",
        "thresholdElection__other"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "party",
          "description": "The party to which the threshold applies.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fixedAmount",
          "description": "Defines that the Threshold is a Fixed Amount.",
          "range": "ThresholdMinimumTransferAmountFixedAmount",
          "@type": "SlotDefinition"
        },
        {
          "name": "ratingsBased",
          "description": "Defines that the Threshold is based on a Ratings condition(s).",
          "range": "ThresholdRatingsBased",
          "@type": "SlotDefinition"
        },
        {
          "name": "infinity",
          "description": "Specifies that the Threshold is Infinity. If 'True' then the threshold for the elective party is Infinity.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "other",
          "description": "Utilised where the clause data structure is not able to capture a material aspect of the clause.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ThresholdElection",
      "all_of": [
        {
          "description": "ThresholdOneOf: Ensures that threshold is specified as one-of fixedAmount, ratingsBased, infinity, or other.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "fixedAmount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "ratingsBased",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "infinity",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "other",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ThresholdMinimumTransferAmountBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ThresholdMinimumTransferAmountBase",
      "description": "A logical container designed to hold a set of related data. In this case, designed to hold a set of information required to specify conditions under which Threshold or Minimum Transfer Amount can fall to zero.",
      "comments": [
        "Rosetta condition ZeroEvent is not stated in LinkML: if zeroEvent = True then event exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "thresholdMinimumTransferAmountBase__zeroEvent",
        "thresholdMinimumTransferAmountBase__event"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "zeroEvent",
          "description": "Indicates whether a trigger applies for the Threshold or Minimum Transfer Amount to fall to zero. If 'True' then such a trigger exists.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "event",
          "description": "Specifies the relevant trigger for the Threshold or Minimum Transfer Amount to fall to zero.",
          "range": "ZeroEventEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ThresholdMinimumTransferAmountBase",
      "@type": "ClassDefinition"
    },
    {
      "name": "ThresholdMinimumTransferAmountFixedAmount",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ThresholdMinimumTransferAmountFixedAmount",
      "description": "Defines the Threshold or the Minimum Transfer Amount (MTA) as a fixed amount.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "is_a": "ThresholdMinimumTransferAmountBase",
      "slots": [
        "thresholdMinimumTransferAmountBase__zeroEvent",
        "thresholdMinimumTransferAmountBase__event",
        "thresholdMinimumTransferAmountFixedAmount__amount"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "amount",
          "description": "Specifies the monetary value of the Threshold or the Minimum Transfer Amount (MTA) applicable to collateral transfer obligations.",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ThresholdMinimumTransferAmountFixedAmount",
      "@type": "ClassDefinition"
    },
    {
      "name": "ThresholdRatingsBased",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ThresholdRatingsBased",
      "description": "Defines that the Threshold is based on Ratings condition(s).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "is_a": "ThresholdMinimumTransferAmountBase",
      "slots": [
        "thresholdMinimumTransferAmountBase__zeroEvent",
        "thresholdMinimumTransferAmountBase__event",
        "thresholdRatingsBased__currency",
        "thresholdRatingsBased__ratingType",
        "thresholdRatingsBased__variableSet",
        "thresholdRatingsBased__ratedParty",
        "thresholdRatingsBased__namedEntity",
        "thresholdRatingsBased__namedAffiliate",
        "thresholdRatingsBased__compare",
        "thresholdRatingsBased__noRating",
        "thresholdRatingsBased__notRatedBy",
        "thresholdRatingsBased__numberOfRatingAgencies"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "currency",
          "description": "The threshold currency code.",
          "range": "ISOCurrencyCodeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ratingType",
          "description": "The relevant rating type.",
          "range": "RatingTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "variableSet",
          "description": "Defines a combination of Rating Agency, Rating Value, Threshold amount and Currency code.",
          "range": "CSAThresholdVariableSet",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ratedParty",
          "description": "The party to which a rating applies.",
          "range": "RatedPartyEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "namedEntity",
          "description": "Details the Named Entity where the Rated Party is Named Entity.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "namedAffiliate",
          "description": "Details the Named Affiliate where the Rated Party is Named Affiliate.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "compare",
          "description": "Where two ratings are specified whether the higher or lower rating prevails.",
          "range": "CreditNotationMismatchResolutionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "noRating",
          "description": "What conditions apply where a party has no rating.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "notRatedBy",
          "description": "Defines where conditions apply if no Rating where ratings may not exist.",
          "range": "NotRatedByEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "numberOfRatingAgencies",
          "description": "Defines the number of Rating Agencies that the Party must be rated by.",
          "range": "NumberOfRatingAgenciesEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ThresholdRatingsBased",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "ratedParty",
                "value_presence": "PRESENT",
                "equals_string": "NamedEntity",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "namedEntity",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NamedEntity: If the rated party is NamedEntity then the entity must be specified.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "ratedParty",
                "value_presence": "PRESENT",
                "equals_string": "NamedAffiliate",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "namedAffiliate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NamedAffiliate: If rated party is NamedAffilite then the affiliate must be specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "TransferSettlementTiming",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TransferSettlementTiming",
      "description": "Specification of transfer / settlement timing for cash and securities collateral assuming that the notice is provided before the Notification Time (and with a 1LBD lag introduced if the notice is delivered after the Notification Time), and that securities allow for a further Local Business Day for transfer / settlement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "transferSettlementTiming__cashCollateralTransferSettlementTime",
        "transferSettlementTiming__securititesCollateralTransferSettlementTime",
        "transferSettlementTiming__additionalLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cashCollateralTransferSettlementTime",
          "description": "Details the day on which collateral is required to be transferred relative to the Notification Time.",
          "range": "CashCTSTimeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "securititesCollateralTransferSettlementTime",
          "description": "Details the day on which collateral is required to be transferred relative to the Notification Time.",
          "range": "SecuritiesCTSTimeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalLanguage",
          "description": "The additional language that might be specified by the parties to the legal agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TransferSettlementTiming",
      "rules": [
        {
          "preconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "cashCollateralTransferSettlementTime",
                    "value_presence": "PRESENT",
                    "equals_string": "Other",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "securititesCollateralTransferSettlementTime",
                    "value_presence": "PRESENT",
                    "equals_string": "Other",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "additionalLanguage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "OtherValues: Additional language is required when 'Other' values are used.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
