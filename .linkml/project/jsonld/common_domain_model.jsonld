          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EquityType",
      "rules": [
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "equityType",
                    "value_presence": "PRESENT",
                    "equals_string": "DepositaryReceipt",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "depositaryReceipt",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DepositaryReceiptSubType",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Instrument",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Instrument",
      "annotations": [
        {
          "tag": "rosetta_choice",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "A type of Asset that is issued by one party to one or more others.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "instrument__ListedDerivative",
        "instrument__Loan",
        "instrument__Security"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "ListedDerivative",
          "description": "A securitized derivative on another asset that is created by an exchange.",
          "range": "ListedDerivative",
          "@type": "SlotDefinition"
        },
        {
          "name": "Loan",
          "description": "An Asset that represents a loan or borrow obligation.",
          "range": "Loan",
          "@type": "SlotDefinition"
        },
        {
          "name": "Security",
          "description": "An Asset that is issued by a party to be held by or transferred to others.",
          "range": "Security",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Instrument",
      "all_of": [
        {
          "description": "OneOf: A choice type holds exactly one of its options.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "ListedDerivative",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "Loan",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "Security",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "InstrumentBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/InstrumentBase",
      "description": "Defines the common attributes for all Instrument data types.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "is_a": "AssetBase",
      "slots": [
        "assetBase__identifier",
        "assetBase__taxonomy",
        "assetBase__isExchangeListed",
        "assetBase__party",
        "assetBase__partyRole",
        "assetBase__ancillaryPartyRole",
        "assetBase__assetType"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/common-domain-model/InstrumentBase",
      "@type": "ClassDefinition"
    },
    {
      "name": "ListedDerivative",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ListedDerivative",
      "description": "A securitized derivative on another asset.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "is_a": "InstrumentBase",
      "slots": [
        "assetBase__identifier",
        "assetBase__taxonomy",
        "assetBase__isExchangeListed",
        "assetBase__party",
        "assetBase__partyRole",
        "assetBase__ancillaryPartyRole",
        "assetBase__assetType",
        "listedDerivative__deliveryTerm",
        "listedDerivative__optionType",
        "listedDerivative__strike"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "deliveryTerm",
          "description": "Also called contract month or delivery month. However, it's not always a month. It is usually expressed using a code, e.g. Z23 would be the Dec 2023 contract, (Z = December). For crude oil, the corresponding contract might be called CLZ23. Optional as this can be uniquely identified in the identifier.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "optionType",
          "description": "The type of option, ie Put or Call. Left empty if it is a Future.",
          "range": "PutCallEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "strike",
          "description": "Specifies the strike of the option.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ListedDerivative",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "optionType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "strike",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "elseconditions": {
            "slot_conditions": [
              {
                "name": "strike",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Options: Options must have a strike price.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "AssetType: Asset type must be ListedDerivative.",
          "slot_conditions": [
            {
              "name": "assetType",
              "equals_string": "ListedDerivative",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Loan",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Loan",
      "description": "Identifies a loan by referencing an asset identifier and through an optional set of attributes.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "is_a": "InstrumentBase",
      "slots": [
        "assetBase__identifier",
        "assetBase__taxonomy",
        "assetBase__isExchangeListed",
        "assetBase__party",
        "assetBase__partyRole",
        "assetBase__ancillaryPartyRole",
        "assetBase__assetType",
        "loan__lien",
        "loan__facilityType",
        "loan__creditAgreementDate",
        "loan__tranche"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "lien",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the seniority level of the lien.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "facilityType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the type of loan facility (letter of credit, revolving, ...).",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "creditAgreementDate",
          "description": "Specifies the credit agreement date is the closing date (the date where the agreement has been signed) for the loans in the credit agreement. Funding of the facilities occurs on (or sometimes a little after) the Credit Agreement date. This underlier attribute is used to help identify which of the company's outstanding loans are being referenced by knowing to which credit agreement it belongs. ISDA Standards Terms Supplement term: Date of Original Credit Agreement.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "tranche",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Denotes the loan tranche that is subject to the derivative transaction. It will typically be referenced as the Bloomberg tranche number. ISDA Standards Terms Supplement term: Bloomberg Tranche Number.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Loan",
      "all_of": [
        {
          "description": "AssetType: Asset type must be Loan.",
          "slot_conditions": [
            {
              "name": "assetType",
              "equals_string": "Loan",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PriceSource",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PriceSource",
      "description": "Specifies a publication that provides the commodity price, including, where applicable, the details of where in the publication the price is published.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "priceSource__pricePublisher",
        "priceSource__priceSourceLocation",
        "priceSource__priceSourceHeading",
        "priceSource__priceSourceTime"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "pricePublisher",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Defines a publication in which the price can be found. (e.g Gas Daily, Platts Bloomberg. Commodity publishers can be found at this URL: http://www.fpml.org/coding-scheme/commodity-information-provider>",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "priceSourceLocation",
          "description": "Specifies the location of the price which may be a specific page, electornic screen name, or a code (e.g. a RIC code) where the price can be found.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "priceSourceHeading",
          "description": "Specifies the heading or field name for the price on a given page or screen, where applicable.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "priceSourceTime",
          "description": "Specifies the time at which the price should be observed.",
          "range": "time",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PriceSource",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "priceSourceHeading",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "priceSourceLocation",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PriceSourceHeading: Requires that if a priceSourceHeading is specified, then a priceSourceLocation must be speficified",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ProductIdentifier",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ProductIdentifier",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Comprises an identifier and a source. The associated metadata key denotes the ability to associate a hash value to the ProductIdentifier instantiations for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "ProductIdentifier_source",
        "productIdentifier__identifier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Provides an identifier associated with a specific product. The identifier is unique within the public source specified in the source attribute.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ProductIdentifier",
      "@type": "ClassDefinition"
    },
    {
      "name": "ProductTaxonomy",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ProductTaxonomy",
      "description": "Specifies the product taxonomy, which is composed of a taxonomy value and a taxonomy source.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "is_a": "Taxonomy",
      "slots": [
        "Taxonomy_source",
        "taxonomy__value",
        "taxonomy__calculated",
        "productTaxonomy__primaryAssetClass",
        "productTaxonomy__secondaryAssetClass"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "primaryAssetClass",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Classifies the most important risk class of the trade.",
          "range": "AssetClassEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "secondaryAssetClass",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Classifies additional risk classes of the trade, if any.",
          "range": "AssetClassEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ProductTaxonomy",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "source",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "value",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "TaxonomySource: A taxonomy source can only be associated with a taxonomy value.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "TaxonomyType: Requires a taxonomy type to be chosen, either from a taxonomy source or using asset classes.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "source",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "primaryAssetClass",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "secondaryAssetClass",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "QuasiGovernmentIssuerType",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/QuasiGovernmentIssuerType",
      "description": "Represents a class to allow specification of different types of Quasi Government collateral.",
      "comments": [
        "Rosetta condition NonSovereignEntityRecourse is not stated in LinkML: if sovereignRecourse exists then sovereignEntity = False"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "quasiGovernmentIssuerType__sovereignEntity",
        "quasiGovernmentIssuerType__sovereignRecourse"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "sovereignEntity",
          "description": "True if sovereign entity (e.g. not separate legal personality from sovereign) or false if non-sovereign entity (e.g. separate legal personality from sovereign).",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "sovereignRecourse",
          "description": "Applies to non-sovereign entity (e.g. separate legal personality from sovereign). True if entity has recourse to sovereign (e.g. debt guaranteed by government). False if entity does not have recourse to sovereign.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/QuasiGovernmentIssuerType",
      "@type": "ClassDefinition"
    },
    {
      "name": "RegionalGovernmentIssuerType",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RegionalGovernmentIssuerType",
      "description": "Represents a class to allow specification of different type of Regional government collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "regionalGovernmentIssuerType__sovereignRecourse"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "sovereignRecourse",
          "description": "Applies to regional governments, local authorities or municipals. True if entity has recourse to sovereign (e.g. debt guaranteed by government). False if entity does not have recourse to sovereign.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/RegionalGovernmentIssuerType",
      "@type": "ClassDefinition"
    },
    {
      "name": "SecuredDebt",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SecuredDebt",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "securedDebt__securedType",
        "securedDebt__assetBacked",
        "securedDebt__collateralizedObligation",
        "securedDebt__coveredBond",
        "securedDebt__propertyType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "securedType",
          "description": "Specifies the type of secured debt product.",
          "range": "SecuredTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "assetBacked",
          "description": "Specifies the type of Asset Backed Security.",
          "range": "AssetBackedEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralizedObligation",
          "description": "Specifies the type of Collateralized Obligation.",
          "range": "CollateralizedObligationEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "coveredBond",
          "description": "Specifies the type of Covered Bond.",
          "range": "CoveredBondEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "propertyType",
          "description": "Specifies the type of property when the security is linked to a property asset.",
          "range": "PropertyTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SecuredDebt",
      "rules": [
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "securedType",
                    "value_presence": "PRESENT",
                    "equals_string": "AssetBacked",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "assetBacked",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "AssetBackedExists: Condition to restrict selection of the assetBacked attribute if AssetBacked is not set as the securedType value.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "any_of": [
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "assetBacked",
                        "value_presence": "PRESENT",
                        "equals_string": "Mortgage",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "assetBacked",
                        "value_presence": "PRESENT",
                        "equals_string": "Property",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "collateralizedObligation",
                        "value_presence": "PRESENT",
                        "equals_string": "CMO",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "propertyType",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PropertyExists: Condition to restrict selection of the property attribute if the security is not linked to a property asset: mortgage, property, CMO.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "securedType",
                    "value_presence": "PRESENT",
                    "equals_string": "CollateralizedObligation",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "collateralizedObligation",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CollateralizedObligationExists: Condition to restrict selection of the collateralizedObligations attribute if CollateralizedObligation is not set as the securedType value.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "securedType",
                    "value_presence": "PRESENT",
                    "equals_string": "CoveredBonds",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "coveredBond",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CoveredBondsExists: Condition to restrict selection of the coveredBonds attribute if CoveredBonds is not set as the securedType value.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Security",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Security",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ICMA GMRA namingConvention Purchased Security",
          "@type": "Annotation"
        }
      ],
      "description": "Identifies a security by referencing an identifier and by specifying the sector.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "is_a": "InstrumentBase",
      "slots": [
        "assetBase__identifier",
        "assetBase__taxonomy",
        "assetBase__isExchangeListed",
        "assetBase__party",
        "assetBase__partyRole",
        "assetBase__ancillaryPartyRole",
        "assetBase__assetType",
        "security__securityType",
        "security__debtType",
        "security__equityType",
        "security__fundType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "securityType",
          "description": "Identifies the type of security using an enumerated list.",
          "range": "SecurityTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "debtType",
          "description": "Identifies the type of debt and selected debt economics.",
          "range": "DebtType",
          "@type": "SlotDefinition"
        },
        {
          "name": "equityType",
          "description": "Identifies the type of equity.",
          "range": "EquityType",
          "@type": "SlotDefinition"
        },
        {
          "name": "fundType",
          "description": "Identifies the type of fund.",
          "range": "FundProductTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Security",
      "rules": [
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "securityType",
                    "value_presence": "PRESENT",
                    "equals_string": "Debt",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "debtType",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DebtSubType",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "securityType",
                    "value_presence": "PRESENT",
                    "equals_string": "Equity",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "equityType",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "EquitySubType",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "securityType",
                    "value_presence": "PRESENT",
                    "equals_string": "Fund",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "fundType",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "FundSubType",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "AssetType: Asset type must be Security.",
          "slot_conditions": [
            {
              "name": "assetType",
              "equals_string": "Security",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "SpecialPurposeVehicleIssuerType",
