    {
      "name": "ObservationDate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ObservationDate",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Specifies a single date on which market observations take place and specifies optional associated weighting.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "observationDate__unadjustedDate",
        "observationDate__adjustedDate",
        "observationDate__weight",
        "observationDate__observationReference"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "unadjustedDate",
          "description": "A date subject to adjustment.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedDate",
          "description": "The date once the adjustment has been performed. (Note that this date may change if the business center holidays change).",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "weight",
          "description": "Specifies the degree of importance of the observation.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "observationReference",
          "description": "Specifies an identification key for the market observation. This attribute can be used as a reference to assign weights to a series of dates defined in a parametricSchedule.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ObservationDate",
      "all_of": [
        {
          "description": "ObservationDate: Either an unadjusted date or an adjusted date needs to be specified.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "unadjustedDate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "adjustedDate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ObservationDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ObservationDates",
      "description": "Describes date details for a set of observation dates in parametric or non-parametric form.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "observationDates__observationSchedule",
        "observationDates__periodicSchedule",
        "observationDates__parametricDates"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "observationSchedule",
          "description": "Specifies a schedule of dates (non-parametric) on which market observations take place, and allows for the optional definition of weights where applicable. When no weight is specified, then weight of each date is assumed to be 1.0",
          "range": "ObservationSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "periodicSchedule",
          "description": "Specifies the date range and frequency on which market observations take place. Weights can be assigned to dates in the schedule by assigning the weight and corresponding observationReference in the observationSchedule.",
          "range": "PeriodicDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "parametricDates",
          "description": "Specifies parametric terms to determine which days within a given calculation period the price would be observed. Typically associated with Commodities.",
          "range": "ParametricDates",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ObservationDates",
      "@type": "ClassDefinition"
    },
    {
      "name": "ObservationSchedule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ObservationSchedule",
      "description": "Specifies a single date on which market observations take place and specifies optional associated weighting.",
      "comments": [
        "Rosetta condition AdjustedDate is not stated in LinkML: if observationDate -> adjustedDate is absent then observationDate -> unadjustedDate exists and dateAdjustments exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "observationSchedule__observationDate",
        "observationSchedule__dateAdjustments"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "observationDate",
          "description": "Specifies an adjusted or unadjusted date for a market observation.",
          "range": "ObservationDate",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dateAdjustments",
          "description": "The business day convention and financial business centers used for adjusting the date if it would otherwise fall on a day that is not a business date in the specified business centers.",
          "range": "BusinessDayAdjustments",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ObservationSchedule",
      "@type": "ClassDefinition"
    },
    {
      "name": "ObservationTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ObservationTerms",
      "description": "Class containing terms that are associated with observing a price/benchmark/index across either single or multiple observations.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "observationTerms__observationTime",
        "observationTerms__observationTimeType",
        "observationTerms__informationSource",
        "observationTerms__precision",
        "observationTerms__calculationPeriodDates",
        "observationTerms__observationDates",
        "observationTerms__numberOfObservationDates"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "observationTime",
          "description": "Defines time in respect to a business calendar location that the price/benchmark/index is observed",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "observationTimeType",
          "description": "The enumerated values to specify points in the day when option exercise and valuation can occur.",
          "range": "TimeTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "informationSource",
          "description": "The information source where a published or displayed market rate will be obtained, e.g. Telerate Page 3750.",
          "range": "FxSpotRateSource",
          "@type": "SlotDefinition"
        },
        {
          "name": "precision",
          "description": "Defines rounding rules and precision to be used in the rounding of observations.",
          "range": "Rounding",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriodDates",
          "description": "Defines parameters used to generate the calculation period dates schedule, including the specification of any initial or final stub calculation periods. A calculation period schedule consists of an optional initial stub calculation period, one or more regular calculation periods and an optional final stub calculation period. In the absence of any initial or final stub calculation periods, the regular part of the calculation period schedule is assumed to be between the effective date and the termination date. No implicit stubs are allowed, i.e. stubs must be explicitly specified using an appropriate combination of firstPeriodStartDate, firstRegularPeriodStartDate and lastRegularPeriodEndDate.",
          "range": "CalculationPeriodDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "observationDates",
          "description": "Describes date details for a set of observation dates in parametric or non-parametric form.",
          "range": "ObservationDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "numberOfObservationDates",
          "description": "The number of observation dates between observation start date and observation end date.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ObservationTerms",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "observationTimeType",
                "value_presence": "PRESENT",
                "equals_string": "SpecificTime",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "observationTime",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ObservationTime: Checks that an observation time is specified either explicitly (through the observation time) or implicitly (through a observation time type different to Specific Time). If Specific Time is defined as observation time type (i.e. no implicit time value), the condition checks that an explicit observation time is provided.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ParametricDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ParametricDates",
      "description": "Defines rules for the dates on which the price will be determined.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "parametricDates__dayType",
        "parametricDates__dayDistribution",
        "parametricDates__dayOfWeek",
        "parametricDates__dayFrequency",
        "parametricDates__lag",
        "parametricDates__businessCenters"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dayType",
          "description": "Denotes the enumerated values to specify the day type classification used in counting the number of days between two dates.",
          "range": "DayTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dayDistribution",
          "description": "Denotes the method by which the pricing days are distributed across the pricing period.",
          "range": "DayDistributionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "dayOfWeek",
          "description": "Indicates the days of the week on which the price will be determined.",
          "range": "DayOfWeekEnum",
          "multivalued": true,
          "maximum_cardinality": 7,
          "@type": "SlotDefinition"
        },
        {
          "name": "dayFrequency",
          "description": "Defines the occurrence of the dayOfWeek within the pricing period on which pricing will take place, e.g. the 3rd Friday within each Calculation Period. If omitted, every dayOfWeek will be a pricing day.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "lag",
          "description": "The pricing period per calculation period if the pricing days do not wholly fall within the respective calculation period.",
          "range": "Lag",
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCenters",
          "description": "The enumerated values to specify the business centers.",
          "range": "BusinessCenters",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ParametricDates",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "dayOfWeek",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "dayFrequency",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DayOfWeekMethod",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "ParametricDatesChoice",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "dayDistribution",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "dayOfWeek",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PaymentCalculationPeriod",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PaymentCalculationPeriod",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A data defining: the adjusted payment date and associated calculation period parameters required to calculate the actual or projected payment amount. This data forms: part of the cashflow representation of a swap stream.",
      "comments": [
        "Rosetta condition CalculationPeriodNumberOfDays is not stated in LinkML: if calculationPeriod -> calculationPeriodNumberOfDays exists then calculationPeriod -> calculationPeriodNumberOfDays all >= 0"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "paymentCalculationPeriod__unadjustedPaymentDate",
        "paymentCalculationPeriod__adjustedPaymentDate",
        "paymentCalculationPeriod__calculationPeriod",
        "paymentCalculationPeriod__fixedPaymentAmount",
        "paymentCalculationPeriod__discountFactor",
        "paymentCalculationPeriod__forecastPaymentAmount",
        "paymentCalculationPeriod__presentValueAmount"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "unadjustedPaymentDate",
          "description": "The unadjusted payment date.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedPaymentDate",
          "description": "The adjusted payment date. This date should already be adjusted for any applicable business day convention. This component is not intended for use in trade confirmation but may be specified to allow the fee structure to also serve as a cashflow type component.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriod",
          "description": "The parameters used in the calculation of a fixed or floating rate calculation period amount. A list of calculation period elements may be ordered in the document by ascending start date. An FpML document which contains an unordered list of calculation periods is still regarded as a conformant document.",
          "range": "CalculationPeriod",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fixedPaymentAmount",
          "description": "A known fixed payment amount.",
          "range": "Money",
          "@type": "SlotDefinition"
        },
        {
          "name": "discountFactor",
          "description": "A decimal value representing the discount factor used to calculate the present value of cash flow.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "forecastPaymentAmount",
          "description": "A monetary amount representing the forecast of the future value of the payment.",
          "range": "Money",
          "@type": "SlotDefinition"
        },
        {
          "name": "presentValueAmount",
          "description": "A monetary amount representing the present value of the forecast payment.",
          "range": "Money",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PaymentCalculationPeriod",
      "all_of": [
        {
          "description": "PaymentCalculationPeriodChoice: condition to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "calculationPeriod",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "fixedPaymentAmount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "FpML_ird_34: FpML validation rule ird-34 - Either unadjustedPaymentDate or adjustedPaymentDate must exist.",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "unadjustedPaymentDate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "adjustedPaymentDate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PaymentDateSchedule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PaymentDateSchedule",
      "description": "The payment dates when specified as relative to a set of dates specified somewhere else in the instance document/transaction, e.g. the valuation dates as typically the case for equity swaps, or when specified as a calculation period schedule.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "paymentDateSchedule__interimPaymentDates",
        "paymentDateSchedule__finalPaymentDate"
      ],
