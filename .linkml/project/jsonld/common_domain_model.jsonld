      "description": "Specification for General Terms and Elections of an Equity Master Confirmation that is applicable across multiple Equity confirmations and is referenced by each of these confirmations, an example of which being the 2018 ISDA CDM Equity Confirmation for Security Equity Swap.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_confirmation",
      "is_a": "MasterConfirmationBase",
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EquityMasterConfirmation",
      "@type": "ClassDefinition"
    },
    {
      "name": "EquitySwapMasterConfirmation2018",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EquitySwapMasterConfirmation2018",
      "description": "Specification for the General Terms and Relationship Supplement Elections as provided in the 2018 ISDA CDM Equity Confirmation for Security Equity Swap.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_confirmation",
      "is_a": "EquityMasterConfirmation",
      "slots": [
        "equitySwapMasterConfirmation2018__typeOfSwapElection",
        "equitySwapMasterConfirmation2018__pricingMethodElection",
        "equitySwapMasterConfirmation2018__linearInterpolationElection",
        "equitySwapMasterConfirmation2018__settlementTerms",
        "equitySwapMasterConfirmation2018__valuationDates",
        "equitySwapMasterConfirmation2018__equityCashSettlementDates"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "typeOfSwapElection",
          "description": "Per Part 1 Section 4, 'Dividend Obligations', of the 2018 ISDA CDM Equity Confirmation, Para 4.2 'Dividend Returns'.",
          "range": "ReturnTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pricingMethodElection",
          "description": "Per Part 1 Section 5, 'Pricing', of the 2018 ISDA CDM Equity Confirmation, Para 5.1.",
          "range": "PriceReturnTerms",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "linearInterpolationElection",
          "description": "Per Part 1 Section 3, 'Floating Obligations', of the 2018 ISDA CDM Equity Confirmation. Para 3.3.",
          "range": "InterpolationMethodEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "settlementTerms",
          "description": "Per Part 1 Section 8, 'Settlement', of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap.",
          "range": "SettlementTerms",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationDates",
          "description": "The parameters used to generate the 'Equity Valuation Dates' schedule, including the Effective Date and Termination Date for the Swap.",
          "range": "ValuationDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "equityCashSettlementDates",
          "description": "The parameters used to generate the payment date schedule, relative to the equityCalculationPeriod. Per Part 1 Section 12, 'Definitions', of the 2018 ISDA CDM Equity Confirmation. Para 73.",
          "range": "PaymentDates",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EquitySwapMasterConfirmation2018",
      "@type": "ClassDefinition"
    },
