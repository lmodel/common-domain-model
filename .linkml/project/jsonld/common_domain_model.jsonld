          "description": "A set of href pointers to calculation period dates defined somewhere else in the document.",
          "range": "CalculationPeriodDates",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DateRelativeToCalculationPeriodDates",
      "@type": "ClassDefinition"
    },
