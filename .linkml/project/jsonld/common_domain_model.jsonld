          "@type": "SlotDefinition"
        },
        {
          "name": "legalEntity",
          "range": "LegalEntity",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AncillaryEntity",
      "all_of": [
