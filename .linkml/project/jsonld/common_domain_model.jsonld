    {
      "name": "CreditSupportAmount",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportAmount",
      "description": "The total amount one counterparty must deliver to the other at any time: the combination of the Exposure to that party and the net Independent Amounts it must post, minus any agreed Threshold.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "creditSupportAmount__creditSupportAmount",
        "creditSupportAmount__additionalLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "creditSupportAmount",
          "description": "Specifies whether the meaning of credit support amount follows the pre-print definition or deviates from the standard (either based on a rating or some other methodology).",
          "range": "CreditSupportAmountEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalLanguage",
          "description": "The additional language that might be specified by the parties to the legal agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportAmount",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "creditSupportAmount",
                "equals_string": "Non-Standard - Other",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "additionalLanguage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "AdditionalLanguage: If a Non Standard Other definition is defined, additional language must be specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditSupportDocument",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportDocument",
