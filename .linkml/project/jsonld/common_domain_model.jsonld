    },
    {
      "name": "UmbrellaAgreement",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/UmbrellaAgreement",
      "description": "Specifies the set of agreements, the parties of which are set within UmbrellaAgreementSet, beyond the two contracting parties to that agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "umbrellaAgreement__agreementSet"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "agreementSet",
          "description": "The language associated with the umbrella agreement, and which applies to all the parties to the umbrella agreement.",
          "range": "UmbrellaAgreementSet",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/UmbrellaAgreement",
      "@type": "ClassDefinition"
    },
    {
      "name": "UmbrellaAgreementParty",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementParty",
      "description": "Specifies the entities that are part of the umbrella agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "umbrellaAgreementParty__party",
        "umbrellaAgreementParty__actingAs",
        "umbrellaAgreementParty__partyRole",
        "umbrellaAgreementParty__nonLegalEntity",
        "umbrellaAgreementParty__parentParty"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "party",
          "description": "Specifies the party to the umbrella agreement",
          "range": "Party",
          "@type": "SlotDefinition"
        },
        {
          "name": "actingAs",
          "description": "Specifies the CounterpartyRoleEnum, e.g. either Party1 or Party2, that is associated to the party.",
          "range": "CounterpartyRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRole",
          "description": "Represents the legal role that each defined entity to the agreement performs within the structure of that agreement.",
          "range": "UmbrellaPartyRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "nonLegalEntity",
          "description": "Specifies a non-legal entity that exists in the agreement with a defined relationship to a Legal entity to the agreement.",
          "range": "NonLegalEntity",
          "@type": "SlotDefinition"
        },
        {
          "name": "parentParty",
          "description": "Represents the identification of a parent child relationship between two entities in the Umbrella agreement, allowing non-legal entities to be linked to the appropriate legal entity and allowing funds, portfolio or managed accounts to be linked to their applicable Investment Manager or Agent within the agreement.",
          "range": "Party",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementParty",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "partyRole",
                "value_presence": "PRESENT",
                "equals_string": "Sleeve",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "parentParty",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ParentParty: Specifies that certain defined roles require that a parent party is identified.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "nonLegalEntity",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "parentParty",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NonLegalEntityParent: Non-Legal entity must have a Parent Party.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "UmbrellaParty: Only a Party or a non-Legal entity can be set.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "party",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "nonLegalEntity",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "UmbrellaAgreementSet",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementSet",
      "description": "Represents the groups of agreement term elections that exist within the agreement and to which entities that particular group of elections apply. Where all entities under the umbrella have the same set of elections only one agreement set will exist. At least one agreement set must be defined for an Umbrella agreement",
      "comments": [
        "Rosetta condition ExcludeGMSLA is not stated in LinkML: agreement -> masterAgreementElections -> islaGmsla is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "umbrellaAgreementSet__agreement",
        "umbrellaAgreementSet__party",
        "umbrellaAgreementSet__additionalLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "agreement",
          "description": "Specification of the standard set of terms that define a legal agreement.",
          "range": "Agreement",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "description": "Specifies the underlying parties to the agreement that either act as legal parties to the agreement or represent legal constructs that are managed by a party to the agreement but do not represent a Legal Entity as of themselves.",
          "range": "UmbrellaAgreementParty",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalLanguage",
          "description": "Represents any additional language that may need to be captured regarding the structure or application of terms that may exist for the agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementSet",
      "@type": "ClassDefinition"
    },
    {
      "name": "BrokerConfirmation",
