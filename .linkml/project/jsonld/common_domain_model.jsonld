          "multivalued": true,
          "minimum_cardinality": 2,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/MinimumTransferAmount",
      "@type": "ClassDefinition"
    },
