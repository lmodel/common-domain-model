    {
      "name": "AggregationParameters",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AggregationParameters",
      "description": "Parameters to be used to filter events that are relevant to a given portfolio in order to calculate the state of this portfolio. The attributes correspond to all the possible aggregation criteria that can be used and these criteria can be combined. All the attributes are optional.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "slots": [
        "aggregationParameters__dateTime",
        "aggregationParameters__totalPosition",
        "aggregationParameters__positionStatus",
        "aggregationParameters__party",
        "aggregationParameters__product",
        "aggregationParameters__productQualifier",
        "aggregationParameters__tradeReference"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dateTime",
          "description": "To aggregate as of a particular date",
          "range": "datetime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "totalPosition",
          "description": "Specifies whether to calculate total position to given date, or only daily position for the given date.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "positionStatus",
          "description": "To aggregate based on position status (EXECUTED, SETTLED etc)",
          "range": "PositionStatusEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "To aggregate based on a selection of party(ies) / legal entity(ies).",
          "range": "Party",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "product",
          "description": "To aggregate based on a selection of products.",
          "range": "NonTransferableProduct",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "productQualifier",
          "description": "To aggregate based on a selection of product type(s).",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "range": "Trade",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AggregationParameters",
      "@type": "ClassDefinition"
    },
    {
      "name": "AvailableInventory",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AvailableInventory",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "A data type that can be used to describe the inventory of securities that a party holds. The securities are held in the AvailableInventoryRecord, with each item in the array being an individual security and its associated criteria. Criteria can include the quantity available, the rate at which the security is available to borrow at, as well as other details that can affect the decision as to whether a party wants to utilise the securities listed.",
      "comments": [
        "Rosetta condition ValidPartyRole is not stated in LinkML: IsValidPartyRole (partyRole, [PartyRoleEnum -> AgentLender, PartyRoleEnum -> BeneficialOwner, PartyRoleEnum -> Borrower, PartyRoleEnum -> Custodian, PartyRoleEnum -> Lender])"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "slots": [
        "availableInventory__availableInventoryType",
        "availableInventory__identifier",
        "availableInventory__comment",
        "availableInventory__messageInformation",
        "availableInventory__party",
        "availableInventory__partyRole",
        "availableInventory__availableInventoryRecord"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "availableInventoryType",
          "description": "Defines the purpose of this inventory.",
          "range": "AvailableInventoryTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "identifier",
          "description": "Unique identifier for this group. This can be used to uniquely identify a group of inventory records.",
          "range": "AssignedIdentifier",
          "@type": "SlotDefinition"
        },
        {
          "name": "comment",
          "description": "Optional comments for this group of inventory records.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "messageInformation",
          "description": "Allows details related to the availability messaging use case to be defined",
          "range": "MessageInformation",
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "description": "Defines all parties involved for the list of inventory records in this set of inventory. For example, when used to describe securities lending availability, this could hold the sender of the availability, the intended recipient, the beneficial owner(s), the lender (which may differ from the sender as the lender may have the same piece of availability going through multiple agents), an agent or a venue.",
          "range": "Party",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRole",
          "description": "Defines the role(s) that party(ies) may have in relation to the inventory.",
          "range": "PartyRole",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "availableInventoryRecord",
          "description": "An array holding the list of inventory being described. Each element in the inventoryRecord array represents an individual piece of inventory i.e. a security.",
          "range": "AvailableInventoryRecord",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AvailableInventory",
      "@type": "ClassDefinition"
    },
    {
      "name": "AvailableInventoryRecord",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AvailableInventoryRecord",
      "description": "An individual piece of available inventory. This represents a single security and its associated criteria. The criteria are used to describe any restrictions on the securities.",
      "comments": [
        "Rosetta condition InterestRate is not stated in LinkML: if interestRate exists then interestRate -> priceType = PriceTypeEnum -> InterestRate",
        "Rosetta condition ValidPartyRole is not stated in LinkML: IsValidPartyRole (partyRole, [PartyRoleEnum -> AgentLender, PartyRoleEnum -> BeneficialOwner, PartyRoleEnum -> Custodian, PartyRoleEnum -> Lender])"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "is_a": "InventoryRecord",
      "slots": [
        "inventoryRecord__identifier",
        "inventoryRecord__security",
        "availableInventoryRecord__expirationDateTime",
        "availableInventoryRecord__collateral",
        "availableInventoryRecord__partyRole",
        "availableInventoryRecord__quantity",
        "availableInventoryRecord__interestRate",
        "availableInventoryRecord__dividendTerms",
        "availableInventoryRecord__comment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "expirationDateTime",
          "description": "There may be a set period/time restriction associated to the security.",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateral",
          "description": "The type of collateral can often be required when determining if the piece of availability being described is suitable for a party.",
          "range": "CollateralProvisions",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRole",
          "description": "An individual security may be held by several agents. Including the party role at this level allows us to reference the party holding this specific item.",
          "range": "PartyRole",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "quantity",
          "description": "The quantity of the security",
          "range": "Quantity",
          "@type": "SlotDefinition"
        },
        {
          "name": "interestRate",
          "description": "An optional element which can be used to hold a rate associated to this piece of availability.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendTerms",
          "description": "Specifies the dividend requirements if applicable.",
          "range": "DividendTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "comment",
          "description": "Optional comment for this specific piece of inventory.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AvailableInventoryRecord",
      "@type": "ClassDefinition"
    },
    {
