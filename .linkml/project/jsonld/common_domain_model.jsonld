    },
    {
      "name": "ManualExercise",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ManualExercise",
      "description": "A class defining manual exercise, i.e. that the option buyer counterparty must give notice to the option seller of exercise.",
      "comments": [
        "Rosetta condition ManualExerciseNoticeReceiverParty is not stated in LinkML: if exerciseNotice -> exerciseNoticeReceiver exists then exerciseNotice -> exerciseNoticeReceiver = AncillaryRoleEnum -> ExerciseNoticeReceiverPartyManual"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "manualExercise__exerciseNotice",
        "manualExercise__fallbackExercise"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "exerciseNotice",
          "description": "Definition of the party to whom notice of exercise should be given.",
          "range": "ExerciseNotice",
          "@type": "SlotDefinition"
        },
        {
          "name": "fallbackExercise",
          "description": "If fallback exercise is specified then the notional amount of the underlying swap, not previously exercised under the swaption, will be automatically exercised at the expiration time on the expiration date if at such time the buyer is in-the-money, provided that the difference between the settlement rate and the fixed rate under the relevant underlying swap is not less than one tenth of a percentage point (0.10% or 0.001). The term in-the-money is assumed to have the meaning defined in the 2000 ISDA Definitions, Section 17.4. In-the-money.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ManualExercise",
      "@type": "ClassDefinition"
    },
    {
      "name": "MultipleExercise",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MultipleExercise",
      "description": "A class defining multiple exercises. As defined in the 2000 ISDA Definitions, Section 12.4. Multiple Exercise, the buyer of the option has the right to exercise all or less than all the unexercised notional amount of the underlying swap on one or more days in the exercise period, but on any such day may not exercise less than the minimum notional amount or more than the maximum notional amount, and if an integral multiple amount is specified, the notional exercised must be equal to or, be an integral multiple of, the integral multiple amount. In FpML, MultipleExercise is built upon the PartialExercise.model.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "is_a": "PartialExercise",
      "slots": [
        "partialExercise__notionalReference",
        "partialExercise__integralMultipleAmount",
        "partialExercise__minimumNotionalAmount",
        "partialExercise__minimumNumberOfOptions",
        "multipleExercise__maximumNotionalAmount",
        "multipleExercise__maximumNumberOfOptions"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "maximumNotionalAmount",
          "description": "The maximum notional amount that can be exercised on a given exercise date.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "maximumNumberOfOptions",
          "description": "The maximum number of options that can be exercised on a given exercise date. If the number is not specified, it means that the maximum number of options corresponds to the remaining unexercised options.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/MultipleExercise",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "maximumNumberOfOptions",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "maximumNotionalAmount",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "MaximumNumberOfOptions: FpML MultipleExercise construct specifies the maximumNumberOfOptions as a positive integer.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "minimumNumberOfOptions",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "minimumNumberOfOptions",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "MinimumNumberOfOptions: FpML MultipleExercise construct specifies the minimumNumberOfOptions as a positive integer.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "From PartialExercise. MinimumChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "minimumNotionalAmount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "minimumNumberOfOptions",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "MaximumChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "maximumNotionalAmount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "maximumNumberOfOptions",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "NonTransferableProduct",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/NonTransferableProduct",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A data type to specify the financial product's economic terms, alongside the product identification and product taxonomy. The non-transferable product data type represents a product that can be traded (as part of a TradableProduct) but cannot be transferred to others. It is meant to be used across the pre-execution, execution and (as part of the Contract) post-execution lifecycle contexts.",
      "comments": [
        "Rosetta condition PrimaryAssetClass is not stated in LinkML: if economicTerms -> nonStandardisedTerms = True then taxonomy -> primaryAssetClass exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "nonTransferableProduct__identifier",
        "nonTransferableProduct__taxonomy",
        "nonTransferableProduct__economicTerms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "Comprises a identifier and a source to uniquely identify the nonTransferableProduct.",
          "range": "ProductIdentifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "taxonomy",
          "description": "Specifies the product taxonomy, which is composed of a taxonomy value and a taxonomy source.",
          "range": "ProductTaxonomy",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "economicTerms",
          "description": "The price forming features, including payouts and provisions.",
          "range": "EconomicTerms",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/NonTransferableProduct",
      "@type": "ClassDefinition"
    },
    {
      "name": "OptionFeature",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/OptionFeature",
      "description": "Defines additional optional features that can be included in an option contract.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "optionFeature__fxFeature",
        "optionFeature__strategyFeature",
        "optionFeature__averagingFeature",
        "optionFeature__barrier",
        "optionFeature__passThrough"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "fxFeature",
          "description": "Describes a quanto or composite FX feature.",
          "range": "FxFeature",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "strategyFeature",
          "description": "Defines a simple strategy feature.",
          "range": "StrategyFeature",
          "@type": "SlotDefinition"
        },
        {
          "name": "averagingFeature",
          "description": "Defines an option feature in which an average market observation price is determined on valuation and compared to the strike to determine a settlement amount.",
          "range": "AveragingFeature",
          "@type": "SlotDefinition"
        },
        {
          "name": "barrier",
          "description": "Specifies a barrier feature.",
          "range": "Barrier",
          "@type": "SlotDefinition"
        },
        {
          "name": "passThrough",
          "description": "Specifies the rules for pass-through payments from the underlier, such as dividends.",
          "range": "PassThrough",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/OptionFeature",
      "@type": "ClassDefinition"
    },
    {
      "name": "OptionPayout",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/OptionPayout",
      "description": "The option payout specification terms. The associated globalKey denotes the ability to associate a hash value to the respective OptionPayout instantiation for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage.",
      "comments": [
        "Rosetta condition AsianOptionChoice_averagingStrikeFeature is not stated in LinkML: if strike -> averagingStrikeFeature exists then feature -> averagingFeature is absent",
        "Rosetta condition AsianOptionChoice_averagingFeature is not stated in LinkML: if feature -> averagingFeature exists then strike -> averagingStrikeFeature is absent",
        "Rosetta condition ClearedPhysicalSettlementExists is not stated in LinkML: if settlementTerms -> physicalSettlementTerms exists and underlier as Product ->> economicTerms -> payout as InterestRatePayout exists and underlier as Product ->> economicTerms -> payout as InterestRatePayout count = 2 then settlementTerms -> physicalSettlementTerms -> clearedPhysicalSettlement exists",
        "Rosetta condition DeliveryCapacity is not stated in LinkML: if delivery -> deliveryCapacity exists then schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity exists then delivery -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if delivery -> periods -> profile -> block -> deliveryCapacity exists then schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity exists then delivery -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent",
        "Rosetta condition PriceTimeIntervalQuantity is not stated in LinkML: if schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity exists then delivery -> periods -> profile -> block -> priceTimeIntervalQuantity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity is absent else if delivery -> periods -> profile -> block -> priceTimeIntervalQuantity exists then schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity exists then schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity is absent and delivery -> periods -> profile -> block -> priceTimeIntervalQuantity is absent",
        "Rosetta condition OptionStylePresent is not stated in LinkML: exerciseTerms -> style exists",
        "Rosetta condition OptionTypePresent is not stated in LinkML: if underlier as NonTransferableProduct is absent then optionType exists",
        "Rosetta condition SettlementCentreRequired is not stated in LinkML: if underlier as Security exists then (settlementTerms -> securitySettlementCentre exists and settlementTerms -> cashSettlementCentre exists)"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "is_a": "PayoutBase",
      "slots": [
        "payoutBase__payerReceiver",
        "payoutBase__priceQuantity",
        "payoutBase__principalPayment",
        "payoutBase__settlementTerms",
        "optionPayout__buyerSeller",
        "optionPayout__feature",
        "optionPayout__observationTerms",
        "optionPayout__schedule",
        "optionPayout__delivery",
        "optionPayout__underlier",
        "optionPayout__optionType",
        "optionPayout__exerciseTerms",
        "optionPayout__strike"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "buyerSeller",
          "range": "BuyerSeller",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "feature",
          "description": "The option feature, such as quanto, Asian, barrier, knock.",
          "range": "OptionFeature",
          "@type": "SlotDefinition"
        },
        {
          "name": "observationTerms",
          "description": "Class containing terms that are associated with observing a price/benchmark/index across either single or multple observations. To be used for option contracts that reference a benchmark price.",
          "range": "ObservationTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "schedule",
          "description": "Allows the full representation of a payout by defining a set of schedule periods. It supports standard schedule customization by expressing all the dates, quantities, and pricing data in a non-parametric way.",
          "range": "CalculationSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "delivery",
          "description": "Contains the information relative to the delivery of the asset.",
          "range": "AssetDeliveryInformation",
          "@type": "SlotDefinition"
        },
        {
          "name": "underlier",
          "description": "The financial product underlying the option, which can be of any type including an Asset, Basket, Index or a NonTransferableProduct.",
          "range": "Underlier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "optionType",
          "description": "The type of option transaction. From a usage standpoint, put/call is the default option type, while payer/receiver indicator is used for options on index credit default swaps, consistently with the industry practice. Straddle is used for the case of straddle strategy, that combine a call and a put with the same strike.",
          "range": "OptionTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseTerms",
          "description": "The terms for exercising the option, which include the option style (e.g. American style option), the exercise procedure (e.g. manual exercise) and the settlement terms (e.g. physical vs. cash).",
          "range": "ExerciseTerms",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "strike",
          "description": "Specifies the strike of the option",
          "range": "OptionStrike",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/OptionPayout",
      "@type": "ClassDefinition"
    },
