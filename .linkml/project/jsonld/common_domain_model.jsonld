          "range": "Quantity",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ReturnInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "ScheduledTransfer",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ScheduledTransfer",
      "description": "A scheduled transfer built into the contract. Extends PayoutTransferBase because a Scheduled Transfer originates from a Payout.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "PayoutTransferBase",
      "slots": [
        "transferBase__identifier",
        "transferBase__quantity",
        "transferBase__asset",
        "transferBase__settlementDate",
        "transferBase__paymentDiscounting",
        "transferBase__partyReferencePayerReceiver",
        "payoutTransferBase__payerReceiver",
        "payoutTransferBase__payoutReference",
        "scheduledTransfer__transferType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "transferType",
          "description": "Specifies the type of Scheduled Transfer.",
          "range": "ScheduledTransferEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ScheduledTransfer",
      "all_of": [
        {
          "description": "From PayoutTransferBase. PayerReceiverChoice: Required choice between a generic, unresolved payer/receiver and a party referenced payer/receiver for the transfer.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "partyReferencePayerReceiver",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "payerReceiver",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "SecurityLendingInvoice",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SecurityLendingInvoice",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Specifies the information required for inclusion in a securities lending billing invoice.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "securityLendingInvoice__sendingParty",
        "securityLendingInvoice__receivingParty",
        "securityLendingInvoice__billingStartDate",
        "securityLendingInvoice__billingEndDate",
        "securityLendingInvoice__billingRecord",
        "securityLendingInvoice__billingSummary"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "sendingParty",
          "description": "The party issuing the invoice",
          "range": "Party",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "receivingParty",
          "description": "The party receiving the invoice",
          "range": "Party",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "billingStartDate",
          "description": "The starting date of the period described by this invoice",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "billingEndDate",
          "description": "The ending date of the period described by this invoice",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "billingRecord",
          "description": "The billing records contained within the invoice",
          "range": "BillingRecord",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "billingSummary",
          "description": "The billing summaries contained within the invoice",
          "range": "BillingSummary",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SecurityLendingInvoice",
      "@type": "ClassDefinition"
    },
    {
      "name": "SpinOff",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SpinOff",
      "description": "Defines the underlier for both the Parent Company and the Child Compagny involved in Spin Off corporate action, as well as th respective price observation for each.",
      "comments": [
        "Rosetta condition EquityPrice is not stated in LinkML: parentSecurity -> securityType = Equity and childSecurity -> securityType = Equity"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "spinOff__parentSecurity",
        "spinOff__parentSecurityPrice",
        "spinOff__childSecurity",
        "spinOff__childSecurityPrice"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "parentSecurity",
          "description": "Defines the underlier for the Parent Company involved in Spin Off corporate action.",
          "range": "Security",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "parentSecurityPrice",
          "description": "The price observation that relates to underlier for the Parent Company.",
          "range": "Price",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "childSecurity",
          "description": "Defines the underlier for the Child Company involved in Spin Off corporate action.",
          "range": "Security",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "childSecurityPrice",
          "description": "The price observation that relates to underlier for the Child Company.",
          "range": "Price",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SpinOff",
      "@type": "ClassDefinition"
    },
    {
      "name": "SplitInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SplitInstruction",
      "description": "Specifies instructions for a split, consisting of a breakdown of instructions to be applied to each branch of the split. This instruction can be used to duplicate a trade, as in a clearing scenario, or to split a trade into smaller quantities (in which case each breakdown instruction needs to include a quantity change), as in an allocation.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "splitInstruction__breakdown"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "breakdown",
          "description": "Each split breakdown specifies the set of primitive instructions to be applied to a single branch of that split. N split breakdowns result in N output trades, which include the original trade. Instructions for how to handle the original trade (e.g. if it must be closed) must be specified in one of the breakdowns.",
          "range": "PrimitiveInstruction",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SplitInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "State",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/State",
      "description": "Defines the state of a trade at a point in the Trade's life cycle. Trades have many state dimensions, all of which are represented here. For example, states useful for position keeping are represented alongside those needed for regulatory reporting.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "state__closedState",
        "state__positionState"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "closedState",
          "description": "Represents the qualification of what led to the trade's closure alongside the dates on which this closure took effect.",
          "range": "ClosedState",
          "@type": "SlotDefinition"
        },
        {
          "name": "positionState",
          "description": "Identifies the state of the position, to distinguish if just executed, formed, already settled, closed, etc.",
          "range": "PositionStatusEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/State",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "positionState",
                "value_presence": "PRESENT",
                "equals_string": "Closed",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "closedState",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ClosedStateExists: When the position state is identified as closed, the closed state must also be specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "StockSplitInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/StockSplitInstruction",
      "description": "Data required to perform a stock split business event.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "stockSplitInstruction__adjustmentRatio",
        "stockSplitInstruction__effectiveDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "adjustmentRatio",
          "description": "The number that denotes the cumulative quantity of post-split shares issued to shareholders versus the quantity of pre-split shares previously issued to shareholders. This number will be multiplied by existing shares in an equity derivative contract or other positions to determine the post-split number of shares. With regard to any reference to price, the pre-split reference price will be divided by this number to determine the post-split reference price.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "The effective date of the stock split, also known as the ex-date. This is the date on which the additional shares are paid to the shareholders, or in the case of a reverse stock split, the number shares held by each shareholder is proportionally reduced. Equity derivative transactions can be amended in firms' internal systems on such date. In most markets, the listed stock price is reduced (or increased for a reverse stock split) to account for the split on the same date, but in some markets the price adjustment occurs on a later date. In either case, equity derivative transactions should be amended on the date that the stocks are paid to the shareholders (or consolidated).",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/StockSplitInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "TermsChangeInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TermsChangeInstruction",
      "description": "Specifies instructions for terms change consisting of the new transaction terms, and the renegotiation fee.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "termsChangeInstruction__product",
        "termsChangeInstruction__ancillaryParty",
        "termsChangeInstruction__adjustment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "product",
          "description": "product to be changed",
          "range": "NonTransferableProduct",
          "@type": "SlotDefinition"
        },
        {
          "name": "ancillaryParty",
          "description": "ancillary party to be changed",
          "range": "AncillaryParty",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustment",
          "range": "NotionalAdjustmentEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TermsChangeInstruction",
      "all_of": [
        {
          "description": "AtLeastOneOf",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "product",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "ancillaryParty",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "adjustment",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Trade",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Trade",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        },
        {
          "tag": "doc_reference",
          "value": "ICMA GMRA namingConvention Transaction",
          "@type": "Annotation"
        }
      ],
      "description": "Defines the output of a financial transaction between parties - a Business Event. A Trade impacts the financial position (i.e. the balance sheet) of involved parties.",
      "comments": [
        "Rosetta condition SettlementPayout is not stated in LinkML: if SettlementPayoutOnlyExists (product -> economicTerms -> payout) then partyRole -> role contains PartyRoleEnum -> Buyer and partyRole -> role contains PartyRoleEnum -> Seller and tradeLot -> priceQuantity -> price exists",
        "Rosetta condition PackageTrade is not stated in LinkML: if executionDetails -> packageReference exists then executionDetails -> packageReference -> componentId -> assignedIdentifier contains tradeIdentifier -> assignedIdentifier",
        "Rosetta condition DeliverableObligationsPhysicalSettlementMatrix is not stated in LinkML: if (contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType all <> MatrixTypeEnum -> CreditDerivativesPhysicalSettlementMatrix or contractDetails -> documentation -> legalAgreementIdentification -> agreementName -> contractualMatrix -> matrixType is absent) and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations exists then (product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notSubordinated exists and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> specifiedCurrency exists and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notSovereignLender exists and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notDomesticCurrency exists and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notDomesticLaw exists and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notContingent exists and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> notDomesticIssuance exists and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> assignableLoan exists and product -> economicTerms -> payout as CreditDefaultPayout -> settlementTerms -> physicalSettlementTerms -> deliverableObligations -> consentRequir