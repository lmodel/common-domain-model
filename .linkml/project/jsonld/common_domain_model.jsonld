    {
      "name": "Regime",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Regime",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 name Regime | ISDA CSA_IM_2018 name Regime",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify one or more regimes that may be specified as relevant to a legal agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "regime__applicableRegime",
        "regime__fallbackToMandatoryMethodDays"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicableRegime",
          "description": "A class to specify the regime(s) that parties to a legal agreement, such as the ISDA 2016 and 2018 CSA for Initial Margin, might agree to apply to one or both parties when acting as collateral taker, and specific terms associated with that application.",
          "range": "ApplicableRegime",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fallbackToMandatoryMethodDays",
          "description": "The specification of the number of days after effective delivery of notice that Mandatory method fallback applies. Specification is only required when one or more Regimes have Fall Back to Mandatory Method elected as a SIMM exception.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Regime",
      "@type": "ClassDefinition"
    },
    {
      "name": "RegimeTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RegimeTerms",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 name Regime | ISDA CSA_IM_2018 name Regime",
          "@type": "Annotation"
        }
      ],
      "description": "A class that is used by the ApplicableRegime and the AdditionalRegime classes to specify the regulatory regime terms.",
