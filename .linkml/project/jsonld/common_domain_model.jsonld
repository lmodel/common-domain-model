    {
      "name": "ResetInstructionState",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ResetInstructionState",
      "description": "The definitive state object for the Reset process. It acts as a cumulative 'Golden Record,' storing every data point captured from Step 1 (Index Collection) through Step 7 (Final Calculation) to ensure deterministic processing.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_instructioncomposition_reset",
      "slots": [
        "resetInstructionState__floatingRateIndex",
        "resetInstructionState__tradeDate",
        "resetInstructionState__unadjustedCalculationPeriod",
        "resetInstructionState__unadjustedResetDate",
        "resetInstructionState__adjustedCalculationPeriod",
        "resetInstructionState__adjustedResetDate",
        "resetInstructionState__unadjustedObservationDates",
        "resetInstructionState__floatingRateOptionData",
        "resetInstructionState__adjustedObservationDates",
        "resetInstructionState__resetValue",
        "resetInstructionState__calculationMethod",
        "resetInstructionState__observedRateDates"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "floatingRateIndex",
          "description": "The benchmark rate index (e.g., LIBOR, EURIBOR, SOFR) identified for this reset.",
          "range": "FloatingRateIndexEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeDate",
          "description": "The date the underlying trade was executed, used for referencing the relevant holiday calendars.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "unadjustedCalculationPeriod",
          "description": "The raw start and end dates of the period before any business day adjustments are applied.",
          "range": "CalculationPeriodBase",
          "@type": "SlotDefinition"
        },
        {
          "name": "unadjustedResetDate",
          "description": "The theoretical reset date before applying business day conventions.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedCalculationPeriod",
          "description": "The calculation period after adjusting for non-business days and relevant financial calendars.",
          "range": "CalculationPeriodBase",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedResetDate",
          "description": "The final, legally binding reset date after applying business day conventions.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "unadjustedObservationDates",
          "description": "The raw dates on which the market rate should be observed according to the index definition.",
          "range": "date",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "floatingRateOptionData",
          "description": "The specific day count fraction, fixings, and lookback parameters associated with the chosen index.",
          "range": "FloatingRateIndexDefinition",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedObservationDates",
          "description": "The final set of observation dates adjusted for bank holidays and index-specific calendars.",
          "range": "date",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "resetValue",
          "description": "The final calculated rate or price derived from the observed market data.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationMethod",
          "description": "The specific compounding or averaging formula used to arrive at the final reset value.",
          "range": "CalculationMethodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "observedRateDates",
          "description": "The audit trail of individual market fixings captured on each adjusted observation date.",
          "range": "DatedValue",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ResetInstructionState",
      "@type": "ClassDefinition"
    },
    {
      "name": "ResetInstructionSteps",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ResetInstructionSteps",
