    {
      "name": "ValuationSource",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ValuationSource",
      "description": "A class describing the method for obtaining a settlement rate, specified through either an information source (page), a settlement rate option (fixing) or by using quotes from reference banks.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "valuationSource__quotedCurrencyPair",
