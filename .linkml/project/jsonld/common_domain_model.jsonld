        "fixedPricePayout__fixedPrice",
        "fixedPricePayout__schedule"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "paymentDates",
          "description": "Specifies the parameters to generate the payment date schedule, either through a parametric representation or by reference to specified dates.",
          "range": "PaymentDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fixedPrice",
          "description": "Specifies the fixed price on which fixed forward payments are based.",
          "range": "FixedPrice",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "schedule",
          "description": "Allows the full representation of a payout by defining a set of schedule periods. It supports standard schedule customization by expressing all the dates, quantities, and pricing data in a non-parametric way.",
          "range": "CalculationSchedule",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FixedPricePayout",
      "all_of": [
        {
          "description": "Quantity: When there is an OptionPayout the quantity can be expressed as part of the payoutQuantity, or as part of the underlier in the case of a Swaption. For all other payouts that extend PayoutBase the payoutQuantity is a mandatory attribute.",
          "slot_conditions": [
            {
              "name": "priceQuantity",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "FxFeature",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FxFeature",
      "description": "A type for defining FX Features.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "fxFeature__referenceCurrency",
        "fxFeature__composite",
        "fxFeature__quanto",
        "fxFeature__crossCurrency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "referenceCurrency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "id scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the reference currency of the trade.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "composite",
          "description": "If 'Composite' is specified as the Settlement Type in the relevant Transaction Supplement, an amount in the Settlement Currency, determined by the Calculation Agent as being equal to the number of Options exercised or deemed exercised, multiplied by: (Settlement Price \u2013 Strike Price) / (Strike Price \u2013 Settlement Price) x Multiplier provided that if the above is equal to a negative amount the Option Cash Settlement Amount shall be deemed to be zero.",
          "range": "Composite",
          "@type": "SlotDefinition"
        },
        {
          "name": "quanto",
          "description": "If 'Quanto' is specified as the Settlement Type in the relevant Transaction Supplement, an amount, as determined by the Calculation Agent in accordance with the Section 8.2 of the Equity Definitions.",
          "range": "Quanto",
          "@type": "SlotDefinition"
        },
        {
          "name": "crossCurrency",
          "description": "If 'Cross-Currency' is specified as the Settlement Type in the relevant Transaction Supplement, an amount in the Settlement Currency, determined by the Calculation Agent as being equal to the number of Options exercised or deemed exercised, multiplied by: (Settlement Price \u2013 Strike Price) / (Strike Price \u2013 Settlement Price) x Multiplier x one unit of the Reference Currency converted into an amount in the Settlement Currency using the rate of exchange of the Settlement Currency as quoted on the Reference Price Source on the Valuation Date, provided that if the above is equal to a negative amount the Option Cash Settlement Amount shall be deemed to be zero.",
          "range": "Composite",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FxFeature",
      "all_of": [
        {
          "description": "FxFeatureChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "composite",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "quanto",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "crossCurrency",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "MandatoryEarlyTermination",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MandatoryEarlyTermination",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A data to: define an early termination provision for which exercise is mandatory.",
      "comments": [
        "Rosetta condition MandatoryEarlyTerminationCalculationAgent is not stated in LinkML: if calculationAgent -> calculationAgentParty exists then calculationAgent -> calculationAgentParty = AncillaryRoleEnum -> CalculationAgentMandatoryEarlyTermination"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "mandatoryEarlyTermination__mandatoryEarlyTerminationDate",
        "mandatoryEarlyTermination__calculationAgent",
        "mandatoryEarlyTermination__cashSettlement",
        "mandatoryEarlyTermination__mandatoryEarlyTerminationAdjustedDates"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "mandatoryEarlyTerminationDate",
          "description": "The early termination date associated with a mandatory early termination of a swap.",
          "range": "AdjustableDate",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationAgent",
          "description": "The ISDA Calculation Agent responsible for performing duties associated with an optional early termination.",
          "range": "CalculationAgent",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cashSettlement",
          "description": "If specified, this means that cash settlement is applicable to the transaction and defines the parameters associated with the cash settlement procedure. If not specified, then physical settlement is applicable.",
          "range": "SettlementTerms",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mandatoryEarlyTerminationAdjustedDates",
          "description": "The adjusted dates associated with a mandatory early termination provision. These dates have been adjusted for any applicable business day convention.",
          "range": "MandatoryEarlyTerminationAdjustedDates",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/MandatoryEarlyTermination",
      "@type": "ClassDefinition"
