    {
      "name": "CreditSupportAmountEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportAmountEnum",
      "description": "Specifies whether the meaning of credit support amount follows the pre-print definition or deviates from the standard (either based on a rating or some other methodology).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "Standard",
          "description": "The standard definition of the credit support amount applies."
        },
        {
          "text": "Non-Standard - IA Floor (Less GiverIA)",
          "aliases": [
            "IAFloorGIA"
          ]
        },
        {
          "text": "Non-Standard - IA Floor (Less GiverIA and TakerIA)",
          "aliases": [
            "IAFloorGIATIA"
          ]
        },
        {
          "text": "Non-Standard - Ratings",
          "aliases": [
            "NonStandardRatings"
          ]
        },
        {
          "text": "Non-Standard - Other",
          "aliases": [
            "NonStandardOther"
          ]
        }
      ]
    },
    {
      "name": "DeliveryReturnAmountEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DeliveryReturnAmountEnum",
      "description": "In respect of a Valuation Date, the amount of collateral which a party is entitled to demand to be transferred to it as a Delivery or Return Amount.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "Standard",
          "description": "Standard definition applies."
        },
        {
          "text": "NonStandardRatings",
          "description": "Election includes non-standard ratings-based language."
        },
        {
          "text": "NonStandardOther",
          "description": "Election includes non-standard bespoke language."
        }
      ]
    },
    {
      "name": "ElectiveAmountEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ElectiveAmountEnum",
      "description": "The enumerated values to specify an elective amount.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "Zero",
          "description": "The elective amount is zero."
        },
        {
          "text": "Unlimited",
          "description": "The elective amount has no upper limit."
        }
      ]
    },
    {
      "name": "ExceptionEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExceptionEnum",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_2016 paragraph 13 General Principles | ISDA CSA_IM_2018 paragraph 13 General Principles"
        }
      ],
      "description": "Values to specify the normalized exceptions applicable to an Initial Margin CSA.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "Applicable",
          "description": "The election is applicable."
        },
        {
          "text": "NotApplicable",
          "description": "The election is not applicable."
        },
        {
          "text": "Other",
          "description": "An alternative approach is described in the document as follows."
        }
      ]
    },
