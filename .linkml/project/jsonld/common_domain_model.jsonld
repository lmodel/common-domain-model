          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportDocument",
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditSupportDocumentElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportDocumentElection",
      "description": "The party election of Credit Support Provider(s), if any.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "creditSupportDocumentElection__party",
        "creditSupportDocumentElection__creditSupportDocumentTerms",
        "creditSupportDocumentElection__creditSupportDocumentTypes",
        "creditSupportDocumentElection__creditSupportDocument",
        "creditSupportDocumentElection__bespokeCreditSuppportDocument"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "party",
          "description": "The elective party.",
          "range": "Party",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "creditSupportDocumentTerms",
          "description": "Specification of the Credit Support Document terms.",
          "range": "CreditSupportDocumentTermsEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "creditSupportDocumentTypes",
          "description": "If a Credit Support Document is specified but not yet in CDM representation, it can still be captured. This argument should be used if the creditSupportDocument argument cannot be used due to not being able to represent the document fully in CDM format.",
          "range": "LegalAgreementIdentification",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "creditSupportDocument",
          "description": "The specified Credit Support Document(s), if any.",
          "range": "LegalAgreement",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "bespokeCreditSuppportDocument",
          "description": "Specification of a document when not captured under RelatedAgreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportDocumentElection",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "creditSupportDocumentTerms",
                "equals_string": "Specified",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "creditSupportDocument",
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  },
                  {
                    "name": "creditSupportDocumentTypes",
                    "value_presence": "ABSENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "creditSupportDocument",
                    "value_presence": "ABSENT",
                    "@type": "SlotDefinition"
                  },
                  {
                    "name": "creditSupportDocumentTypes",
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CreditSupportDocument: A validation rule to ensure that a Credit Support Document is specified when required, either by a full legal agreement, or by specification explicitly. Note only one can be provided..",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditSupportObligationsBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportObligationsBase",
      "description": "A logical container designed to hold a set of related data. In this case, designed to hold a set of clauses that are common amongst Legacy (1994/95), Variation Margin and Initial Margin Credit Support Documents in regards to Credit Support Obligations.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "creditSupportObligationsBase__deliveryAmount",
        "creditSupportObligationsBase__returnAmount",
        "creditSupportObligationsBase__minimumTransferAmount",
        "creditSupportObligationsBase__collateralTransferTiming",
        "creditSupportObligationsBase__bespokeTransferTiming"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "deliveryAmount",
          "description": "In respect of a Valuation Date, the amount of collateral which a party is entitled to demand to be transferred to it as a Delivery Amount.",
          "range": "CSADeliveryAmount",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "returnAmount",
          "description": "In respect of a Valuation Date, the amount of collateral which a party is entitled to demand to be recalled to it as a Return Amount.",
          "range": "CSAReturnAmount",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "minimumTransferAmount",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ISDA CSA_NewYork_1994 | ISDA CSA_English_1995 | ISDA CSD_English_1995 | ISDA CSA_VM_English_2016 | ISDA CSA_VM_NewYork_2016 | ISDA CSD_IM_English_2016 paragraph 13 General Principles clause (c)(vi)(C) name Rounding | ISDA CSA_IM_Japanese_2016 paragraph 13 General Principles clause (d)(vi)(C) name Rounding | ISDA CSA_IM_NewYork_2016 paragraph 13 General Principles clause (c)(vi)(C) name Rounding",
              "@type": "Annotation"
            }
          ],
          "description": "Represents the threshold specified in the agreement below which collateral need not be delivered, and represents the smallest incremental value of exposure that must be reached before the parties are obliged to transfer collateral.",
          "range": "MinimumTransferAmount",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralTransferTiming",
          "description": "Specification of transfer / settlement timing for cash and securities collateral assuming that the notice is provided before the Notification Time (and with a 1LBD lag introduced if the notice is delivered after the Notification Time), and that securities allow for a further Local Business Day for transfer / settlement.",
          "range": "CollateralTransferTiming",
          "@type": "SlotDefinition"
        },
        {
          "name": "bespokeTransferTiming",
          "description": "The time by which the transfer of collateral must take place when different from the Regular Settlement Day as a result of parties' election.",
          "range": "BespokeTransferTiming",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditSupportObligationsBase",
      "@type": "ClassDefinition"
    },
