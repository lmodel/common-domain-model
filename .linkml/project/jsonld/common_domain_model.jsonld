      "name": "MandatoryEarlyTerminationAdjustedDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MandatoryEarlyTerminationAdjustedDates",
      "description": "A data defining: the adjusted dates associated with a mandatory early termination provision.",
      "comments": [
        "Rosetta condition FpML_ird_44 is not stated in LinkML: adjustedEarlyTerminationDate <= adjustedCashSettlementValuationDate and adjustedCashSettlementValuationDate <= adjustedCashSettlementPaymentDate"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
