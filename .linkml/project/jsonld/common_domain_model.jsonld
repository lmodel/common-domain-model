              "value": "AcadiaSoft AM_1_0 namingConvention CSA"
            }
          ]
        },
        {
          "text": "CollateralTransferAgreement",
          "description": "A Collateral Transfer Agreement"
        }
      ]
    },
    {
      "name": "DeliveryAmountElectionEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DeliveryAmountElectionEnum",
      "description": "The enumerated values to specify the application of Interest Amount with respect to the Delivery Amount through standard language.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "permissible_values": [
        {
          "text": "LastLocalBusinessDay",
          "description": "The delivery only includes `Transfer on last Local Business Day."
        },
        {
          "text": "LastAndAnyLocalBusinessDay",
          "description": "The delivery includes both `Transfer on last Local Business Day` and `Transfer a Delivery Amount (IM) consisting of cash on any Local Business Day.`"
        }
      ]
    },
    {
      "name": "RatingPriorityResolutionEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RatingPriorityResolutionEnum",
      "description": "Represents an enumeration list to identify which Collateral Criteria type should have priority over others. If set to 'Issuer', the rating in the Issuer Criteria has priority or is used if there is no Asset criteria. If set to 'Asset', the rating in the Asset Criteria has priority or is used if there is no Issuer rating.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "permissible_values": [
        {
          "text": "Issuer",
          "description": "Denotes that the Issuer Criteria has priority."
        },
        {
          "text": "Asset",
          "description": "Denotes that the Asset Criteria has priority."
        },
        {
          "text": "Lowest",
          "description": "Denotes that lowest rating should be used if several criteria apply."
        },
        {
          "text": "Highest",
          "description": "Denotes that highest rating should be used if several criteria apply."
        },
        {
          "text": "Average",
          "description": "Denotes that average rating should be used if several criteria apply."
        }
      ]
    },
    {
      "name": "NotionalAdjustmentEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/NotionalAdjustmentEnum",
      "description": "The enumerated values to specify the conditions that govern the adjustment to the number of units of the return swap.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common",
      "permissible_values": [
        {
          "text": "Execution",
          "description": "The adjustments to the number of units are governed by an execution clause."
        },
        {
          "text": "PortfolioRebalancing",
          "description": "The adjustments to the number of units are governed by a portfolio rebalancing clause."
        },
        {
          "text": "Standard",
          "description": "The adjustments to the number of units are not governed by any specific clause."
        }
      ]
    },
    {
      "name": "PayRelativeToEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PayRelativeToEnum",
      "description": "The enumerated values to specify whether payments occur relative to the calculation period start date or end date, each reset date, valuation date or the last pricing date.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "permissible_values": [
        {
          "text": "CalculationPeriodStartDate",
          "description": "Payments will occur relative to the first day of each calculation period."
        },
        {
          "text": "CalculationPeriodEndDate",
          "description": "Payments will occur relative to the last day of each calculation period."
        },
        {
          "text": "LastPricingDate",
          "description": "Payments will occur relative to the last Pricing Date of each Calculation Period."
        },
        {
          "text": "ResetDate",
          "description": "Payments will occur relative to the reset date."
        },
        {
          "text": "ValuationDate",
          "description": "Payments will occur relative to the valuation date."
        }
      ]
    },
    {
      "name": "ResetRelativeToEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ResetRelativeToEnum",
      "description": "The enumerated values to specify whether resets occur relative to the first or last day of a calculation period.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "permissible_values": [
        {
          "text": "CalculationPeriodStartDate",
          "description": "Resets occur relative to the first day of a calculation period."
        },
        {
          "text": "CalculationPeriodEndDate",
          "description": "Resets occur relative to the last day of a calculation period."
        }
      ]
    },
    {
      "name": "StubPeriodTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/StubPeriodTypeEnum",
      "description": "The enumerated values to specify how to deal with a non standard calculation period within a swap stream.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "permissible_values": [
        {
          "text": "ShortInitial",
          "description": "If there is a non regular period remaining it is left shorter than the streams calculation period frequency and placed at the start of the stream."
        },
        {
          "text": "ShortFinal",
          "description": "If there is a non regular period remaining it is left shorter than the streams calculation period frequency and placed at the end of the stream."
        },
        {
          "text": "LongInitial",
          "description": "If there is a non regular period remaining it is placed at the start of the stream and combined with the adjacent calculation period to give a long first calculation period."
        },
        {
          "text": "LongFinal",
          "description": "If there is a non regular period remaining it is placed at the end of the stream and combined with the adjacent calculation period to give a long last calculation period."
        }
      ]
    },
    {
      "name": "WeeklyRollConventionEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/WeeklyRollConventionEnum",
      "annotations": [
        {
          "tag": "rosetta_extends",
