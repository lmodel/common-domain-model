    },
    {
      "name": "AssetDeliveryProfile",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AssetDeliveryProfile",
      "description": "Defines the delivery profile of the asset, including the load type and the delivery intervals.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "assetDeliveryProfile__loadType",
        "assetDeliveryProfile__block",
        "assetDeliveryProfile__bankHolidaysTreatment"
