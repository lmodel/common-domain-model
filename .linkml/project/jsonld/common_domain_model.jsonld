      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "offset",
          "range": "Offset",
          "@type": "SlotDefinition"
        },
        {
          "name": "customProvision",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CustomisableOffset",
      "@type": "ClassDefinition"
    },
    {
      "name": "DateList",
