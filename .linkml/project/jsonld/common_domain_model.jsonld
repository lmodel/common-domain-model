    {
      "name": "SubstituteCalculationAgentElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SubstituteCalculationAgentElection",
      "description": "An election to determine the characteristics around a substitution Calculation Agent.",
      "comments": [
        "Rosetta condition SubstituteCalculationAgentElectionDefined is not stated in LinkML: if methodologyForSubstitutionExists then substituteCalculationAgentIsIndependent exists and substituteCalculationAgentAppointedBy exists and costOfSubstituteCalculationAgentIsBoreBy exists",
        "Rosetta condition SubstituteCalculationAgentElectionOmitted is not stated in LinkML: if methodologyForSubstitutionExists = False then substituteCalculationAgentIsIndependent is absent and substituteCalculationAgentAppointedBy is absent and substituteCalculationAgentAppointedByIfOther is absent and costOfSubstituteCalculationAgentIsBoreBy is absent and costOfSubstituteCalculationAgentBoreByIfOther is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isda",
      "slots": [
        "substituteCalculationAgentElection__methodologyForSubstitutionExists",
        "substituteCalculationAgentElection__substituteCalculationAgentIsIndependent",
        "substituteCalculationAgentElection__substituteCalculationAgentAppointedBy",
        "substituteCalculationAgentElection__substituteCalculationAgentAppointedByIfOther",
        "substituteCalculationAgentElection__costOfSubstituteCalculationAgentIsBoreBy",
        "substituteCalculationAgentElection__costOfSubstituteCalculationAgentBoreByIfOther"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "methodologyForSubstitutionExists",
          "description": "A boolean to represent if the metholodgy exists for appointing a substitute Calculation Agent (True), or not (False).",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "substituteCalculationAgentIsIndependent",
          "description": "A boolean to represent that if a substitute Calculation Agent can be appointed, whether they should be independent (True) or not (False).",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "substituteCalculationAgentAppointedBy",
          "description": "A representation of who appoints the substitute Calculation Agent.",
          "range": "SubstituteCalculationAgentAppointerEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "substituteCalculationAgentAppointedByIfOther",
          "description": "A representation of who appoints the substitute Calculation Agent if 'Other' or 'Third Party'.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "costOfSubstituteCalculationAgentIsBoreBy",
          "description": "A representation of who bears the cost of the substitute calculation agent.",
          "range": "PayeeOfSubstituteCalculationAgentEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "costOfSubstituteCalculationAgentBoreByIfOther",
          "description": "A representation of who bears the cost of the substitute calculation agent if 'Other'.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SubstituteCalculationAgentElection",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "substituteCalculationAgentAppointedBy",
                "value_presence": "PRESENT",
                "equals_string": "Other",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "substituteCalculationAgentAppointedByIfOther",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "SubstituteCalculationAgentElectionOtherThenProvided: A validation rule to determine if appointed by is defined as 'Other' then the substituteCalculationAgentAppointedByIfOther exists.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "substituteCalculationAgentAppointedBy",
                    "value_presence": "PRESENT",
                    "equals_string": "Other",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "substituteCalculationAgentAppointedByIfOther",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "SubstituteCalculationAgentElectionDefinedNotOther: A validation rule to determine if appointed by is defined and not 'Other', then the substituteCalculationAgentAppointedByIfOther is omitted.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "costOfSubstituteCalculationAgentIsBoreBy",
                "value_presence": "PRESENT",
                "equals_string": "Other",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "costOfSubstituteCalculationAgentBoreByIfOther",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "SubstituteCalculationAgentIsBoreByElectionOtherThenProvided: A validation rule to determine if the cost bore by is defined as 'Other' then the costOfSubstituteCalculationAgentBoreByIfOther exists.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "costOfSubstituteCalculationAgentIsBoreBy",
                    "value_presence": "PRESENT",
                    "equals_string": "Other",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "costOfSubstituteCalculationAgentBoreByIfOther",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "SubstituteCalculationAgentIsBoreByElectionDefinedNotOther: A validation rule to determine if the cost bore by is defined and not 'Other', then the costOfSubstituteCalculationAgentBoreByIfOther is omitted.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
