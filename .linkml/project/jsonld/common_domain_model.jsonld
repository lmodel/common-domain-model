    {
      "name": "AssetDeliveryProfileBlock",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AssetDeliveryProfileBlock",
      "description": "Defines a delivery profile block, including start and end time, days of the week, duration, delivery capacity and price time interval quantity.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "assetDeliveryProfileBlock__startTime",
        "assetDeliveryProfileBlock__endTime",
        "assetDeliveryProfileBlock__dayOfWeek",
        "assetDeliveryProfileBlock__deliveryCapacity",
        "assetDeliveryProfileBlock__priceTimeIntervalQuantity"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "startTime",
          "description": "The start time of the delivery interval for each block or shape.",
          "range": "time",
          "@type": "SlotDefinition"
        },
        {
          "name": "endTime",
          "description": "The end time of the delivery interval for each block or shape.",
          "range": "time",
          "@type": "SlotDefinition"
        },
        {
          "name": "dayOfWeek",
          "description": "The days of the week of the delivery.",
          "range": "DayOfWeekEnum",
          "multivalued": true,
          "maximum_cardinality": 7,
          "@type": "SlotDefinition"
        },
        {
          "name": "deliveryCapacity",
          "description": "The number of units included in the transaction for each delivery interval",
          "range": "Quantity",
          "@type": "SlotDefinition"
        },
        {
          "name": "priceTimeIntervalQuantity",
          "description": "Price per quantity per delivery time interval.",
          "range": "Price",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AssetDeliveryProfileBlock",
      "@type": "ClassDefinition"
    },
    {
      "name": "BasketReferenceInformation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/BasketReferenceInformation",
      "description": "CDS Basket Reference Information.",
      "comments": [
        "Rosetta condition MthToDefault is not stated in LinkML: if (nthToDefault exists and mthToDefault exists) then nthToDefault < mthToDefault"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "basketReferenceInformation__basketName",
        "basketReferenceInformation__basketId",
        "basketReferenceInformation__referencePool",
        "basketReferenceInformation__nthToDefault",
        "basketReferenceInformation__mthToDefault",
        "basketReferenceInformation__tranche"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "basketName",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The name of the basket expressed as a free format string. FpML does not define usage rules for this element.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "basketId",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "A CDS basket identifier.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "referencePool",
          "description": "This element contains all the reference pool items to define the reference entity and reference obligation(s) in the basket.",
          "range": "ReferencePool",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "nthToDefault",
          "description": "N th reference obligation to default triggers payout.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "mthToDefault",
          "description": "M th reference obligation to default to allow representation of N th to M th defaults.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "tranche",
          "description": "This element contains CDS tranche terms.",
          "range": "Tranche",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/BasketReferenceInformation",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "mthToDefault",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "nthToDefault",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NthToDefault: As part of the branch of the choice node, FpML requires the nthToDefault element to be present, while the mthToDefault one is optional.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "BasketReferenceInformationChoice: Choice rule to represent an FpML choice construct. This choice rule is complemented by the data rule BasketReferenceInformation_nthToDefault to represent the FpML construct where there is a choice between a tranche element and a [required nthToDefault, optional mthToDefault] branch.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "nthToDefault",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "tranche",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "BondReference",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/BondReference",
      "description": "Reference to a bond underlier to represent an asset swap or Condition Precedent Bond.",
      "comments": [
        "Rosetta condition BondUnderlier is not stated in LinkML: bond -> securityType = Debt"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "bondReference__bond",
        "bondReference__conditionPrecedentBond",
        "bondReference__discrepancyClause",
        "bondReference__couponRate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "bond",
          "description": "Reference to a bond underlier.",
          "range": "Security",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "conditionPrecedentBond",
          "description": "To indicate whether the Condition Precedent Bond is applicable. The swap contract is only valid if the bond is issued and if there is any dispute over the terms of fixed stream then the bond terms would be used.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "discrepancyClause",
          "description": "To indicate whether the Discrepancy Clause is applicable.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "couponRate",
          "description": "Specifies the coupon rate (expressed in percentage) of a fixed income security or convertible bond.",
          "range": "FixedRateSpecification",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/BondReference",
      "@type": "ClassDefinition"
    },
    {
      "name": "BoundedCorrelation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/BoundedCorrelation",
      "description": "Describes correlation bounds, which form a cap and a floor on the realized correlation.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "boundedCorrelation__minimumBoundaryPercent",
        "boundedCorrelation__maximumBoundaryPercent"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "minimumBoundaryPercent",
          "description": "Minimum Boundary as a percentage of the Strike Price.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "maximumBoundaryPercent",
          "description": "Maximum Boundary as a percentage of the Strike Price.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/BoundedCorrelation",
      "@type": "ClassDefinition"
    },
    {
      "name": "BoundedVariance",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/BoundedVariance",
      "comments": [
        "Rosetta condition NonNegativeBarriers is not stated in LinkML: if upperBarrier exists then upperBarrier >= 0 and if lowerBarrier exists then lowerBarrier >= 0"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "boundedVariance__realisedVarianceMethod",
        "boundedVariance__daysInRangeAdjustment",
        "boundedVariance__upperBarrier",
        "boundedVariance__lowerBarrier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "realisedVarianceMethod",
          "description": "The contract specifies which price must satisfy the boundary condition.",
          "range": "RealisedVarianceMethodEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "daysInRangeAdjustment",
          "description": "The contract specifies whether the notional should be scaled by the Number of Days in Range divided by the Expected N. The number of Days in Ranges refers to the number of returns that contribute to the realized volatility.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "upperBarrier",
          "description": "All observations above this price level will be excluded from the variance calculation.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "lowerBarrier",
          "description": "All observations below this price level will be excluded from the variance calculation.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/BoundedVariance",
      "@type": "ClassDefinition"
    },
    {
      "name": "CalculationScheduleDeliveryPeriods",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationScheduleDeliveryPeriods",
      "description": "Period and time profile over which the delivery takes place.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "AssetDeliveryPeriods",
      "slots": [
        "AssetDeliveryPeriods_startDate",
        "AssetDeliveryPeriods_endDate",
        "assetDeliveryPeriods__profile",
        "calculationScheduleDeliveryPeriods__deliveryCapacity",
        "calculationScheduleDeliveryPeriods__priceTimeIntervalQuantity"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "deliveryCapacity",
          "description": "The number of units included in the transaction for each delivery interval",
          "range": "Quantity",
          "@type": "SlotDefinition"
        },
        {
          "name": "priceTimeIntervalQuantity",
          "description": "Price per quantity per delivery time interval.",
          "range": "Price",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculationScheduleDeliveryPeriods",
      "@type": "ClassDefinition"
    },
    {
      "name": "CashflowRepresentation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CashflowRepresentation",
      "description": "A data defining: the cashflow representation of a swap trade.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "cashflowRepresentation__cashflowsMatchParameters",
        "cashflowRepresentation__paymentCalculationPeriod"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cashflowsMatchParameters",
          "description": "A true/false flag to indicate whether the cashflows match the parametric definition of the stream, i.e. whether the cashflows could be regenerated from the parameters without loss of information.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentCalculationPeriod",
          "description": "The adjusted payment date and associated calculation period parameters required to calculate the actual or projected payment amount. A list of payment calculation period elements may be ordered in the document by ascending adjusted payment date. An FpML document containing an unordered list of payment calculation periods is still regarded as a conformant document.",
          "range": "PaymentCalculationPeriod",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CashflowRepresentation",
      "@type": "ClassDefinition"
    },
    {
      "name": "CommodityPayout",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CommodityPayout",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Payout based on the averaged price of a referenced underlier. (e.g. Commodities). Can represent both average (average of many) & bullet (average of 1) pricing",
      "comments": [
        "Rosetta condition CommodityUnderlier is not stated in LinkML: if underlier as Observable exists then ObservableIsCommodity (underlier as Observable) else if underlier as TransferableProduct -> economicTerms -> payout only-element as OptionPayout exists then ObservableIsCommodity (underlier as TransferableProduct -> economicTerms -> payout only-element as OptionPayout -> underlier as Observable) else if underlier as TransferableProduct -> economicTerms -> payout only-element as SettlementPayout exists then ObservableIsCommodity (underlier as TransferableProduct -> economicTerms -> payout only-element as SettlementPayout -> underlier as Observable) else False",
        "Rosetta condition DeliveryCapacity is not stated in LinkML: if delivery -> deliveryCapacity exists then schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity exists then delivery -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if delivery -> periods -> profile -> block -> deliveryCapacity exists then schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity exists then delivery -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent",
        "Rosetta condition PriceTimeIntervalQuantity is not stated in LinkML: if schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity exists then delivery -> periods -> profile -> block -> priceTimeIntervalQuantity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity is absent else if delivery -> periods -> profile -> block -> priceTimeIntervalQuantity exists then schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity exists then schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity is absent and delivery -> periods -> profile -> block -> priceTimeIntervalQuantity is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "PayoutBase",
      "slots": [
        "payoutBase__payerReceiver",
        "payoutBase__priceQuantity",
        "payoutBase__principalPayment",
        "payoutBase__settlementTerms",
        "commodityPayout__averagingFeature",
        "commodityPayout__commodityPriceReturnTerms",
        "commodityPayout__pricingDates",
        "commodityPayout__schedule",
        "commodityPayout__calculationPeriodDates",
        "commodityPayout__paymentDates",
        "commodityPayout__underlier",
        "commodityPayout__fxFeature",
        "commodityPayout__delivery"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "averagingFeature",
          "description": "Indicates if the averaging calculation, when applicable, is weighted or unweighted.",
          "range": "AveragingCalculation",
          "@type": "SlotDefinition"
        },
        {
          "name": "commodityPriceReturnTerms",
          "description": "Defines parameters in which the commodity price is assessed.",
          "range": "CommodityPriceReturnTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "pricingDates",
          "description": "Specifies specific dates or parametric rules for the dates on which the price will be determined.",
          "range": "PricingDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "schedule",
          "description": "Allows the full representation of a payout by defining a set of schedule periods. It supports standard schedule customization by expressing all the dates, quantities, and pricing data in a non-parametric way.",
          "range": "CalculationSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriodDates",
          "description": "Defines the calculation period dates schedule.",
          "range": "CalculationPeriodDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentDates",
          "description": "Defines the payment date schedule, as defined by the parameters that are needed to specify it, either in a parametric way or by reference to another schedule of dates (e.g. the valuation dates).",
          "range": "PaymentDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "underlier",
          "description": "Identifies the underlying product that is referenced for pricing of the applicable leg in a swap. Referenced in the '2018 ISDA CDM Equity Confirmation for Security Equity Swap' as Security.",
          "range": "Underlier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fxFeature",
          "description": "Defines quanto or composite FX features that are included in the swap leg.",
          "range": "FxFeature",
          "@type": "SlotDefinition"
        },
        {
          "name": "delivery",
          "description": "Contains the information relative to the delivery of the asset.",
          "range": "AssetDeliveryInformation",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CommodityPayout",
      "all_of": [
        {
          "description": "Quantity: When there is an OptionPayout the quantity can be expressed as part of the payoutQuantity, or as part of the underlier in the case of a Swaption. For all other payouts that extend PayoutBase the payoutQuantity is a mandatory attribute.",
          "slot_conditions": [
            {
              "name": "priceQuantity",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "CalculationPeriod: The calculation periods are either specified parametrically via CalculationPeriodDates or non-parametrically via SchedulePeriod.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "schedule",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "calculationPeriodDates",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CorrelationReturnTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CorrelationReturnTerms",
      "comments": [
        "Rosetta condition CorrelationValue is not stated in LinkML: correlationStrikePrice -> value > - 1 and correlationStrikePrice -> value < 1"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "ReturnTermsBase",
      "slots": [
        "returnTermsBase__valuationTerms",
        "returnTermsBase__annualizationFactor",
        "returnTermsBase__dividendApplicability",
        "returnTermsBase__equityUnderlierProvisions",
        "returnTermsBase__sharePriceDividendAdjustment",
        "returnTermsBase__expectedN",
        "returnTermsBase__initialLevel",
        "returnTermsBase__initialLevelSource",
        "returnTermsBase__meanAdjustment",
        "returnTermsBase__performance",
        "correlationReturnTerms__correlationStrikePrice",
        "correlationReturnTerms__boundedCorrelation",
        "correlationReturnTerms__numberOfDataSeries"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "correlationStrikePrice",
          "description": "Correlation Strike Price in accordance with the ISDA 2011 Equity Derivatives Definitions.",
          "range": "Price",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "boundedCorrelation",
          "description": "Describes correlation bounds, which form a cap and a floor on the realized correlation.",
          "range": "NumberRange",
          "@type": "SlotDefinition"
        },
        {
          "name": "numberOfDataSeries",
          "description": "Number of data series, normal market practice is that correlation data sets are drawn from geographic market areas, such as America, Europe and Asia Pacific, each of these geographic areas will have its own data series to avoid contagion.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CorrelationReturnTerms",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "numberOfDataSeries",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "numberOfDataSeries",
                "minimum_value": 1,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PositiveNumberOfDataSeries: The number of data series must be positive",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "From ReturnTermsBase. PositiveExpectedN: The number of expected trading dates must be positive",
          "slot_conditions": [
            {
              "name": "expectedN",
              "minimum_value": 1,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditDefaultPayout",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditDefaultPayout",
      "description": "The credit default payout specification provides the details necessary for determining when a credit payout will be triggered as well as the parameters for calculating the payout and the settlement terms. The associated globalKey denotes the ability to associate a hash value to the CreditDefaultPayout instantiations for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage.",
      "comments": [
        "Rosetta condition FpML_cd_12 is not stated in LinkML: if generalTerms -> referenceInformation -> referencePrice exists then generalTerms -> referenceInformation -> referencePrice -> value >= 0"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "PayoutBase",
      "slots": [
        "payoutBase__payerReceiver",
        "payoutBase__priceQuantity",
        "payoutBase__principalPayment",
        "payoutBase__settlementTerms",
        "creditDefaultPayout__generalTerms",
        "creditDefaultPayout__protectionTerms",
        "creditDefaultPayout__transactedPrice"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "generalTerms",
          "description": "The specification of the non-monetary terms for the Credit Derivative Transaction, including the buyer and seller and selected items from the ISDA 2014 Credit Definition article II, such as the reference obligation and related terms.",
          "range": "GeneralTerms",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "protectionTerms",
          "description": "Specifies the terms for calculating a payout to protect the buyer of the swap in the case of a qualified credit event. These terms include the applicable credit events, the reference obligation, and in the case of a CDS on mortgage-backed securities, the floatingAmountEvents.",
          "range": "ProtectionTerms",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "transactedPrice",
          "description": "The qualification of the price at which the contract has been transacted, in terms of market fixed rate, initial points, market price and/or quotation style. In FpML, those attributes are positioned as part of the fee leg.",
          "range": "TransactedPrice",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditDefaultPayout",
      "all_of": [
        {
          "description": "Quantity: When there is an OptionPayout the quantity can be expressed as part of the payoutQuantity, or as part of the underlier in the case of a Swaption. For all other payouts that extend PayoutBase the payoutQuantity is a mandatory attribute.",
          "slot_conditions": [
            {
              "name": "priceQuantity",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "DiscountingMethod",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DiscountingMethod",
      "description": "A data defining: discounting information. The 2000 ISDA definitions, section 8.4. discounting (related to the calculation of a discounted fixed amount or floating amount) apply. This type must only be included if discounting applies.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "discountingMethod__discountingType",
        "discountingMethod__discountRate",
        "discountingMethod__discountRateDayCountFraction"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "discountingType",
          "description": "The discounting method that is applicable.",
          "range": "DiscountingTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "discountRate",
          "description": "A discount rate, expressed as a decimal, to be used in the calculation of a discounted amount. A discount amount of 5% would be represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "discountRateDayCountFraction",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "A discount day count fraction to be used in the calculation of a discounted amount.",
          "range": "DayCountFractionEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DiscountingMethod",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "discountRateDayCountFraction",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "discountRate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DiscountRate: In FpML discountingRate and discountRateDayCountFraction are part of an optional node, with discountingRate as the required element as part of that node.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "DividendCurrency",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DividendCurrency",
      "description": "A class to specify the currency in which the dividends will be denominated, i.e. either in the dividend currency or in a currency specified as part of the contract.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "dividendCurrency__currency",
        "dividendCurrency__determinationMethod",
        "dividendCurrency__currencyReference"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The currency in which the dividend is denominated. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "determinationMethod",
          "description": "Specifies the method according to which the dividend is determined, e.g. the dividend currency.",
          "range": "DeterminationMethodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "currencyReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to a currency specified elsewhere in the document",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DividendCurrency",
      "all_of": [
        {
          "description": "Unnamed condition (one-of)",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "currency",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "determinationMethod",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "currencyReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "DividendDateReference",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DividendDateReference",
      "description": "A class to specify the dividend date by reference to another date, with the ability to apply and offset. This class doesn't exist in FpML and is meant to simplify the choice constraint associated with the DividendPaymentDate class.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "dividendDateReference__dateReference",
        "dividendDateReference__paymentDateOffset"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dateReference",
          "description": "Specification of the dividend date using an enumeration, with values such as the pay date, the ex-date or the record date.",
          "range": "DividendDateReferenceEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentDateOffset",
          "description": "Only to be used when SharePayment has been specified in the dividendDateReference element. The number of Currency Business Days following the day on which the Issuer of the Shares pays the relevant dividend to holders of record of the Shares.",
          "range": "Offset",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DividendDateReference",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "paymentDateOffset",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "dateReference",
                "equals_string": "SharePayment",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PaymentDateOffset: FpML specifies that paymentDateOffset is only to be used when SharePayment has been specified in the dividendDateReference element.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "DividendPaymentDate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DividendPaymentDate",
      "description": "A class describing the date on which the dividend will be paid/received. This class is also used to specify the date on which the FX rate will be determined, when applicable.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "dividendPaymentDate__dividendDateReference",
        "dividendPaymentDate__dividendDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dividendDateReference",
          "range": "DividendDateReference",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendDate",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DividendPaymentDate",
      "all_of": [
        {
          "description": "Unnamed condition (one-of)",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "dividendDateReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "dividendDate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "DividendPayoutRatio",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DividendPayoutRatio",
      "description": "A class describing the dividend payout ratio associated with an equity underlier. In certain cases the actual ratio is not known on trade inception, and only general conditions are then specified.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "dividendPayoutRatio__totalRatio",
        "dividendPayoutRatio__cashRatio",
        "dividendPayoutRatio__nonCashRatio",
        "dividendPayoutRatio__basketConstituent"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "totalRatio",
          "description": "Specifies the total actual dividend payout ratio associated with the equity underlier. A ratio of 90% should be expressed at 0.90.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cashRatio",
          "description": "Specifies the cash actual dividend payout ratio associated with the equity underlier. A ratio of 90% should be expressed at 0.90.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "nonCashRatio",
          "description": "Specifies the non cash actual dividend payout ratio associated with the equity underlier. A ratio of 90% should be expressed at 0.90.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "basketConstituent",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->observable->Basket->basketConstituent",
              "@type": "Annotation"
            }
          ],
          "description": "In the case of a basket underlier, specifies to which component of the basket this particular set of dividend payout ratios correspond.",
          "range": "BasketConstituent",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DividendPayoutRatio",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "cashRatio",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "cashRatio",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "totalRatio",
                "maximum_value": 1,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DividendPayoutRatioCash: The cash dividend payout ratio should be comprised between 0 and 100%, meaning 0 and 1.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "nonCashRatio",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "nonCashRatio",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "totalRatio",
                "maximum_value": 1,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DividendPayoutRatioNonCash: The non cash dividend payout ratio should be comprised between 0 and 100%, meaning 0 and 1.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "DividendPayoutRatioTotal: The dividend payout ratio should be comprised between 0 and 100%, meaning 0 and 1.",
          "slot_conditions": [
            {
              "name": "totalRatio",
              "minimum_value": 0,
              "maximum_value": 1,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "DividendPeriod",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DividendPeriod",
      "description": "Time bounded dividend payment periods, each with a dividend payment date per period.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "DividendPeriod_startDate",
        "DividendPeriod_endDate",
        "dividendPeriod__dateAdjustments",
        "dividendPeriod__basketConstituent",
        "dividendPeriod__dividendPaymentDate",
        "dividendPeriod__dividendValuationDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dateAdjustments",
          "description": "Date adjustments for all unadjusted dates in this dividend period.",
          "range": "BusinessDayAdjustments",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "basketConstituent",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->observable->Basket->basketConstituent",
              "@type": "Annotation"
            }
          ],
          "description": "For basket underliers, reference to the basket component which is paying dividends in the specified period.",
          "range": "BasketConstituent",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendPaymentDate",
          "description": "Specifies when the dividend will be paid to the receiver of the equity return. Has the meaning as defined in the ISDA 2002 Equity Derivatives Definitions. Is not applicable in the case of a dividend reinvestment election.",
          "range": "DividendPaymentDate",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendValuationDate",
          "description": "Specifies the dividend valuation dates of the swap.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DividendPeriod",
      "@type": "ClassDefinition"
    },
    {
      "name": "DividendReturnTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DividendReturnTerms",
      "description": "A class describing the conditions governing the payment of dividends to the receiver of the equity return, with the exception of the dividend payout ratio, which is defined for each of the underlying components.",
      "comments": [
        "Rosetta condition DividendPeriod is not stated in LinkML: if firstOrSecondPeriod exists then dividendPeriod -> startDate is absent and dividendPeriod -> endDate is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "dividendReturnTerms__dividendPayoutRatio",
        "dividendReturnTerms__dividendReinvestment",
        "dividendReturnTerms__dividendEntitlement",
        "dividendReturnTerms__dividendAmountType",
        "dividendReturnTerms__performance",
        "dividendReturnTerms__firstOrSecondPeriod",
        "dividendReturnTerms__extraordinaryDividendsParty",
        "dividendReturnTerms__excessDividendAmount",
        "dividendReturnTerms__dividendCurrency",
        "dividendReturnTerms__nonCashDividendTreatment",
        "dividendReturnTerms__dividendComposition",
        "dividendReturnTerms__specialDividends",
        "dividendReturnTerms__materialDividend",
        "dividendReturnTerms__dividendPeriod"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dividendPayoutRatio",
          "description": "Specifies the dividend payout ratio associated with each underlier. In FpML 5.10 the payout is positioned at the underlier level, although there is an intent to reconsider this approach and position it at the leg level. This is approach adopted by the CDM.",
          "range": "DividendPayoutRatio",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendReinvestment",
          "description": "Boolean element that defines whether the dividend will be reinvested or not.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendEntitlement",
          "description": "Defines the date on which the receiver of the equity return is entitled to the dividend.",
          "range": "DividendEntitlementEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendAmountType",
          "description": "Specifies whether the dividend is paid with respect to the Dividend Period.",
          "range": "DividendAmountTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "performance",
          "description": "Performance calculation, in accordance with Part 1 Section 12 of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap, Para 75. 'Equity Performance'. Cumulative performance is used as a notional multiplier factor on both legs of an Equity Swap.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "firstOrSecondPeriod",
          "description": "2002 ISDA Equity Derivatives Definitions: Dividend Period as either the First Period or the Second Period. |",
          "range": "DividendPeriodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "extraordinaryDividendsParty",
          "description": "Specifies the party which determines if dividends are extraordinary in relation to normal levels.",
          "range": "AncillaryRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "excessDividendAmount",
          "description": "Determination of Gross Cash Dividend per Share.",
          "range": "DividendAmountTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendCurrency",
          "description": "Specifies the currency in which the dividend will be denominated, e.g. the dividend currency, or a specified currency. This class is not specified as such in FpML, which makes use of the CurrencyAndDeterminationMethod.model to specify such terms.",
          "range": "DividendCurrency",
          "@type": "SlotDefinition"
        },
        {
          "name": "nonCashDividendTreatment",
          "description": "Specifies the treatment of Non-Cash Dividends.",
          "range": "NonCashDividendTreatmentEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendComposition",
          "description": "Specifies how the composition of Dividends is to be determined.",
          "range": "DividendCompositionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "specialDividends",
          "description": "Specifies the method according to which special dividends are determined.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "materialDividend",
          "description": "If present and true, then material non cash dividends are applicable.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendPeriod",
          "description": "One to many time bounded dividend payment periods, each with a dividend payment date per period.",
          "range": "DividendPeriod",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DividendReturnTerms",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "extraordinaryDividendsParty",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "extraordinaryDividendsParty",
                "value_presence": "PRESENT",
                "equals_string": "ExtraordinaryDividendsParty",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ExtraordinaryDividendsParty",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "EquityUnderlierProvisions",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EquityUnderlierProvisions",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "equityUnderlierProvisions__multipleExchangeIndexAnnexFallback",
        "equityUnderlierProvisions__componentSecurityIndexAnnexFallback",
        "equityUnderlierProvisions__localJurisdiction",
        "equityUnderlierProvisions__relevantJurisdiction"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "multipleExchangeIndexAnnexFallback",
          "description": "For an index option or swap transaction, a flag to indicate whether a relevant Multiple Exchange Index Annex is applicable to the transaction. This annex defines additional provisions which are applicable where an index is comprised of component securities that are traded on multiple exchanges.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "componentSecurityIndexAnnexFallback",
          "description": "For an index option or swap transaction, a flag to indicate whether a relevant Component Security Index Annex is applicable to the transaction.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "localJurisdiction",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The ISO 3166 standard code for the country within which the postal address is located.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "relevantJurisdiction",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The ISO 3166 standard code for the country within which the postal address is located.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EquityUnderlierProvisions",
      "all_of": [
        {
          "description": "ComponentSecurityOrMultipleExchange: If multipleExchangeIndexAnnexFallback is present then componentSecurityIndexAnnexFallback must be absent and vice versa.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "multipleExchangeIndexAnnexFallback",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "componentSecurityIndexAnnexFallback",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "multipleExchangeIndexAnnexFallback",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "componentSecurityIndexAnnexFallback",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "FixedAmountCalculationDetails",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FixedAmountCalculationDetails",
      "description": "Type for reporting the detailed results of calculating a cash flow for a calculation period. This is enhanced relative to the FpML-based cashflows structure to allow more information to be returned about daily compounded rates.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "fixedAmountCalculationDetails__calculationPeriod",
        "fixedAmountCalculationDetails__calculationPeriodNotionalAmount",
        "fixedAmountCalculationDetails__fixedRate",
        "fixedAmountCalculationDetails__yearFraction",
        "fixedAmountCalculationDetails__calculatedAmount"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "calculationPeriod",
          "description": "The calculation period for which the floating calculation was performed.",
          "range": "CalculationPeriodBase",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriodNotionalAmount",
          "description": "The notional in effect during the calculation period.",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fixedRate",
          "description": "The value of the fixed rate that was used.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "yearFraction",
          "description": "The fraction of a year that this calculation represents, according to the day count fraction method.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculatedAmount",
          "description": "The amount of the cash flow that was computed, including any spreads and other processing.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FixedAmountCalculationDetails",
      "@type": "ClassDefinition"
    },
    {
      "name": "FixedRateSpecification",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FixedRateSpecification",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Type defining the specification for a fixed rate.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "fixedRateSpecification__rateSchedule"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "rateSchedule",
          "description": "The fixed rate or fixed rate schedule expressed as explicit fixed rates and dates. In the case of a schedule, the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments.",
          "range": "RateSchedule",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FixedRateSpecification",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingAmountEvents",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingAmountEvents",
      "description": "A class to specify the ISDA terms relating to the floating rate payment events and the implied additional fixed payments, applicable to the credit derivatives transactions on mortgage-backed securities with pay-as-you-go or physical settlement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "floatingAmountEvents__failureToPayPrincipal",
        "floatingAmountEvents__interestShortfall",
        "floatingAmountEvents__writedown",
        "floatingAmountEvents__impliedWritedown",
        "floatingAmountEvents__floatingAmountProvisions",
        "floatingAmountEvents__additionalFixedPayments"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "failureToPayPrincipal",
          "description": "A floating rate payment event. Corresponds to the failure by the Reference Entity to pay an expected principal amount or the payment of an actual principal amount that is less than the expected principal amount. ISDA 2003 Term: Failure to Pay Principal.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "interestShortfall",
          "description": "A floating rate payment event. With respect to any Reference Obligation Payment Date, either (a) the non-payment of an Expected Interest Amount or (b) the payment of an Actual Interest Amount that is less than the Expected Interest Amount. ISDA 2003 Term: Interest Shortfall.",
          "range": "InterestShortFall",
          "@type": "SlotDefinition"
        },
        {
          "name": "writedown",
          "description": "A floating rate payment event. Results from the fact that the underlier writes down its outstanding principal amount. ISDA 2003 Term: Writedown.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "impliedWritedown",
          "description": "A floating rate payment event. Results from the fact that losses occur to the underlying instruments that do not result in reductions of the outstanding principal of the reference obligation.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "floatingAmountProvisions",
          "description": "Specifies the floating amount provisions associated with the floatingAmountEvents.",
          "range": "FloatingAmountProvisions",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalFixedPayments",
          "description": "Specifies the events that will give rise to the payment additional fixed payments.",
          "range": "AdditionalFixedPayments",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingAmountEvents",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingAmountProvisions",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingAmountProvisions",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "floatingAmountProvisions__wacCapInterestProvision",
        "floatingAmountProvisions__stepUpProvision"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "wacCapInterestProvision",
          "description": "As specified by the ISDA Supplement for use with trades on mortgage-backed securities, 'WAC Cap' means a weighted average coupon or weighted average rate cap provision (however defined in the Underlying Instruments) of the Underlying Instruments that limits, increases or decreases the interest rate or interest entitlement, as set out in the Underlying Instruments on the Effective Date without regard to any subsequent amendment The presence of the element with value set to 'true' signifies that the provision is applicable. From a usage standpoint, this provision is typically applicable in the case of CMBS and not applicable in case of RMBS trades.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "stepUpProvision",
          "description": "As specified by the ISDA Standard Terms Supplement for use with trades on mortgage-backed securities. The presence of the element with value set to 'true' signifies that the provision is applicable. If applicable, the applicable step-up terms are specified as part of that ISDA Standard Terms Supplement. From a usage standpoint, this provision is typically applicable in the case of RMBS and not applicable in case of CMBS trades.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingAmountProvisions",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRate",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "FloatingRateBase",
      "slots": [
        "floatingRateBase__rateOption",
        "floatingRateBase__spreadSchedule",
        "floatingRateBase__capRateSchedule",
        "floatingRateBase__floorRateSchedule",
        "floatingRate__floatingRateMultiplierSchedule",
        "floatingRate__rateTreatment",
        "floatingRate__calculationParameters",
        "floatingRate__fallbackRate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "floatingRateMultiplierSchedule",
          "description": "A rate multiplier or multiplier schedule to apply to the floating rate. A multiplier schedule is expressed as explicit multipliers and dates. In the case of a schedule, the step dates may be subject to adjustment in accordance with any adjustments specified in the calculationPeriodDatesAdjustments. The multiplier can be a positive or negative decimal. This element should only be included if the multiplier is not equal to 1 (one) for the term of the stream.",
          "range": "RateSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "rateTreatment",
          "description": "The specification of any rate conversion which needs to be applied to the observed rate before being used in any calculations. The two common conversions are for securities quoted on a bank discount basis which will need to be converted to either a Money Market Yield or Bond Equivalent Yield. See the Annex to the 2000 ISDA Definitions, Section 7.3. Certain General Definitions Relating to Floating Rate Options, paragraphs (g) and (h) for definitions of these terms.",
          "range": "RateTreatmentEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationParameters",
          "description": "Support for modular calculated rates, such such as lockout compound calculations.",
          "range": "FloatingRateCalculationParameters",
          "@type": "SlotDefinition"
        },
        {
          "name": "fallbackRate",
          "description": "Definition of any fallback rate that may be applicable.",
          "range": "FallbackRateParameters",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRate",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRateBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateBase",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class defining a floating interest rate through the specification of the floating rate index, the tenor, the multiplier schedule, the spread, the qualification of whether a specific rate treatment and/or a cap or floor apply.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "floatingRateBase__rateOption",
        "floatingRateBase__spreadSchedule",
        "floatingRateBase__capRateSchedule",
        "floatingRateBase__floorRateSchedule"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "rateOption",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=Observable->Index->InterestRateIndex",
              "@type": "Annotation"
            }
          ],
          "range": "InterestRateIndex",
          "@type": "SlotDefinition"
        },
        {
          "name": "spreadSchedule",
          "description": "The ISDA Spread or a Spread schedule expressed as explicit spreads and dates. In the case of a schedule, the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The spread is a per annum rate, expressed as a decimal. For purposes of determining a calculation period amount, if positive the spread will be added to the floating rate and if negative the spread will be subtracted from the floating rate. A positive 10 basis point (0.1%) spread would be represented as 0.001.",
          "range": "SpreadSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "capRateSchedule",
          "description": "The cap rate or cap rate schedule, if any, which applies to the floating rate. The cap rate (strike) is only required where the floating rate on a swap stream is capped at a certain level. A cap rate schedule is expressed as explicit cap rates and dates and the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The cap rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A cap rate of 5% would be represented as 0.05.",
          "range": "StrikeSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "floorRateSchedule",
          "description": "The floor rate or floor rate schedule, if any, which applies to the floating rate. The floor rate (strike) is only required where the floating rate on a swap stream is floored at a certain strike level. A floor rate schedule is expressed as explicit floor rates and dates and the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The floor rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A floor rate of 5% would be represented as 0.05.",
          "range": "StrikeSchedule",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateBase",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRateDefinition",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition",
      "description": "A data defining: parameters associated with a floating rate reset. This data forms: part of the cashflows representation of a stream.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "floatingRateDefinition__calculatedRate",
        "floatingRateDefinition__rateObservation",
        "floatingRateDefinition__floatingRateMultiplier",
        "floatingRateDefinition__spread",
        "floatingRateDefinition__capRate",
        "floatingRateDefinition__floorRate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "calculatedRate",
          "description": "The final calculated rate for a calculation period after any required averaging of rates A calculated rate of 5% would be represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "rateObservation",
          "description": "The details of a particular rate observation, including the fixing date and observed rate. A list of rate observation elements may be ordered in the document by ascending adjusted fixing date. An FpML document containing an unordered list of rate observations is still regarded as a conformant document.",
          "range": "RateObservation",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "floatingRateMultiplier",
          "description": "A rate multiplier to apply to the floating rate. The multiplier can be a positive or negative decimal. This element should only be included if the multiplier is not equal to 1 (one).",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "spread",
          "description": "The ISDA Spread, if any, which applies for the calculation period. The spread is a per annum rate, expressed as a decimal. For purposes of determining a calculation period amount, if positive the spread will be added to the floating rate and if negative the spread will be subtracted from the floating rate. A positive 10 basis point (0.1%) spread would be represented as 0.001.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "capRate",
          "description": "The cap rate, if any, which applies to the floating rate for the calculation period. The cap rate (strike) is only required where the floating rate on a swap stream is capped at a certain strike level. The cap rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A cap rate of 5% would be represented as 0.05.",
          "range": "Strike",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "floorRate",
          "description": "The floor rate, if any, which applies to the floating rate for the calculation period. The floor rate (strike) is only required where the floating rate on a swap stream is floored at a certain strike level. The floor rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. The floor rate of 5% would be represented as 0.05.",
          "range": "Strike",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "floatingRateMultiplier",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "floatingRateMultiplier",
                    "value_presence": "PRESENT",
                    "equals_number": 1,
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "FloatingRateMultiplier: FpML specifies that the floatingRateMultiplier should only be included if different from 1.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRateSpecification",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateSpecification",
      "description": "A class to specify the floating interest rate by extending the floating rate definition with a set of attributes that specify such rate: the initial value specified as part of the trade, the rounding convention, the averaging method and the negative interest rate treatment.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "FloatingRate",
      "slots": [
        "floatingRateBase__rateOption",
        "floatingRateBase__spreadSchedule",
        "floatingRateBase__capRateSchedule",
        "floatingRateBase__floorRateSchedule",
        "floatingRate__floatingRateMultiplierSchedule",
        "floatingRate__rateTreatment",
        "floatingRate__calculationParameters",
        "floatingRate__fallbackRate",
        "floatingRateSpecification__initialRate",
        "floatingRateSpecification__finalRateRounding",
        "floatingRateSpecification__averagingMethod",
        "floatingRateSpecification__negativeInterestRateTreatment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "initialRate",
          "description": "The initial floating rate reset agreed between the principal parties involved in the trade. This is assumed to be the first required reset rate for the first regular calculation period. It should only be included when the rate is not equal to the rate published on the source implied by the floating rate index. An initial rate of 5% would be represented as 0.05.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "finalRateRounding",
          "description": "The rounding convention to apply to the final rate used in determination of a calculation period amount.",
          "range": "Rounding",
          "@type": "SlotDefinition"
        },
        {
          "name": "averagingMethod",
          "description": "If averaging is applicable, this component specifies whether a weighted or unweighted average method of calculation is to be used. The component must only be included when averaging applies.",
          "range": "AveragingWeightingMethodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "negativeInterestRateTreatment",
          "description": "The specification of any provisions for calculating payment obligations when a floating rate is negative (either due to a quoted negative floating rate or by operation of a spread that is subtracted from the floating rate).",
          "range": "NegativeInterestRateTreatmentEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateSpecification",
      "@type": "ClassDefinition"
    },
    {
      "name": "FutureValueAmount",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FutureValueAmount",
      "description": "A class defining a currency and a future value date.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "futureValueAmount__quantity",
        "futureValueAmount__currency",
        "futureValueAmount__calculationPeriodNumberOfDays",
        "futureValueAmount__valueDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "quantity",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->quantity",
              "@type": "Annotation"
            }
          ],
          "range": "NonNegativeQuantitySchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The currency in which the an amount is denominated. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriodNumberOfDays",
          "description": "The number of days from the adjusted calculation period start date to the adjusted value date, calculated in accordance with the applicable day count fraction.",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "valueDate",
          "description": "Adjusted value date of the future value amount.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FutureValueAmount",
      "all_of": [
        {
          "description": "PositiveCalculationPeriodNumberOfDays: FpML specifies calculationPeriodNumberOfDays as a positiveInteger.",
          "slot_conditions": [
            {
              "name": "calculationPeriodNumberOfDays",
              "minimum_value": 0,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "GeneralTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/GeneralTerms",
      "description": "A class specifying a set of non-monetary terms for the Credit Derivative Transaction, including the buyer and seller and selected items from the ISDA 2014 Credit Definition article II, such as the reference obligation and related terms. The CDM GeneralTerms class corresponds to the FpML GeneralTerms complex type, except that the effectiveDate and scheduledTerminationDate have been positioned as part of the InterestRatePayout class in the CDM instead of in GeneralTerms.",
      "comments": [
        "Rosetta condition FpML_cd_41 is not stated in LinkML: if indexReferenceInformation -> tranche is absent then modifiedEquityDelivery is absent",
        "Rosetta condition BasketReferenceInformationNameOrId is not stated in LinkML: if basketReferenceInformation exists then basketReferenceInformation -> basketName exists or basketReferenceInformation -> basketId exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "generalTerms__referenceInformation",
        "generalTerms__indexReferenceInformation",
        "generalTerms__basketReferenceInformation",
        "generalTerms__additionalTerm",
        "generalTerms__substitution",
        "generalTerms__modifiedEquityDelivery"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "referenceInformation",
          "description": "This attribute contains all the terms relevant to defining the reference entity and reference obligation(s).",
          "range": "ReferenceInformation",
          "@type": "SlotDefinition"
        },
        {
          "name": "indexReferenceInformation",
          "description": "This attribute contains all the terms relevant to the underlying Index.",
          "range": "CreditIndex",
          "@type": "SlotDefinition"
        },
        {
          "name": "basketReferenceInformation",
          "description": "This attribute contains all the terms relevant to defining the Credit Default Swap Basket.",
          "range": "BasketReferenceInformation",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalTerm",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "This attribute is used for representing information contained in the Additional Terms field of the 2003 Master Credit Derivatives confirm.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "substitution",
          "description": "Value of this attribute set to 'true' indicates that substitution is applicable.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "modifiedEquityDelivery",
          "description": "Value of this attribute set to 'true' indicates that modified equity delivery is applicable.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/GeneralTerms",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "basketReferenceInformation",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "substitution",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "FpML_cd_42: FpML validation rule cd-42 - If basketReferenceInformation does not exist, then substitution must not exist.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "GeneralTermsChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "referenceInformation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "indexReferenceInformation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "basketReferenceInformation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "InflationRateSpecification",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/InflationRateSpecification",
      "description": "A data to: specify the inflation rate.",
      "comments": [
        "Rosetta condition InflationIndex is not stated in LinkML: rateOption as InflationIndex exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "FloatingRateSpecification",
      "slots": [
        "floatingRateBase__rateOption",
        "floatingRateBase__spreadSchedule",
        "floatingRateBase__capRateSchedule",
        "floatingRateBase__floorRateSchedule",
        "floatingRate__floatingRateMultiplierSchedule",
        "floatingRate__rateTreatment",
        "floatingRate__calculationParameters",
        "floatingRate__fallbackRate",
        "floatingRateSpecification__initialRate",
        "floatingRateSpecification__finalRateRounding",
        "floatingRateSpecification__averagingMethod",
        "floatingRateSpecification__negativeInterestRateTreatment",
        "inflationRateSpecification__inflationLag",
        "inflationRateSpecification__indexSource",
        "inflationRateSpecification__mainPublication",
        "inflationRateSpecification__interpolationMethod",
        "inflationRateSpecification__initialIndexLevel",
        "inflationRateSpecification__fallbackBondApplicable",
        "inflationRateSpecification__calculationMethod",
        "inflationRateSpecification__calculationStyle",
        "inflationRateSpecification__finalPrincipalExchangeCalculation"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "inflationLag",
          "description": "An off-setting period from the payment date which determines the reference period for which the inflation index is observed.",
          "range": "Offset",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "indexSource",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The reference source such as Reuters or Bloomberg. FpML specifies indexSource to be of type rateSourcePageScheme, but without specifying actual values.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mainPublication",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The current main publication source such as relevant web site or a government body. FpML specifies mainPublication to be of type mainPublicationSource, but without specifying actual values.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "interpolationMethod",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The method used when calculating the Inflation Index Level from multiple points. The most common is Linear.",
          "range": "InterpolationMethodEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "initialIndexLevel",
          "description": "Initial known index level for the first calculation period.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "fallbackBondApplicable",
          "description": "The applicability of a fallback bond as defined in the 2006 ISDA Inflation Derivatives Definitions, sections 1.3 and 1.8.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationMethod",
          "description": "Indicates how to use the inflation index to calculate the payment (e.g. Ratio, Return, Spread). Added for Inflation Asset Swap",
          "range": "InflationCalculationMethodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationStyle",
          "description": "Indicates the style of how the inflation index calculates the payment (e.g. YearOnYear, ZeroCoupon).",
          "range": "InflationCalculationStyleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "finalPrincipalExchangeCalculation",
          "description": "To be specified only for products that embed a redemption payment.",
          "range": "FinalPrincipalExchangeCalculationEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/InflationRateSpecification",
      "@type": "ClassDefinition"
    },
    {
      "name": "InterestRatePayout",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/InterestRatePayout",
      "description": "A class to specify all of the terms necessary to define and calculate a cash flow based on a fixed, a floating or an inflation index rate. The interest rate payout can be applied to interest rate swaps and FRA (which both have two associated interest rate payouts), credit default swaps (to represent the fee leg when subject to periodic payments) and equity swaps (to represent the funding leg). The associated globalKey denotes the ability to associate a hash value to the InterestRatePayout instantiations for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage.",
      "comments": [
        "Rosetta condition FutureValueNotional is not stated in LinkML: if rateSpecification as FixedRateSpecification is absent then priceQuantity -> futureValueNotional is absent",
        "Rosetta condition TerminationDate is not stated in LinkML: if priceQuantity -> futureValueNotional exists then priceQuantity -> futureValueNotional -> valueDate = calculationPeriodDates -> terminationDate -> adjustableDate -> adjustedDate",
        "Rosetta condition RateSpecification is not stated in LinkML: if rateSpecification is absent then priceQuantity -> priceSchedule exists",
        "Rosetta condition FpML_ird_6 is not stated in LinkML: if paymentDates -> firstPaymentDate exists and calculationPeriodDates -> effectiveDate exists then paymentDates -> firstPaymentDate > calculationPeriodDates -> effectiveDate -> adjustableDate -> unadjustedDate",
        "Rosetta condition FpML_ird_23 is not stated in LinkML: if stubPeriod -> initialStub exists then calculationPeriodDates -> firstRegularPeriodStartDate exists",
        "Rosetta condition FpML_ird_24 is not stated in LinkML: if stubPeriod -> finalStub exists then calculationPeriodDates -> lastRegularPeriodEndDate exists",
        "Rosetta condition InitialStubFinalStub is not stated in LinkML: if stubPeriod exists then stubPeriod -> initialStub exists or stubPeriod -> finalStub exists",
        "Rosetta condition CashSettlementTerms is not stated in LinkML: if settlementTerms -> settlementCurrency exists and (settlementTerms -> settlementCurrency <> priceQuantity -> quantitySchedule -> unit -> currency or settlementTerms -> settlementCurrency <> priceQuantity -> quantityMultiplier -> fxLinkedNotionalSchedule -> varyingNotionalCurrency) then (settlementTerms -> cashSettlementTerms -> valuationMethod exists and settlementTerms -> cashSettlementTerms -> valuationDate exists) or priceQuantity -> quantityMultiplier -> fxLinkedNotionalSchedule -> fxSpotRateSource exists",
        "Rosetta condition FpML_ird_7_1 is not stated in LinkML: if paymentDates -> paymentFrequency -> period = calculationPeriodDates -> calculationPeriodFrequency -> period and paymentDates -> paymentFrequency -> periodMultiplier = calculationPeriodDates -> calculationPeriodFrequency -> periodMultiplier then (compoundingMethod is absent or compoundingMethod = CompoundingMethodEnum -> None)",
        "Rosetta condition FpML_ird_7_2 is not stated in LinkML: if (paymentDates -> paymentFrequency -> period exists and calculationPeriodDates -> calculationPeriodFrequency -> period exists and paymentDates -> paymentFrequency -> period <> calculationPeriodDates -> calculationPeriodFrequency -> period) or (paymentDates -> paymentFrequency -> periodMultiplier exists and calculationPeriodDates -> calculationPeriodFrequency -> periodMultiplier exists and paymentDates -> paymentFrequency -> periodMultiplier <> calculationPeriodDates -> calculationPeriodFrequency -> periodMultiplier) then compoundingMethod exists",
        "Rosetta condition FpML_ird_29 is not stated in LinkML: if compoundingMethod exists and compoundingMethod <> CompoundingMethodEnum -> None then rateSpecification as FixedRateSpecification is absent",
        "Rosetta condition CalculationPeriodDatesFirstCompoundingPeriodEndDate is not stated in LinkML: if compoundingMethod is absent or compoundingMethod = CompoundingMethodEnum -> None then calculationPeriodDates -> firstCompoundingPeriodEndDate is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "PayoutBase",
      "slots": [
        "payoutBase__payerReceiver",
        "payoutBase__priceQuantity",
        "payoutBase__principalPayment",
        "payoutBase__settlementTerms",
        "interestRatePayout__rateSpecification",
        "interestRatePayout__dayCountFraction",
        "interestRatePayout__calculationPeriodDates",
        "interestRatePayout__paymentDates",
        "interestRatePayout__paymentDate",
        "interestRatePayout__paymentDelay",
        "interestRatePayout__resetDates",
        "interestRatePayout__discountingMethod",
        "interestRatePayout__compoundingMethod",
        "interestRatePayout__cashflowRepresentation",
        "interestRatePayout__stubPeriod",
        "interestRatePayout__bondReference",
        "interestRatePayout__fixedAmount",
        "interestRatePayout__floatingAmount",
        "interestRatePayout__spreadCalculationMethod"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "rateSpecification",
          "description": "The specification of the rate value(s) applicable to the contract using either a floating rate calculation, a single fixed rate, a fixed rate schedule, or an inflation rate calculation.",
          "range": "RateSpecification",
          "@type": "SlotDefinition"
        },
        {
          "name": "dayCountFraction",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The day count fraction. The cardinality has been relaxed when compared with the FpML interest rate swap for the purpose of accommodating standardized credit default swaps which DCF is not explicitly stated as part of the economic terms. The data rule InterestRatePayout_dayCountFraction requires that the DCF be stated for interest rate products.",
          "range": "DayCountFractionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriodDates",
          "description": "The parameters used to generate the calculation period dates schedule, including the specification of any initial or final stub calculation periods.",
          "range": "CalculationPeriodDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentDates",
          "description": "The payment date schedule, as defined by the parameters that are needed to specify it, either in a parametric way or by reference to another schedule of dates (e.g. the reset dates).",
          "range": "PaymentDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentDate",
          "description": "The payment date, where only one date is specified, as for the FRA product.",
          "range": "AdjustableDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentDelay",
          "description": "Applicable to CDS on MBS to specify whether payment delays are applicable to the fixed Amount. RMBS typically have a payment delay of 5 days between the coupon date of the reference obligation and the payment date of the synthetic swap. CMBS do not, on the other hand, with both payment dates being on the 25th of each month.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "resetDates",
          "description": "The reset dates schedule, i.e. the dates on which the new observed index value is applied for each period and the interest rate hence begins to accrue.",
          "range": "ResetDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "discountingMethod",
          "description": "The parameters specifying any discounting conventions that may apply. This element must only be included if discounting applies.",
          "range": "DiscountingMethod",
          "@type": "SlotDefinition"
        },
        {
          "name": "compoundingMethod",
          "description": "If one or more calculation period contributes to a single payment amount this element specifies whether compounding is applicable and, if so, what compounding method is to be used. This element must only be included when more than one calculation period contributes to a single payment amount.",
          "range": "CompoundingMethodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "cashflowRepresentation",
          "description": "The cashflow representation of the swap stream.",
          "range": "CashflowRepresentation",
          "@type": "SlotDefinition"
        },
        {
          "name": "stubPeriod",
          "description": "The stub calculation period amount parameters. This element must only be included if there is an initial or final stub calculation period. Even then, it must only be included if either the stub references a different floating rate tenor to the regular calculation periods, or if the stub is calculated as a linear interpolation of two different floating rate tenors, or if a specific stub rate or stub amount has been negotiated.",
          "range": "StubPeriod",
          "@type": "SlotDefinition"
        },
        {
          "name": "bondReference",
          "description": "Reference to a bond underlier to represent an asset swap or Condition Precedent Bond.",
          "range": "BondReference",
          "@type": "SlotDefinition"
        },
        {
          "name": "fixedAmount",
          "description": "Fixed Amount Calculation",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "floatingAmount",
          "description": "Floating Amount Calculation",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "spreadCalculationMethod",
          "description": "Method by which spread is calculated. For example on an asset swap: 'ParPar' or 'Proceeds' may be the method indicated.",
          "range": "SpreadCalculationMethodEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/InterestRatePayout",
      "rules": [
        {
          "preconditions": {
            "all_of": [
              {
                "slot_conditions": [
                  {
                    "name": "compoundingMethod",
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "compoundingMethod",
                        "value_presence": "PRESENT",
                        "equals_string": "None",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "resetDates",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "FpML_ird_9: FpML validation rule ird-9 - If calculationPeriodAmount/calculation/compoundingMethod exists, then resetDates must exist.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "Quantity: When there is an OptionPayout the quantity can be expressed as part of the payoutQuantity, or as part of the underlier in the case of a Swaption. For all other payouts that extend PayoutBase the payoutQuantity is a mandatory attribute.",
          "slot_conditions": [
            {
              "name": "priceQuantity",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "InterestRatePayoutChoice: The paymentDates attributes is applicable to interest rate payouts with periodic payments, while the paymentDate reflects the FpML FRA implementation where one specific date is specified.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "paymentDates",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "paymentDate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "paymentDates",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "paymentDate",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
