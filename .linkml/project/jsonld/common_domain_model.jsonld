    {
      "name": "eventTimestamp__dateTime",
      "description": "The CDM specifies that the zoned date time is to be expressed in accordance with ISO 8601, either as UTC as an offset to UTC.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slot_uri": "https://w3id.org/lmodel/common-domain-model/dateTime",
      "alias": "dateTime",
