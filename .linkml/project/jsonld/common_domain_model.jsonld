    {
      "name": "FxHaircutCurrency",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FxHaircutCurrency",
      "description": "A class to specify the reference currency for the purpose of specifying the FX Haircut relating to a posting obligation, as being either the Termination Currency or an FX Designated Currency.",
      "comments": [
        "Rosetta condition TerminationCurrency is not stated in LinkML: if isTerminationCurrency = True then fxDesignatedCurrency is absent",
        "Rosetta condition FxDesignatedCurrency is not stated in LinkML: if isTerminationCurrency = False then fxDesignatedCurrency exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "fxHaircutCurrency__isTerminationCurrency",
        "fxHaircutCurrency__fxDesignatedCurrency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "isTerminationCurrency",
          "description": "The reference currency for the purpose of specifying the FX Haircut relating to a posting obligation is the Termination Currency when the Boolean value is set to True.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fxDesignatedCurrency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "When specified, the reference currency for the purpose of specifying the FX Haircut relating to a posting obligation. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FxHaircutCurrency",
      "@type": "ClassDefinition"
    },
