    {
      "name": "EarlyTerminationEvent",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EarlyTerminationEvent",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A data to: define the adjusted dates associated with an early termination provision.",
      "comments": [
        "Rosetta condition FpML_ird_39 is not stated in LinkML: adjustedExerciseDate <= adjustedEarlyTerminationDate",
        "Rosetta condition FpML_ird_40 is not stated in LinkML: adjustedExerciseDate <= adjustedCashSettlementValuationDate",
        "Rosetta condition FpML_ird_41 is not stated in LinkML: adjustedCashSettlementValuationDate <= adjustedCashSettlementPaymentDate"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "earlyTerminationEvent__adjustedExerciseDate",
        "earlyTerminationEvent__adjustedEarlyTerminationDate",
        "earlyTerminationEvent__adjustedCashSettlementValuationDate",
        "earlyTerminationEvent__adjustedCashSettlementPaymentDate",
        "earlyTerminationEvent__adjustedExerciseFeePaymentDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "adjustedExerciseDate",
          "description": "The date on which option exercise takes place. This date should already be adjusted for any applicable business day convention.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedEarlyTerminationDate",
          "description": "The early termination date that is applicable if an early termination provision is exercised. This date should already be adjusted for any applicable business day convention.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedCashSettlementValuationDate",
          "description": "The date by which the cash settlement amount must be agreed. This date should already be adjusted for any applicable business day convention.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedCashSettlementPaymentDate",
          "description": "The date on which the cash settlement amount is paid. This date should already be adjusted for any applicable business date convention.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedExerciseFeePaymentDate",
          "description": "The date on which the exercise fee amount is paid. This date should already be adjusted for any applicable business day convention.",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EarlyTerminationEvent",
      "@type": "ClassDefinition"
    },
    {
      "name": "EarlyTerminationProvision",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EarlyTerminationProvision",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A data defining: an early termination provision for a swap. This early termination is at fair value, i.e. on termination the fair value of the product must be settled between the parties.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "earlyTerminationProvision__mandatoryEarlyTermination",
        "earlyTerminationProvision__mandatoryEarlyTerminationDateTenor",
        "earlyTerminationProvision__optionalEarlyTermination",
        "earlyTerminationProvision__optionalEarlyTerminationParameters"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "mandatoryEarlyTermination",
          "description": "A mandatory early termination provision to terminate the swap at fair value.",
          "range": "MandatoryEarlyTermination",
          "@type": "SlotDefinition"
        },
        {
          "name": "mandatoryEarlyTerminationDateTenor",
          "description": "Period after trade date of the mandatory early termination date.",
          "range": "Period",
          "@type": "SlotDefinition"
        },
        {
          "name": "optionalEarlyTermination",
          "description": "An option for either or both parties to terminate the swap at fair value.",
          "range": "OptionalEarlyTermination",
          "@type": "SlotDefinition"
        },
        {
          "name": "optionalEarlyTerminationParameters",
          "description": "Definition of the first early termination date and the frequency of the termination dates subsequent to that. American exercise is defined by having a frequency of one day.",
          "range": "ExercisePeriod",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EarlyTerminationProvision",
      "all_of": [
        {
          "description": "MandatoryEarlyTermination: The FpML MandatoryEarlyTermination.model specifies a required choice node. The choice node associated with the FpML EarlyTerminationProvision is quite complex and using the data rule provides a more flexible approach than adding complexity to the condition grammar.",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "mandatoryEarlyTermination",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "optionalEarlyTermination",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "mandatoryEarlyTermination",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                },
                {
                  "name": "optionalEarlyTermination",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "EconomicTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EconomicTerms",
      "description": "This class represents the full set of price-forming features associated with a contractual product: the payout component, the notional/quantity, the effective and termination date and the date adjustment provisions when applying uniformily across the payout components. This class also includes the legal provisions which have valuation implications: cancelable provision, extendible provision, early termination provision and extraordinary events specification.",
      "comments": [
        "Rosetta condition ReturnType_Total_Requires_Dividends is not stated in LinkML: if payout as PerformancePayout -> returnTerms -> priceReturnTerms -> returnType all = ReturnTypeEnum -> Total then payout as PerformancePayout -> returnTerms -> dividendReturnTerms exists",
        "Rosetta condition LastRegularPaymentDate is not stated in LinkML: if payout as InterestRatePayout -> paymentDates -> lastRegularPaymentDate exists and payout as InterestRatePayout -> stubPeriod -> finalStub exists then payout as InterestRatePayout count = 2",
        "Rosetta condition PayRelativeTo is not stated in LinkML: if payout as InterestRatePayout count = 2 and payout as InterestRatePayout -> paymentDates exists then payout as InterestRatePayout -> paymentDates -> payRelativeTo exists",
        "Rosetta condition PaymentDatesAdjustments is not stated in LinkML: if payout as InterestRatePayout count = 2 and payout as InterestRatePayout -> paymentDates exists then payout as InterestRatePayout -> paymentDates -> paymentDatesAdjustments exists",
        "Rosetta condition PaymentFrequency is not stated in LinkML: if payout as InterestRatePayout count = 2 and payout as InterestRatePayout -> paymentDates exists then payout as InterestRatePayout -> paymentDates -> paymentFrequency exists",
        "Rosetta condition Quantity is not stated in LinkML: if payout as OptionPayout exists then payout as OptionPayout -> priceQuantity exists or payout as OptionPayout -> underlier as Product ->> economicTerms -> payout as InterestRatePayout count = 2",
        "Rosetta condition DayCountFraction is not stated in LinkML: if payout as InterestRatePayout count = 2 then payout as InterestRatePayout -> dayCountFraction exists",
        "Rosetta condition PaymentDates is not stated in LinkML: if payout as InterestRatePayout count = 2 then payout as InterestRatePayout -> dayCountFraction exists",
        "Rosetta condition MarketPrice is not stated in LinkML: if payout as CreditDefaultPayout -> generalTerms -> indexReferenceInformation is absent then payout as CreditDefaultPayout -> transactedPrice -> marketFixedRate is absent and payout as CreditDefaultPayout -> transactedPrice -> marketPrice is absent",
        "Rosetta condition NotionalResetOnPerformancePayout is not stated in LinkML: payout as CreditDefaultPayout -> priceQuantity -> reset is absent and payout as AssetPayout -> priceQuantity -> reset is absent and payout as CommodityPayout -> priceQuantity -> reset is absent and payout as FixedPricePayout -> priceQuantity -> reset is absent and payout as SettlementPayout -> priceQuantity -> reset is absent and payout as OptionPayout -> priceQuantity -> reset is absent",
        "Rosetta condition NotionalResetInterestRatePayoutExists is not stated in LinkML: if payout as PerformancePayout -> priceQuantity -> reset contains True then payout as InterestRatePayout exists",
        "Rosetta condition FpML_cd_26_28 is not stated in LinkML: True",
        "Rosetta condition FpML_cd_27 is not stated in LinkML: True",
        "Rosetta condition FpML_cd_30 is not stated in LinkML: if payout as InterestRatePayout -> paymentDates -> lastRegularPaymentDate exists and terminationDate exists then payout as InterestRatePayout -> paymentDates -> lastRegularPaymentDate all < terminationDate -> adjustableDate -> unadjustedDate or payout as InterestRatePayout -> paymentDates -> lastRegularPaymentDate all < terminationDate -> adjustableDate -> adjustedDate",
        "Rosetta condition IndependentCalculationAgent is not stated in LinkML: if calculationAgent -> calculationAgentParty exists then calculationAgent -> calculationAgentParty = AncillaryRoleEnum -> CalculationAgentIndependent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "economicTerms__effectiveDate",
        "economicTerms__effectiveTime",
        "economicTerms__terminationDate",
        "economicTerms__terminationTime",
        "economicTerms__dateAdjustments",
        "economicTerms__payout",
        "economicTerms__terminationProvision",
        "economicTerms__calculationAgent",
        "economicTerms__nonStandardisedTerms",
        "economicTerms__collateral"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "effectiveDate",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ICMA GMRA namingConvention Purchase Date | ICMA ERCCBestPractice namingConvention Purchase Date",
              "@type": "Annotation"
            }
          ],
          "description": "The first day of the terms of the trade. This day may be subject to adjustment in accordance with a business day convention.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveTime",
          "description": "The time and zone of the first day of the terms of the trade. It can also be specified in relation to another time.",
          "range": "DirectOrRelativeTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "terminationDate",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ICMA GMRA namingConvention Repurchase Date | ICMA ERCCBestPractice namingConvention Repurchase Date",
              "@type": "Annotation"
            }
          ],
          "description": "The last day of the terms of the trade. This date may be subject to adjustments in accordance with the business day convention. It can also be specified in relation to another scheduled date (e.g. the last payment date).",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "terminationTime",
          "description": "The time and zone of the last day of the terms of the trade. It can also be specified in relation to another time.",
          "range": "DirectOrRelativeTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "dateAdjustments",
          "description": "The business day adjustment convention when it applies across all the payout components. This specification of the business day convention and financial business centers is used for adjusting any calculation period date if it would otherwise fall on a day that is not a business day in the specified business center.",
          "range": "BusinessDayAdjustments",
          "@type": "SlotDefinition"
        },
        {
          "name": "payout",
          "description": "The payout specifies the future cashflow computation methodology which characterizes a financial product.",
          "range": "Payout",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "terminationProvision",
          "description": "Contains optional provisions pertaining to the termination characteristics of a contract.",
          "range": "TerminationProvision",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationAgent",
          "description": "The ISDA calculation agent responsible for performing duties as defined in the applicable product definitions.",
          "range": "CalculationAgent",
          "@type": "SlotDefinition"
        },
        {
          "name": "nonStandardisedTerms",
          "description": "Specifies, when boolean value is True, that additional economic terms exist that have not been included in the product representation.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateral",
          "description": "Represents the collateral obligations of a party.",
          "range": "Collateral",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EconomicTerms",
      "@type": "ClassDefinition"
    },
    {
      "name": "EvergreenProvision",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EvergreenProvision",
      "description": "Specifies a transaction which automatically extends for a specified timeframe until the exercise of an embedded option.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "evergreenProvision__singlePartyOption",
        "evergreenProvision__noticePeriod",
        "evergreenProvision__noticeDeadlinePeriod",
        "evergreenProvision__noticeDeadlineDateTime",
        "evergreenProvision__extensionFrequency",
        "evergreenProvision__finalPeriodFeeAdjustment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "singlePartyOption",
          "description": "If evergreen termination is not available to both parties then this component specifies the buyer and seller of the option.",
          "range": "PartyRole",
          "@type": "SlotDefinition"
        },
        {
          "name": "noticePeriod",
          "description": "The length of each evergreen extension period relative to the effective date of the preceding contract.",
          "range": "RelativeDateOffset",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "noticeDeadlinePeriod",
          "description": "Defines the minimum period before an evergreen is scheduled to terminate that notice can be given that it will terminate beyond the scheduled termination date.",
          "range": "RelativeDateOffset",
          "@type": "SlotDefinition"
        },
        {
          "name": "noticeDeadlineDateTime",
          "description": "A specific date and time for the notice deadline",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "extensionFrequency",
          "description": "The frequency with which the evergreen contract will be extended if notice is not given.",
          "range": "AdjustableRelativeOrPeriodicDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "finalPeriodFeeAdjustment",
          "description": "An optional adjustment to the rate for the last period of the evergreen i.e. the period from when notice is given to stop rolling the contract through to the termination date.",
          "range": "Price",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EvergreenProvision",
      "@type": "ClassDefinition"
    },
    {
      "name": "ExerciseFee",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseFee",
      "description": "A class defining the fee payable on exercise of an option. This fee may be defined as an amount or a percentage of the notional exercised. As a difference with FpML, it extends the BuyerSeller class.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "is_a": "PayerReceiver",
      "slots": [
        "payerReceiver__payer",
        "payerReceiver__receiver",
        "exerciseFee__notionalReference",
        "exerciseFee__feeAmount",
        "exerciseFee__feeRate",
        "exerciseFee__feePaymentDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "notionalReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A pointer style reference to the associated notional schedule defined elsewhere in the document.",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "feeAmount",
          "description": "The amount of fee to be paid on exercise. The fee currency is that of the referenced notional.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "feeRate",
          "description": "A fee represented as a percentage of some referenced notional. A percentage of 5% would be represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "feePaymentDate",
          "description": "The date on which exercise fee(s) will be paid. It is specified as a relative date.",
          "range": "RelativeDateOffset",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseFee",
      "all_of": [
        {
          "description": "ExerciseFeeChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "feeAmount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "feeRate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ExerciseFeeSchedule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule",
      "description": "A class to define a fee or schedule of fees to be payable on the exercise of an option. This fee may be defined as an amount or a percentage of the notional exercised. As a difference with FpML, it extends the BuyerSeller class.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "is_a": "PayerReceiver",
      "slots": [
        "payerReceiver__payer",
        "payerReceiver__receiver",
        "exerciseFeeSchedule__notionalReference",
        "exerciseFeeSchedule__feeAmountSchedule",
        "exerciseFeeSchedule__feeRateSchedule",
        "exerciseFeeSchedule__feePaymentDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "notionalReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A pointer style reference to the associated notional schedule defined elsewhere in the document.",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "feeAmountSchedule",
          "description": "The exercise fee amount schedule. The fees are expressed as currency amounts. The currency of the fee is assumed to be that of the notional schedule referenced.",
          "range": "AmountScheduleWithInitialValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "feeRateSchedule",
          "description": "The exercise free rate schedule. The fees are expressed as percentage rates of the notional being exercised. The currency of the fee is assumed to be that of the notional schedule referenced.",
          "range": "ScheduleWithInitialValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "feePaymentDate",
          "description": "The date on which exercise fee(s) will be paid. It is specified as a relative date.",
          "range": "RelativeDateOffset",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule",
      "all_of": [
        {
          "description": "ExerciseFeeScheduleChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "feeAmountSchedule",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "feeRateSchedule",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ExerciseNotice",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseNotice",
      "description": "Defines to whom and where notice of execution should be given. The exerciseNoticeGiver refers to one or both of the principal parties of the trade. If present the exerciseNoticeReceiver refers to a party, other than the principal party, to whom notice should be given.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "exerciseNotice__exerciseNoticeGiver",
        "exerciseNotice__exerciseNoticeReceiver",
        "exerciseNotice__businessCenter"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "exerciseNoticeGiver",
          "description": "Specifies the principal party of the trade that has the right to exercise.",
          "range": "ExerciseNoticeGiverEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseNoticeReceiver",
          "description": "Specifies the party to which notice of exercise should be given, e.g. by the buyer of the option. Although in many cases it is the buyer of the option who sends the exercise notice to the seller of the option, this component is reused, e.g. in case of OptionEarlyTermination, either or both parties have the right to exercise.",
          "range": "AncillaryRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCenter",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the location where the exercise must be reported, e.g. where the exercise notice receiver is based.",
          "range": "BusinessCenter",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseNotice",
      "@type": "ClassDefinition"
    },
    {
      "name": "ExercisePeriod",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExercisePeriod",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "This defines the time interval to the start of the exercise period, i.e. the earliest exercise date, and the frequency of subsequent exercise dates (if any).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "exercisePeriod__earliestExerciseDateTenor",
        "exercisePeriod__exerciseFrequency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "earliestExerciseDateTenor",
          "description": "The time interval to the first (and possibly only) exercise date in the exercise period.",
          "range": "Period",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseFrequency",
          "description": "The frequency of subsequent exercise dates in the exercise period following the earliest exercise date. An interval of 1 day should be used to indicate an American style exercise period.",
          "range": "Period",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExercisePeriod",
      "@type": "ClassDefinition"
    },
    {
      "name": "ExerciseProcedure",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseProcedure",
      "description": "A class describing how notice of exercise should be given. This can be either manual or automatic.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "exerciseProcedure__manualExercise",
        "exerciseProcedure__automaticExercise",
        "exerciseProcedure__followUpConfirmation",
        "exerciseProcedure__limitedRightToConfirm",
        "exerciseProcedure__splitTicket"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "manualExercise",
          "description": "Specifies that the notice of exercise must be given by the buyer to the seller or seller's agent.",
          "range": "ManualExercise",
          "@type": "SlotDefinition"
        },
        {
          "name": "automaticExercise",
          "description": "If automatic is specified, then the notional amount of the underlying swap not previously exercised under the swaption will be automatically exercised at the expiration time on the expiration date if at such time the buyer is in-the-money, provided that the difference between the settlement rate and the fixed rate under the relevant underlying swap is not less than the specified threshold rate. The term in-the-money is assumed to have the meaning defining in the 2000 ISDA Definitions, Section 17.4 In-the-money.",
          "range": "AutomaticExercise",
          "@type": "SlotDefinition"
        },
        {
          "name": "followUpConfirmation",
          "description": "A flag to indicate whether follow-up confirmation of exercise (written or electronic) is required following telephonic notice by the buyer to the seller or seller's agent.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "limitedRightToConfirm",
          "description": "Has the meaning defined as part of the 1997 ISDA Government Bond Option Definitions, section 4.5 Limited Right to Confirm Exercise. If present, (i) the Seller may request the Buyer to confirm its intent if not done on or before the expiration time on the Expiration date (ii) specific rules will apply in relation to the settlement mode.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "splitTicket",
          "description": "Typically applicable to the physical settlement of bond and convertible bond options. If present, means that the party required to deliver the bonds will divide those to be delivered as notifying party desires to facilitate delivery obligations.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseProcedure",
      "all_of": [
        {
          "description": "ExerciseProcedureChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "manualExercise",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "automaticExercise",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ExerciseTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseTerms",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class defining the exercise period for an option together with any rules governing the notional amount of the underlying which can be exercised on any given exercise date and any associated exercise fees.",
      "comments": [
        "Rosetta condition AmericanExercise is not stated in LinkML: if style = OptionExerciseStyleEnum -> American then commencementDate exists and exerciseFee is absent and partialExercise is absent and expirationDate count = 1",
        "Rosetta condition ExpirationTimeChoice is not stated in LinkML: (if expirationTime exists then expirationTimeType = ExpirationTimeTypeEnum -> SpecificTime and if expirationTimeType = ExpirationTimeTypeEnum -> SpecificTime then expirationTime exists)"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "exerciseTerms__style",
        "exerciseTerms__commencementDate",
        "exerciseTerms__exerciseDates",
        "exerciseTerms__expirationDate",
        "exerciseTerms__relevantUnderlyingDate",
        "exerciseTerms__earliestExerciseTime",
        "exerciseTerms__latestExerciseTime",
        "exerciseTerms__expirationTime",
        "exerciseTerms__expirationTimeType",
        "exerciseTerms__multipleExercise",
        "exerciseTerms__exerciseFeeSchedule",
        "exerciseTerms__exerciseProcedure",
        "exerciseTerms__exerciseFee",
        "exerciseTerms__partialExercise"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "style",
          "description": "Whether the option has a single exercise (european), multiple exercise dates (bermuda), or a continuous range of exercise (american).",
          "range": "OptionExerciseStyleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "commencementDate",
          "description": "The first day of the exercise period for an American style option.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseDates",
          "description": "The dates that define the Bermuda option exercise dates and the expiration date. The last specified date is assumed to be the expiration date. The dates can either be specified as a series of explicit dates and associated adjustments or as a series of dates defined relative to another schedule of dates, for example, the calculation period start dates. Where a relative series of dates are defined the first and last possible exercise dates can be separately specified.",
          "range": "AdjustableOrRelativeDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "expirationDate",
          "description": "The last day within an exercise period for an American style option. For a European style option it is the only day within the exercise period.",
          "range": "AdjustableOrRelativeDate",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "relevantUnderlyingDate",
          "description": "The effective date on the underlying product if the option is exercised. For example, for a swaption it is the swap effective date, for an option on an FX spot or forward it is the value date for settlement, and in an extendible/cancelable provision it is the swap termination date, which is the date on which the termination is effective.'",
          "range": "AdjustableOrRelativeDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "earliestExerciseTime",
          "description": "The earliest time at which notice of exercise can be given by the buyer to the seller (or seller's agent) to, and including, the expiration date.",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "latestExerciseTime",
          "description": "For a Bermuda or American style option, the latest time on an exercise business day (excluding the expiration date) within the exercise period that notice can be given by the buyer to the seller or seller's agent. Notice of exercise given after this time will be deemed to have been given on the next exercise business day.",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "expirationTime",
          "description": "The latest time for exercise on expirationDate. It is made mandatory given that for all option styles, this field is required.",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "expirationTimeType",
          "description": "The time of day at which the equity option expires, for example the official closing time of the exchange.",
          "range": "ExpirationTimeTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "multipleExercise",
          "description": "As defined in the 2000 ISDA Definitions, Section 12.4. Multiple Exercise, the buyer of the option has the right to exercise all or less than all the unexercised notional amount of the underlying swap on one or more days in the exercise period, but on any such day may not exercise less than the minimum notional amount or more that the maximum notional amount, and if an integral multiple amount is specified, the notional amount exercised must be equal to, or be an integral multiple of, the integral multiple amount.",
          "range": "MultipleExercise",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseFeeSchedule",
          "description": "The fees associated with an exercise date. The fees are conditional on the exercise occurring. The fees can be specified as actual currency amounts or as percentages of the notional amount being exercised.",
          "range": "ExerciseFeeSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseProcedure",
          "description": "The set of parameters defining the procedure associated with the exercise, e.g. manual exercise.",
          "range": "ExerciseProcedure",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseFee",
          "description": "A fee to be paid on exercise. This could be represented as an amount or a rate and notional reference on which to apply the rate.",
          "range": "ExerciseFee",
          "@type": "SlotDefinition"
        },
        {
          "name": "partialExercise",
          "description": "As defined in the 2000 ISDA Definitions, Section 12.3. Partial Exercise, the buyer of the option has the right to exercise all or less than all the notional amount of the underlying swap on the expiration date, but may not exercise less than the minimum notional amount, and if an integral multiple amount is specified, the notional amount exercised must be equal to, or be an integral multiple of, the integral multiple amount.",
          "range": "PartialExercise",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseTerms",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "commencementDate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "expirationDate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CommencementAndExpirationDate: Condition to check that expiration date is present when commencement date is present.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "style",
                "value_presence": "PRESENT",
                "equals_string": "European",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "expirationDate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "exerciseFeeSchedule",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "multipleExercise",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "latestExerciseTime",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "commencementDate",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "EuropeanExercise: Condition to check that only fields expected for a european option are present.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "style",
                "value_presence": "PRESENT",
                "equals_string": "Bermuda",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "exerciseDates",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "earliestExerciseTime",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "partialExercise",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "exerciseFee",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "BermudaExercise: Condition to check that only fields expected for a bermuda option are present.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "ExerciseDateExpirationDateChoice: Required choice rule between exercise dates and expiration date. The exerciseDates field can be used to extract the expiration date of a bermuda option, while the expirationDate field refers to the expiration date of an american or european option.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "exerciseDates",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "expirationDate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ExtendibleProvision",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExtendibleProvision",
      "description": "A data defining: an option to extend an existing swap transaction on the specified exercise dates for a term ending on the specified new termination date. As a difference from FpML, it extends the BuyerSeller class, which represents the BuyerSeller.model.",
      "comments": [
        "Rosetta condition ExtendibleProvisionExerciseNoticeReceiverParty is not stated in LinkML: if exerciseNotice -> exerciseNoticeReceiver exists then exerciseNotice -> exerciseNoticeReceiver = AncillaryRoleEnum -> ExerciseNoticeReceiverPartyExtendibleProvision"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "is_a": "BuyerSeller",
      "slots": [
        "buyerSeller__buyer",
        "buyerSeller__seller",
        "extendibleProvision__exerciseNotice",
        "extendibleProvision__followUpConfirmation",
        "extendibleProvision__extendibleProvisionAdjustedDates",
        "extendibleProvision__callingParty",
        "extendibleProvision__singlePartyOption",
        "extendibleProvision__noticeDeadlinePeriod",
        "extendibleProvision__noticeDeadlineDateTime",
        "extendibleProvision__extensionTerm",
        "extendibleProvision__extensionPeriod",
        "extendibleProvision__exerciseTerms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "exerciseNotice",
          "description": "Definition of the party to whom notice of exercise should be given.",
          "range": "ExerciseNotice",
          "@type": "SlotDefinition"
        },
        {
          "name": "followUpConfirmation",
          "description": "A flag to indicate whether follow-up confirmation of exercise (written or electronic) is required following telephonic notice by the buyer to the seller or seller's agent.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "extendibleProvisionAdjustedDates",
          "description": "The adjusted dates associated with an extendible provision. These dates have been adjusted for any applicable business day convention.",
          "range": "ExtendibleProvisionAdjustedDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "callingParty",
          "range": "CallingPartyEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "singlePartyOption",
          "description": "If the ability to extend the contract is not available to both parties then this component specifies the buyer and seller of the option.",
          "range": "PartyRole",
          "@type": "SlotDefinition"
        },
        {
          "name": "noticeDeadlinePeriod",
          "description": "Defines the minimum period before a contract is scheduled to terminate that notice can be given that it will terminate beyond the scheduled termination date.",
          "range": "RelativeDateOffset",
          "@type": "SlotDefinition"
        },
        {
          "name": "noticeDeadlineDateTime",
          "description": "A specific date and time for the notice deadline",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "extensionTerm",
          "description": "The length of each extension period relative to the effective date of the preceding contract.",
          "range": "RelativeDateOffset",
          "@type": "SlotDefinition"
        },
        {
          "name": "extensionPeriod",
          "description": "The period within which notice can be given that the contract will be extended.",
          "range": "AdjustableRelativeOrPeriodicDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseTerms",
          "description": "The exercise terms associated with the extendible provision, including details such as exercise style, exercise fees, and any other relevant conditions or terms governing the extension of the swap transaction.",
          "range": "ExerciseTerms",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExtendibleProvision",
      "@type": "ClassDefinition"
    },
    {
      "name": "ExtendibleProvisionAdjustedDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExtendibleProvisionAdjustedDates",
      "description": "A data defining: the adjusted dates associated with a provision to extend a swap.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "extendibleProvisionAdjustedDates__extensionEvent"
      ],
