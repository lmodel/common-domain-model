      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "creditRisk",
          "description": "Indicates tranched or untranched credit risk.",
          "range": "CreditRiskEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SpecialPurposeVehicleIssuerType",
      "@type": "ClassDefinition"
    },
    {
      "name": "Taxonomy",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Taxonomy",
      "description": "Defines the taxonomy of an object by combining a taxonomy source (i.e. the rules to classify the object) and a value (i.e. the output of those rules on the object).",
      "comments": [
        "Rosetta condition OrdinalExists is not stated in LinkML: if value -> classification count > 1 then value -> classification -> ordinal count = value -> classification count",
        "Rosetta condition DifferentOrdinals is not stated in LinkML: if value -> classification -> ordinal exists then value -> classification -> ordinal count = value -> classification -> ordinal distinct count",
        "Rosetta condition SequentialOrdinals is not stated in LinkML: if value -> classification count > 1 then value -> classification -> ordinal count = value -> classification -> ordinal max"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "Taxonomy_source",
        "taxonomy__value",
        "taxonomy__calculated"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "value",
          "description": "The value according to that taxonomy. Optional as it may not be possible to classify the object in that taxonomy.",
          "range": "TaxonomyValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculated",
          "description": "Specifies whether the taxonomy has been derived from the model features using a CDM qualification function that determines the product type based on the model features.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Taxonomy",
      "@type": "ClassDefinition"
    },
    {
      "name": "TaxonomyClassification",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TaxonomyClassification",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "TaxonomyClassification_description",
        "taxonomyClassification__className",
        "taxonomyClassification__value",
        "taxonomyClassification__ordinal"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "className",
          "description": "The name defined by the classification system for a specific attribute in the taxonomy",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "value",
          "description": "The value set by the taxonomy that is specific to the className attribute.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ordinal",
          "description": "In the case of multi-layered hierarchical classification systems such as commodity classification, the layer the value and className occupy in the classification hierarchy, where 1 represents the top-layer.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TaxonomyClassification",
      "@type": "ClassDefinition"
    },
    {
      "name": "TaxonomyValue",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TaxonomyValue",
      "description": "Defines a taxonomy value as either a simple string or a more granular expression with class names and values for each class.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "TaxonomyValue_name",
        "taxonomyValue__classification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "classification",
          "description": "Specifies the taxonomy value as a set of class names and values for each class.",
          "range": "TaxonomyClassification",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TaxonomyValue",
      "all_of": [
        {
          "description": "ValueExists",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "name",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "classification",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "NotDomesticCurrency",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency",
      "description": "A class to specify the ISDA 2003 Term: Not Domestic Currency.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit",
      "slots": [
        "notDomesticCurrency__applicable",
        "notDomesticCurrency__currency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicable",
          "description": "Indicates whether the Not Domestic Currency provision is applicable.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "An explicit specification of the domestic currency. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency",
      "@type": "ClassDefinition"
    },
    {
      "name": "Obligations",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Obligations",
      "description": "A class to specify the underlying obligations of the reference entity on which protection is purchased or sold through the Credit Default Swap.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit",
      "slots": [
        "obligations__category",
        "obligations__notSubordinated",
        "obligations__specifiedCurrency",
        "obligations__notSovereignLender",
        "obligations__notDomesticCurrency",
        "obligations__notDomesticLaw",
        "obligations__listed",
        "obligations__notDomesticIssuance",
        "obligations__fullFaithAndCreditObLiability",
        "obligations__generalFundObligationLiability",
        "obligations__revenueObligationLiability",
        "obligations__notContingent",
        "obligations__excluded",
        "obligations__othReferenceEntityObligations",
        "obligations__designatedPriority",
        "obligations__cashSettlementOnly",
        "obligations__deliveryOfCommitments",
        "obligations__continuity"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "category",
          "description": "Used in both obligations and deliverable obligations to represent a class or type of securities which apply. ISDA 2003 Term: Obligation Category/Deliverable Obligation Category.",
          "range": "ObligationCategoryEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "notSubordinated",
          "description": "An obligation and deliverable obligation characteristic. An obligation that ranks at least equal with the most senior Reference Obligation in priority of payment or, if no Reference Obligation is specified in the related Confirmation, the obligations of the Reference Entity that are senior. ISDA 2003 Term: Not Subordinated.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "specifiedCurrency",
          "description": "An obligation and deliverable obligation characteristic. The currency or currencies in which an obligation or deliverable obligation must be payable. ISDA 2003 Term: Specified Currency.",
          "range": "SpecifiedCurrency",
          "@type": "SlotDefinition"
        },
        {
          "name": "notSovereignLender",
          "description": "An obligation and deliverable obligation characteristic. Any obligation that is not primarily (majority) owed to a Sovereign or Supranational Organisation. ISDA 2003 Term: Not Sovereign Lender.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "notDomesticCurrency",
          "description": "An obligation and deliverable obligation characteristic. Any obligation that is payable in any currency other than the domestic currency. Domestic currency is either the currency so specified or, if no currency is specified, the currency of (a) the reference entity, if the reference entity is a sovereign, or (b) the jurisdiction in which the relevant reference entity is organised, if the reference entity is not a sovereign. ISDA 2003 Term: Not Domestic Currency.",
          "range": "NotDomesticCurrency",
          "@type": "SlotDefinition"
        },
        {
          "name": "notDomesticLaw",
          "description": "An obligation and deliverable obligation characteristic. If the reference entity is a Sovereign, this means any obligation that is not subject to the laws of the reference entity. If the reference entity is not a sovereign, this means any obligation that is not subject to the laws of the jurisdiction of the reference entity. ISDA 2003 Term: Not Domestic Law.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "listed",
          "description": "An obligation and deliverable obligation characteristic. Indicates whether or not the obligation is quoted, listed or ordinarily purchased and sold on an exchange. ISDA 2003 Term: Listed.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "notDomesticIssuance",
          "description": "An obligation and deliverable obligation characteristic. Any obligation other than an obligation that was intended to be offered for sale primarily in the domestic market of the relevant Reference Entity. This specifies that the obligation must be an internationally recognised bond. ISDA 2003 Term: Not Domestic Issuance.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "fullFaithAndCreditObLiability",
          "description": "An obligation and deliverable obligation characteristic. Defined in the ISDA published additional provisions for U.S. Municipal as Reference Entity. ISDA 2003 Term: Full Faith and Credit Obligation Liability.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "generalFundObligationLiability",
          "description": "An obligation and deliverable obligation characteristic. Defined in the ISDA published additional provisions for U.S. Municipal as Reference Entity. ISDA 2003 Term: General Fund Obligation Liability.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "revenueObligationLiability",
          "description": "An obligation and deliverable obligation characteristic. Defined in the ISDA published additional provisions for U.S. Municipal as Reference Entity. ISDA 2003 Term: Revenue Obligation Liability.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "notContingent",
          "description": "OTE: Only allowed as an obligation characteristic under ISDA Credit 1999. In essence Not Contingent means the repayment of principal cannot be dependent on a formula/index, i.e. to prevent the risk of being delivered an instrument that may never pay any element of principal, and to ensure that the obligation is interest bearing (on a regular schedule). ISDA 2003 Term: Not Contingent.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "excluded",
          "description": "A free format string to specify any excluded obligations or deliverable obligations, as the case may be, of the reference entity or excluded types of obligations or deliverable obligations. ISDA 2003 Term: Excluded Obligations/Excluded Deliverable Obligations.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "othReferenceEntityObligations",
          "description": "This element is used to specify any other obligations of a reference entity in both obligations and deliverable obligations. The obligations can be specified free-form. ISDA 2003 Term: Other Obligations of a Reference Entity.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "designatedPriority",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Applies to Loan CDS, to indicate what lien level is appropriate for a deliverable obligation. Applies to European Loan CDS, to indicate the Ranking of the obligation. Example: a 2nd lien Loan CDS would imply that the deliverable obligations are 1st or 2nd lien loans.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "cashSettlementOnly",
          "description": "An obligation and deliverable obligation characteristic. Defined in the ISDA published Standard Terms Supplement for use with CDS Transactions on Leveraged Loans. ISDA 2003 Term: Cash Settlement Only.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "deliveryOfCommitments",
          "description": "An obligation and deliverable obligation characteristic. Defined in the ISDA published Standard Terms Supplement for use with CDS Transactions on Leveraged Loans. ISDA 2003 Term: Delivery of Commitments.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "continuity",
          "description": "An obligation and deliverable obligation characteristic. Defined in the ISDA published Standard Terms Supplement for use with CDS Transactions on Leveraged Loans. ISDA 2003 Term: Continuity.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Obligations",
      "all_of": [
        {
          "description": "ObligationsChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "fullFaithAndCreditObLiability",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "generalFundObligationLiability",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "revenueObligationLiability",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "fullFaithAndCreditObLiability",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "generalFundObligationLiability",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "revenueObligationLiability",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "SpecifiedCurrency",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SpecifiedCurrency",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit",
      "slots": [
        "specifiedCurrency__applicable",
        "specifiedCurrency__currency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicable",
          "description": "Indicates whether the specified currency provision is applicable.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The currency in which the specified currency is denominated. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SpecifiedCurrency",
      "@type": "ClassDefinition"
    },
    {
      "name": "CodeList",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CodeList",
      "description": "A type hold a list of codes for business data validation",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_codelist",
      "slots": [
        "codeList__identification",
        "codeList__codes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identification",
          "description": "Identification information about the code list",
          "range": "CodeListIdentification",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "codes",
          "description": "Code values",
          "range": "CodeValue",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CodeList",
      "@type": "ClassDefinition"
    },
    {
      "name": "CodeListIdentification",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CodeListIdentification",
      "description": "A type to identify the version of a codelist",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_codelist",
      "slots": [
        "CodeListIdentification_description",
        "CodeListIdentification_version",
        "codeListIdentification__publicationDate",
        "codeListIdentification__shortName",
        "codeListIdentification__codeShortId",
        "codeListIdentification__canonicalUri",
        "codeListIdentification__canonicalVersionUri",
        "codeListIdentification__locationUri"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "publicationDate",
          "description": "The most recent date the code list was published, e.g. 2021-10-05",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "shortName",
          "description": "A short name (without whitespace) for the code list, e.g. businessCenterScheme",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "codeShortId",
          "description": "The name of the code list, e.g. business-center",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "canonicalUri",
          "description": "Canonical URI which uniquely identifies all versions (collectively) of the referenced code list. Must be an absolute URI. Must not be used as a de facto location URI.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "canonicalVersionUri",
          "description": "Canonical URI which uniquely identifies a specific version of the referenced code list. Must be an absolute URI. Must not be used as a de facto location URI.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "locationUri",
          "description": "Suggested retrieval location for this version, in genericode format. An application must signal an error to the user if a document retrieved using a LocationUri is not in genericode format.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CodeListIdentification",
      "@type": "ClassDefinition"
    },
    {
      "name": "CodeValue",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CodeValue",
      "description": "A type to hold the value of the code in a codelist",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_codelist",
      "slots": [
        "CodeValue_description",
        "CodeValue_source",
