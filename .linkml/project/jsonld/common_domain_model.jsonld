    {
      "name": "MultipleValuationDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MultipleValuationDates",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "is_a": "SingleValuationDate",
      "slots": [
        "singleValuationDate__businessDays",
        "multipleValuationDates__businessDaysThereafter",
        "multipleValuationDates__numberValuationDates"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "businessDaysThereafter",
          "description": "The number of business days between successive valuation dates when multiple valuation dates are applicable for cash settlement. ISDA 2003 Term: Business Days thereafter.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "numberValuationDates",
          "description": "Where multiple valuation dates are specified as being applicable for cash settlement, this element specifies (a) the number of applicable valuation dates, and (b) the number of business days after satisfaction of all conditions to settlement when the first such valuation date occurs, and (c) the number of business days thereafter of each successive valuation date. ISDA 2003 Term: Multiple Valuation Dates.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/MultipleValuationDates",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "businessDaysThereafter",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "businessDaysThereafter",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "BusinessDaysThereafter: FpML specifies businessDaysThereafter as a PositiveInteger.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "numberValuationDates",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "numberValuationDates",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NumberValuationDates: FpML specifies numberValuationDates as a PositiveInteger.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Observable",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Observable",
      "annotations": [
        {
          "tag": "rosetta_choice",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "Specifies the object to be observed for a price, it could be an asset or a reference.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slots": [
        "observable__Asset",
        "observable__Basket",
        "observable__Index"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "Asset",
          "description": "The object to be observed is an Asset, ie something that can be owned and transferred in the financial markets.",
          "range": "Asset",
          "@type": "SlotDefinition"
        },
        {
          "name": "Basket",
          "description": "The object to be observed is a Basket, ie a collection of Observables with an identifier and optional weightings.",
          "range": "Basket",
          "@type": "SlotDefinition"
        },
        {
          "name": "Index",
          "description": "The object to be observed is an Index, ie an observable computed on the prices, rates or valuations of a number of assets.",
          "range": "Index",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Observable",
      "all_of": [
        {
          "description": "OneOf: A choice type holds exactly one of its options.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "Asset",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "Basket",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "Index",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "OtherIndex",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/OtherIndex",
