      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "value",
          "description": "The value of the code, e.g. USNY",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "When the code became/becomes effective",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "deprecatedDate",
          "description": "When the code ceased to be valid for new uses",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CodeValue",
      "@type": "ClassDefinition"
    },
    {
      "name": "AssignedIdentifier",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AssignedIdentifier",
      "description": "A class to specify the identifier value and its associated version.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_identifier",
      "slots": [
        "AssignedIdentifier_version",
        "assignedIdentifier__identifier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The identifier value.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AssignedIdentifier",
      "@type": "ClassDefinition"
    },
    {
      "name": "IdentifiedList",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/IdentifiedList",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Attaches an identifier to a collection of objects, when those objects themselves can each be represented by an identifier. One use case is the representation of package transactions, where each component is a separate trade with its own identifier, and those trades are linked together as a package with its own identifier. The data type has been named generically rather than referring to 'packages' as it may have a number of other uses.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_identifier",
      "slots": [
        "identifiedList__listId",
        "identifiedList__componentId",
        "identifiedList__price"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "listId",
          "description": "The identifier for the list. In the case of a package transaction, this would be the package identifier. This attribute is mandatory to allow the list itself to be identified.",
          "range": "Identifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "componentId",
          "description": "Identifiers for each component of the list. Since the data type is used to link multiple identified objects together, at least 2 components are required in the list. Creating an identified list with only 1 identified component has been deemed unnecessary, because it would just create a redundant identifier.",
          "range": "Identifier",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "price",
          "description": "The price of the package.",
          "range": "Price",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/IdentifiedList",
      "@type": "ClassDefinition"
    },
    {
      "name": "Identifier",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Identifier",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        },
        {
          "tag": "doc_reference",
          "value": "ICMA GMRA namingConvention Identifier",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify a generic identifier, applicable to CDM artefacts such as executions, contracts, lifecycle events and legal documents. An issuer can be associated with the actual identifier value as a way to properly qualify it.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_identifier",
      "slots": [
        "identifier__issuerReference",
        "identifier__issuer",
        "identifier__assignedIdentifier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "issuerReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The identifier issuer, when specified by reference to a party specified as part of the transaction.",
          "range": "Party",
          "@type": "SlotDefinition"
        },
        {
          "name": "issuer",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The identifier issuer, when specified explicitly alongside the identifier value (instead of being specified by reference to a party).",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "assignedIdentifier",
          "description": "The identifier value. This level of indirection between the issuer and the identifier and its version provides the ability to associate multiple identifiers to one issuer, consistently with the FpML PartyTradeIdentifier.",
          "range": "AssignedIdentifier",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Identifier",
      "all_of": [
        {
          "description": "IssuerChoice: The identifier issuer is specified either explicitly or by reference to one of the parties.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "issuerReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "issuer",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "LocationIdentifier",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LocationIdentifier",
      "description": "Specifies a location identifier. An issuer and an identifier type can be associated with the actual identifier value as a way to properly qualify it.",
      "comments": [
        "Rosetta condition IdentifierType is not stated in LinkML: if locationIdentifierType exists then assignedIdentifier count = 1"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_identifier",
