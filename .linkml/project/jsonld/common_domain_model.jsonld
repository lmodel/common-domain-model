      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ContractualTermsSupplement",
      "@type": "ClassDefinition"
    },
    {
      "name": "LegalAgreement",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LegalAgreement",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "The specification of a legal agreement between two parties, being negotiated or having been executed. This includes the baseline information and the optional specialised elections",
      "comments": [
        "Rosetta condition ConsistentlyExecutedAgreements is not stated in LinkML: if relatedAgreements exists and agreementDate exists then relatedAgreements -> agreementDate exists",
        "Rosetta condition AgreementVerification is not stated in LinkML: if agreementTerms -> agreement -> securityAgreementElections exists then legalAgreementIdentification -> agreementName -> agreementType = LegalAgreementTypeEnum -> SecurityAgreement else if agreementTerms -> agreement -> creditSupportAgreementElections exists then legalAgreementIdentification -> agreementName -> creditSupportAgreementType = CreditSupportAgreementTypeEnum -> CreditSupportAnnex or legalAgreementIdentification -> agreementName -> creditSupportAgreementType = CreditSupportAgreementTypeEnum -> CreditSupportDeed else if agreementTerms -> agreement -> collateralTransferAgreementElections exists then legalAgreementIdentification -> agreementName -> creditSupportAgreementType = CreditSupportAgreementTypeEnum -> CollateralTransferAgreement else if agreementTerms -> agreement -> masterAgreementElections exists then legalAgreementIdentification -> agreementName -> agreementType = LegalAgreementTypeEnum -> MasterAgreement"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "is_a": "LegalAgreementBase",
      "slots": [
        "legalAgreementBase__agreementDate",
        "legalAgreementBase__effectiveDate",
        "legalAgreementBase__identifier",
        "legalAgreementBase__legalAgreementIdentification",
        "legalAgreementBase__contractualParty",
        "legalAgreementBase__otherParty",
        "legalAgreementBase__attachment",
        "legalAgreement__agreementTerms",
        "legalAgreement__relatedAgreements",
        "legalAgreement__umbrellaAgreement"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "agreementTerms",
          "description": "Specification of the content of the legal agreement.",
          "range": "AgreementTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "relatedAgreements",
          "description": "Specifies the agreement(s) that govern the agreement, either as a reference to such agreements when specified as part of the CDM, or through identification of some of the key terms of those agreements, such as the type of agreement, the publisher, the vintage, the agreement identifier and the agreement date.",
          "range": "LegalAgreement",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "umbrellaAgreement",
          "description": "Specifies a set of legal entities which are part of a legal agreement beyond the two contracting parties to that agreement.",
          "range": "UmbrellaAgreement",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LegalAgreement",
      "all_of": [
        {
          "description": "AgreementType: Either the Agreement Terms (i.e. a bilateral or one way agreement) or an Umbrella Agreement (i.e. an agreement where multiple parties and variations of terms are described within a single document but represent multiple agreements for operational purposes) should be included, but not both.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "agreementTerms",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "umbrellaAgreement",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "LegalAgreementBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LegalAgreementBase",
      "description": "Specifies the legal agreement baseline information, being negotiated or having been executed. It excludes specialized elections",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "legalAgreementBase__agreementDate",
        "legalAgreementBase__effectiveDate",
        "legalAgreementBase__identifier",
        "legalAgreementBase__legalAgreementIdentification",
        "legalAgreementBase__contractualParty",
        "legalAgreementBase__otherParty",
        "legalAgreementBase__attachment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "agreementDate",
          "description": "The date on which the legal agreement has been agreed between the parties. This corresponds to the Date of Deed in an English Law document.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "The date on which, or as of which, the agreement is effective, if different from the agreement date. It is expected that it will most often correspond to the agreement date, although there could be situations where the parties will explicitly agree on a distinct effective date.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "identifier",
          "description": "The legal agreement identifier. Several identifiers can be specified.",
          "range": "Identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "legalAgreementIdentification",
          "description": "The type of legal agreement, identified via a set of composable attributes: agreementName, publisher, governing law and version, e.g. ISDA 2013 Standard Credit Support Annex English Law.",
          "range": "LegalAgreementIdentification",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "contractualParty",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The two contractual parties to the legal agreement, which reference information is positioned as part of the partyInformation attribute.",
          "range": "Party",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "otherParty",
          "description": "The role(s) that other party(ies) may have in relation to the legal agreement, further to the contractual parties.",
          "range": "PartyRole",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "attachment",
          "description": "A human readable document, for example a confirmation.",
          "range": "Resource",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LegalAgreementBase",
      "@type": "ClassDefinition"
    },
    {
      "name": "LegalAgreementIdentification",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LegalAgreementIdentification",
      "description": "Specifies the type of legal agreement, identified via a set of composable attributes: agreementName, publisher, governing law and version, e.g. ISDA 2013 Standard Credit Support Annex English Law.",
      "comments": [
        "Rosetta condition CSAMarginType is not stated in LinkML: if agreementName -> creditSupportAgreementMarginType exists then agreementName -> creditSupportAgreementType exists and vintage >= 2016"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "LegalAgreementIdentification_publisher",
        "legalAgreementIdentification__governingLaw",
        "legalAgreementIdentification__agreementName",
        "legalAgreementIdentification__vintage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "governingLaw",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "AcadiaSoft AM_1_0 namingConvention governingLaw",
              "@type": "Annotation"
            }
          ],
          "description": "The law governing the legal agreement, e.g. English Law, New York Law or Japanese Law.",
          "range": "GoverningLawEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "agreementName",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "AcadiaSoft AM_1_0 namingConvention documentName",
              "@type": "Annotation"
            }
          ],
          "description": "The legal agreement name, e.g. Credit Support Annex for Variation Margin.",
          "range": "AgreementName",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "vintage",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "AcadiaSoft AM_1_0 namingConvention csaVersion",
              "@type": "Annotation"
            }
          ],
          "description": "In the case where successive definitions of the legal agreement have been developed, the vintage identification. This is typically (but not necessarily) done by referencing the year, e.g. 2013 in the case of the ISDA 2013 Standard Credit Support Annex.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LegalAgreementIdentification",
      "@type": "ClassDefinition"
    },
    {
      "name": "NonLegalEntity",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/NonLegalEntity",
      "description": "Specifies a non-legal entity that exists in the agreement with a defined relationship to a Legal entity to the agreement",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "nonLegalEntity__identifier",
        "nonLegalEntity__identifierType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "Specifies the unique identifier value for a non-legal entity such as a sleeve, or sub account, that is a party to the agreement and has a relationship with a legal entity defined on the agreement.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "identifierType",
          "description": "Specifies the Identifier type for a non-Legal entity to the agreement, for example the use of an alert code to uniquely identify a non-Legal entity.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/NonLegalEntity",
      "@type": "ClassDefinition"
    },
    {
      "name": "NoticeContactInformation",
