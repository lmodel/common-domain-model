            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "specialPurposeVehicleType",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "SpecialPurposeVehicleSubType",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralTaxonomy",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralTaxonomy",
      "description": "Specifies the collateral taxonomy, which is composed of a taxonomy value and a taxonomy source.",
      "comments": [
        "Rosetta condition Eu_EligibleCollateralTaxonomy is not stated in LinkML: if taxonomySource = TaxonomySourceEnum -> EU_EMIR_EligibleCollateralAssetClass then taxonomyValue -> eu_EMIR_EligibleCollateral exists",
        "Rosetta condition UkEligibleCollateralTaxonomy is not stated in LinkML: if taxonomySource = TaxonomySourceEnum -> UK_EMIR_EligibleCollateralAssetClass then taxonomyValue -> uk_EMIR_EligibleCollateral exists",
        "Rosetta condition UsEligibleCollateralTaxonomy is not stated in LinkML: if taxonomySource = TaxonomySourceEnum -> US_CFTC_PR_EligibleCollateralAssetClass then taxonomyValue -> us_CFTC_PR_EligibleCollateral exists",
        "Rosetta condition TaxonomyValue is not stated in LinkML: if taxonomyValue -> nonEnumeratedTaxonomyValue exists then taxonomySource <> TaxonomySourceEnum -> EU_EMIR_EligibleCollateralAssetClass and taxonomySource <> TaxonomySourceEnum -> UK_EMIR_EligibleCollateralAssetClass and taxonomySource <> TaxonomySourceEnum -> US_CFTC_PR_EligibleCollateralAssetClass"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "collateralTaxonomy__taxonomyValue",
        "collateralTaxonomy__taxonomySource"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "taxonomyValue",
          "description": "Specifies the taxonomy value.",
          "range": "CollateralTaxonomyValue",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "taxonomySource",
          "description": "Specifies the taxonomy source.",
          "range": "TaxonomySourceEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralTaxonomy",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralTaxonomyValue",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralTaxonomyValue",
      "description": "Specifies the collateral taxonomy value, either as a specified enumeration or as a string.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "collateralTaxonomyValue__eu_EMIR_EligibleCollateral",
        "collateralTaxonomyValue__uk_EMIR_EligibleCollateral",
        "collateralTaxonomyValue__us_CFTC_PR_EligibleCollateral",
        "collateralTaxonomyValue__nonEnumeratedTaxonomyValue"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "eu_EMIR_EligibleCollateral",
          "description": "Identifies European Union Eligible Collateral Assets classification categories based on EMIR Uncleared Margin Rules. Eligible Collateral asset classes for both initial margin (IM) and variation margin (VM) posted and collected between specified entities. Please note: EMIR regulation will detail which eligible collateral assets classes apply to each type of entity pairing (counterparty) and which apply to posting of IM and VM",
          "range": "EU_EMIR_EligibleCollateralEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "uk_EMIR_EligibleCollateral",
          "description": "Identifies United Kingdom Eligible Collateral Assets classification categories based on UK Onshored EMIR Uncleared Margin Rules Eligible Collateral asset classes for both initial margin (IM) and variation margin (VM) posted and collected between specified entities. Please note: UK EMIR regulation will detail which eligible collateral assets classes apply to each type of entity pairing (counterparty) and which apply to posting of IM and VM.",
          "range": "UK_EMIR_EligibleCollateralEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "us_CFTC_PR_EligibleCollateral",
          "description": "Identifies US Eligible Collateral Assets classification categories based on Uncleared Margin Rules published by the CFTC and the US Prudential Regulator. Note: While the same basic categories exist in the CFTC and US Prudential Regulators\u2019 margin rules, the precise definitions or application of those rules could differ between the two rules.",
          "range": "US_CFTC_PR_EligibleCollateralEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "nonEnumeratedTaxonomyValue",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Identifies the taxonomy value when not specified as an enumeration.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralTaxonomyValue",
      "all_of": [
        {
          "description": "Unnamed condition (one-of)",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "eu_EMIR_EligibleCollateral",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "uk_EMIR_EligibleCollateral",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "us_CFTC_PR_EligibleCollateral",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "nonEnumeratedTaxonomyValue",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Commodity",
