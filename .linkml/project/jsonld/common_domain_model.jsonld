        },
        {
          "name": "notionalAmountReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A reference to the notional amount.",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PercentageRule",
      "@type": "ClassDefinition"
    },
    {
      "name": "PhysicalSettlementPeriod",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PhysicalSettlementPeriod",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "physicalSettlementPeriod__businessDaysNotSpecified",
        "physicalSettlementPeriod__businessDays",
        "physicalSettlementPeriod__maximumBusinessDays"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "businessDaysNotSpecified",
          "description": "An explicit indication that a number of business days are not specified and therefore ISDA fallback provisions should apply.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "businessDays",
          "description": "A number of business days. Its precise meaning is dependant on the context in which this element is used. ISDA 2003 Term: Business Day.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "maximumBusinessDays",
          "description": "A maximum number of business days. Its precise meaning is dependant on the context in which this element is used. Intended to be used to limit a particular ISDA fallback provision.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PhysicalSettlementPeriod",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "businessDays",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "businessDays",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "BusinessDays: FpML specifies businessDays as a NonNegativeInteger.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "maximumBusinessDays",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "maximumBusinessDays",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "MaximumBusinessDays: FpML specifies maximumBusinessDays as a NonNegativeInteger.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "Unnamed condition (one-of)",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "businessDaysNotSpecified",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "businessDays",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "maximumBusinessDays",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PhysicalSettlementTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PhysicalSettlementTerms",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Specifies Physical Settlement Terms characteristics for the settlement of a Credit Default Swap or Option.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "physicalSettlementTerms__clearedPhysicalSettlement",
        "physicalSettlementTerms__predeterminedClearingOrganizationParty",
        "physicalSettlementTerms__physicalSettlementPeriod",
        "physicalSettlementTerms__deliverableObligations",
        "physicalSettlementTerms__escrow",
        "physicalSettlementTerms__sixtyBusinessDaySettlementCap"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "clearedPhysicalSettlement",
          "description": "Specifies whether the swap resulting from physical settlement of the swaption transaction will clear through a clearing house. The meaning of Cleared Physical Settlement is defined in the 2006 ISDA Definitions, Section 15.2 (published in Supplement number 28).",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "predeterminedClearingOrganizationParty",
          "description": "Specifies the clearing organization (CCP, DCO) to which the trade should be cleared.",
          "range": "AncillaryRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "physicalSettlementPeriod",
          "description": "The number of business days used in the determination of the physical settlement date. The physical settlement date is this number of business days after all applicable conditions to settlement are satisfied. If a number of business days is not specified fallback provisions apply for determining the number of business days. If Section 8.5/8.6 of the 1999/2003 ISDA Definitions are to apply the businessDaysNotSpecified element should be included. If a specified number of business days are to apply these should be specified in the businessDays element. If Section 8.5/8.6 of the 1999/2003 ISDA Definitions are to apply but capped at a maximum number of business days then the maximum number should be specified in the maximumBusinessDays element. ISDA 2003 Term: Physical Settlement Period.",
          "range": "PhysicalSettlementPeriod",
          "@type": "SlotDefinition"
        },
        {
          "name": "deliverableObligations",
          "description": "This element contains all the ISDA terms relevant to defining the deliverable obligations.",
          "range": "DeliverableObligations",
          "@type": "SlotDefinition"
        },
        {
          "name": "escrow",
          "description": "If this element is specified and set to 'true', indicates that physical settlement must take place through the use of an escrow agent. (For Canadian counterparties this is always 'Not Applicable'. ISDA 2003 Term: Escrow.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "sixtyBusinessDaySettlementCap",
          "description": "If this element is specified and set to 'true', for a transaction documented under the 2003 ISDA Credit Derivatives Definitions, has the effect of incorporating the language set forth below into the confirmation. The section references are to the 2003 ISDA Credit Derivatives Definitions. Notwithstanding Section 1.7 or any provisions of Sections 9.9 or 9.10 to the contrary, but without prejudice to Section 9.3 and (where applicable) Sections 9.4, 9.5 and 9.6, if the Termination Date has not occurred on or prior to the date that is 60 Business Days following the Physical Settlement Date, such 60th Business Day shall be deemed to be the Termination Date with respect to this Transaction except in relation to any portion of the Transaction (an 'Affected Portion') in respect of which: (1) a valid notice of Buy-in Price has been delivered that is effective fewer than three Business Days prior to such 60th Business Day, in which case the Termination Date for that Affected Portion shall be the third Business Day following the date on which such notice is effective; or (2) Buyer has purchased but not Delivered Deliverable Obligations validly specified by Seller pursuant to Section 9.10(b), in which case the Termination Date for that Affected Portion shall be the tenth Business Day following the date on which Seller validly specified such Deliverable Obligations to Buyer.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PhysicalSettlementTerms",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "predeterminedClearingOrganizationParty",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "predeterminedClearingOrganizationParty",
                "value_presence": "PRESENT",
                "equals_string": "PredeterminedClearingOrganizationParty",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PredeterminedClearingOrganizationParty",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PricingDates",
