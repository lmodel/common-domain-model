        "collateralTransferAgreementElections__finalReturns"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "regime",
          "description": "The Regime Table provision , which determines the regulatory regime(s) applicable to each of the parties to the agreement.",
          "range": "Regime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "oneWayProvisions",
          "description": "The determination of whether the One Way Provisions are applicable (true) or not applicable (false).",
          "range": "OneWayProvisions",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "generalSimmElections",
          "description": "The specification of the ISDA SIMM Method for all Covered Transactions with respect to all Regimes.",
          "range": "GeneralSimmElections",
          "@type": "SlotDefinition"
        },
        {
          "name": "identifiedCrossCurrencySwap",
          "description": "The qualification of whether cross-currency swaps need to be identified in the Confirmation so that the obligations to exchange principal be disregarded for the purpose of determining the Delivery Amount or Return Amount.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "sensitivityMethodologies",
          "description": "The specification of methodologies to compute sensitivities specific to the agreement.",
          "range": "SensitivityMethodologies",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "fxHaircutCurrency",
          "description": "The reference currency for the purpose of specifying the FX Haircut relating to a posting obligation, as being either the Termination Currency or an FX Designated Currency.",
          "range": "FxHaircutCurrency",
          "@type": "SlotDefinition"
        },
        {
          "name": "postingObligations",
          "description": "The security providers posting obligations.",
          "range": "PostingObligations",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "substitutedRegime",
          "description": "The specification of Additional regimes for purposes of determining whether a Regulatory Event has occurred.",
          "range": "SubstitutedRegime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "baseAndEligibleCurrency",
          "description": "The base and eligible currency(ies) for the document as specified by the parties to the agreement.",
          "range": "BaseAndEligibleCurrency",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "creditSupportObligations",
          "description": "The Credit Support Obligations applicable to the agreement.",
          "range": "CreditSupportObligationsCollateralTransferAgreement",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationAndTiming",
          "description": "The set of elections for determining Valuation and Timing terms specific to the agreement.",
          "range": "CalculationAndTimingCollateralTransferAgreement",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "conditionsPrecedent",
          "description": "The set of elections that may overwrite the default Condition Precedent provision, and the set of provisions that are deemed Access Condition.",
          "range": "ConditionsPrecedent",
          "@type": "SlotDefinition"
        },
        {
          "name": "substitution",
          "description": "The conditions under which the Security Provider can substitute posted collateral.",
          "range": "Substitution",
          "@type": "SlotDefinition"
        },
        {
          "name": "disputeResolution",
          "description": "The election terms under which a party disputes (i) the Calculation Agents calculation of a Delivery Amount or a Return Amount, or (ii) the Value of any Transfer of Eligible Credit Support or Posted Credit Support.",
          "range": "DisputeResolution",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "rightsEvents",
          "description": "The bespoke provisions that might be specified by the parties to the agreement to specify the rights of Security Taker and/or Security Provider when an Early Termination or Access Condition event has occurred.",
          "range": "RightsEvents",
          "@type": "SlotDefinition"
        },
        {
          "name": "custodyArrangements",
          "description": "The Custodian and Segregated Account details in respect of each party to the agreement.",
          "range": "CustodyArrangements",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalRepresentations",
          "description": "The specification Additional Representations that may be applicable to the agreement.",
          "range": "AdditionalRepresentations",
          "@type": "SlotDefinition"
        },
        {
          "name": "demandsAndNotices",
          "description": "The optional specification of address where the demands, specifications and notices will be communicated to for each of the parties to the agreement.",
          "range": "DemandsAndNotices",
          "@type": "SlotDefinition"
        },
        {
          "name": "addressesForTransfer",
          "description": "The optional specification of address for transfer as specified by the respective parties to the agreement.",
          "range": "AddressesForTransfer",
          "@type": "SlotDefinition"
        },
        {
          "name": "otherAgreements",
          "description": "The bespoke definition of other agreement terms as specified by the parties to the agreement.",
          "range": "OtherAgreements",
          "@type": "SlotDefinition"
        },
        {
          "name": "terminationCurrencyAmendment",
          "description": "The bespoke provision that might be specified by the parties to the agreement applicable to Termination Currency. Unless specified the definition of Termination Currency has the meaning specified in the Schedule to the ISDA Master Agreement.",
          "range": "TerminationCurrencyAmendment",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "minimumTransferAmountAmendment",
          "description": "The bespoke provision that might be specified by the parties to the agreement applicable to Minimum Transfer Amount. Unless specified the definition of Minimum Transfer Amount in any Other Regulatory CSA has the meaning specified in such Other Regulatory CSA.",
          "range": "MinimumTransferAmountAmendment",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "interpretationTerms",
          "description": "The bespoke provision that might be specified by the parties to the agreement applicable to Interpretations.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "processAgent",
          "description": "The Process Agent that might be appointed by the parties to the agreement.",
          "range": "ProcessAgent",
          "@type": "SlotDefinition"
        },
        {
          "name": "jurisdictionRelatedTerms",
          "description": "The jurisdiction specific terms relevant to the agreement.",
          "range": "JurisdictionRelatedTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalAmendments",
          "description": "Any additional amendments that might be specified by the parties to the agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalBespokeTerms",
          "description": "Any additional terms that might be specified applicable.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "pledgeeRepresentativeRider",
          "description": "The terms of the Rider for the ISDA Euroclear 2019 Collateral Transfer Agreement with respect to the use of a Pledgee Representative attached to this Agreement.",
          "range": "PledgeeRepresentativeRider",
          "@type": "SlotDefinition"
        },
        {
          "name": "masterAgreementDatedAsOfDate",
          "description": "Defines the date agreed by the parties as the date of the Collateral Transfer Agreement.",
          "range": "MasterAgreementDatedAsOfDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "finalReturns",
          "description": "A clause providing that final return collateral is to be provided without consideration of any Minimum Transfer Amount and collateral haircut.",
          "range": "FinalReturns",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralTransferAgreementElections",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralTransferTiming",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralTransferTiming",
      "description": "Specification of transfer / settlement timing for cash and securities collateral assuming that the notice is provided before the Notification Time (and with a 1LBD lag introduced if the notice is delivered after the Notification Time), and that securities allow for a further Local Business Day for transfer / settlement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "collateralTransferTiming__transferSettlementTiming",
        "collateralTransferTiming__collateralTransferTimingDefinition"
      ],
