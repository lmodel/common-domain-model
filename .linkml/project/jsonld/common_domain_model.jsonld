            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "capacityUnit",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "weatherUnit",
