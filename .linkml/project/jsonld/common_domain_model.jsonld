                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "UnscheduledTransfer",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "ContingentTransfer",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "TransferBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TransferBase",
      "description": "Defines the transfer of an Asset (eg cash, securities or commodities) between two parties on a date.",
      "comments": [
        "Rosetta condition QuantityUnitExists is not stated in LinkML: if asset as Cash exists then quantity -> unit -> currency exists else if asset as Commodity exists then quantity -> unit -> capacityUnit exists else if asset as Instrument exists then quantity -> unit -> financialUnit exists"
      ],
