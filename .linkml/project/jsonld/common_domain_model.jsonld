    {
      "name": "CounterpartyPosition",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CounterpartyPosition",
      "description": "A Position describes the accumulated effect of a set of securities or financial transactions.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "is_a": "ContractBase",
      "slots": [
        "contractBase__contractDetails",
        "contractBase__executionDetails",
        "contractBase__collateral",
        "counterpartyPosition__positionIdentifier",
        "counterpartyPosition__openDateTime",
        "counterpartyPosition__tradeReference",
        "counterpartyPosition__party",
        "counterpartyPosition__partyRole",
        "counterpartyPosition__positionBase"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "positionIdentifier",
          "description": "Represents the identifier(s) that uniquely identify a position for an identity issuer. A position can include multiple identifiers, for example an internal position identifer and a UTI (Unique Trade Identifier).",
          "range": "PositionIdentifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "openDateTime",
          "description": "The date and time when the position was opened.",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to all the trades that constitute the position.",
          "range": "TradeState",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "description": "The parties involved in the position, including the Clearing Organization.",
          "range": "Party",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRole",
          "description": "Represents the role each specified party takes in the position.",
          "range": "PartyRole",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "positionBase",
          "description": "Encapsulates the core constituents that characterize a position.",
          "range": "TradableProduct",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CounterpartyPosition",
      "@type": "ClassDefinition"
    },
