      "range": "QuotationRateTypeEnum",
      "@type": "SlotDefinition"
    },
    {
      "name": "valuationMethod__valuationMethod",
      "description": "The ISDA defined methodology for determining the final price of the reference obligation for purposes of cash settlement. (ISDA 2003 Term: Valuation Method). For example, Market, Highest etc.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "slot_uri": "https://w3id.org/lmodel/common-domain-model/valuationMethod",
      "alias": "valuationMethod",
