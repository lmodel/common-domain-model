          "range": "Party",
          "@type": "SlotDefinition"
        },
        {
          "name": "servicingParty",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The reference to the legal entity that services the account, i.e. in the books of which the account is held.",
          "range": "Party",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Account",
      "@type": "ClassDefinition"
    },
    {
      "name": "Address",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Address",
      "description": "A class to specify a post or street address.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party",
      "slots": [
        "address__street",
        "address__city",
        "address__state",
        "address__country",
        "address__postalCode"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "street",
          "description": "The set of street and building number information that identifies a postal address within a city.",
          "range": "string",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "city",
          "description": "The city component of the postal address.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "state",
          "description": "A country subdivision used in postal addresses in some countries. For example, US states, Canadian provinces, Swiss cantons, ...",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "country",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The ISO 3166 standard code for the country within which the postal address is located.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "postalCode",
          "description": "The code, required for computerized mail sorting systems, that is allocated to a physical address by a national postal authority.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Address",
      "@type": "ClassDefinition"
    },
    {
      "name": "AncillaryEntity",
