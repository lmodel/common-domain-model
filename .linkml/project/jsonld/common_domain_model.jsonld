        "DeliverableObligations"
      ],
      "range": "SpecifiedCurrency",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "deliverableObligations__notSovereignLender",
      "description": "An obligation and deliverable obligation characteristic. Any obligation that is not primarily (majority) owed to a Sovereign or Supranational Organisation. ISDA 2003 Term: Not Sovereign Lender.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slot_uri": "https://w3id.org/lmodel/common-domain-model/notSovereignLender",
