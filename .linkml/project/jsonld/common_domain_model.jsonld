  "classes": [
    {
      "name": "AdjustableDate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AdjustableDate",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class for defining a date that shall be subject to adjustment if it would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the date.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "adjustableDate__unadjustedDate",
        "adjustableDate__dateAdjustments",
        "adjustableDate__dateAdjustmentsReference",
        "adjustableDate__adjustedDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "unadjustedDate",
          "description": "A date subject to adjustment. While in FpML this date is required, this cardinality constraint has been relaxed as part of the CDM in order to support the FRA representation, which effective and termination dates are specified in FpML as adjusted dates.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "dateAdjustments",
          "description": "The business day convention and financial business centers used for adjusting the date if it would otherwise fall on a day that is not a business date in the specified business centers.",
          "range": "BusinessDayAdjustments",
          "@type": "SlotDefinition"
        },
        {
          "name": "dateAdjustmentsReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A pointer style reference to date adjustments defined elsewhere in the document.",
          "range": "BusinessDayAdjustments",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedDate",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "id",
              "@type": "Annotation"
            }
          ],
          "description": "The date once the adjustment has been performed. (Note that this date may change if the business center holidays change).",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AdjustableDate",
      "all_of": [
        {
          "description": "AdjustableDateChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "dateAdjustments",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "dateAdjustmentsReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "dateAdjustments",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "dateAdjustmentsReference",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
