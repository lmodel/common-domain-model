    {
      "name": "ReferenceInformation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ReferenceInformation",
      "description": "A class specifying the Credit Default Swap Reference Information.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "referenceInformation__referenceEntity",
        "referenceInformation__referenceObligation",
        "referenceInformation__noReferenceObligation",
        "referenceInformation__unknownReferenceObligation",
        "referenceInformation__allGuarantees",
        "referenceInformation__referencePrice",
        "referenceInformation__referencePolicy",
        "referenceInformation__securedList"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "referenceEntity",
          "description": "The corporate or sovereign entity which is subject to the swap transaction and any successor that assumes all or substantially all of its contractual and other obligations. Reference Entities cannot be senior or subordinated. It is the obligations of the Reference Entities that can be senior or subordinated. ISDA 2014 Credit definitions article II section 2.1: `Reference Entity` means the entity specified as such in the related Confirmation.",
          "range": "LegalEntity",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "referenceObligation",
          "description": "The Reference Obligation is a financial instrument that is either issued or guaranteed by the reference entity. It serves to clarify the precise reference entity protection is being offered upon, and its legal position with regard to other related firms (parents/subsidiaries). Furthermore the Reference Obligation is ALWAYS deliverable and establishes the Pari Passu ranking (as the deliverable bonds must rank equal to the reference obligation). ISDA 2003 Term: Reference Obligation.",
          "range": "ReferenceObligation",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "noReferenceObligation",
          "description": "Used to indicate that there is no Reference Obligation associated with this Credit Default Swap and that there will never be one.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "unknownReferenceObligation",
          "description": "Used to indicate that the Reference obligation associated with the Credit Default Swap is currently not known. This is not valid for Legal Confirmation purposes, but is valid for earlier stages in the trade life cycle (e.g. Broker Confirmation).",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "allGuarantees",
          "description": "Indicates whether an obligation of the Reference Entity, guaranteed by the Reference Entity on behalf of a non-Affiliate, is to be considered an Obligation for the purpose of the transaction. It will be considered an obligation if allGuarantees is applicable (true) and not if allGuarantees is inapplicable (false). ISDA 2003 Term: All Guarantees.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "referencePrice",
          "description": "Used to determine (a) for physically settled trades, the Physical Settlement Amount, which equals the Floating Rate Payer Calculation Amount times the Reference Price and (b) for cash settled trades, the Cash Settlement Amount, which equals the greater of (i) the difference between the Reference Price and the Final Price and (ii) zero. ISDA 2003 Term: Reference Price.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "referencePolicy",
          "description": "Applicable to the transactions on mortgage-backed security, which can make use of a reference policy. Presence of the element with value set to 'true' indicates that the reference policy is applicable; absence implies that it is not.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "securedList",
          "description": "With respect to any day, the list of Syndicated Secured Obligations of the Designated Priority of the Reference Entity published by Markit Group Limited or any successor thereto appointed by the Specified Dealers (the 'Secured List Publisher') on or most recently before such day, which list is currently available at [http://www.markit.com]. ISDA 2003 Term: Relevant Secured List.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ReferenceInformation",
      "all_of": [
        {
          "description": "ReferenceInformationChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "referenceObligation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "noReferenceObligation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "unknownReferenceObligation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ReferenceObligation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ReferenceObligation",
      "description": "A class to specify the reference obligation that is associated with a credit derivative instrument.",
      "comments": [
        "Rosetta condition MustBeDebtSecurity is not stated in LinkML: if security exists then security -> securityType = Debt"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "referenceObligation__security",
        "referenceObligation__loan",
        "referenceObligation__primaryObligor",
        "referenceObligation__primaryObligorReference",
        "referenceObligation__guarantor",
        "referenceObligation__guarantorReference",
        "referenceObligation__standardReferenceObligation"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "security",
          "description": "Identifies the underlying asset when it is a security, such as a bond or convertible bond. The security data type requires one or more productIdentifiers, specificaiton of the security type (e.g. debt), and includes optional attributes to specify a debt class, such as asset-backed, as well as seniority.",
          "range": "Security",
          "@type": "SlotDefinition"
        },
        {
          "name": "loan",
          "description": "Identifies the underlying asset when it is a loan.",
          "range": "Loan",
          "@type": "SlotDefinition"
        },
        {
          "name": "primaryObligor",
          "description": "The entity primarily responsible for repaying debt to a creditor as a result of borrowing or issuing bonds. ISDA 2003 Term: Primary Obligor.",
          "range": "LegalEntity",
          "@type": "SlotDefinition"
        },
        {
          "name": "primaryObligorReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A pointer style reference to a reference entity defined elsewhere in the document. Used when the reference entity is the primary obligor.",
          "range": "LegalEntity",
          "@type": "SlotDefinition"
        },
        {
          "name": "guarantor",
          "description": "The party that guarantees by way of a contractual arrangement to pay the debts of an obligor if the obligor is unable to make the required payments itself. ISDA 2003 Term: Guarantor.",
          "range": "LegalEntity",
          "@type": "SlotDefinition"
        },
        {
          "name": "guarantorReference",
          "description": "A pointer style reference to a reference entity defined elsewhere in the document. Used when the reference entity is the guarantor.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "standardReferenceObligation",
          "description": "Indicates if the reference obligation is a Standard Reference Obligation. ISDA 2014 Term: Standard Reference Obligation.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ReferenceObligation",
      "all_of": [
        {
          "description": "AssetChoice: Represents the choice in a CDS contract.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "security",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "loan",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "LegalEntityChoice: Represents the choice in a CDS contract..",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "primaryObligor",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "primaryObligorReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "primaryObligor",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "primaryObligorReference",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ReferencePair",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ReferencePair",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "referencePair__referenceEntity",
        "referencePair__referenceObligation",
        "referencePair__noReferenceObligation",
        "referencePair__entityType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "referenceEntity",
          "description": "The corporate or sovereign entity on which you are buying or selling protection and any successor that assumes all or substantially all of its contractual and other obligations. It is vital to use the correct legal name of the entity and to be careful not to choose a subsidiary if you really want to trade protection on a parent company. Please note, Reference Entities cannot be senior or subordinated. It is the obligations of the Reference Entities that can be senior or subordinated. ISDA 2003 Term: Reference Entity.",
          "range": "LegalEntity",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "referenceObligation",
          "description": "The Reference Obligation is a financial instrument that is either issued or guaranteed by the reference entity. It serves to clarify the precise reference entity protection is being offered upon, and its legal position with regard to other related firms (parents/subsidiaries). Furthermore the Reference Obligation is ALWAYS deliverable and establishes the Pari Passu ranking (as the deliverable bonds must rank equal to the reference obligation). ISDA 2003 Term: Reference Obligation.",
          "range": "ReferenceObligation",
          "@type": "SlotDefinition"
        },
        {
          "name": "noReferenceObligation",
          "description": "Used to indicate that there is no Reference Obligation associated with this Credit Default Swap and that there will never be one.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "entityType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Defines the reference entity types corresponding to a list of types in the ISDA First to Default documentation.",
          "range": "EntityTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ReferencePair",
      "all_of": [
        {
          "description": "ReferenceChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "referenceObligation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "noReferenceObligation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ReferencePool",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ReferencePool",
      "description": "This type contains all the reference pool items to define the reference entity and reference obligation(s) in the basket.",
      "comments": [
        "Rosetta condition FpML_cd_44_openUnits is not stated in LinkML: if referencePoolItem -> constituentWeight -> openUnits exists then referencePoolItem -> constituentWeight -> basketPercentage is absent",
        "Rosetta condition FpML_cd_44_basketPercentage is not stated in LinkML: if referencePoolItem -> constituentWeight -> basketPercentage exists then referencePoolItem -> constituentWeight -> openUnits is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "referencePool__referencePoolItem"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "referencePoolItem",
          "description": "This type contains all the constituent weight and reference information.",
          "range": "ReferencePoolItem",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ReferencePool",
      "@type": "ClassDefinition"
    },
    {
      "name": "ReferencePoolItem",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ReferencePoolItem",
      "description": "This type contains all the constituent weight and reference information.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "referencePoolItem__constituentWeight",
        "referencePoolItem__referencePair",
        "referencePoolItem__protectionTermsReference",
        "referencePoolItem__cashSettlementTermsReference",
        "referencePoolItem__physicalSettlementTermsReference"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "constituentWeight",
          "description": "Describes the weight of each of the constituents within the basket. If not provided, it is assumed to be equal weighted.",
          "range": "ConstituentWeight",
          "@type": "SlotDefinition"
        },
        {
          "name": "referencePair",
          "range": "ReferencePair",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "protectionTermsReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to the documentation terms applicable to this item.",
          "range": "ProtectionTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "cashSettlementTermsReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to the cash settlement terms applicable to this item.",
          "range": "CashSettlementTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "physicalSettlementTermsReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to the physical settlement terms applicable to this item.",
          "range": "PhysicalSettlementTerms",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ReferencePoolItem",
      "all_of": [
        {
          "description": "SettlementChoice: A choice rule between a reference to the cash or physical settlement terms.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "cashSettlementTermsReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "physicalSettlementTermsReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "cashSettlementTermsReference",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "physicalSettlementTermsReference",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ReturnTermsBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ReturnTermsBase",
      "description": "Contains all common elements in variance, volatility and correlation return Terms.",
      "comments": [
        "Rosetta condition InitialLevelOrInitialLevelSource is not stated in LinkML: if initialLevel is absent then initialLevelSource exists and if initialLevelSource is absent then initialLevel exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "returnTermsBase__valuationTerms",
        "returnTermsBase__annualizationFactor",
        "returnTermsBase__dividendApplicability",
        "returnTermsBase__equityUnderlierProvisions",
        "returnTermsBase__sharePriceDividendAdjustment",
        "returnTermsBase__expectedN",
        "returnTermsBase__initialLevel",
        "returnTermsBase__initialLevelSource",
        "returnTermsBase__meanAdjustment",
        "returnTermsBase__performance"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "valuationTerms",
          "description": "Contains all non-date valuation information.",
          "range": "ValuationTerms",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "annualizationFactor",
          "description": "This specifies the numerator of an annualization factor. Frequently this number is equal to the number of observations of prices in a year e.g. 252.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendApplicability",
          "description": "The parameters which define whether dividends are applicable",
          "range": "DividendApplicability",
          "@type": "SlotDefinition"
        },
        {
          "name": "equityUnderlierProvisions",
          "description": "Contains Equity Underlyer provisions regarding jurisdiction and fallbacks.",
          "range": "EquityUnderlierProvisions",
          "@type": "SlotDefinition"
        },
        {
          "name": "sharePriceDividendAdjustment",
          "description": "Indicates whether the price of shares is adjusted for dividends or not.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "expectedN",
          "description": "Expected number of trading days.",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "initialLevel",
          "description": "Contract will strike off this initial level. Providing just the initialLevel without initialLevelSource, infers that this is AgreedInitialPrice - a specified Initial Index Level.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "initialLevelSource",
          "description": "In this context, this is AgreedInitialPrice - a specified Initial Index Level.",
          "range": "DeterminationMethodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "meanAdjustment",
          "description": "Specifies whether Mean Adjustment is applicable or not in the calculation of the Realized Volatility, Variance or Correlation",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "performance",
          "description": "Performance calculation, in accordance with Part 1 Section 12 of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap, Para 75. 'Equity Performance'. Cumulative performance is used as a notional multiplier factor on both legs of an Equity Swap.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ReturnTermsBase",
      "all_of": [
        {
          "description": "PositiveExpectedN: The number of expected trading dates must be positive",
          "slot_conditions": [
            {
              "name": "expectedN",
              "minimum_value": 1,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "SettledEntityMatrix",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SettledEntityMatrix",
      "description": "A class to specify the Relevant Settled Entity Matrix.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "settledEntityMatrix__matrixSource",
        "settledEntityMatrix__publicationDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "matrixSource",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Relevant settled entity matrix source.",
          "range": "SettledEntityMatrixSourceEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "publicationDate",
          "description": "Specifies the publication date of the applicable version of the matrix. When this element is omitted, the Standard Terms Supplement defines rules for which version of the matrix is applicable.",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SettledEntityMatrix",
      "@type": "ClassDefinition"
    },
    {
      "name": "SpreadSchedule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SpreadSchedule",
      "description": "Adds an optional spread type element to the Schedule to identify a long or short spread value.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "RateSchedule",
      "slots": [
        "rateSchedule__price",
        "spreadSchedule__spreadScheduleType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "spreadScheduleType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "An element which purpose is to identify a long or short spread value.",
          "range": "SpreadScheduleTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SpreadSchedule",
      "@type": "ClassDefinition"
    },
    {
      "name": "StubFloatingRate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/StubFloatingRate",
      "description": "A class defining a floating rate.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "stubFloatingRate__floatingRateIndex",
        "stubFloatingRate__indexTenor",
        "stubFloatingRate__floatingRateMultiplierSchedule",
        "stubFloatingRate__spreadSchedule",
        "stubFloatingRate__rateTreatment",
        "stubFloatingRate__capRateSchedule",
        "stubFloatingRate__floorRateSchedule"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "floatingRateIndex",
          "description": "The floating rate index.",
          "range": "FloatingRateIndexEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "indexTenor",
          "description": "The ISDA Designated Maturity, i.e. the tenor of the floating rate.",
          "range": "Period",
          "@type": "SlotDefinition"
        },
        {
          "name": "floatingRateMultiplierSchedule",
          "description": "A rate multiplier or multiplier schedule to apply to the floating rate. A multiplier schedule is expressed as explicit multipliers and dates. In the case of a schedule, the step dates may be subject to adjustment in accordance with any adjustments specified in the calculationPeriodDatesAdjustments. The multiplier can be a positive or negative decimal. This element should only be included if the multiplier is not equal to 1 (one) for the term of the stream.",
          "range": "ScheduleWithInitialValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "spreadSchedule",
          "description": "The ISDA Spread or a Spread schedule expressed as explicit spreads and dates. In the case of a schedule, the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The spread is a per annum rate, expressed as a decimal. For purposes of determining a calculation period amount, if positive the spread will be added to the floating rate and if negative the spread will be subtracted from the floating rate. A positive 10 basis point (0.1%) spread would be represented as 0.001.",
          "range": "SpreadSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "rateTreatment",
          "description": "The specification of any rate conversion which needs to be applied to the observed rate before being used in any calculations. The two common conversions are for securities quoted on a bank discount basis which will need to be converted to either a Money Market Yield or Bond Equivalent Yield. See the Annex to the 2000 ISDA Definitions, Section 7.3. Certain General Definitions Relating to Floating Rate Options, paragraphs (g) and (h) for definitions of these terms.",
          "range": "RateTreatmentEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "capRateSchedule",
          "description": "The cap rate or cap rate schedule, if any, which applies to the floating rate. The cap rate (strike) is only required where the floating rate on a swap stream is capped at a certain level. A cap rate schedule is expressed as explicit cap rates and dates and the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The cap rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A cap rate of 5% would be represented as 0.05.",
          "range": "StrikeSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "floorRateSchedule",
          "description": "The floor rate or floor rate schedule, if any, which applies to the floating rate. The floor rate (strike) is only required where the floating rate on a swap stream is floored at a certain strike level. A floor rate schedule is expressed as explicit floor rates and dates and the step dates may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments. The floor rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. A floor rate of 5% would be represented as 0.05.",
          "range": "StrikeSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/StubFloatingRate",
      "@type": "ClassDefinition"
    },
    {
      "name": "StubValue",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/StubValue",
      "description": "A type defining how a stub calculation period amount is calculated. A single floating rate tenor different to that used for the regular part of the calculation periods schedule may be specified, or two floating rate tenors many be specified. If two floating rate tenors are specified then Linear Interpolation (in accordance with the 2000 ISDA Definitions, Section 8.3 Interpolation) is assumed to apply. Alternatively, an actual known stub rate or stub amount may be specified.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "stubValue__floatingRate",
        "stubValue__stubRate",
        "stubValue__stubAmount"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "floatingRate",
          "description": "The rates to be applied to the initial or final stub may be the linear interpolation of two different rates. While the majority of the time, the rate indices will be the same as that specified in the stream and only the tenor itself will be different, it is possible to specift two different rates. For example, a 2 month stub period may use the linear interpolation of a 1 month and 3 month rate. The different rates would be specified in this component. Note that a maximum of two rates can be specified. If a stub period uses the same floating rate index, including tenor, as the regular calculation periods then this should not be specified again within this component, i.e. the stub calculation period amount component may not need to be specified even if there is an initial or final stub period. If a stub period uses a different floating rate index compared to the regular calculation periods then this should be specified within this component. If specified here, they are likely to have id attributes, allowing them to be referenced from within the cashflows component.",
          "range": "StubFloatingRate",
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "stubRate",
          "description": "An actual rate to apply for the initial or final stub period may have been agreed between the principal parties (in a similar way to how an initial rate may have been agreed for the first regular period). If an actual stub rate has been agreed then it would be included in this component. It will be a per annum rate, expressed as a decimal. A stub rate of 5% would be represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "stubAmount",
          "description": "An actual amount to apply for the initial or final stub period may have been agreed between the two parties. If an actual stub amount has been agreed then it would be included in this component.",
          "range": "Money",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/StubValue",
      "all_of": [
        {
          "description": "Unnamed condition (one-of)",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "floatingRate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "stubRate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "stubAmount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Tranche",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Tranche",
      "description": "The class to represent a CDS Tranche.",
      "comments": [
        "Rosetta condition AttachmentPointLessThanExhaustionPoint is not stated in LinkML: attachmentPoint <= exhaustionPoint"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "tranche__attachmentPoint",
        "tranche__exhaustionPoint",
        "tranche__incurredRecoveryApplicable"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "attachmentPoint",
          "description": "Lower bound percentage of the loss that the Tranche can endure, expressed as a decimal. An attachment point of 5% would be represented as 0.05. The difference between Attachment and Exhaustion points is called the width of the Tranche.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "exhaustionPoint",
          "description": "Upper bound percentage of the loss that the Tranche can endure, expressed as a decimal. An exhaustion point of 5% would be represented as 0.05. The difference between Attachment and Exhaustion points is call the width of the Tranche.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "incurredRecoveryApplicable",
          "description": "Outstanding Swap Notional Amount is defined at any time on any day, as the greater of: (a) Zero; If Incurred Recovery Amount Applicable: (b) The Original Swap Notional Amount minus the sum of all Incurred Loss Amounts and all Incurred Recovery Amounts (if any) determined under this Confirmation at or prior to such time.Incurred Recovery Amount not populated: (b) The Original Swap Notional Amount minus the sum of all Incurred Loss Amounts determined under this Confirmation at or prior to such time.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Tranche",
      "all_of": [
        {
          "description": "AttachmentPoint: FpML definition associated with the attachmentPoint element specifies that a schema facet to constraint the value between 0 to 1 will be introduced in FpML 4.3.",
          "slot_conditions": [
            {
              "name": "attachmentPoint",
              "minimum_value": 0,
              "maximum_value": 1,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "ExhaustionPoint: FpML definition associated with the exhaustionPoint element specifies that a schema facet to constraint the value between 0 to 1 will be introduced in FpML 4.3.",
          "slot_conditions": [
            {
              "name": "exhaustionPoint",
              "minimum_value": 0,
              "maximum_value": 1,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ValuationTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ValuationTerms",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "valuationTerms__futuresPriceValuation",
        "valuationTerms__optionsPriceValuation",
        "valuationTerms__numberOfValuationDates",
        "valuationTerms__dividendValuationDates",
        "valuationTerms__fPVFinalPriceElectionFallback",
        "valuationTerms__multipleExchangeIndexAnnexFallback",
        "valuationTerms__componentSecurityIndexAnnexFallback"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "futuresPriceValuation",
          "description": "The official settlement price as announced by the related exchange is applicable, in accordance with the ISDA 2002 definitions.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "optionsPriceValuation",
          "description": "The official settlement price as announced by the related exchange is applicable, in accordance with the ISDA 2002 definitions",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "numberOfValuationDates",
          "description": "The number of valuation dates between valuation start date and valuation end date.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendValuationDates",
          "description": "Specifies the dividend valuation dates of the swap.",
          "range": "AdjustableRelativeOrPeriodicDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "fPVFinalPriceElectionFallback",
          "description": "Specifies the fallback provisions for Hedging Party in the determination of the Final Price.",
          "range": "FPVFinalPriceElectionFallbackEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "multipleExchangeIndexAnnexFallback",
          "description": "For an index option transaction, a flag to indicate whether a relevant Multiple Exchange Index Annex is applicable to the transaction. This annex defines additional provisions which are applicable where an index is comprised of component securities that are traded on multiple exchanges.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "componentSecurityIndexAnnexFallback",
          "description": "For an index option transaction, a flag to indicate whether a relevant Component Security Index Annex is applicable to the transaction.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ValuationTerms",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "numberOfValuationDates",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "numberOfValuationDates",
                "minimum_value": 1,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PositiveNumberOfValuationDates: The number of valuation dates must be positive.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "VarianceCapFloor",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/VarianceCapFloor",
      "comments": [
        "Rosetta condition PositiveUnadjustedVarianceCap is not stated in LinkML: if unadjustedVarianceCap exists then unadjustedVarianceCap > 0",
        "Rosetta condition CapFloorApplicability is not stated in LinkML: if varianceCap = True then unadjustedVarianceCap exists or boundedVariance exists else unadjustedVarianceCap is absent and boundedVariance is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "varianceCapFloor__varianceCap",
        "varianceCapFloor__unadjustedVarianceCap",
        "varianceCapFloor__boundedVariance"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "varianceCap",
          "description": "If present and true, then variance cap is applicable.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "unadjustedVarianceCap",
          "description": "For use when varianceCap is applicable. Contains the scaling factor of the Variance Cap that can differ on a trade-by-trade basis in the European market. For example, a Variance Cap of 2.5^2 x Variance Strike Price has an unadjustedVarianceCap of 2.5.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "boundedVariance",
          "description": "Conditions which bound variance. The contract specifies one or more boundary levels. These levels are expressed as prices for confirmation purposes Underlyer price must be equal to or higher than Lower Barrier is known as Up Conditional Swap Underlyer price must be equal to or lower than Upper Barrier is known as Down Conditional Swap Underlyer price must be equal to or higher than Lower Barrier and must be equal to or lower than Upper Barrier is known as Barrier Conditional Swap.",
          "range": "BoundedVariance",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/VarianceCapFloor",
      "@type": "ClassDefinition"
    },
    {
      "name": "VarianceReturnTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/VarianceReturnTerms",
      "comments": [
        "Rosetta condition Positive_VegaNotionalAmount is not stated in LinkML: if vegaNotionalAmount -> value exists then vegaNotionalAmount -> value > 0",
        "Rosetta condition UnderlierMustBeListedDerivative is not stated in LinkML: if exchangeTradedContractNearest exists then exchangeTradedContractNearest as ListedDerivative exists",
        "Rosetta condition ReferenceContract is not stated in LinkML: if valuationTerms -> futuresPriceValuation = True then exchangeTradedContractNearest exists",
        "Rosetta condition NonNegativeStrikePrice is not stated in LinkML: if volatilityStrikePrice -> value exists then volatilityStrikePrice -> value >= 0 and if varianceStrikePrice -> value exists then varianceStrikePrice -> value >= 0"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "is_a": "ReturnTermsBase",
      "slots": [
        "returnTermsBase__valuationTerms",
        "returnTermsBase__annualizationFactor",
        "returnTermsBase__dividendApplicability",
        "returnTermsBase__equityUnderlierProvisions",
        "returnTermsBase__sharePriceDividendAdjustment",
        "returnTermsBase__expectedN",
        "returnTermsBase__initialLevel",
        "returnTermsBase__initialLevelSource",
        "returnTermsBase__meanAdjustment",
        "returnTermsBase__performance",
        "varianceReturnTerms__varianceStrikePrice",
        "varianceReturnTerms__volatilityStrikePrice",
        "varianceReturnTerms__varianceCapFloor",
        "varianceReturnTerms__volatilityCapFloor",
        "varianceReturnTerms__vegaNotionalAmount",
        "varianceReturnTerms__exchangeTradedContractNearest"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "varianceStrikePrice",
          "description": "Variance Strike Price in accordance with the ISDA 2011 Equity Derivatives Definitions.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "volatilityStrikePrice",
          "description": "Volatility Strike Price in accordance with the ISDA 2011 Equity Derivatives Definitions.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "varianceCapFloor",
          "description": "Contains possible barriers for variance products, both variance-based and underlier price based",
          "range": "VarianceCapFloor",
          "@type": "SlotDefinition"
        },
        {
          "name": "volatilityCapFloor",
          "description": "Contains containing volatility-based barriers",
          "range": "VolatilityCapFloor",
          "@type": "SlotDefinition"
        },
        {
          "name": "vegaNotionalAmount",
          "description": "Vega Notional represents the approximate gain/loss at maturity for a 1% difference between RVol (realised vol) and KVol (strike vol). It does not necessarily represent the Vega Risk of the trade.",
          "range": "NonNegativeQuantitySchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "exchangeTradedContractNearest",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->observable",
              "@type": "Annotation"
            }
          ],
          "description": "Specification of the exchange traded contract nearest.",
          "range": "Observable",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/VarianceReturnTerms",
      "all_of": [
        {
          "description": "From ReturnTermsBase. PositiveExpectedN: The number of expected trading dates must be positive",
          "slot_conditions": [
            {
              "name": "expectedN",
              "minimum_value": 1,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "StrikePriceMustExist: The strike price must be present, but it can be expressed in either variance or volatility terms",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "volatilityStrikePrice",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "varianceStrikePrice",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "VolatilityCapFloor",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/VolatilityCapFloor",
      "description": "Contains volatility-based barriers. Volatility Cap needs to be specified in accordance with the ISDA 2011 Equity Derivatives Definitions.",
      "comments": [
        "Rosetta condition CapFloorApplicability is not stated in LinkML: if applicable = True then totalVolatilityCap exists or volatilityCapFactor exists else totalVolatilityCap is absent and volatilityCapFactor is absent",
        "Rosetta condition PositiveCaps is not stated in LinkML: if totalVolatilityCap exists then totalVolatilityCap >= 0 and if volatilityCapFactor exists then volatilityCapFactor >= 0"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slots": [
        "volatilityCapFloor__applicable",
        "volatilityCapFloor__totalVolatilityCap",
        "volatilityCapFloor__volatilityCapFactor"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicable",
          "description": "Indicates whether the volatility cap is applicable in accordance with the ISDA 2011 Equity Derivatives Definitions. Setting the element 'applicable' to 'False' - means No Volatility Cap and no 'totalVolatilityCap' or 'volatilityCapFactor' should be provided. Setting the element 'applicable' to 'True' - means Volatility Cap election, then 'totalVolatilityCap' or 'volatilityCapFactor' should be provided, otherwise it defaults to volatilityCapFactor=2.5.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "totalVolatilityCap",
          "description": "Volatility Cap Amount in accordance with the ISDA 2011 Equity Derivatives Definitions. This means the Volatility Cap Amount election is a number.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "volatilityCapFactor",
          "description": "Volatility Cap Amount in accordance with the ISDA 2011 Equity Derivatives Definitions. The Calculated VolCapAmt can be optionally provided.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/VolatilityCapFloor",
      "@type": "ClassDefinition"
    },
    {
      "name": "VolatilityReturnTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/VolatilityReturnTerms",
