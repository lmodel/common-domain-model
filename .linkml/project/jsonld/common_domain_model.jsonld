    {
      "name": "HoldingPostedCollateralEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/HoldingPostedCollateralEnum",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_VM_2016 paragraph 13 General Principles clause (h)(i) name Eligibility to Hold Posted Collateral (VM); Custodians (VM) | ISDA FpML_Coding_Scheme schemeLocation http://www.fpml.org/coding-scheme/holding-posted-collateral"
        }
      ],
      "description": "The enumerated values to specify condition(s) required by a party from the other party to hold its posted collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "see_also": [
        "http://www.fpml.org/coding-scheme/holding-posted-collateral"
      ],
      "permissible_values": [
        {
          "text": "AcceptableCustodian",
          "description": "The custodian is acceptable to the other party to the agreement."
        }
      ]
    },
    {
      "name": "IndependentAmountCompareEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/IndependentAmountCompareEnum",
      "annotations": [
        {
          "tag": "rosetta_extends",
          "value": "CreditNotationMismatchResolutionEnum"
        }
      ],
      "description": "Specifies how multiple credit ratings are compared when determining the applicable Independent Amount, and whether that measure is highest, lowest, or a comparison of the ratings.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "permissible_values": [
        {
          "text": "Lowest",
          "description": "Denotes the lowest credit notation if several notations are listed."
        },
        {
          "text": "Highest",
          "description": "Denotes the highest credit notation if several notations are listed."
        },
        {
          "text": "ReferenceAgency",
          "description": "Denotes that a credit notation issued from a defined reference agency is used if several notations are listed."
        },
        {
          "text": "Average",
          "description": "Denotes the average credit notation if several notations are listed."
        },
        {
          "text": "SecondBest",
          "description": "Denotes the second best credit notation if several notations are listed."
        },
        {
          "text": "Other",
          "description": "Utilised where bespoke language represents the label characteristics of the rating."
        },
        {
          "text": "Compare",
          "description": "Represents that the credit ratings across multiple credit rating agencies will be compared against one another."
        }
      ]
    },
    {
      "name": "IndependentAmountEligibilityEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/IndependentAmountEligibilityEnum",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA FpML_Coding_Scheme schemeLocation http://www.fpml.org/coding-scheme/independent-amount-eligibility"
        }
      ],
      "description": "The enumerated values to specify the instances where the independent amount eligible collateral is not defined as a set of eligible collateral assets.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "see_also": [
        "http://www.fpml.org/coding-scheme/independent-amount-eligibility"
      ],
      "permissible_values": [
        {
          "text": "None",
          "description": "None."
        },
        {
          "text": "NoneUnlessSpecifiedInConfirmation",
          "description": "None, unless otherwise specified in a Confirmation."
        }
      ]
    },
    {
      "name": "InterestAdjustmentPeriodicityEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/InterestAdjustmentPeriodicityEnum",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_IM_Japanese_2016 paragraph 13 General Principles clause (n)(ii)"
        }
      ],
      "description": "Values to specify the interest adjustment periodicity election through standard language.",
