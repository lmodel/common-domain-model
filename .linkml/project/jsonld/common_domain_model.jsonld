          "range": "BusinessDayConventionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCenters",
          "description": "The business center(s), specified either explicitly or by reference to those specified somewhere else in the instance document.",
          "range": "BusinessCenters",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/BusinessDateRange",
      "@type": "ClassDefinition"
    },
