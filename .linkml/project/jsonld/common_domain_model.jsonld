      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LegacyResolutionAlternative",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "resolutionAlternative",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "additionalLanguage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "AdditionalLanguage: If no resolution alternative procedure is defined, additional language must be specified.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "resolutionAlternative",
                "value_presence": "PRESENT",
                "equals_string": "SplitDifference",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "amount",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "SplitDifferenceAmount: If the resolution is to split the difference, then the amount concerned should be specified.",
