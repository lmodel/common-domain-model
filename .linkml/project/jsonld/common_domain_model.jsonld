      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "TradableProduct",
      "slots": [
        "tradableProduct__product",
        "tradableProduct__tradeLot",
        "tradableProduct__counterparty",
        "tradableProduct__ancillaryParty",
        "tradableProduct__adjustment",
        "trade__tradeIdentifier",
        "trade__tradeDate",
        "trade__tradeTime",
        "trade__party",
        "trade__partyRole",
        "trade__executionDetails",
        "trade__contractDetails",
        "trade__collateral"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "tradeIdentifier",
          "description": "Represents the identifier(s) that uniquely identify a trade for an identity issuer. A trade can include multiple identifiers, for example a trade that is reportable to both the CFTC and ESMA, and then has an associated USI (Unique Swap Identifier) UTI (Unique Trade Identifier).",
          "range": "TradeIdentifier",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeDate",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "id",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the date which the trade was agreed.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeTime",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "id",
              "@type": "Annotation"
            }
          ],
          "description": "Denotes the trade time and timezone as agreed by the parties to the trade.",
          "range": "TimeZone",
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "description": "Represents the parties to the trade. The cardinality is optional to address the case where the trade is defined within a BusinessEvent data type, in which case the party is specified in BusinessEvent.",
          "range": "Party",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRole",
          "description": "Represents the role each specified party takes in the trade. further to the principal roles, payer and receiver.",
          "range": "PartyRole",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "executionDetails",
          "description": "Represents information specific to trades that arose from executions.",
          "range": "ExecutionDetails",
          "@type": "SlotDefinition"
        },
        {
          "name": "contractDetails",
          "description": "Represents information specific to trades involving contractual products.",
          "range": "ContractDetails",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateral",
          "description": "Represents the collateral obligations of a party.",
          "range": "Collateral",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Trade",
      "@type": "ClassDefinition"
    },
    {
      "name": "TradeIdentifier",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TradeIdentifier",
      "description": "Defines a trade identifier as a special case of the generic identifier type, that also includes the trade identifier class.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "Identifier",
      "slots": [
        "identifier__issuerReference",
        "identifier__issuer",
        "identifier__assignedIdentifier",
        "tradeIdentifier__identifierType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifierType",
          "description": "The enumerated classification of the identifier. Optional as a trade identifier may be party-specific, in which case it may not correspond to any established classification.",
          "range": "TradeIdentifierTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TradeIdentifier",
      "all_of": [
        {
          "description": "From Identifier. IssuerChoice: The identifier issuer is specified either explicitly or by reference to one of the parties.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "issuerReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "issuer",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "TradePricingReport",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TradePricingReport",
      "description": "The attributes that are specific for consensus based pricing reporting.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "tradePricingReport__trade",
        "tradePricingReport__pricingTime",
        "tradePricingReport__discountingIndex"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "trade",
          "description": "Represents the cosensus based pricing parameters on a trade basis.",
          "range": "Trade",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "pricingTime",
          "description": "The regional exchange close time for the underlying contract,including time zone, at which the trades should be priced. This provides an indication for which regional snapshot should be used for pricing primarily for Global markets where there are multiple regional close times.",
          "range": "TimeZone",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "discountingIndex",
          "description": "It specifies the interest payable on collateral delivered under a CSA covering the trade.",
          "range": "FloatingRateIndexEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TradePricingReport",
      "@type": "ClassDefinition"
    },
    {
      "name": "TradeState",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TradeState",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Defines the fundamental financial information that can be changed by a Primitive Event and by extension any business or life-cycle event. Each TradeState specifies where a Trade is in its life-cycle. TradeState is a root type and as such, can be created independently to any other CDM data type, but can also be used as part of the CDM Event Model.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "tradeState__trade",
        "tradeState__state",
        "tradeState__resetHistory",
        "tradeState__transferHistory",
        "tradeState__observationHistory",
        "tradeState__valuationHistory"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "trade",
          "description": "Represents the Trade that has been effected by a business or life-cycle event.",
          "range": "Trade",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "state",
          "description": "Represents the State of the Trade through its life-cycle.",
          "range": "State",
          "@type": "SlotDefinition"
        },
        {
          "name": "resetHistory",
          "description": "Represents the updated Trade attributes which can change as the result of a reset event. Only the changed values are captured, leaving the remaining data attributes empty. See Create_Reset function for further details on how TradeState is used in the Reset event. The TradeState data type is used to maintain backwards compatibility with the current Reset mechanism.",
          "range": "Reset",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "transferHistory",
          "description": "Represents the updated Trade attributes which can change as the result of a transfer event.",
          "range": "TransferState",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "observationHistory",
          "description": "Represents the observed events related to a particular product or process, such as credit events or corporate actions.",
          "range": "ObservationEvent",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationHistory",
          "range": "Valuation",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TradeState",
      "@type": "ClassDefinition"
    },
    {
      "name": "Transfer",
