    {
      "name": "FixedPrice",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FixedPrice",
      "description": "A predefined price accorded by the counterparties.",
      "comments": [
        "Rosetta condition NonNegativePrice_amount is not stated in LinkML: if price -> value exists then price -> value >= 0.0",
        "Rosetta condition NonNegativePrice_datedValue is not stated in LinkML: if price -> datedValue exists then price -> datedValue -> value all >= 0.0"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "fixedPrice__price"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "price",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->price",
              "@type": "Annotation"
            }
          ],
          "description": "Fixed price step schedule, including an initial price specified as an absolute number.",
          "range": "PriceSchedule",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FixedPrice",
      "@type": "ClassDefinition"
    },
    {
      "name": "FxFixingDate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FxFixingDate",
      "description": "Extends the Offset structure to specify an FX fixing date as an offset to dates specified somewhere else in the document.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "is_a": "Offset",
      "slots": [
        "period__periodMultiplier",
        "period__period",
        "offset__dayType",
        "fxFixingDate__businessDayConvention",
        "fxFixingDate__businessCenters",
        "fxFixingDate__businessCentersReference",
        "fxFixingDate__dateRelativeToPaymentDates",
        "fxFixingDate__dateRelativeToCalculationPeriodDates",
        "fxFixingDate__dateRelativeToValuationDates",
        "fxFixingDate__fxFixingDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "businessDayConvention",
          "description": "The convention for adjusting a date if it would otherwise fall on a day that is not a business day, as specified by an ISDA convention (e.g. Following, Precedent).",
          "range": "BusinessDayConventionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCenters",
          "range": "BusinessCenters",
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCentersReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A reference to a set of financial business centers defined elsewhere in the document. This set of business centers is used to determine whether a particular day is a business day or not.",
          "range": "BusinessCenters",
          "@type": "SlotDefinition"
        },
        {
          "name": "dateRelativeToPaymentDates",
          "description": "The payment date references on which settlements in non-deliverable currency are due and will then have to be converted according to the terms specified through the other parts of the nonDeliverableSettlement structure.",
          "range": "DateRelativeToPaymentDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "dateRelativeToCalculationPeriodDates",
          "description": "The calculation period references on which settlements in non-deliverable currency are due and will then have to be converted according to the terms specified through the other parts of the nonDeliverableSettlement structure. Implemented for Brazilian-CDI swaps where it will refer to the termination date of the appropriate leg.",
          "range": "DateRelativeToCalculationPeriodDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "dateRelativeToValuationDates",
          "description": "The calculation period references on which settlements in non-deliverable currency are due and will then have to be converted according to the terms specified through the other parts of the nonDeliverableSettlement structure. Implemented for Brazilian-CDI swaps where it will refer to the termination date of the appropriate leg.",
          "range": "DateRelativeToValuationDates",
          "@type": "SlotDefinition"
        },
        {
          "name": "fxFixingDate",
          "description": "Describes the specific date when a non-deliverable forward or cash-settled option will 'fix' against a particular rate, which will be used to compute the ultimate cash settlement. This element should be omitted where a single, discrete fixing date cannot be identified e.g. on an american option, where fixing may occur at any date on a continuous range. This attribute was formerly part of 'fxSettlementTerms', which is now being harmonised into a common 'CashSettlementTerms' that includes a 'ValuationDate'.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FxFixingDate",
      "all_of": [
        {
          "description": "BusinessCentersChoice: condition to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "businessCenters",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "businessCentersReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "businessCenters",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "businessCentersReference",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "DateChoice: condition to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "dateRelativeToPaymentDates",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
