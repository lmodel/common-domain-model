    {
      "name": "LegacyIndependentAmountRatingsBased",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LegacyIndependentAmountRatingsBased",
      "description": "Specifies that the Independent Amount is determined using a credit rating.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "is_a": "IndependentAmountRatings",
      "slots": [
        "independentAmountRatings__compare",
        "independentAmountRatings__ratedParty",
        "independentAmountRatings__namedAffiliate",
        "independentAmountRatings__namedEntity",
        "independentAmountRatings__ratingType",
        "legacyIndependentAmountRatingsBased__variableSet",
        "legacyIndependentAmountRatingsBased__currency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "variableSet",
          "description": "A logical container designed to hold a defined set of related data. In this case the collation of Rating Information and an associated Independent Amount.",
          "range": "RatingAgencyAmount",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the currency applicable to the relevant Independent Amount.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LegacyIndependentAmountRatingsBased",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "compare",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "compare",
                    "equals_string": "Lowest",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "compare",
                    "equals_string": "Highest",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "RestrictCompare: Restricts allowable values pertaining to how multiple credit ratings are compared when determining the applicable Independent Amount.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "LegacyIndependentAmountRatingsXExposure",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LegacyIndependentAmountRatingsXExposure",
      "description": "Specifies that the Independent Amount is determined using both credit rating and exposure metrics.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "is_a": "IndependentAmountRatings",
      "slots": [
        "independentAmountRatings__compare",
        "independentAmountRatings__ratedParty",
        "independentAmountRatings__namedAffiliate",
        "independentAmountRatings__namedEntity",
        "independentAmountRatings__ratingType",
        "legacyIndependentAmountRatingsXExposure__highestLowestVariableSet",
        "legacyIndependentAmountRatingsXExposure__compareVariableSet"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "highestLowestVariableSet",
          "description": "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier where highest or lowest of the associated credit ratings are used when determining the applicable Independent Amount.",
          "range": "RatingMultiplier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "compareVariableSet",
          "description": "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier where multiple credit ratings are compared when determining the applicable Independent Amount.",
          "range": "DirectionRatingMultiplier",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LegacyIndependentAmountRatingsXExposure",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "compare",
                "equals_string": "Compare",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "compareVariableSet",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "highestLowestVariableSet",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CompareIA: Ensures the appropriate variable set is populated based on how the Ratings are compared.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "compare",
                "equals_string": "Lowest",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "highestLowestVariableSet",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "compareVariableSet",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "LowestIA: Ensures the appropriate variable set is populated based on how the Ratings are compared.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "compare",
                "equals_string": "Highest",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "highestLowestVariableSet",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "compareVariableSet",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "HighestIA: Ensures the appropriate variable set is populated based on how the Ratings are compared.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "LegacyResolutionAlternative",
