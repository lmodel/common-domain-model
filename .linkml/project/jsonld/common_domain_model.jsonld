    {
      "name": "PartyChangeInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PartyChangeInstruction",
      "description": "Specifies instruction to change the party on a trade. This primitive instruction is used in a number of scenarios including: clearing, allocation and novation. The instrution must include a trade identifier, because a change of party effectively results in a different trade.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "partyChangeInstruction__counterparty",
        "partyChangeInstruction__ancillaryParty",
        "partyChangeInstruction__partyRole",
        "partyChangeInstruction__tradeId"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "counterparty",
          "description": "The new counterparty who is stepping into the trade. The stepping out counterparty is inferred based on the counterparty role that is being updated.",
          "range": "Counterparty",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ancillaryParty",
          "description": "Specifies an ancillary party to be added onto the new transaction, e.g. the original executing party in an allocation.",
          "range": "AncillaryParty",
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRole",
          "description": "Specifies an additional party roles to be added on to the new transaction.",
          "range": "PartyRole",
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeId",
          "description": "The identifier to be assigned to the new trade post change of party.",
          "range": "TradeIdentifier",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PartyChangeInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "PayoutTransferBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PayoutTransferBase",
      "description": "Defines a transfer of an Asset associated with an economic payout - either a payout's own scheduled terms or an outcome contingent on some other event. Carries a reference back to that Payout, and allows the transfer's payer/receiver to be expressed as a generic, unresolved Party1 / Party2 enumerator, since a transfer generated directly from a payout's terms may not yet be tied to resolved parties.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "TransferBase",
      "slots": [
        "transferBase__identifier",
        "transferBase__quantity",
        "transferBase__asset",
        "transferBase__settlementDate",
        "transferBase__paymentDiscounting",
        "transferBase__partyReferencePayerReceiver",
        "payoutTransferBase__payerReceiver",
        "payoutTransferBase__payoutReference"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "payerReceiver",
          "description": "Specifies who pays/receives the transfer, through a normalised Party1 / Party2 enumerator, for use before the transfer is resolved to actual parties.",
          "range": "PayerReceiver",
          "@type": "SlotDefinition"
        },
        {
          "name": "payoutReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Represents the origin to the transfer as a reference for lineage purposes, whether it originated from trade level settlement terms or from payment terms on an economic payout.",
          "range": "Payout",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PayoutTransferBase",
      "all_of": [
        {
          "description": "PayerReceiverChoice: Required choice between a generic, unresolved payer/receiver and a party referenced payer/receiver for the transfer.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "partyReferencePayerReceiver",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "payerReceiver",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PositionIdentifier",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PositionIdentifier",
      "description": "Defines a position identifier as a special case of the generic identifier type, that also includes the position identifier class.",
