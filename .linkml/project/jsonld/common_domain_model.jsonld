        },
        {
          "name": "observationDate",
          "description": "The day upon which the rate was observed (for term rates).",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "resetDate",
          "description": "The day for which the rate is needed (e.g. period beginning or end date).",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "floatingRate",
          "description": "The resulting rate that was observed or calculated.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateSettingDetails",
      "@type": "ClassDefinition"
    },
    {
      "name": "AgencyRatingCriteria",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AgencyRatingCriteria",
      "description": "Represents a class to specify a credit notation.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "agencyRatingCriteria__creditNotation",
        "agencyRatingCriteria__mismatchResolution",
        "agencyRatingCriteria__referenceAgency",
        "agencyRatingCriteria__boundary"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "creditNotation",
          "description": "Indicates the agency rating criteria specified for the asset or issuer.",
          "range": "CreditNotation",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "mismatchResolution",
          "description": "Indicator for options to be used if several agency ratings (>1) are specified and its necessary to identify specific charateristics. i.e (lowest or highest).",
          "range": "CreditNotationMismatchResolutionEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "referenceAgency",
          "description": "identifies the dominant reference agency if there is a missmatch and several reference agencies exsist.",
          "range": "CreditRatingAgencyEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "boundary",
          "description": "Indicates the boundary of a credit agency rating i.e minimum or maximum.",
          "range": "CreditNotationBoundaryEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AgencyRatingCriteria",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "mismatchResolution",
                "value_presence": "PRESENT",
                "equals_string": "ReferenceAgency",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "referenceAgency",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ReferenceAgency: If the mismatch resolution is ReferenceAgency, ensure that the reference agency is specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
