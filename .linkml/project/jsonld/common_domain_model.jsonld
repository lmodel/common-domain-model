    {
      "name": "PerformancePayout",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PerformancePayout",
      "description": "Contains the necessary specifications for all performance payouts, encompassing equity return, dividend, variance, volatility and correlation products.",
      "comments": [
        "Rosetta condition Underlier is not stated in LinkML: underlier as Observable exists",
        "Rosetta condition PortfolioReturnIsMultipleReturns is not stated in LinkML: if portfolioReturnTerms exists then portfolioReturnTerms count > 1",
        "Rosetta condition UnderlierOfPortfolioIsBasket is not stated in LinkML: if portfolioReturnTerms -> priceReturnTerms exists then underlier as Basket exists",
        "Rosetta condition NoSharePriceDividendAdjustmentIndex is not stated in LinkML: if underlier as Index exists then returnTerms -> varianceReturnTerms -> sharePriceDividendAdjustment is absent and returnTerms -> volatilityReturnTerms -> sharePriceDividendAdjustment is absent",
        "Rosetta condition NoSharePriceDividendAdjustmentForeignExchange is not stated in LinkML: if underlier as ForeignExchangeRateIndex exists then returnTerms -> varianceReturnTerms -> sharePriceDividendAdjustment is absent and returnTerms -> volatilityReturnTerms -> sharePriceDividendAdjustment is absent",
        "Rosetta condition CorrelationUnderlierOnlyBasket is not stated in LinkML: if returnTerms -> correlationReturnTerms exists then underlier as Basket exists",
        "Rosetta condition EquitySpecificAttributes is not stated in LinkML: if Qualify_UnderlierObservable_Equity (underlier as Observable) = False then returnTerms -> varianceReturnTerms -> dividendApplicability is absent and returnTerms -> varianceReturnTerms -> equityUnderlierProvisions is absent and returnTerms -> varianceReturnTerms -> sharePriceDividendAdjustment is absent and returnTerms -> volatilityReturnTerms -> dividendApplicability is absent and returnTerms -> volatilityReturnTerms -> equityUnderlierProvisions is absent and returnTerms -> volatilityReturnTerms -> sharePriceDividendAdjustment is absent and returnTerms -> correlationReturnTerms -> dividendApplicability is absent and returnTerms -> correlationReturnTerms -> equityUnderlierProvisions is absent and returnTerms -> correlationReturnTerms -> sharePriceDividendAdjustment is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "is_a": "PayoutBase",
      "slots": [
        "payoutBase__payerReceiver",
        "payoutBase__priceQuantity",
        "payoutBase__principalPayment",
        "payoutBase__settlementTerms",
        "performancePayout__observationTerms",
        "performancePayout__valuationDates",
        "performancePayout__paymentDates",
        "performancePayout__underlier",
        "performancePayout__fxFeature",
        "performancePayout__returnTerms",
        "performancePayout__portfolioReturnTerms",
        "performancePayout__initialValuationPrice",
        "performancePayout__interimValuationPrice",
        "performancePayout__finalValuationPrice"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "observationTerms",
          "description": "Defines how and when a performance type option or performance type swap is to be observed.",
          "range": "ObservationTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationDates",
          "description": "Defines how and when a performance type option or performance type swap is to be valued, including both interim and final valuation.",
          "range": "ValuationDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentDates",
          "description": "Defines the payment date schedule, as defined by the parameters that are needed to specify it, either in a parametric way or by reference to another schedule of dates (e.g. the valuation dates).",
          "range": "PaymentDates",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "underlier",
          "description": "Identifies the underlying product that is referenced for pricing of the applicable leg in a swap. Referenced in the '2018 ISDA CDM Equity Confirmation for Security Equity Swap' as Security.",
          "range": "Underlier",
          "@type": "SlotDefinition"
        },
        {
          "name": "fxFeature",
          "description": "Defines quanto or composite FX features that are included in the swap leg.",
          "range": "FxFeature",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "returnTerms",
          "description": "Specifies the type of return of a performance payout.",
          "range": "ReturnTerms",
          "@type": "SlotDefinition"
        },
        {
          "name": "portfolioReturnTerms",
          "description": "Specifies an individual type of return of a Performance Payout, when such individual return is part of an aggregation of multiple similar returns, at Performance Payout level",
          "range": "PortfolioReturnTerms",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "initialValuationPrice",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->price",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the net initial valuation price(s) of the underlier at Performance Payout level. This price can be expressed either as an actual amount/currency, as a determination method, or by reference to another value specified in the swap document.",
          "range": "PriceSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "interimValuationPrice",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->price",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the net initial valuation price(s) of the underlier at Performance Payout level. This price can be expressed either as an actual amount/currency, as a determination method, or by reference to another value specified in the swap document.",
          "range": "PriceSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "finalValuationPrice",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "address \"pointsTo\"=PriceQuantity->price",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the net final valuation price(s) of the underlier at Performance Payout level. This price can be expressed either as an actual amount/currency, as a determination method, or by reference to another value specified in the swap document.",
          "range": "PriceSchedule",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PerformancePayout",
      "all_of": [
        {
          "description": "PortfolioOrStraightReturn",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "returnTerms",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "portfolioReturnTerms",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "Quantity: When there is an OptionPayout the quantity can be expressed as part of the payoutQuantity, or as part of the underlier in the case of a Swaption. For all other payouts that extend PayoutBase the payoutQuantity is a mandatory attribute.",
          "slot_conditions": [
            {
              "name": "priceQuantity",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PortfolioReturnTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PortfolioReturnTerms",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
