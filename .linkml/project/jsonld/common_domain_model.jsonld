    {
      "name": "FinancialUnitEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FinancialUnitEnum",
      "description": "Provides enumerated values for financial units, generally used in the context of defining quantities for securities.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "permissible_values": [
        {
          "text": "Contract",
          "description": "Denotes financial contracts, such as listed futures and options."
        },
        {
          "text": "ContractualProduct",
          "description": "Denotes a Contractual Product as defined in the CDM. This unit type would be used when the price applies to the whole product, for example, in the case of a premium expressed as a cash amount."
        },
        {
          "text": "IndexUnit",
          "description": "Denotes a price expressed in index points, e.g. for a stock index."
        },
        {
          "text": "LogNormalVolatility",
          "description": "Denotes a log normal volatility, expressed in %/month, where the percentage is represented as a decimal. For example, 0.15 means a log-normal volatility of 15% per month."
        },
        {
          "text": "Share",
          "description": "Denotes the number of units of financial stock shares."
        },
        {
          "text": "ValuePerDay",
          "description": "Denotes a value (expressed in currency units) for a one day change in a valuation date, which is typically used for expressing sensitivity to the passage of time, also known as theta risk, or carry, or other names."
        },
        {
          "text": "ValuePerPercent",
          "description": "Denotes a value (expressed in currency units) per percent change in the underlying rate which is typically used for expressing sensitivity to volatility changes, also known as vega risk."
        },
        {
          "text": "Weight",
          "description": "Denotes a quantity (expressed as a decimal value) represented the weight of a component in a basket."
        }
      ]
    },
    {
      "name": "QuantifierEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/QuantifierEnum",
      "description": "Represents the enumerated values to specify a logical quantification, i.e. either All or Any.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "permissible_values": [
        {
          "text": "All",
          "description": "Specifies that the condition in the scope of the quantifier is true of every member of the domain i.e. every one of the elements in scope."
        },
        {
          "text": "Any",
          "description": "Specifies that the condition in the scope of the quantifier is true of at least one member of the domain i.e. one or more of the elements in scope."
        }
      ]
    },
    {
      "name": "QuantityChangeDirectionEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/QuantityChangeDirectionEnum",
      "description": "Specifies whether a quantity change is an increase, a decrease or a replacement, whereby the quantity is always specified as a positive number.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "permissible_values": [
        {
          "text": "Increase",
          "description": "When the quantity should go up by the specified amount."
        },
        {
          "text": "Decrease",
          "description": "When the quantity should go down by the specified amount."
        },
        {
          "text": "Replace",
          "description": "When the quantity should be replaced by the specified amount."
        }
      ]
    },
    {
      "name": "RoundingDirectionEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RoundingDirectionEnum",
      "description": "The enumerated values to specify the rounding direction and precision to be used in the rounding of a number. Used by function cdm.base.math.RoundToPrecision.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "permissible_values": [
        {
          "text": "Up",
          "description": "A fractional number will be rounded up to the specified number of decimal places (the precision). For example, 5.21 and 5.25 rounded up to 1 decimal place are 5.3 and 5.3 respectively."
        },
        {
          "text": "Down",
          "description": "A fractional number will be rounded down to the specified number of decimal places (the precision). For example, 5.29 and 5.25 rounded down to 1 decimal place are 5.2 and 5.2 respectively."
        },
        {
          "text": "Nearest",
          "description": "A fractional number will be rounded either up or down to the specified number of decimal places (the precision) depending on its value. For example, 5.24 would be rounded down to 5.2 and 5.25 would be rounded up to 5.3 if a precision of 1 decimal place were specified."
        }
      ]
    },
    {
      "name": "RoundingModeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RoundingModeEnum",
      "description": "The enumerated values to specify the rounding direction when rounding of a number to nearest. Used by function cdm.base.math.RoundToNearest.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "permissible_values": [
        {
          "text": "Down",
          "description": "A number will be rounded down to the specified nearest number. For example, 529 rounded down to the nearest 10 is 520."
        },
        {
          "text": "Up",
          "description": "A number will be rounded up to the specified nearest number. For example, 521 rounded up to the nearest 10 is 530."
        }
      ]
    },
    {
      "name": "WeatherUnitEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/WeatherUnitEnum",
      "description": "Provides enumerated values for weather units, generally used in the context of defining quantities for commodities.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "permissible_values": [
        {
          "text": "CDD",
          "description": "Denotes Cooling Degree Days as a standard unit."
        },
        {
          "text": "CPD",
          "description": "Denotes Critical Precipitation Day as a standard unit."
        },
        {
          "text": "HDD",
          "description": "Heating Degree Day as a standard unit."
        }
      ]
    },
