    {
      "name": "CSAValuationDate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CSAValuationDate",
      "description": "Specifies the date on which the value of collateral or exposure are calculated in accordance with the agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "cSAValuationDate__date",
        "cSAValuationDate__day",
        "cSAValuationDate__calendarDay",
        "cSAValuationDate__frequency",
        "cSAValuationDate__additionalLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "date",
          "description": "Defines whether a date is defined by a certain day of the week or a particular date in the month. If not specified here, then additional language must be used.",
          "range": "ValuationDateDateEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "day",
          "description": "Specific day(s) or day of the week, if any, specified for Valuation Time.",
          "range": "ValuationDateDayEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "calendarDay",
          "description": "Defines the day of the calendar if this is specified for in the ValuationDateDateEnum.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "frequency",
          "description": "Defines the regularity of the date specified for the Valuation Date.",
          "range": "ValuationDateFrequencyEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalLanguage",
          "description": "The additional language that might be specified by the parties to the legal agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CSAValuationDate",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "date",
                "value_presence": "PRESENT",
                "equals_string": "CalendarDay",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "calendarDay",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "elseconditions": {
            "slot_conditions": [
              {
                "name": "calendarDay",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CalendarDay: If a specific calendar day is specified, it must be defined.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "date",
                    "value_presence": "ABSENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "frequency",
                    "value_presence": "ABSENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "additionalLanguage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "AdditionalLanguage: If no methodology is defined, additional language must be specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CalculationAgentTerms",
