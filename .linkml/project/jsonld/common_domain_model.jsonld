        },
        {
          "name": "AmountOfNetCapital",
          "description": "The minimum amount of net capital to be entitled to hold Posted Collateral.",
          "range": "AmountOfNetCapital",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EligibilityToHoldCollateralCriteria",
      "all_of": [
        {
          "description": "OneOf: A choice type holds exactly one of its options.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "AllEligibilityToHoldCollateralCriteria",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "AnyEligibilityToHoldCollateralCriteria",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "RatingAgencyValue",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "AmountOfNetCapital",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
