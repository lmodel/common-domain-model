                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "IndexType",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "CounterpartyOwnIssuePermitted",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "DomesticCurrencyIssued",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralCriteriaBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralCriteriaBase",
      "description": "Represents a set of criteria used to specify and describe collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateralCriteriaBase__collateralCriteria",
        "collateralCriteriaBase__appliesTo",
        "collateralCriteriaBase__restrictTo",
        "collateralCriteriaBase__ratingPriorityResolution"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "collateralCriteria",
          "description": "The specific criteria that applies. It can be created using AND, OR and NOT logic, and both asset and issuer characteristics.",
          "range": "CollateralCriteria",
          "@type": "SlotDefinition"
        },
        {
          "name": "appliesTo",
          "description": "Specifies which of the two counterparties the criteria applies to (either one or both counterparties). This attribute is optional, in case the applicable party is already specified elsewhere within a party election.",
          "range": "CounterpartyRoleEnum",
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "restrictTo",
          "description": "Restrict the criteria to only apply to a specific type of margin, ie IM or VM.",
          "range": "CollateralMarginTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "ratingPriorityResolution",
          "description": "Denotes which Criteria has priority if more than one agency rating applies.",
          "range": "RatingPriorityResolutionEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralCriteriaBase",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralInterestCalculationParameters",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralInterestCalculationParameters",
      "description": "Represents parameters for calculating the amount the floating interest calculation, e.g. for a single currency or defaults for all currencies.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateralInterestCalculationParameters__fixedRate",
        "collateralInterestCalculationParameters__floatingRate",
        "collateralInterestCalculationParameters__inBaseCurrency",
        "collateralInterestCalculationParameters__compoundingType",
        "collateralInterestCalculationParameters__compoundingBusinessCenter",
        "collateralInterestCalculationParameters__dayCountFraction",
        "collateralInterestCalculationParameters__rounding",
        "collateralInterestCalculationParameters__roundingFrequency",
        "collateralInterestCalculationParameters__withholdingTaxRate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "fixedRate",
          "description": "Specifies the applicable fixed rate if used.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "floatingRate",
          "description": "Specifies the floating interest rate to be used.",
          "range": "CollateralAgreementFloatingRate",
          "@type": "SlotDefinition"
        },
        {
          "name": "inBaseCurrency",
          "description": "If True, specifies that the interest transfers should be converted to base currency equivalent, or if False specifies that the transfer should be in the currency of the collateral.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "compoundingType",
          "description": "Specifies the type of compounding to be applied (None, Business, Calendar).",
          "range": "CompoundingTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "compoundingBusinessCenter",
          "description": "Specifies the applicable business centers for compounding.",
          "range": "BusinessCenter",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dayCountFraction",
          "description": "Specifies the day count fraction to use for that currency.",
          "range": "DayCountFractionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "rounding",
          "description": "Specifies the rounding rules for settling in that currency.",
          "range": "Rounding",
          "@type": "SlotDefinition"
        },
        {
          "name": "roundingFrequency",
          "description": "Specifies when/how often is rounding applied?",
          "range": "RoundingFrequencyEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "withholdingTaxRate",
          "description": "Specifies the withholding tax rate if a withholding tax is applicable.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralInterestCalculationParameters",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "compoundingType",
                "value_presence": "PRESENT",
                "equals_string": "Business",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "compoundingBusinessCenter",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CompoundingBC1",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "compoundingType",
                    "value_presence": "PRESENT",
                    "equals_string": "Business",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "compoundingBusinessCenter",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CompoundingBC2",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "InterestRate",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "fixedRate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "floatingRate",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "DCF",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "dayCountFraction",
                  "equals_string": "ACT/360",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "dayCountFraction",
                  "equals_string": "ACT/365.FIXED",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralInterestHandlingParameters",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralInterestHandlingParameters",
      "description": "Represents parameters that describe how calculated interest amounts are handled, i.e. are they transferred/distributed, or is the collateral balance adjusted, is netting done, and any other special handling.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateralInterestHandlingParameters__interestPaymentHandling",
        "collateralInterestHandlingParameters__paymentBusinessCenter",
        "collateralInterestHandlingParameters__netPostedAndHeldInterest",
        "collateralInterestHandlingParameters__netInterestWithMarginCalls",
        "collateralInterestHandlingParameters__includeAccrualInMarginCalc",
        "collateralInterestHandlingParameters__accrueInterestOnUnsettledInterest",
        "collateralInterestHandlingParameters__onFullReturn",
        "collateralInterestHandlingParameters__onPartialReturn",
        "collateralInterestHandlingParameters__interestAmountApplication",
        "collateralInterestHandlingParameters__interestRolloverLimit",
        "collateralInterestHandlingParameters__writeoffLimit",
        "collateralInterestHandlingParameters__alternativeToInterestAmount",
        "collateralInterestHandlingParameters__alternativeProvision",
        "collateralInterestHandlingParameters__cutoffTime",
        "collateralInterestHandlingParameters__notification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "interestPaymentHandling",
          "description": "Specifies how the collateral interest is to be handled.",
          "range": "CollateralInterestHandlingEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentBusinessCenter",
          "description": "Specifies applicable business centers for payments.",
          "range": "BusinessCenter",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "netPostedAndHeldInterest",
          "description": "Indicates whether to net Held and Posted Interest Payments (i.e. whether interest payable for a period can be netted with interest receivable).",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "netInterestWithMarginCalls",
          "description": "Indicates whether the interest amount may be offset against any margin call deliver or return amounts? (aka 'net payments' indicator).",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "includeAccrualInMarginCalc",
          "description": "Indicates whether or not to include the open interest accrual in the margin calculation.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "accrueInterestOnUnsettledInterest",
          "description": "Indicates whether interest accruing on unsettled interest amount is included (continues to be accrued) in the following period.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "onFullReturn",
          "description": "Indicates the option that accrued interest should be calculated and distributed when a full return of collateral occurs.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "onPartialReturn",
          "description": "Indicates the option that accrued interest should be calculated and distributed when a partial return collateral occurs.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "interestAmountApplication",
          "description": "The application of Interest Amount with respect to the Delivery Amount and the Return Amount.",
          "range": "InterestAmountApplication",
          "@type": "SlotDefinition"
        },
        {
          "name": "interestRolloverLimit",
          "description": "Specifies the level below which the interest will be rolled over.",
          "range": "NumberBound",
          "@type": "SlotDefinition"
        },
        {
          "name": "writeoffLimit",
          "description": "Specifies the level below which the interest will be written off; if omitted write-off is not applicable.",
          "range": "NumberBound",
          "@type": "SlotDefinition"
        },
        {
          "name": "alternativeToInterestAmount",
          "description": "Specifies the alternative to interest amounts.",
          "range": "AlternativeToInterestAmountEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "alternativeProvision",
          "description": "Specifies an alternative to interest amount, when the alternative provision clause is specified.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "cutoffTime",
          "description": "Specifies the time of day that interest needs to be confirmed by.",
          "range": "time",
          "@type": "SlotDefinition"
        },
        {
          "name": "notification",
          "description": "Specifies the terms describing notification requirements.",
          "range": "CollateralInterestNotification",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralInterestHandlingParameters",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "alternativeToInterestAmount",
                "value_presence": "PRESENT",
                "equals_string": "Other",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "alternativeProvision",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Alternative",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "alternativeToInterestAmount",
                    "value_presence": "PRESENT",
                    "equals_string": "Other",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "alternativeProvision",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Alternative2",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralInterestNotification",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralInterestNotification",
      "description": "Represents the parameters describing when notifications should be made for required collateral interest transfers.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateralInterestNotification__trigger",
        "collateralInterestNotification__offset",
        "collateralInterestNotification__notificationTime",
        "collateralInterestNotification__notificationDayType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "trigger",
          "description": "Specifies what triggers notification (should be enum) Interest Statement Frequency, Period End Date.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "offset",
          "description": "Specifies the number of days before (negative) or after (positive) the trigger event.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "notificationTime",
          "description": "Specifies the time of day that the notification should occur.",
          "range": "time",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "notificationDayType",
          "description": "The type of days on which notification should occur.",
          "range": "DayTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralInterestNotification",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralInterestParameters",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralInterestParameters",
      "description": "Represents the floating interest calculation and distribution parameters for a single currency.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateralInterestParameters__postingParty",
        "collateralInterestParameters__marginType",
        "collateralInterestParameters__currency",
        "collateralInterestParameters__interestCalculationParameters",
        "collateralInterestParameters__interestCalculationFrequency",
        "collateralInterestParameters__interestHandlingParameters"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "postingParty",
          "description": "Represents the party to which these parameters apply (the applicable party). In other words, if the parameters are different depending on which party is posting/holding the collateral, for which party to the Collateral Agreement (Party 1 or Party 2) that is posting the collateral do these parameters apply?",
          "range": "CounterpartyRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "marginType",
          "description": "Specifies the type of margin for which interest is being calculated, if the parameters are different depending on type of margin (initial or variation).",
          "range": "CollateralMarginTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "description": "Specifies the currency for which the parameters are captured.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "interestCalculationParameters",
          "description": "Represents the basic interest calculation parameters.",
          "range": "CollateralInterestCalculationParameters",
          "@type": "SlotDefinition"
        },
        {
          "name": "interestCalculationFrequency",
          "description": "Represents how often and when interest is calculated.",
          "range": "CalculationFrequency",
          "@type": "SlotDefinition"
        },
        {
          "name": "interestHandlingParameters",
          "description": "Represents the parameters describing how and when interest transfer occurs.",
          "range": "CollateralInterestHandlingParameters",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralInterestParameters",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralProvisions",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralProvisions",
      "description": "Contains collateral attributes which can also inherit information from a GMRA",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateralProvisions__collateralType",
        "collateralProvisions__eligibleCollateral",
        "collateralProvisions__substitutionProvisions"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "collateralType",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ICMA GMRA namingConvention marginType",
              "@type": "Annotation"
            }
          ],
          "description": "Enumerates the collateral types which are accepted by the Seller.",
          "range": "CollateralTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "eligibleCollateral",
          "description": "The eligible collateral as specified in relation to the transaction.",
          "range": "EligibleCollateralCriteria",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "substitutionProvisions",
          "description": "The provisions for collateral substitutions such as how many and when they are allowed.",
          "range": "SubstitutionProvisions",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralProvisions",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralTreatment",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralTreatment",
      "description": "Specifies the treatment terms for the eligible collateral criteria specified.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateralTreatment__valuationTreatment",
        "collateralTreatment__concentrationLimit",
        "collateralTreatment__isIncluded"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "valuationTreatment",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ICMA GMRA namingConvention marginRatio",
              "@type": "Annotation"
            }
          ],
          "description": "Specification of the valuation treatment for the specified collateral.",
          "range": "CollateralValuationTreatment",
          "@type": "SlotDefinition"
        },
        {
          "name": "concentrationLimit",
          "description": "Specification of concentration limits applicable to the collateral criteria.",
          "range": "ConcentrationLimit",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "isIncluded",
          "description": "A boolean attribute to specify whether collateral critieria are inclusion (True) or exclusion (False) criteria.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralTreatment",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralValuationTreatment",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment",
      "description": "Specification of the valuation treatment for the specified collateral.",
      "comments": [
        "Rosetta condition HaircutPercentage is not stated in LinkML: if haircutPercentage exists then haircutPercentage >= 0 and haircutPercentage < 1",
        "Rosetta condition FxHaircutPercentage is not stated in LinkML: if fxHaircutPercentage exists then fxHaircutPercentage > 0 and fxHaircutPercentage < 1",
        "Rosetta condition AdditionalHaircutPercentage is not stated in LinkML: if additionalHaircutPercentage exists then additionalHaircutPercentage > 0 and additionalHaircutPercentage < 1"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateralValuationTreatment__haircutPercentage",
        "collateralValuationTreatment__marginPercentage",
        "collateralValuationTreatment__fxHaircutPercentage",
        "collateralValuationTreatment__additionalHaircutPercentage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "haircutPercentage",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ICMA GMRA namingConvention Haircut | ICMA ERCCBestPractice namingConvention Haircut",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies a haircut percentage to be applied to the value of asset and used as a discount factor to the value of the collateral asset,expressed as a percentage in decimal terms. As an example a 0.5% haircut would be represented as a decimal number 0.005.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "marginPercentage",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ICMA GMRA namingConvention Margin Ratio | ICMA ERCCBestPractice namingConvention Margin Ratio",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies a percentage value of transaction needing to be posted as collateral expressed as a valuation. As an example a 104% requirement would be represented as a decimal number 1.04.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "fxHaircutPercentage",
          "description": "Specifies an FX haircut applied to a specific asset which is agreed between the parties (for example, if pledgor eligible collateral is not denominated in the termination currency or under other specified cases in collateral support documents both for initial margin and variation margin).The percentage value is expressed as the discount haircut to the value of the collateral- as an example an 8% FX haircut would be expressed as 0.08.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalHaircutPercentage",
          "description": "Specifies a percentage value of any additional haircut to be applied to a collateral asset,the percentage value is expressed as the discount haircut to the value of the collateral- as an example a 5% haircut would be expressed as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "marginPercentage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "marginPercentage",
                "minimum_value": 1,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "MarginPercentage: A data rule to validate that if a Margin Percentage is specified it should be greater than 1.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "HaircutPercentageOrMarginPercentage: Choice rule requiring that either a haircut percentage or margin percentage is specified.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "haircutPercentage",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "marginPercentage",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
