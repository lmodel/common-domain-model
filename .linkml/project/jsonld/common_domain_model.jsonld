          "range": "CommodityLocationIdentifierTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LocationIdentifier",
      "all_of": [
        {
          "description": "From Identifier. IssuerChoice: The identifier issuer is specified either explicitly or by reference to one of the parties.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "issuerReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "issuer",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Account",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Account",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify an account as an account number alongside, optionally. an account name, an account type, an account beneficiary and a servicing party.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party",
      "slots": [
        "account__partyReference",
        "account__accountNumber",
        "account__accountName",
        "account__accountType",
        "account__accountBeneficiary",
        "account__servicingParty"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "partyReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A reference to the party to which the account refers to.",
          "range": "Party",
          "@type": "SlotDefinition"
        },
        {
          "name": "accountNumber",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The account number.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "accountName",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The name by which the account is known.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "accountType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The type of account, e.g. client, house.",
          "range": "AccountTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "accountBeneficiary",
          "annotations": [
            {
              "tag": "rosetta_metadata",
