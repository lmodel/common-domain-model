    {
      "name": "ResetInstructionCompositionStepsEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ResetInstructionCompositionStepsEnum",
      "description": "Defines the strictly sequenced lifecycle of a Reset process. Each enum value represents a discrete atomic action required to transition the Instruction Composition from initial trade parameters to the final Reset execution output.",
