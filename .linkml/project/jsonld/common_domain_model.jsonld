    {
      "name": "PaymentRule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PaymentRule",
      "description": "A class defining the payment calculation rule. As of FpML 5.10, percentage rule is the only calculation rule that has been specified as part of the standard.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "paymentRule__percentageRule"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "percentageRule",
          "description": "This attribute is not present as part of the FpML construct, as the payment rule is specialised by means of runtime type extension through the xsi:type.",
          "range": "PercentageRule",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PaymentRule",
      "@type": "ClassDefinition"
    },
    {
      "name": "PayoutBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PayoutBase",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A data type that contains the common attributes (e.g. payer and receiver parties) and validation conditions that apply across all payout types",
      "comments": [
        "Rosetta condition FinalPrincipalAmountExists is not stated in LinkML: if principalPayment -> principalPaymentSchedule -> finalPrincipalPayment exists and priceQuantity -> quantitySchedule exists and priceQuantity -> reset is absent then principalPayment -> principalPaymentSchedule -> finalPrincipalPayment -> principalAmount exists or principalPayment -> principalPaymentSchedule -> finalPrincipalPayment -> presentValuePrincipalAmount exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "payoutBase__payerReceiver",
        "payoutBase__priceQuantity",
        "payoutBase__principalPayment",
        "payoutBase__settlementTerms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "payerReceiver",
          "description": "Canonical representation of the payer and receiver parties applicable to each payout leg.",
          "range": "PayerReceiver",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "priceQuantity",
          "description": "Each payout leg must implement the quantity concept as a 'resolvable' type, which allows for different payout legs to be linked to each other (e.g. in the case of cross-curreny products).",
          "range": "ResolvablePriceQuantity",
          "@type": "SlotDefinition"
        },
        {
          "name": "principalPayment",
          "description": "The specification of the principal exchange. Optional as only applicable in the case of cross-currency or zero-coupon swaps with a final payment.",
          "range": "PrincipalPayments",
          "@type": "SlotDefinition"
        },
        {
          "name": "settlementTerms",
          "description": "Each payout leg must specifies its settlement terms, including the delivery type (i.e. cash vs physical, and their respective terms), the transfer type (DvP etc.) and settlement date, if any.",
          "range": "SettlementTerms",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PayoutBase",
      "@type": "ClassDefinition"
    },
    {
      "name": "PercentageRule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PercentageRule",
      "description": "A class defining a content model for a calculation rule defined as percentage of the notional amount.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "percentageRule__paymentPercent",
        "percentageRule__notionalAmountReference"
      ],
      "slot_usage": {},
      "attributes": [
