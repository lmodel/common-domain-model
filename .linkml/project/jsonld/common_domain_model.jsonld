      "@type": "ClassDefinition"
    },
    {
      "name": "LoanParticipation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LoanParticipation",
      "description": "A class to specify loan with a participation agreement whereby the buyer is capable of creating, or procuring the creation of, a contractual right in favour of the seller that provides the seller with recourse to the participation seller for a specified share in any payments due under the relevant loan which are received by the participation seller. ISDA 2003 Term: Direct Loan Participation.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "is_a": "PCDeliverableObligationCharac",
      "slots": [
        "pCDeliverableObligationCharac__applicable",
        "pCDeliverableObligationCharac__partialCashSettlement",
        "loanParticipation__qualifyingParticipationSeller"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "qualifyingParticipationSeller",
          "description": "If Direct Loan Participation is specified as a deliverable obligation characteristic, this specifies any requirements for the Qualifying Participation Seller. The requirements may be listed free-form. ISDA 2003 Term: Qualifying Participation Seller.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LoanParticipation",
      "@type": "ClassDefinition"
    },
    {
      "name": "PCDeliverableObligationCharac",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PCDeliverableObligationCharac",
      "description": "A class to specify the Partial Cash Deliverable Obligation Characteristic.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "pCDeliverableObligationCharac__applicable",
        "pCDeliverableObligationCharac__partialCashSettlement"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicable",
          "description": "Indicates whether the provision is applicable.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "partialCashSettlement",
          "description": "Specifies whether either 'Partial Cash Settlement of Assignable Loans', 'Partial Cash Settlement of Consent Required Loans' or 'Partial Cash Settlement of Participations' is applicable. If this element is specified and Assignable Loan is a Deliverable Obligation Characteristic, any Assignable Loan that is deliverable, but where a non-receipt of Consent by the Physical Settlement Date has occurred, the Loan can be cash settled rather than physically delivered. If this element is specified and Consent Required Loan is a Deliverable Obligation Characteristic, any Consent Required Loan that is deliverable, but where a non-receipt of Consent by the Physical Settlement Date has occurred, the Loan can be cash settled rather than physically delivered. If this element is specified and Direct Loan Participation is a Deliverable Obligation Characteristic, any Participation that is deliverable, but where this participation has not been effected (has not come into effect) by the Physical Settlement Date, the participation can be cash settled rather than physically delivered.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PCDeliverableObligationCharac",
      "@type": "ClassDefinition"
    },
    {
      "name": "PaymentDetail",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PaymentDetail",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "paymentDetail__paymentDate",
        "paymentDetail__paymentRule",
        "paymentDetail__paymentAmount"
      ],
      "slot_usage": {},
      "attributes": [
