    {
      "name": "FixedPricePayout",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FixedPricePayout",
      "description": "Represents a fixed price payout. There is no underlier associated with this payout type and is based on fixed pricing per a given unit (e.g. in commodities price per barrel)",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "is_a": "PayoutBase",
      "slots": [
        "payoutBase__payerReceiver",
