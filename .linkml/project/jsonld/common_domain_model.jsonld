      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/NoticeInformationElection",
      "@type": "ClassDefinition"
    },
    {
      "name": "OtherAgreement",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/OtherAgreement",
      "description": "A class for defining an agreement executed between parties.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "slots": [
        "OtherAgreement_version",
        "otherAgreement__identifier",
