    {
      "name": "EligibleCollateralCriteria",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EligibleCollateralCriteria",
      "description": "Represents a set of criteria used to specify eligible collateral.",
      "comments": [
        "Rosetta condition ConcentrationLimitTypeIssueOSAmountDebtOnly is not stated in LinkML: if treatment -> concentrationLimit -> concentrationLimitCriteria -> concentrationLimitType only-element = ConcentrationLimitTypeEnum -> IssueOutstandingAmount then CriteriaMatchesSecurityType (collateralCriteria, Debt) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType (item -> concentrationLimitCriteria -> collateralCriteria, Debt)) all = True",
        "Rosetta condition ConcentrationLimitTypeMarketCapEquityOnly is not stated in LinkML: if treatment -> concentrationLimit -> concentrationLimitCriteria -> concentrationLimitType only-element = ConcentrationLimitTypeEnum -> MarketCapitalisation then CriteriaMatchesSecurityType (collateralCriteria, Equity) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType (item -> concentrationLimitCriteria -> collateralCriteria, Equity)) all = True",
        "Rosetta condition AverageTradingVolumeEquityOnly is not stated in LinkML: if treatment -> concentrationLimit -> concentrationLimitCriteria -> averageTradingVolume exists then CriteriaMatchesSecurityType (collateralCriteria, Equity) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType (item -> concentrationLimitCriteria -> collateralCriteria, Equity)) all = True"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "is_a": "CollateralCriteriaBase",
      "slots": [
        "collateralCriteriaBase__appliesTo",
        "collateralCriteriaBase__restrictTo",
        "collateralCriteriaBase__ratingPriorityResolution",
        "eligibleCollateralCriteria__treatment",
        "EligibleCollateralCriteria_collateralCriteria"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "treatment",
          "description": "Identifies the treatment of specified collateral, e.g., haircuts,holding limits or exclusions.",
          "range": "CollateralTreatment",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EligibleCollateralCriteria",
      "@type": "ClassDefinition"
    },
