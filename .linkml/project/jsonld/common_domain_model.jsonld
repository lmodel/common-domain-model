          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "otherLanguage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "OtherLanguage: A data rule to enforce that bespoke execution language must be included if non-standard execution language is specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
