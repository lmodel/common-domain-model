    {
      "name": "CSAIndependentAmount",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CSAIndependentAmount",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_NewYork_1994 paragraph 13 clause (b)(iv)(A) | ISDA CSA_English_1995 paragraph 11 clause (b)(iii)(A) | ISDA CSD_English_1995 paragraph 11 clause (c)(iii)(A)",
          "@type": "Annotation"
        }
      ],
      "description": "Sets out the additional amount of collateral that is required to be delivered by that party irrespective of the mark-to-market exposure under the related Transactions. It may take the form of a fixed amount, or be determined using credit ratings.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "cSAIndependentAmount__partyElection",
        "cSAIndependentAmount__additionalLanguage"
