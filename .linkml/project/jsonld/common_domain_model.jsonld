        "valuationTime__timezone",
        "valuationTime__additionalLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "day",
          "description": "The day in respect of which the Valuation Time is being specified. If not specified, addional language must be used to define the methodology.",
          "range": "ValuationTimeDayEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "location",
          "description": "The location relevant to the timezone for the Valuation Time.",
          "range": "BusinessCenter",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "time",
          "description": "The type of time specified for the Valuation Time.",
          "range": "ValuationTimeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "hourminutetime",
          "description": "A time specified in a 24-hour notation, e.g. 3pm would be represented as 15:00.",
          "range": "time",
          "@type": "SlotDefinition"
        },
        {
          "name": "timezone",
          "description": "Any relevant time zone where specified.",
          "range": "BusinessCenter",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalLanguage",
          "description": "The additional language that might be specified by the parties to the legal agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ValuationTime",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "day",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "additionalLanguage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "AdditionalLanguage: If no Day valuation methodology is defined, additional language must be specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
