          "range": "Transfer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "transferStatus",
          "description": "Represents the State of the Transfer through its life-cycle.",
          "range": "TransferStatusEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TransferState",
      "@type": "ClassDefinition"
    },
    {
      "name": "UnscheduledTransfer",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/UnscheduledTransfer",
      "description": "An ad-hoc transfer instigated by a party to the contract. Extends TransferBase rather than PayoutTransferBase because an Unscheduled Transfer is not derived from a Payout's terms - it is initiated by a party against a known counterparty, so it will always have a resolved payer/receiver.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "TransferBase",
      "slots": [
        "transferBase__identifier",
        "transferBase__quantity",
        "transferBase__asset",
        "transferBase__settlementDate",
        "transferBase__paymentDiscounting",
        "transferBase__partyReferencePayerReceiver",
        "unscheduledTransfer__transferType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "transferType",
          "description": "Specifies the type of unscheduled transfer.",
          "range": "UnscheduledTransferEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/UnscheduledTransfer",
      "all_of": [
        {
          "description": "PartyReferencePayerReceiverExists: An Unscheduled Transfer must specify the resolved payer and receiver parties to the transfer.",
          "slot_conditions": [
            {
              "name": "partyReferencePayerReceiver",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Valuation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Valuation",
      "description": "Defines the value of an investment, asset, or security",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "Valuation_timestamp",
        "Valuation_source",
        "valuation__amount",
        "valuation__method",
        "valuation__scope",
        "valuation__delta",
        "valuation__valuationTiming",
        "valuation__priceComponent"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "amount",
          "description": "Current value of the outstanding contract",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "method",
          "description": "Method used for the valuation of the transaction by the valuation party.",
          "range": "ValuationTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "scope",
          "description": "Defines the scope of the valuation, what it applies to e.g. the collateral or the trade",
          "range": "ValuationScopeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "delta",
          "description": "The ratio of the change in the price of a derivative transaction to the change in the price of the underlying. This field is applicable only to options and swaptions.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationTiming",
          "description": "Denotes when the valuation was sourced during a business day.",
          "range": "PriceTimingEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "priceComponent",
          "description": "Denotes the price used to compute the valuation.",
          "range": "Price",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Valuation",
      "all_of": [
        {
          "description": "ValuationType: The below condition ensures one and only one of the two attributes: 'Valuation Method' or 'Valuation Source' is allowed. Valuation of a trade or a portfolio is either internally calculated (via M2Market or M2Model methods) or supplied from an external source (e.g Central Counterparty's Valuation). Valuation cannot be based upon internal calculations and external source at the same time.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "method",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "source",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
