    {
      "name": "AdditionalDisruptionEvents",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AdditionalDisruptionEvents",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA EquityDerivativesDefinitions_2002",
          "@type": "Annotation"
        }
      ],
      "description": "A type for defining the Additional Disruption Events.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction",
      "slots": [
        "additionalDisruptionEvents__changeInLaw",
        "additionalDisruptionEvents__failureToDeliver",
        "additionalDisruptionEvents__insolvencyFiling",
        "additionalDisruptionEvents__hedgingDisruption",
        "additionalDisruptionEvents__increasedCostOfHedging",
        "additionalDisruptionEvents__foreignOwnershipEvent",
        "additionalDisruptionEvents__lossOfStockBorrow",
        "additionalDisruptionEvents__maximumStockLoanRate",
        "additionalDisruptionEvents__increasedCostOfStockBorrow",
        "additionalDisruptionEvents__initialStockLoanRate",
        "additionalDisruptionEvents__determiningParty",
        "additionalDisruptionEvents__additionalBespokeTerms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "changeInLaw",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "failureToDeliver",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "insolvencyFiling",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "hedgingDisruption",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "increasedCostOfHedging",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "foreignOwnershipEvent",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "lossOfStockBorrow",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "maximumStockLoanRate",
          "description": "Specifies the maximum stock loan rate for Loss of Stock Borrow. A percentage of 5% is represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "increasedCostOfStockBorrow",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "initialStockLoanRate",
          "description": "Specifies the initial stock loan per ISDA Def. A percentage of 5% is represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "determiningParty",
          "description": "Specifies the party which determines additional disruption events.",
          "range": "AncillaryRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalBespokeTerms",
          "description": "Where parties may optionnaly describe any extra bespoke agreements, in regards of the standardized Extraordinary Events.",
          "range": "Clause",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AdditionalDisruptionEvents",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "maximumStockLoanRate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "all_of": [
              {
                "slot_conditions": [
                  {
                    "name": "maximumStockLoanRate",
                    "minimum_value": 0,
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "maximumStockLoanRate",
                    "maximum_value": 1,
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "MaximumStockLoanRate: FpML specifies the maximumStockLoanRate as a RestrictedPercentage, meaning that its value is comprised between 0 and 1.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "initialStockLoanRate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "all_of": [
              {
                "slot_conditions": [
                  {
                    "name": "initialStockLoanRate",
                    "minimum_value": 0,
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "initialStockLoanRate",
                    "maximum_value": 1,
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "InitialStockLoanRate: FpML specifies the initialStockLoanRate as a RestrictedPercentage, meaning that its value is comprised between 0 and 1.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "determiningParty",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "determiningParty",
                "value_presence": "PRESENT",
                "equals_string": "DisruptionEventsDeterminingParty",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DisruptionEventsDeterminingParty",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Clause",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Clause",
      "description": "A type for documenting additional clause that cannot yet be represented with the model and yet needed for a digital representation of the agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction",
      "slots": [
        "clause__identifier",
        "clause__terms",
        "clause__subcomponents"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "The name or identifier associated to this clause.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "terms",
          "description": "Content of this bespoke clause.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "subcomponents",
          "description": "Additional hierarchical components of the clause if relevant.",
          "range": "Clause",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Clause",
      "all_of": [
        {
          "description": "Unnamed condition (optional choice terms, subcomponents): The Clause should describe at least the additional terms, additional subcomponents or both.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "terms",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "subcomponents",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "terms",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "subcomponents",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
