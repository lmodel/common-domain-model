            }
          ],
          "description": "The reference index that is used to specify the floating interest rate. The FpML standard maintains the list of such indices, which are positioned as enumeration values as part of the CDM.",
          "range": "FloatingRateIndexEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "description": "FRO currency - 3 character ISO currrency code",
          "range": "ISOCurrencyCodeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "froType",
          "description": "FRO type (e.g. OIS)",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexIdentification",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRateIndexMap",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexMap",
      "description": "A map for a single FRO to or from an equivalent or similar FRO in a different contractual definitions version.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro",
      "slots": [
        "floatingRateIndexMap__index",
        "floatingRateIndexMap__contractualDefinitionIdentifier",
        "floatingRateIndexMap__identifier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "index",
          "description": "The FRO name that is being mapped to/from.",
          "range": "FloatingRateIndexEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "contractualDefinitionIdentifier",
          "description": "Contractual Definition to which the map applies. Includes Document Type and Document Version",
          "range": "ContractualDefinitionIdentifier",
          "@type": "SlotDefinition"
        },
        {
          "name": "identifier",
          "description": "Corresponds to the unique identifier of the Contractual Definition to which the map applies",
          "range": "Identifier",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexMap",
      "all_of": [
        {
          "description": "Choice: Choice between document uuid or document type and version",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "identifier",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "contractualDefinitionIdentifier",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "identifier",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "contractualDefinitionIdentifier",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRateIndexMappings",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexMappings",
      "description": "This type defines mappings between FROs in different definitional versions.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro",
      "slots": [
        "floatingRateIndexMappings__mapsTo",
        "floatingRateIndexMappings__mapsFrom"
      ],
