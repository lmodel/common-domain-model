    {
      "name": "AssetBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AssetBase",
      "description": "The base data type to specify common attributes for all Assets.",
      "comments": [
        "Rosetta condition RoleIsExchange is not stated in LinkML: if partyRole -> role = Exchange then isExchangeListed = True",
        "Rosetta condition ExchangeListed is not stated in LinkML: if isExchangeListed and partyRole exists then partyRole -> role = Exchange",
        "Rosetta condition IssuerRole is not stated in LinkML: if assetType = Security and partyRole exists then partyRole -> role = Issuer",
        "Rosetta condition ExchangeRole is not stated in LinkML: if assetType = ListedDerivative and partyRole exists then partyRole -> role = Exchange",
        "Rosetta condition LenderBorrowerRole is not stated in LinkML: if assetType = Loan and partyRole exists then partyRole -> role = Lender or partyRole -> role = Borrower"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "assetBase__identifier",
        "assetBase__taxonomy",
        "assetBase__isExchangeListed",
        "assetBase__party",
        "assetBase__partyRole",
        "assetBase__ancillaryPartyRole",
        "assetBase__assetType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "identifier",
          "description": "Asset Identifiers are used to uniquely identify an Asset, using a specified Asset Identifier Type.",
          "range": "AssetIdentifier",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "taxonomy",
          "description": "Defines the taxonomy of an object by combining a taxonomy source (i.e. the rules to classify the object) and a value (i.e. the output of those rules on the object.",
          "range": "Taxonomy",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "isExchangeListed",
          "description": "Defines whether the asset is listed on a public exchange.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "description": "The party with the obligation to pay dividends, coupons, or other payouts to the asset holder.",
          "range": "Party",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRole",
          "description": "The role of the payer specific to the asset type, i.e. bond, equity.",
          "range": "AssetPartyRole",
          "@type": "SlotDefinition"
        },
        {
          "name": "ancillaryPartyRole",
          "description": "The role of a party with indirect participation in the asset (i.e. transfer agent).",
          "range": "AssetAncillaryPartyRole",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "assetType",
          "description": "Specifies the type of asset.",
          "range": "AssetTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AssetBase",
      "@type": "ClassDefinition"
    },
