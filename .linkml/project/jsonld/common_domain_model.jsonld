    {
      "name": "Portfolio",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Portfolio",
      "description": "A Portfolio represents an aggregation of multiple Positions, by describing the parameters that this Portfolio should be aggregated based on. The resulting PortfolioState is calculated using these aggregation parameters as inputs, by aggregating all the Events that are relevant to this Portfolio. The concept of Portfolio works at all levels in the model: from the highest for a given LegalEntity for instance, to the lowest to account for security substitutions in a secutity financing transaction. As such, Portfolio can be used either above or below the Contract level.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "slots": [
        "portfolio__aggregationParameters",
        "portfolio__portfolioState"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "aggregationParameters",
          "description": "Describes the portfolio by describing how to aggregate all its relevant Events.",
          "range": "AggregationParameters",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "portfolioState",
          "description": "Describes the state of the Portfolio as a list of Positions resulting from the aggregation.",
          "range": "PortfolioState",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Portfolio",
      "@type": "ClassDefinition"
    },
    {
      "name": "PortfolioState",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PortfolioState",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "State-full representation of a Portfolio that describes all the positions held at a given time, in various states which can be either traded, settled, etc., with lineage information to the previous state",
      "comments": [
        "Rosetta condition Initialisation is not stated in LinkML: if lineage -> portfolioStateReference is absent then positions is absent and lineage -> eventReference is absent",
        "Rosetta condition NonTransferable is not stated in LinkML: positions -> product as NonTransferableProduct exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "slots": [
        "portfolioState__positions",
        "portfolioState__lineage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "positions",
          "description": "The list of positions, each containing a Quantity and a Product.",
          "range": "Position",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "lineage",
          "description": "Pointer to the previous PortfolioState and new Event(s) leading to the current (new) state. Previous PortfolioState in the Lineage can be Null in case this is the start of the chain of Events.",
          "range": "Lineage",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PortfolioState",
      "@type": "ClassDefinition"
    },
    {
      "name": "Position",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Position",
      "description": "A Position describes how much of a given Product is being held and constitutes the atomic element of a Portfolio.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "is_a": "PositionBase",
      "slots": [
        "positionBase__priceQuantity",
        "positionBase__asset",
        "positionBase__cashBalance",
        "positionBase__tradeReference",
        "Position_product"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Position",
      "all_of": [
        {
          "description": "From PositionBase. ProductOrAsset: A Position must either refer to a grouping by product or a grouping by asset.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "product",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "asset",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PositionBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PositionBase",
      "description": "Base class to describe a Position, which could be a group of products (e.g. trade portfolio) or a group of assets (e.g. collateral portfolio).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "slots": [
        "positionBase__priceQuantity",
        "positionBase__product",
        "positionBase__asset",
        "positionBase__cashBalance",
        "positionBase__tradeReference"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "priceQuantity",
          "description": "Position with many price quantities.",
          "range": "PriceQuantity",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "product",
          "description": "The product underlying the position.",
          "range": "Product",
          "@type": "SlotDefinition"
        },
        {
          "name": "asset",
          "description": "The asset that underlies the position.",
          "range": "Asset",
          "@type": "SlotDefinition"
        },
        {
          "name": "cashBalance",
          "description": "The aggregate cost of proceeds.",
          "range": "Money",
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to the Contract, in case product is contractual and the contract has been formed.",
          "range": "TradeState",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PositionBase",
      "all_of": [
        {
          "description": "ProductOrAsset: A Position must either refer to a grouping by product or a grouping by asset.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "product",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "asset",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "SecurityLocate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SecurityLocate",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "A locate is an approval from a broker that needs to be obtained prior to effecting a short sale in an equity security. Similar to security availability, a borrower can request a single or multiple securities, but at least one must be requested.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_position",
      "is_a": "AvailableInventory",
      "slots": [
        "availableInventory__availableInventoryType",
        "availableInventory__identifier",
        "availableInventory__comment",
        "availableInventory__messageInformation",
        "availableInventory__party",
        "availableInventory__partyRole",
        "availableInventory__availableInventoryRecord"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SecurityLocate",
      "all_of": [
        {
          "description": "RequestOneSecurityMinimum: A locate must request the availability of at least one security.",
          "slot_conditions": [
            {
              "name": "availableInventoryRecord",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditLimitInformation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditLimitInformation",
      "description": "A class to represent the credit limit utilisation information.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "creditLimitInformation__limitApplicable"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "limitApplicable",
          "range": "LimitApplicableExtended",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditLimitInformation",
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditLimitUtilisation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditLimitUtilisation",
      "description": "Credit limit utilisation breakdown by executed trades and pending orders.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "creditLimitUtilisation__executed",
        "creditLimitUtilisation__pending"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "executed",
          "description": "Credit limit utilisation attributable to executed trades.",
          "range": "CreditLimitUtilisationPosition",
          "@type": "SlotDefinition"
        },
        {
          "name": "pending",
          "description": "Credit limit utilisation attributable to pending unexecuted orders.",
          "range": "CreditLimitUtilisationPosition",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditLimitUtilisation",
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditLimitUtilisationPosition",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditLimitUtilisationPosition",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "creditLimitUtilisationPosition__shortPosition",
        "creditLimitUtilisationPosition__longPosition",
        "creditLimitUtilisationPosition__global"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "shortPosition",
          "description": "Credit limit utilisation attributable to short positions.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "longPosition",
          "description": "Credit limit utilisation attributable to long positions.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "global",
          "description": "Global credit limit utilisation amount, agnostic of long/short position direction.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditLimitUtilisationPosition",
      "@type": "ClassDefinition"
    },
    {
      "name": "CustomisedWorkflow",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CustomisedWorkflow",
      "description": "In its initial iteration, this class is meant to support the DTCC TIW workflow information.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "customisedWorkflow__itemName",
        "customisedWorkflow__itemValue"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "itemName",
          "description": "In this initial iteration, this corresponds to the DTCC TIW element name.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "itemValue",
          "description": "In this initial iteration, this corresponds to the DTCC value.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CustomisedWorkflow",
      "@type": "ClassDefinition"
    },
    {
      "name": "EventInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EventInstruction",
      "description": "Specifies instructions to create a BusinessEvent.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "eventInstruction__intent",
        "eventInstruction__corporateActionIntent",
        "eventInstruction__eventDate",
        "eventInstruction__eventTime",
        "eventInstruction__effectiveDate",
        "eventInstruction__effectiveTime",
        "eventInstruction__packageInformation",
        "eventInstruction__instruction"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "intent",
          "description": "The intent attribute is meant to be specified when the event qualification cannot be programmatically inferred from the event features. As a result it is only associated with those primitives that can give way to such ambiguity, the quantityChange being one of those. An example of such is a reduction in the trade notional, which could be interpreted as either a trade correction (unless a maximum period of time post-event is specified as part of the qualification), a partial termination or a portfolio rebalancing in the case of an equity swap. On the other hand, an event such as the exercise is not expected to have an associated intent as there should not be ambiguity.",
          "range": "EventIntentEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "corporateActionIntent",
          "range": "CorporateActionTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "eventDate",
          "description": "Specifies the date on which the event is taking place. This date is equal to the trade date in the case of a simple execution. However it can be different from the trade date, for example in the case of a partial termination.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "eventTime",
          "description": "The time and zone of the date in which the event is taking place.",
          "range": "TimeZone",
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "The date on which the event contractually takes effect, when different from the event date.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveTime",
          "description": "The time and zone of the date in which the event contractually takes effect.",
          "range": "TimeZone",
          "@type": "SlotDefinition"
        },
        {
          "name": "packageInformation",
          "description": "Specifies the package information in case the business event represents several trades executed as a package (hence this attribute is optional). The package information is only instantiated once at the business event level to preserve referential integrity, whereas individual trades make reference to it to identify that they are part of a package.",
          "range": "IdentifiedList",
          "@type": "SlotDefinition"
        },
        {
          "name": "instruction",
          "description": "Specifies the instructions to create the Business Event.",
          "range": "Instruction",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EventInstruction",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "corporateActionIntent",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "intent",
                "value_presence": "PRESENT",
                "equals_string": "CorporateActionAdjustment",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CorporateAction",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "EventTimestamp",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EventTimestamp",
      "description": "A class to represent the various set of timestamps that can be associated with lifecycle events, as a collection of [dateTime, qualifier].",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "eventTimestamp__dateTime",
        "eventTimestamp__qualification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dateTime",
          "description": "The CDM specifies that the zoned date time is to be expressed in accordance with ISO 8601, either as UTC as an offset to UTC.",
          "range": "datetime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "qualification",
          "description": "The timestamp qualifier is specified through an enumeration because the experience of integrating the DTCC and CME data representations suggests that a wide set of timestamps are currently utilized among service providers, while there is not at present an objective set of criteria that could help suggest a defined set of timestamps as part of the CDM. At some future point, one possible baseline could be developed from the review of the set of timestamps specified across regulatory regimes and regulations (incl. regulations such as high frequency trading). Also, the integration with a further set of implementations and the specification of business workflows such as clearing as part of the CDM development should help confirm the implementation approach in this respect.",
          "range": "EventTimestampQualificationEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EventTimestamp",
      "@type": "ClassDefinition"
    },
    {
      "name": "LimitApplicable",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LimitApplicable",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "limitApplicable__limitType",
        "limitApplicable__clipSize",
        "limitApplicable__amountUtilized",
        "limitApplicable__utilization",
        "limitApplicable__amountRemaining",
        "limitApplicable__currency",
        "limitApplicable__velocity"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "limitType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Standard code to indicate which type of credit line is being referred to - i.e. IM, DV01, PV01, CS01, Notional, Clip Size, Notional, maximumOrderQuantity.",
          "range": "CreditLimitTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "clipSize",
          "description": "This element is required in FpML, optional in CDM for the purpose of accommodating the CME data representation while making reference to the FpML one.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "amountUtilized",
          "description": "The limit utilised by all the cleared trades for the limit level and limit type. While the attribute is of type integer in FpML and the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "utilization",
          "range": "CreditLimitUtilisation",
          "@type": "SlotDefinition"
        },
        {
          "name": "amountRemaining",
          "description": "The limit remaining for the limit level and limit type. This does not take into account any pending trades. While the attribute is of type integer in FpML and the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The currency in which the applicable limit is denominated. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "velocity",
          "range": "Velocity",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LimitApplicable",
      "all_of": [
        {
          "description": "LimitApplicableChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "amountUtilized",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "utilization",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "amountUtilized",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "utilization",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "LimitApplicableExtended",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended",
      "description": "A class to represent the CDM attributes that are not part of the FpML standard. Once broader usage is confirmed, it is expected that those two classes can be collapsed.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "is_a": "LimitApplicable",
      "slots": [
        "limitApplicable__limitType",
        "limitApplicable__clipSize",
        "limitApplicable__amountUtilized",
        "limitApplicable__utilization",
        "limitApplicable__amountRemaining",
        "limitApplicable__currency",
        "limitApplicable__velocity",
        "limitApplicableExtended__limitLevel",
        "limitApplicableExtended__limitAmount",
        "limitApplicableExtended__limitImpactDueToTrade"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "limitLevel",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The level at which the limit is set: customer business, proprietary business or account level. This attribute is specified as a string as part of the CME clearing confirmation specification.",
          "range": "LimitLevelEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "limitAmount",
          "description": "The total limit available for the limit level and limit type. While the attribute is of type integer in the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "limitImpactDueToTrade",
          "description": "The limit utilized by this specific trade. While the attribute is of type integer in the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended",
      "all_of": [
        {
          "description": "From LimitApplicable. LimitApplicableChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "amountUtilized",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "utilization",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "amountUtilized",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "utilization",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "MessageInformation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MessageInformation",
      "description": "This class corresponds to the components of the FpML MessageHeader.model.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "messageInformation__messageId",
        "messageInformation__sentBy",
        "messageInformation__sentTo",
        "messageInformation__copyTo"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "messageId",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "A unique identifier assigned to the message.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "sentBy",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The identifier for the originator of a message instance.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "sentTo",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The identifier(s) for the recipient(s) of a message instance.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "copyTo",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "A unique identifier (within the specified coding scheme) giving the details of some party to whom a copy of this message will be sent for reference.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/MessageInformation",
      "@type": "ClassDefinition"
    },
    {
      "name": "PartyCustomisedWorkflow",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PartyCustomisedWorkflow",
      "description": "A class to specify a party-related, non-standardized data in a generic form.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow",
      "slots": [
        "partyCustomisedWorkflow__partyReference",
        "partyCustomisedWorkflow__partyName",
        "partyCustomisedWorkflow__customisedWorkflow"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "partyReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Reference to the party to which the workflow pertains to.",
          "range": "Party",
          "@type": "SlotDefinition"
        },
        {
          "name": "partyName",
          "description": "The party name to which the workflow pertains to.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "customisedWorkflow",
          "description": "Non-standardized data in a generic form.",
          "range": "CustomisedWorkflow",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PartyCustomisedWorkflow",
      "all_of": [
        {
          "description": "PartyCustomisedWorkflowChoice: The identification of the party to which the PartyCustomisedWorkflow pertains to can be done through either a party reference or the party name.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "partyName",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "partyReference",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Velocity",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Velocity",
