        "floatingRateProcessingParameters__treatment",
        "floatingRateProcessingParameters__capRate",
        "floatingRateProcessingParameters__floorRate",
        "floatingRateProcessingParameters__rounding",
        "floatingRateProcessingParameters__negativeTreatment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "initialRate",
          "description": "The rate to be applied for the initial period.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "multiplier",
          "description": "floating rate multiplier.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "spread",
          "description": "spread to be added to the floating rate.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "treatment",
          "description": "US rate treatment (Bond Equivalent Yield or Money Market Yield, if applicable.",
          "range": "RateTreatmentEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "capRate",
          "description": "capt to be applied to the floating rate.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "floorRate",
          "description": "floor to be applied to the floating rate.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "rounding",
          "description": "THe final rate rounding to be applied.",
          "range": "Rounding",
          "@type": "SlotDefinition"
        },
        {
          "name": "negativeTreatment",
          "description": "How to handle negative interest rates.",
          "range": "NegativeInterestRateTreatmentEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateProcessingParameters",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRateSettingDetails",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateSettingDetails",
      "description": "Type for reporting the raw (untreated) observed or calculated rate for a calculation period. If this is a calculated rate, it allows details of the observations and the resulting rate to be returned.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset_floatingrate",
