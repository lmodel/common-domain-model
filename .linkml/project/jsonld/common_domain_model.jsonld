    {
      "name": "deliveryDateParameters__deliveryDate",
      "description": "Specifies the specific contract date for the contract that should be referenced for a price.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slot_uri": "https://w3id.org/lmodel/common-domain-model/deliveryDate",
