    {
      "name": "SettlementProvision",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SettlementProvision",
      "description": "Defines parameters that regulate a settlement, for instance whether this settlement should be netted with other ones or broken-down into smaller amounts.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "slots": [
        "settlementProvision__shapingProvisions"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "shapingProvisions",
          "description": "Defines the parameters that are necessary to 'shape' a settlement, i.e. break it down into smaller amounts.",
          "range": "ShapingProvision",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SettlementProvision",
      "@type": "ClassDefinition"
    },
    {
      "name": "SettlementTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SettlementTerms",
      "description": "Specifies the settlement terms, which can either be cash, physical, or fx-based cash-settlement. This class can be used for the settlement of options and forwards, cash transactions (e.g. securities or foreign exchange), or in case of credit event.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement",
      "is_a": "SettlementBase",
      "slots": [
        "settlementBase__settlementType",
        "settlementBase__transferSettlementType",
        "settlementBase__settlementCurrency",
        "settlementBase__settlementDate",
        "settlementBase__settlementCentre",
        "settlementBase__settlementProvision",
        "settlementBase__standardSettlementStyle",
        "settlementBase__securitySettlementCentre",
        "settlementBase__cashSettlementCentre",
        "settlementTerms__cashSettlementTerms",
        "settlementTerms__physicalSettlementTerms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "cashSettlementTerms",
          "description": "Specifies the parameters associated with the cash settlement procedure.",
          "range": "CashSettlementTerms",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "physicalSettlementTerms",
          "description": "Specifies the physical settlement terms which apply to the transaction.",
          "range": "PhysicalSettlementTerms",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/SettlementTerms",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "cashSettlementTerms",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "physicalSettlementTerms",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "settlementType",
                    "equals_string": "Election",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "settlementType",
                    "equals_string": "CashOrPhysical",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "OptionSettlementChoice: The option settlement cannot combine both physical and cash terms specification.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "cashSettlementTerms",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "settlementType",
                    "value_presence": "PRESENT",
                    "equals_string": "Physical",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CashSettlementTerms: If the cash settlement terms are specified, then the settlementType can either be Cash, Election or CashOrPhysical",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "physicalSettlementTerms",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "none_of": [
              {
                "slot_conditions": [
                  {
                    "name": "settlementType",
                    "value_presence": "PRESENT",
                    "equals_string": "Cash",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PhysicalSettlementTerms: If the physical settlement terms are specified, then the settlementType can either be Physical, Election or CashOrPhysical",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
