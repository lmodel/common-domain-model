    {
      "name": "ConstituentWeight",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ConstituentWeight",
      "description": "A class describing the weight of each of the underlier constituent within the basket, either in absolute or relative terms.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "constituentWeight__openUnits",
        "constituentWeight__basketPercentage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "openUnits",
          "description": "The number of units (index or securities) that constitute the underlier of the swap. In the case of a basket swap, this element is used to reference both the number of basket units, and the number of each asset components of the basket when these are expressed in absolute terms.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "basketPercentage",
          "description": "The relative weight of each respective basket constituent, expressed in percentage. A basket percentage of 5% would be represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ConstituentWeight",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "basketPercentage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "all_of": [
              {
                "slot_conditions": [
                  {
                    "name": "basketPercentage",
                    "minimum_value": 0,
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "basketPercentage",
                    "maximum_value": 1,
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "BasketPercentage: FpML specifies basketPercentage as a RestrictedPercentage type, meaning that the value needs to be comprised between 0 and 1.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "DividendTerms",
