    {
      "name": "QuantitySchedule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/QuantitySchedule",
      "description": "Specifies a quantity schedule to be associated to a financial product to represent a trade amount. This data type extends MeasureBase with several unit or multiplier attributes that are used to define financial quantities. This data type is generically based on a schedule and can also be used to represent a quantity as a single value.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "is_a": "MeasureBase",
      "slots": [
        "schedule__value",
        "schedule__datedValue",
        "quantitySchedule__multiplier",
        "quantitySchedule__frequency",
        "quantitySchedule__total",
        "QuantitySchedule_unit"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "multiplier",
          "description": "Defines an optional measure that the quantity should be multiplied by to derive a total quantity. Requires that the multiplier must be positive. This number is associated to an optional unit. For example in the case of the Coal (API2) CIF ARA (ARGUS-McCloskey) Futures Contract on the CME, where the unit would be contracts, the multiplier value would 1,000 and the mulitiplier unit would be 1,000 MT (Metric Tons).",
          "range": "NonNegativeMeasure",
          "@type": "SlotDefinition"
        },
        {
          "name": "frequency",
          "description": "Defines the frequency to be used when defining a quantity. For example a quantity may be specified as a number of barrels of oil per day, which needs multiplying by the number of days in the relevant period to get the total quantity as a number of barrels.",
          "range": "Frequency",
          "@type": "SlotDefinition"
        },
        {
          "name": "total",
          "description": "Specifies the total quantity when the quantity itself is specified with a frequency.",
          "range": "Schedule",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/QuantitySchedule",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "total",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "frequency",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "TotalQuantity: A total quantity must only be specified when the frequency exists.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "From Schedule. ValueExists: A schedule may be specified as a single value or as a set of date-value pairs. Both attributes may be specified, in which case the single amount number is the initial value.",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "value",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "datedValue",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Rounding",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Rounding",
      "description": "Defines rounding rules and precision to be used in the rounding of a number.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "slots": [
        "rounding__roundingDirection",
        "rounding__precision"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "roundingDirection",
          "description": "Specifies the rounding rule as up, down, or nearest.",
          "range": "RoundingDirectionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "precision",
          "description": "Specifies the rounding precision in terms of a number of decimal places when the number is evaluated in decimal form (not percentage), e.g. 0.09876543 rounded to the nearest 5 decimal places is 0.0987654.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Rounding",
      "@type": "ClassDefinition"
    },
    {
      "name": "Schedule",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Schedule",
      "description": "Specifies an amount or quantity, either as a single value or as a schedule of dated values. This can be used where the applicable quantity changes over time, with each dated value becoming effective from its associated step date.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_math",
      "slots": [
        "schedule__value",
        "schedule__datedValue"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "value",
          "description": "The initial rate or amount, as the case may be. An initial rate of 5% would be represented as 0.05.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "datedValue",
          "description": "The schedule of step date and value pairs. On each step date the associated step value becomes effective. A list of steps may be ordered in the document by ascending step date. An FpML document containing an unordered list of steps is still regarded as a conformant document.",
          "range": "DatedValue",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Schedule",
