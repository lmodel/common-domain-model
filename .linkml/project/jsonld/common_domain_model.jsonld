    {
      "name": "Asset",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Asset",
      "annotations": [
        {
          "tag": "rosetta_choice",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "An Asset is defined as something that can be owned and transferred in the financial markets. As a choice data type, one and only one of the attributes must be used.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
