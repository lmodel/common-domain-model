          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "isFirstPeriod",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "isLastPeriod",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculationPeriodData",
      "@type": "ClassDefinition"
    },
    {
      "name": "CalculationPeriodDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A data for: defining the parameters used to generate the calculation period dates schedule, including the specification of any initial or final stub calculation periods. A calculation period schedule consists of an optional initial stub calculation period, one or more regular calculation periods and an optional final stub calculation period. In the absence of any initial or final stub calculation periods, the regular part of the calculation period schedule is assumed to be between the effective date and the termination date. No implicit stubs are allowed, i.e. stubs must be explicitly specified using an appropriate combination of firstPeriodStartDate, firstRegularPeriodStartDate and lastRegularPeriodEndDate.",
      "comments": [
        "Rosetta condition FpML_ird_16 is not stated in LinkML: if firstRegularPeriodStartDate exists then terminationDate -> adjustableDate -> unadjustedDate > firstRegularPeriodStartDate",
        "Rosetta condition FpML_ird_17 is not stated in LinkML: if lastRegularPeriodEndDate exists then terminationDate -> adjustableDate -> unadjustedDate > lastRegularPeriodEndDate",
        "Rosetta condition FpML_ird_18 is not stated in LinkML: if firstRegularPeriodStartDate exists and lastRegularPeriodEndDate exists then lastRegularPeriodEndDate > firstRegularPeriodStartDate",
        "Rosetta condition FpML_ird_20 is not stated in LinkML: if lastRegularPeriodEndDate exists then lastRegularPeriodEndDate > effectiveDate -> adjustableDate -> unadjustedDate",
        "Rosetta condition FpML_ird_21 is not stated in LinkML: if firstPeriodStartDate exists and effectiveDate exists then firstPeriodStartDate -> adjustableDate -> unadjustedDate < effectiveDate -> adjustableDate -> unadjustedDate",
        "Rosetta condition FpML_ird_22 is not stated in LinkML: if firstPeriodStartDate exists and firstRegularPeriodStartDate exists then firstPeriodStartDate -> adjustableDate -> unadjustedDate < firstRegularPeriodStartDate"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "calculationPeriodDates__effectiveDate",
        "calculationPeriodDates__terminationDate",
        "calculationPeriodDates__calculationPeriodDatesAdjustments",
        "calculationPeriodDates__firstPeriodStartDate",
        "calculationPeriodDates__firstRegularPeriodStartDate",
        "calculationPeriodDates__firstCompoundingPeriodEndDate",
        "calculationPeriodDates__lastRegularPeriodEndDate",
        "calculationPeriodDates__stubPeriodType",
        "calculationPeriodDates__calculationPeriodFrequency"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "effectiveDate",
          "description": "The first day of the terms of the trade. This day may be subject to adjustment in accordance with a business day convention.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "terminationDate",
          "description": "The last day of the terms of the trade. This date may be subject to adjustments in accordance with the business day convention. It can also be specified in relation to another scheduled date (e.g. the last payment date).",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriodDatesAdjustments",
          "description": "The specification of the business day convention and financial business centers used for adjusting any calculation period date if it would otherwise fall on a day that is not a business day in the specified business center.",
          "range": "BusinessDayAdjustments",
          "@type": "SlotDefinition"
        },
        {
          "name": "firstPeriodStartDate",
          "description": "The start date of the calculation period. FpML specifies that for interest rate swaps this date must only be specified if it is not equal to the effective date. It is always specified in the case of equity swaps and credit default swaps with periodic payments. This date may be subject to adjustment in accordance with a business day convention.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "firstRegularPeriodStartDate",
          "description": "The start date of the regular part of the calculation period schedule. It must only be specified if there is an initial stub calculation period. This day may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "firstCompoundingPeriodEndDate",
          "description": "The end date of the initial compounding period when compounding is applicable. It must only be specified when the compoundingMethod element is present and not equal to a value of None. This date may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "lastRegularPeriodEndDate",
          "description": "The end date of the regular part of the calculation period schedule. It must only be specified if there is a final stub calculation period. This day may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "stubPeriodType",
          "description": "Method to allocate any irregular period remaining after regular periods have been allocated between the effective and termination date. The multiplicity of 2 allows the possibility of expressing the type for both an initial and final stub at the same time.",
          "range": "StubPeriodTypeEnum",
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriodFrequency",
          "description": "The frequency at which calculation period end dates occur with the regular part of the calculation period schedule and their roll date convention.",
          "range": "CalculationPeriodFrequency",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates",
      "@type": "ClassDefinition"
    },
    {
      "name": "DateRelativeToCalculationPeriodDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DateRelativeToCalculationPeriodDates",
      "description": "A data to: provide the ability to point to multiple payment nodes in the document through the unbounded paymentDatesReference.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule",
      "slots": [
        "dateRelativeToCalculationPeriodDates__calculationPeriodDatesReference"
      ],
      "slot_usage": {},
