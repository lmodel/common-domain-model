          "name": "mapsTo",
          "description": "The successor FRO that this index maps to.",
          "range": "FloatingRateIndexMap",
          "@type": "SlotDefinition"
        },
        {
          "name": "mapsFrom",
          "description": "The predecessor FRO(s) that this index maps to.",
          "range": "FloatingRateIndexMap",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexMappings",
      "@type": "ClassDefinition"
    },
    {
      "name": "FroHistory",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FroHistory",
      "description": "FRO History",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro",
      "slots": [
        "FroHistory_startDate",
        "FroHistory_endDate",
        "froHistory__firstDefinedIn",
        "froHistory__updateDate",
        "froHistory__lastUpdatedIn"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "firstDefinedIn",
          "description": "The supplement or version the FRO was first added to the 2006 Definitions or 2021 Floating Rate Matrix. (e.g. S52)",
          "range": "ContractualDefinition",
          "@type": "SlotDefinition"
        },
        {
          "name": "updateDate",
          "description": "The date the Floating Rate Option was last updated in the 2006 Definitions or 2021 Floating Rate Matrix. (e.g. 2021/06/11)",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "lastUpdatedIn",
          "description": "The supplement or version the FRO was last updated in the 2006 Definitions or 2021 Floating Rate Matrix. (e.g. FRO-M-V1)",
          "range": "ContractualDefinition",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FroHistory",
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditEventNotice",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditEventNotice",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "creditEventNotice__notifyingParty",
        "creditEventNotice__businessCenter",
        "creditEventNotice__publiclyAvailableInformation"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "notifyingParty",
          "description": "The notifying party is the party that notifies the other party when a credit event has occurred by means of a credit event notice. If more than one party is referenced as being the notifying party then either party may notify the other of a credit event occurring. ISDA 2003 Term: Notifying Party.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "multivalued": true,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCenter",
          "description": "Inclusion of this business center element implies that Greenwich Mean Time in Section 3.3 of the 2003 ISDA Credit Derivatives Definitions is replaced by the local time of the city indicated by the businessCenter element value.",
          "range": "BusinessCenter",
          "@type": "SlotDefinition"
        },
        {
          "name": "publiclyAvailableInformation",
          "description": "A specified condition to settlement. Publicly available information means information that reasonably confirms any of the facts relevant to determining that a credit event or potential repudiation/moratorium, as applicable, has occurred. The ISDA defined list (2003) is the market standard and is considered comprehensive, and a minimum of two differing public sources must have published the relevant information, to declare a Credit Event. ISDA 2003 Term: Notice of Publicly Available Information Applicable.",
          "range": "PubliclyAvailableInformation",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditEventNotice",
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditEvents",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditEvents",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify the applicable Credit Events that would trigger a settlement, as specified in the related Confirmation and defined in the ISDA 2014 Credit Definition article IV section 4.1.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "creditEvents__bankruptcy",
        "creditEvents__failureToPay",
        "creditEvents__failureToPayPrincipal",
        "creditEvents__failureToPayInterest",
        "creditEvents__obligationDefault",
        "creditEvents__obligationAcceleration",
        "creditEvents__repudiationMoratorium",
        "creditEvents__restructuring",
        "creditEvents__governmentalIntervention",
        "creditEvents__distressedRatingsDowngrade",
        "creditEvents__maturityExtension",
        "creditEvents__writedown",
        "creditEvents__impliedWritedown",
        "creditEvents__defaultRequirement",
        "creditEvents__creditEventNotice"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "bankruptcy",
          "description": "A credit event. The reference entity has been dissolved or has become insolvent. It also covers events that may be a precursor to insolvency such as instigation of bankruptcy or insolvency proceedings. Sovereign trades are not subject to Bankruptcy as 'technically' a Sovereign cannot become bankrupt. ISDA 2003 Term: Bankruptcy.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "failureToPay",
          "description": "A credit event. This credit event triggers, after the expiration of any applicable grace period, if the reference entity fails to make due payments in an aggregate amount of not less than the payment requirement on one or more obligations (e.g. a missed coupon payment). ISDA 2003 Term: Failure to Pay.",
          "range": "FailureToPay",
          "@type": "SlotDefinition"
        },
        {
          "name": "failureToPayPrincipal",
          "description": "A credit event. Corresponds to the failure by the Reference Entity to pay an expected principal amount or the payment of an actual principal amount that is less than the expected principal amount. ISDA 2003 Term: Failure to Pay Principal.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "failureToPayInterest",
          "description": "A credit event. Corresponds to the failure by the Reference Entity to pay an expected interest amount or the payment of an actual interest amount that is less than the expected interest amount. ISDA 2003 Term: Failure to Pay Interest.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "obligationDefault",
          "description": "A credit event. One or more of the obligations have become capable of being declared due and payable before they would otherwise have been due and payable as a result of, or on the basis of, the occurrence of a default, event of default or other similar condition or event other than failure to pay. ISDA 2003 Term: Obligation Default.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "obligationAcceleration",
          "description": "A credit event. One or more of the obligations have been declared due and payable before they would otherwise have been due and payable as a result of, or on the basis of, the occurrence of a default, event of default or other similar condition or event other than failure to pay (preferred by the market over Obligation Default, because more definitive and encompasses the definition of Obligation Default - this is more favorable to the Seller). Subject to the default requirement amount. ISDA 2003 Term: Obligation Acceleration.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "repudiationMoratorium",
          "description": "A credit event. The reference entity, or a governmental authority, either refuses to recognise or challenges the validity of one or more obligations of the reference entity, or imposes a moratorium thereby postponing payments on one or more of the obligations of the reference entity. Subject to the default requirement amount. ISDA 2003 Term: Repudiation/Moratorium.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "restructuring",
          "description": "A credit event. A restructuring is an event that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2003 Term: Restructuring.",
          "range": "Restructuring",
          "@type": "SlotDefinition"
        },
        {
          "name": "governmentalIntervention",
          "description": "A credit event. A governmental intervention is an event resulting from an action by a governmental authority that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2014 Term: Governmental Intervention.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "distressedRatingsDowngrade",
          "description": "A credit event. Results from the fact that the rating of the reference obligation is down-graded to a distressed rating level. From a usage standpoint, this credit event is typically not applicable in case of RMBS trades.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "maturityExtension",
          "description": "A credit event. Results from the fact that the underlier fails to make principal payments as expected.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "writedown",
          "description": "A credit event. Results from the fact that the underlier writes down its outstanding principal amount.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "impliedWritedown",
          "description": "A credit event. Results from the fact that losses occur to the underlying instruments that do not result in reductions of the outstanding principal of the reference obligation.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "defaultRequirement",
          "description": "In relation to certain credit events, serves as a threshold for Obligation Acceleration, Obligation Default, Repudiation/Moratorium and Restructuring. Market standard is USD 10,000,000 (JPY 1,000,000,000 for all Japanese Yen trades). This is applied on an aggregate or total basis across all Obligations of the Reference Entity. Used to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Default Requirement.",
          "range": "Money",
          "@type": "SlotDefinition"
        },
        {
          "name": "creditEventNotice",
          "description": "A specified condition to settlement. An irrevocable written or verbal notice that describes a credit event that has occurred. The notice is sent from the notifying party (either the buyer or the seller) to the counterparty. It provides information relevant to determining that a credit event has occurred. This is typically accompanied by Publicly Available Information. ISDA 2003 Term: Credit Event Notice.",
          "range": "CreditEventNotice",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditEvents",
      "@type": "ClassDefinition"
    },
    {
      "name": "DeterminationMethodology",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DeterminationMethodology",
      "description": "Specifies the method according to which an amount or a date is determined.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "determinationMethodology__determinationMethod",
        "determinationMethodology__averagingMethod"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "determinationMethod",
          "description": "Represents a more granular dimention of observation. Typically relevent for resolving a unique equity price, which can be expressed as trade-weighted or volume-weighted averages.",
          "range": "DeterminationMethodEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "averagingMethod",
          "description": "Specifies enumerations for the type of averaging calculation.",
          "range": "AveragingCalculationMethodEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DeterminationMethodology",
      "@type": "ClassDefinition"
    },
    {
      "name": "FailureToPay",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FailureToPay",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "failureToPay__applicable",
        "failureToPay__gracePeriodExtension",
        "failureToPay__paymentRequirement"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicable",
          "description": "Indicates whether the failure to pay provision is applicable.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gracePeriodExtension",
          "description": "If this element is specified, indicates whether or not a grace period extension is applicable. ISDA 2003 Term: Grace Period Extension Applicable.",
          "range": "GracePeriodExtension",
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentRequirement",
          "description": "Specifies a threshold for the failure to pay credit event. Market standard is USD 1,000,000 (JPY 100,000,000 for Japanese Yen trades) or its equivalent in the relevant obligation currency. This is applied on an aggregate basis across all Obligations of the Reference Entity. Intended to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Payment Requirement",
          "range": "Money",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FailureToPay",
      "@type": "ClassDefinition"
    },
    {
      "name": "FeaturePayment",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FeaturePayment",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Payment made following trigger occurrence.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "featurePayment__payerReceiver",
        "featurePayment__levelPercentage",
        "featurePayment__amount",
        "featurePayment__time",
        "featurePayment__currency",
        "featurePayment__paymentDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "payerReceiver",
          "description": "This attribute doesn't exist as part of the FpML construct, which makes use of the PayerReceiver.model group.",
          "range": "PartyReferencePayerReceiver",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "levelPercentage",
          "description": "The trigger level percentage.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "amount",
          "description": "The monetary quantity in currency units.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "time",
          "description": "The feature payment time.",
          "range": "TimeTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "currency",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The currency in which an amount is denominated.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "paymentDate",
          "description": "The feature payment date.",
          "range": "AdjustableOrRelativeDate",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FeaturePayment",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "amount",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "amount",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Amount: The amount attribute is specified in FpML as non-negative decimal.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "FeaturePaymentChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "levelPercentage",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "amount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "GracePeriodExtension",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/GracePeriodExtension",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "gracePeriodExtension__applicable",
        "gracePeriodExtension__gracePeriod"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicable",
          "description": "Indicates whether the grace period extension provision is applicable.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "gracePeriod",
          "description": "The number of calendar or business days after any due date that the reference entity has to fulfil its obligations before a failure to pay credit event is deemed to have occurred. ISDA 2003 Term: Grace Period.",
          "range": "Offset",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/GracePeriodExtension",
      "@type": "ClassDefinition"
    },
    {
      "name": "Observation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Observation",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Defines a single, numerical value that was observed in the marketplace. Observations of market data are made independently to business events or trade life-cycle events, so data instances of Observation can be created independently of any other model type, hence it is annotated as a root type. Observations will be broadly reused in many situations, so references to Observation are supported via the 'key' annotation.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "observation__observedValue",
        "observation__observationIdentifier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "observedValue",
          "description": "Specifies the observed value as a number.",
          "range": "Price",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "observationIdentifier",
          "description": "Represents the observation was made i.e. how to uniquely identify the observed value among the population of all available market data.",
          "range": "ObservationIdentifier",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Observation",
      "@type": "ClassDefinition"
    },
    {
      "name": "ObservationIdentifier",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ObservationIdentifier",
      "description": "Defines the parameters needed to uniquely identify a piece of data among the population of all available market data.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "observationIdentifier__observable",
        "observationIdentifier__observationDate",
        "observationIdentifier__observationTime",
        "observationIdentifier__informationSource",
        "observationIdentifier__determinationMethodology"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "observable",
          "description": "Represents the asset or rate to which the observation relates.",
          "range": "Observable",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "observationDate",
          "description": "Specifies the date value to use when resolving the market data.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "observationTime",
          "description": "Represents the time and time-zone.",
          "range": "TimeZone",
          "@type": "SlotDefinition"
        },
        {
          "name": "informationSource",
          "description": "Represents where the market data published and should be observed.",
          "range": "InformationSource",
          "@type": "SlotDefinition"
        },
        {
          "name": "determinationMethodology",
          "description": "Specifies the method according to which an amount or a date is determined.",
          "range": "DeterminationMethodology",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ObservationIdentifier",
      "@type": "ClassDefinition"
    },
    {
      "name": "PubliclyAvailableInformation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PubliclyAvailableInformation",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "publiclyAvailableInformation__standardPublicSources",
        "publiclyAvailableInformation__publicSource",
        "publiclyAvailableInformation__specifiedNumber"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "standardPublicSources",
          "description": "If this element is specified and set to 'true', indicates that ISDA defined Standard Public Sources are applicable.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "publicSource",
          "description": "A public information source, e.g. a particular newspaper or electronic news service, that may publish relevant information used in the determination of whether or not a credit event has occurred. ISDA 2003 Term: Public Source.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "specifiedNumber",
          "description": "The minimum number of the specified public information sources that must publish information that reasonably confirms that a credit event has occurred. The market convention is two. ISDA 2003 Term: Specified Number.",
          "range": "integer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PubliclyAvailableInformation",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "specifiedNumber",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "specifiedNumber",
                "minimum_value": 0,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PositiveSpecifiedNumber: FpML specifies specifiedNumber as a positiveInteger.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "SourceChoice: FpML validation rule cd-36 - Context: PubliclyAvailableInformation (complex type). Either standardPublicSources or at least one publicSource element must exist.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "standardPublicSources",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "publicSource",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Restructuring",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Restructuring",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_event",
      "slots": [
        "restructuring__applicable",
        "restructuring__restructuringType",
        "restructuring__multipleHolderObligation",
        "restructuring__multipleCreditEventNotices"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "applicable",
          "description": "Indicates whether the restructuring provision is applicable.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "restructuringType",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the type of restructuring that is applicable.",
          "range": "RestructuringEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "multipleHolderObligation",
          "description": "In relation to a restructuring credit event, unless multiple holder obligation is not specified restructurings are limited to multiple holder obligations. A multiple holder obligation means an obligation that is held by more than three holders that are not affiliates of each other and where at least two thirds of the holders must agree to the event that constitutes the restructuring credit event. ISDA 2003 Term: Multiple Holder Obligation.",
          "range": "boolean",
          "@type": "SlotDefinition"
        },
        {
          "name": "multipleCreditEventNotices",
          "description": "Presence of this element and value set to 'true' indicates that Section 3.9 of the 2003 Credit Derivatives Definitions shall apply. Absence of this element indicates that Section 3.9 shall not apply. NOTE: Not allowed under ISDA Credit 1999.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Restructuring",
      "@type": "ClassDefinition"
    },
    {
      "name": "Trigger",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Trigger",
      "description": "Trigger point at which feature is effective.",
