    {
      "name": "HoldingAndUsingPostedCollateral",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/HoldingAndUsingPostedCollateral",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_VM_2016 paragraph 13 clause  (h) name Holding and Using Posted Collateral (VM) | ISDA CSA_NewYork_1994 paragraph 13 clause (g) | ISDA CSD_English_1995 paragraph 13 clause (h)",
          "@type": "Annotation"
        }
      ],
      "description": "Specifies the conditions that need to be satisfied before the Secured Party or Custodian acting on its behalf can hold and use posted collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "holdingAndUsingPostedCollateral__partyElection",
        "holdingAndUsingPostedCollateral__additionalLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "partyElection",
          "description": "The parties' elections for the holding and using of posted collateral.",
          "range": "HoldingAndUsingPostedCollateralElection",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "additionalLanguage",
          "description": "The additional language that might be specified by the parties to the legal agreement.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/HoldingAndUsingPostedCollateral",
      "@type": "ClassDefinition"
    },
    {
      "name": "HoldingAndUsingPostedCollateralElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/HoldingAndUsingPostedCollateralElection",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_VM_2016 paragraph 13 clause  (h) name Holding and Using Posted Collateral (VM) | ISDA CSA_NewYork_1994 paragraph 13 clause (g) | ISDA CSD_English_1995 paragraph 13 clause (h)",
          "@type": "Annotation"
        }
      ],
      "description": "Specifies the parties' elections related to the holding and using of posted collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "holdingAndUsingPostedCollateralElection__party",
        "holdingAndUsingPostedCollateralElection__eligibilityToHoldCollateral",
        "holdingAndUsingPostedCollateralElection__useOfPostedCollateral"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "party",
          "description": "The party to which the elections apply.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "eligibilityToHoldCollateral",
          "description": "The specification of the conditions under which a party and its custodian(s) are entitled to hold posted collateral.",
          "range": "EligibilityToHoldCollateral",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "useOfPostedCollateral",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ISDA CSA_VM_2016 paragraph 13 clause (h)(ii) name Use of Posted Collateral (VM) | ISDA CSA_NewYork_1994 paragraph 13 clause (g)(ii)",
              "@type": "Annotation"
            }
          ],
          "description": "Indicates whether the party has the right to reuse, rehypothecate, or otherwise make use of the posted collateral. 'True' if the party has the right,'False' if the party does not have the right.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/HoldingAndUsingPostedCollateralElection",
      "@type": "ClassDefinition"
    },
    {
      "name": "IndependentAmountRatings",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings",
      "description": "A logical container designed to hold a set of related data. In this case, designed to hold a set of information required when Independent Amount is determined using credit ratings.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "independentAmountRatings__compare",
        "independentAmountRatings__ratedParty",
        "independentAmountRatings__namedAffiliate",
        "independentAmountRatings__namedEntity",
        "independentAmountRatings__ratingType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "compare",
          "description": "Specifies how multiple credit ratings are compared when determining the applicable Independent Amount, and whether that measure is highest, lowest, or a comparison of either.",
          "range": "IndependentAmountCompareEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "ratedParty",
          "description": "Specifies the party to whom the rating agency rating applies to for the purposes of determining the Independent Amount.",
          "range": "RatedPartyEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "namedAffiliate",
          "description": "Details the Named Affiliate where the Rated Party is Named Affiliate.",
          "range": "LegalEntity",
          "@type": "SlotDefinition"
        },
        {
          "name": "namedEntity",
          "description": "Details the Named Entity where the Rated Party is Named Entity.",
          "range": "LegalEntity",
          "@type": "SlotDefinition"
        },
        {
          "name": "ratingType",
          "description": "The relevant rating type.",
          "range": "RatingTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "compare",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "compare",
                    "equals_string": "Compare",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "compare",
                    "equals_string": "Lowest",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "compare",
                    "equals_string": "Highest",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "RestrictCompare: Restricts allowable values pertaining to how multiple credit ratings are compared when determining the applicable Independent Amount.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "ratedParty",
                "equals_string": "NamedAffiliate",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "namedAffiliate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "elseconditions": {
            "slot_conditions": [
              {
                "name": "namedAffiliate",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NamedAffiliate: Ensures Named Affiliate is provided where the Rated Party is Named Affiliate.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "ratedParty",
                "equals_string": "NamedEntity",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "namedEntity",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "elseconditions": {
            "slot_conditions": [
              {
                "name": "namedEntity",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NamedEntity: Ensures Named Entity is provided where the Rated Party is Named Entity.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
