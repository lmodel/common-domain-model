    {
      "name": "MinimumTransferAmount",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MinimumTransferAmount",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_NewYork_1994 name Minimum Transfer Amount | ISDA CSA_English_1995 name Minimum Transfer Amount | ISDA CSD_English_1995 name Minimum Transfer Amount | ISDA CSA_VM_English_2016 name Minimum Transfer Amount | ISDA CSA_VM_NewYork_2016 name Minimum Transfer Amount",
          "@type": "Annotation"
        }
      ],
      "description": "Represents the threshold specified in the agreement below which collateral need not be delivered, and represents the smallest incremental value of exposure that must be reached before the parties are obliged to transfer collateral.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "minimumTransferAmount__partyElection"
      ],
