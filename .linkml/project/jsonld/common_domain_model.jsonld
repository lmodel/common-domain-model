    {
      "name": "DisputeResolution",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DisputeResolution",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSD_IM_English_2016 paragraph 13 General Principles clause (g) name Dispute Resolution | ISDA CSA_IM_Japanese_2016 paragraph 13 General Principles clause (h) name Dispute Resolution | ISDA CSA_IM_NewYork_2016 paragraph 13 General Principles clause (g) name Dispute Resolution",
          "@type": "Annotation"
        }
      ],
      "description": "A class to specify the election terms under which a party disputes the Value of any Transfer of Eligible Credit Support or Posted Credit Support.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "disputeResolution__resolutionTime",
        "disputeResolution__otherTerms",
        "disputeResolution__alternativeTerms",
        "disputeResolution__recalculationOfValue",
        "disputeResolution__legacyAlternative",
        "disputeResolution__value"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "resolutionTime",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ISDA CSA_IM_2016 paragraph 3 General Principles clause (g)(i) name Resolution Time | ISDA CSA_VM_2016 paragraph 13 clause (g)(i) name Resolution Time",
              "@type": "Annotation"
            }
          ],
          "description": "The time by which the dispute needs to be resolved, failure of which would trigger a recalculation alongside a process that is specified as part of the agreement.",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "otherTerms",
          "description": "The custom Resolution Time election that might be specified by the parties.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "alternativeTerms",
          "description": "The alternative dispute resolution procedure if specified.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "recalculationOfValue",
          "description": "The elections to specify terms for recalculation of the market value of posted collateral.",
          "range": "RecalculationOfValue",
          "@type": "SlotDefinition"
        },
        {
          "name": "legacyAlternative",
          "description": "Alternative procedures to those in the pre-print for resolving collateral related disputes.",
          "range": "LegacyResolutionAlternative",
          "@type": "SlotDefinition"
        },
        {
          "name": "value",
          "description": "Methodology for resolving disputes in respect of the determination of the value of collateral.",
          "range": "ResolutionValue",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DisputeResolution",
      "@type": "ClassDefinition"
    },
    {
      "name": "ElectiveAmountElection",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection",
      "description": "A class to specify the party elective amounts which can be used for the purpose of specifying elections such as the ISDA CSA Threshold and Minimum Transfer Amount.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "electiveAmountElection__party",
        "electiveAmountElection__electiveAmount",
        "electiveAmountElection__amount",
        "electiveAmountElection__customElection"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "party",
          "description": "The elective party.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "electiveAmount",
          "description": "Specifies an enumerated election to express the elective amount.",
          "range": "ElectiveAmountEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "amount",
          "description": "The elective amount when expressed as a currency amount. The associated PartyElectiveAmount_amount data rule enforces that the currency amount is actually greater than 0.",
          "range": "Money",
          "@type": "SlotDefinition"
        },
        {
          "name": "customElection",
          "description": "The elective amount when expressed as a custom election by the party.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "electiveAmount",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "amount",
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "customElection",
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "NonZeroAmount: When the elective amount is not zero either a currency amount or a custom election must exist.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "EligibilityToHoldCollateral",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EligibilityToHoldCollateral",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA CSA_VM_2016 paragraph 13 clause  (h)(i) name Eligibility to Hold Posted Collateral (VM) Custodians (VM)",
          "@type": "Annotation"
        }
      ],
      "description": "Specifies the conditions under which a party and its custodian(s) are entitled to hold collateral.",
      "comments": [
        "Rosetta condition Custodian is not stated in LinkML: if custodianEligibility = True then initialCustodian exists else initialCustodian is absent and custodianCondition is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "eligibilityToHoldCollateral__custodianEligibility",
        "eligibilityToHoldCollateral__initialCustodian",
        "eligibilityToHoldCollateral__criteria",
        "eligibilityToHoldCollateral__eligibleLocation",
        "eligibilityToHoldCollateral__custodianCondition"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "custodianEligibility",
          "description": "Specifies whether the party's custodian is eligible to hold the other party's posted collateral. If 'True' then the custodian is eligible to hold the Posted Collateral given that the specified criteria are met.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "initialCustodian",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ISDA CSA_VM_2016",
              "@type": "Annotation"
            }
          ],
          "description": "Election to specify the initial custodian.",
          "range": "LegalEntity",
          "@type": "SlotDefinition"
        },
        {
          "name": "criteria",
          "description": "A logical container to hold a defined set of related data. In this case the collation of criteria required by the party and its custodian to Hold the other party's Posted Collateral.",
          "range": "EligibilityToHoldCollateralCriteria",
          "@type": "SlotDefinition"
        },
        {
          "name": "eligibleLocation",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The restrictions that might be required by a party and its custodian in terms of country(ies) where the other party's collateral can be held.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "custodianCondition",
          "description": "Specifies any additional conditions relevant to the Custodian of the respective parties as set out in the Holding and Using Posted Collateral clause.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/EligibilityToHoldCollateral",
      "@type": "ClassDefinition"
    },
