    {
      "name": "EquityType",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/EquityType",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "slots": [
        "equityType__equityType",
        "equityType__depositaryReceipt"
