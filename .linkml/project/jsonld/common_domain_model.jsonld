        }
      ],
      "description": "A business event represents a life cycle event of a trade. The combination of the state changes results in a qualifiable life cycle event. An example of a Business Event is a PartialTermination which is a defined by a quantity change primitive event.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "EventInstruction",
      "slots": [
        "eventInstruction__intent",
        "eventInstruction__corporateActionIntent",
        "eventInstruction__eventDate",
        "eventInstruction__eventTime",
        "eventInstruction__effectiveDate",
        "eventInstruction__effectiveTime",
        "eventInstruction__packageInformation",
        "eventInstruction__instruction",
        "businessEvent__eventQualifier",
        "businessEvent__after"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "eventQualifier",
          "description": "The CDM event qualifier, which corresponds to the outcome of the isEvent qualification logic which qualifies the lifecycle event as a function of its features (e.g. PartialTermination, ClearingSubmission, Novation, ...).",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "after",
          "description": "Specifies the after trade state(s) created.",
          "range": "TradeState",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/BusinessEvent",
      "all_of": [
        {
          "description": "EventDate",
          "slot_conditions": [
            {
              "name": "eventDate",
              "value_presence": "PRESENT",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CalculateResetInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculateResetInstruction",
      "description": "Defines the information needed to create a Reset Instruction for the Reset Business Event.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "calculateResetInstruction__payout",
        "calculateResetInstruction__rateRecordDate",
        "calculateResetInstruction__resetDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "payout",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "range": "Payout",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "rateRecordDate",
          "description": "Specifies the 'Rate Record Day' for a Fallback rate. Fallback rate fixing processes typically set the fixing rate in arrears, i.e., the Fallback Rate corresponding to a Rate Record Date is set at the end of the interest accural period. When this applies, Reset->resetDate occurs at the end of the interest period, and the Reset->rateRecordDate occurs near the start of the interest period. The Reset->rateRecordDate and Reset->observations->observationIdentifier->observationDate will differ if a Fallback rate is unavailable on the Rate Record Date, and the latest previous available rate is used as the observation.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "resetDate",
          "description": "Specifies the date on which the reset is occuring.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculateResetInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "CalculateTransferInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculateTransferInstruction",
      "description": "Defines the tradeState or payout on which to create a Transfer along with all necessary resets.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "calculateTransferInstruction__tradeState",
        "calculateTransferInstruction__payout",
        "calculateTransferInstruction__resets",
        "calculateTransferInstruction__payerReceiver",
        "calculateTransferInstruction__quantity",
        "calculateTransferInstruction__date"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "tradeState",
          "range": "TradeState",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "payout",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "range": "Payout",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "resets",
          "range": "Reset",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "payerReceiver",
          "range": "PayerReceiver",
          "@type": "SlotDefinition"
        },
        {
          "name": "quantity",
          "description": "Specifies quantity amount returned if not the full amount from the TradeState, e.g. partial return",
          "range": "Quantity",
          "@type": "SlotDefinition"
        },
        {
          "name": "date",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculateTransferInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "ClearingInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ClearingInstruction",
      "description": "All information required to perform the clear life cycle event; the clearing party (CCP), the two parties facing each other on the alpha contract, and optionally the parties acting as clearing members.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "clearingInstruction__alphaContract",
        "clearingInstruction__clearingParty",
        "clearingInstruction__party1",
        "clearingInstruction__party2",
        "clearingInstruction__clearerParty1",
        "clearingInstruction__clearerParty2",
        "clearingInstruction__isOpenOffer"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "alphaContract",
          "description": "The contract that will be submitted to the clearing house for clearing. The contract should indicate that it should be cleared by assigning a clearing organisation as a party role.",
          "range": "TradeState",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "clearingParty",
          "description": "The Central Counter party (CCP) that the contract will be submitted to for clearing.",
          "range": "Party",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "party1",
          "description": "First party facing the CCP if it is clearing for its own account.",
          "range": "Party",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "party2",
          "description": "Second party facing the CCP if it is clearing for its own account.",
          "range": "Party",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "clearerParty1",
          "description": "Optional party facing the CCP, acting as clearing member for party1.",
          "range": "Party",
          "@type": "SlotDefinition"
        },
        {
          "name": "clearerParty2",
          "description": "Optional party facing the CCP, acting as clearing member for party2.",
          "range": "Party",
          "@type": "SlotDefinition"
        },
        {
          "name": "isOpenOffer",
          "description": "Open Offer",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ClearingInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "ClosedState",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ClosedState",
      "description": "A class to qualify the closed state of an execution or a contract through the combination or a state (e.g. terminated, novated) and a set of dates: activity date, effective date and, when relevant, last payment date.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "closedState__state",
        "closedState__activityDate",
        "closedState__effectiveDate",
        "closedState__lastPaymentDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "state",
          "description": "The qualification of what gave way to the contract or execution closure, e.g. allocation, termination, ...",
          "range": "ClosedStateEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "activityDate",
          "description": "The activity date on which the closing state took place, i.e. either the event date of the closing event (e.g. option exercise, contract early termination) or the contractual termination date.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "The date on which the closing event contractually takes effect, when different from the activity date. When an explicit event effective date attribute is associated with the closing event, it will be that date. In the case of a cancellation event, it will be the date on which the cancelled event took place.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "lastPaymentDate",
          "description": "The date associated with the last payment in relation to the artefact (e.g. contract) to which this closed state applies. As an example, in the case of an early termination event, it would be the settlement date of the associated fee, if applicable.",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ClosedState",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralBalance",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralBalance",
      "description": "Represents common attributes to define a collateral balance recorded by the principal as held or posted.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "collateralBalance__collateralBalanceStatus",
        "collateralBalance__haircutIndicator",
        "collateralBalance__amountBaseCurrency",
        "collateralBalance__payerReceiver"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "collateralBalanceStatus",
          "description": "Defines the collateral balance breakdown of settlement status.",
          "range": "CollateralStatusEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "haircutIndicator",
          "description": "Indicates if the collateral balance amount is based on pre or post haircut, if a haircut is associated with the collateral asset",
          "range": "HaircutIndicatorEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "amountBaseCurrency",
          "description": "Specifies the collateral balance amount in base currency determined within a collateral legal agreement, or defined for reporting purposes.",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "payerReceiver",
          "description": "Specifies each of the parties in the collateral balance and its perspective with regards to the direction of the collateral balance, posted or received.",
          "range": "PartyReferencePayerReceiver",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralBalance",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralPortfolio",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralPortfolio",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Represents common attributes to define the details of collateral assets, to be used in margin call messaging and contribute to collateral balances e.g securities in a collateral account.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "collateralPortfolio__portfolioIdentifier",
        "collateralPortfolio__collateralPosition",
        "collateralPortfolio__collateralBalance",
        "collateralPortfolio__legalAgreement"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "portfolioIdentifier",
          "description": "Specifies a unique identifier for a set of collateral positions in a portfolio.",
          "range": "Identifier",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralPosition",
          "description": "Specifies the individual components of the collateral positions in the collateral portfolio.",
          "range": "CollateralPosition",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralBalance",
          "description": "Represents the populated or calculated collateral aggregate balance amount for the collateral portfolio.",
          "range": "CollateralBalance",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "legalAgreement",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The specification of a legal agreement between two parties governing the collateral relationship such as Credit Support Agreement or Collateral Transfer Agreement etc. (NB: this can be provided by reference to a global key for each LegalAgreement object).",
          "range": "LegalAgreement",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralPortfolio",
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralPosition",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralPosition",
      "description": "Specifies the individual components of collateral positions.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "PositionBase",
      "slots": [
        "positionBase__priceQuantity",
        "positionBase__product",
        "positionBase__asset",
        "positionBase__cashBalance",
        "positionBase__tradeReference",
        "collateralPosition__treatment",
        "collateralPosition__collateralPositionStatus"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "treatment",
          "description": "Specifies if there is any treatment to be applied to collateral, such as percentage discount which will impact collateral value.",
          "range": "CollateralTreatment",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralPositionStatus",
          "description": "Indicates the collateral positions settlement status.",
          "range": "CollateralStatusEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CollateralPosition",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "collateralPositionStatus",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "collateralPositionStatus",
                    "value_presence": "PRESENT",
                    "equals_string": "SettledAmount",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "collateralPositionStatus",
                    "value_presence": "PRESENT",
                    "equals_string": "InTransitAmount",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CollateralPositionStatusSettledOrInTransitOnly: Represents a condition to ensure that if a status is defined for a collateral position you must only indicate 'Settled Amount' or 'In Transit' amount from the available enumerations.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "From PositionBase. ProductOrAsset: A Position must either refer to a grouping by product or a grouping by asset.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "product",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "asset",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ContingentTransfer",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ContingentTransfer",
      "description": "Specifies a transfer created from a trade contingent upon a specific, uncertain event on a contract. Extends PayoutTransferBase because a Contingent Transfer originates from a Payout.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "PayoutTransferBase",
      "slots": [
        "transferBase__identifier",
        "transferBase__quantity",
        "transferBase__asset",
        "transferBase__settlementDate",
        "transferBase__paymentDiscounting",
        "transferBase__partyReferencePayerReceiver",
        "payoutTransferBase__payerReceiver",
        "payoutTransferBase__payoutReference",
        "contingentTransfer__transferType",
        "contingentTransfer__corporateActionTransferType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "transferType",
          "description": "Specifies the type of Contingent Transfer.",
          "range": "ContingentTransferEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "corporateActionTransferType",
          "description": "A transfer corresponding to a corporate action event",
          "range": "CorporateActionTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ContingentTransfer",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "transferType",
                "value_presence": "PRESENT",
                "equals_string": "CorporateAction",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "corporateActionTransferType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CorporateActionTransferTypeExists: When a Contingent Transfer is a Corporate Action the type of event must be specified.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "From PayoutTransferBase. PayerReceiverChoice: Required choice between a generic, unresolved payer/receiver and a party referenced payer/receiver for the transfer.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "partyReferencePayerReceiver",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "payerReceiver",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ContractDetails",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ContractDetails",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Defines specific attributes that relate to contractual details of trades.",
      "comments": [
        "Rosetta condition ExecutedAgreement is not stated in LinkML: if documentation exists then documentation -> agreementDate exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "ContractDetails_documentation",
        "contractDetails__governingLaw"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "governingLaw",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Represents the law governing the trade and associated contractual product terms.",
          "range": "GoverningLawEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ContractDetails",
      "@type": "ClassDefinition"
    },
    {
      "name": "ContractFormationInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ContractFormationInstruction",
      "description": "Specifies instructions to create a fully formed contract, with optional legal agreements.",
      "comments": [
        "Rosetta condition ExecutedAgreements is not stated in LinkML: if legalAgreement exists then legalAgreement -> agreementDate exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "contractFormationInstruction__legalAgreement"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "legalAgreement",
          "description": "Optional legal agreements associated to the contract being formed, for instance a master agreement.",
          "range": "LegalAgreement",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ContractFormationInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "CorporateAction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CorporateAction",
      "description": "Specifies the relevant data regarding a corporate action",
      "comments": [
        "Rosetta condition DividendObservation is not stated in LinkML: if dividendObservation exists then dividendObservation -> priceType = PriceTypeEnum -> Dividend"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "corporateAction__corporateActionType",
        "corporateAction__exDate",
        "corporateAction__payDate",
        "corporateAction__recordDate",
        "corporateAction__announcementDate",
        "corporateAction__underlier",
        "corporateAction__adjustmentFactor",
        "corporateAction__informationSource",
        "corporateAction__dividendObservation",
        "corporateAction__bespokeEventDescription"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "corporateActionType",
          "description": "The type of corporate action taking place.",
          "range": "CorporateActionTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "exDate",
          "description": "The date on which the corporate action is known to have taken place.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "payDate",
          "description": "The date on which resulting from the corporate action are delivered.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "recordDate",
          "description": "The date on which the account phyical balance and related underlier ownership is recorded by the custodian.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "announcementDate",
          "description": "The date on which the corporate action is announced by the issuer.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "underlier",
          "description": "The underlier impacted by the corporate action.",
          "range": "Underlier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustmentFactor",
          "description": "Specifies any additional details e.g. further descriptions depending on the particular type of Corporate Action, adjustmentFactor, calculations",
          "range": "AdjustmentFactor",
          "@type": "SlotDefinition"
        },
        {
          "name": "informationSource",
          "description": "A class defining the source of data used in an Observation for any purposes. The data is either sourced from a Provider, or from a Party.",
          "range": "InformationSource",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendObservation",
          "description": "To record observations of dividends.",
          "range": "PriceSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "bespokeEventDescription",
          "description": "Corporate action triggered by the occurrence of an event which description is seperatly agreed between the parties and/or described in any referenced agreement (for instance bespoke term described in any string type objects present in most root attributes of Agreement type).",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CorporateAction",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "corporateActionType",
                "equals_string": "BespokeEvent",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "bespokeEventDescription",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CorporateActionTypeBespoke: When Enum value does not corresponds to standard terms, then bespoke description must be populated.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "Unnamed condition (optional choice adjustmentFactor, dividendObservation): If intent is to record dividend observation per se with no relation to an adjustment (typically when such observation is made, looking forward dividend passthrough payments) then no adjustment is expected, and vice-versa. For the avoidance of doubts, in the case dividend terms are involved in the calculation or the occurrence of an adjustment calculation, then such information shall be defined at such proper level i.e. precisely as an attribute of the adjustmentFactorCalculation.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "adjustmentFactor",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "dividendObservation",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "adjustmentFactor",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "dividendObservation",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CounterpartyPositionBusinessEvent",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CounterpartyPositionBusinessEvent",
      "description": "A business event represents a life cycle event of a position. The combination of the state changes results in a qualifiable life cycle event.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "counterpartyPositionBusinessEvent__intent",
        "counterpartyPositionBusinessEvent__corporateActionIntent",
        "counterpartyPositionBusinessEvent__eventDate",
        "counterpartyPositionBusinessEvent__effectiveDate",
        "counterpartyPositionBusinessEvent__packageInformation",
        "counterpartyPositionBusinessEvent__after"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "intent",
          "description": "The intent attribute is meant to be specified when the event qualification cannot be programmatically inferred from the event features. As a result it is only associated with those primitives that can give way to such ambiguity, the quantityChange being one of those.",
          "range": "PositionEventIntentEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "corporateActionIntent",
          "description": "The intent of a corporate action on the position.",
          "range": "CorporateActionTypeEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "eventDate",
          "description": "Specifies the date on which the event is taking place. This date is equal to the trade date in the case of a simple execution. However it can be different from the trade date, for example in the case of a partial termination.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "The date on which the event contractually takes effect, when different from the event date.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "packageInformation",
          "description": "Specifies the package information in case the business event represents several trades executed as a package (hence this attribute is optional). The package information is only instantiated once at the business event level to preserve referential integrity, whereas individual trades make reference to it to identify that they are part of a package.",
          "range": "IdentifiedList",
          "@type": "SlotDefinition"
        },
        {
          "name": "after",
          "description": "Specifies the after position state(s) created.",
          "range": "CounterpartyPositionState",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CounterpartyPositionBusinessEvent",
      "@type": "ClassDefinition"
    },
    {
      "name": "CounterpartyPositionState",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CounterpartyPositionState",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Defines the fundamental financial information that can be changed by a Primitive Event and by extension any business or life-cycle event. Each PositionState specifies where a Position is in its life-cycle. PositionState is a root type and as such, can be created independently to any other CDM data type, but can also be used as part of the CDM Event Model.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "counterpartyPositionState__counterpartyPosition",
        "counterpartyPositionState__state",
        "counterpartyPositionState__observationHistory",
        "counterpartyPositionState__valuationHistory"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "counterpartyPosition",
          "description": "Represents the Position that has been effected by a business or life-cycle event.",
          "range": "CounterpartyPosition",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "state",
          "description": "Represents the State of the Position through its life-cycle.",
          "range": "State",
          "@type": "SlotDefinition"
        },
        {
          "name": "observationHistory",
          "description": "Represents the observed events related to a particular product or process, such as credit events or corporate actions.",
          "range": "ObservationEvent",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationHistory",
          "range": "Valuation",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CounterpartyPositionState",
      "@type": "ClassDefinition"
    },
    {
      "name": "CreditEvent",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CreditEvent",
      "description": "Specifies the relevant data regarding a credit event.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "creditEvent__creditEventType",
        "creditEvent__eventDeterminationDate",
        "creditEvent__auctionDate",
        "creditEvent__finalPrice",
        "creditEvent__recoveryPercent",
        "creditEvent__publiclyAvailableInformation",
        "creditEvent__referenceInformation"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "creditEventType",
          "description": "The type of credit event taking place.",
          "range": "CreditEventTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "eventDeterminationDate",
          "description": "The date in which the credit event is determined by the Credit Derivatives Determinations Comitee.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "auctionDate",
          "description": "The date on which the auction is scheduled to occur.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "finalPrice",
          "description": "The final price resulting from the auction.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "recoveryPercent",
          "description": "The percentage of the original value of the asset affected by the credit event that can be recovered.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "publiclyAvailableInformation",
          "description": "A public information source, e.g. a particular newspaper or electronic news service, that may publish relevant information used in the determination of whether or not a credit event has occurred.",
          "range": "Resource",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "referenceInformation",
          "description": "The reference entity, part of a credit basket, impacted by the credit event.",
          "range": "ReferenceInformation",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CreditEvent",
      "@type": "ClassDefinition"
    },
    {
      "name": "ExecutionDetails",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExecutionDetails",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "Defines specific attributes that relate to trade executions.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "executionDetails__executionType",
        "executionDetails__executionVenue",
        "executionDetails__packageReference"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "executionType",
          "description": "Identifies the type of execution, e.g. via voice, electronically...",
          "range": "ExecutionTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "executionVenue",
          "description": "Represents the venue on which a trade was executed.",
          "range": "LegalEntity",
          "@type": "SlotDefinition"
        },
        {
          "name": "packageReference",
          "description": "A reference to the package linking the trade with other trades, in case the trade was executed as part of a package (hence this attribute is optional).",
          "range": "IdentifiedList",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExecutionDetails",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "executionType",
                "equals_string": "Electronic",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "executionVenue",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ExecutionVenue: When the execution type is set to 'Electronically', the execution venue must be specified.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ExecutionInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExecutionInstruction",
      "description": "Specifies instructions for execution of a transaction, consisting of a product, price, quantity, parties, trade identifier, execution details, and settlement terms.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "executionInstruction__product",
        "executionInstruction__priceQuantity",
        "executionInstruction__counterparty",
        "executionInstruction__ancillaryParty",
        "executionInstruction__parties",
        "executionInstruction__partyRoles",
        "executionInstruction__executionDetails",
        "executionInstruction__tradeDate",
        "executionInstruction__tradeTime",
        "executionInstruction__tradeIdentifier",
        "executionInstruction__collateral",
        "executionInstruction__lotIdentifier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "product",
          "description": "Defines the financial product to be executed and contract formed.",
          "range": "NonTransferableProduct",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "priceQuantity",
          "description": "Defines the prices (e.g. spread, equity price, FX rate), quantities (e.g. currency amount, no. shares) and settlement terms (e.g. initial fee, broker fee, up-front cds payment or option premium settlement) associated with the constituents of the transacted product.",
          "range": "PriceQuantity",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "counterparty",
          "description": "Maps two defined parties to counterparty enums for the transacted product.",
          "range": "Counterparty",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "ancillaryParty",
          "description": "Maps any ancillary parties, e.g. parties involved in the transaction that are not one of the two principal parties.",
          "range": "AncillaryParty",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "parties",
          "description": "Defines all parties to that execution, including agents and brokers.",
          "range": "Party",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRoles",
          "description": "Defines the role(s) that party(ies) may have in relation to the execution.",
          "range": "PartyRole",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "executionDetails",
          "description": "Specifies the type and venue of execution, e.g. via voice, or electronically.",
          "range": "ExecutionDetails",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeDate",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "id",
              "@type": "Annotation"
            }
          ],
          "description": "Denotes the trade/execution date.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeTime",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "id",
              "@type": "Annotation"
            }
          ],
          "description": "Denotes the trade time and timezone as agreed by the parties to the trade.",
          "range": "TimeZone",
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeIdentifier",
          "description": "Denotes one or more identifiers associated with the transaction.",
          "range": "TradeIdentifier",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "collateral",
          "description": "Detail the collateral requirement anticipated with the transaction.",
          "range": "Collateral",
          "@type": "SlotDefinition"
        },
        {
          "name": "lotIdentifier",
          "description": "Lot Identifier associated with the transaction.",
          "range": "Identifier",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExecutionInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "ExerciseInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseInstruction",
      "description": "Specifies the information required to communicate the choices made by the exercising party, in a financial product endowing the party with at least one option.",
      "comments": [
        "Rosetta condition IsOptionPayout is not stated in LinkML: if exerciseOption exists then exerciseOption switch OptionPayout then item exists, default False"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "exerciseInstruction__exerciseQuantity",
        "exerciseInstruction__exerciseOption",
        "exerciseInstruction__exerciseDate",
        "exerciseInstruction__exerciseTime",
        "exerciseInstruction__replacementTradeIdentifier"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "exerciseQuantity",
          "description": "Contains instructions for exercising the option including a quantity change, and optionally a transfer.",
          "range": "PrimitiveInstruction",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseOption",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The Payout being exercised on the trade.",
          "range": "Payout",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseDate",
          "description": "Specifies the date on which an option contained within the financial product would be exercised. The date may be omitted if the contractual product allows for only a single date of exercise (European exercise).",
          "range": "AdjustableOrAdjustedDate",
          "@type": "SlotDefinition"
        },
        {
          "name": "exerciseTime",
          "description": "Specifies the time at which an option contained within the financial product woulld be exercised. The time may be omitted if the contractual product allows for only a single time of exercise (European exercise).",
          "range": "BusinessCenterTime",
          "@type": "SlotDefinition"
        },
        {
          "name": "replacementTradeIdentifier",
          "description": "Specifies the trade identifier to apply to the replacement trade for physical exercise.",
          "range": "TradeIdentifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExerciseInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "Exposure",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Exposure",
      "description": "Represents the current mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "exposure__tradePortfolio",
        "exposure__aggregateValue",
        "exposure__calculationDateTime",
        "exposure__valuationDateTime"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "tradePortfolio",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Represents a Portfolio that describes all the positions held at a given time, in various states which can be either traded, settled, etc., with lineage information to the previous state.",
          "range": "PortfolioState",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "aggregateValue",
          "description": "Represents the aggregate value of the portfolio in base currency.",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationDateTime",
          "description": "Indicates the date when the exposure is calculated if different from valuation date.",
          "range": "datetime",
          "@type": "SlotDefinition"
        },
        {
          "name": "valuationDateTime",
          "description": "Indicates the valuation date of the exposure underlying the calculation.",
          "range": "datetime",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Exposure",
      "@type": "ClassDefinition"
    },
    {
      "name": "IndexTransitionInstruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/IndexTransitionInstruction",
      "description": "Defines the information needed to create a Index Transition Business Event.",
      "comments": [
        "Rosetta condition PriceQuantity is not stated in LinkML: priceQuantity -> price -> priceType contains PriceTypeEnum -> InterestRate and priceQuantity -> observable as InterestRateIndex exists and priceQuantity -> quantity is absent"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "indexTransitionInstruction__priceQuantity",
        "indexTransitionInstruction__effectiveDate",
        "indexTransitionInstruction__cashTransfer"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "priceQuantity",
          "description": "Specifies both new floating rate index and spread adjustment for each leg to be updated. The spread adjustment accounts for the difference between the old floating rate index relative to the new one. This spread amount is added to the existing spread to determine the new spread, which is applied from the specified effective date forward. In the case of the IBOR Fallback Rate Adjustments, the adjustment spread (also known as the Fallback Adjustment) accounts for two distinctions: i) the fact that the replacement Risk-Free Rate is an overnight rate while IBORs have term structures (e.g., 1, 3, 6-month LIBOR); and (ii) the historical spread differential between IBORs and their term equivalent Overnight Risk-Free Rate compounded rates.",
          "range": "PriceQuantity",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "effectiveDate",
          "description": "Specifies the effective date of the index transition event. This is first date on which the floating rate calculation will use the new floating rate index and adjusted spread in the floating rate calculation.",
          "range": "date",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "cashTransfer",
          "description": "Specifies the cash transfer that can optionally be tied to an index transition event.",
          "range": "Transfer",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/IndexTransitionInstruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "Instruction",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Instruction",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "Instruction to a function that will be used to perform a business event",
      "comments": [
        "Rosetta condition ExclusiveSplitPrimitive is not stated in LinkML: if primitiveInstruction -> split exists then primitiveInstruction -> split only exists",
        "Rosetta condition NewTrade is not stated in LinkML: (if primitiveInstruction -> execution exists then before is absent else True) and (if before is absent then primitiveInstruction -> execution exists else True)"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "instruction__primitiveInstruction",
        "instruction__before"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "primitiveInstruction",
          "description": "Specifies the primitive instructions that will be used to call primitive event functions.",
          "range": "PrimitiveInstruction",
          "@type": "SlotDefinition"
        },
        {
          "name": "before",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the trade state that will be acted on by the primitive event functions.",
          "range": "TradeState",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Instruction",
      "@type": "ClassDefinition"
    },
    {
      "name": "Lineage",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Lineage",
      "description": "A class to provide lineage information across lifecycle events through a pointer or set of pointers into the event(s), contract(s) and, possibly, payout components that the event is dependent on or relates to. As an example, if an contractFormation event is corrected, the correction event will have a lineage into the initial event, which takes the form of a globalKey into that initial contract formation event. Two referencing mechanisms are provided as part of the CDM: either the globalKey, which corresponds to the hash value of the CDM class which is referred to, or a reference qualifier which is meant to provide support for the ingestion of xml documents with id/href mechanisms. The CDM recommends the use of the globalKey and provides a default implementation which is accessible in the generated code through org.finos.cdm.globalKey.GlobalKeyHashCalculator. If implementers want to use an alternative hashing mechanism, the API in which they need to plug it is com.rosetta.model.lib.HashFunction.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "lineage__tradeReference",
        "lineage__eventReference",
        "lineage__portfolioStateReference"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "tradeReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "range": "Trade",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "eventReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The reference to the instantiation of an Event object, either through a globalKey or an xml-derived id/href mechanism. The definition associated to the Lineage class provides more details with respect to those referencing approaches, their expected usage and available implementation.",
          "range": "WorkflowStep",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "portfolioStateReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The reference to the previous state of a Portfolio, in a chain of Events leading up to a build of that Portfolio as the holding of Product(s) in specific Quantity(ies). As part of the PortfolioState object, a pointer to the previous PortfolioState is provided through a Lineage object, together with pointer(s) to the Event or set of Events leading up to the current (new) state.",
          "range": "PortfolioState",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Lineage",
      "@type": "ClassDefinition"
    },
    {
      "name": "MarginCallBase",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MarginCallBase",
      "description": "Represents common attributes required for Issuance and Response to a Margin Call action as a result of a demand for delivery or return of collateral determined under a legal agreement such as a credit support document or equivalent.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "marginCallBase__instructionType",
        "marginCallBase__party",
        "marginCallBase__partyRole",
        "marginCallBase__clearingBroker",
        "marginCallBase__callIdentifier",
        "marginCallBase__callAgreementType",
        "marginCallBase__agreementMinimumTransferAmount",
        "marginCallBase__agreementThreshold",
        "marginCallBase__agreementRounding",
        "marginCallBase__regMarginType",
        "marginCallBase__regIMRole",
        "marginCallBase__baseCurrencyExposure",
        "marginCallBase__collateralPortfolio",
        "marginCallBase__independentAmountBalance"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "instructionType",
          "description": "Identifies the enumeration values to specify the call notification type, direction, specific action type.",
          "range": "MarginCallInstructionType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "party",
          "description": "Represents the parties to the margin call. The cardinality is optional to address the case where both parties of the event are specified and a third party if applicable.",
          "range": "Party",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "partyRole",
          "description": "Represents the role each specified party takes in the margin call. further to the principal roles, payer and receiver.",
          "range": "PartyRole",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "clearingBroker",
          "description": "Indicates the name of the Clearing Broker FCM/DCM.",
          "range": "Party",
          "@type": "SlotDefinition"
        },
        {
          "name": "callIdentifier",
          "description": "Represents a unique Identifier for a margin call message, that can be referenced throughout all points of the process.",
          "range": "Identifier",
          "@type": "SlotDefinition"
        },
        {
          "name": "callAgreementType",
          "description": "Specifies the legal agreement type the margin call is generated from and governed by.",
          "range": "AgreementName",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "agreementMinimumTransferAmount",
          "description": "Specifies the collateral legal agreement minimum transfer amount in base currency.",
          "range": "Money",
          "@type": "SlotDefinition"
        },
        {
          "name": "agreementThreshold",
          "description": "Specifies the collateral legal agreement threshold amount in base currency.",
          "range": "Money",
          "@type": "SlotDefinition"
        },
        {
          "name": "agreementRounding",
          "description": "Specifies the collateral legal agreement rounding in base currency.",
          "range": "Money",
          "@type": "SlotDefinition"
        },
        {
          "name": "regMarginType",
          "description": "Identifies margin type and if related regulatory mandate",
          "range": "RegMarginTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "regIMRole",
          "description": "Indicates the role of the party in an regulatory initial margin call instruction (i.e Pledgor party or Secured party).",
          "range": "RegIMRoleEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "baseCurrencyExposure",
          "description": "Represents the current mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency), to be referenced in a margin call.",
          "range": "MarginCallExposure",
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralPortfolio",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Represents attributes to define the details of collateral assets within a collateral portfolio to be used in margin call messaging and contribute to collateral balances e.g securities in a collateral account recorded by the principal as held or posted.",
          "range": "CollateralPortfolio",
          "@type": "SlotDefinition"
        },
        {
          "name": "independentAmountBalance",
          "description": "Represents additional credit support amount over and above mark to market value.",
          "range": "CollateralBalance",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/MarginCallBase",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "regIMRole",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "regMarginType",
                "equals_string": "RegIM",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "RegIMRoleIMOnly: Specifies a condition to ensure that RegIMRole (Pledgor or Secured Party)is only applicable if the Reg margin type is defined as RegIM (Regulatory Initial Margin).",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "MarginCallExposure",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MarginCallExposure",
      "description": "Represents attributes required for mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency).",
      "comments": [
        "Rosetta condition OverallExposureSumOfSimmAndScheduleIM is not stated in LinkML: if simmIMExposure exists and scheduleGridIMExposure exists then (overallExposure -> aggregateValue -> value = simmIMExposure -> aggregateValue -> value + scheduleGridIMExposure -> aggregateValue -> value) and (overallExposure -> aggregateValue -> unit -> currency = simmIMExposure -> aggregateValue -> unit -> currency) and (overallExposure -> aggregateValue -> unit -> currency = scheduleGridIMExposure -> aggregateValue -> unit -> currency)"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "MarginCallBase",
      "slots": [
        "marginCallBase__instructionType",
        "marginCallBase__party",
        "marginCallBase__partyRole",
        "marginCallBase__clearingBroker",
        "marginCallBase__callIdentifier",
        "marginCallBase__callAgreementType",
        "marginCallBase__agreementMinimumTransferAmount",
        "marginCallBase__agreementThreshold",
        "marginCallBase__agreementRounding",
        "marginCallBase__regMarginType",
        "marginCallBase__regIMRole",
        "marginCallBase__baseCurrencyExposure",
        "marginCallBase__collateralPortfolio",
        "marginCallBase__independentAmountBalance",
        "marginCallExposure__overallExposure",
        "marginCallExposure__simmIMExposure",
        "marginCallExposure__scheduleGridIMExposure"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "overallExposure",
          "description": "Represents the whole overall mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency).",
          "range": "Exposure",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "simmIMExposure",
          "description": "Represents Initial Margin (IM) exposure derived from ISDA SIMM calculation.",
          "range": "Exposure",
          "@type": "SlotDefinition"
        },
        {
          "name": "scheduleGridIMExposure",
          "description": "Represents Initial Margin (IM) exposure derived from schedule or Grid calculation.",
          "range": "Exposure",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/MarginCallExposure",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "simmIMExposure",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              },
              {
                "name": "scheduleGridIMExposure",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "regMarginType",
                "equals_string": "RegIM",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "ExposureSimmAndScheduleIMOnly: Specifies a condition to ensure that if margin exposure is defined as Simm IM and Schedule/Grid IM Exposure this is only applicable if the Reg margin type is defined as RegIM (Regulatory Initial Margin).",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "MarginCallInstructionType",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MarginCallInstructionType",
      "description": "Represents enumeration values to specify the call notification type, direction, specific action type.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "marginCallInstructionType__callType",
        "marginCallInstructionType__visibilityIndicator"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "callType",
          "description": "Indicates the status of the call message type, such as expected call, notification of a call or an actionable margin call.",
          "range": "CallTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "visibilityIndicator",
          "description": "Indicates the choice if the call instruction is visible or not to the other party.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/MarginCallInstructionType",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "callType",
                "equals_string": "ExpectedCall",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "visibilityIndicator",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CallTypeExpectedVisibility: Represents a condition to ensure that a visibility indicator is specifies then the call type must be an expected call.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "MarginCallIssuance",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MarginCallIssuance",
      "description": "Represents common attributes required for a Margin Call Issuance under a legal agreement such as a credit support document or equivalent.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
