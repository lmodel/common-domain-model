              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The reference index that is used to specify the floating interest rate.",
          "range": "FloatingRateIndexEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "indexTenor",
          "description": "The ISDA Designated Maturity, i.e. the floating rate tenor.",
          "range": "Period",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AssetFloatingRateIndex",
      "all_of": [
        {
          "description": "From IndexBase. AssetType: Asset type must be Other.",
          "slot_conditions": [
            {
              "name": "assetType",
              "equals_string": "Other",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "InterestRateAssetClass: The asset class must be Interest Rate.",
          "slot_conditions": [
            {
              "name": "assetClass",
              "value_presence": "PRESENT",
              "equals_string": "InterestRate",
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "AssetSettlementRateOption",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AssetSettlementRateOption",
      "annotations": [
        {
          "tag": "rosetta_name",
          "value": "cdm.observable.asset.SettlementRateOption",
          "@type": "Annotation"
        }
      ],
      "description": "Defines the settlement rate option to use for fixing in case of cash settlement. Currently only applicable to foreign exchange fixing in case of cross-currency settlement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "aliases": [
        "SettlementRateOption"
      ],
      "slots": [
        "assetSettlementRateOption__settlementRateOption",
        "assetSettlementRateOption__priceSourceDisruption"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "settlementRateOption",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The rate source for the conversion to the settlement currency. This source is specified through a scheme that reflects the terms of the Annex A to the 1998 FX and Currency Option Definitions.",
          "range": "SettlementRateOptionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "priceSourceDisruption",
          "description": "An attribute defining the parameters to get a new quote when a settlement rate option is disrupted.",
          "range": "PriceSourceDisruption",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AssetSettlementRateOption",
      "@type": "ClassDefinition"
    },
    {
      "name": "Basket",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Basket",
      "description": "Defines a custom basket by referencing an identifier and its constituents.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "is_a": "AssetBase",
      "slots": [
        "assetBase__identifier",
