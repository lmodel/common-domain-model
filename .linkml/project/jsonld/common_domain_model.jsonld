    {
      "name": "ExecutionLanguage",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExecutionLanguage",
      "description": "A class to specify execution language terms of a Security Agreement.",
      "comments": [
        "Rosetta condition NumberOfOriginals is not stated in LinkML: if standardLanguage = False then numberOfOriginals is absent",
        "Rosetta condition OtherLanguage is not stated in LinkML: if standardLanguage = False then otherLanguage exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "executionLanguage__standardLanguage",
        "executionLanguage__numberOfOriginals",
        "executionLanguage__otherLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "standardLanguage",
          "description": "A boolean attribute to determine if standard language is applicable or not.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "numberOfOriginals",
          "description": "The number of original documents.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "otherLanguage",
          "description": "Bespoke execution language to be included when specified.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExecutionLanguage",
      "@type": "ClassDefinition"
    },
    {
      "name": "ExecutionLocation",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ExecutionLocation",
      "description": "A class to specify execution location terms of a Security Agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "executionLocation__executionLocation",
        "executionLocation__otherLanguage",
        "executionLocation__dutyPayer",
        "executionLocation__dutyPayerLanguage",
        "executionLocation__dutyPaymentDate",
        "executionLocation__dutyPaymentLanguage"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "executionLocation",
          "description": "The execution location of the agreement.",
          "range": "ExecutionLocationEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "otherLanguage",
          "description": "Bespoke execution location language to be included when specified.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "dutyPayer",
          "description": "The payer of documentary duty.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "dutyPayerLanguage",
          "description": "Bespoke terms specific to the payment of documentary duty.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "dutyPaymentDate",
          "description": "The date that documentary duty will be paid.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "dutyPaymentLanguage",
          "description": "Bespoke terms specific to the date that documentary duty will be paid.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/ExecutionLocation",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "dutyPayer",
                "value_presence": "PRESENT",
                "equals_string": "Specify",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "dutyPayerLanguage",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DutyPayerLanguage: A data rule to enforce that Duty Payer Language should only be specified when required.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "dutyPaymentDate",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "dutyPaymentLanguage",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DutyPaymentLanguage: A data rule to enforce that Duty Payment Language should be absent when a Duty Payment date is provided.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "executionLocation",
