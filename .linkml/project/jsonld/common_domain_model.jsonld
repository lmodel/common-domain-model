    {
      "name": "ValuationMethodEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ValuationMethodEnum",
      "description": "The enumerated values to specify the ISDA defined methodology for determining the final price of the reference obligation for purposes of cash settlement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset",
      "permissible_values": [
        {
          "text": "Market"
        },
        {
          "text": "Highest"
        },
        {
          "text": "AverageMarket"
        },
        {
          "text": "AverageHighest"
        },
        {
          "text": "BlendedMarket"
        },
        {
          "text": "BlendedHighest"
        },
        {
          "text": "AverageBlendedMarket"
        },
        {
          "text": "AverageBlendedHighest"
        }
      ]
    },
    {
      "name": "CalculationMethodEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationMethodEnum",
      "description": "What calculation type is required, averaging or compounding. This enumeration is used to represent the definitions of modular calculated rates as described in the 2021 ISDA Definitions, section 7.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_calculatedrate",
      "permissible_values": [
        {
          "text": "Averaging",
          "description": "Averaging, i.e. arithmetic averaging."
        },
        {
          "text": "Compounding",
          "description": "Compounding, i.e. geometric averaging following an ISDA defined formula."
        },
        {
          "text": "CompoundedIndex",
          "description": "A rate based on an index that is computed by a rate administrator. The user is responsible for backing out the rate by applying a simple formula."
        }
      ]
    },
    {
      "name": "CalculationShiftMethodEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationShiftMethodEnum",
      "description": "the specific calculation method, e.g. lookback. This enumeration is used to represent the definitions of modular calculated rates as described in the 2021 ISDA Definitions, section 7.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_calculatedrate",
      "permissible_values": [
        {
          "text": "Lookback",
          "description": "Calculations and weighting are done with respect to the calculation period, but observations are shifted back by several days."
        },
        {
          "text": "ObservationPeriodShift",
          "description": "the observation period is shifted by several days prior to rate setting, and weightings are done with respect to the obseration period."
        },
        {
          "text": "RateCutOff",
          "description": "Calculations cut the rate off several business days prior to rate setting (Lockout)."
        },
        {
          "text": "NoShift",
          "description": "calculations occur without any shifting, e.g. OIS Compounding/Basic Averaging style."
        }
      ]
    },
    {
      "name": "InflationCalculationMethodEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/InflationCalculationMethodEnum",
      "description": "Indicates how to use the inflation index to calculate the payment (e.g. Ratio, Return, Spread). Added for Inflation Asset Swap",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_calculatedrate",
      "permissible_values": [
        {
          "text": "Ratio",
          "description": "(Inflation Index Final / Inflation Index Base). Inflation Index Final is inflation index for Reference Month that is the Lag number of months prior to Payment Date (subject to interpolation). Inflation Index Base subject to the Calculation Style. Used in inflation asset swaps to calculate the inflation coupons and principal exchange."
        },
        {
          "text": "Return",
          "description": "(Inflation Index Final / Inflation Index Base -1). Inflation Index Final is the inflation index for Reference Month that is the Lag number of months prior to Payment Date (subject to interp). Inflation Index Base subject to the Calculation Style. Used in market standard ZC Inflation swaps."
        },
        {
          "text": "Spread",
          "description": "Inflation Index Final - Inflation Index Base). Inflation Index Final is Index for Ref month the Lag months prior to Payment Date (subject to interp). Inflation Index Base subject to the Calculation Style. Typically used for fixing locks."
        }
      ]
    },
    {
      "name": "InflationCalculationStyleEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/InflationCalculationStyleEnum",
      "description": "Indicates the style of how the inflation index calculates the payment (e.g. YearOnYear, ZeroCoupon).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_calculatedrate",
      "permissible_values": [
        {
          "text": "YearOnYear",
          "description": "YearOnYear means Inflation Index Base is the inflation index for Reference Month that is 12 months prior to Inflation Index Final (subject to interpolation). Inflation Index Base is cashflow dependent."
        },
        {
          "text": "ZeroCoupon",
          "description": "ZeroCoupon means Inflation Index Base used in the CalculationMethod is the inflation index for the Reference Month that is the lag number of months prior to Effective Date in the case of a swap, or Bond Interest Accrual Date in the case of an Asset Swap (subject to interpolation). Inflation Index Base has the same value for each inflation cashflow and Principal Exchange calculation within the trade."
        }
      ]
    },
    {
      "name": "ObservationPeriodDatesEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ObservationPeriodDatesEnum",
      "description": "The enumerated values to specify whether rate calculations occur relative to the first or last day of a calculation period. Done in uppercase due to a bug in code generation. This enumeration is used to represent the definitions of modular calculated rates as described in the 2021 ISDA Definitions, section 7.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_calculatedrate",
      "permissible_values": [
        {
          "text": "SetInAdvance",
          "description": "Calculations occur relative to the first day of a calculation period."
        },
        {
          "text": "Standard",
          "description": "Calculations occur relative to the last day of a calculation period (set in arrears)."
        },
        {
          "text": "FixingDate",
          "description": "Calculations occur relative to a previously defined reset date, e.g. for a fallback rate."
        }
      ]
    },
    {
      "name": "FloatingRateIndexCalculationMethodEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexCalculationMethodEnum",
      "description": "3rd level ISDA FRO category.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro",
      "permissible_values": [
        {
          "text": "OIS Compounding",
          "description": "A calculation methodology using the ISDA-defined OIS compounding formula.",
          "aliases": [
            "OISCompound"
          ]
        },
        {
          "text": "Overnight Averaging",
          "description": "A calculation methodology using the arithmetic mean.",
          "aliases": [
            "Average"
          ]
        },
        {
          "text": "Compounded Index",
          "aliases": [
            "Compounded"
          ]
        },
        {
          "text": "All-In Compounded Index",
          "aliases": [
            "AllInCompounded"
          ]
        }
      ]
    },
    {
      "name": "FloatingRateIndexCategoryEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexCategoryEnum",
      "description": "Top level ISDA FRO category.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro",
      "permissible_values": [
        {
          "text": "Screen Rate",
          "description": "The rate is observed directly from a screen.",
          "aliases": [
            "ScreenRate"
          ]
        },
        {
          "text": "Calculated Rate",
          "description": "The rate is calculated by the calculation agents from multiple observations.",
          "aliases": [
            "Calculated"
          ]
        },
        {
          "text": "Reference Banks Rate",
          "description": "The rate is obtained by polling several other banks.",
          "aliases": [
            "ReferenceBanks"
          ]
        }
      ]
    },
    {
      "name": "FloatingRateIndexPeriodObservationTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexPeriodObservationTypeEnum",
      "description": "Defines the observation pattern for a floating rate index period.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro",
      "permissible_values": [
        {
          "text": "Single",
          "description": "Single observation date pattern (e.g., term rate / screen rate)."
        },
        {
          "text": "Multiple",
          "description": "Multiple observation dates pattern requiring a date range generation."
        },
        {
          "text": "CompoundedIndex",
          "description": "Compounded Index pattern requiring start and end dates."
        }
      ]
    },
    {
      "name": "FloatingRateIndexStyleEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexStyleEnum",
      "description": "Second level ISDA FRO category.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro",
      "permissible_values": [
        {
          "text": "Average FRO",
          "description": "An ISDA-defined calculated rate done using arithmetic averaging.",
          "aliases": [
            "AverageFRO"
          ]
        },
        {
          "text": "Compounded FRO",
          "description": "An ISDA-defined calculated rate done using arithmetic averaging.",
          "aliases": [
            "CompoundedFRO"
          ]
        },
        {
          "text": "Compounded Index",
          "description": "A published index calculated using compounding.",
          "aliases": [
            "CompoundedIndex"
          ]
        },
        {
          "text": "Index",
          "description": "A published index using a methodology defined by the publisher, e.g. S&P 500."
        },
        {
          "text": "Other"
        },
        {
          "text": "Overnight Rate",
          "aliases": [
            "Overnight"
          ]
        },
        {
          "text": "Published Average Rate",
          "description": "A published rate computed using an averaging methodology.",
          "aliases": [
            "PublishedAverage"
          ]
        },
        {
          "text": "Specified Formula",
          "aliases": [
            "SpecifiedFormula"
          ]
        },
        {
          "text": "Swap Rate",
          "description": "A rate representing the market rate for swaps of a given maturity.",
          "aliases": [
            "SwapRate"
          ]
        },
        {
          "text": "Term Rate",
          "description": "A rate specified over a given term, such as a libor-type rate.",
          "aliases": [
            "TermRate"
          ]
        }
      ]
    },
    {
      "name": "DeterminationMethodEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DeterminationMethodEnum",
      "annotations": [
        {
          "tag": "doc_reference",
          "value": "ISDA FpML_Coding_Scheme schemeLocation http://www.fpml.org/coding-scheme/determination-method"
        }
      ],
      "description": "The enumerated values to specify the method according to which an amount or a date is determined.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_observable_common",
      "see_also": [
        "http://www.fpml.org/coding-scheme/determination-method"
