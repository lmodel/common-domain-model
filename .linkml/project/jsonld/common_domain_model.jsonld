        "accrualFactorCalculationTerms__interpolationTerms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "tenorTillMaturity",
          "description": "The duration between last fixing date and the payment date of accruals, calculated in accordance with the appropriate DayCountFraction.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dayCountFraction",
          "description": "The enumerated values to specify the day count fraction.",
          "range": "DayCountFractionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "interpolationTerms",
          "description": "Describes the rate, tenor, period duration for the short and long stubs, when the accrualRate optionnaly results from an interpolation method.",
          "range": "StubValue",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AccrualFactorCalculationTerms",
      "@type": "ClassDefinition"
    },
    {
      "name": "AdjustmentFactor",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AdjustmentFactor",
      "description": "Describes the terms involved for adjusting the price of the underlier impacted by a Corporate Action.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "adjustmentFactor__value",
        "adjustmentFactor__calculationTerms"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "value",
          "description": "The multiplier value applied to the price of the underlier impacted by a Corporate Action.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationTerms",
          "description": "Describes the input terms involved in the calculation of the adjustment factor applied to the price of the underlier impacted by a Corporate Action.",
          "range": "AdjustmentFactorCalculationTerms",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AdjustmentFactor",
      "@type": "ClassDefinition"
    },
    {
      "name": "AdjustmentFactorCalculationTerms",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AdjustmentFactorCalculationTerms",
      "description": "Describes the input terms involved in the calculation of the adjustment factor applied to the price of the underlier impacted by a Corporate Action.",
      "comments": [
        "Rosetta condition DividendObservation is not stated in LinkML: if dividendObservation exists then dividendObservation -> priceType = PriceTypeEnum -> Dividend"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "slots": [
        "adjustmentFactorCalculationTerms__shareForShareRatio",
        "adjustmentFactorCalculationTerms__shareForRightsRatio",
        "adjustmentFactorCalculationTerms__rightsSubscriptionPrice",
        "adjustmentFactorCalculationTerms__dividendRatio",
        "adjustmentFactorCalculationTerms__spinOff",
        "adjustmentFactorCalculationTerms__merger",
        "adjustmentFactorCalculationTerms__accrualFactor",
        "adjustmentFactorCalculationTerms__lastFixingPriceBeforeAdjustment",
        "adjustmentFactorCalculationTerms__dividendObservation",
        "adjustmentFactorCalculationTerms__bespokeCalculationFormula"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "shareForShareRatio",
          "description": "Multiple value, say 'M/N' where 'M' is the number of shares after the event and 'N' is the number of shares prior to the event.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "shareForRightsRatio",
          "description": "Multiple value, say 'M/N' where 'M' is the number of rights after the event, and 'N' of shares prior to the event.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "rightsSubscriptionPrice",
          "description": "The price to pay per each right.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendRatio",
          "description": "Multiplier value (e.g. 85 %, etc.) to calculate net dividend amount, given gross amount before taking into account the relevant fiscal features.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "spinOff",
          "description": "Defines the underlier for both the Parent Company and the Child Compagny involved in Spin Off corporate action, as well as the respective price observation for each.",
          "range": "SpinOff",
          "@type": "SlotDefinition"
        },
        {
          "name": "merger",
          "description": "Defines the underlier for both the Purchaser Company and the Acquired Compagny involved in Spin Off corporate action, as well as the respective price observation for each.",
          "range": "Merger",
          "@type": "SlotDefinition"
        },
        {
          "name": "accrualFactor",
          "description": "The accrual rate and related terms, to adjust the price of an underlier impacted by a Corporate Action when economic impact consists in freezing the underlier price to last fixing and applying accruals for each remaining underlier price fixing date required i.e. for each, adjustedPrice = lastFixingPrice x (1 + accrualRate x DCF).",
          "range": "AccrualFactor",
          "@type": "SlotDefinition"
        },
        {
          "name": "lastFixingPriceBeforeAdjustment",
          "description": "The last fixing price of the Underlier affected by the CorporateAction, before any adjustment with regards to the CorporateAction.",
          "range": "Price",
          "@type": "SlotDefinition"
        },
        {
          "name": "dividendObservation",
          "description": "To record observations of dividends.",
          "range": "PriceSchedule",
          "@type": "SlotDefinition"
        },
        {
          "name": "bespokeCalculationFormula",
          "description": "To describe the formula used to calculate the Adjustment Factor.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AdjustmentFactorCalculationTerms",
      "all_of": [
        {
          "description": "SpinOffOrMergerOrAccrual",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "spinOff",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "merger",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "accrualFactor",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "spinOff",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "merger",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "accrualFactor",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "ShareRatio",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "shareForShareRatio",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "shareForRightsRatio",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "shareForShareRatio",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "shareForRightsRatio",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "AgreementEvent",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AgreementEvent",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        },
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "An agreement event represents a life cycle event of a legal document. The combination of legal term amendments, contracting party changes or agreement status changes that are represented by an amendment agreement that includes a change to the overall Legal agreement representation through a change in contractual parties or terms.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_common",
      "is_a": "AgreementEventInstruction",
      "slots": [
        "agreementEventInstruction__eventDate",
        "agreementEventInstruction__effectiveDate",
        "agreementEventInstruction__instruction",
        "agreementEventInstruction__intent",
        "agreementEvent__eventQualifier",
        "agreementEvent__after"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "eventQualifier",
          "description": "The CDM event qualifier, which corresponds to the outcome of the isEvent qualification logic which qualifies the lifecycle event as a function of its features (e.g. PartialTermination, ClearingSubmission, Novation, ...).",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "after",
          "description": "The agreement as it looks after the event",
          "range": "LegalAgreement",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/AgreementEvent",
      "@type": "ClassDefinition"
    },
