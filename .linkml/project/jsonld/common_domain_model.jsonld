    {
      "name": "FloatingAmountCalculationDetails",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingAmountCalculationDetails",
      "description": "Type for reporting the detailed results of calculating a cash flow for a calculation period. This is enhanced relative to the FpML-based cashflows structure to allow more information to be returned about daily compounded rates.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset_floatingrate",
      "slots": [
        "floatingAmountCalculationDetails__calculationPeriod",
        "floatingAmountCalculationDetails__calculationPeriodNotionalAmount",
        "floatingAmountCalculationDetails__floatingRate",
        "floatingAmountCalculationDetails__processingDetails",
        "floatingAmountCalculationDetails__appliedRate",
        "floatingAmountCalculationDetails__yearFraction",
        "floatingAmountCalculationDetails__calculatedAmount",
        "floatingAmountCalculationDetails__spreadExclusiveCalculatedAMount"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "calculationPeriod",
          "description": "The calculation period for which the floating calculation was performed.",
          "range": "CalculationPeriodBase",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculationPeriodNotionalAmount",
          "description": "The notional in effect during the calculation period.",
          "range": "Money",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "floatingRate",
          "description": "The details of the floating rate setting. (If it is a calculated rate, details of that calculation will be inside that.",
          "range": "FloatingRateSettingDetails",
          "@type": "SlotDefinition"
        },
        {
          "name": "processingDetails",
          "description": "Details fo the floating rate treatment after the rate is observed or calculated. This will include details of things like multipliers, spreads, caps and floors, and the raw and treated rates.",
          "range": "FloatingRateProcessingDetails",
          "@type": "SlotDefinition"
        },
        {
          "name": "appliedRate",
          "description": "The rate that was actually applied, after all calculations and treatments.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "yearFraction",
          "description": "The fraction of a year that this calculation represents, according to the day count fraction method.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "calculatedAmount",
          "description": "The amount of the cash flow that was computed, including any spreads and other processing.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "spreadExclusiveCalculatedAMount",
          "description": "The amount of the cash flow excluding any spread, for subsequent processing.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingAmountCalculationDetails",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRateProcessingDetails",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateProcessingDetails",
      "description": "Type for reporting the details of the rate treatment. This could potentially be replaced by the existing FloatingRateDefinition type , but this is slightly more detailed.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset_floatingrate",
      "slots": [
        "floatingRateProcessingDetails__rawRate",
        "floatingRateProcessingDetails__processingParameters",
        "floatingRateProcessingDetails__processedRate",
        "floatingRateProcessingDetails__spreadExclusiveRate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "rawRate",
          "description": "The raw or untreated rate, prior to any of the rate treatments.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "processingParameters",
          "range": "FloatingRateProcessingParameters",
          "@type": "SlotDefinition"
        },
        {
          "name": "processedRate",
          "description": "The value of the rate after processing.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "spreadExclusiveRate",
          "description": "The value of the processed rate without the spread applied, for subsequent compounding, etc.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateProcessingDetails",
      "@type": "ClassDefinition"
    },
    {
      "name": "FloatingRateProcessingParameters",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/FloatingRateProcessingParameters",
      "description": "Type to hold the processing parameters that should be or were used to calculate a floating amount. These parameters can vary over a schedule so this type holds the acutal values applicable to this calculation.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset_floatingrate",
      "slots": [
        "floatingRateProcessingParameters__initialRate",
