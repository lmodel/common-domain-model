    {
      "name": "CalculationFrequency",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationFrequency",
      "description": "Represents the parameters for describing how often something (such as collateral interest) is to be calculated.",
      "comments": [
        "Rosetta condition MoyTerm is not stated in LinkML: if monthOfYear exists then (period -> period = PeriodEnum -> Y)",
        "Rosetta condition DomTerm is not stated in LinkML: if dayOfMonth exists then (period -> period = PeriodEnum -> M)",
        "Rosetta condition DowTerm is not stated in LinkML: if dayOfWeek exists then (period -> period = PeriodEnum -> W)",
        "Rosetta condition WomTerm is not stated in LinkML: if weekOfMonth exists then (period -> period = PeriodEnum -> M)"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "calculationFrequency__period",
        "calculationFrequency__monthOfYear",
        "calculationFrequency__dayOfMonth",
        "calculationFrequency__dayOfWeek",
        "calculationFrequency__weekOfMonth",
        "calculationFrequency__offsetDays",
        "calculationFrequency__dateLocation",
        "calculationFrequency__businessCenter"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "period",
          "description": "Specifies the time period at which calculation is performed, e.g. 1 month.",
          "range": "Period",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "monthOfYear",
          "description": "Specifies the month of the year if used.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "dayOfMonth",
          "description": "Specifies the day of the month if used.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "dayOfWeek",
          "description": "Specifies the day of the week if used.",
          "range": "DayOfWeekEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "weekOfMonth",
          "description": "Specifies the week of the month if used.",
          "range": "decimal",
          "@type": "SlotDefinition"
        },
        {
          "name": "offsetDays",
          "description": "Specifies how many days from the trigger event should the payment occur.",
          "range": "decimal",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dateLocation",
          "description": "Specifies where is the time measured.",
          "range": "BusinessCenterTime",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCenter",
          "description": "Specifies the business center for adjustment of calculation period.",
          "range": "BusinessCenter",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculationFrequency",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "monthOfYear",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "monthOfYear",
                "maximum_value": 12,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Moy",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "dayOfMonth",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "dayOfMonth",
                "maximum_value": 31,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Dom",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "weekOfMonth",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "weekOfMonth",
                "maximum_value": 5,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "Wom",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CalculationPeriodFrequency",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CalculationPeriodFrequency",
      "description": "A class to specify the frequency at which calculation period end dates occur within the regular part of the calculation period schedule and their roll date convention.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "is_a": "Frequency",
      "slots": [
        "frequency__periodMultiplier",
        "frequency__period",
        "calculationPeriodFrequency__rollConvention",
        "calculationPeriodFrequency__balanceOfFirstPeriod"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "rollConvention",
          "description": "The roll convention specifies the period term as part of a periodic schedule, i.e. the calculation period end date within the regular part of the calculation period. The value could be a rule, e.g. IMM Settlement Dates, which is the 3rd Wednesday of the month, or it could be a specific day of the month, such as the first day of the applicable month. It is used in conjunction with a frequency and the regular period start date of a calculation period.",
          "range": "RollConventionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "balanceOfFirstPeriod",
          "description": "Indicates, when true, that that the first Calculation Period should run from the Effective Date to the end of the calendar period in which the Effective Date falls, e.g. Jan 15 - Jan 31 if the calculation periods are one month long and Effective Date is Jan 15. If false, the first Calculation Period should run from the Effective Date for one whole period, e.g. Jan 15 to Feb 14 if the calculation periods are one month long and Effective Date is Jan 15. Mostly used in Commmodity Swaps.",
          "range": "boolean",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CalculationPeriodFrequency",
      "rules": [
        {
          "preconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "period",
                    "equals_string": "M",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "period",
                    "equals_string": "Y",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "all_of": [
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "NONE",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "SFE",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "MON",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "TUE",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "WED",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "THU",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "FRI",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "SAT",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "rollConvention",
                        "value_presence": "PRESENT",
                        "equals_string": "SUN",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "FpML_ird_57: FpML validation rule ird-57 - Context: CalculationPeriodFrequency. [period eq ('M', 'Y')] not(rollConvention = ('NONE', 'SFE', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT','SUN')).",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "period",
                "equals_string": "W",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "NONE",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "SFE",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "MON",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "TUE",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "WED",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "THU",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "FRI",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "SAT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "rollConvention",
                    "equals_string": "SUN",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "FpML_ird_58: FpML validation rule ird-58 - Context: CalculationPeriodFrequency. When the period is 'W', the rollConvention must be a week day, 'SFE' or 'NONE'.",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "period",
                "equals_string": "T",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "rollConvention",
                "equals_string": "NONE",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "FpML_ird_60: FpML validation rule ird-60 - Context: CalculationPeriodFrequency. When the period is 'T', the rollConvention must be 'NONE'.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "From Frequency. PositivePeriodMultiplier: FpML specifies periodMultiplier as a positive integer.",
          "slot_conditions": [
            {
              "name": "periodMultiplier",
              "minimum_value": 1,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CustomisableOffset",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CustomisableOffset",
      "description": "A class to specify an offset either as a normalized [multiplier, period, dayType] or as a custom provision of type string.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "customisableOffset__offset",
