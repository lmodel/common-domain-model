    {
      "name": "InstructionComposition",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/InstructionComposition",
      "annotations": [
        {
          "tag": "rosetta_root_type",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "Represents an Instruction Composition orchestration, holding data, shared history, and an ordered sequence of CompositionSteps. Each InstructionComposition will have one or more CompositionStps.",
      "comments": [
        "Rosetta condition InstructionCompositionType is not stated in LinkML: compositionStep -> compositionStepInstruction -> instructionCompositionType all = instructionCompositionType",
        "Rosetta condition CompositionStateByType is not stated in LinkML: if instructionCompositionType = ResetInstruction then (compositionState switch ResetInstructionState then True) = True"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_event_instructioncomposition",
      "slots": [
        "instructionComposition__compositionStep",
        "instructionComposition__compositionState",
        "instructionComposition__instructionCompositionType",
        "instructionComposition__identifier",
        "instructionComposition__tradeId",
        "instructionComposition__instructionCompositionOutput"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "compositionStep",
          "description": "Ordered sequence of CompositionSteps that drive the Instruction Composition process (atomic actions, calculations, validations).",
          "range": "CompositionStep",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "compositionState",
          "description": "Shared state accumulated across executed steps, capturing intermediate and final outputs of the Instruction Composition process.",
          "range": "CompositionState",
          "@type": "SlotDefinition"
        },
        {
          "name": "instructionCompositionType",
          "description": "Type of Instruction Composition being orchestrated (e.g. ResetInstruction).",
          "range": "InstructionCompositionTypeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "identifier",
          "description": "Unique identifier of this InstructionComposition instance.",
          "range": "string",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeId",
          "description": "Identifier of the underlying trade to which this InstructionComposition relates.",
          "range": "TradeIdentifier",
          "@type": "SlotDefinition"
        },
        {
          "name": "instructionCompositionOutput",
          "description": "Outputs of each Instruction Composition process. The recording of this information will be done in a single step at the end of the process for each Instruction Composition.",
          "range": "InstructionCompositionOutput",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/InstructionComposition",
      "@type": "ClassDefinition"
    },
    {
      "name": "InstructionCompositionOutput",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/InstructionCompositionOutput",
      "description": "Records the relevant output of each Instruction Composition. Will be updated while executing the relevant steps of the Instruction Composition so at the end of the process the output should be completed and ready to use in other parts of the system.",
