    {
      "name": "ResourceTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ResourceTypeEnum",
      "description": "The enumerated values to specify the type of a resource (e.g. document).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common",
      "permissible_values": [
        {
          "text": "Confirmation",
          "description": "Document describing the legal terms of a transaction."
        },
        {
          "text": "SupplementalMaterialEconomicTerms",
          "description": "Document providing supplemental material economic terms to the FpML data representation. The initial intended usage is to fulfill the CFTC Part 45 rule requirement to report \u2018Any other terms(s) of the swap matched or affirmed by the counterparties in verifying the swap\u2019 when the reporting is done via the generic FpML representation."
        },
        {
          "text": "TermSheet",
          "description": "Document describing the economic characteristics of a transaction."
        }
      ]
    },
