      "@type": "ClassDefinition"
    },
    {
      "name": "DateRange",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DateRange",
      "description": "A class defining a contiguous series of calendar dates. The date range is defined as all the dates between and including the start and the end date. The start date must fall on or before the end date.",
      "comments": [
        "Rosetta condition DatesOrdered is not stated in LinkML: startDate <= endDate"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "DateRange_startDate",
        "DateRange_endDate"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DateRange",
      "@type": "ClassDefinition"
    },
    {
      "name": "DateTimeList",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DateTimeList",
      "description": "List of dateTimes.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "dateTimeList__dateTime"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dateTime",
          "description": "The CDM specifies that the zoned date time is to be expressed in accordance with ISO 8601, either as UTC as an offset to UTC.",
          "range": "datetime",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DateTimeList",
      "@type": "ClassDefinition"
    },
    {
      "name": "DirectOrRelativeTime",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/DirectOrRelativeTime",
      "description": "Represents a time definition that can be either an absolute (direct) time or a time calculated relative to another referenced time. Either one directTime or one relativeTime should be provided",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "directOrRelativeTime__directTime",
        "directOrRelativeTime__relativeTime"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "directTime",
          "description": "An absolute time value expressed in a specific time zone.",
          "range": "TimeZone",
          "@type": "SlotDefinition"
        },
        {
          "name": "relativeTime",
          "description": "A time value calculated relative to another reference time.",
          "range": "RelativeTime",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/DirectOrRelativeTime",
      "@type": "ClassDefinition"
    },
    {
      "name": "Frequency",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Frequency",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class for defining a date frequency, e.g. one day, three months, through the combination of an integer value and a standardized period value that is specified as part of an enumeration.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "frequency__periodMultiplier",
        "frequency__period"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "periodMultiplier",
          "description": "A time period multiplier, e.g. 1, 2, or 3. If the period value is T (Term) then period multiplier must contain the value 1.",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "period",
          "description": "A time period, e.g. a day, week, month, year or term of the stream.",
          "range": "PeriodExtendedEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Frequency",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "period",
                "equals_string": "T",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "periodMultiplier",
                "equals_number": 1,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "TermPeriod: FpML specifies that if period value is T (Term) then periodMultiplier must contain the value 1.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "PositivePeriodMultiplier: FpML specifies periodMultiplier as a positive integer.",
          "slot_conditions": [
            {
              "name": "periodMultiplier",
              "minimum_value": 1,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Offset",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Offset",
      "description": "A class defining an offset used in calculating a new date relative to a reference date, e.g. calendar days, business days, commodity Business days, etc.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "is_a": "Period",
      "slots": [
        "period__periodMultiplier",
        "period__period",
        "offset__dayType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dayType",
          "description": "In the case of an offset specified as a number of days, this element defines whether consideration is given as to whether a day is a good business day or not. If a day type of business days is specified then non-business days are ignored when calculating the offset. The financial business centers to use for determination of business days are implied by the context in which this element is used. This element must only be included when the offset is specified as a number of days. If the offset is zero days then the dayType element should not be included.",
          "range": "DayTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Offset",
      "rules": [
        {
          "preconditions": {
            "any_of": [
              {
                "none_of": [
                  {
                    "slot_conditions": [
                      {
                        "name": "period",
                        "value_presence": "PRESENT",
                        "equals_string": "D",
                        "@type": "SlotDefinition"
                      }
                    ],
                    "@type": "AnonymousClassExpression"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "periodMultiplier",
                    "equals_number": 0,
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "dayType",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DayType: FpML specifies that the dayType must only be included when the offset is specified as a number of days, while should not be included if the offset is zero days.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "Period",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Period",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class to define recurring periods or time offsets.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "period__periodMultiplier",
        "period__period"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "periodMultiplier",
          "description": "A time period multiplier, e.g. 1, 2 or 3 etc. A negative value can be used when specifying an offset relative to another date, e.g. -2 days.",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "period",
          "description": "A time period, e.g. a day, week, month or year of the stream. If the periodMultiplier value is 0 (zero) then period must contain the value D (day).",
          "range": "PeriodEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Period",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "periodMultiplier",
                "equals_number": 0,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "period",
                "equals_string": "D",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "DayPeriod: FpML specifies that if the periodMultiplier value is 0 (zero) then period must contain the value D (day).",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PeriodBound",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PeriodBound",
      "description": "Indicator to specify if the period bound is defined as a period and whether the bound is inclusive.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "periodBound__period",
        "periodBound__inclusive"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "period",
          "description": "Specifies the period is to be used as the bound, e.g. 5Y.",
          "range": "Period",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "inclusive",
          "description": "Specifies whether the period bound is inclusive, e.g. for a lower bound, false would indicate greater than, whereas true would indicate greater than or equal to.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PeriodBound",
      "@type": "ClassDefinition"
    },
    {
      "name": "PeriodRange",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PeriodRange",
      "description": "Indicates The period range defined as either a lower and upper period bound, or both.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "periodRange__lowerBound",
        "periodRange__upperBound"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "lowerBound",
          "description": "Specifies the lower bound of a period range, e.g. greater than or equal to 5Y.",
          "range": "PeriodBound",
          "@type": "SlotDefinition"
        },
        {
          "name": "upperBound",
          "description": "Specifies the upper bound of a period range, e.g. less than to 10Y.",
          "range": "PeriodBound",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PeriodRange",
      "all_of": [
        {
          "description": "AtLeastOneOf",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "lowerBound",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "upperBound",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "PeriodicDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PeriodicDates",
      "description": "A class for specifying a calculation period schedule.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "PeriodicDates_startDate",
        "PeriodicDates_endDate",
        "periodicDates__periodFrequency",
        "periodicDates__periodDatesAdjustments",
        "periodicDates__dayType"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "periodFrequency",
          "description": "The frequency at which calculation period end dates occur with the regular part of the calculation period schedule and their roll date convention.",
          "range": "CalculationPeriodFrequency",
          "@type": "SlotDefinition"
        },
        {
          "name": "periodDatesAdjustments",
          "description": "The specification of the business day convention and financial business centers used for adjusting any calculation period date if it would otherwise fall on a day that is not a business day in the specified business center.",
          "range": "BusinessDayAdjustments",
          "@type": "SlotDefinition"
        },
        {
          "name": "dayType",
          "description": "Denotes the enumerated values to specify the day type classification used in counting the number of days between two dates.",
          "range": "DayTypeEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PeriodicDates",
      "@type": "ClassDefinition"
    },
    {
      "name": "RelativeDateOffset",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RelativeDateOffset",
      "description": "A class defining a date (referred to as the derived date) as a relative offset from another date (referred to as the anchor date). If the anchor date is itself an adjustable date then the offset is assumed to be calculated from the adjusted anchor date. A number of different scenarios can be supported, namely; 1) the derived date may simply be a number of calendar periods (days, weeks, months or years) preceding or following the anchor date; 2) the unadjusted derived date may be a number of calendar periods (days, weeks, months or years) preceding or following the anchor date with the resulting unadjusted derived date subject to adjustment in accordance with a specified business day convention, i.e. the derived date must fall on a good business day; 3) the derived date may be a number of business days preceding or following the anchor date. Note that the businessDayConvention specifies any required adjustment to the unadjusted derived date. A negative or positive value in the periodMultiplier indicates whether the unadjusted derived precedes or follows the anchor date. The businessDayConvention should contain a value NONE if the day type element contains a value of Business (since specifying a negative or positive business days offset would already guarantee that the derived date would fall on a good business day in the specified business centers).",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "is_a": "Offset",
      "slots": [
        "period__periodMultiplier",
        "period__period",
        "offset__dayType",
        "relativeDateOffset__businessDayConvention",
        "relativeDateOffset__businessCenters",
        "relativeDateOffset__businessCentersReference",
        "relativeDateOffset__dateRelativeTo",
        "relativeDateOffset__adjustedDate"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "businessDayConvention",
          "description": "The convention for adjusting a date if it would otherwise fall on a day that is not a business day, as specified by an ISDA convention (e.g. Following, Precedent).",
          "range": "BusinessDayConventionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCenters",
          "range": "BusinessCenters",
          "@type": "SlotDefinition"
        },
        {
          "name": "businessCentersReference",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "A pointer style reference to a set of financial business centers defined elsewhere in the document. This set of business centers is used to determine whether a particular day is a business day or not.",
          "range": "BusinessCenters",
          "@type": "SlotDefinition"
        },
        {
          "name": "dateRelativeTo",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the anchor as an href attribute. The href attribute value is a pointer style reference to the element or component elsewhere in the document where the anchor date is defined.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustedDate",
          "description": "The date once the adjustment has been performed. (Note that this date may change if the business center holidays change).",
          "range": "date",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/RelativeDateOffset",
      "@type": "ClassDefinition"
    },
    {
      "name": "RelativeDates",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RelativeDates",
      "description": "A class describing a set of dates defined as relative to another set of dates.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "is_a": "RelativeDateOffset",
      "slots": [
        "period__periodMultiplier",
        "period__period",
        "offset__dayType",
        "relativeDateOffset__businessDayConvention",
        "relativeDateOffset__businessCenters",
        "relativeDateOffset__businessCentersReference",
        "relativeDateOffset__dateRelativeTo",
        "relativeDateOffset__adjustedDate",
        "relativeDates__periodSkip",
        "relativeDates__scheduleBounds"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "periodSkip",
          "description": "The number of periods in the referenced date schedule that are between each date in the relative date schedule. Thus a skip of 2 would mean that dates are relative to every second date in the referenced schedule. If present this should have a value greater than 1.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "scheduleBounds",
          "description": "The first and last dates of a schedule. This can be used to restrict the range of values in a reference series of dates.",
          "range": "DateRange",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/RelativeDates",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "periodSkip",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "periodSkip",
                "minimum_value": 2,
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "PeriodSkipGreaterThanOne: FpML specifies that, if present, the period skip should have a value greater than 1.",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "RelativeTime",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RelativeTime",
      "description": "Defines a time value calculated relative to a reference time. The final value is derived by applying any offset and rounding rules inherited from RelativeTimeOffset to the reference time.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "is_a": "RelativeTimeOffset",
      "slots": [
        "relativeTimeOffset__offsetTimeUnit",
        "relativeTimeOffset__offsetMultiplier",
        "relativeTimeOffset__rounding",
        "relativeTime__timeRelativeTo"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "timeRelativeTo",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The reference time zone or base time from which the relative time is calculated.",
          "range": "TimeZone",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/RelativeTime",
      "@type": "ClassDefinition"
    },
    {
      "name": "RelativeTimeOffset",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RelativeTimeOffset",
      "description": "Describes how a time is offset from a reference point, including the unit, magnitude, and rounding behavior.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "relativeTimeOffset__offsetTimeUnit",
        "relativeTimeOffset__offsetMultiplier",
        "relativeTimeOffset__rounding"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "offsetTimeUnit",
          "description": "The unit of time for the offset (e.g., seconds, minutes, hours, days).",
          "range": "TimeUnitEnum",
          "@type": "SlotDefinition"
        },
        {
          "name": "offsetMultiplier",
          "description": "A time offset multiplier, e.g. 1, 2 or 3 etc. A negative value can be used when specifying a negative offset, e.g. -2 hours.",
          "range": "integer",
          "@type": "SlotDefinition"
        },
        {
          "name": "rounding",
          "description": "Optional rules that define how the calculated time should be rounded after the offset has been applied.",
          "range": "TimeRounding",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/RelativeTimeOffset",
      "@type": "ClassDefinition"
    },
    {
      "name": "TimeRounding",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TimeRounding",
      "description": "Specifies how a calculated time should be rounded, including both the direction of rounding and the unit to which the time is rounded. Rounding is applied after all offsets have been calculated.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "timeRounding__roundingDirection",
        "timeRounding__roundToUnit"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "roundingDirection",
          "description": "The direction in which rounding is performed (e.g., up, down, or to the nearest value).",
          "range": "RoundingDirectionEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "roundToUnit",
          "description": "The time unit to which the value should be rounded (e.g., minute, hour, day).",
          "range": "TimeUnitEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TimeRounding",
      "@type": "ClassDefinition"
    },
    {
      "name": "TimeZone",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TimeZone",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "The time alongside with the timezone location information. This class makes use of the FpML TimezoneLocation construct.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "slots": [
        "timeZone__time",
        "timeZone__location"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "time",
          "description": "The observation time.",
          "range": "time",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "location",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "FpML specifies the timezoneLocationScheme by reference to the Time Zone Database (a.k.a. tz database) maintained by IANA, the Internet Assigned Numbers Authority.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TimeZone",
      "@type": "ClassDefinition"
    },
    {
      "name": "AveragingCalculationMethod",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/AveragingCalculationMethod",
