        "CalculationPeriodData_startDate",
        "CalculationPeriodData_endDate",
        "calculationPeriodData__daysInPeriod",
        "calculationPeriodData__daysInLeapYearPeriod",
        "calculationPeriodData__isFirstPeriod",
        "calculationPeriodData__isLastPeriod"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "daysInPeriod",
          "range": "integer",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
