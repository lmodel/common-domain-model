      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "referenceInformation__noReferenceObligation",
      "description": "Used to indicate that there is no Reference Obligation associated with this Credit Default Swap and that there will never be one.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_asset",
      "slot_uri": "https://w3id.org/lmodel/common-domain-model/noReferenceObligation",
