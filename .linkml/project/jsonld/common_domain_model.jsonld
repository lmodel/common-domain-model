    {
      "name": "PeriodExtendedEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PeriodExtendedEnum",
      "description": "The enumerated values to specify a time period containing the additional value of Term.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime",
      "permissible_values": [
        {
          "text": "H",
          "description": "Hour"
