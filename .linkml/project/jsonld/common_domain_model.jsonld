    {
      "name": "CheckEligibilityResult",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CheckEligibilityResult",
      "description": "Result for the CheckEligibilityByDetails and CheckEligibilityForProduct functions",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "checkEligibilityResult__isEligible",
        "checkEligibilityResult__matchingEligibleCriteria",
        "checkEligibilityResult__eligibilityQuery",
        "checkEligibilityResult__specification"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "isEligible",
          "description": "a simple boolean which is set to true if the asset described in the EligibilityQuery input is eligible",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "matchingEligibleCriteria",
          "description": "if there was a match, this will be the one or more criteria that were supplied in the EligbilityCollateralSpecification which matched with the query input",
          "range": "EligibleCollateralCriteria",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "eligibilityQuery",
          "description": "a copy of the input query that was checked against the eligible collateral specification",
          "range": "EligibilityQuery",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "specification",
          "description": "a copy of the input EligbilityCollateralSpecification that was checked against the query",
          "range": "EligibleCollateralSpecification",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/CheckEligibilityResult",
      "@type": "ClassDefinition"
    },
    {
      "name": "Collateral",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Collateral",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A type for defining the obligations of the counterparty subject to credit support requirements.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "slots": [
        "collateral__independentAmount",
        "collateral__portfolioIdentifier",
        "collateral__collateralPortfolio",
        "collateral__collateralProvisions"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "independentAmount",
          "description": "Independent Amount is an amount that usually less creditworthy counterparties are asked to provide. It can either be a fixed amount or a percentage of the Transaction's value. The Independent Amount can be: (i) transferred before any trading between the parties occurs (as a deposit at a third party's account or with the counterparty) or (ii) callable after trading has occurred (typically because a downgrade has occurred). In situation (i), the Independent Amount is not included in the calculation of Exposure, but in situation (ii), it is included in the calculation of Exposure. Thus, for situation (ii), the Independent Amount may be transferred along with any collateral call. Independent Amount is a defined term in the ISDA Credit Support Annex. ('with respect to a party, the amount specified as such for that party in Paragraph 13; if no amount is specified, zero').",
          "range": "IndependentAmount",
          "@type": "SlotDefinition"
        },
        {
          "name": "portfolioIdentifier",
          "description": "A list of identifiers pointing to the collateral portfolios which contain the collateral which covers a trade.",
          "range": "Identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralPortfolio",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "reference",
              "@type": "Annotation"
            }
          ],
          "description": "The collateral portfolios which contain the collateral which covers a trade. (NB: this can be provided by reference to a global key for each CollateralPortfolio object)",
          "range": "CollateralPortfolio",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "collateralProvisions",
          "description": "specifies the collateral provisions of the product.",
          "range": "CollateralProvisions",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/Collateral",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "collateralPortfolio",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "collateralProvisions",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "CollateralProvisions: When a collateral portfolio is provided, collateral provisions must exists that govern this collateral.",
          "@type": "ClassRule"
        }
      ],
      "all_of": [
        {
          "description": "CollateralExists: Collateral must represent either a simple independent amount or full collateral portfolio.",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "independentAmount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "collateralPortfolio",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "Collateralchoice",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "independentAmount",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "portfolioIdentifier",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "collateralPortfolio",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "independentAmount",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "portfolioIdentifier",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "collateralPortfolio",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CollateralAgreementFloatingRate",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/CollateralAgreementFloatingRate",
      "description": "Represents the parameters needed to calculate the floating rate paid on collateral holdings.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral",
      "is_a": "FloatingRateBase",
