      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "tradableProduct__product",
        "tradableProduct__tradeLot",
        "tradableProduct__counterparty",
        "tradableProduct__ancillaryParty",
        "tradableProduct__adjustment"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "product",
          "description": "The underlying product to be included in a contract or execution.",
          "range": "NonTransferableProduct",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "tradeLot",
          "description": "Specifies the price, quantity and effective date of each trade lot, when the same product may be traded multiple times in different lots with the same counterparty. In a trade increase, a new trade lot is added to the list, with the corresponding effective date. In a trade decrease, the existing trade lot(s) are decreased of the corresponding quantity (and an unwind fee may have to be settled). The multiple cardinality and the ability to increase existing trades is used for Equity Swaps in particular.",
          "range": "TradeLot",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "counterparty",
          "annotations": [
            {
              "tag": "doc_reference",
              "value": "ICMA GMRA namingConvention Party",
              "@type": "Annotation"
            }
          ],
          "description": "Specifies the parties which are the two counterparties to the transaction. The product is agnostic to the actual parties to the transaction, with the party references abstracted away from the product definition and replaced by the counterparty enum (e.g. CounterpartyEnum values Party1 or Party2). The counterparty enum can then be positioned in the product (e.g. to specify which counterparty is the payer, receiver etc) and this counterparties attribute, which is positioned outside of the product definition, allows the counterparty enum to be associated with an actual party reference.",
          "range": "Counterparty",
          "required": true,
          "multivalued": true,
          "minimum_cardinality": 2,
          "maximum_cardinality": 2,
          "@type": "SlotDefinition"
        },
        {
          "name": "ancillaryParty",
          "description": "Specifies the parties with ancillary roles in the transaction. The product is agnostic to the actual parties involved in the transaction, with the party references abstracted away from the product definition and replaced by the AncillaryRoleEnum. The AncillaryRoleEnum can then be positioned in the product and this AncillaryParty type, which is positioned outside of the product definition, allows the AncillaryRoleEnum to be associated with an actual party reference.",
          "range": "AncillaryParty",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "adjustment",
          "description": "Specifies the conditions that govern the adjustment to the quantity of a product being traded: e.g. execution, portfolio rebalancing etc. It is typically used in the context of Equity Swaps.",
          "range": "NotionalAdjustmentEnum",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TradableProduct",
      "@type": "ClassDefinition"
    },
    {
      "name": "TradeLot",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TradeLot",
      "description": "Specifies the price and quantity of a trade lot, where the same product could be traded multiple times with the same counterparty but in different lots (at a different date, in a different quantity and at a different price). One trade lot combined with a product definition specifies the entire economics of a trade. The lifecycle mechanics of each such trade lot (e.g. cashflow payments) is independent of the other lots.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "tradeLot__lotIdentifier",
        "tradeLot__priceQuantity"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "lotIdentifier",
          "description": "Specifies one or more identifiers for the lot, if any.",
          "range": "Identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "priceQuantity",
          "description": "Specifies the settlement characteristics of a trade lot: price, quantity, observable (optionally) and the settlement terms. This attribute has a multiple cardinality to allow to specify the price, quantity and observable of different legs in a single, composite product (e.g. a Swap).",
          "range": "PriceQuantity",
          "required": true,
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TradeLot",
      "@type": "ClassDefinition"
    },
    {
      "name": "TransferableProduct",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TransferableProduct",
      "description": "A TransferableProduct is a type of financial product which can be held or transferred, represented as an Asset with the addition of specific EconomicTerms.",
      "comments": [
        "Rosetta condition AssetPartyRoleExists is not stated in LinkML: asset ->> partyRole exists"
      ],
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "transferableProduct__asset",
        "transferableProduct__economicTerms",
        "transferableProduct__productPartyRole"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "asset",
          "description": "An Asset is defined as something that can be owned and transferred in the financial markets.",
          "range": "Asset",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "economicTerms",
          "description": "The price forming features, including payouts and provisions.",
          "range": "EconomicTerms",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "productPartyRole",
          "description": "Overrides the parties on the trade to identify the party with the obligation to pay dividends or coupons, e.g issuer.",
          "range": "CounterpartyRoleEnum",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/TransferableProduct",
      "@type": "ClassDefinition"
    },
    {
      "name": "Underlier",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/Underlier",
      "annotations": [
        {
          "tag": "rosetta_choice",
          "value": "true",
          "@type": "Annotation"
        }
      ],
      "description": "The underlying financial product that will be physically or cash settled, which can be of any type, eg an asset such as cash or a security, a product, or the cash settlement of an index rate. Conditions are usually applied when used in a data type, such as a payout, to ensure this aligns with the use case.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_product_template",
      "slots": [
        "underlier__Observable",
        "underlier__Product"
      ],
      "slot_usage": {},
