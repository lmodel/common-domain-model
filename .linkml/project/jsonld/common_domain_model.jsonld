        },
        {
          "name": "presentValueAmount",
          "description": "The amount representing the present value of the forecast payment.",
          "range": "Money",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/PaymentDiscounting",
      "@type": "ClassDefinition"
