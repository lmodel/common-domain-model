    {
      "name": "MaturityTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MaturityTypeEnum",
      "description": "Represents an enumeration list to identify the Maturity.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "RemainingMaturity",
          "description": "Denotes a period from now until maturity date."
        },
        {
          "text": "OriginalMaturity",
          "description": "Denotes a period from issuance until maturity date."
        },
        {
          "text": "FromIssuance",
          "description": "Denotes a period from issuance date until now."
        }
      ]
    },
    {
      "name": "MoneyMarketTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/MoneyMarketTypeEnum",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "CommercialPaper"
        },
        {
          "text": "CertificateOfDeposit"
        }
      ]
    },
    {
      "name": "ProductIdTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/ProductIdTypeEnum",
      "description": "Provides the enumerated values to specify the product identifier source.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "BBGID",
          "description": "Published by Bloomberg, the BBGID is a 12-digit alphanumeric randomly generated ID covering active and non-active securities."
        },
        {
          "text": "BBGTICKER",
          "description": "Published by Bloomberg as a short code to identify publicly trades shares of a particular stock on a specific exchange."
        },
        {
          "text": "CUSIP",
          "description": "Derived from the Committee on Uniform Security Identification Procedures, CUSIPs are 9-character identifiers that capture an issue\u2019s important differentiating characteristics for issuers and their financial instruments in the U.S. and Canada."
        },
        {
          "text": "FIGI",
          "description": "Issued under the guidelines of the Object Management Group, the Financial Instrument Global Identifier (FIGI) is a 12 character, alphanumeric, randomly generated ID covering hundreds of millions of active and inactive instruments. The identifier acts as a Uniform Resource Identifier (URI) to link to a set of metadata that uniquely and clearly describes the instrument."
        },
        {
          "text": "ISDACRP",
          "description": "Issued by the International Swaps Dealers Association as a string representing a Commodity Reference Price used for purposes of determining a relevant price for an underlying commodity in an OTC derivatives contract."
        },
        {
          "text": "ISIN",
          "description": "Issued by The International Securities Identification Number (ISIN) Organization, the ISIN is a 12-character alpha-numerical code used to uniformly identify a security for trading and settlement purposes. Securities with which ISINs can be used include debt securities, such as notes or bonds as well shares, such as common stock or shares of a fund, options, derivatives, and futures. The ISIN structure is defined in ISO 6166."
        },
        {
          "text": "Name",
          "description": "The name of the product."
        },
        {
          "text": "REDID",
          "description": "Assigned by S&P Global Market Intelligence, REDID (Reference Entity Data Identifier) is a unique alphanumeric code to reference entities, primarily utilized within the credit derivatives market for the standardized identification of underlying entities."
        },
        {
          "text": "RIC",
          "description": "Issued by Refinitiv (formerly Reuters), the Reuters Instrument Codes(RIC) uniquely identifies financial instruments, including where they are traded."
        },
        {
          "text": "Other",
          "description": "Used when the source is not otherwise in this enumerated list because it is internal or other reasons. The source can be identified in the scheme which is part of the identifier attribute."
        },
        {
          "text": "Sicovam",
          "description": "Issued by the French Soci\u00e9t\u00e9 Interprofessionnelle pour la Compensation des Valeurs Mobili\u00e8res (SICOVAM) to identify French securities listed on French stock exchanges."
        },
        {
          "text": "SEDOL",
          "description": "Assigned by the London Stock Exchange, the Stock Exchange Daily Official List (SEDOL) is a list of security identifiers used in the United Kingdom and Ireland for clearing purposes. SEDOLs serve as the National Securities Identifying Number for all securities issued in the United Kingdom and are therefore part of the security's ISIN as well."
        },
        {
          "text": "UPI",
          "description": "Assigned by the Derivatives Service Bureau Ltd (DSB), the Unique Product Identifier (UPI) is a unique code to describe an over-the-counter (OTC) derivatives product. The UPI is used for identifying the product in transaction reporting data."
        },
        {
          "text": "Valoren",
          "description": "Assigned by SIX Financial Information, Valoren is a unique numerical identification number typically ranging from six to nine digits primarily traded in Switzerland, Liechtenstein, and Belgium. This code enables the identification of securities such as stocks, bonds, and investment funds within these markets."
        },
        {
          "text": "Wertpapier",
          "description": "Issued by the Institute for the Issuance and Administration of Securities in Germany (Securities Information), the Wertpapierkennnummer (WKN, WPKN, WPK or simply Wert) consists of six digits or capital letters (excluding I and O), and no check digit. It is used to identify German securities."
        }
      ]
    },
    {
      "name": "PropertyTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PropertyTypeEnum",
      "description": "Specifies different types of property.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "Commercial",
          "description": "Commercial property."
        },
        {
          "text": "Residential",
          "description": "Residential property."
        }
      ]
    },
    {
      "name": "PutCallEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/PutCallEnum",
      "description": "The enumerated values to specify the types of listed derivative options.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "Put",
          "description": "A put option gives the holder the right to sell the underlying asset by a certain date for a certain price."
        },
        {
          "text": "Call",
          "description": "A call option gives the holder the right to buy the underlying asset by a certain date for a certain price."
        }
      ]
    },
    {
      "name": "RedemptionPartyEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RedemptionPartyEnum",
      "description": "Specifies the redeeming party of a debt security.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "Holder",
          "description": "Specifies the holder of a debt security."
        },
        {
          "text": "Issuer",
          "description": "Specifies the issuer of a debt security."
        }
      ]
    },
    {
      "name": "RedemptionTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/RedemptionTypeEnum",
      "description": "Specifies the contractual redemption or conversion features associated with a debt security.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "Convertible",
          "description": "Specifies a debt instrument that can be converted into common shares."
        },
        {
          "text": "Exchangeable",
          "description": "Specifies a debt security that can be converted to equity in a company other than the issuing company."
        },
        {
          "text": "ContingentConvertible",
          "description": "Specifies a debt security that can be converted into equity if a pre-defined trigger event occurs."
        },
        {
          "text": "Sinkable",
          "description": "Specifies a debt security that requires the issuer to periodically set aside money to buy back portions of the debt."
        },
        {
          "text": "Extraordinary",
          "description": "Specifies a debt security that can be redeemed early if certain extraordinary events occur."
        }
      ]
    },
    {
      "name": "SecuredTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SecuredTypeEnum",
      "description": "Specifies the type of secured debt.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "AssetBacked",
          "description": "Debt instrument with periodic income payments and value derived from or backed by a specified pool of underlying assets."
        },
        {
          "text": "CollateralizedObligation",
          "description": "Complex product that is backed by a pool of loans and other assets and sold to institutional investors."
        },
        {
          "text": "CoveredBonds",
          "description": "Specifies a debt obligations issued by credit institutions which offer a so-called double-recourse protection to bondholders."
        }
      ]
    },
    {
      "name": "SecurityTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SecurityTypeEnum",
      "description": "Represents an enumeration list to indentify the type of a security.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "Debt",
          "description": "Identifies a security as a fixed income security of debt issued and securitized as a tradable asset."
        },
        {
          "text": "Equity",
          "description": "Identifies a security as an Equity value of holding of shares in listed company."
        },
        {
          "text": "Fund",
          "description": "Identifies a security as representing holding in an investment fund."
        },
        {
          "text": "Warrant",
          "description": "Identifies a security as a Warrant that give the right, but not the obligation, to buy or sell a security \u2014 most commonly an equity \u2014 at a certain price before expiration, or to receive the cash equivalent."
        },
        {
          "text": "Certificate",
          "description": "Identifies a security as one that that offers a derivative-based economic return which is not structured as a bond, an equity or a warrant. Note that this security type is not a Certificate of Deposit (aka CD)."
        }
      ]
    },
    {
      "name": "SupraNationalIssuerTypeEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/SupraNationalIssuerTypeEnum",
      "description": "Represents an enumeration list to identify the type of supranational entity issuing the asset.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "InternationalOrganisation",
          "description": "Specifies International Financial Institution."
        },
        {
          "text": "MultilateralBank",
          "description": "Specifies Multilateral Bank or Multilateral Development Bank."
        }
      ]
    },
    {
      "name": "TaxonomySourceEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/TaxonomySourceEnum",
      "description": "Represents the enumerated values to specify taxonomy sources.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "CFI",
          "description": "Represents the ISO 10962 Classification of Financial Instruments code."
        },
        {
          "text": "ISDA",
          "description": "Represents the ISDA product taxonomy."
        },
        {
          "text": "ICAD",
          "description": "Represents the ISDA Collateral Asset Definition Identifier code."
        },
        {
          "text": "EMIR",
          "description": "Represents the EMIR Article 9 Asset Definition Identifier code."
        },
        {
          "text": "EU_EMIR_EligibleCollateralAssetClass",
          "description": "Identifies European Union Eligible Collateral Assets classification categories based on EMIR Uncleared Margin Rules."
        },
        {
          "text": "UK_EMIR_EligibleCollateralAssetClass",
          "description": "Identifies United Kingdom Eligible Collateral Assets classification categories based on UK Onshored EMIR Uncleared Margin Rules Eligible Collateral asset classes for both initial margin (IM) and variation margin (VM) posted and collected between specified entities.Please note: UK EMIR regulation will detail which eligible collateral assets classes apply to each type of entity pairing (counterparty) and which apply to posting of IM and VM."
        },
        {
          "text": "CFTC",
          "description": "Represents the Commodity Futures Trading Commission (CFTC) as a taxonomy source."
        },
        {
          "text": "US_CFTC_PR_EligibleCollateralAssetClass",
          "description": "Identifies US Eligible Collateral Assets classification categories based on Uncleared Margin Rules published by the CFTC and the US Prudential Regulator. Note: While the same basic categories exist in the CFTC and US Prudential Regulators margin rules, the precise definitions or application of those rules could differ between the two rules."
        },
        {
          "text": "MAS",
          "description": "Represents the Monetary Authority of Singapore (MAS) as a taxonomy source."
        },
        {
          "text": "CSA",
          "description": "Represents the Canadian Securities Administrators (CSA) as a taxonomy source."
        },
        {
          "text": "Other",
          "description": "Denotes a user-specific scheme or taxonomy or other external sources not listed here."
        }
      ]
    },
    {
      "name": "UK_EMIR_EligibleCollateralEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/UKEMIREligibleCollateralEnum",
      "description": "Identifies United Kingdom Eligible Collateral Assets classification categories based on UK Onshored EMIR Uncleared Margin Rules. Eligible Collateral asset classes for both initial margin (IM) and variation margin (VM) posted and collected between specified entities. Please note: UK EMIR regulation will detail which eligible collateral assets classes apply to each type of entity pairing (counterparty) and which apply to posting of IM and VM.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "UK_EMIRTypeA",
          "description": "Denotes cash in the form of money credited to an account in any currency, or similar claims for the repayment of money, such as money market deposits."
        },
        {
          "text": "UK_EMIRTypeB",
          "description": "Denotes gold in the form of allocated pure gold bullion of recognised good delivery."
        },
        {
          "text": "UK_EMIRTypeC",
          "description": "Denotes debt securities issued by the central government of the United Kingdom or the Bank of England."
        },
        {
          "text": "UK_EMIRTypeD",
          "description": "Denotes debt securities issued by United Kingdom regional governments or local authorities whose exposures are treated as exposures to the central government of the United Kingdom in accordance with Article 115(2) of Regulation (EU) No 575/2013."
        },
        {
          "text": "UK_EMIRTypeE",
          "description": "Denotes debt securities issued by United Kingdom public sector entities whose exposures are treated as exposures to the central government, regional government or local authority of the United Kingdom in accordance with Article 116(4) of Regulation (EU) No 575/2013."
        },
        {
          "text": "UK_EMIRTypeF",
          "description": "Denotes debt securities issued by United Kingdom regional governments or local authorities other than those referred to in (TypeD)."
        },
        {
          "text": "UK_EMIRTypeG",
          "description": "Denotes debt securities issued by United Kingdom public sector entities other than those referred to in (TypeE)."
        },
        {
          "text": "UK_EMIRTypeH",
          "description": "Denotes debt securities issued by multilateral development banks listed in Article 117(2) of Regulation (EU) No 575/2013."
        },
        {
          "text": "UK_EMIRTypeI",
          "description": "Denotes debt securities issued by the international organisations listed in Article 118 of Regulation (EU) No 575/2013."
        },
        {
          "text": "UK_EMIRTypeJ",
          "description": "Denotes debt securities issued by third countries' governments or central banks."
        },
        {
          "text": "UK_EMIRTypeK",
          "description": "Denotes debt securities issued by third countries' regional governments or local authorities that meet the requirements of (TypeD) and (TypeE)."
        },
        {
          "text": "UK_EMIRTypeL",
          "description": "Denotes debt securities issued by third countries' regional governments or local authorities other than those referred to in (TypeD) and (TypeE)."
        },
        {
          "text": "UK_EMIRTypeM",
          "description": "Denotes debt securities issued by credit institutions or investment firms including bonds admitted to the register of regulated covered bonds maintained under Regulation 7(1)(b) of the Regulated Covered Bonds Regulations 2008 (SI 2008/346)."
        },
        {
          "text": "UK_EMIRTypeN",
          "description": "Denotes corporate bonds."
        },
        {
          "text": "UK_EMIRTypeO",
          "description": "Denotes the most senior tranche of a securitisation, as defined in Article 4(61) of Regulation (EU) No 575/2013, that is not a re-securitisation as defined in Article 4(63) of that Regulation."
        },
        {
          "text": "UK_EMIRTypeP",
          "description": "Denotes convertible bonds provided that they can be converted only into equities which are included in an index specified pursuant to point (a) of Article 197 (8) of Regulation (EU) No 575/2013."
        },
        {
          "text": "UK_EMIRTypeQ",
          "description": "Denotes equities included in an index specified pursuant to point (a) of Article 197(8) of Regulation (EU) No 575/2013."
        },
        {
          "text": "UK_EMIRTypeR",
          "description": "Denotes shares or units in undertakings for UK UCITS, provided that the conditions set out in Article 5 of EU Regulation 2016/2251 (as modified by the Technical Standards (European Market Infrastructure) (EU Exit) (No. 3) Instrument 2019) are met."
        }
      ]
    },
    {
      "name": "US_CFTC_PR_EligibleCollateralEnum",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/USCFTCPREligibleCollateralEnum",
      "description": "Identifies US Eligible Collateral Assets classification categories based on Uncleared Margin Rules published by the CFTC and the US Prudential Regulator. Note: While the same basic categories exist in the CFTC and US Prudential Regulators margin rules, the precise definitions or application of those rules could differ between the two rules.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common",
      "permissible_values": [
        {
          "text": "US_CFTC_PRType1",
          "description": "Denotes immediately available cash funds denominated in USD, a major currency, a currency of settlement for the uncleared swap."
        },
        {
          "text": "US_CFTC_PRType2",
          "description": "Denotes a security that is issued by, or unconditionally guaranteed as to the timely payment of principal and interest by, the U.S. Department of the Treasury."
        },
        {
          "text": "US_CFTC_PRType3",
          "description": "Denotes a security that is issued by, or unconditionally guaranteed as to the timely payment of principal and interest by, a U.S. government agency (other than the U.S. Department of Treasury) whose obligations are fully guaranteed by the full faith and credit of the United States government."
        },
        {
          "text": "US_CFTC_PRType4",
          "description": "Denotes a security that is issued by, or fully guaranteed as to the payment of principal and interest by, the European Central Bank or a sovereign entity that is assigned no higher than a 20 percent risk weight under the capital rules applicable to swap dealers subject to regulation by a prudential regulator."
        },
        {
          "text": "US_CFTC_PRType5A",
          "description": "Denotes a publicly traded debt security issued by, or an asset-backed security fully guaranteed as to the timely payment of principal and interest by, a U.S. Government-sponsored enterprise that is operating with capital support or another form of direct financial assistance received from the U.S. government that enables the repayments of the U.S. Government-sponsored enterprise's eligible securities."
        },
        {
          "text": "US_CFTC_PRType5B",
          "description": "Denotes a publicly traded debt security, but not an asset backed security, that is investment grade and issued by a U.S. Government-sponsored enterprise that is not operating with capital support or another form of direct financial assistance received from the U.S. government."
        },
        {
          "text": "US_CFTC_PRType6",
          "description": "Denotes a security that is issued by, or fully guaranteed as to the payment of principal and interest by, the Bank for International Settlements, the International Monetary Fund, or a multilateral development bank."
        },
        {
          "text": "US_CFTC_PRType7",
          "description": "Denotes publicly-traded debt, but not an asset backed security, that is investment grade and is not a debt security issued by a U.S. Government-sponsored enterprise. This category excludes a security issued by a non-bank financial institution supervised by the board of governors of the Federal Reserve System under Title I of the Dodd-Frank Wall Street Reform and Consumer Protection Act. This category also excludes a security issued by any of the following entities, by a company that would be any of the following entities if it were the organized under the laws of the United States or any State, or in either case by an affiliate of such an entity: the party posting the collateral, a bank holding company, a savings and loan holding company, a U.S. intermediate holding company, a foreign bank, a depositary institution, a securities holding company, a broker, a dealer, a futures commission merchant, a swap dealer, or a security-based swap dealer."
        },
        {
          "text": "US_CFTC_PRType8A",
          "description": "Denotes a publicly traded common equity security that is included in the Standard & Poor's Composite 500 Index or related indexes. This category excludes a security issued by a non-bank financial institution supervised by the board of governors of the Federal Reserve System under Title I of the Dodd-Frank Wall Street Reform and Consumer Protection Act. This category also excludes a security issued by any of the following entities, by a company that would be any of the following entities if it were the organized under the laws of the United States or any State, or in either case by an affiliate of such an entity: the party posting the collateral, a bank holding company, a savings and loan holding company, a U.S. intermediate holding company, a foreign bank, a depositary institution, a securities holding company, a broker, a dealer, a futures commission merchant, a swap dealer, or a security-based swap dealer."
        },
        {
          "text": "US_CFTC_PRType8B",
          "description": "Denotes a publicly traded common equity security that is included in the Standard & Poor's Composite 1500 Index or related indexes. This category excludes a security issued by a non-bank financial institution supervised by the board of governors of the Federal Reserve System under Title I of the Dodd-Frank Wall Street Reform and Consumer Protection Act. This category also excludes a security issued by any of the following entities, by a company that would be any of the following entities if it were the organized under the laws of the United States or any State, or in either case by an affiliate of such an entity: the party posting the collateral, a bank holding company, a savings and loan holding company, a U.S. intermediate holding company, a foreign bank, a depositary institution, a securities holding company, a broker, a dealer, a futures commission merchant, a swap dealer, or a security-based swap dealer."
        },
        {
          "text": "US_CFTC_PRType8C",
          "description": "Denotes a publicly traded common equity security that is included in an index that a regulated swap entity's supervisor in a foreign jurisdiction recognizes for purposes of including publicly traded common equity as initial margin under applicable regulatory policy, if held in that foreign jurisdiction. This category excludes a security issued by a non-bank financial institution supervised by the board of governors of the Federal Reserve System under Title I of the Dodd-Frank Wall Street Reform and Consumer Protection Act. This category also excludes a security issued by any of the following entities, by a company that would be any of the following entities if it were the organized under the laws of the United States or any State, or in either case by an affiliate of such an entity: the party posting the collateral, a bank holding company, a savings and loan holding company, a U.S. intermediate holding company, a foreign bank, a depositary institution, a securities holding company, a broker, a dealer, a futures commission merchant, a swap dealer, or a security-based swap dealer."
        },
        {
          "text": "US_CFTC_PRType9",
          "description": "Denotes securities in the form of redeemable securities in a pooled investment fund representing the security-holder's proportional interest in the fund's net assets and that are issued and redeemed only on the basis of the market value of the fund's net assets prepared each business day after the security-holder makes its investment commitment or redemption request to the fund, if the fund's investments are limited to the following: (A) securities that are issued by, or unconditionally guaranteed as to the timely payment of principal and interest by, the U.S. Department of the Treasury, and immediately-available cash funds denominated in U.S. dollars; or (B) securities denominated in a common currency and issued by, or fully guaranteed as to the payment of principal and interest by, the European Central Bank or a sovereign entity that is assigned no higher than a 20 percent risk weight under the capital rules applicable to swap dealers subject to regulation by a prudential regulator, and immediately-available cash funds denominated in the same currency; and (C) assets of the fund may not be transferred through securities lending, securities borrowing, repurchase agreements, reverse repurchase agreements, or other means that involve the fund having rights to acquire the same or similar assets from the transferee."
        },
        {
          "text": "US_CTFC_PRType10",
          "description": "Denotes Gold."
        }
      ]
    },
