              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "GoverningLawOtherThenProvided: A validation rule to ensure that if the value from the Governing Law Enum is 'OTHER', governingLawIfOther exists.",
          "@type": "ClassRule"
        }
