    {
      "name": "NaturalPerson",
      "definition_uri": "https://w3id.org/lmodel/common-domain-model/NaturalPerson",
      "annotations": [
        {
          "tag": "rosetta_metadata",
          "value": "key",
          "@type": "Annotation"
        }
      ],
      "description": "A class to represent the attributes that are specific to a natural person.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party",
      "slots": [
        "naturalPerson__personId",
        "naturalPerson__honorific",
        "naturalPerson__firstName",
        "naturalPerson__middleName",
        "naturalPerson__initial",
        "naturalPerson__surname",
        "naturalPerson__suffix",
        "naturalPerson__dateOfBirth",
        "naturalPerson__contactInformation"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "personId",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "The identifier associated with a person, e.g. the internal identification code.",
          "range": "PersonIdentifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "honorific",
          "description": "An honorific title, such as Mr., Ms., Dr. etc.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "firstName",
          "description": "The natural person's first name. It is optional in FpML.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "middleName",
          "description": "The natural person's middle name(s). If a middle name is provided then an initial should be absent.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "initial",
          "description": "The natural person's middle initial(s). If a middle initial is provided then a name should be absent.",
          "range": "string",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "surname",
          "description": "The natural person's surname.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "suffix",
          "description": "Name suffix, such as Jr., III, etc.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "dateOfBirth",
          "description": "The natural person's date of birth.",
          "range": "date",
          "@type": "SlotDefinition"
        },
        {
          "name": "contactInformation",
          "description": "The contact information for such person, when different from the contact information associated with the party.",
          "range": "ContactInformation",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/NaturalPerson",
      "all_of": [
        {
          "description": "NameOrIdChoice",
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "firstName",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                },
                {
                  "name": "surname",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "personId",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "description": "NaturalPersonChoice: Choice rule to represent an FpML choice construct.",
          "exactly_one_of": [
            {
              "slot_conditions": [
                {
                  "name": "middleName",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "initial",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "all_of": [
                {
                  "slot_conditions": [
                    {
                      "name": "middleName",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                },
                {
                  "slot_conditions": [
                    {
                      "name": "initial",
                      "value_presence": "ABSENT",
                      "@type": "SlotDefinition"
                    }
                  ],
                  "@type": "AnonymousClassExpression"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
