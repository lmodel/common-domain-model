      "definition_uri": "https://w3id.org/lmodel/common-domain-model/BaseAndEligibleCurrency",
      "description": "The base and eligible currency(ies) for the document as specified by the parties to the agreement.",
      "from_schema": "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa",
      "slots": [
        "baseAndEligibleCurrency__baseCurrency",
        "baseAndEligibleCurrency__baseCurrencyTerminationCurrency",
        "baseAndEligibleCurrency__baseCurrencyOther",
        "baseAndEligibleCurrency__eligibleCurrency",
        "baseAndEligibleCurrency__eligibleCurrencyInclBaseCurrency",
        "baseAndEligibleCurrency__eligibleCurrencyOther"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "baseCurrency",
          "description": "The common agreed currency into which relevant amounts of all collateral arrangements between the parties are converted, or if not an actual currency, the process through which this is determined. Where hardcoded (e.g. under the 1994 ISDA Credit Support Annex (Security Interest NY Law)), the currency that effectively performs this function.",
          "range": "ISOCurrencyCodeEnum",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "baseCurrencyTerminationCurrency",
          "description": "A flag detailing whether the Base Currency is set to the Termination Currency as defined in the related Master Agreement.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "baseCurrencyOther",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Utilised where the clause data structure is not able to capture a material aspect of the clause.",
          "range": "string",
          "@type": "SlotDefinition"
        },
        {
          "name": "eligibleCurrency",
          "description": "A definition of a currency agreed by the parties, typically to indicate the currencies of eligible cash collateral.",
          "range": "ISOCurrencyCodeEnum",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "eligibleCurrencyInclBaseCurrency",
          "description": "A flag detailing whether the Base Currency is included as an Eligible Currency.",
          "range": "boolean",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "eligibleCurrencyOther",
          "annotations": [
            {
              "tag": "rosetta_metadata",
              "value": "scheme",
              "@type": "Annotation"
            }
          ],
          "description": "Utilised where the clause data structure is not able to capture a material aspect of the clause.",
          "range": "string",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/common-domain-model/BaseAndEligibleCurrency",
      "@type": "ClassDefinition"
    },
