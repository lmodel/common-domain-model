<https://w3id.org/lmodel/common-domain-model/WeightedAveragingObservation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:WeightedAveragingObservation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: PositiveObservationNumber — if observationNumber exists then observationNumber >= 0",
        "Rosetta condition: PositiveWeight — weight >= 0.0",
        "Rosetta condition: WeightedAveragingObservationChoice — required choice dateTime, observationNumber" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/observationNumber> ] ;
            linkml:description " FpML specifies observationNumber as a positive integer." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/observationNumber> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description " FpML specifies observationNumber as a non-negative decimal." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/weight> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description " Choice rule to represent an FpML choice construct between date times for literal date values, and observation numbers for schedule generated observations." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dateTime> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/observationNumber> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/WeightedAveragingObservation"^^xsd:anyURI ;
    linkml:description "A single weighted averaging observation." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/WeightedAveragingObservation_dateTime>,
        <https://w3id.org/lmodel/common-domain-model/WeightedAveragingObservation_weight>,
        <https://w3id.org/lmodel/common-domain-model/observationNumber> .

<https://w3id.org/lmodel/common-domain-model/WorkflowStepApproval> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_workflow> ;
    skos:exactMatch "common_domain_model:WorkflowStepApproval"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_ProposedWorkflowStep — Represents the proposal to create a business event that results in a workflow step containing an instruction, message details, identifiers, event timestamps, parties and accounts. The optional previous workflow step input provides workflow lineage to where there has been a correction or cancellation to the proposed step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_ProposedWorkflowStep\",\"description\":\"Represents the proposal to create a business event that results in a workflow step containing an instruction, message details, identifiers, event timestamps, parties and accounts. The optional previous workflow step input provides workflow lineage to where there has been a correction or cancellation to the proposed step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New.\",\"inputs\":[{\"name\":\"messageInformation\",\"type\":\"MessageInformation\",\"cardinality\":\"0..1\"},{\"name\":\"timestamp\",\"type\":\"EventTimestamp\",\"cardinality\":\"1..*\"},{\"name\":\"eventIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"1..*\"},{\"name\":\"party\",\"type\":\"Party\",\"cardinality\":\"0..*\"},{\"name\":\"account\",\"type\":\"Account\",\"cardinality\":\"0..*\"},{\"name\":\"previousWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"0..1\"},{\"name\":\"action\",\"type\":\"ActionEnum\",\"cardinality\":\"1..1\"},{\"name\":\"proposedEvent\",\"type\":\"EventInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"approval\",\"type\":\"WorkflowStepApproval\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"proposedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/WorkflowStepApproval"^^xsd:anyURI ;
    linkml:description "Party approvals associated to the current WorkflowStep. " ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/WorkflowStepApproval_party>,
        <https://w3id.org/lmodel/common-domain-model/WorkflowStepApproval_timestamp>,
        <https://w3id.org/lmodel/common-domain-model/approved>,
        <https://w3id.org/lmodel/common-domain-model/rejectedReason> .

<https://w3id.org/lmodel/common-domain-model/adjustedDate> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AdjustableDate.adjustedDate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/adjustedDate"^^xsd:anyURI ;
    linkml:description "The date once the adjustment has been performed. (Note that this date may change if the business center holidays change)." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AdjustableDate>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableDates>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedOrRelativeDate>,
        <https://w3id.org/lmodel/common-domain-model/ObservationDate>,
        <https://w3id.org/lmodel/common-domain-model/RelativeDateOffset> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ObservationDate> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/adjustedDate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/isSpecified> a linkml:SlotDefinition ;
