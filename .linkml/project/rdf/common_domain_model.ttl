    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_Workflow\",\"description\":\"Function to create a Workflow from a list of WorkflowStep.\",\"inputs\":[{\"name\":\"steps\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..*\"}],\"output\":{\"name\":\"workflow\",\"type\":\"Workflow\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Workflow"^^xsd:anyURI ;
    linkml:description "A collection of workflow steps which together make up an entire workflow sequence." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/steps> .

<https://w3id.org/lmodel/common-domain-model/accrualFactor> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AdjustmentFactorCalculationTerms.accrualFactor"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/accrualFactor"^^xsd:anyURI ;
    linkml:description "The accrual rate and related terms, to adjust the price of an underlier impacted by a Corporate Action when economic impact consists in freezing the underlier price to last fixing and applying accruals for each remaining underlier price fixing date required i.e. for each, adjustedPrice = lastFixingPrice x (1 + accrualRate x DCF)." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AdjustmentFactorCalculationTerms> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/AdjustmentFactorCalculationTerms> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/AccrualFactor> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/accrualFactor"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/accruedInterest> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CashSettlementTerms.accruedInterest"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/accruedInterest"^^xsd:anyURI ;
    linkml:description "Indicates whether accrued interest is included (true) or not (false). For cash settlement this specifies whether quotations should be obtained inclusive or not of accrued interest. For physical settlement this specifies whether the buyer should deliver the obligation with an outstanding principal balance that includes or excludes accrued interest. ISDA 2003 Term: Include/Exclude Accrued Interest." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CashSettlementTerms>,
        <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/accruedInterest"^^xsd:anyURI .

