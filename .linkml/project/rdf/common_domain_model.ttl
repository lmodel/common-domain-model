<https://w3id.org/lmodel/common-domain-model/SecurityLocate> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_position> ;
    skos:exactMatch "common_domain_model:SecurityLocate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_position"^^xsd:anyURI ;
    skos:note "Rosetta condition: RequestOneSecurityMinimum — availableInventoryRecord exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "A locate must request the availability of at least one security." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/availableInventoryRecord> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SecurityLocate"^^xsd:anyURI ;
    linkml:description "A locate is an approval from a broker that needs to be obtained prior to effecting a short sale in an equity security. Similar to security availability, a borrower can request a single or multiple securities, but at least one must be requested." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/AvailableInventory> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AvailableInventory_identifer>,
        <https://w3id.org/lmodel/common-domain-model/AvailableInventory_party>,
        <https://w3id.org/lmodel/common-domain-model/AvailableInventory_partyRole>,
        <https://w3id.org/lmodel/common-domain-model/availableInventoryRecord>,
        <https://w3id.org/lmodel/common-domain-model/availableInventoryType>,
        <https://w3id.org/lmodel/common-domain-model/comment>,
        <https://w3id.org/lmodel/common-domain-model/messageInformation> ;
    linkml:tree_root true .

<https://w3id.org/lmodel/common-domain-model/SellerDecisionMaker> linkml:description "The party or person who, having legal authority to act on behalf of the trade counterparty acting as Seller as defined in this coding scheme, made the decision to sell the financial instrument. Corresponds to 'seller decision maker' as defined in ESMA\\'s MIFIR RTS 23 report. This does not refer to the decision maker for what is traditionally called the 'Sell side'; for that, see the 'Trader' person role." ;
    linkml:meaning "http://www.fpml.org/coding-scheme/party-role-4-0#SellerDecisionMaker"^^xsd:anyURI .

