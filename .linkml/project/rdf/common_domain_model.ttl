	linkml:range <https://w3id.org/lmodel/common-domain-model/FxSpotRateSource> , <https://w3id.org/lmodel/common-domain-model/InformationSource> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/informationSource__sourcePage> a linkml:SlotDefinition ;
