	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/strikeFactor> a linkml:SlotDefinition ;
	linkml:description "The factor of strike." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> .
<https://w3id.org/lmodel/common-domain-model/strikePrice> a linkml:SlotDefinition ;
