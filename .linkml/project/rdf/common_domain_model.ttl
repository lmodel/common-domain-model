<https://w3id.org/lmodel/common-domain-model/timeRounding__roundingDirection> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
	skos:prefLabel "roundingDirection" ;
	linkml:description "The direction in which rounding is performed (e.g., up, down, or to the nearest value)." ;
