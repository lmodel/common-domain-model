<https://w3id.org/lmodel/common-domain-model/balanceOfFirstPeriod> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CalculationPeriodFrequency.balanceOfFirstPeriod"^^xsd:anyURI ;
