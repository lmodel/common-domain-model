	skos:prefLabel "designatedPriority" ;
	linkml:annotations _:c14n1286 ;
	linkml:description "Applies to Loan CDS, to indicate what lien level is appropriate for a deliverable obligation. Applies to European Loan CDS, to indicate the Ranking of the obligation. Example: a 2nd lien Loan CDS would imply that the deliverable obligations are 1st or 2nd lien loans." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Obligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Obligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/designatedPriority"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/obligations__excluded> a linkml:SlotDefinition ;
