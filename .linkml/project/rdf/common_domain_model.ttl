    linkml:abstract true ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Product"^^xsd:anyURI ;
    linkml:description "Enables either a TransferableProduct or a NonTransferableProduct to be used in an underlier." ;
