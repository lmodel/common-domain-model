	linkml:range <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/floatingRateIndex"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/fallbackRateParameters__spreadAdjustment> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_calculatedrate"^^xsd:anyURI ;
	skos:prefLabel "spreadAdjustment" ;
