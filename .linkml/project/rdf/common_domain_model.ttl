<https://w3id.org/lmodel/common-domain-model/PhysicalSettlementPeriod> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement> ;
    skos:exactMatch "common_domain_model:PhysicalSettlementPeriod"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
    skos:note "Rosetta condition: BusinessDays — if businessDays exists then businessDays >= 0",
