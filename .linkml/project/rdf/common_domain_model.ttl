<https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:ExerciseFeeSchedule"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: ExerciseFeeScheduleChoice — required choice feeAmountSchedule, feeRateSchedule" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/feeAmountSchedule> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/feeRateSchedule> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule"^^xsd:anyURI ;
    linkml:description "A class to define a fee or schedule of fees to be payable on the exercise of an option. This fee may be defined as an amount or a percentage of the notional exercised. As a difference with FpML, it extends the BuyerSeller class." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/PayerReceiver> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/feeAmountSchedule>,
        <https://w3id.org/lmodel/common-domain-model/feePaymentDate>,
        <https://w3id.org/lmodel/common-domain-model/feeRateSchedule>,
        <https://w3id.org/lmodel/common-domain-model/notionalReference>,
        <https://w3id.org/lmodel/common-domain-model/payer>,
        <https://w3id.org/lmodel/common-domain-model/receiver> .

<https://w3id.org/lmodel/common-domain-model/ExtensionEvent> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:ExtensionEvent"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: FpML_ird_42 — adjustedExerciseDate < adjustedExtendedTerminationDate" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: adjustedExerciseDate < adjustedExtendedTerminationDate" ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule ird-42 - adjustedExerciseDate must be before adjustedExtendedTerminationDate." ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExtensionEvent"^^xsd:anyURI ;
    linkml:description "A data to:  define the adjusted dates associated with an individual extension event." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ExtensionEvent_adjustedExerciseDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedExtendedTerminationDate> .

