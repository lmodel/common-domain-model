	linkml:description "An identifier that has been created to identify the agreement." , "An identifier used to uniquely identify the organizational unit" , "Asset Identifiers are used to uniquely identify an Asset, using a specified Asset Identifier Type." , "Comprises a identifier and a source to uniquely identify the nonTransferableProduct." , "Corresponds to the unique identifier of the Contractual Definition in which the code is published" , "Corresponds to the unique identifier of the Contractual Definition to which the map applies" , "Identification of the Instruction Composition step." , "Provides an identifier associated with a legal entity." , "Provides an identifier associated with a party. The identifier is unique within the public source specified in the source attribute." , "Provides an identifier associated with a person. The identifier is unique within the public source specified in the source attribute." , "Provides an identifier associated with a specific product. The identifier is unique within the public source specified in the source attribute." , "Represents a unique reference to the transfer." , "Specifies the identifier(s) to uniquely identify eligible collateral or a set of eligible collateral, such as a schedule or equivalant for an identity issuer." , "Specifies the unique identifier value for a non-legal entity such as a sleeve, or sub account, that is a party to the agreement and has a relationship with a legal entity defined on the agreement." , "The identifier value." , "The legal agreement identifier. Several identifiers can be specified." , "The name or identifier associated to this clause." , "Unique identifier for the clause." , "Unique identifier for this group. This can be used to uniquely identify a group of inventory records." , "Unique identifier for this record. This can be used to uniquely identify a specific piece of inventory." , "Unique identifier for this variant." , "Unique identifier of this InstructionComposition instance." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AssetIdentifier> , <https://w3id.org/lmodel/common-domain-model/AssignedIdentifier> , <https://w3id.org/lmodel/common-domain-model/Identifier> , <https://w3id.org/lmodel/common-domain-model/ProductIdentifier> , <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true ;
	linkml:value_presence "ABSENT" , "PRESENT" .
