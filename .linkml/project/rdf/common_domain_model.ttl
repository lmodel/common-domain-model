            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PrincipalPayment"^^xsd:anyURI ;
    linkml:description "Any kind of principal payments when the amount is known and thus fixed." ;
