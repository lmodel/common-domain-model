<https://w3id.org/lmodel/common-domain-model/MandatoryEarlyTerminationAdjustedDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:MandatoryEarlyTerminationAdjustedDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: FpML_ird_44 — adjustedEarlyTerminationDate <= adjustedCashSettlementValuationDate and adjustedCashSettlementValuationDate <= adjustedCashSettlementPaymentDate" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: adjustedCashSettlementValuationDate <= adjustedCashSettlementPaymentDate",
                "Rosetta comparison: adjustedEarlyTerminationDate <= adjustedCashSettlementValuationDate" ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule ird-44 - AdjustedEarlyTerminationDate must be before or equal to adjustedCashSettlementValuationDate must be before or the same as adjustedCashSettlementPaymentDate" ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MandatoryEarlyTerminationAdjustedDates"^^xsd:anyURI ;
    linkml:description "A data defining:  the adjusted dates associated with a mandatory early termination provision." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/MandatoryEarlyTerminationAdjustedDates_adjustedCashSettlementPaymentDate>,
        <https://w3id.org/lmodel/common-domain-model/MandatoryEarlyTerminationAdjustedDates_adjustedCashSettlementValuationDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedEarlyTerminationDate> .

<https://w3id.org/lmodel/common-domain-model/NotificationTimeElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_Japanese_2016"^^xsd:anyURI,
        "isda:CSA_IM_NewYork_2016"^^xsd:anyURI,
        "isda:CSD_IM_English_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(e)(iii)\" name \"Notification Time\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(d)(iii)\" name \"Notification Time\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(d)(iii)\" name \"Notification Time\"" ;
    skos:exactMatch "common_domain_model:NotificationTimeElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: NotificationTimeElectionChoice — required choice notificationTime, customNotification" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The Notification Time is specified either as a time that is qualified by a standard business center or as a custom election." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/notificationTime> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/customNotification> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/NotificationTimeElection"^^xsd:anyURI ;
    linkml:description "A class to specify the notification time election by the respective parties to the agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/NotificationTimeElection_notificationTime>,
        <https://w3id.org/lmodel/common-domain-model/NotificationTimeElection_party>,
        <https://w3id.org/lmodel/common-domain-model/customNotification>,
        <https://w3id.org/lmodel/common-domain-model/localBusinessDay> .

<https://w3id.org/lmodel/common-domain-model/Observable> a linkml:ClassDefinition ;
