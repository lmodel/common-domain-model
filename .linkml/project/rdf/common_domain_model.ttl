<https://w3id.org/lmodel/common-domain-model/tranche> a linkml:SlotDefinition ;
	linkml:annotations _:c14n268 ;
	linkml:description "Denotes the loan tranche that is subject to the derivative transaction. It will typically be referenced as the Bloomberg tranche number. ISDA Standards Terms Supplement term: Bloomberg Tranche Number." , "This element contains CDS tranche terms." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Tranche> , <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/tranche__attachmentPoint> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "attachmentPoint" ;
	linkml:description "Lower bound percentage of the loss that the Tranche can endure, expressed as a decimal. An attachment point of 5% would be represented as 0.05. The difference between Attachment and Exhaustion points is called the width of the Tranche." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Tranche> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Tranche> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/attachmentPoint"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tranche__exhaustionPoint> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "exhaustionPoint" ;
	linkml:description "Upper bound percentage of the loss that the Tranche can endure, expressed as a decimal. An exhaustion point of 5% would be represented as 0.05. The difference between Attachment and Exhaustion points is call the width of the Tranche." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Tranche> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Tranche> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/exhaustionPoint"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tranche__incurredRecoveryApplicable> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "incurredRecoveryApplicable" ;
	linkml:description "Outstanding Swap Notional Amount is defined at any time on any day, as the greater of: (a) Zero; If Incurred Recovery Amount Applicable: (b) The Original Swap Notional Amount minus the sum of all Incurred Loss Amounts and all Incurred Recovery Amounts (if any) determined under this Confirmation at or prior to such time.Incurred Recovery Amount not populated: (b) The Original Swap Notional Amount minus the sum of all Incurred Loss Amounts determined under this Confirmation at or prior to such time." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Tranche> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Tranche> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/incurredRecoveryApplicable"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/transactedPrice> a linkml:SlotDefinition ;
	linkml:description "The qualification of the price at which the contract has been transacted, in terms of market fixed rate, initial points, market price and/or quotation style. In FpML, those attributes are positioned as part of the fee leg." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TransactedPrice> .
<https://w3id.org/lmodel/common-domain-model/transactedPrice__initialPoints> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "initialPoints" ;
	linkml:description "An optional element that contains the up-front points expressed as a percentage of the notional. An initialPoints value of 5% would be represented as 0.05. The initialPoints element is an alternative to marketFixedRate in quoting the traded level of a trade. When initialPoints is used, the traded level is the sum of fixedRate and initialPoints. The initialPoints is one of the items that are factored into the initialPayment calculation and is payable by the Buyer to the Seller. Note that initialPoints and marketFixedRate may both be present in the same document when both implied values are desired." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TransactedPrice> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TransactedPrice> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/initialPoints"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/transactedPrice__marketFixedRate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "marketFixedRate" ;
	linkml:description "An optional element that only has meaning in a credit index trade. This element contains the credit spread ('fair value') at which the trade was executed. Unlike the fixedRate of an index, the marketFixedRate varies over the life of the index depending on market conditions. The marketFixedRate is the price of the index as quoted by trading desks." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TransactedPrice> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TransactedPrice> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/marketFixedRate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/transactedPrice__marketPrice> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "marketPrice" ;
	linkml:description "An optional element that only has meaning in a credit index trade. This element contains the price at which the trade was executed and is used instead of marketFixedRate on credit trades on certain indicies which are quoted using a price rather than a spread." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TransactedPrice> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TransactedPrice> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/marketPrice"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/transactedPrice__quotationStyle> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "quotationStyle" ;
	linkml:description "An optional element that contains the up-front points expressed as a percentage of the notional. An initialPoints value of 5% would be represented as 0.05. The initialPoints element is an alternative to marketFixedRate in quoting the traded level of a trade. When initialPoints is used, the traded level is the sum of fixedRate and initialPoints. The initialPoints is one of the items that are factored into the initialPayment calculation and is payable by the Buyer to the Seller. Note that initialPoints and marketFixedRate may both be present in the same document when both implied values are desired." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TransactedPrice> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TransactedPrice> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/QuotationStyleEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/quotationStyle"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/transactionAdditionalTerms> a linkml:SlotDefinition ;
	linkml:description "Any additional terms which mainly intend to specify the extraordinary events that may affect a trade and the related contractual rights and obligation of the parties when this happens" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TransactionAdditionalTerms> ;
	linkml:value_presence "PRESENT" .
