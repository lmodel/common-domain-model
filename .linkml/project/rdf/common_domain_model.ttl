    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexIdentification"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexIdentification_currency>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexIdentification_floatingRateIndex>,
        <https://w3id.org/lmodel/common-domain-model/froType> .

<https://w3id.org/lmodel/common-domain-model/FrenchLawAddendumElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:FrenchLawAddendumElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AddendumLanguage — if isApplicable = True then addendumLanguage exists else if isApplicable = False then addendumLanguage is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isApplicable> ] ;
            linkml:description "A data rule to enforce that the French Law Addendum party language must be specified when applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/addendumLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FrenchLawAddendumElection"^^xsd:anyURI ;
    linkml:description "A class to specify party specific French Law Addendum language." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FrenchLawAddendumElection_isApplicable>,
        <https://w3id.org/lmodel/common-domain-model/FrenchLawAddendumElection_party>,
        <https://w3id.org/lmodel/common-domain-model/addendumLanguage> .

<https://w3id.org/lmodel/common-domain-model/FutureValueAmount> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
