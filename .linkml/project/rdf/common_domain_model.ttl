<https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum> skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum"^^xsd:anyURI ;
