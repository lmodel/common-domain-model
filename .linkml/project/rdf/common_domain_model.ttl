<https://w3id.org/lmodel/common-domain-model/AdditionalType> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_2016"^^xsd:anyURI ;
    skos:closeMatch "fpml_5_10:AdditionalType"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(b)(B)\"" ;
    skos:exactMatch "common_domain_model:AdditionalType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: CustomValue — if standardValue = AdditionalTypeEnum -> Other then customValue exists",
        "Rosetta condition: StandardValue — if standardValue <> AdditionalTypeEnum -> Other then customValue is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/standardValue> ] ;
            linkml:description "The specification of a custom value by the parties to the legal agreement takes place alongside the qualification of the `Other` value as part of the AdditionalTypeEnum." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/customValue> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: standardValue <> AdditionalTypeEnum -> Other" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/standardValue> ] ;
            linkml:description "The specification of a standard value by the parties to the legal agreement is done through the qualification of a value distinct than `Other` as part of the AdditionalTypeEnum, and implies that the customerValue is not being qualified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/customValue> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdditionalType"^^xsd:anyURI ;
    linkml:description "The specification of the Additional Type of transaction that can require the collection or delivery of initial margin under a given regulatory regime for the purposes of Covered Transactions." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/customValue>,
        <https://w3id.org/lmodel/common-domain-model/standardValue> .

<https://w3id.org/lmodel/common-domain-model/AveragingCalculationMethod> a linkml:ClassDefinition ;
