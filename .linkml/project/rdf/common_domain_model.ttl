	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/valuation"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationMethod> a linkml:SlotDefinition ;
	linkml:description "Specifies the parameters required to obtain a valuation, including the source, quotation method (bid, mid etc.) and any applicable quotation amount." , "The ISDA defined methodology for determining the final price of the reference obligation for purposes of cash settlement. (ISDA 2003 Term: Valuation Method). For example, Market, Highest etc." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ValuationMethod> , <https://w3id.org/lmodel/common-domain-model/ValuationMethodEnum> .
<https://w3id.org/lmodel/common-domain-model/valuationMethod__cashCollateralValuationMethod> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "cashCollateralValuationMethod" ;
	linkml:description "Specifies the parameters representing several mid-market valuation and replacement value methods." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CashCollateralValuationMethod> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/cashCollateralValuationMethod"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationMethod__minimumQuotationAmount> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "minimumQuotationAmount" ;
	linkml:description "In the determination of a cash settlement amount, if weighted average quotations are to be obtained, the minimum quotation amount specifies a minimum intended threshold amount of outstanding principal balance of the reference obligation for which the quote should be obtained. If not specified, the ISDA definitions provide for a fallback amount of the lower of either USD 1,000,000 (or its equivalent in the relevant obligation currency) or the quotation amount. ISDA 2003 Term: Minimum Quotation Amount." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/minimumQuotationAmount"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationMethod__quotationAmount> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "quotationAmount" ;
	linkml:description "In the determination of a cash settlement amount, if weighted average quotations are to be obtained, the quotation amount specifies an upper limit to the outstanding principal balance of the reference obligation for which the quote should be obtained. If not specified, the ISDA definitions provide for a fallback amount equal to the floating rate payer calculation amount. ISDA 2003 Term: Quotation Amount." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/quotationAmount"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationMethod__quotationMethod> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "quotationMethod" ;
	linkml:description "The type of price quotations to be requested from dealers when determining the market value of the reference obligation for purposes of cash settlement, or which rate quote is to be observed for a fixing. For example, Bid, Offer, Mid-market or Exercising Party Pays. ISDA 2003 Term: Quotation Method. The meaning of Exercising Party Pays is defined in the 2000 ISDA Definitions, Section 17.2. Certain Definitions Relating to Cash Settlement, paragraph (j)." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/QuotationRateTypeEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/quotationMethod"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationMethod__valuationMethod> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "valuationMethod" ;
	linkml:description "The ISDA defined methodology for determining the final price of the reference obligation for purposes of cash settlement. (ISDA 2003 Term: Valuation Method). For example, Market, Highest etc." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ValuationMethodEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/valuationMethod"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationMethod__valuationSource> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "valuationSource" ;
	linkml:description "The source for obtaining a valuation. This may come from some information source (e.g. Reuters), from a rate option fixing (e.g. FX fixing for cross-currency settlement), or from a set of reference banks. This is a mandatory attribute as the valuation method relies on one of those sources to be specified." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationMethod> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ValuationSource> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/valuationSource"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationPostponement> a linkml:SlotDefinition ;
	linkml:description "Specifies how long to wait to get a quote from a settlement rate option upon a price source disruption." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ValuationPostponement> .
<https://w3id.org/lmodel/common-domain-model/valuationPostponement__maximumDaysOfPostponement> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "maximumDaysOfPostponement" ;
	linkml:description "The maximum number of days to wait for a quote from the disrupted settlement rate option before proceeding to the next method." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationPostponement> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationPostponement> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/maximumDaysOfPostponement"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationSource> a linkml:SlotDefinition ;
	linkml:description "The source for obtaining a valuation. This may come from some information source (e.g. Reuters), from a rate option fixing (e.g. FX fixing for cross-currency settlement), or from a set of reference banks. This is a mandatory attribute as the valuation method relies on one of those sources to be specified." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ValuationSource> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/valuationSource__dealerOrCCP> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "dealerOrCCP" ;
	linkml:description "Holds an identifier for the reference entity that is agreed by both parties as a basis for cash settlement calculations. This could be a dealer from whom quotations are obtained by the calculation agent on the reference obligation for purposes of cash settlement in a credit event. ISDA 2003 Term: Dealer. This could be the clearing organization (CCP, DCO) to which the trade should be cleared, as applicable for cash-settled swaptions." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationSource> ;
