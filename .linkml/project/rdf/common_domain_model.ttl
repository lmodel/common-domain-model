<https://w3id.org/lmodel/common-domain-model/DeliverableObligations> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement> ;
    skos:exactMatch "common_domain_model:DeliverableObligations"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
    skos:note "Rosetta condition: DeliverableObligationsChoice — optional choice fullFaithAndCreditObLiability, generalFundObligationLiability, revenueObligationLiability",
        "Rosetta condition: FpML_cd_34 — if category exists and category = ObligationCategoryEnum -> ReferenceObligationsOnly then acceleratedOrMatured is absent and accruedInterest is absent and assignableLoan is absent and consentRequiredLoan is absent and directLoanParticipation is absent and excluded is absent and fullFaithAndCreditObLiability is absent and generalFundObligationLiability is absent and indirectLoanParticipation is absent and listed is absent and maximumMaturity is absent and notBearer is absent and notContingent is absent and notDomesticCurrency is absent and notDomesticIssuance is absent and notDomesticLaw is absent and notSovereignLender is absent and notSubordinated is absent and othReferenceEntityObligations is absent and revenueObligationLiability is absent and specifiedCurrency is absent and transferable is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/generalFundObligationLiability> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/revenueObligationLiability> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fullFaithAndCreditObLiability> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/DeliverableObligations"^^xsd:anyURI ;
    linkml:description "A class to specify all the ISDA terms relevant to defining the deliverable obligations." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/DeliverableObligations_category>,
        <https://w3id.org/lmodel/common-domain-model/DeliverableObligations_notContingent>,
        <https://w3id.org/lmodel/common-domain-model/acceleratedOrMatured>,
        <https://w3id.org/lmodel/common-domain-model/accruedInterest>,
        <https://w3id.org/lmodel/common-domain-model/assignableLoan>,
        <https://w3id.org/lmodel/common-domain-model/consentRequiredLoan>,
        <https://w3id.org/lmodel/common-domain-model/directLoanParticipation>,
        <https://w3id.org/lmodel/common-domain-model/excluded>,
        <https://w3id.org/lmodel/common-domain-model/fullFaithAndCreditObLiability>,
        <https://w3id.org/lmodel/common-domain-model/generalFundObligationLiability>,
