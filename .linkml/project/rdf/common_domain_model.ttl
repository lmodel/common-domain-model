<https://w3id.org/lmodel/common-domain-model/BasketReferenceInformation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:closeMatch "fpml_5_10:BasketReferenceInformation"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:BasketReferenceInformation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: BasketReferenceInformationChoice — required choice nthToDefault, tranche",
        "Rosetta condition: MthToDefault — if (nthToDefault exists and mthToDefault exists) then nthToDefault < mthToDefault",
        "Rosetta condition: NthToDefault — if mthToDefault exists then nthToDefault exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct. This choice rule is complemented by the data rule BasketReferenceInformation_nthToDefault to represent the FpML construct where there is a choice between a tranche element and a [required nthToDefault, optional mthToDefault] branch." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/tranche> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nthToDefault> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/mthToDefault> ] ;
            linkml:description "As part of the branch of the choice node, FpML requires the nthToDefault element to be present, while the mthToDefault one is optional." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nthToDefault> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: nthToDefault < mthToDefault" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/mthToDefault>,
                        <https://w3id.org/lmodel/common-domain-model/nthToDefault> ] ;
            linkml:description "FpML validation rule cd-39 - Context: BasketReferenceInformation (complex type). If nthToDefault exists, and if mthToDefault exists, then nthToDefault must be less than mthToDefault." ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/BasketReferenceInformation"^^xsd:anyURI ;
    linkml:description "CDS Basket Reference Information." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/BasketReferenceInformation_tranche>,
        <https://w3id.org/lmodel/common-domain-model/basketId>,
        <https://w3id.org/lmodel/common-domain-model/basketName>,
        <https://w3id.org/lmodel/common-domain-model/mthToDefault>,
        <https://w3id.org/lmodel/common-domain-model/nthToDefault>,
        <https://w3id.org/lmodel/common-domain-model/referencePool> .

