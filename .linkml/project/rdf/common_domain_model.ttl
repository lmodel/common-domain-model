	linkml:minimum_value "1"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/numberRange__lowerBound> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
	skos:prefLabel "lowerBound" ;
	linkml:description "The lower bound of a number range, e.g. greater than or equal to 5." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NumberRange> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NumberRange> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NumberBound> ;
