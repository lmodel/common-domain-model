<https://w3id.org/lmodel/common-domain-model/CreditSupportObligationsBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:CreditSupportObligationsBase"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CreditSupportObligationsBase"^^xsd:anyURI ;
    linkml:description "A logical container designed to hold a set of related data. In this case, designed to hold a set of clauses that are common amongst Legacy (1994/95), Variation Margin and Initial Margin Credit Support Documents in regards to Credit Support Obligations." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CreditSupportObligationsBase_deliveryAmount>,
        <https://w3id.org/lmodel/common-domain-model/CreditSupportObligationsBase_returnAmount>,
        <https://w3id.org/lmodel/common-domain-model/bespokeTransferTiming>,
        <https://w3id.org/lmodel/common-domain-model/collateralTransferTiming>,
        <https://w3id.org/lmodel/common-domain-model/minimumTransferAmount> .

<https://w3id.org/lmodel/common-domain-model/CustodianElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:CustodianElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdditionalLanguage — if legacyVMCustodian is absent then additionalLanguage exists",
        "Rosetta condition: NamedEntity — if legacyVMCustodian = LegacyVMCustodianEnum -> NamedEntity then legacyNamedEntity exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/legacyVMCustodian> ] ;
            linkml:description "The entity should be named if this is specified in the determination." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/legacyNamedEntity> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/legacyVMCustodian> ] ;
            linkml:description "If no Custodian determination methodology is defined, additional language must be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CustodianElection"^^xsd:anyURI ;
    linkml:description "A class to specify the custodian and custody account details for each party to the agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CustodianElection_additionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/CustodianElection_party>,
        <https://w3id.org/lmodel/common-domain-model/custodian>,
        <https://w3id.org/lmodel/common-domain-model/legacyNamedEntity>,
        <https://w3id.org/lmodel/common-domain-model/legacyVMCustodian>,
        <https://w3id.org/lmodel/common-domain-model/segregatedCashAccount>,
        <https://w3id.org/lmodel/common-domain-model/segregatedSecurityAccount> .

<https://w3id.org/lmodel/common-domain-model/ExecutionInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:ExecutionInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_Execution — Specifies the function to compose an execution based on a minimum required set of inputs: product, quantity, parties, etc." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_Execution\",\"description\":\"Specifies the function to compose an execution based on a minimum required set of inputs: product, quantity, parties, etc.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"ExecutionInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"execution\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExecutionInstruction"^^xsd:anyURI ;
    linkml:description "Specifies instructions for execution of a transaction, consisting of a product, price, quantity, parties, trade identifier, execution details, and settlement terms." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ExecutionInstruction_ancillaryParty>,
        <https://w3id.org/lmodel/common-domain-model/collateral>,
        <https://w3id.org/lmodel/common-domain-model/counterparty>,
        <https://w3id.org/lmodel/common-domain-model/executionDetails>,
        <https://w3id.org/lmodel/common-domain-model/lotIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/parties>,
        <https://w3id.org/lmodel/common-domain-model/partyRoles>,
        <https://w3id.org/lmodel/common-domain-model/priceQuantity>,
        <https://w3id.org/lmodel/common-domain-model/product>,
        <https://w3id.org/lmodel/common-domain-model/tradeDate>,
        <https://w3id.org/lmodel/common-domain-model/tradeIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/tradeTime> .

<https://w3id.org/lmodel/common-domain-model/IndexBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:IndexBase"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: AssetType — assetType = Other" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Asset type must be Other." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/assetType> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/IndexBase"^^xsd:anyURI ;
    linkml:description "Identifies an index by referencing an identifier." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/AssetBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/IndexBase_assetClass>,
        <https://w3id.org/lmodel/common-domain-model/IndexBase_name>,
        <https://w3id.org/lmodel/common-domain-model/assetType>,
        <https://w3id.org/lmodel/common-domain-model/exchange>,
        <https://w3id.org/lmodel/common-domain-model/identifier>,
        <https://w3id.org/lmodel/common-domain-model/isExchangeListed>,
        <https://w3id.org/lmodel/common-domain-model/provider>,
        <https://w3id.org/lmodel/common-domain-model/relatedExchange>,
        <https://w3id.org/lmodel/common-domain-model/taxonomy> .

<https://w3id.org/lmodel/common-domain-model/LegalAgreementBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common> ;
