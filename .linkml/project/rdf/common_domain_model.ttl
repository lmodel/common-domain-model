	skos:prefLabel "sourcePage" ;
	linkml:annotations _:c14n1480 ;
	linkml:description "A specific page for the source for obtaining a market data point. In FpML, this is specified as a scheme, rateSourcePageScheme, for which no coding Scheme or URI is specified." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/InformationSource> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/InformationSource> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/sourcePage"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/informationSource__sourcePageHeading> a linkml:SlotDefinition ;
