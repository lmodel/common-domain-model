    linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableOrRelativeDate> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fxFixingDate"^^xsd:anyURI ;
    linkml:usage_slot_name "fxFixingDate" .

