	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/listed"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__maximumMaturity> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "maximumMaturity" ;
	linkml:description "A deliverable obligation characteristic. An obligation that has a remaining maturity from the Physical Settlement Date of not greater than the period specified. ISDA 2003 Term: Maximum Maturity." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Period> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/maximumMaturity"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__notBearer> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "notBearer" ;
	linkml:description "A deliverable obligation characteristic. Any obligation that is not a bearer instrument. This applies to Bonds only and is meant to avoid tax, fraud and security/delivery provisions that can potentially be associated with Bearer Bonds. ISDA 2003 Term: Not Bearer." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notBearer"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__notContingent> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "notContingent" ;
	linkml:description "A deliverable obligation characteristic. In essence Not Contingent means the repayment of principal cannot be dependant on a formula/index, i.e. to prevent the risk of being delivered an instrument that may never pay any element of principal, and to ensure that the obligation is interest bearing (on a regular schedule). ISDA 2003 Term: Not Contingent." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notContingent"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__notDomesticCurrency> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "notDomesticCurrency" ;
	linkml:description "An obligation and deliverable obligation characteristic. Any obligation that is payable in any currency other than the domestic currency. Domestic currency is either the currency so specified or, if no currency is specified, the currency of (a) the reference entity, if the reference entity is a sovereign, or (b) the jurisdiction in which the relevant reference entity is organised, if the reference entity is not a sovereign. ISDA 2003 Term: Not Domestic Currency." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notDomesticCurrency"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__notDomesticIssuance> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "notDomesticIssuance" ;
	linkml:description "An obligation and deliverable obligation characteristic. Any obligation other than an obligation that was intended to be offered for sale primarily in the domestic market of the relevant Reference Entity. This specifies that the obligation must be an internationally recognised bond. ISDA 2003 Term: Not Domestic Issuance." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notDomesticIssuance"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__notDomesticLaw> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "notDomesticLaw" ;
	linkml:description "An obligation and deliverable obligation characteristic. If the reference entity is a Sovereign, this means any obligation that is not subject to the laws of the reference entity. If the reference entity is not a sovereign, this means any obligation that is not subject to the laws of the jurisdiction of the reference entity. ISDA 2003 Term: Not Domestic Law." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notDomesticLaw"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__notSovereignLender> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "notSovereignLender" ;
	linkml:description "An obligation and deliverable obligation characteristic. Any obligation that is not primarily (majority) owed to a Sovereign or Supranational Organisation. ISDA 2003 Term: Not Sovereign Lender." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notSovereignLender"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__notSubordinated> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "notSubordinated" ;
	linkml:description "An obligation and deliverable obligation characteristic. An obligation that ranks at least equal with the most senior Reference Obligation in priority of payment or, if no Reference Obligation is specified in the related Confirmation, the obligations of the Reference Entity that are senior. ISDA 2003 Term: Not Subordinated." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notSubordinated"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__othReferenceEntityObligations> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "othReferenceEntityObligations" ;
	linkml:description "This element is used to specify any other obligations of a reference entity in both obligations and deliverable obligations. The obligations can be specified free-form. ISDA 2003 Term: Other Obligations of a Reference Entity." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/othReferenceEntityObligations"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__revenueObligationLiability> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "revenueObligationLiability" ;
	linkml:description "An obligation and deliverable obligation characteristic. Defined in the ISDA published additional provisions for U.S. Municipal as Reference Entity. ISDA 2003 Term: Revenue Obligation Liability." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
