                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumBusinessDays> ] ;
            linkml:description "FpML specifies maximumBusinessDays as a NonNegativeInteger." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumBusinessDays> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PhysicalSettlementPeriod"^^xsd:anyURI ;
