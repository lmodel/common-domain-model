    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PricingDates"^^xsd:anyURI ;
    linkml:description "Specifies specific dates or parametric rules for the dates on which the price will be determined" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PricingDates_parametricDates>,
        <https://w3id.org/lmodel/common-domain-model/specifiedDates> .

<https://w3id.org/lmodel/common-domain-model/QuantityChangeInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:QuantityChangeInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_OnDemandRateChangePriceChangeInstruction — Creates a price change instruction for an on-demand rate change, based on a new rate provided as a single number by matching it to a single rate price.",
        "Rosetta func: Create_QuantityChange — A specification of the inputs, outputs and constraints when calculating the after state of a Quantity Change Primitive Event" ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_QuantityChange\",\"description\":\"A specification of the inputs, outputs and constraints when calculating the after state of a Quantity Change Primitive Event\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"QuantityChangeInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"quantityChange\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_OnDemandRateChangePriceChangeInstruction\",\"description\":\"Creates a price change instruction for an on-demand rate change, based on a new rate provided as a single number by matching it to a single rate price.\",\"inputs\":[{\"name\":\"priceQuantity\",\"type\":\"PriceQuantity\",\"cardinality\":\"1..*\"},{\"name\":\"newRate\",\"type\":\"number\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"quantityChangeInstruction\",\"type\":\"QuantityChangeInstruction\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/QuantityChangeInstruction"^^xsd:anyURI ;
    linkml:description "Instructions required to create a Quantity Change Primitive Event, which can be either an increase, a decrease or a replacement. An increase adds a new trade lot to the original trade, whereas a decrease subtracts from an existing trade lot's quantity. A replacement updates the quantity of an existing trade lot to the new value." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/QuantityChangeInstruction_lotIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/change>,
        <https://w3id.org/lmodel/common-domain-model/direction> .

<https://w3id.org/lmodel/common-domain-model/RateSchedule> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:RateSchedule"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/RateSchedule"^^xsd:anyURI ;
    linkml:description "A class defining a schedule of rates or amounts in terms of an initial value and then a series of step date and value pairs. On each step date the rate or amount changes to the new step value. The series of step date and value pairs are optional. If not specified, this implies that the initial value remains unchanged over time." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/RateSchedule_price> .

<https://w3id.org/lmodel/common-domain-model/ReturnAmount> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:exactMatch "common_domain_model:ReturnAmount"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta condition: CustomElection — if customElection exists then includesDefaultLanguage = False" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/customElection> ] ;
            linkml:description "A data rule to specify that when a custom election exists then default language should not be included." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/includesDefaultLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ReturnAmount"^^xsd:anyURI ;
    linkml:description "A class to specify the application of Interest Amount with respect the Return Amount." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ReturnAmount_customElection>,
        <https://w3id.org/lmodel/common-domain-model/includesDefaultLanguage> .

<https://w3id.org/lmodel/common-domain-model/SensitivityMethodology> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(gg)(2)\"" ;
    skos:exactMatch "common_domain_model:SensitivityMethodology"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SensitivityMethodology"^^xsd:anyURI ;
    linkml:description "A class to specify the methodology according to which sensitivities are computed." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/customMethodology>,
        <https://w3id.org/lmodel/common-domain-model/specifiedMethodology> .

<https://w3id.org/lmodel/common-domain-model/SettledEntityMatrix> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:SettledEntityMatrix"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SettledEntityMatrix"^^xsd:anyURI ;
    linkml:description "A class to specify the Relevant Settled Entity Matrix." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SettledEntityMatrix_publicationDate>,
        <https://w3id.org/lmodel/common-domain-model/matrixSource> .

<https://w3id.org/lmodel/common-domain-model/SettlementTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement> ;
    skos:exactMatch "common_domain_model:SettlementTerms"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
    skos:note "Rosetta condition: CashSettlementTerms — if cashSettlementTerms exists then settlementType <> SettlementTypeEnum -> Physical",
        "Rosetta condition: OptionSettlementChoice — if cashSettlementTerms exists and physicalSettlementTerms exists then settlementType = SettlementTypeEnum -> Election or settlementType = SettlementTypeEnum -> CashOrPhysical",
        "Rosetta condition: PhysicalSettlementTerms — if physicalSettlementTerms exists then settlementType <> SettlementTypeEnum -> Cash" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SettlementTerms"^^xsd:anyURI ;
    linkml:description "Specifies the settlement terms, which can either be cash, physical, or fx-based cash-settlement. This class can be used for the settlement of options and forwards, cash transactions (e.g. securities or foreign exchange), or in case of credit event." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SettlementBase_settlementDate>,
        <https://w3id.org/lmodel/common-domain-model/cashSettlementTerms>,
        <https://w3id.org/lmodel/common-domain-model/physicalSettlementTerms>,
        <https://w3id.org/lmodel/common-domain-model/settlementCentre>,
        <https://w3id.org/lmodel/common-domain-model/settlementCurrency>,
        <https://w3id.org/lmodel/common-domain-model/settlementProvision>,
        <https://w3id.org/lmodel/common-domain-model/settlementType>,
        <https://w3id.org/lmodel/common-domain-model/standardSettlementStyle>,
        <https://w3id.org/lmodel/common-domain-model/transferSettlementType> .

<https://w3id.org/lmodel/common-domain-model/StandardizedSchedule> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_margin_schedule> ;
    skos:exactMatch "common_domain_model:StandardizedSchedule"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_margin_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: PositiveDuration — if durationInYears exists then durationInYears > 0",
        "Rosetta condition: PositiveNotional — notional > 0",
        "Rosetta condition: ValidCurrency — notionalCurrency to-enum ISOCurrencyCodeEnum exists",
        "Rosetta func: BuildStandardizedSchedule — Takes a trade and uses qualification to extract the relevant information to populate the grid that will be used to calculate the gross initial margin.",
        "Rosetta func: GetGrossInitialMarginFromStandardizedSchedule — Takes the grid information from an specific trade and calculates the gross initial margin." ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/durationInYears> ] ;
            linkml:description "Ensure duration is greater than 0." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/durationInYears> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Ensure notional is greater than 0" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/notional> ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"BuildStandardizedSchedule\",\"description\":\"Takes a trade and uses qualification to extract the relevant information to populate the grid that will be used to calculate the gross initial margin.\",\"inputs\":[{\"name\":\"trade\",\"type\":\"Trade\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"standardizedSchedule\",\"type\":\"StandardizedSchedule\",\"cardinality\":\"1..1\"}},{\"name\":\"GetGrossInitialMarginFromStandardizedSchedule\",\"description\":\"Takes the grid information from an specific trade and calculates the gross initial margin.\",\"inputs\":[{\"name\":\"standardizedSchedule\",\"type\":\"StandardizedSchedule\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"grossInitialMargin\",\"type\":\"Money\",\"cardinality\":\"0..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/StandardizedSchedule"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/assetClass>,
        <https://w3id.org/lmodel/common-domain-model/durationInYears>,
        <https://w3id.org/lmodel/common-domain-model/notional>,
        <https://w3id.org/lmodel/common-domain-model/notionalCurrency>,
        <https://w3id.org/lmodel/common-domain-model/productClass> .

<https://w3id.org/lmodel/common-domain-model/StubValue> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:StubValue"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/StubValue"^^xsd:anyURI ;
    linkml:description "A type defining how a stub calculation period amount is calculated. A single floating rate tenor different to that used for the regular part of the calculation periods schedule may be specified, or two floating rate tenors many be specified. If two floating rate tenors are specified then Linear Interpolation (in accordance with the 2000 ISDA Definitions, Section 8.3 Interpolation) is assumed to apply. Alternatively, an actual known stub rate or stub amount may be specified." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/floatingRate>,
        <https://w3id.org/lmodel/common-domain-model/stubAmount>,
        <https://w3id.org/lmodel/common-domain-model/stubRate> .

<https://w3id.org/lmodel/common-domain-model/TelephoneNumber> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:exactMatch "common_domain_model:TelephoneNumber"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TelephoneNumber"^^xsd:anyURI ;
    linkml:description "A class to specify a telephone number as a type of phone number (e.g. work, personal, ...) alongside with the actual number." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/TelephoneNumber_number>,
        <https://w3id.org/lmodel/common-domain-model/telephoneNumberType> .

<https://w3id.org/lmodel/common-domain-model/TradeIdentifier> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:TradeIdentifier"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_PartyChange — Defines the logic for changing one of the counterparties on a trade. A new trade identifier must be specified as a change of party results in a new trade. An ancillary party can also be specified, for instance to refer to the original executing party on the new trade." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_PartyChange\",\"description\":\"Defines the logic for changing one of the counterparties on a trade. A new trade identifier must be specified as a change of party results in a new trade. An ancillary party can also be specified, for instance to refer to the original executing party on the new trade.\",\"inputs\":[{\"name\":\"counterparty\",\"type\":\"Counterparty\",\"cardinality\":\"1..1\"},{\"name\":\"ancillaryParty\",\"type\":\"AncillaryParty\",\"cardinality\":\"0..1\"},{\"name\":\"partyRole\",\"type\":\"PartyRole\",\"cardinality\":\"0..1\"},{\"name\":\"tradeId\",\"type\":\"TradeIdentifier\",\"cardinality\":\"1..*\"},{\"name\":\"originalTrade\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"newTrade\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TradeIdentifier"^^xsd:anyURI ;
    linkml:description "Defines a trade identifier as a special case of the generic identifier type, that also includes the trade identifier class." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/Identifier> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/TradeIdentifier_identifierType>,
        <https://w3id.org/lmodel/common-domain-model/assignedIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/issuer>,
        <https://w3id.org/lmodel/common-domain-model/issuerReference> .

<https://w3id.org/lmodel/common-domain-model/Tranche> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:Tranche"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: AttachmentPoint — attachmentPoint >= 0.0 and attachmentPoint <= 1.0",
        "Rosetta condition: AttachmentPointLessThanExhaustionPoint — attachmentPoint <= exhaustionPoint",
        "Rosetta condition: ExhaustionPoint — exhaustionPoint >= 0.0 and exhaustionPoint <= 1.0" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML definition associated with the attachmentPoint element specifies that a schema facet to constraint the value between 0 to 1 will be introduced in FpML 4.3." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/attachmentPoint> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: attachmentPoint <= exhaustionPoint" ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule cd-40 - Context: Tranche (complex type) attachmentPoint must be less or equal to exhaustionPoint." ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML definition associated with the exhaustionPoint element specifies that a schema facet to constraint the value between 0 to 1 will be introduced in FpML 4.3." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/exhaustionPoint> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Tranche"^^xsd:anyURI ;
    linkml:description "The class to represent a CDS Tranche." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/attachmentPoint>,
        <https://w3id.org/lmodel/common-domain-model/exhaustionPoint>,
        <https://w3id.org/lmodel/common-domain-model/incurredRecoveryApplicable> .

<https://w3id.org/lmodel/common-domain-model/TriggerEvent> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_event> ;
    skos:exactMatch "common_domain_model:TriggerEvent"^^xsd:anyURI ;
