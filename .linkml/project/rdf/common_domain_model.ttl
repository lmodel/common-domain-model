	linkml:annotations _:c14n1185 ;
	linkml:description "Represents the origin to the transfer as a reference for lineage purposes, whether it originated from trade level settlement terms or from payment terms on an economic payout." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Payout> .
