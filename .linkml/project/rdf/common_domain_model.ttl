<https://w3id.org/lmodel/common-domain-model/date> a linkml:SlotDefinition,
        linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\".",
        "URI is dateTime because OWL reasoners don't work with straight date or time" ;
    skos:exactMatch "schema:Date"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI,
        "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:base "XSDDate" ;
    linkml:definition_uri "https://w3id.org/linkml/Date"^^xsd:anyURI,
        "https://w3id.org/lmodel/common-domain-model/date"^^xsd:anyURI ;
    linkml:description "a date (year, month and day) in an idealized calendar" ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AmendmentEffectiveDate>,
        <https://w3id.org/lmodel/common-domain-model/CSAValuationDate>,
        <https://w3id.org/lmodel/common-domain-model/CalculateTransferInstruction>,
        <https://w3id.org/lmodel/common-domain-model/DateList>,
        <https://w3id.org/lmodel/common-domain-model/DatedValue>,
        <https://w3id.org/lmodel/common-domain-model/OtherAgreement> ;
    linkml:equals_string "CalendarDay" ;
    linkml:imported_from "linkml:types" ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CSAValuationDate> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
    linkml:repr "str" ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/date"^^xsd:anyURI ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .

