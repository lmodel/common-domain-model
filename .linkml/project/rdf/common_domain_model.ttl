	linkml:description "Observation date time, which should be used when literal observation dates are required. The CDM specifies that the zoned date time is to be expressed in accordance with ISO 8601, either as UTC as an offset to UTC." , "The CDM specifies that the zoned date time is to be expressed in accordance with ISO 8601, either as UTC as an offset to UTC." , "To aggregate as of a particular date" ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/datetime> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/dateTimeList__dateTime> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
	skos:prefLabel "dateTime" ;
	linkml:description "The CDM specifies that the zoned date time is to be expressed in accordance with ISO 8601, either as UTC as an offset to UTC." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DateTimeList> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DateTimeList> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/datetime> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/date_or_datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI ;
	linkml:description "Either a date or a datetime" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/datedValue> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model"^^xsd:anyURI ;
	linkml:description "The schedule of step date and value pairs must be absent." , "The schedule of step date and value pairs. On each step date the associated step value becomes effective. A list of steps may be ordered in the document by ascending step date. An FpML document containing an unordered list of steps is still regarded as a conformant document." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DatedValue> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/datedValue"^^xsd:anyURI ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/datedValue__date> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
	skos:prefLabel "date" ;
	linkml:description "The date on which the associated step value becomes effective. This day may be subject to adjustment in accordance with a business day convention." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DatedValue> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DatedValue> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/date"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/datedValue__value> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
	skos:prefLabel "value" ;
	linkml:description "The rate of amount which becomes effective on the associated step date. A rate of 5% would be represented as 0.05." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DatedValue> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DatedValue> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/value"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"." ;
	skos:exactMatch "schema:DateTime"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDateTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Datetime"^^xsd:anyURI ;
	linkml:description "The combination of a date and time" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/day> a linkml:SlotDefinition ;
	linkml:description "Specific day(s) or day of the week, if any, specified for Valuation Time." , "The day in respect of which the Valuation Time is being specified. If not specified, addional language must be used to define the methodology." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ValuationDateDayEnum> , <https://w3id.org/lmodel/common-domain-model/ValuationTimeDayEnum> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/dayCountFraction> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1719 ;
	linkml:description "Specifies the day count fraction to use for that currency." , "The day count fraction. The cardinality has been relaxed when compared with the FpML interest rate swap for the purpose of accommodating standardized credit default swaps which DCF is not explicitly stated as part of the economic terms. The data rule InterestRatePayout_dayCountFraction requires that the DCF be stated for interest rate products." , "The default day count fraction." , "The enumerated values to specify the day count fraction." ;
	linkml:equals_string "ACT/360" , "ACT/365.FIXED" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DayCountFractionEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/dayCountYearFraction> a linkml:SlotDefinition ;
	linkml:description "The year fraction value of the calculation period, result of applying the ISDA rules for day count fraction defined in the ISDA Annex." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> .
<https://w3id.org/lmodel/common-domain-model/dayDistribution> a linkml:SlotDefinition ;
	linkml:description "Denotes the method by which the pricing days are distributed across the pricing period." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/dayFrequency> a linkml:SlotDefinition ;
	linkml:description "Defines the occurrence of the dayOfWeek within the pricing period on which pricing will take place, e.g. the 3rd Friday within each Calculation Period. If omitted, every dayOfWeek will be a pricing day." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/dayOfMonth> a linkml:SlotDefinition ;
	linkml:description "Specifies the day of the month if used." ;
	linkml:maximum_value "31"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/dayOfWeek> a linkml:SlotDefinition ;
	linkml:description "Indicates the days of the week on which the price will be determined." , "Specifies the day of the week if used." , "The days of the week of the delivery." ;
	linkml:maximum_cardinality 7 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/dayType> a linkml:SlotDefinition ;
	linkml:description "Denotes the enumerated values to specify the day type classification used in counting the number of days between two dates." , "In the case of an offset specified as a number of days, this element defines whether consideration is given as to whether a day is a good business day or not. If a day type of business days is specified then non-business days are ignored when calculating the offset. The financial business centers to use for determination of business days are implied by the context in which this element is used. This element must only be included when the offset is specified as a number of days. If the offset is zero days then the dayType element should not be included." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DayTypeEnum> ;
	linkml:required true ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/daysAfterCustodianEvent> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1145 ;
	linkml:description "Election to specify the number of days after the occurrence of the Custodian Event/Collateral Management Event for the purpose of qualifying the CE/CME End Date." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CustomisableOffset> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/daysInLeapYearPeriod> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/daysInPeriod> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/daysInRangeAdjustment> a linkml:SlotDefinition ;
	linkml:description "The contract specifies whether the notional should be scaled by the Number of Days in Range divided by the Expected N. The number of Days in Ranges refers to the number of returns that contribute to the realized volatility." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/dealerOrCCP> a linkml:SlotDefinition ;
	linkml:description "Holds an identifier for the reference entity that is agreed by both parties as a basis for cash settlement calculations. This could be a dealer from whom quotations are obtained by the calculation agent on the reference obligation for purposes of cash settlement in a credit event. ISDA 2003 Term: Dealer. This could be the clearing organization (CCP, DCO) to which the trade should be cleared, as applicable for cash-settled swaptions." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AncillaryEntity> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/debt> a linkml:SlotDefinition ;
	linkml:description "Specifies the credit rating debt type (e.g. long term, high yield, deposits, ...) associated with the credit rating notation and scale." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CreditRatingDebt> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/debtEconomics> a linkml:SlotDefinition ;
	linkml:description "Specifies selected financial terms of a debt security." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DebtEconomics> .
<https://w3id.org/lmodel/common-domain-model/debtEconomics__interest> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "interest" ;
	linkml:description "Specifies the general rule for periodic interest rate payment." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DebtInterestEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/interest"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtEconomics__principal> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "principal" ;
	linkml:description "Specifies the general rule for repayment of principal." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DebtPrincipalEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/principal"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtEconomics__redemption> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "redemption" ;
	linkml:description "Specifies the general rule for redemption of a debt security." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DebtRedemption> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/redemption"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtEconomics__secured> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "secured" ;
	linkml:description "Specifies the type of secured debt." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SecuredDebt> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/secured"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtEconomics__seniority> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "seniority" ;
	linkml:description "Specifies the order of repayment in the event of a sale or bankruptcy of the issuer or a related party (eg guarantor)." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DebtSeniorityEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/seniority"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtRedemption__party> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "party" ;
	linkml:description "Specifies whether the debt security is redeemed at the election of the Issuer/Holder." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtRedemption> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtRedemption> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RedemptionPartyEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/party"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtRedemption__putCall> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "putCall" ;
	linkml:description "Specifies the embedded option feature of a debt security." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtRedemption> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtRedemption> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PutCallEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/putCall"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtRedemption__redemptionType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "redemptionType" ;
	linkml:description "Specifies the contractual redemption or conversion features associated with a debt security." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtRedemption> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtRedemption> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RedemptionTypeEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/redemptionType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtType> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2076 ;
	linkml:description "Identifies the type of debt and selected debt economics." , "Represents a filter based on the type of bond." , "Specifies when there is only one debt type. FpML doesn't specify values in relation to the associated scheme, which is hence not specified as an enumeration as part of the CDM." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DebtType> , <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/debtType__debtEconomics> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "debtEconomics" ;
	linkml:description "Specifies selected financial terms of a debt security." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DebtType> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DebtType> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DebtEconomics> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/debtEconomics"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/debtTypes> a linkml:SlotDefinition ;
	linkml:description "Specifies if there are several debt types, alongside an 'any' or 'all' or all condition. As an example, Baa1 rating is required for any long term debt and deposit." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/MultipleDebtTypes> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/decimal> a linkml:TypeDefinition ;
	skos:broadMatch "schema:Number"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Decimal" ;
	linkml:definition_uri "https://w3id.org/linkml/Decimal"^^xsd:anyURI ;
	linkml:description "A real number with arbitrary precision that conforms to the xsd:decimal specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#decimal"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deemedEffectiveNextLBD> a linkml:SlotDefinition ;
	linkml:description "Specifies if notice shall be deemed to be effective at the time such notice is actually received unless such notice is received on a day which is not a Local Business Day or after the Notification Time on any Local Business Day in which event such notice shall be deemed to be effective on the next succeeding Local Business Day. If deemed effective,'True'. If not deemed effective, or not stated,'False'." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/defaultRequirement> a linkml:SlotDefinition ;
	linkml:description "In relation to certain credit events, serves as a threshold for Obligation Acceleration, Obligation Default, Repudiation/Moratorium and Restructuring. Market standard is USD 10,000,000 (JPY 1,000,000,000 for all Japanese Yen trades). This is applied on an aggregate or total basis across all Obligations of the Reference Entity. Used to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Default Requirement." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> .
<https://w3id.org/lmodel/common-domain-model/definitionOfMarketValueNonStandard> a linkml:SlotDefinition ;
	linkml:description "If the definition of 'Market Value' is non standard, it can be specified here." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/definitionalSource> a linkml:SlotDefinition ;
	linkml:description "The source of an FRO, particularly if not a Contractual Definition (e.g. the broker rates matrix)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/delisting> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NationalizationOrInsolvencyOrDelistingEventEnum> .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations> a linkml:SlotDefinition ;
	linkml:description "This element contains all the ISDA terms relevant to defining the deliverable obligations." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__acceleratedOrMatured> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "acceleratedOrMatured" ;
	linkml:description "A deliverable obligation characteristic. An obligation at time of default is due to mature and due to be repaid, or as a result of downgrade/bankruptcy is due to be repaid as a result of an acceleration clause. ISDA 2003 Term: Accelerated or Matured." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/acceleratedOrMatured"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__accruedInterest> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "accruedInterest" ;
	linkml:description "Indicates whether accrued interest is included (true) or not (false). For cash settlement this specifies whether quotations should be obtained inclusive or not of accrued interest. For physical settlement this specifies whether the buyer should deliver the obligation with an outstanding principal balance that includes or excludes accrued interest. ISDA 2003 Term: Include/Exclude Accrued Interest." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/accruedInterest"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliverableObligations__assignableLoan> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "assignableLoan" ;
	linkml:description "A deliverable obligation characteristic. A loan that is freely assignable to a bank or financial institution without the consent of the Reference Entity or the guarantor, if any, of the loan (or the consent of the applicable borrower if a Reference Entity is guaranteeing the loan) or any agent. ISDA 2003 Term: Assignable Loan." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliverableObligations> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PCDeliverableObligationCharac> ;
