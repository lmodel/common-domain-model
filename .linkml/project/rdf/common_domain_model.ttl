<https://w3id.org/lmodel/common-domain-model/ProductTaxonomy> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:ProductTaxonomy"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: TaxonomySource — if source exists then (value exists or productQualifier exists)",
        "Rosetta condition: TaxonomyType — required choice source, primaryAssetClass, secondaryAssetClass",
        "Rosetta condition: TaxonomyValue — optional choice value, productQualifier" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/source> ] ;
            linkml:description "A taxonomy source can only be associated with a taxonomy value or productQualifier" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/productQualifier> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Requires a taxonomy type to be chosen, either from a taxonomy source or using asset classes." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/primaryAssetClass> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/source> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/secondaryAssetClass> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "A taxonomy value and product qualifier are mutually exclusive. Choice is optional as it only applies when source exists." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/productQualifier> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ProductTaxonomy"^^xsd:anyURI ;
    linkml:description "Specifies the product taxonomy, which is composed of a taxonomy value and a taxonomy source." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/Taxonomy> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Taxonomy_source>,
        <https://w3id.org/lmodel/common-domain-model/Taxonomy_value>,
        <https://w3id.org/lmodel/common-domain-model/primaryAssetClass>,
        <https://w3id.org/lmodel/common-domain-model/productQualifier>,
        <https://w3id.org/lmodel/common-domain-model/secondaryAssetClass> .

<https://w3id.org/lmodel/common-domain-model/PubliclyAvailableInformation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_event> ;
    skos:exactMatch "common_domain_model:PubliclyAvailableInformation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    skos:note "Rosetta condition: PositiveSpecifiedNumber — if specifiedNumber exists then specifiedNumber >= 0",
        "Rosetta condition: SourceChoice — required choice standardPublicSources, publicSource" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description " FpML validation rule cd-36 - Context: PubliclyAvailableInformation (complex type). Either standardPublicSources or at least one publicSource element must exist." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/publicSource> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/standardPublicSources> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/specifiedNumber> ] ;
            linkml:description " FpML specifies specifiedNumber as a positiveInteger." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/specifiedNumber> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PubliclyAvailableInformation"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/publicSource>,
        <https://w3id.org/lmodel/common-domain-model/specifiedNumber>,
        <https://w3id.org/lmodel/common-domain-model/standardPublicSources> .

