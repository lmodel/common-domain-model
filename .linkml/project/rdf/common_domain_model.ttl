<https://w3id.org/lmodel/common-domain-model/DateRange> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:exactMatch "common_domain_model:DateRange"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: DatesOrdered — startDate <= endDate" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: startDate <= endDate" ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The start date must fall on or before the end date (a date range of only one date is allowed)." ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/DateRange"^^xsd:anyURI ;
    linkml:description "A class defining a contiguous series of calendar dates. The date range is defined as all the dates between and including the start and the end date. The start date must fall on or before the end date." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/endDate>,
        <https://w3id.org/lmodel/common-domain-model/startDate> .

<https://w3id.org/lmodel/common-domain-model/DebtRedemption> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:DebtRedemption"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: ConvertibleExchangablePartyElectionExists — if party exists then redemptionType exists or putCall exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/party> ] ;
            linkml:description "A type of redemption must be specified if the redeeming party is specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/putCall> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/redemptionType> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/DebtRedemption"^^xsd:anyURI ;
    linkml:description "Specifies the redemption features and whether the redemption right is exercised at the discretion of the issuer or the holder." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/party>,
        <https://w3id.org/lmodel/common-domain-model/putCall>,
        <https://w3id.org/lmodel/common-domain-model/redemptionType> .

<https://w3id.org/lmodel/common-domain-model/DeterminationMethodology> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_event> ;
