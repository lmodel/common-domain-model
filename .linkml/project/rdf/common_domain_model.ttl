                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/basketPercentage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ConstituentWeight"^^xsd:anyURI ;
    linkml:description "A class describing the weight of each of the underlier constituent within the basket, either in absolute or relative terms." ;
