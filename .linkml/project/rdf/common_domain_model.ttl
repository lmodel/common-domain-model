    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/rateOption"^^xsd:anyURI ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FloatingRateBase> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FloatingRateBase> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/InterestRateIndex> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/rateOption"^^xsd:anyURI .

