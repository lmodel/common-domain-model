            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML specified stepValue as a NonNegativeDecimal." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/stepValue> ] ] ;
    linkml:annotations [ a linkml:Annotation ;
