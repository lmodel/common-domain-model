<https://w3id.org/lmodel/common-domain-model/PriceQuantity> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:PriceQuantity"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: ArithmeticOperator — if observable -> Index -> InterestRateIndex exists and price exists then price -> arithmeticOperator exists",
        "Rosetta condition: InterestRateObservable — InterestRateObservableCondition",
        "Rosetta condition: NonCurrencyQuantities — (quantity count - quantity -> unit -> currency count) <= 1 or (observable -> Asset -> Commodity exists and quantity -> unit -> capacityUnit exists and (quantity count - quantity -> unit -> currency count) <= 2)",
        "Rosetta func: InterestRateObservableCondition — Implementation for PriceQuantity.InterestRateObservable condition." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"InterestRateObservableCondition\",\"description\":\"Implementation for PriceQuantity.InterestRateObservable condition.\",\"inputs\":[{\"name\":\"pq\",\"type\":\"PriceQuantity\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"valid\",\"type\":\"boolean\",\"cardinality\":\"0..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PriceQuantity"^^xsd:anyURI ;
    linkml:description "Defines a settlement as an exchange between two parties of a specified quantity of an asset (the quantity) against a specified quantity of another asset (the price). The settlement is optional and can be either cash or physical. The quantity can additionally be specified in terms of one or more currency amounts. In the case of non-cash products, the settlement of the price/quantity would not be specified here and instead would be delegated to the product mechanics, as parameterised by the price/quantity values." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PriceQuantity_effectiveDate>,
        <https://w3id.org/lmodel/common-domain-model/PriceQuantity_price>,
        <https://w3id.org/lmodel/common-domain-model/PriceQuantity_quantity>,
        <https://w3id.org/lmodel/common-domain-model/observable> .

<https://w3id.org/lmodel/common-domain-model/ResetDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:ResetDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: NonWeeklyPeriod — if resetFrequency -> period <> PeriodExtendedEnum -> W then resetFrequency -> weeklyRollConvention is absent",
        "Rosetta condition: RateCutOffDaysOffset — if rateCutOffDaysOffset exists then rateCutOffDaysOffset -> periodMultiplier < 0",
        "Rosetta condition: WeeklyPeriod — if resetFrequency -> period = PeriodExtendedEnum -> W then resetFrequency -> weeklyRollConvention exists" ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ResetDates"^^xsd:anyURI ;
    linkml:description "A data defining:  the parameters used to generate the reset dates schedule and associated fixing dates. The reset dates are the dates on which the new index value (which is observed on the fixing date) is applied for each period and on which the interest rate hence begins to accrue." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ResetDates_calculationPeriodDatesReference>,
        <https://w3id.org/lmodel/common-domain-model/finalFixingDate>,
        <https://w3id.org/lmodel/common-domain-model/fixingDates>,
        <https://w3id.org/lmodel/common-domain-model/initialFixingDate>,
        <https://w3id.org/lmodel/common-domain-model/rateCutOffDaysOffset>,
        <https://w3id.org/lmodel/common-domain-model/resetDatesAdjustments>,
        <https://w3id.org/lmodel/common-domain-model/resetFrequency>,
        <https://w3id.org/lmodel/common-domain-model/resetRelativeTo> .

<https://w3id.org/lmodel/common-domain-model/SecurityProviderRightsEvent> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_Japanese_2016"^^xsd:anyURI,
        "isda:CSA_IM_NewYork_2016"^^xsd:anyURI,
        "isda:CSD_IM_English_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(j)\" name \"Obligor Rights Event\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(j)\" name \"Pledgor Rights Event.\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(j)\" name \"Chargor Rights Event\"" ;
    skos:exactMatch "common_domain_model:SecurityProviderRightsEvent"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: RightsEvent_customElection — if customElection exists then includeCoolingOffLanguage = False",
        "Rosetta condition: RightsEvent_includeCoolingOffLanguage — if includeCoolingOffLanguage = True then customElection is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/includeCoolingOffLanguage> ] ;
            linkml:description "A data rule to enforce that, when the Rights Event election includes cooling off language, no custom election should be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/customElection> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/customElection> ] ;
            linkml:description "A data rule to enforce that, when the Rights Event is specified through a custom election, no standard cooling off language should be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/includeCoolingOffLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SecurityProviderRightsEvent"^^xsd:anyURI ;
    linkml:description "A class to specify the Pledgor/Obligor/Chargor Rights Event election." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SecurityProviderRightsEvent_customElection>,
        <https://w3id.org/lmodel/common-domain-model/SecurityProviderRightsEvent_fullDischarge>,
        <https://w3id.org/lmodel/common-domain-model/SecurityProviderRightsEvent_partyElection>,
        <https://w3id.org/lmodel/common-domain-model/automaticSetOff>,
        <https://w3id.org/lmodel/common-domain-model/includeCoolingOffLanguage> .

<https://w3id.org/lmodel/common-domain-model/isExchangeListed> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AssetBase.isExchangeListed"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/isExchangeListed"^^xsd:anyURI ;
    linkml:description "Defines whether the Asset is listed on a public exchange." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AssetBase> ;
    linkml:equals_string "True" ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/AssetBase> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/isExchangeListed"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/taxonomy> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AssetBase.taxonomy"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/taxonomy"^^xsd:anyURI ;
    linkml:description "Defines the taxonomy of an object by combining a taxonomy source (i.e. the rules to classify the object) and a value (i.e. the output of those rules on the object." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AssetBase>,
        <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Taxonomy> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/taxonomy"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/AvailableInventory> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_position> ;
    skos:closeMatch "fpml_5_10:AvailableInventory"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AvailableInventory"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_position"^^xsd:anyURI ;
    skos:note "Rosetta condition: ValidPartyRole — IsValidPartyRole( partyRole, [PartyRoleEnum -> AgentLender, PartyRoleEnum -> BeneficialOwner, PartyRoleEnum -> Borrower, PartyRoleEnum -> Custodian, PartyRoleEnum -> Lender] )" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AvailableInventory"^^xsd:anyURI ;
    linkml:description "A data type that can be used to describe the inventory of securities that a party holds. The securities are held in the AvailableInventoryRecord, with each item in the array being an individual security and its associated criteria. Criteria can include the quantity available, the rate at which the security is available to borrow at, as well as other details that can affect the decision as to whether a party wants to utilise the securities listed." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AvailableInventory_identifer>,
        <https://w3id.org/lmodel/common-domain-model/AvailableInventory_party>,
        <https://w3id.org/lmodel/common-domain-model/AvailableInventory_partyRole>,
        <https://w3id.org/lmodel/common-domain-model/availableInventoryRecord>,
        <https://w3id.org/lmodel/common-domain-model/availableInventoryType>,
        <https://w3id.org/lmodel/common-domain-model/comment>,
        <https://w3id.org/lmodel/common-domain-model/messageInformation> ;
    linkml:tree_root true .

<https://w3id.org/lmodel/common-domain-model/CalculationAndTimingCollateralTransferAgreement> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:closeMatch "fpml_5_10:CalculationAndTimingCollateralTransferAgreement"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CalculationAndTimingCollateralTransferAgreement"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculationAndTimingCollateralTransferAgreement"^^xsd:anyURI ;
    linkml:description "Specification of the Calculation, Valuation and Timing terms specific to the Initial Margin Credit Support Annex." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/CalculationAndTimingBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CalculationAndTimingCollateralTransferAgreement_calculationAgentTerms>,
        <https://w3id.org/lmodel/common-domain-model/CalculationAndTimingCollateralTransferAgreement_calculationDateLocation>,
        <https://w3id.org/lmodel/common-domain-model/bespokeCalculationDate>,
        <https://w3id.org/lmodel/common-domain-model/bespokeCalculationTime>,
        <https://w3id.org/lmodel/common-domain-model/cashSettlementDay>,
        <https://w3id.org/lmodel/common-domain-model/notificationTime>,
        <https://w3id.org/lmodel/common-domain-model/securitiesSettlementDay> .

<https://w3id.org/lmodel/common-domain-model/CalculationFrequency> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:CalculationFrequency"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CalculationFrequency"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: Dom — if dayOfMonth exists then dayOfMonth <= 31",
        "Rosetta condition: DomTerm — if dayOfMonth exists then (period -> period = PeriodEnum -> M)",
        "Rosetta condition: DowTerm — if dayOfWeek exists then (period -> period = PeriodEnum -> W)",
        "Rosetta condition: Moy — if monthOfYear exists then monthOfYear <= 12",
        "Rosetta condition: MoyTerm — if monthOfYear exists then (period -> period = PeriodEnum -> Y)",
        "Rosetta condition: Wom — if weekOfMonth exists then weekOfMonth <= 5",
        "Rosetta condition: WomTerm — if weekOfMonth exists then (period -> period = PeriodEnum -> M)" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dayOfMonth> ] ;
            linkml:description "Dom" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dayOfMonth> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/monthOfYear> ] ;
            linkml:description "Moy" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/monthOfYear> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/weekOfMonth> ] ;
            linkml:description "Wom" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/weekOfMonth> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculationFrequency"^^xsd:anyURI ;
    linkml:description "Represents the parameters for describing how often something (such as collateral interest) is to be calculated." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CalculationFrequency_businessCenter>,
        <https://w3id.org/lmodel/common-domain-model/CalculationFrequency_period>,
        <https://w3id.org/lmodel/common-domain-model/dateLocation>,
        <https://w3id.org/lmodel/common-domain-model/dayOfMonth>,
        <https://w3id.org/lmodel/common-domain-model/dayOfWeek>,
        <https://w3id.org/lmodel/common-domain-model/monthOfYear>,
        <https://w3id.org/lmodel/common-domain-model/offsetDays>,
        <https://w3id.org/lmodel/common-domain-model/weekOfMonth> .

<https://w3id.org/lmodel/common-domain-model/CounterpartyPosition> a linkml:ClassDefinition ;
