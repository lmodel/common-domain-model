    linkml:description "Indicate the Payout legs which nominal amount may vary in regards of FX Fixing dates as determined in the product terms." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PrincipalPayments> ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PrincipalPayments> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/varyingLegNotionalCurrency"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/varyingNotionalCurrency> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_scheme"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/varyingNotionalCurrency"^^xsd:anyURI ;
    linkml:description "The currency of the varying notional amount, i.e. the notional amount being determined periodically based on observation of a spot currency exchange rate. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FxLinkedNotionalSchedule> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FxLinkedNotionalSchedule> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/varyingNotionalCurrency"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/varyingNotionalFixingDates> a linkml:SlotDefinition ;
