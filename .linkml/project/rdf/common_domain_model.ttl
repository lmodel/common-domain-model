            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "A Position must either refer to a grouping by product or a grouping by asset." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/asset> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/product> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PositionBase"^^xsd:anyURI ;
    linkml:description "Base class to describe a Position, which could be a group of products (e.g. trade portfolio) or a group of assets (e.g. collateral portfolio)." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PositionBase_priceQuantity>,
        <https://w3id.org/lmodel/common-domain-model/PositionBase_product>,
        <https://w3id.org/lmodel/common-domain-model/PositionBase_tradeReference>,
        <https://w3id.org/lmodel/common-domain-model/asset>,
        <https://w3id.org/lmodel/common-domain-model/cashBalance> .

<https://w3id.org/lmodel/common-domain-model/PrincipalPayment> a linkml:ClassDefinition ;
