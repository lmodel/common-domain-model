        <https://w3id.org/lmodel/common-domain-model/InterestAmountApplication> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/InterestAmountApplication> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
