        <https://w3id.org/lmodel/common-domain-model/interestRate>,
        <https://w3id.org/lmodel/common-domain-model/security> .

<https://w3id.org/lmodel/common-domain-model/CSAValuationDate> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:closeMatch "fpml_5_10:CSAValuationDate"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CSAValuationDate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdditionalLanguage — if date is absent or frequency is absent then additionalLanguage exists",
        "Rosetta condition: CalendarDay — if date = ValuationDateDateEnum -> CalendarDay then calendarDay exists else calendarDay is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/date> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/frequency> ] ] ;
            linkml:description "If no methodology is defined, additional language must be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalLanguage> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/date> ] ;
            linkml:description "If a specific calendar day is specified, it must be defined." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/calendarDay> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CSAValuationDate"^^xsd:anyURI ;
    linkml:description "Specifies the date on which the value of collateral or exposure are calculated in accordance with the agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CSAValuationDate_additionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/CSAValuationDate_date>,
        <https://w3id.org/lmodel/common-domain-model/CSAValuationDate_day>,
        <https://w3id.org/lmodel/common-domain-model/CSAValuationDate_frequency>,
        <https://w3id.org/lmodel/common-domain-model/calendarDay> .

<https://w3id.org/lmodel/common-domain-model/Collateral> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:closeMatch "fpml_5_10:Collateral"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:Collateral"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta condition: CollateralExists — independentAmount exists or collateralPortfolio exists",
        "Rosetta condition: CollateralProvisions — if collateralPortfolio exists then collateralProvisions exists",
        "Rosetta condition: Collateralchoice — optional choice independentAmount, portfolioIdentifier, collateralPortfolio" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Collateral must represent either a simple independent amount or full collateral portfolio." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/collateralPortfolio> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/independentAmount> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Collateralchoice" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/portfolioIdentifier> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/collateralPortfolio> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/independentAmount> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/collateralPortfolio> ] ;
            linkml:description "When a collateral portfolio is provided, collateral provisions must exists that govern this collateral." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/collateralProvisions> ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Collateral"^^xsd:anyURI ;
    linkml:description "A type for defining the obligations of the counterparty subject to credit support requirements.",
        "Valuation of the collateral used against a trade." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Collateral_collateralPortfolio>,
        <https://w3id.org/lmodel/common-domain-model/Collateral_independentAmount>,
        <https://w3id.org/lmodel/common-domain-model/Collateral_portfolioIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/collateralProvisions> .

<https://w3id.org/lmodel/common-domain-model/CommodityPayout> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:closeMatch "fpml_5_10:CommodityPayout"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CommodityPayout"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: CalculationPeriod — required choice schedule, calculationPeriodDates",
        "Rosetta condition: CommodityUnderlier — if underlier -> Observable exists then ObservableIsCommodity(underlier -> Observable) else if underlier -> Product -> TransferableProduct -> economicTerms -> payout only-element -> OptionPayout exists then ObservableIsCommodity( underlier -> Product -> TransferableProduct -> economicTerms -> payout only-element -> OptionPayout -> underlier -> Observable ) // Commodity Option else if underlier -> Product -> TransferableProduct -> economicTerms -> payout only-element -> SettlementPayout exists then ObservableIsCommodity( underlier -> Product -> TransferableProduct -> economicTerms -> payout only-element -> SettlementPayout -> underlier -> Observable ) // Commodity Future else False",
        "Rosetta condition: DeliveryCapacity — if delivery -> deliveryCapacity exists then schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity exists then delivery -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if delivery -> periods -> profile -> block -> deliveryCapacity exists then schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> deliveryCapacity exists then delivery -> deliveryCapacity is absent and schedule -> schedulePeriod -> deliveryPeriod -> deliveryCapacity is absent and delivery -> periods -> profile -> block -> deliveryCapacity is absent",
        "Rosetta condition: PriceTimeIntervalQuantity — if schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity exists then delivery -> periods -> profile -> block -> priceTimeIntervalQuantity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity is absent else if delivery -> periods -> profile -> block -> priceTimeIntervalQuantity exists then schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity exists then schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity is absent and delivery -> periods -> profile -> block -> priceTimeIntervalQuantity is absent",
        "Rosetta condition: Quantity — priceQuantity exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "When there is an OptionPayout the quantity can be expressed as part of the payoutQuantity, or as part of the underlier in the case of a Swaption.  For all other payouts that extend PayoutBase the payoutQuantity is a mandatory attribute." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/priceQuantity> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The calculation periods are either specified parametrically via CalculationPeriodDates or non-parametrically via SchedulePeriod." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/schedule> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/calculationPeriodDates> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CommodityPayout"^^xsd:anyURI ;
    linkml:description "Payout based on the averaged price of a referenced underlier. (e.g. Commodities). Can represent both average (average of many) & bullet (average of 1) pricing" ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/PayoutBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CommodityPayout_schedule>,
        <https://w3id.org/lmodel/common-domain-model/CommodityPayout_underlier>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase_payerReceiver>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase_priceQuantity>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase_settlementTerms>,
        <https://w3id.org/lmodel/common-domain-model/averagingFeature>,
        <https://w3id.org/lmodel/common-domain-model/calculationPeriodDates>,
        <https://w3id.org/lmodel/common-domain-model/commodityPriceReturnTerms>,
        <https://w3id.org/lmodel/common-domain-model/delivery>,
        <https://w3id.org/lmodel/common-domain-model/fxFeature>,
        <https://w3id.org/lmodel/common-domain-model/paymentDates>,
        <https://w3id.org/lmodel/common-domain-model/pricingDates>,
        <https://w3id.org/lmodel/common-domain-model/principalPayment> .

