	skos:prefLabel "period" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Velocity> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Velocity> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PeriodTimeEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/period"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/velocity__periodMultiplier> a linkml:SlotDefinition ;
