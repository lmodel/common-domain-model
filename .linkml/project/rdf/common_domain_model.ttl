    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EvergreenProvision"^^xsd:anyURI ;
    linkml:description "Specifies a transaction which automatically extends for a specified timeframe until the exercise of an embedded option." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/EvergreenProvision_noticeDeadlinePeriod>,
        <https://w3id.org/lmodel/common-domain-model/EvergreenProvision_singlePartyOption>,
        <https://w3id.org/lmodel/common-domain-model/extensionFrequency>,
        <https://w3id.org/lmodel/common-domain-model/finalPeriodFeeAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/noticeDeadlineDateTime>,
        <https://w3id.org/lmodel/common-domain-model/noticePeriod> .

<https://w3id.org/lmodel/common-domain-model/GeneralTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:GeneralTerms"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: BasketReferenceInformationNameOrId — if basketReferenceInformation exists then basketReferenceInformation -> basketName exists or basketReferenceInformation -> basketId exists",
        "Rosetta condition: FpML_cd_41 — if indexReferenceInformation -> tranche is absent then modifiedEquityDelivery is absent",
        "Rosetta condition: FpML_cd_42 — if basketReferenceInformation is absent then substitution is absent",
        "Rosetta condition: GeneralTermsChoice — required choice referenceInformation, indexReferenceInformation, basketReferenceInformation" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/indexReferenceInformation> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/referenceInformation> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/basketReferenceInformation> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/basketReferenceInformation> ] ;
            linkml:description "FpML validation rule cd-42 - If basketReferenceInformation does not exist, then substitution must not exist." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/substitution> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/GeneralTerms"^^xsd:anyURI ;
    linkml:description " A class specifying a set of non-monetary terms for the Credit Derivative Transaction, including the buyer and seller and selected items from the ISDA 2014 Credit Definition article II, such as the reference obligation and related terms. The CDM GeneralTerms class corresponds to the FpML GeneralTerms complex type, except that the effectiveDate and scheduledTerminationDate have been positioned as part of the InterestRatePayout class in the CDM instead of in GeneralTerms." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/GeneralTerms_referenceInformation>,
        <https://w3id.org/lmodel/common-domain-model/GeneralTerms_substitution>,
        <https://w3id.org/lmodel/common-domain-model/additionalTerm>,
        <https://w3id.org/lmodel/common-domain-model/basketReferenceInformation>,
        <https://w3id.org/lmodel/common-domain-model/indexReferenceInformation>,
        <https://w3id.org/lmodel/common-domain-model/modifiedEquityDelivery> .

<https://w3id.org/lmodel/common-domain-model/PaymentDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:PaymentDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: FpML_ird_35_cd_31 — if firstPaymentDate exists and lastRegularPaymentDate exists then firstPaymentDate < lastRegularPaymentDate",
        "Rosetta condition: NonZeroPeriodMultiplier — if paymentDaysOffset exists then paymentDaysOffset -> periodMultiplier <> 0" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: firstPaymentDate < lastRegularPaymentDate" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/firstPaymentDate>,
                        <https://w3id.org/lmodel/common-domain-model/lastRegularPaymentDate> ] ;
            linkml:description "FpML validation rule ird-35 & cd-31- If firstPaymentDate exists, and if lastRegularPaymentDate exists, then firstPaymentDate must be before lastRegularPaymentDate." ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PaymentDates"^^xsd:anyURI ;
    linkml:description "Specifies the parameters to generate the payment date schedule, either through a parametric representation or by reference to specified dates." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/firstPaymentDate>,
        <https://w3id.org/lmodel/common-domain-model/lastRegularPaymentDate>,
        <https://w3id.org/lmodel/common-domain-model/payRelativeTo>,
        <https://w3id.org/lmodel/common-domain-model/paymentDateSchedule>,
        <https://w3id.org/lmodel/common-domain-model/paymentDatesAdjustments>,
        <https://w3id.org/lmodel/common-domain-model/paymentDaysOffset>,
        <https://w3id.org/lmodel/common-domain-model/paymentFrequency> .

<https://w3id.org/lmodel/common-domain-model/PerformanceValuationDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:PerformanceValuationDates"^^xsd:anyURI ;
