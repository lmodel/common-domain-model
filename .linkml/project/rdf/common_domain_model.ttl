	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/sourceProvider"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/initial> a linkml:SlotDefinition ;
	linkml:description "The natural person's middle initial(s). If a middle initial is provided then a name should be absent." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/initialCustodian> a linkml:SlotDefinition ;
	linkml:annotations _:c14n497 ;
	linkml:description "Election to specify the initial custodian." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/LegalEntity> .
<https://w3id.org/lmodel/common-domain-model/initialDesignation> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1990 ;
	linkml:description "Election to specify the initial custodian." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/LegalEntity> .
<https://w3id.org/lmodel/common-domain-model/initialFee> a linkml:SlotDefinition ;
	linkml:description "An initial fee for the cancelable option." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Transfer> .
<https://w3id.org/lmodel/common-domain-model/initialFixingDate> a linkml:SlotDefinition ;
	linkml:description "The initial fixing date." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/InitialFixingDate> , <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/initialFixingDate__initialFixingDate> a linkml:SlotDefinition ;
