        <https://w3id.org/lmodel/common-domain-model/TripartyAgent> .

<https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum> skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PayerReceiverEnum"^^xsd:anyURI ;
    linkml:description "The enumerated values to specify an interest rate stream payer or receiver party." ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/Payer>,
        <https://w3id.org/lmodel/common-domain-model/Receiver> .

<https://w3id.org/lmodel/common-domain-model/Payout> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:Payout"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." ;
    linkml:abstract true ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Payout"^^xsd:anyURI ;
    linkml:description "Represents the set of future cashflow methodologies in the form of specific payout data type(s) which result from the financial product.  Examples: a trade in a cash asset will use only a settlement payout; for derivatives, two interest rate payouts can be combined to specify an interest rate swap; one interest rate payout can be combined with a credit default payout to specify a credit default swap." ;
    linkml:slot_usage [ ] ;
    linkml:union_of <https://w3id.org/lmodel/common-domain-model/AssetPayout>,
        <https://w3id.org/lmodel/common-domain-model/CommodityPayout>,
        <https://w3id.org/lmodel/common-domain-model/CreditDefaultPayout>,
        <https://w3id.org/lmodel/common-domain-model/FixedPricePayout>,
        <https://w3id.org/lmodel/common-domain-model/InterestRatePayout>,
        <https://w3id.org/lmodel/common-domain-model/OptionPayout>,
        <https://w3id.org/lmodel/common-domain-model/PerformancePayout>,
        <https://w3id.org/lmodel/common-domain-model/SettlementPayout> .

<https://w3id.org/lmodel/common-domain-model/Portfolio> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_position> ;
    skos:exactMatch "common_domain_model:Portfolio"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_position"^^xsd:anyURI ;
    skos:note "Rosetta func: EvaluatePortfolioState — Function specification to evaluate a portfolio's aggregation parameters and return a new portfolio state containing aggregated positions." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"EvaluatePortfolioState\",\"description\":\"Function specification to evaluate a portfolio's aggregation parameters and return a new portfolio state containing aggregated positions.\",\"inputs\":[{\"name\":\"portfolio\",\"type\":\"Portfolio\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"portfolioState\",\"type\":\"PortfolioState\",\"cardinality\":\"1..1\"},\"code_implementation\":true}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Portfolio"^^xsd:anyURI ;
    linkml:description " A Portfolio represents an aggregation of multiple Positions, by describing the parameters that this Portfolio should be aggregated based on. The resulting PortfolioState is calculated using these aggregation parameters as inputs, by aggregating all the Events that are relevant to this Portfolio. The concept of Portfolio works at all levels in the model: from the highest for a given LegalEntity for instance, to the lowest to account for security substitutions in a secutity financing transaction. As such, Portfolio can be used either above or below the Contract level." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/aggregationParameters>,
        <https://w3id.org/lmodel/common-domain-model/portfolioState> .

<https://w3id.org/lmodel/common-domain-model/QuantitySchedule> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_math> ;
    skos:exactMatch "common_domain_model:QuantitySchedule"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    skos:note "Rosetta condition: Quantity_multiplier — if multiplier exists then multiplier -> value >= 0.0",
        "Rosetta condition: UnitOfAmountExists — unit exists",
        "Rosetta func: FilterQuantityByCurrency — Filter list of quantities based on unit type.",
        "Rosetta func: FilterQuantityByCurrencyExists — Filter list of quantities based on unit type.",
        "Rosetta func: FilterQuantityByFinancialUnit — Filter list of quantities based on unit type." ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Requires that a unit of amount must be specified for any quantity." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unit> ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"FilterQuantityByCurrency\",\"description\":\"Filter list of quantities based on unit type.\",\"inputs\":[{\"name\":\"quantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"},{\"name\":\"currency\",\"type\":\"string\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredQuantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"}},{\"name\":\"FilterQuantityByCurrencyExists\",\"description\":\"Filter list of quantities based on unit type.\",\"inputs\":[{\"name\":\"quantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"filteredQuantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"}},{\"name\":\"FilterQuantityByFinancialUnit\",\"description\":\"Filter list of quantities based on unit type.\",\"inputs\":[{\"name\":\"quantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"},{\"name\":\"financialUnit\",\"type\":\"FinancialUnitEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredQuantities\",\"type\":\"QuantitySchedule\",\"cardinality\":\"0..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/QuantitySchedule"^^xsd:anyURI ;
    linkml:description "Specifies a quantity schedule to be associated to a financial product to represent a trade amount. This data type extends MeasureSchedule with several unit or multiplier attributes that are used to define financial quantities. This data type is generically based on a schedule and can also be used to represent a quantity as a single value." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/MeasureSchedule> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/datedValue>,
        <https://w3id.org/lmodel/common-domain-model/frequency>,
        <https://w3id.org/lmodel/common-domain-model/multiplier>,
        <https://w3id.org/lmodel/common-domain-model/unit>,
        <https://w3id.org/lmodel/common-domain-model/value> .

<https://w3id.org/lmodel/common-domain-model/QuasiGovernmentIssuerType> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:QuasiGovernmentIssuerType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: NonSovereignEntityRecourse — if sovereignRecourse exists then sovereignEntity = False" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/sovereignRecourse> ] ;
            linkml:description "NonSovereignEntityRecourse" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/sovereignEntity> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/QuasiGovernmentIssuerType"^^xsd:anyURI ;
    linkml:description "Represents a class to allow specification of different types of Quasi Government collateral." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/sovereignEntity>,
        <https://w3id.org/lmodel/common-domain-model/sovereignRecourse> .

<https://w3id.org/lmodel/common-domain-model/RatingMultiplier> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:RatingMultiplier"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: RestrictingCreditNotation — ratingVariableSet -> scale is absent and ratingVariableSet -> outlook is absent and ratingVariableSet -> debt is absent and ratingVariableSet -> creditWatch is absent and ratingVariableSet -> agency exists and ratingVariableSet -> notation exists" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/RatingMultiplier"^^xsd:anyURI ;
    linkml:description "A logical container to hold a defined set of related data. In this case the collation of Ratings Information and associated exposure multiplier." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/exposureMultiplier>,
        <https://w3id.org/lmodel/common-domain-model/ratingVariableSet> .

<https://w3id.org/lmodel/common-domain-model/ReferenceBanks> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:altLabel "Reference Banks Rate" ;
    skos:exactMatch "common_domain_model:ReferenceBanks"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ReferenceBanks"^^xsd:anyURI ;
    linkml:description "A class defining the list of reference institutions polled for relevant rates or prices when determining the cash settlement amount for a product where cash settlement is applicable.",
        "The rate is obtained by polling several other banks." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/referenceBank> .

<https://w3id.org/lmodel/common-domain-model/ResetInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:ResetInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_Reset — Defines how a Reset should be constructed." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_Reset\",\"description\":\"Defines how a Reset should be constructed.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"ResetInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"reset\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ResetInstruction"^^xsd:anyURI ;
    linkml:description "Defines the information needed to create a Reset Business Event. " ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/payout>,
        <https://w3id.org/lmodel/common-domain-model/rateRecordDate>,
        <https://w3id.org/lmodel/common-domain-model/resetDate> .

<https://w3id.org/lmodel/common-domain-model/ReturnInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:ReturnInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_Return — Defines the process of partially or fully returning a Security Lending Transaction." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_Return\",\"description\":\"Defines the process of partially or fully returning a Security Lending Transaction.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"},{\"name\":\"returnInstruction\",\"type\":\"ReturnInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"returnDate\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"returnEvent\",\"type\":\"BusinessEvent\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ReturnInstruction"^^xsd:anyURI ;
    linkml:description "Specifies the information required to create the return of a Security Finance Transaction." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ReturnInstruction_quantity> .

