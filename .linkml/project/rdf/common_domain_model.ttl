<https://w3id.org/lmodel/common-domain-model/IndexTransitionInstruction_effectiveDate> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CodeValue.effectiveDate"^^xsd:anyURI ;
