    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    skos:note "Rosetta condition: AtLeastOneOf — lowerBound exists or upperBound exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "AtLeastOneOf" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/upperBound> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/lowerBound> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MoneyRange"^^xsd:anyURI ;
    linkml:description "The money range defined as either a lower and upper money bound, or both." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/MoneyRange_lowerBound>,
        <https://w3id.org/lmodel/common-domain-model/MoneyRange_upperBound> .

<https://w3id.org/lmodel/common-domain-model/MultipleDebtTypes> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:MultipleDebtTypes"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MultipleDebtTypes"^^xsd:anyURI ;
    linkml:description "Represents a class to specify multiple credit debt types alongside a conditional 'any' or 'all' qualifier." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/MultipleDebtTypes_condition>,
        <https://w3id.org/lmodel/common-domain-model/MultipleDebtTypes_debtType> .

<https://w3id.org/lmodel/common-domain-model/ObservationDate> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:ObservationDate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: ObservationDate — required choice unadjustedDate, adjustedDate" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Either an unadjusted date or an adjusted date needs to be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustedDate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unadjustedDate> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ObservationDate"^^xsd:anyURI ;
    linkml:description "Specifies a single date on which market observations take place and specifies optional associated weighting." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ObservationDate_unadjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/observationReference>,
        <https://w3id.org/lmodel/common-domain-model/weight> .

<https://w3id.org/lmodel/common-domain-model/PrincipalPayments> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement> ;
    skos:exactMatch "common_domain_model:PrincipalPayments"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PrincipalPayments"^^xsd:anyURI ;
    linkml:description "A class defining which principal exchanges occur for the stream." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/finalPayment>,
        <https://w3id.org/lmodel/common-domain-model/initialPayment>,
        <https://w3id.org/lmodel/common-domain-model/intermediatePayment>,
        <https://w3id.org/lmodel/common-domain-model/principalPaymentSchedule>,
        <https://w3id.org/lmodel/common-domain-model/varyingLegNotionalCurrency> .

<https://w3id.org/lmodel/common-domain-model/ReferencePoolItem> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:ReferencePoolItem"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: SettlementChoice — optional choice cashSettlementTermsReference, physicalSettlementTermsReference" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "A choice rule between a reference to the cash or physical settlement terms." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/physicalSettlementTermsReference> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/cashSettlementTermsReference> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ReferencePoolItem"^^xsd:anyURI ;
    linkml:description "This type contains all the constituent weight and reference information." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/cashSettlementTermsReference>,
        <https://w3id.org/lmodel/common-domain-model/constituentWeight>,
        <https://w3id.org/lmodel/common-domain-model/physicalSettlementTermsReference>,
        <https://w3id.org/lmodel/common-domain-model/protectionTermsReference>,
        <https://w3id.org/lmodel/common-domain-model/referencePair> .

<https://w3id.org/lmodel/common-domain-model/ResolutionValue> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ResolutionValue"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: OtherValues — if cash = ValueCashEnum -> Other or securities = ValueSecuritiesEnum -> Other then additionalLanguage exists" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ResolutionValue"^^xsd:anyURI ;
    linkml:description "Methodology for resolving disputes in respect of the determination of the value of collateral." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ResolutionValue_additionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/cash>,
        <https://w3id.org/lmodel/common-domain-model/fallback>,
        <https://w3id.org/lmodel/common-domain-model/securities> .

<https://w3id.org/lmodel/common-domain-model/SecuredDebt> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:SecuredDebt"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: AssetBackedExists — if securedType <> SecuredTypeEnum -> AssetBacked then assetBacked is absent",
        "Rosetta condition: CollateralizedObligationExists — if securedType <> CollateralizedObligation then collateralizedObligation is absent",
        "Rosetta condition: CoveredBondsExists — if securedType <> CoveredBonds then coveredBond is absent",
        "Rosetta condition: PropertyExists — if assetBacked <> Mortgage or assetBacked <> Property or collateralizedObligation <> CMO then propertyType is absent" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securedType <> CoveredBonds" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securedType> ] ;
            linkml:description "Condition to restrict selection of the coveredBonds attribute if CoveredBonds is not set as the securedType value." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/coveredBond> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securedType <> SecuredTypeEnum -> AssetBacked" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securedType> ] ;
            linkml:description "Condition to restrict selection of the assetBacked attribute if AssetBacked is not set as the securedType value." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/assetBacked> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securedType <> CollateralizedObligation" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securedType> ] ;
            linkml:description "Condition to restrict selection of the collateralizedObligations attribute if CollateralizedObligation is not set as the securedType value." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/collateralizedObligation> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SecuredDebt"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/assetBacked>,
        <https://w3id.org/lmodel/common-domain-model/collateralizedObligation>,
        <https://w3id.org/lmodel/common-domain-model/coveredBond>,
        <https://w3id.org/lmodel/common-domain-model/propertyType>,
        <https://w3id.org/lmodel/common-domain-model/securedType> .

<https://w3id.org/lmodel/common-domain-model/SpecifiedOrAccessConditionPartyElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:SpecifiedOrAccessConditionPartyElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdditionalTerminationEvent — if specifiedOrAccessCondition any = CSASpecifiedOrAccessConditionEnum -> AdditionalTerminationEvents then additionalTerminationEvent exists else additionalTerminationEvent is absent",
        "Rosetta condition: SpecifiedAdditionalTerminationEvent — if additionalTerminationEvent any = AdditionalTerminationEventEnum -> AsSpecified then specifiedAdditionalTerminationEvent exists else specifiedAdditionalTerminationEvent is absent" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SpecifiedOrAccessConditionPartyElection"^^xsd:anyURI ;
    linkml:description "The party specific elections in respect to the Specified Condition and Access Condition clause." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SpecifiedOrAccessConditionPartyElection_party>,
        <https://w3id.org/lmodel/common-domain-model/additionalTerminationEvent>,
        <https://w3id.org/lmodel/common-domain-model/specifiedAdditionalTerminationEvent>,
        <https://w3id.org/lmodel/common-domain-model/specifiedOrAccessCondition> .

<https://w3id.org/lmodel/common-domain-model/TerminationCurrencySelection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isda> ;
    skos:exactMatch "common_domain_model:TerminationCurrencySelection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isda"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TerminationCurrencySelection"^^xsd:anyURI ;
    linkml:description "Specifies Termination Currency where a currency is stated at the time the agreement is entered into." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/TerminationCurrencySelection_partyElection>,
        <https://w3id.org/lmodel/common-domain-model/bothAffected>,
        <https://w3id.org/lmodel/common-domain-model/fallbackCurrency>,
        <https://w3id.org/lmodel/common-domain-model/statedCurrency> .

<https://w3id.org/lmodel/common-domain-model/TerminationProvision> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:TerminationProvision"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: TerminationProvisionChoice — required choice cancelableProvision, extendibleProvision, evergreenProvision, earlyTerminationProvision, recallProvision" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "TerminationProvisionChoice" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/evergreenProvision> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/cancelableProvision> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/recallProvision> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/earlyTerminationProvision> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/extendibleProvision> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TerminationProvision"^^xsd:anyURI ;
    linkml:description "A class for defining option provisions." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/cancelableProvision>,
        <https://w3id.org/lmodel/common-domain-model/earlyTerminationProvision>,
        <https://w3id.org/lmodel/common-domain-model/evergreenProvision>,
        <https://w3id.org/lmodel/common-domain-model/extendibleProvision>,
        <https://w3id.org/lmodel/common-domain-model/recallProvision> .

<https://w3id.org/lmodel/common-domain-model/TimeZone> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:exactMatch "common_domain_model:TimeZone"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta func: TimeZoneFromBusinessCenterTime — Function to resolve a time passed as BusinessCenterTime into a TimeZone time." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "[{\"name\":\"TimeZoneFromBusinessCenterTime\",\"description\":\"Function to resolve a time passed as BusinessCenterTime into a TimeZone time.\",\"inputs\":[{\"name\":\"time\",\"type\":\"BusinessCenterTime\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"TimeZone\",\"cardinality\":\"1..1\"},\"code_implementation\":true}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TimeZone"^^xsd:anyURI ;
    linkml:description "The time alongside with the timezone location information. This class makes use of the FpML TimezoneLocation construct." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/location>,
        <https://w3id.org/lmodel/common-domain-model/time> .

<https://w3id.org/lmodel/common-domain-model/TradeLot> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:TradeLot"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta func: AddTradeLot — Add a TradeLot to an existing list of TradeLots.",
        "Rosetta func: CompareTradeLot — Compare the Quantity in TradeLot 1 to the Quantity (with the same unit of amount) in TradeLot 2, based on the CompareOp enum.",
        "Rosetta func: CompareTradeLotToAmount — Compare the Quantity amount in TradeLot to the given amount (regardless of unit of amount), based on the CompareOp enum.",
        "Rosetta func: FilterTradeLot — Filter list of TradeLot based on TradeLot->lotIdentifier.",
        "Rosetta func: PriceQuantityTriangulation — Defines all the scenarios which triangulation can be helpful validation between Prices and Quantities.",
        "Rosetta func: ReplaceTradeLot — Replace TradeLot in with matching TradeLot->lotIdentifier." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"FilterTradeLot\",\"description\":\"Filter list of TradeLot based on TradeLot->lotIdentifier.\",\"inputs\":[{\"name\":\"tradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"},{\"name\":\"lotIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"filteredTradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"}},{\"name\":\"AddTradeLot\",\"description\":\"Add a TradeLot to an existing list of TradeLots.\",\"inputs\":[{\"name\":\"tradableProduct\",\"type\":\"TradableProduct\",\"cardinality\":\"1..1\"},{\"name\":\"newTradeLot\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"updatedTradableProduct\",\"type\":\"TradableProduct\",\"cardinality\":\"1..1\"}},{\"name\":\"ReplaceTradeLot\",\"description\":\"Replace TradeLot in with matching TradeLot->lotIdentifier.\",\"inputs\":[{\"name\":\"tradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"},{\"name\":\"newTradeLot\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"mergedTradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"}},{\"name\":\"CompareTradeLot\",\"description\":\"Compare the Quantity in TradeLot 1 to the Quantity (with the same unit of amount) in TradeLot 2, based on the CompareOp enum.\",\"inputs\":[{\"name\":\"tradeLot1\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"},{\"name\":\"op\",\"type\":\"CompareOp\",\"cardinality\":\"1..1\"},{\"name\":\"tradeLot2\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CompareTradeLotToAmount\",\"description\":\"Compare the Quantity amount in TradeLot to the given amount (regardless of unit of amount), based on the CompareOp enum.\",\"inputs\":[{\"name\":\"tradeLot\",\"type\":\"TradeLot\",\"cardinality\":\"1..1\"},{\"name\":\"op\",\"type\":\"CompareOp\",\"cardinality\":\"1..1\"},{\"name\":\"amount\",\"type\":\"number\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"PriceQuantityTriangulation\",\"description\":\"Defines all the scenarios which triangulation can be helpful validation between Prices and Quantities.\",\"inputs\":[{\"name\":\"tradeLots\",\"type\":\"TradeLot\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"success\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TradeLot"^^xsd:anyURI ;
    linkml:description "Specifies the price and quantity of a trade lot, where the same product could be traded multiple times with the same counterparty but in different lots (at a different date, in a different quantity and at a different price). One trade lot combined with a product definition specifies the entire economics of a trade. The lifecycle mechanics of each such trade lot (e.g. cashflow payments) is independent of the other lots." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/TradeLot_lotIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/TradeLot_priceQuantity> .

<https://w3id.org/lmodel/common-domain-model/ValuationCalculationDateLocationElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_Japanese_2016"^^xsd:anyURI,
        "isda:CSA_IM_NewYork_2016"^^xsd:anyURI,
        "isda:CSD_IM_English_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(e)(i)\" name \"Calculation Date Location\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(d)(i)\" name \"Calculation Date Location\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(d)(i)\" name \"Calculation Date Location\"" ;
    skos:exactMatch "common_domain_model:ValuationCalculationDateLocationElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: Choice — required choice businessCenter, customLocation" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The Calculation Date Location is specified either as a standard business center or as a custom location." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/customLocation> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/businessCenter> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ValuationCalculationDateLocationElection"^^xsd:anyURI ;
    linkml:description "A class to specify each of the party elections with respect to the Calculation Date Location." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ValuationCalculationDateLocationElection_businessCenter>,
        <https://w3id.org/lmodel/common-domain-model/ValuationCalculationDateLocationElection_party>,
        <https://w3id.org/lmodel/common-domain-model/customLocation> .

<https://w3id.org/lmodel/common-domain-model/dateAdjustments> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AdjustableDate.dateAdjustments"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/dateAdjustments"^^xsd:anyURI ;
    linkml:description "The business day convention and financial business centers used for adjusting the date if it would otherwise fall on a day that is not a business date in the specified business centers." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AdjustableDate>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableDates>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedOrRelativeDate>,
        <https://w3id.org/lmodel/common-domain-model/DividendPeriod>,
        <https://w3id.org/lmodel/common-domain-model/EconomicTerms>,
        <https://w3id.org/lmodel/common-domain-model/ObservationSchedule> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/EconomicTerms> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessDayAdjustments> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dateAdjustments"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/partyReference> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_reference"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/partyReference"^^xsd:anyURI ;
    linkml:description "Specifies the party that is associated to the counterparty." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Account>,
        <https://w3id.org/lmodel/common-domain-model/AncillaryParty>,
        <https://w3id.org/lmodel/common-domain-model/ContactInformationElection>,
        <https://w3id.org/lmodel/common-domain-model/Counterparty>,
        <https://w3id.org/lmodel/common-domain-model/PartyAgreementIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/PartyCustomisedWorkflow>,
        <https://w3id.org/lmodel/common-domain-model/PartyRole>,
        <https://w3id.org/lmodel/common-domain-model/RelatedParty> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PartyAgreementIdentifier> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Party> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/partyReference"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/priceQuantity> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/priceQuantity"^^xsd:anyURI ;
    linkml:description "Defines the prices (e.g. spread, equity price, FX rate), quantities (e.g. currency amount, no. shares) and settlement terms (e.g. initial fee, broker fee, up-front cds payment or option premium settlement) associated with the constituents of the transacted product." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ExecutionInstruction>,
        <https://w3id.org/lmodel/common-domain-model/IndexTransitionInstruction>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase>,
        <https://w3id.org/lmodel/common-domain-model/PositionBase>,
        <https://w3id.org/lmodel/common-domain-model/TradeLot> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/TradeLot> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/priceQuantity"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/Asset> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:Asset"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." ;
    linkml:abstract true ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Asset"^^xsd:anyURI ;
    linkml:description "An Asset is defined as something that can be owned and transferred in the financial markets. As a choice data type, one and only one of the attributes must be used.",
        "Denotes that the Asset Criteria has priority.",
        "Specifies a limit on a single asset in the eligible collateral schedule" ;
    linkml:slot_usage [ ] ;
    linkml:union_of <https://w3id.org/lmodel/common-domain-model/Cash>,
        <https://w3id.org/lmodel/common-domain-model/Commodity>,
        <https://w3id.org/lmodel/common-domain-model/DigitalAsset>,
        <https://w3id.org/lmodel/common-domain-model/Instrument> .

<https://w3id.org/lmodel/common-domain-model/AssetDeliveryPeriods> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:closeMatch "fpml_5_10:AssetDeliveryPeriods"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AssetDeliveryPeriods"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AssetDeliveryPeriods"^^xsd:anyURI ;
    linkml:description "Defines the periods of delivery, including the delivery profile." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AssetDeliveryPeriods_endDate>,
        <https://w3id.org/lmodel/common-domain-model/AssetDeliveryPeriods_startDate>,
        <https://w3id.org/lmodel/common-domain-model/profile> .

<https://w3id.org/lmodel/common-domain-model/AveragingPeriod> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:closeMatch "fpml_5_10:AveragingPeriod"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AveragingPeriod"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: AveragingPeriodChoice — optional choice averagingDateTimes, averagingObservations" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description " Choice rule to represent an FpML choice construct between unweighted and weighted averaging date and times." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/averagingDateTimes> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/averagingObservations> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AveragingPeriod"^^xsd:anyURI ;
    linkml:description "Period over which an average value is taken." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AveragingPeriod_schedule>,
        <https://w3id.org/lmodel/common-domain-model/averagingDateTimes>,
        <https://w3id.org/lmodel/common-domain-model/averagingObservations>,
        <https://w3id.org/lmodel/common-domain-model/marketDisruption> .

<https://w3id.org/lmodel/common-domain-model/AveragingSchedule> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:AveragingSchedule"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AveragingSchedule"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AveragingSchedule"^^xsd:anyURI ;
    linkml:description "Class to representing a method for generating a series of dates." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AveragingSchedule_endDate>,
        <https://w3id.org/lmodel/common-domain-model/AveragingSchedule_startDate>,
        <https://w3id.org/lmodel/common-domain-model/averagingPeriodFrequency> .

<https://w3id.org/lmodel/common-domain-model/BaseAndEligibleCurrency> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:closeMatch "fpml_5_10:BaseAndEligibleCurrency"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:BaseAndEligibleCurrency"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/BaseAndEligibleCurrency"^^xsd:anyURI ;
    linkml:description "The base and eligible currency(ies) for the document as specified by the parties to the agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/baseCurrency>,
        <https://w3id.org/lmodel/common-domain-model/baseCurrencyOther>,
