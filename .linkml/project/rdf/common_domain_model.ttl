	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dividendValuationDates"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/valuationTerms__fPVFinalPriceElectionFallback> a linkml:SlotDefinition ;
