    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/varyingNotionalInterimExchangePaymentDates"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/vegaNotionalAmount> a linkml:SlotDefinition ;
