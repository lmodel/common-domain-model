<https://w3id.org/lmodel/common-domain-model/Party> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:broadMatch "iso29100:PrivacyStakeholder"^^xsd:anyURI ;
    skos:closeMatch "gist:Organization"^^xsd:anyURI,
        "oscal:Party"^^xsd:anyURI,
        "spdx:Agent"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:Party"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    skos:note "Rosetta func: ReplaceParty — Removes the old party, and adds the new party." ;
    skos:relatedMatch "gist:Person"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "[{\"name\":\"ReplaceParty\",\"description\":\"Removes the old party, and adds the new party.\",\"inputs\":[{\"name\":\"parties\",\"type\":\"Party\",\"cardinality\":\"0..*\"},{\"name\":\"oldParty\",\"type\":\"Party\",\"cardinality\":\"1..1\"},{\"name\":\"newParty\",\"type\":\"Party\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"updatedParties\",\"type\":\"Party\",\"cardinality\":\"0..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Party"^^xsd:anyURI ;
    linkml:description "A class to specify a party, without a qualification as to whether this party is a legal entity or a natural person, although the model provides the ability to associate a person (or set of persons) to a party, which use case would imply that such party would be a legal entity (even if not formally specified as such). ",
        "Party." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Party_contactInformation>,
        <https://w3id.org/lmodel/common-domain-model/Party_name>,
        <https://w3id.org/lmodel/common-domain-model/account>,
        <https://w3id.org/lmodel/common-domain-model/businessUnit>,
        <https://w3id.org/lmodel/common-domain-model/partyId>,
        <https://w3id.org/lmodel/common-domain-model/person>,
        <https://w3id.org/lmodel/common-domain-model/personRole> .

