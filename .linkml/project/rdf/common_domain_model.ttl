<https://w3id.org/lmodel/common-domain-model/CollateralInterestCalculationParameters> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:closeMatch "fpml_5_10:CollateralInterestCalculationParameters"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CollateralInterestCalculationParameters"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta condition: CompoundingBC1 — if compoundingType = CompoundingTypeEnum -> Business then compoundingBusinessCenter exists",
        "Rosetta condition: CompoundingBC2 — if compoundingType <> CompoundingTypeEnum -> Business then compoundingBusinessCenter is absent",
        "Rosetta condition: DCF — dayCountFraction = DayCountFractionEnum -> ACT_360 or dayCountFraction = DayCountFractionEnum -> ACT_365_FIXED",
        "Rosetta condition: InterestRate — required choice fixedRate, floatingRate" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta negation: compoundingType <> CompoundingTypeEnum -> Business" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compoundingType> ] ;
            linkml:description "CompoundingBC2" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compoundingBusinessCenter> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compoundingType> ] ;
            linkml:description "CompoundingBC1" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compoundingBusinessCenter> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "InterestRate" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fixedRate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/floatingRate> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CollateralInterestCalculationParameters"^^xsd:anyURI ;
    linkml:description "Represents parameters for calculating the amount the floating interest calculation, e.g.  for a single currency or defaults for all currencies." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CollateralInterestCalculationParameters_dayCountFraction>,
        <https://w3id.org/lmodel/common-domain-model/CollateralInterestCalculationParameters_fixedRate>,
        <https://w3id.org/lmodel/common-domain-model/CollateralInterestCalculationParameters_floatingRate>,
        <https://w3id.org/lmodel/common-domain-model/CollateralInterestCalculationParameters_rounding>,
        <https://w3id.org/lmodel/common-domain-model/compoundingBusinessCenter>,
        <https://w3id.org/lmodel/common-domain-model/compoundingType>,
        <https://w3id.org/lmodel/common-domain-model/inBaseCurrency>,
        <https://w3id.org/lmodel/common-domain-model/roundingFrequency>,
        <https://w3id.org/lmodel/common-domain-model/withholdingTaxRate> .

