	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/ratingVariableSet"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/ratingAgencyValue__ratedParty> a linkml:SlotDefinition ;
