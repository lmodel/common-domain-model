<https://w3id.org/lmodel/common-domain-model/OneWayProvisions> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(aa)\" name \"One Way Provisions\"" ;
    skos:exactMatch "common_domain_model:OneWayProvisions"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: PostingPartyAbsent — if isApplicable = False then postingParty is absent",
        "Rosetta condition: PostingPartyExists — if isApplicable = True then postingParty exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isApplicable> ] ;
            linkml:description "A data rule to enforce that the Posting Party must not be specified in the case where the One Way Provision is not deemed applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/postingParty> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isApplicable> ] ;
            linkml:description "A data rule to enforce that the Posting Party must be specified in the case where the One Way Provision is deemed applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/postingParty> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/OneWayProvisions"^^xsd:anyURI ;
    linkml:description "A class to specify whether One Way Provisions apply." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/OneWayProvisions_isApplicable>,
        <https://w3id.org/lmodel/common-domain-model/postingParty> .

