<https://w3id.org/lmodel/common-domain-model/fxFixingDate> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/fxFixingDate"^^xsd:anyURI ;
    linkml:description "The date on which the currency rate will be determined for the purpose of specifying the amount in deliverable currency. This attribute was formerly part of 'NonDeliverableSettlement', which is now being harmonised into a common 'CashSettlementTerms' that includes a 'ValuationDate'." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FxFixingDate>,
        <https://w3id.org/lmodel/common-domain-model/ValuationDate> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FxFixingDate> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/FxFixingDate> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fxFixingDate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/fxLinkedNotionalAmount> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CalculationPeriod.fxLinkedNotionalAmount"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/fxLinkedNotionalAmount"^^xsd:anyURI ;
    linkml:description "The amount that a cashflow will accrue interest on. This is the calculated amount of the FX linked - i.e. the other currency notional amount multiplied by the appropriate FX spot rate." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriod> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CalculationPeriod> ;
