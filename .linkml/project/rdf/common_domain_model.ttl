    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/vegaNotionalAmount"^^xsd:anyURI ;
    linkml:description "Vega Notional represents the approximate gain/loss at maturity for a 1% difference between RVol (realised vol) and KVol (strike vol). It does not necessarily represent the Vega Risk of the trade." ;
