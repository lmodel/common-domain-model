    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/observationTerms"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/observationTime> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/observationTime"^^xsd:anyURI ;
    linkml:description "Represents the time and time-zone." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ObservationIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/ObservationTerms> ;
