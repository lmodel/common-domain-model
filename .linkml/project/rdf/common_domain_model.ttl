    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fxLinkedNotionalAmount"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/generalSimmElections> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
