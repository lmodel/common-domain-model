<https://w3id.org/lmodel/common-domain-model/ContractFormationInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:ContractFormationInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: ExecutedAgreements — if legalAgreement exists then legalAgreement -> agreementDate exists",
        "Rosetta func: Create_ContractFormation — Function specification that represents an executed trade for a contractual product that has been affirmed (or confirmed) by the two parties. The formed contract can reference a legal agreement for instance a master agreement, by using the optional legalAgreement input.",
        "Rosetta func: Create_ContractFormationInstruction" ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_ContractFormationInstruction\",\"inputs\":[{\"name\":\"legalAgreement\",\"type\":\"LegalAgreement\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"instruction\",\"type\":\"ContractFormationInstruction\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_ContractFormation\",\"description\":\"Function specification that represents an executed trade for a contractual product that has been affirmed (or confirmed) by the two parties. The formed contract can reference a legal agreement for instance a master agreement, by using the optional legalAgreement input.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"ContractFormationInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"execution\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"contractFormation\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ContractFormationInstruction"^^xsd:anyURI ;
    linkml:description "Specifies instructions to create a fully formed contract, with optional legal agreements." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/legalAgreement> .

