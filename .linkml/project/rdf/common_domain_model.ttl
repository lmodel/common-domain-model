    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dayFrequency"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/dealerOrCCP> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/dealerOrCCP"^^xsd:anyURI ;
    linkml:description "Holds an identifier for the reference entity that is agreed by both parties as a basis for cash settlement calculations. This could be a dealer from whom quotations are obtained by the calculation agent on the reference obligation for purposes of cash settlement in a credit event. ISDA 2003 Term: Dealer. This could be the clearing organization (CCP, DCO) to which the trade should be cleared, as applicable for cash-settled swaptions." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationSource> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationSource> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/AncillaryEntity> ;
