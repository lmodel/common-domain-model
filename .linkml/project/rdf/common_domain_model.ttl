<https://w3id.org/lmodel/common-domain-model/fixingOffsetReason> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#BusinessDayOffset.fixingOffsetReason"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/fixingOffsetReason"^^xsd:anyURI ;
    linkml:description "Fixing Offset Reason" ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/BusinessDayOffset> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/BusinessDayOffset> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fixingOffsetReason"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/floatingRateDefinition> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CalculationPeriod.floatingRateDefinition"^^xsd:anyURI ;
