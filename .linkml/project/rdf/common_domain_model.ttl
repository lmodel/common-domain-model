	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FallbackRateParameters> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/FallbackRateParameters> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/effectiveDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/fallbackRateParameters__floatingRateIndex> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_calculatedrate"^^xsd:anyURI ;
	skos:prefLabel "floatingRateIndex" ;
