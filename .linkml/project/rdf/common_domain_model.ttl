    skos:note "Rosetta func: ResolveObservation — Specifies the interface that should be used by implementors to resolve a single observation when provided many, applying the averaging method, if one is provided." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"ResolveObservation\",\"description\":\"Specifies the interface that should be used by implementors to resolve a single observation when provided many, applying the averaging method, if one is provided.\",\"inputs\":[{\"name\":\"identifiers\",\"type\":\"ObservationIdentifier\",\"cardinality\":\"1..*\"},{\"name\":\"averagingMethod\",\"type\":\"AveragingCalculationMethod\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"observation\",\"type\":\"Observation\",\"cardinality\":\"1..1\"},\"code_implementation\":true}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ObservationIdentifier"^^xsd:anyURI ;
    linkml:description "Defines the parameters needed to uniquely identify a piece of data among the population of all available market data." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ObservationIdentifier_informationSource>,
        <https://w3id.org/lmodel/common-domain-model/ObservationIdentifier_observable>,
        <https://w3id.org/lmodel/common-domain-model/determinationMethodology>,
        <https://w3id.org/lmodel/common-domain-model/observationDate>,
