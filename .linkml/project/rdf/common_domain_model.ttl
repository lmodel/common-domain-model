            linkml:description "The number of valuation dates must be positive." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/numberOfValuationDates> ] ] ;
