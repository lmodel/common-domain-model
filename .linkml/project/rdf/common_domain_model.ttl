	linkml:range <https://w3id.org/lmodel/common-domain-model/Price> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/offset> a linkml:SlotDefinition ;
	linkml:description "Specifies the number of days before (negative) or after (positive) the trigger event." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> , <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true .
