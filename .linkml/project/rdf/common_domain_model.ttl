            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Asset type must be ListedDerivative." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/assetType> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/optionType> ] ;
            linkml:description "Options must have a strike price." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/strike> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ListedDerivative"^^xsd:anyURI ;
