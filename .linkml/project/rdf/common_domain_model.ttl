	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/creditEvents__bankruptcy> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "bankruptcy" ;
	linkml:description "A credit event. The reference entity has been dissolved or has become insolvent. It also covers events that may be a precursor to insolvency such as instigation of bankruptcy or insolvency proceedings. Sovereign trades are not subject to Bankruptcy as 'technically' a Sovereign cannot become bankrupt. ISDA 2003 Term: Bankruptcy." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/bankruptcy"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__creditEventNotice> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "creditEventNotice" ;
	linkml:description "A specified condition to settlement. An irrevocable written or verbal notice that describes a credit event that has occurred. The notice is sent from the notifying party (either the buyer or the seller) to the counterparty. It provides information relevant to determining that a credit event has occurred. This is typically accompanied by Publicly Available Information. ISDA 2003 Term: Credit Event Notice." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CreditEventNotice> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/creditEventNotice"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__defaultRequirement> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "defaultRequirement" ;
	linkml:description "In relation to certain credit events, serves as a threshold for Obligation Acceleration, Obligation Default, Repudiation/Moratorium and Restructuring. Market standard is USD 10,000,000 (JPY 1,000,000,000 for all Japanese Yen trades). This is applied on an aggregate or total basis across all Obligations of the Reference Entity. Used to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Default Requirement." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/defaultRequirement"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__distressedRatingsDowngrade> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "distressedRatingsDowngrade" ;
	linkml:description "A credit event. Results from the fact that the rating of the reference obligation is down-graded to a distressed rating level. From a usage standpoint, this credit event is typically not applicable in case of RMBS trades." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/distressedRatingsDowngrade"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__failureToPay> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "failureToPay" ;
	linkml:description "A credit event. This credit event triggers, after the expiration of any applicable grace period, if the reference entity fails to make due payments in an aggregate amount of not less than the payment requirement on one or more obligations (e.g. a missed coupon payment). ISDA 2003 Term: Failure to Pay." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FailureToPay> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/failureToPay"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__failureToPayInterest> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "failureToPayInterest" ;
	linkml:description "A credit event. Corresponds to the failure by the Reference Entity to pay an expected interest amount or the payment of an actual interest amount that is less than the expected interest amount. ISDA 2003 Term: Failure to Pay Interest." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/failureToPayInterest"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__failureToPayPrincipal> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "failureToPayPrincipal" ;
	linkml:description "A credit event. Corresponds to the failure by the Reference Entity to pay an expected principal amount or the payment of an actual principal amount that is less than the expected principal amount. ISDA 2003 Term: Failure to Pay Principal." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/failureToPayPrincipal"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__governmentalIntervention> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "governmentalIntervention" ;
	linkml:description "A credit event. A governmental intervention is an event resulting from an action by a governmental authority that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2014 Term: Governmental Intervention." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/governmentalIntervention"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__impliedWritedown> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "impliedWritedown" ;
	linkml:description "A credit event. Results from the fact that losses occur to the underlying instruments that do not result in reductions of the outstanding principal of the reference obligation." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/impliedWritedown"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__maturityExtension> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "maturityExtension" ;
	linkml:description "A credit event. Results from the fact that the underlier fails to make principal payments as expected." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/maturityExtension"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__obligationAcceleration> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "obligationAcceleration" ;
	linkml:description "A credit event. One or more of the obligations have been declared due and payable before they would otherwise have been due and payable as a result of, or on the basis of, the occurrence of a default, event of default or other similar condition or event other than failure to pay (preferred by the market over Obligation Default, because more definitive and encompasses the definition of Obligation Default - this is more favorable to the Seller). Subject to the default requirement amount. ISDA 2003 Term: Obligation Acceleration." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/obligationAcceleration"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__obligationDefault> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "obligationDefault" ;
	linkml:description "A credit event. One or more of the obligations have become capable of being declared due and payable before they would otherwise have been due and payable as a result of, or on the basis of, the occurrence of a default, event of default or other similar condition or event other than failure to pay. ISDA 2003 Term: Obligation Default." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/obligationDefault"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__repudiationMoratorium> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "repudiationMoratorium" ;
	linkml:description "A credit event. The reference entity, or a governmental authority, either refuses to recognise or challenges the validity of one or more obligations of the reference entity, or imposes a moratorium thereby postponing payments on one or more of the obligations of the reference entity. Subject to the default requirement amount. ISDA 2003 Term: Repudiation/Moratorium." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/repudiationMoratorium"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__restructuring> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "restructuring" ;
	linkml:description "A credit event. A restructuring is an event that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2003 Term: Restructuring." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Restructuring> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/restructuring"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEvents__writedown> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "writedown" ;
	linkml:description "A credit event. Results from the fact that the underlier writes down its outstanding principal amount." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/writedown"^^xsd:anyURI .
