    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: NameMustExist — if name exists then value exists",
        "Rosetta condition: ValueMustExist — if value exists then name exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ] ;
            linkml:description "If we have a value then we must also have a name." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/name> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/name> ] ;
            linkml:description "If we have a name then we must also have a value." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CSAMinimumTransferAmountVariableSet"^^xsd:anyURI ;
    linkml:description "Defines a combination of Rating Agency, Rating Value, amount and Currency code." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CSAMinimumTransferAmountVariableSet_amount>,
        <https://w3id.org/lmodel/common-domain-model/CSAMinimumTransferAmountVariableSet_name>,
        <https://w3id.org/lmodel/common-domain-model/CSAMinimumTransferAmountVariableSet_value>,
        <https://w3id.org/lmodel/common-domain-model/amountIsInfinity> .

<https://w3id.org/lmodel/common-domain-model/CollateralRounding> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_Japanese_2016"^^xsd:anyURI,
        "isda:CSA_IM_NewYork_2016"^^xsd:anyURI,
        "isda:CSD_IM_English_2016"^^xsd:anyURI ;
    skos:closeMatch "fpml_5_10:CollateralRounding"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(d)(vi)( C )\" name \"Rounding\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(c)(vi)( C )\" name \"Rounding\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(c)(vi)( C )\" name \"Rounding\"" ;
    skos:exactMatch "common_domain_model:CollateralRounding"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta func: DeliveryAmount",
        "Rosetta func: ReturnAmount" ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"ReturnAmount\",\"inputs\":[{\"name\":\"postedCreditSupportItems\",\"type\":\"PostedCreditSupportItem\",\"cardinality\":\"0..*\"},{\"name\":\"priorDeliveryAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"priorReturnAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"disputedTransferredPostedCreditSupportAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"marginAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"threshold\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"marginApproach\",\"type\":\"MarginApproachEnum\",\"cardinality\":\"1..1\"},{\"name\":\"marginAmountIA\",\"type\":\"Money\",\"cardinality\":\"0..1\"},{\"name\":\"minimumTransferAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"rounding\",\"type\":\"CollateralRounding\",\"cardinality\":\"1..1\"},{\"name\":\"disputedReturnAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"baseCurrency\",\"type\":\"string\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"Money\",\"cardinality\":\"1..1\"}},{\"name\":\"DeliveryAmount\",\"inputs\":[{\"name\":\"postedCreditSupportItems\",\"type\":\"PostedCreditSupportItem\",\"cardinality\":\"0..*\"},{\"name\":\"priorDeliveryAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"priorReturnAmountAdjustment\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"disputedTransferredPostedCreditSupportAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"marginAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"threshold\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"marginApproach\",\"type\":\"MarginApproachEnum\",\"cardinality\":\"1..1\"},{\"name\":\"marginAmountIA\",\"type\":\"Money\",\"cardinality\":\"0..1\"},{\"name\":\"minimumTransferAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"rounding\",\"type\":\"CollateralRounding\",\"cardinality\":\"1..1\"},{\"name\":\"disputedDeliveryAmount\",\"type\":\"Money\",\"cardinality\":\"1..1\"},{\"name\":\"baseCurrency\",\"type\":\"string\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"Money\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CollateralRounding"^^xsd:anyURI ;
    linkml:description "A class to specify the rounding methodology applicable to the Delivery Amount and the Return Amount." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CollateralRounding_currency>,
        <https://w3id.org/lmodel/common-domain-model/deliveryAmount>,
        <https://w3id.org/lmodel/common-domain-model/deliveryDirection>,
        <https://w3id.org/lmodel/common-domain-model/other>,
        <https://w3id.org/lmodel/common-domain-model/returnAmount>,
        <https://w3id.org/lmodel/common-domain-model/returnDirection> .

