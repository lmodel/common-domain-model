    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_SecurityLendingInvoice\",\"description\":\"Defines the process of calculating and creating a Security Lending Invoice.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"BillingInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"invoice\",\"type\":\"SecurityLendingInvoice\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SecurityLendingInvoice"^^xsd:anyURI ;
    linkml:description "Specifies the information required for inclusion in a securities lending billing invoice." ;
