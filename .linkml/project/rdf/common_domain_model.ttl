<https://w3id.org/lmodel/common-domain-model/floatingRateMultiplier> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/floatingRateMultiplier"^^xsd:anyURI ;
    linkml:description "A rate multiplier to apply to the floating rate. The multiplier can be a positive or negative decimal. This element should only be included if the multiplier is not equal to 1 (one)." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition> ;
