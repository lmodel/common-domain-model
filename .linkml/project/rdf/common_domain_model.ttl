    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/presentValuePrincipalAmount"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/priceType> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/priceType"^^xsd:anyURI ;
