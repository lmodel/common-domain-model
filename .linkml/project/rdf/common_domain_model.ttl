    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/resetDate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/returnAmount> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CollateralRounding.returnAmount"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/returnAmount"^^xsd:anyURI ;
