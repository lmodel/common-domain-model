    skos:note "Rosetta condition: Alternative — if alternativeToInterestAmount = AlternativeToInterestAmountEnum -> Other then alternativeProvision exists",
        "Rosetta condition: Alternative2 — if alternativeToInterestAmount <> AlternativeToInterestAmountEnum -> Other then alternativeProvision is absent" ;
