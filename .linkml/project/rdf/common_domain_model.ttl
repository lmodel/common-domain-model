<https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedOrRelativeDate> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:AdjustableOrAdjustedOrRelativeDate"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AdjustableOrAdjustedOrRelativeDate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdjustedDate — adjustedDate exists or relativeDate exists or unadjustedDate exists or (unadjustedDate exists and dateAdjustments exists and adjustedDate is absent)",
        "Rosetta func: AdjustableOrAdjustedOrRelativeDateResolution — Prioritization of unadjustedDate over adjustedDate.",
        "Rosetta func: ConvertToAdjustableOrAdjustedOrRelativeDate — Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrAdjustedOrRelativeDate",
        "Rosetta func: ConvertToAdjustableOrRelativeDate — Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrRelativeDate" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "This data rule extends the data rule AdjustableOrAdjustedDate_adjustedDate by specifying logic applicable to the relative date." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustedDate>,
                                <https://w3id.org/lmodel/common-domain-model/dateAdjustments>,
                                <https://w3id.org/lmodel/common-domain-model/unadjustedDate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustedDate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/relativeDate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unadjustedDate> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"ConvertToAdjustableOrRelativeDate\",\"description\":\"Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrRelativeDate\",\"inputs\":[{\"name\":\"adjustableOrAdjustedOrRelativeDate\",\"type\":\"AdjustableOrAdjustedOrRelativeDate\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"adjustableOrRelativeDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"0..1\"}},{\"name\":\"ConvertToAdjustableOrAdjustedOrRelativeDate\",\"description\":\"Utility function to convert from AdjustableOrAdjustedOrRelativeDate to AdjustableOrAdjustedOrRelativeDate\",\"inputs\":[{\"name\":\"adjustableOrRelativeDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"adjustableOrAdjustedOrRelativeDate\",\"type\":\"AdjustableOrAdjustedOrRelativeDate\",\"cardinality\":\"0..1\"}},{\"name\":\"AdjustableOrAdjustedOrRelativeDateResolution\",\"description\":\"Prioritization of unadjustedDate over adjustedDate.\",\"inputs\":[{\"name\":\"adjustableDate\",\"type\":\"AdjustableOrAdjustedOrRelativeDate\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"0..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedOrRelativeDate"^^xsd:anyURI ;
    linkml:description "This Rosetta class specifies the date as either an unadjusted, adjusted or relative date. It supplements the features of the AdjustableOrAdjustedDate to support the credit default swap option premium, which uses the relative date construct." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedOrRelativeDate_unadjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/dateAdjustments>,
        <https://w3id.org/lmodel/common-domain-model/relativeDate> .

