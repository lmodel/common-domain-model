    linkml:range <https://w3id.org/lmodel/common-domain-model/NotRatedByEnum> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notRatedBy"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/notSovereignLender> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/notSovereignLender"^^xsd:anyURI ;
    linkml:description "An obligation and deliverable obligation characteristic. Any obligation that is not primarily (majority) owed to a Sovereign or Supranational Organisation. ISDA 2003 Term: Not Sovereign Lender." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliverableObligations>,
        <https://w3id.org/lmodel/common-domain-model/Obligations> ;
