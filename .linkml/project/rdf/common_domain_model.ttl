	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "informationSource" ;
	linkml:description "The information source where a published or displayed market rate will be obtained, e.g. Telerate Page 3750." ;
