	linkml:range <https://w3id.org/lmodel/common-domain-model/NonLegalEntity> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/nonLegalEntity__identifier> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
	skos:prefLabel "identifier" ;
	linkml:description "Specifies the unique identifier value for a non-legal entity such as a sleeve, or sub account, that is a party to the agreement and has a relationship with a legal entity defined on the agreement." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NonLegalEntity> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NonLegalEntity> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/identifier"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/nonLegalEntity__identifierType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
	skos:prefLabel "identifierType" ;
	linkml:description "Specifies the Identifier type for a non-Legal entity to the agreement, for example the use of an alert code to uniquely identify a non-Legal entity." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NonLegalEntity> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NonLegalEntity> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/identifierType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/nonReliance> a linkml:SlotDefinition ;
	linkml:description "If true, then non reliance is applicable." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/nonStandardisedTerms> a linkml:SlotDefinition ;
	linkml:description "Specifies, when boolean value is True, that additional economic terms exist that have not been included in the product representation." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/nonTransferableProduct__economicTerms> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "economicTerms" ;
	linkml:description "The price forming features, including payouts and provisions." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/EconomicTerms> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/economicTerms"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/nonTransferableProduct__identifier> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "identifier" ;
	linkml:description "Comprises a identifier and a source to uniquely identify the nonTransferableProduct." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ProductIdentifier> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/identifier"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/nonTransferableProduct__taxonomy> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "taxonomy" ;
	linkml:description "Specifies the product taxonomy, which is composed of a taxonomy value and a taxonomy source." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ProductTaxonomy> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/taxonomy"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/nonstandardSettlementRate> a linkml:SlotDefinition ;
	linkml:description "Indicates that a non-standard rate source will be used for the fixing." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FxInformationSource> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/notBearer> a linkml:SlotDefinition ;
	linkml:description "A deliverable obligation characteristic. Any obligation that is not a bearer instrument. This applies to Bonds only and is meant to avoid tax, fraud and security/delivery provisions that can potentially be associated with Bearer Bonds. ISDA 2003 Term: Not Bearer." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/notContingent> a linkml:SlotDefinition ;
	linkml:description "A deliverable obligation characteristic. In essence Not Contingent means the repayment of principal cannot be dependant on a formula/index, i.e. to prevent the risk of being delivered an instrument that may never pay any element of principal, and to ensure that the obligation is interest bearing (on a regular schedule). ISDA 2003 Term: Not Contingent." , "OTE: Only allowed as an obligation characteristic under ISDA Credit 1999. In essence Not Contingent means the repayment of principal cannot be dependent on a formula/index, i.e. to prevent the risk of being delivered an instrument that may never pay any element of principal, and to ensure that the obligation is interest bearing (on a regular schedule). ISDA 2003 Term: Not Contingent." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/notDomesticCurrency> a linkml:SlotDefinition ;
	linkml:description "An obligation and deliverable obligation characteristic. Any obligation that is payable in any currency other than the domestic currency. Domestic currency is either the currency so specified or, if no currency is specified, the currency of (a) the reference entity, if the reference entity is a sovereign, or (b) the jurisdiction in which the relevant reference entity is organised, if the reference entity is not a sovereign. ISDA 2003 Term: Not Domestic Currency." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/notDomesticCurrency__applicable> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit"^^xsd:anyURI ;
	skos:prefLabel "applicable" ;
	linkml:description "Indicates whether the Not Domestic Currency provision is applicable." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/applicable"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/notDomesticCurrency__currency> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit"^^xsd:anyURI ;
	skos:prefLabel "currency" ;
	linkml:annotations _:c14n1963 ;
	linkml:description "An explicit specification of the domestic currency. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/currency"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/notDomesticIssuance> a linkml:SlotDefinition ;
	linkml:description "An obligation and deliverable obligation characteristic. Any obligation other than an obligation that was intended to be offered for sale primarily in the domestic market of the relevant Reference Entity. This specifies that the obligation must be an internationally recognised bond. ISDA 2003 Term: Not Domestic Issuance." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/notDomesticLaw> a linkml:SlotDefinition ;
	linkml:description "An obligation and deliverable obligation characteristic. If the reference entity is a Sovereign, this means any obligation that is not subject to the laws of the reference entity. If the reference entity is not a sovereign, this means any obligation that is not subject to the laws of the jurisdiction of the reference entity. ISDA 2003 Term: Not Domestic Law." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/notRatedBy> a linkml:SlotDefinition ;
	linkml:description "Defines where conditions apply if no Rating where ratings may not exist." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NotRatedByEnum> .
<https://w3id.org/lmodel/common-domain-model/notSovereignLender> a linkml:SlotDefinition ;
	linkml:description "An obligation and deliverable obligation characteristic. Any obligation that is not primarily (majority) owed to a Sovereign or Supranational Organisation. ISDA 2003 Term: Not Sovereign Lender." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/notSubordinated> a linkml:SlotDefinition ;
	linkml:description "An obligation and deliverable obligation characteristic. An obligation that ranks at least equal with the most senior Reference Obligation in priority of payment or, if no Reference Obligation is specified in the related Confirmation, the obligations of the Reference Entity that are senior. ISDA 2003 Term: Not Subordinated." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/notation> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2068 ;
	linkml:description "Specifies The credit rating notation. As it varies among credit rating agencies, FpML doesn't specify a default scheme." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/noticeContactInformation__additionalInformation> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
	skos:prefLabel "additionalInformation" ;
	linkml:description "Additional information on the recipient." ;
