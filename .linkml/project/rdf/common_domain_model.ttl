    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CalculationFrequency.offsetDays"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/offsetDays"^^xsd:anyURI ;
