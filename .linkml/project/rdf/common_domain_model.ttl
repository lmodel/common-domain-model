<https://w3id.org/lmodel/common-domain-model/CollateralInterestNotification> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:closeMatch "fpml_5_10:CollateralInterestNotification"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CollateralInterestNotification"^^xsd:anyURI ;
