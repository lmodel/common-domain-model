    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/precision"^^xsd:anyURI ;
    linkml:description "Specifies the rounding precision in terms of a number of decimal places when the number is evaluated in decimal form (not percentage), e.g. 0.09876543 rounded to the nearest 5 decimal places is  0.0987654." ;
