<https://w3id.org/lmodel/common-domain-model/MeasureSchedule> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_math> ;
    skos:exactMatch "common_domain_model:MeasureSchedule"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    skos:note "Rosetta condition: ValueExists — value exists or datedValue exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "A schedule may be specified as a single value or as a set of date-value pairs. Both attributes may be specified, in which case the single amount number is the initial value." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/datedValue> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MeasureSchedule"^^xsd:anyURI ;
    linkml:description "A set of measures, all in the same unit, where the values are defined through a schedule of steps. The initial value may be defined either as part of the steps, or using the single amount attribute." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/MeasureBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/datedValue>,
        <https://w3id.org/lmodel/common-domain-model/unit>,
        <https://w3id.org/lmodel/common-domain-model/value> .

