<https://w3id.org/lmodel/common-domain-model/CalculationAgentAdjustment> linkml:description "Calculation Agent Adjustment." .

<https://w3id.org/lmodel/common-domain-model/CalculationAgentElection> linkml:description "The Calculation Agent determines the composition of dividends (subject to conditions)." .

<https://w3id.org/lmodel/common-domain-model/CalculationAgentFallback> linkml:description "Specifies the party responsible for deciding the fallback rate." .

<https://w3id.org/lmodel/common-domain-model/CalculationAgentIndependent> linkml:description "Specifies the party responsible for performing calculation agent duties as defined in the applicable product definition." .

<https://w3id.org/lmodel/common-domain-model/CalculationAgentMandatoryEarlyTermination> linkml:description "Specifies the party responsible for performing calculation agent duties associated with an mandatory early termination." .

<https://w3id.org/lmodel/common-domain-model/CalculationAgentOptionalEarlyTermination> linkml:description "Specifies the party responsible for performing calculation agent duties associated with an optional early termination." .

<https://w3id.org/lmodel/common-domain-model/CalculationShiftMethodEnum> skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_calculatedrate"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculationShiftMethodEnum"^^xsd:anyURI ;
    linkml:description " the specific calculation method, e.g. lookback. This enumeration is used to represent the definitions of modular calculated rates as described in the 2021 ISDA Definitions, section 7." ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/Lookback>,
