    linkml:range <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/calculationPeriodDates"^^xsd:anyURI ;
    linkml:usage_slot_name "calculationPeriodDates" .

