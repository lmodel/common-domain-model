    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdditionalObligations"^^xsd:anyURI ;
    linkml:description "The election of party specific additional obligations applicable to the agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AdditionalObligations_party>,
        <https://w3id.org/lmodel/common-domain-model/additionalObligations> .

<https://w3id.org/lmodel/common-domain-model/AdjustableOrRelativeDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:AdjustableOrRelativeDates"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AdjustableOrRelativeDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdjustableOrRelativeDatesChoice — required choice adjustableDates, relativeDates" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustableDates> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/relativeDates> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdjustableOrRelativeDates"^^xsd:anyURI ;
    linkml:description "A class giving the choice between defining a series of dates as an explicit list of dates together with applicable adjustments or as relative to some other series of (anchor) dates." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/adjustableDates>,
        <https://w3id.org/lmodel/common-domain-model/relativeDates> .

<https://w3id.org/lmodel/common-domain-model/AdjustedRelativeDateOffset> a linkml:ClassDefinition ;
