	skos:prefLabel "gracePeriodExtension" ;
	linkml:description "If this element is specified, indicates whether or not a grace period extension is applicable. ISDA 2003 Term: Grace Period Extension Applicable." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FailureToPay> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
