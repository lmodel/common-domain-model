        <https://w3id.org/lmodel/common-domain-model/automaticEarlyTerminationRequiredDueToSystemOfLaw>,
        <https://w3id.org/lmodel/common-domain-model/automaticEarlyTerminationSpecifiedSeparatelyForEachPrinciple>,
        <https://w3id.org/lmodel/common-domain-model/automation>,
        <https://w3id.org/lmodel/common-domain-model/existingLoans> .

<https://w3id.org/lmodel/common-domain-model/EvergreenProvision> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:EvergreenProvision"^^xsd:anyURI ;
