<https://w3id.org/lmodel/common-domain-model/Increase> linkml:description "A transfer associated with an increase lifecycle event.",
        "The intent is to Increase the quantity of the position.",
        "The intent is to Increase the quantity or notional of the contract.",
        "When the quantity should go up by the specified amount." .

<https://w3id.org/lmodel/common-domain-model/IndependentAmount> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:exactMatch "common_domain_model:IndependentAmount"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/IndependentAmount"^^xsd:anyURI ;
    linkml:description "A class specifying the Independent Amount as the combination of a payer/receiver, a payment amount, a payment date and an associated payment calculation rule." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/PartyReferencePayerReceiver> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/payerAccountReference>,
        <https://w3id.org/lmodel/common-domain-model/payerPartyReference>,
        <https://w3id.org/lmodel/common-domain-model/paymentDetail>,
        <https://w3id.org/lmodel/common-domain-model/receiverAccountReference>,
        <https://w3id.org/lmodel/common-domain-model/receiverPartyReference> .

<https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_compare> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:prefLabel "compare" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/compare"^^xsd:anyURI ;
    linkml:description "Specifies how multiple credit ratings are compared when determining the applicable Independent Amount, and whether that measure is highest, lowest, or a comparison of either." ;
    linkml:domain <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings> ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings> ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/compare> ;
    linkml:is_usage_slot true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/IndependentAmountCompareEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/compare"^^xsd:anyURI ;
    linkml:usage_slot_name "compare" .

