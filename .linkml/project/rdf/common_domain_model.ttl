	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Payout> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/SettlementPayout"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/pending> a linkml:SlotDefinition ;
	linkml:description "Credit limit utilisation attributable to pending unexecuted orders." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CreditLimitUtilisationPosition> .
<https://w3id.org/lmodel/common-domain-model/perUnitOf> a linkml:SlotDefinition ;
	linkml:description "Provides an attribute to define the unit of the thing being priced. For example, {amount, unitOfAmount, PerUnitOfAmount} = [10, EUR, Shares] = (10.00 EUR/SHARE) * (300,000 SHARES) = EUR 3,000,000.00 (Shares cancel out in the calculation)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/UnitType> ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/percentageLimit> a linkml:SlotDefinition ;
	linkml:description "Specifies the perecentage of collateral limit represented as a decimal number - example 25% is 0.25." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NumberRange> ;
	linkml:value_presence "PRESENT" .
