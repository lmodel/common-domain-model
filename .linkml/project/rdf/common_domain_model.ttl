	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/effectiveDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/calculationPeriodDates__firstCompoundingPeriodEndDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "firstCompoundingPeriodEndDate" ;
	linkml:description "The end date of the initial compounding period when compounding is applicable. It must only be specified when the compoundingMethod element is present and not equal to a value of None. This date may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/firstCompoundingPeriodEndDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/calculationPeriodDates__firstPeriodStartDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "firstPeriodStartDate" ;
	linkml:description "The start date of the calculation period. FpML specifies that for interest rate swaps this date must only be specified if it is not equal to the effective date. It is always specified in the case of equity swaps and credit default swaps with periodic payments. This date may be subject to adjustment in accordance with a business day convention." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableOrRelativeDate> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/firstPeriodStartDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/calculationPeriodDates__firstRegularPeriodStartDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "firstRegularPeriodStartDate" ;
	linkml:description "The start date of the regular part of the calculation period schedule. It must only be specified if there is an initial stub calculation period. This day may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
