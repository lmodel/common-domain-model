	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
	skos:prefLabel "sizeInBytes" ;
	linkml:description "Indicates the size of the resource in bytes. It could be used by the end user to estimate the download time and storage needs." ;
