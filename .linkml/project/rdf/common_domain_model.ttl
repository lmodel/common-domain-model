	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/businessCenter"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEventNotice__notifyingParty> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "notifyingParty" ;
	linkml:description "The notifying party is the party that notifies the other party when a credit event has occurred by means of a credit event notice. If more than one party is referenced as being the notifying party then either party may notify the other of a credit event occurring. ISDA 2003 Term: Notifying Party." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEventNotice> ;
	linkml:maximum_cardinality 2 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEventNotice> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notifyingParty"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditEventNotice__publiclyAvailableInformation> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "publiclyAvailableInformation" ;
	linkml:description "A specified condition to settlement. Publicly available information means information that reasonably confirms any of the facts relevant to determining that a credit event or potential repudiation/moratorium, as applicable, has occurred. The ISDA defined list (2003) is the market standard and is considered comprehensive, and a minimum of two differing public sources must have published the relevant information, to declare a Credit Event. ISDA 2003 Term: Notice of Publicly Available Information Applicable." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEventNotice> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEventNotice> ;
