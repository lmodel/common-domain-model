        <https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule>,
        <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
