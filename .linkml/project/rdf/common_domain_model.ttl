	linkml:owner <https://w3id.org/lmodel/common-domain-model/FallbackRateParameters> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FloatingRateCalculationParameters> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/calculationParameters"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/fallbackRateParameters__effectiveDate> a linkml:SlotDefinition ;
