	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/sourcePageHeading"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/informationSource__sourceProvider> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "sourceProvider" ;
