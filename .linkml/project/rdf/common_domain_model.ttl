    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"AssetIdentifierByType\",\"description\":\"Returns all the Asset Identifiers of a certain Identifier Type.\",\"inputs\":[{\"name\":\"identifiers\",\"type\":\"AssetIdentifier\",\"cardinality\":\"0..*\"},{\"name\":\"idType\",\"type\":\"AssetIdTypeEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredIdentifier\",\"type\":\"AssetIdentifier\",\"cardinality\":\"0..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AssetIdentifier"^^xsd:anyURI ;
    linkml:description "The unique identifier for an Asset, specified using an Asset Identifier Type enumerator." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AssetIdentifier_identifier>,
        <https://w3id.org/lmodel/common-domain-model/identifierType> .

