	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Trade> , <https://w3id.org/lmodel/common-domain-model/TradeState> .
<https://w3id.org/lmodel/common-domain-model/tradeState> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2793 , _:c14n2794 ;
	linkml:description "The trade for the individual billing record." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TradeState> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/tradeState__observationHistory> a linkml:SlotDefinition ;
