<https://w3id.org/lmodel/common-domain-model/singlePartyOption> a linkml:SlotDefinition ;
	linkml:description "If evergreen termination is not available to both parties then this component specifies the buyer and seller of the option." , "If optional early termination is not available to both parties then this component specifies the buyer and seller of the option. In FpML, this attribute is of type SinglePsrtyOption, which actually consists of the BuyerSeller.model." , "If the ability to extend the contract is not available to both parties then this component specifies the buyer and seller of the option." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BuyerSeller> , <https://w3id.org/lmodel/common-domain-model/PartyRole> .
<https://w3id.org/lmodel/common-domain-model/singlePostingParty> a linkml:SlotDefinition ;
	linkml:description "Where only a single party is explicitly designated to post collateral, the party which is specified as the sole poster of collateral." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SinglePostingParty> .
<https://w3id.org/lmodel/common-domain-model/singlePostingParty__other> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
