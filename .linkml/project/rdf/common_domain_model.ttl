	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "deliveryDateRollConvention" ;
	linkml:description "Specifies, for a Commodity Transaction that references a listed future, the day on which the specified future will roll to the next nearby month prior to the expiration of the referenced future. If the future will not roll at all - i.e. the price will be taken from the expiring contract, 0 days should be specified here. If the future will roll to the next nearby on the last trading day - i.e. the price will be taken from the next nearby on the last trading day, then 1 business day should be specified and so on." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/deliveryDateRollConvention"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliveryDateParameters__deliveryNearby> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "deliveryNearby" ;
	linkml:description "Provides a container for the parametric representation that specifies which nearby contract date would be used as a refrence for a price." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/deliveryNearby"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliveryDateReference> a linkml:SlotDefinition ;
	linkml:description "Specifies the parameters for identifying the relevant contract date when the commodity reference price is a futures contract." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> .
<https://w3id.org/lmodel/common-domain-model/deliveryDateRollConvention> a linkml:SlotDefinition ;
	linkml:description "Specifies, for a Commodity Transaction that references a delivery date for a listed future, the day on which the specified future will roll to the next nearby month prior to the expiration of the referenced future. If the future will not roll at all - i.e. the price will be taken from the expiring contract, 0 should be specified here. If the future will roll to the next nearby on the last trading day - i.e. the price will be taken from the next nearby on the last trading day, then 1 should be specified and so on." , "Specifies, for a Commodity Transaction that references a listed future, the day on which the specified future will roll to the next nearby month prior to the expiration of the referenced future. If the future will not roll at all - i.e. the price will be taken from the expiring contract, 0 days should be specified here. If the future will roll to the next nearby on the last trading day - i.e. the price will be taken from the next nearby on the last trading day, then 1 business day should be specified and so on." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> .
<https://w3id.org/lmodel/common-domain-model/deliveryDirection> a linkml:SlotDefinition ;
	linkml:description "The rounding rule applicable to the Delivery Amount (which can be (i) up to nearest; (ii) down to nearest)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RoundingModeEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/deliveryInLieuRight> a linkml:SlotDefinition ;
	linkml:description "Delivery In Lieu rights." , "The specification of whether Delivery In Lieu language is applicable to the agreement (true) or not (false)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/deliveryMethod> a linkml:SlotDefinition ;
	linkml:description "Specifies a delivery method for the security transaction." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeliveryMethodEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/deliveryNearby> a linkml:SlotDefinition ;
	linkml:description "Provides a container for the parametric representation that specifies which nearby contract date would be used as a refrence for a price." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/deliveryOfCommitments> a linkml:SlotDefinition ;
	linkml:description "An obligation and deliverable obligation characteristic. Defined in the ISDA published Standard Terms Supplement for use with CDS Transactions on Leveraged Loans. ISDA 2003 Term: Delivery of Commitments." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/deliveryPeriod> a linkml:SlotDefinition ;
	linkml:description "Period and time profile over which the delivery takes place." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CalculationScheduleDeliveryPeriods> .
<https://w3id.org/lmodel/common-domain-model/deliveryTerm> a linkml:SlotDefinition ;
	linkml:description "Also called contract month or delivery month. However, it's not always a month. It is usually expressed using a code, e.g. Z23 would be the Dec 2023 contract, (Z = December). For crude oil, the corresponding contract might be called CLZ23. Optional as this can be uniquely identified in the identifier." , "Also called contract month or delivery month. However, it's not always a month. It is usually expressed using a code, e.g. Z23 would be the Dec 2023 contract, (Z = December). For crude oil, the corresponding contract might be called CLZ23." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/delta> a linkml:SlotDefinition ;
	linkml:description "The ratio of the change in the price of a derivative transaction to the change in the price of the underlying. This field is applicable only to options and swaptions." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> .
<https://w3id.org/lmodel/common-domain-model/demandsAndNotices> a linkml:SlotDefinition ;
	linkml:description "The optional specification of address where the demands, specifications and notices will be communicated to for each of the parties to the agreement." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DemandsAndNotices> .
<https://w3id.org/lmodel/common-domain-model/demandsAndNotices__deemedEffectiveNextLBD> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
	skos:prefLabel "deemedEffectiveNextLBD" ;
	linkml:description "Specifies if notice shall be deemed to be effective at the time such notice is actually received unless such notice is received on a day which is not a Local Business Day or after the Notification Time on any Local Business Day in which event such notice shall be deemed to be effective on the next succeeding Local Business Day. If deemed effective,'True'. If not deemed effective, or not stated,'False'." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DemandsAndNotices> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DemandsAndNotices> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/deemedEffectiveNextLBD"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/demandsAndNotices__partyElection> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
	skos:prefLabel "partyElection" ;
	linkml:description "The parties' contact information election." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DemandsAndNotices> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:maximum_cardinality 2 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DemandsAndNotices> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NoticeInformationElection> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/partyElection"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/denominatedCurrency> a linkml:SlotDefinition ;
	linkml:description "The underlying asset denominated currency." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CurrencyCodeEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/depositaryReceipt> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DepositaryReceiptTypeEnum> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/deprecatedDate> a linkml:SlotDefinition ;
	linkml:description "When the code ceased to be valid for new uses" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> .
<https://w3id.org/lmodel/common-domain-model/deprecationReason> a linkml:SlotDefinition ;
	linkml:description "Deprecation and Code Descriptions" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/derivedQuantity> a linkml:SlotDefinition ;
	linkml:description "Specifies the derived quantity associated with the price. For instance when the price is an asset price expressed in a currency, the primary quantity is the asset's quantity while the derived quantity is the corresponding monetary amount in that currency. When the price is an exchange rate, both the primary quantity and the derived quantity are monetary amounts, in the 2 currencies of the exchange rate." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NonNegativeQuantitySchedule> .
<https://w3id.org/lmodel/common-domain-model/description> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/common_domain_model_keys"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/description"^^xsd:anyURI ;
	linkml:description "The CDM's description attribute; each class's slot_usage gives its meaning." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CodeListIdentification> , <https://w3id.org/lmodel/common-domain-model/CodeValue> , <https://w3id.org/lmodel/common-domain-model/Commodity> , <https://w3id.org/lmodel/common-domain-model/OtherIndex> , <https://w3id.org/lmodel/common-domain-model/TaxonomyClassification> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/OtherIndex> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/description"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/designatedMaturity> a linkml:SlotDefinition ;
	linkml:description "Allows a designed maturity to be specified for the fixing time." , "Allows a reason to be specified for using the alternative fixing offset." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/designatedMaturityApplicable> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/designatedPriority> a linkml:SlotDefinition ;
	linkml:annotations _:c14n878 ;
	linkml:description "Applies to Loan CDS, to indicate what lien level is appropriate for a deliverable obligation. Applies to European Loan CDS, to indicate the Ranking of the obligation. Example: a 2nd lien Loan CDS would imply that the deliverable obligations are 1st or 2nd lien loans." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/determinationMethod> a linkml:SlotDefinition ;
	linkml:description "Represents a more granular dimention of observation. Typically relevent for resolving a unique equity price, which can be expressed as trade-weighted or volume-weighted averages." , "Specifies the method according to which an amount or a date is determined." , "Specifies the method according to which the dividend is determined, e.g. the dividend currency." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeterminationMethodEnum> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/determinationMethodology> a linkml:SlotDefinition ;
	linkml:description "Specifies the method according to which an amount or a date is determined." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeterminationMethodology> .
<https://w3id.org/lmodel/common-domain-model/determinationMethodology__averagingMethod> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "averagingMethod" ;
	linkml:description "Specifies enumerations for the type of averaging calculation." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeterminationMethodology> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeterminationMethodology> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AveragingCalculationMethodEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/averagingMethod"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/determinationMethodology__determinationMethod> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
	skos:prefLabel "determinationMethod" ;
	linkml:description "Represents a more granular dimention of observation. Typically relevent for resolving a unique equity price, which can be expressed as trade-weighted or volume-weighted averages." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeterminationMethodology> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeterminationMethodology> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeterminationMethodEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/determinationMethod"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/determinationRole> a linkml:SlotDefinition ;
	linkml:description "Defines the enumerated values to specify the determination roles to the transaction. Such roles mostly address any determination that would be required when some Extraordinary Events would happen, for instance qualifying the effectiveness of such event, or when a calculation is required, etc. else any other kind of determination as need be. Yet for clarity, other kinds of determination may be covered by such roles, which are not necessarily restricted to the scope of Extarordinary Events, depending on particular product specifications e.g. for instance when Calculation Agent is mentioned as the Price Determination Method enumarated value, etc." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeterminationRoleEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/determinationRolesAndTerms__determinationRole> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
	skos:prefLabel "determinationRole" ;
	linkml:description "Defines the enumerated values to specify the determination roles to the transaction. Such roles mostly address any determination that would be required when some Extraordinary Events would happen, for instance qualifying the effectiveness of such event, or when a calculation is required, etc. else any other kind of determination as need be. Yet for clarity, other kinds of determination may be covered by such roles, which are not necessarily restricted to the scope of Extarordinary Events, depending on particular product specifications e.g. for instance when Calculation Agent is mentioned as the Price Determination Method enumarated value, etc." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeterminationRoleEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/determinationRole"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/determinationRolesAndTerms__disputingParty> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
	skos:prefLabel "disputingParty" ;
	linkml:description "Where the party who is not granted with the determination role at least has a right to dispute the determination given by the counterparty with such role. As an example, a given PartyA is the unique Counterparty with the Role of CalculationAgent, yet Party B could be Disputing Party in regard of such Role." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/disputingParty"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/determinationRolesAndTerms__fallbackLanguageBespokeTerms> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
	skos:prefLabel "fallbackLanguageBespokeTerms" ;
	linkml:description "Where parties may optionnaly describe any extra bespoke agreements about fallback procedure attached to a particular determination role. This fallback bespoke paragraph would typically address topics such as : delay for the Disputing Party to notify a disagreement when receiving a determination from the Calculation Agent ; Independent Third Party Dealers election terms e.g. number of Dealers to be jointly elected by the counterparties ; delay for joint election of Dealers by the counterparties ; further fallback election procedure in case of disagreement between parties to jointly elect all the Dealers e.g. typically each party designates 1 Dealer, each a Party Representant, which thus result in 2 Dealers in charge of joint election of 3 other Dealers who will be the final ones to provide the response, each a Final Dealer ; delay for joint election of the Final Dealers by the Party Representants ; fees repartition e.g. typically cost and fees incurred by the election of Dealers are equally shared by the parties ; etc." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Clause> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fallbackLanguageBespokeTerms"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/determinationRolesAndTerms__whoToDetermine> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
	skos:prefLabel "whoToDetermine" ;
	linkml:description "Designates which Counterparty to the transaction is granted with the particular role ; cardinality of this object is 2, in case parties are both having the same role e.g. jointly CalculationAgent, jointly Determining Party, etc." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
	linkml:maximum_cardinality 2 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/whoToDetermine"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/determinationTerms> a linkml:SlotDefinition ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms> ;
