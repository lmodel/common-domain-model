    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FloatingRateIndexFixingDetails"^^xsd:anyURI ;
    linkml:description "This type holds parameters defining the fixingt time and offset for a floating rate index." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexFixingDetails_fixingTime>,
        <https://w3id.org/lmodel/common-domain-model/fixingOffset> .

