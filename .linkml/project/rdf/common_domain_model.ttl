	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "lastRegularPeriodEndDate" ;
	linkml:description "The end date of the regular part of the calculation period schedule. It must only be specified if there is a final stub calculation period. This day may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
