<https://w3id.org/lmodel/common-domain-model/party1> a linkml:SlotDefinition ;
	linkml:description "First party facing the CCP if it is clearing for its own account." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Party> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/party2> a linkml:SlotDefinition ;
