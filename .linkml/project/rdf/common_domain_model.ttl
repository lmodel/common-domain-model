    linkml:usage_slot_name "settlementTerms" .

<https://w3id.org/lmodel/common-domain-model/PriceSource> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:PriceSource"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: PriceSourceHeading — if priceSourceHeading exists then priceSourceLocation exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/priceSourceHeading> ] ;
            linkml:description "Requires that if a priceSourceHeading is specified, then a priceSourceLocation must be speficified" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/priceSourceLocation> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PriceSource"^^xsd:anyURI ;
    linkml:description "Specifies a publication that provides the commodity price, including, where applicable, the details of where in the publication the price is published." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/pricePublisher>,
        <https://w3id.org/lmodel/common-domain-model/priceSourceHeading>,
        <https://w3id.org/lmodel/common-domain-model/priceSourceLocation>,
        <https://w3id.org/lmodel/common-domain-model/priceSourceTime> .

<https://w3id.org/lmodel/common-domain-model/Product> a linkml:ClassDefinition ;
