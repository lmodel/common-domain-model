<https://w3id.org/lmodel/common-domain-model/paymentDatesAdjustments> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/paymentDatesAdjustments"^^xsd:anyURI ;
    linkml:description "The definition of the business day convention and financial business centers used for adjusting the payment date if it would otherwise fall on a day that is not a business day in the specified business center." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessDayAdjustments> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentDatesAdjustments"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/paymentDatesReference> a linkml:SlotDefinition ;
