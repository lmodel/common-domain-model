	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/protectionTerms"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/creditDefaultPayout__transactedPrice> a linkml:SlotDefinition ;
