	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/lag"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/parentParty> a linkml:SlotDefinition ;
	linkml:description "Represents the identification of a parent child relationship between two entities in the Umbrella agreement, allowing non-legal entities to be linked to the appropriate legal entity and allowing funds, portfolio or managed accounts to be linked to their applicable Investment Manager or Agent within the agreement." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Party> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/parentSecurity> a linkml:SlotDefinition ;
	linkml:description "Defines the underlier for the Parent Company involved in Spin Off corporate action." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Security> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/parentSecurityPrice> a linkml:SlotDefinition ;
	linkml:description "The price observation that relates to underlier for the Parent Company." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Price> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/partialCashSettlement> a linkml:SlotDefinition ;
	linkml:description "Specifies whether either 'Partial Cash Settlement of Assignable Loans', 'Partial Cash Settlement of Consent Required Loans' or 'Partial Cash Settlement of Participations' is applicable. If this element is specified and Assignable Loan is a Deliverable Obligation Characteristic, any Assignable Loan that is deliverable, but where a non-receipt of Consent by the Physical Settlement Date has occurred, the Loan can be cash settled rather than physically delivered. If this element is specified and Consent Required Loan is a Deliverable Obligation Characteristic, any Consent Required Loan that is deliverable, but where a non-receipt of Consent by the Physical Settlement Date has occurred, the Loan can be cash settled rather than physically delivered. If this element is specified and Direct Loan Participation is a Deliverable Obligation Characteristic, any Participation that is deliverable, but where this participation has not been effected (has not come into effect) by the Physical Settlement Date, the participation can be cash settled rather than physically delivered." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/partialExercise> a linkml:SlotDefinition ;
	linkml:description "As defined in the 2000 ISDA Definitions, Section 12.3. Partial Exercise, the buyer of the option has the right to exercise all or less than all the notional amount of the underlying swap on the expiration date, but may not exercise less than the minimum notional amount, and if an integral multiple amount is specified, the notional amount exercised must be equal to, or be an integral multiple of, the integral multiple amount." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/partialExercise__integralMultipleAmount> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "integralMultipleAmount" ;
	linkml:description "A notional amount which restricts the amount of notional that can be exercised when partial exercise or multiple exercise is applicable. The integral multiple amount defines a lower limit of notional that can be exercised and also defines a unit multiple of notional that can be exercised, i.e. only integer multiples of this amount can be exercised." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/integralMultipleAmount"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/partialExercise__minimumNotionalAmount> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "minimumNotionalAmount" ;
	linkml:description "The minimum notional amount that can be exercised on a given exercise date. See multipleExercise." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/minimumNotionalAmount"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/partialExercise__minimumNumberOfOptions> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "minimumNumberOfOptions" ;
	linkml:description "The minimum number of options that can be exercised on a given exercise date." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/minimumNumberOfOptions"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/partialExercise__notionalReference> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "notionalReference" ;
	linkml:annotations _:c14n507 ;
	linkml:description "A pointer style reference to the associated notional schedule defined elsewhere in the document. This element has been made optional as part of its integration in the OptionBaseExtended, because not required for the options on securities." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notionalReference"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/parties> a linkml:SlotDefinition ;
	linkml:description "Defines all parties to that execution, including agents and brokers." ;
	linkml:minimum_cardinality 2 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Party> ;
