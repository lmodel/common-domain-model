<https://w3id.org/lmodel/common-domain-model/DividendPayoutRatio> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:DividendPayoutRatio"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: DividendPayoutRatioCash — if cashRatio exists then cashRatio >= 0 and totalRatio <= 1",
        "Rosetta condition: DividendPayoutRatioNonCash — if nonCashRatio exists then nonCashRatio >= 0 and totalRatio <= 1",
        "Rosetta condition: DividendPayoutRatioTotal — totalRatio >= 0 and totalRatio <= 1" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The dividend payout ratio should be comprised between 0 and 100%, meaning 0 and 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/totalRatio> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/cashRatio> ] ;
            linkml:description "The cash dividend payout ratio should be comprised between 0 and 100%, meaning 0 and 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/cashRatio> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nonCashRatio> ] ;
            linkml:description "The non cash dividend payout ratio should be comprised between 0 and 100%, meaning 0 and 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nonCashRatio> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/DividendPayoutRatio"^^xsd:anyURI ;
    linkml:description "A class describing the dividend payout ratio associated with an equity underlier. In certain cases the actual ratio is not known on trade inception, and only general conditions are then specified." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/DividendPayoutRatio_basketConstituent>,
        <https://w3id.org/lmodel/common-domain-model/cashRatio>,
        <https://w3id.org/lmodel/common-domain-model/nonCashRatio>,
        <https://w3id.org/lmodel/common-domain-model/totalRatio> .

