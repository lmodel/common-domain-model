<https://w3id.org/lmodel/common-domain-model/linearInterpolationElection> a linkml:SlotDefinition ;
	linkml:description "Per Part 1 Section 3, 'Floating Obligations', of the 2018 ISDA CDM Equity Confirmation. Para 3.3." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/InterpolationMethodEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/listId> a linkml:SlotDefinition ;
	linkml:description "The identifier for the list. In the case of a package transaction, this would be the package identifier. This attribute is mandatory to allow the list itself to be identified." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/listed> a linkml:SlotDefinition ;
	linkml:description "An obligation and deliverable obligation characteristic. Indicates whether or not the obligation is quoted, listed or ordinarily purchased and sold on an exchange. ISDA 2003 Term: Listed." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/listedDerivative__deliveryTerm> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "deliveryTerm" ;
	linkml:description "Also called contract month or delivery month. However, it's not always a month. It is usually expressed using a code, e.g. Z23 would be the Dec 2023 contract, (Z = December). For crude oil, the corresponding contract might be called CLZ23. Optional as this can be uniquely identified in the identifier." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ListedDerivative> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ListedDerivative> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/deliveryTerm"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/listedDerivative__optionType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "optionType" ;
	linkml:description "The type of option, ie Put or Call. Left empty if it is a Future." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ListedDerivative> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ListedDerivative> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PutCallEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/optionType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/listedDerivative__strike> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "strike" ;
	linkml:description "Specifies the strike of the option." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ListedDerivative> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ListedDerivative> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/strike"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/listingExchange__exchange> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
	skos:prefLabel "exchange" ;
	linkml:annotations _:c14n1297 ;
	linkml:description "Represents a filter based on the Primary Stock Exchange facilitating the listing of companies, exchange of Stocks, Exchange traded Derivatives, Bonds, and other Securities expressed in ISO standard 10383." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ListingExchange> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ListingExchange> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/exchange"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/listingSector__sector> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
	skos:prefLabel "sector" ;
	linkml:annotations _:c14n2149 ;
	linkml:description "Represents a filter based on an industry sector defined under a system for classifying industry types such as Global Industry Classification Standard (GICS) and North American Industry Classification System (NAICS)" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ListingSector> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ListingSector> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/sector"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/loadType> a linkml:SlotDefinition ;
	linkml:description "Identification of the delivery profile." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/LoadTypeEnum> .
<https://w3id.org/lmodel/common-domain-model/loan> a linkml:SlotDefinition ;
	linkml:description "Identifies the underlying asset when it is a loan." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Loan> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/loanParticipation__qualifyingParticipationSeller> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "qualifyingParticipationSeller" ;
	linkml:description "If Direct Loan Participation is specified as a deliverable obligation characteristic, this specifies any requirements for the Qualifying Participation Seller. The requirements may be listed free-form. ISDA 2003 Term: Qualifying Participation Seller." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LoanParticipation> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LoanParticipation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/qualifyingParticipationSeller"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/loan__creditAgreementDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "creditAgreementDate" ;
	linkml:description "Specifies the credit agreement date is the closing date (the date where the agreement has been signed) for the loans in the credit agreement. Funding of the facilities occurs on (or sometimes a little after) the Credit Agreement date. This underlier attribute is used to help identify which of the company's outstanding loans are being referenced by knowing to which credit agreement it belongs. ISDA Standards Terms Supplement term: Date of Original Credit Agreement." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Loan> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Loan> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/creditAgreementDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/loan__facilityType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
