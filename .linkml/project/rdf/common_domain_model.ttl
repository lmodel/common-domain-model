    skos:note "Rosetta condition: ConcentrationLimitTypeChoice — required choice concentrationLimitType, averageTradingVolume, collateralCriteria" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Either a limit type or limit criteria must be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/concentrationLimitType> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/averageTradingVolume> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/collateralCriteria> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ConcentrationLimitCriteria"^^xsd:anyURI ;
    linkml:description "Respresents a class to describe a set of criteria to describe specific assets that the concentration limits apply to." ;
