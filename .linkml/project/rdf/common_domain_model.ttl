        <https://w3id.org/lmodel/common-domain-model/billingRecord>,
        <https://w3id.org/lmodel/common-domain-model/billingStartDate>,
        <https://w3id.org/lmodel/common-domain-model/billingSummary>,
        <https://w3id.org/lmodel/common-domain-model/receivingParty>,
        <https://w3id.org/lmodel/common-domain-model/sendingParty> ;
    linkml:tree_root true .

<https://w3id.org/lmodel/common-domain-model/SensitivityToEquity> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:SensitivityToEquity"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SensitivityToEquity"^^xsd:anyURI ;
    linkml:description "Represents risk sensitivity calculated with respect to the value of an individual equity instrument." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/sensitivityToETFs>,
        <https://w3id.org/lmodel/common-domain-model/sensitivityToFunds>,
        <https://w3id.org/lmodel/common-domain-model/sensitivityToIndices> .

<https://w3id.org/lmodel/common-domain-model/Standard> skos:altLabel "Standard" ;
    linkml:description "As specified by the 2006 ISDA Definitions, Section 8.4. Discounting, paragraph (a).",
        "Calculations occur relative to the last day of a calculation period (set in arrears).",
        "Interest amount is not transferred if transfer would create or increase a delivery amount.",
        "Standard definition applies.",
        "The adjustments to the number of units are not governed by any specific clause.",
        "The relevant sensitivities are addressed by the standard preferred approach where the entire delta is put into the applicable asset class/category.",
        "The standard definition of the credit support amount applies.",
        "This trade will settle using standard predetermined funds settlement instructions." .

<https://w3id.org/lmodel/common-domain-model/StockSplitInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:StockSplitInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_StockSplit — Function specification to create the fully-formed business event which represents the impact of a stock split (or a reverse stock split) on an Equity Derivatives contract on a certain date." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_StockSplit\",\"description\":\"Function specification to create the fully-formed business event which represents the impact of a stock split (or a reverse stock split) on an Equity Derivatives contract on a certain date.\",\"inputs\":[{\"name\":\"stockSplitInstruction\",\"type\":\"StockSplitInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"before\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"after\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/StockSplitInstruction"^^xsd:anyURI ;
    linkml:description "Data required to perform a stock split business event." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/StockSplitInstruction_effectiveDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustmentRatio> .

<https://w3id.org/lmodel/common-domain-model/ThresholdMinimumTransferAmountBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ThresholdMinimumTransferAmountBase"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: ZeroEvent — if zeroEvent = True then event exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/zeroEvent> ] ;
            linkml:description "If zero event exists then boolean must be set to 'True' and event must be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/event> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ThresholdMinimumTransferAmountBase"^^xsd:anyURI ;
    linkml:description "A logical container designed to hold a set of related data. In this case, designed to hold a set of information required to specify conditions under which Threshold or Minimum Transfer Amount can fall to zero." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/event>,
        <https://w3id.org/lmodel/common-domain-model/zeroEvent> .

<https://w3id.org/lmodel/common-domain-model/Transfer> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:Transfer"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." ;
    linkml:abstract true ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Transfer"^^xsd:anyURI ;
    linkml:description " Transfer the interest each period ",
        "The intent is to transfer the position to another clearing member.",
        "The type of transfer." ;
    linkml:slot_usage [ ] ;
    linkml:union_of <https://w3id.org/lmodel/common-domain-model/ScheduledTransfer>,
        <https://w3id.org/lmodel/common-domain-model/UnscheduledTransfer> .

<https://w3id.org/lmodel/common-domain-model/UnitType> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_math> ;
    skos:closeMatch "gist:UnitOfMeasure"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:UnitType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    skos:note "Rosetta condition: UnitType — one-of",
        "Rosetta func: CompareQuantityByUnitOfAmount",
        "Rosetta func: FilterQuantity — Filter list of quantities based on unit type.",
        "Rosetta func: UnitEquals — Compares two UnitType to check if all attributes match." ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta one-of: exactly one slot must be present." ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Requires that a unit type must be set." ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"CompareQuantityByUnitOfAmount\",\"inputs\":[{\"name\":\"quantity1\",\"type\":\"Quantity\",\"cardinality\":\"0..*\"},{\"name\":\"op\",\"type\":\"CompareOp\",\"cardinality\":\"1..1\"},{\"name\":\"quantity2\",\"type\":\"Quantity\",\"cardinality\":\"0..*\"},{\"name\":\"unitOfAmount\",\"type\":\"UnitType\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"UnitEquals\",\"description\":\"Compares two UnitType to check if all attributes match.\",\"inputs\":[{\"name\":\"u1\",\"type\":\"UnitType\",\"cardinality\":\"0..1\"},{\"name\":\"u2\",\"type\":\"UnitType\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"result\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"FilterQuantity\",\"description\":\"Filter list of quantities based on unit type.\",\"inputs\":[{\"name\":\"quantities\",\"type\":\"Quantity\",\"cardinality\":\"0..*\"},{\"name\":\"unit\",\"type\":\"UnitType\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredQuantities\",\"type\":\"Quantity\",\"cardinality\":\"0..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/UnitType"^^xsd:anyURI ;
    linkml:description "Defines the unit to be used for price, quantity, or other purposes" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/capacityUnit>,
        <https://w3id.org/lmodel/common-domain-model/currency>,
        <https://w3id.org/lmodel/common-domain-model/financialUnit>,
        <https://w3id.org/lmodel/common-domain-model/weatherUnit> .

<https://w3id.org/lmodel/common-domain-model/ValuationCalculationDateLocation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_Japanese_2016"^^xsd:anyURI,
        "isda:CSA_IM_NewYork_2016"^^xsd:anyURI,
        "isda:CSD_IM_English_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(e)(i)\" name \"Calculation Date Location\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(d)(i)\" name \"Calculation Date Location\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(d)(i)\" name \"Calculation Date Location\"" ;
    skos:exactMatch "common_domain_model:ValuationCalculationDateLocation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ValuationCalculationDateLocation"^^xsd:anyURI ;
    linkml:description "Specification of the Calculation Date Location for the respective parties to the legal agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ValuationCalculationDateLocation_partyElection> .

<https://w3id.org/lmodel/common-domain-model/ValuationPostponement> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:ValuationPostponement"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ValuationPostponement"^^xsd:anyURI ;
    linkml:description "Specifies how long to wait to get a quote from a settlement rate option upon a price source disruption." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/maximumDaysOfPostponement> .

<https://w3id.org/lmodel/common-domain-model/VarianceCapFloor> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:VarianceCapFloor"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: CapFloorApplicability — if varianceCap = True then unadjustedVarianceCap exists or boundedVariance exists // If CapFloor is applicable at least one cap expression must exist else unadjustedVarianceCap is absent and boundedVariance is absent // If CapFloor is not applicable, then there cannot be any volatility caps",
        "Rosetta condition: PositiveUnadjustedVarianceCap — if unadjustedVarianceCap exists then unadjustedVarianceCap > 0" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/varianceCap> ] ;
            linkml:description "Caps/floors can and must be specified if varianceCap is set to true. If false, barriers cannot be established" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unadjustedVarianceCap> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/boundedVariance> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unadjustedVarianceCap> ] ;
            linkml:description "Unadjusted variance cap must be positive" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unadjustedVarianceCap> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/VarianceCapFloor"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/boundedVariance>,
        <https://w3id.org/lmodel/common-domain-model/unadjustedVarianceCap>,
        <https://w3id.org/lmodel/common-domain-model/varianceCap> .

<https://w3id.org/lmodel/common-domain-model/businessDayConvention> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#BusinessDateRange.businessDayConvention"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/businessDayConvention"^^xsd:anyURI ;
    linkml:description "The convention for adjusting a date if it would otherwise fall on a day that is not a business day, as specified by an ISDA convention (e.g. Following, Precedent)." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/BusinessDateRange>,
        <https://w3id.org/lmodel/common-domain-model/BusinessDayAdjustments>,
        <https://w3id.org/lmodel/common-domain-model/FinalCalculationPeriodDateAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/FxFixingDate>,
        <https://w3id.org/lmodel/common-domain-model/RelativeDateOffset> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FxFixingDate> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessDayConventionEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/businessDayConvention"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/businessDays> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/businessDays"^^xsd:anyURI ;
    linkml:description "A number of business days. Its precise meaning is dependant on the context in which this element is used. ISDA 2003 Term: Business Day." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PhysicalSettlementPeriod>,
        <https://w3id.org/lmodel/common-domain-model/SingleValuationDate> ;
    linkml:minimum_value "0"^^<https://w3id.org/linkml/@id> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PhysicalSettlementPeriod> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/businessDays"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/counterparty> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/counterparty"^^xsd:anyURI ;
    linkml:description "Maps two defined parties to counterparty enums for the transacted product." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AgreementTerms>,
        <https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification>,
        <https://w3id.org/lmodel/common-domain-model/ExecutionInstruction>,
        <https://w3id.org/lmodel/common-domain-model/MasterAgreementClause>,
        <https://w3id.org/lmodel/common-domain-model/MasterAgreementClauseVariant>,
        <https://w3id.org/lmodel/common-domain-model/PartyChangeInstruction>,
        <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Counterparty> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/counterparty"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/dayType> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/dayType"^^xsd:anyURI ;
    linkml:description "In the case of an offset specified as a number of days, this element defines whether consideration is given as to whether a day is a good business day or not. If a day type of business days is specified then non-business days are ignored when calculating the offset. The financial business centers to use for determination of business days are implied by the context in which this element is used. This element must only be included when the offset is specified as a number of days. If the offset is zero days then the dayType element should not be included." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Offset>,
        <https://w3id.org/lmodel/common-domain-model/ParametricDates>,
        <https://w3id.org/lmodel/common-domain-model/PeriodicDates> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/DayTypeEnum> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dayType"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/fixedAmount> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/fixedAmount"^^xsd:anyURI ;
    linkml:description "Defines that the Threshold is a Fixed Amount." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/InterestRatePayout>,
        <https://w3id.org/lmodel/common-domain-model/LegacyIndependentAmountParty>,
        <https://w3id.org/lmodel/common-domain-model/MinimumTransferAmountElection>,
        <https://w3id.org/lmodel/common-domain-model/ThresholdElection> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/InterestRatePayout> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/ThresholdMinimumTransferAmountFixedAmount> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fixedAmount"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/floatingRateIndex> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_scheme"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/floatingRateIndex"^^xsd:anyURI ;
    linkml:description "The reference index that is used to specify the floating interest rate." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FallbackRateParameters>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateIndex>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexIdentification>,
        <https://w3id.org/lmodel/common-domain-model/InterestRateCurve>,
        <https://w3id.org/lmodel/common-domain-model/StubFloatingRate>,
        <https://w3id.org/lmodel/common-domain-model/SwapCurveValuation> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/StubFloatingRate> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/floatingRateIndex"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/frequency> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/frequency"^^xsd:anyURI ;
    linkml:description "Defines the frequency to be used when defining a quantity. For example a quantity may be specified as a number of barrels of oil per day, which needs multiplying by the number of days in the relevant period to get the total quantity as a number of barrels." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CSAValuationDate>,
        <https://w3id.org/lmodel/common-domain-model/QuantitySchedule> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CSAValuationDate> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Frequency> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/frequency"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/identifierType> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AssetIdentifier.identifierType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/identifierType"^^xsd:anyURI ;
