	linkml:description "Contains the information relative to the delivery of the asset." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AssetDeliveryInformation> .
<https://w3id.org/lmodel/common-domain-model/deliveryAmount> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2194 ;
	linkml:description "In respect of a Valuation Date, the amount of collateral which a party is entitled to demand to be transferred to it as a Delivery Amount." , "Specifies whether the meaning of Delivery Amount follows the pre-print definition or deviates from this (either based on a rating or some other methodology)." , "The application of Interest Amount with respect the Delivery Amount." , "The nearest integral multiple of Base Currency units to which the Delivery Amount will be rounded in accordance with the specified rounding direction." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CSADeliveryAmount> , <https://w3id.org/lmodel/common-domain-model/DeliveryAmount> , <https://w3id.org/lmodel/common-domain-model/DeliveryReturnAmountEnum> , <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true .
