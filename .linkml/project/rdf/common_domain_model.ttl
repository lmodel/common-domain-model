	skos:prefLabel "localBusinessDay" ;
	linkml:description "Whether the Notification Time is precluded on the day being a local business day." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NotificationTimeElection> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/NotificationTimeElection> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/localBusinessDay"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/notificationTimeElection__notificationTime> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
	skos:prefLabel "notificationTime" ;
	linkml:description "The Notification Time as a time that is qualified as a standard business center." ;
