        <https://w3id.org/lmodel/common-domain-model/isCreditSupportDocument>,
        <https://w3id.org/lmodel/common-domain-model/otherProvisions> .

<https://w3id.org/lmodel/common-domain-model/FloatingRateIndexCalculationDefaults> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro> ;
    skos:exactMatch "common_domain_model:FloatingRateIndexCalculationDefaults"^^xsd:anyURI ;
