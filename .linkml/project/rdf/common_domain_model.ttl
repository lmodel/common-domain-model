        <https://w3id.org/lmodel/common-domain-model/RateObservation>,
        <https://w3id.org/lmodel/common-domain-model/Reset>,
        <https://w3id.org/lmodel/common-domain-model/ResetInstruction> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FxLinkedNotionalAmount> ;
