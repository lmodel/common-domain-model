	skos:prefLabel "fxFixingDate" ;
	linkml:description "The date on which the currency rate will be determined for the purpose of specifying the amount in deliverable currency. This attribute was formerly part of 'NonDeliverableSettlement', which is now being harmonised into a common 'CashSettlementTerms' that includes a 'ValuationDate'." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationDate> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationDate> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FxFixingDate> ;
