	linkml:owner <https://w3id.org/lmodel/common-domain-model/CashCollateralValuationMethod> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/cashCollateralInterestRate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/cashCollateralValuationMethod__prescribedDocumentationAdjustment> a linkml:SlotDefinition ;
