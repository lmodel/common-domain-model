	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/offsetDays"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/offsetDays> a linkml:SlotDefinition ;
	linkml:description "Specifies how many days from the trigger event should the payment occur." , "The number of business days offset." , "The number of days of observation shift." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> , <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/offsetMultiplier> a linkml:SlotDefinition ;
	linkml:description "A time offset multiplier, e.g. 1, 2 or 3 etc. A negative value can be used when specifying a negative offset, e.g. -2 hours." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> .
<https://w3id.org/lmodel/common-domain-model/offsetTimeUnit> a linkml:SlotDefinition ;
	linkml:description "The unit of time for the offset (e.g., seconds, minutes, hours, days)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum> .
<https://w3id.org/lmodel/common-domain-model/offset__dayType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
	skos:prefLabel "dayType" ;
	linkml:description "In the case of an offset specified as a number of days, this element defines whether consideration is given as to whether a day is a good business day or not. If a day type of business days is specified then non-business days are ignored when calculating the offset. The financial business centers to use for determination of business days are implied by the context in which this element is used. This element must only be included when the offset is specified as a number of days. If the offset is zero days then the dayType element should not be included." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Offset> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Offset> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DayTypeEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dayType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/onBehalfOf> a linkml:SlotDefinition ;
	linkml:description "Optionally specifies the counterparty that the ancillary party is acting on behalf of." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> .
<https://w3id.org/lmodel/common-domain-model/onFullReturn> a linkml:SlotDefinition ;
	linkml:description "Indicates the option that accrued interest should be calculated and distributed when a full return of collateral occurs." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/onPartialReturn> a linkml:SlotDefinition ;
	linkml:description "Indicates the option that accrued interest should be calculated and distributed when a partial return collateral occurs." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/oneWayProvisions> a linkml:SlotDefinition ;
	linkml:description "The determination of whether the One Way Provisions are applicable (true) or not applicable (false)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/OneWayProvisions> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/oneWayProvisions__isApplicable> a linkml:SlotDefinition ;
