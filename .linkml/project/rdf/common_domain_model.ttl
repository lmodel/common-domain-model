    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/ABX> linkml:description "Broker Confirmation Type representing ABX index trades.",
