        <https://w3id.org/lmodel/common-domain-model/excessDividendAmount>,
        <https://w3id.org/lmodel/common-domain-model/extraordinaryDividendsParty>,
        <https://w3id.org/lmodel/common-domain-model/firstOrSecondPeriod>,
        <https://w3id.org/lmodel/common-domain-model/materialDividend>,
        <https://w3id.org/lmodel/common-domain-model/nonCashDividendTreatment>,
        <https://w3id.org/lmodel/common-domain-model/performance>,
        <https://w3id.org/lmodel/common-domain-model/specialDividends> .

<https://w3id.org/lmodel/common-domain-model/LegalEntity> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:closeMatch "gist:Organization"^^xsd:anyURI,
        "oscal:Party"^^xsd:anyURI,
        "spdx:Organization"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:LegalEntity"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    skos:narrowMatch "gist:GovernmentOrganization"^^xsd:anyURI ;
    skos:relatedMatch "iso29100:PIIController"^^xsd:anyURI,
        "iso29100:PIIProcessor"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/LegalEntity"^^xsd:anyURI ;
    linkml:description "A class to specify a legal entity, with a required name and an optional entity identifier (such as the LEI)." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/LegalEntity_name>,
        <https://w3id.org/lmodel/common-domain-model/entityIdentifier> .

<https://w3id.org/lmodel/common-domain-model/assetType> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AssetBase.assetType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/assetType"^^xsd:anyURI ;
    linkml:description "Specifies the type of asset." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AssetBase>,
        <https://w3id.org/lmodel/common-domain-model/AssetType> ;
    linkml:equals_string "Cash",
        "Commodity",
        "ListedDerivative",
        "Loan",
        "Other",
        "Security" ;
    linkml:none_of [ a linkml:AnonymousSlotExpression ;
            linkml:equals_string_in "Security" ] ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/AssetType> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/AssetTypeEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/assetType"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/CancelableProvision> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:closeMatch "fpml_5_10:CancelableProvision"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CancelableProvision"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: CancelableProvisionExerciseNoticeReceiverParty — if exerciseNotice -> exerciseNoticeReceiver exists then exerciseNotice -> exerciseNoticeReceiver = AncillaryRoleEnum -> ExerciseNoticeReceiverPartyCancelableProvision",
        "Rosetta condition: EffectiveDate — optional choice effectiveDate, effectivePeriod" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Must select one of predefined cancellation types of effectiveDate or effectivePeriod." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/effectivePeriod> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/effectiveDate> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CancelableProvision"^^xsd:anyURI ;
    linkml:description "A data defining:  the right of a party to cancel a swap transaction on the specified exercise dates. The provision is for 'walk-away' cancellation (i.e. the fair value of the swap is not paid). A fee payable on exercise can be specified. As a difference from the FpML construct, the canonical model extends the BuyerSeller class." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/BuyerSeller> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CancelableProvision_effectiveDate>,
        <https://w3id.org/lmodel/common-domain-model/CancelableProvision_exerciseTerms>,
        <https://w3id.org/lmodel/common-domain-model/buyer>,
        <https://w3id.org/lmodel/common-domain-model/callingParty>,
        <https://w3id.org/lmodel/common-domain-model/cancelableProvisionAdjustedDates>,
        <https://w3id.org/lmodel/common-domain-model/earliestCancellationTime>,
        <https://w3id.org/lmodel/common-domain-model/earliestDate>,
        <https://w3id.org/lmodel/common-domain-model/effectivePeriod>,
        <https://w3id.org/lmodel/common-domain-model/exerciseNotice>,
        <https://w3id.org/lmodel/common-domain-model/expirationDate>,
        <https://w3id.org/lmodel/common-domain-model/finalCalculationPeriodDateAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/followUpConfirmation>,
        <https://w3id.org/lmodel/common-domain-model/initialFee>,
        <https://w3id.org/lmodel/common-domain-model/latestCancelationTime>,
        <https://w3id.org/lmodel/common-domain-model/seller> .

