	linkml:maximum_cardinality 2 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/levelPercentage> a linkml:SlotDefinition ;
	linkml:description "The trigger level percentage." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/lien> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1389 ;
	linkml:description "Specifies the seniority level of the lien." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/limitAmount> a linkml:SlotDefinition ;
	linkml:description "The total limit available for the limit level and limit type. While the attribute is of type integer in the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> .
<https://w3id.org/lmodel/common-domain-model/limitApplicable> a linkml:SlotDefinition ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/limitApplicableExtended__limitAmount> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "limitAmount" ;
	linkml:description "The total limit available for the limit level and limit type. While the attribute is of type integer in the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/limitAmount"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicableExtended__limitImpactDueToTrade> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "limitImpactDueToTrade" ;
	linkml:description "The limit utilized by this specific trade. While the attribute is of type integer in the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/limitImpactDueToTrade"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicableExtended__limitLevel> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "limitLevel" ;
	linkml:annotations _:c14n1386 ;
	linkml:description "The level at which the limit is set: customer business, proprietary business or account level. This attribute is specified as a string as part of the CME clearing confirmation specification." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/LimitLevelEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/limitLevel"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicable__amountRemaining> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "amountRemaining" ;
	linkml:description "The limit remaining for the limit level and limit type. This does not take into account any pending trades. While the attribute is of type integer in FpML and the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/amountRemaining"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicable__amountUtilized> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "amountUtilized" ;
	linkml:description "The limit utilised by all the cleared trades for the limit level and limit type. While the attribute is of type integer in FpML and the CME schema, it has been specified to be of type number in the CDM to take into consideration java size limits as well as for consistency purposes with the way most monetary amounts are expressed." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
