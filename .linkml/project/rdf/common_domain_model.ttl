    skos:note "Rosetta condition: DividendPeriod — if firstOrSecondPeriod exists then dividendPeriod -> startDate is absent and dividendPeriod -> endDate is absent",
        "Rosetta condition: ExtraordinaryDividendsParty — if extraordinaryDividendsParty exists then extraordinaryDividendsParty = AncillaryRoleEnum -> ExtraordinaryDividendsParty" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/DividendReturnTerms"^^xsd:anyURI ;
    linkml:description "A class describing the conditions governing the payment of dividends to the receiver of the equity return, with the exception of the dividend payout ratio, which is defined for each of the underlying components." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/dividendAmountType>,
        <https://w3id.org/lmodel/common-domain-model/dividendComposition>,
