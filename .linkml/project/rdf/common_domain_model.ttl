	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/additionalHaircutPercentage"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/collateralValuationTreatment__fxHaircutPercentage> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
	skos:prefLabel "fxHaircutPercentage" ;
	linkml:description "Specifies an FX haircut applied to a specific asset which is agreed between the parties (for example, if pledgor eligible collateral is not denominated in the termination currency or under other specified cases in collateral support documents both for initial margin and variation margin).The percentage value is expressed as the discount haircut to the value of the collateral- as an example an 8% FX haircut would be expressed as 0.08." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fxHaircutPercentage"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/collateralValuationTreatment__haircutPercentage> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
	skos:prefLabel "haircutPercentage" ;
	linkml:annotations _:c14n376 ;
	linkml:description "Specifies a haircut percentage to be applied to the value of asset and used as a discount factor to the value of the collateral asset,expressed as a percentage in decimal terms. As an example a 0.5% haircut would be represented as a decimal number 0.005." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment> ;
