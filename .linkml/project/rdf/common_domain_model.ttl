	linkml:range <https://w3id.org/lmodel/common-domain-model/DateRange> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/fixingReason> a linkml:SlotDefinition ;
	linkml:description "Fixing Reason" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/fixingTime> a linkml:SlotDefinition ;
	linkml:description "Parameters defining the normal fixing time (can vary by index tenor / designated maturity)." , "The time at which the spot currency exchange rate will be observed. It is specified as a time in a business day calendar location, e.g. 11:00am London time." , "The time that the fixing will be taken along with a business center to define the time zone." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessCenterTime> , <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexFixingTime> .
<https://w3id.org/lmodel/common-domain-model/fixingTimeDefinition> a linkml:SlotDefinition ;
	linkml:description "Legal text that underlies the Fixing Time. ISDA Fixing Time Definition. (e.g. 09:30, Sydney time)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
