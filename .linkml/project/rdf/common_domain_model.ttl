	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/recalculationOfValueTerms"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/recalculationOfValueTerms> a linkml:SlotDefinition ;
	linkml:description "Additional Recalculation of Value terms when specified." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/recalculationOfValue__partyElection> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
	skos:prefLabel "partyElection" ;
	linkml:description "The parties' Recalculation of Value terms." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/RecalculationOfValue> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:maximum_cardinality 2 ;
	linkml:minimum_cardinality 2 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/RecalculationOfValue> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RecalculationOfValueElection> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/partyElection"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/recallNonCashCollateralDescription> a linkml:SlotDefinition ;
	linkml:description "Specifies the details to describe or identify non-cash collateral eligible assets for recall purposes." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/EligibleCollateralCriteria> .
<https://w3id.org/lmodel/common-domain-model/recallProvision> a linkml:SlotDefinition ;
	linkml:description "A provision defining criteria controlling the ability for a lender to recall securities it has lent out." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/recallProvision__intendedSettlementDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "intendedSettlementDate" ;
	linkml:description "The intended settlement date of the recall, expressed as an offset against a relative date e.g. T+1. The best practice is that the borrower must make their best efforts to settle on T+1." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RelativeDateOffset> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/intendedSettlementDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/recallProvision__isRecallable> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "isRecallable" ;
	linkml:description "Whether the securities on loan can be recalled by the lender." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/isRecallable"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/recallProvision__issuanceCutoffTime> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "issuanceCutoffTime" ;
	linkml:description "The operational deadline on T+0 before which a recall must be requested. For the UK, best practice recommends that this would be 30 minutes before market close i.e. 16:00:00 GMT." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TimeZone> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/issuanceCutoffTime"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/recallProvision__notificationTime> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "notificationTime" ;
	linkml:description "The time on the day of intended settlement by which the borrower must notify the lender that they will be returning the requested security. For the UK, best practice recommends that this would be 30 minutes before the CREST DVP cut-off time i.e. 15:15:00 GMT" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TimeZone> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notificationTime"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/receiver> a linkml:SlotDefinition ;
	linkml:annotations _:c14n469 ;
	linkml:description "Specifies the party that receives the payments corresponding to this structure. The party is one of the two counterparties to the transaction." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/receiverAccountReference> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2286 ;
	linkml:description "A reference to the account that receives the payments corresponding to this structure." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Account> .
<https://w3id.org/lmodel/common-domain-model/receiverPartyReference> a linkml:SlotDefinition ;
	linkml:annotations _:c14n502 ;
	linkml:description "The party that receives the payments corresponding to this structure." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Party> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/receivingParty> a linkml:SlotDefinition ;
	linkml:description "The party receiving the invoice" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Party> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/recordDate> a linkml:SlotDefinition ;
	linkml:description "The date on which the account phyical balance and related underlier ownership is recorded by the custodian." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> .
<https://w3id.org/lmodel/common-domain-model/recordEndDate> a linkml:SlotDefinition ;
	linkml:description "The ending date of the period described by this record" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/recordStartDate> a linkml:SlotDefinition ;
	linkml:description "The starting date of the period described by this record" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/recordTransfer> a linkml:SlotDefinition ;
	linkml:description "The settlement terms for the billing record" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Transfer> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/recoveryFactor> a linkml:SlotDefinition ;
	linkml:description "Used for fixed recovery, specifies the recovery level, determined at contract formation, to be applied on a default. Used to calculate the amount paid by the seller to the buyer for cash settlement on the cash settlement date. Amount calculation is (1 minus the Recovery Factor) multiplied by the Floating Rate Payer Calculation Amount. The currency will be derived from the Floating Rate Payer Calculation Amount." ;
	linkml:maximum_value "1"^^linkml:\@id ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/recoveryPercent> a linkml:SlotDefinition ;
	linkml:description "The percentage of the original value of the asset affected by the credit event that can be recovered." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> .
<https://w3id.org/lmodel/common-domain-model/redemption> a linkml:SlotDefinition ;
	linkml:description "Specifies the general rule for redemption of a debt security." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DebtRedemption> .
<https://w3id.org/lmodel/common-domain-model/redemptionType> a linkml:SlotDefinition ;
	linkml:description "Specifies the contractual redemption or conversion features associated with a debt security." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RedemptionTypeEnum> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/referenceAgency> a linkml:SlotDefinition ;
	linkml:description "identifies the dominant reference agency if there is a missmatch and several reference agencies exsist." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CreditRatingAgencyEnum> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/referenceBank> a linkml:SlotDefinition ;
	linkml:description "An institution (party) identified by means of a coding scheme and an optional name." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ReferenceBank> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/referenceBankId> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1036 ;
	linkml:description "An institution (party) identifier, e.g. a bank identifier code (BIC). FpML specifies a referenceBankIdScheme." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/referenceBankName> a linkml:SlotDefinition ;
	linkml:description "The name of the institution (party). A free format string. FpML does not define usage rules for the element." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/referenceBank__referenceBankId> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
	skos:prefLabel "referenceBankId" ;
	linkml:annotations _:c14n1970 ;
	linkml:description "An institution (party) identifier, e.g. a bank identifier code (BIC). FpML specifies a referenceBankIdScheme." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceBank> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceBank> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/referenceBankId"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceBank__referenceBankName> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
	skos:prefLabel "referenceBankName" ;
	linkml:description "The name of the institution (party). A free format string. FpML does not define usage rules for the element." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceBank> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceBank> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/referenceBankName"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceBanks> a linkml:SlotDefinition ;
	linkml:description "A container for a set of reference institutions that may be called upon to provide rate quotations as part of the method to determine the applicable cash settlement amount. If institutions are not specified, it is assumed that reference institutions will be agreed between the parties on the exercise date, or in the case of swap transaction to which mandatory early termination is applicable, the cash settlement valuation date." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ReferenceBanks> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/referenceBanks__referenceBank> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
	skos:prefLabel "referenceBank" ;
	linkml:description "An institution (party) identified by means of a coding scheme and an optional name." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceBanks> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceBanks> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ReferenceBank> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/referenceBank"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceCurrency> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1669 ;
	linkml:description "Specifies the reference currency of the trade." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/referenceEntity> a linkml:SlotDefinition ;
	linkml:description "The corporate or sovereign entity on which you are buying or selling protection and any successor that assumes all or substantially all of its contractual and other obligations. It is vital to use the correct legal name of the entity and to be careful not to choose a subsidiary if you really want to trade protection on a parent company. Please note, Reference Entities cannot be senior or subordinated. It is the obligations of the Reference Entities that can be senior or subordinated. ISDA 2003 Term: Reference Entity." , "The corporate or sovereign entity which is subject to the swap transaction and any successor that assumes all or substantially all of its contractual and other obligations. Reference Entities cannot be senior or subordinated. It is the obligations of the Reference Entities that can be senior or subordinated. ISDA 2014 Credit definitions article II section 2.1: `Reference Entity` means the entity specified as such in the related Confirmation." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/LegalEntity> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/referenceFramework> a linkml:SlotDefinition ;
	linkml:description "Specifies the type of commodity." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CommodityReferenceFramework> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/referenceInformation> a linkml:SlotDefinition ;
	linkml:description "The reference entity, part of a credit basket, impacted by the credit event." , "This attribute contains all the terms relevant to defining the reference entity and reference obligation(s)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/referenceInformation__allGuarantees> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "allGuarantees" ;
	linkml:description "Indicates whether an obligation of the Reference Entity, guaranteed by the Reference Entity on behalf of a non-Affiliate, is to be considered an Obligation for the purpose of the transaction. It will be considered an obligation if allGuarantees is applicable (true) and not if allGuarantees is inapplicable (false). ISDA 2003 Term: All Guarantees." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/allGuarantees"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceInformation__noReferenceObligation> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "noReferenceObligation" ;
	linkml:description "Used to indicate that there is no Reference Obligation associated with this Credit Default Swap and that there will never be one." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/noReferenceObligation"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceInformation__referenceEntity> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "referenceEntity" ;
	linkml:description "The corporate or sovereign entity which is subject to the swap transaction and any successor that assumes all or substantially all of its contractual and other obligations. Reference Entities cannot be senior or subordinated. It is the obligations of the Reference Entities that can be senior or subordinated. ISDA 2014 Credit definitions article II section 2.1: `Reference Entity` means the entity specified as such in the related Confirmation." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/LegalEntity> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/referenceEntity"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceInformation__referenceObligation> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "referenceObligation" ;
	linkml:description "The Reference Obligation is a financial instrument that is either issued or guaranteed by the reference entity. It serves to clarify the precise reference entity protection is being offered upon, and its legal position with regard to other related firms (parents/subsidiaries). Furthermore the Reference Obligation is ALWAYS deliverable and establishes the Pari Passu ranking (as the deliverable bonds must rank equal to the reference obligation). ISDA 2003 Term: Reference Obligation." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ReferenceObligation> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/referenceObligation"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceInformation__referencePolicy> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "referencePolicy" ;
	linkml:description "Applicable to the transactions on mortgage-backed security, which can make use of a reference policy. Presence of the element with value set to 'true' indicates that the reference policy is applicable; absence implies that it is not." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/referencePolicy"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceInformation__referencePrice> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "referencePrice" ;
	linkml:description "Used to determine (a) for physically settled trades, the Physical Settlement Amount, which equals the Floating Rate Payer Calculation Amount times the Reference Price and (b) for cash settled trades, the Cash Settlement Amount, which equals the greater of (i) the difference between the Reference Price and the Final Price and (ii) zero. ISDA 2003 Term: Reference Price." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Price> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/referencePrice"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceInformation__securedList> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "securedList" ;
	linkml:description "With respect to any day, the list of Syndicated Secured Obligations of the Designated Priority of the Reference Entity published by Markit Group Limited or any successor thereto appointed by the Specified Dealers (the 'Secured List Publisher') on or most recently before such day, which list is currently available at [http://www.markit.com]. ISDA 2003 Term: Relevant Secured List." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/securedList"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceInformation__unknownReferenceObligation> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "unknownReferenceObligation" ;
	linkml:description "Used to indicate that the Reference obligation associated with the Credit Default Swap is currently not known. This is not valid for Legal Confirmation purposes, but is valid for earlier stages in the trade life cycle (e.g. Broker Confirmation)." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceInformation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/unknownReferenceObligation"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/referenceObligation> a linkml:SlotDefinition ;
	linkml:description "The Reference Obligation is a financial instrument that is either issued or guaranteed by the reference entity. It serves to clarify the precise reference entity protection is being offered upon, and its legal position with regard to other related firms (parents/subsidiaries). Furthermore the Reference Obligation is ALWAYS deliverable and establishes the Pari Passu ranking (as the deliverable bonds must rank equal to the reference obligation). ISDA 2003 Term: Reference Obligation." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ReferenceObligation> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/referenceObligation__guarantor> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "guarantor" ;
	linkml:description "The party that guarantees by way of a contractual arrangement to pay the debts of an obligor if the obligor is unable to make the required payments itself. ISDA 2003 Term: Guarantor." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ReferenceObligation> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ReferenceObligation> ;
