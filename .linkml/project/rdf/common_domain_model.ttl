    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TriggerEvent"^^xsd:anyURI ;
    linkml:description "Observation point for trigger." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/featurePayment>,
        <https://w3id.org/lmodel/common-domain-model/schedule>,
        <https://w3id.org/lmodel/common-domain-model/trigger>,
        <https://w3id.org/lmodel/common-domain-model/triggerDates> .

<https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementSet> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common> ;
    skos:exactMatch "common_domain_model:UmbrellaAgreementSet"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: ExcludeGMSLA — agreement -> masterAgreementElections -> islaGmsla is absent" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementSet"^^xsd:anyURI ;
    linkml:description "Represents the groups of agreement term elections that exist within the agreement and to which entities that particular group of elections apply. Where all entities under the umbrella have the same set of elections only one agreement set will exist. At least one agreement set must be defined for an Umbrella agreement" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementSet_party>,
        <https://w3id.org/lmodel/common-domain-model/additionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/agreement> .

<https://w3id.org/lmodel/common-domain-model/UnderlierSubstitutionProvision> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction> ;
    skos:exactMatch "common_domain_model:UnderlierSubstitutionProvision"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction"^^xsd:anyURI ;
    skos:note "Rosetta condition: DisputingPartyCannotHaveOriginalRole — whoMaySubstitute all <> disputingParty" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/UnderlierSubstitutionProvision"^^xsd:anyURI ;
    linkml:description "Where parties describe any substitution terms." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/disputingParty>,
        <https://w3id.org/lmodel/common-domain-model/substitutionBeSpokeTerms>,
        <https://w3id.org/lmodel/common-domain-model/substitutionTriggerEvents>,
        <https://w3id.org/lmodel/common-domain-model/whoMaySubstitute> .

<https://w3id.org/lmodel/common-domain-model/ValuationDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:ValuationDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ValuationDates"^^xsd:anyURI ;
    linkml:description "Defines how and when a performance type option or performance type swap is to be valued, including initial, interim and final valuation dates." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/finalValuationDate>,
        <https://w3id.org/lmodel/common-domain-model/initialValuationDate>,
        <https://w3id.org/lmodel/common-domain-model/interimValuationDate> .

<https://w3id.org/lmodel/common-domain-model/ValuationInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:ValuationInstruction"^^xsd:anyURI ;
