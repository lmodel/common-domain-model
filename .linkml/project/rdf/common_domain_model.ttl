    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentDate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/paymentDates> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CommodityPayout.paymentDates"^^xsd:anyURI ;
