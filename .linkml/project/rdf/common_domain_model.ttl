<https://w3id.org/lmodel/common-domain-model/StandardizedScheduleInitialMargin> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_margin_schedule> ;
    skos:exactMatch "common_domain_model:StandardizedScheduleInitialMargin"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_margin_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: NonNegativeNetInitialMargin — netInitialMargin -> value >= 0",
        "Rosetta func: GetNetInitialMarginFromExposure — Computes the net initial margin, taking the gross initial margin result and the mark to market value for each trade in the portfolio." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"GetNetInitialMarginFromExposure\",\"description\":\"Computes the net initial margin, taking the gross initial margin result and the mark to market value for each trade in the portfolio.\",\"inputs\":[{\"name\":\"exposure\",\"type\":\"Exposure\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"initialMargin\",\"type\":\"StandardizedScheduleInitialMargin\",\"cardinality\":\"0..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/StandardizedScheduleInitialMargin"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/netInitialMargin>,
        <https://w3id.org/lmodel/common-domain-model/tradeInfo> .

<https://w3id.org/lmodel/common-domain-model/StubPeriod> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:StubPeriod"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/StubPeriod"^^xsd:anyURI ;
    linkml:description " A class defining how the initial or final stub calculation period amounts is calculated. For example, the rate to be applied to the initial or final stub calculation period may be the linear interpolation of two different tenors for the floating rate index specified in the calculation period amount component, e.g. A two month stub period may used the linear interpolation of a one month and three month floating rate. The different rate tenors would be specified in this component. Note that a maximum of two rate tenors can be specified. If a stub period uses a single index tenor and this is the same as that specified in the calculation period amount component then the initial stub or final stub component, as the case may be, must not be included." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/calculationPeriodDatesReference>,
        <https://w3id.org/lmodel/common-domain-model/finalStub>,
        <https://w3id.org/lmodel/common-domain-model/initialStub> .

<https://w3id.org/lmodel/common-domain-model/TaxonomyValue> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:TaxonomyValue"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: ValueExists — name exists or classification exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "ValueExists" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/name> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/classification> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TaxonomyValue"^^xsd:anyURI ;
    linkml:description "Defines a taxonomy value as either a simple string or a more granular expression with class names and values for each class." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/classification>,
        <https://w3id.org/lmodel/common-domain-model/name> .

<https://w3id.org/lmodel/common-domain-model/TimeRounding> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:exactMatch "common_domain_model:TimeRounding"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TimeRounding"^^xsd:anyURI ;
    linkml:description "Specifies how a calculated time should be rounded, including both the direction of rounding and the unit to which the time is rounded. Rounding is applied after all offsets have been calculated." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/roundToUnit>,
        <https://w3id.org/lmodel/common-domain-model/roundingDirection> .

<https://w3id.org/lmodel/common-domain-model/account> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/account"^^xsd:anyURI ;
    linkml:description "The account that might be associated with the party. At most one account can be specified, as it is expected that this information is used in the context of a contract or legal document where only one account per party can be associated with such object." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Party>,
        <https://w3id.org/lmodel/common-domain-model/Trade>,
        <https://w3id.org/lmodel/common-domain-model/TransferContactInformation>,
        <https://w3id.org/lmodel/common-domain-model/WorkflowStep> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/TransferContactInformation> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Account> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/account"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/additionalHaircutPercentage> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/additionalHaircutPercentage"^^xsd:anyURI ;
    linkml:description "Percentage value of any additional haircut to be applied to a collateral asset,the percentage value is expressed as the discount haircut to the value of the collateral- as an example a 5% haircut would be expressed as 0.05." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment>,
        <https://w3id.org/lmodel/common-domain-model/PostedCreditSupportItem> ;
    linkml:maximum_value "1"^^<https://w3id.org/linkml/@id> ;
    linkml:minimum_value "0"^^<https://w3id.org/linkml/@id> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/additionalHaircutPercentage"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/additionalRegime> a linkml:SlotDefinition ;
