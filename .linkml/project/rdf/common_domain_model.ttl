    linkml:description "The feature payment date." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FeaturePayment>,
        <https://w3id.org/lmodel/common-domain-model/InterestRatePayout>,
        <https://w3id.org/lmodel/common-domain-model/PaymentDetail>,
        <https://w3id.org/lmodel/common-domain-model/SchedulePeriod> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
