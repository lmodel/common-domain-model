<https://w3id.org/lmodel/common-domain-model/AssetType> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:closeMatch "fpml_5_10:AssetType"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AssetType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: BondSubType — if securityType <> Debt then debtType is absent",
        "Rosetta condition: EquitySubType — if securityType <> Equity then equityType is absent",
        "Rosetta condition: FundSubType — if securityType <> Fund then fundType is absent",
        "Rosetta condition: OtherAssetSubType — if assetType = Other then otherAssetType exists",
        "Rosetta condition: SecuritySubType — if assetType <> Security then securityType is absent" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta negation: assetType <> Security" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/assetType> ] ;
            linkml:description "SecuritySubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securityType> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securityType <> Equity" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securityType> ] ;
            linkml:description "EquitySubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/equityType> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/assetType> ] ;
            linkml:description "OtherAssetSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/otherAssetType> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securityType <> Fund" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securityType> ] ;
            linkml:description "FundSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fundType> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securityType <> Debt" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securityType> ] ;
            linkml:description "BondSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/debtType> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AssetType"^^xsd:anyURI ;
    linkml:description "Represents a class to allow specification of the asset product type." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AssetType_assetType>,
        <https://w3id.org/lmodel/common-domain-model/AssetType_debtType>,
        <https://w3id.org/lmodel/common-domain-model/AssetType_equityType>,
        <https://w3id.org/lmodel/common-domain-model/AssetType_fundType>,
        <https://w3id.org/lmodel/common-domain-model/AssetType_securityType>,
        <https://w3id.org/lmodel/common-domain-model/otherAssetType> .

<https://w3id.org/lmodel/common-domain-model/CalculationPeriod> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:closeMatch "fpml_5_10:CalculationPeriod"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CalculationPeriod"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: EndDateChoice — required choice adjustedEndDate, unadjustedEndDate",
        "Rosetta condition: NotionalChoice — required choice notionalAmount, fxLinkedNotionalAmount",
        "Rosetta condition: RateChoice — required choice floatingRateDefinition, fixedRate",
        "Rosetta condition: StartDateChoice — required choice adjustedStartDate, unadjustedStartDate" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule ird-30 - Context: CalculationPeriod (complex type). unadjustedStartDate exists or adjustedStartDate exists." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustedStartDate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unadjustedStartDate> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule ird-31 - Context: CalculationPeriod (complex type). unadjustedEndDate exists or adjustedEndDate exists." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustedEndDate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unadjustedEndDate> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "condition to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fxLinkedNotionalAmount> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/notionalAmount> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "condition to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fixedRate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/floatingRateDefinition> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculationPeriod"^^xsd:anyURI ;
    linkml:description "A data defining:  the parameters used in the calculation of a fixed or floating rate calculation period amount. This data forms:  part of cashflows representation of a swap stream.",
        "Describes the reference contract as the one that pertains to the month-year of the calculation period. If used, the nearby count is expected to be 0." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/CalculationPeriodBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CalculationPeriod_calculationPeriodNumberOfDays>,
        <https://w3id.org/lmodel/common-domain-model/CalculationPeriod_fixedRate>,
        <https://w3id.org/lmodel/common-domain-model/CalculationPeriod_forecastRate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedEndDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedStartDate>,
        <https://w3id.org/lmodel/common-domain-model/dayCountYearFraction>,
        <https://w3id.org/lmodel/common-domain-model/floatingRateDefinition>,
        <https://w3id.org/lmodel/common-domain-model/forecastAmount>,
        <https://w3id.org/lmodel/common-domain-model/fxLinkedNotionalAmount>,
        <https://w3id.org/lmodel/common-domain-model/notionalAmount>,
        <https://w3id.org/lmodel/common-domain-model/unadjustedEndDate>,
        <https://w3id.org/lmodel/common-domain-model/unadjustedStartDate> .

