<https://w3id.org/lmodel/common-domain-model/PaymentCalculationPeriod> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:PaymentCalculationPeriod"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: CalculationPeriodNumberOfDays — if calculationPeriod -> calculationPeriodNumberOfDays exists then calculationPeriod -> calculationPeriodNumberOfDays all >= 0",
        "Rosetta condition: FpML_ird_34 — unadjustedPaymentDate exists or adjustedPaymentDate exists",
        "Rosetta condition: PaymentCalculationPeriodChoice — required choice calculationPeriod, fixedPaymentAmount" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule ird-34 - Either unadjustedPaymentDate or adjustedPaymentDate must exist." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustedPaymentDate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unadjustedPaymentDate> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "condition to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fixedPaymentAmount> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/calculationPeriod> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PaymentCalculationPeriod"^^xsd:anyURI ;
    linkml:description "A data defining:  the adjusted payment date and associated calculation period parameters required to calculate the actual or projected payment amount. This data forms:  part of the cashflow representation of a swap stream." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PaymentCalculationPeriod_calculationPeriod>,
        <https://w3id.org/lmodel/common-domain-model/adjustedPaymentDate>,
        <https://w3id.org/lmodel/common-domain-model/discountFactor>,
        <https://w3id.org/lmodel/common-domain-model/fixedPaymentAmount>,
        <https://w3id.org/lmodel/common-domain-model/forecastPaymentAmount>,
        <https://w3id.org/lmodel/common-domain-model/presentValueAmount>,
        <https://w3id.org/lmodel/common-domain-model/unadjustedPaymentDate> .

<https://w3id.org/lmodel/common-domain-model/PostingObligationsElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(ii)\"" ;
    skos:exactMatch "common_domain_model:PostingObligationsElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AsPermitted — if asPermitted = True then eligibleCollateral is absent",
        "Rosetta condition: ConsistentParty — if eligibleCollateral exists then eligibleCollateral -> appliesTo count = 0",
        "Rosetta condition: EligibleCollateral — if asPermitted = False then eligibleCollateral exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/asPermitted> ] ;
            linkml:description "A data rule to enforce that the eligible collateral shouldn't be specified when the Control Agreement isn't deemed a Credit Support Document with respect to the party(ies)." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/eligibleCollateral> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/asPermitted> ] ;
            linkml:description "A data rule to enforce that the eligible collateral should be specified when the Control Agreement is a Credit Support Document with respect to the party(ies)." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/eligibleCollateral> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PostingObligationsElection"^^xsd:anyURI ;
    linkml:description "Specifies the collateral posting obligations for the security provider party(ies)." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PostingObligationsElection_additionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/PostingObligationsElection_party>,
        <https://w3id.org/lmodel/common-domain-model/asPermitted>,
        <https://w3id.org/lmodel/common-domain-model/eligibleCollateral>,
        <https://w3id.org/lmodel/common-domain-model/excludedCollateral> .

