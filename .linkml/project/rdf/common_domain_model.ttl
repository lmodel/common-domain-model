    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FloatingRateProcessingParameters> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Measure> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/multiplier"^^xsd:anyURI .

