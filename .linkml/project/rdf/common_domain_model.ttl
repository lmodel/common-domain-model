<https://w3id.org/lmodel/common-domain-model/IdentifiedList> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_identifier> ;
    skos:exactMatch "common_domain_model:IdentifiedList"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_identifier"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/IdentifiedList"^^xsd:anyURI ;
    linkml:description "Attaches an identifier to a collection of objects, when those objects themselves can each be represented by an identifier. One use case is the representation of package transactions, where each component is a separate trade with its own identifier, and those trades are linked together as a package with its own identifier. The data type has been named generically rather than referring to 'packages' as it may have a number of other uses." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/componentId>,
        <https://w3id.org/lmodel/common-domain-model/listId>,
        <https://w3id.org/lmodel/common-domain-model/price> .

<https://w3id.org/lmodel/common-domain-model/Index> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:altLabel "Index" ;
    skos:exactMatch "common_domain_model:Index"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." ;
    linkml:abstract true ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Index"^^xsd:anyURI ;
    linkml:description "A published index using a methodology defined by the publisher, e.g. S&P 500.",
        "An Index is an Observable which is computed based on the prices, rates or valuations of a number of assets that are tracked in a standardized way.  Examples include equity market indices as well as indices on interest rates, inflation and credit instruments.",
        "Denotes a value as the Index price reported in or by the relevant Price Source as specified in the relevant Confirmation." ;
    linkml:slot_usage [ ] ;
    linkml:union_of <https://w3id.org/lmodel/common-domain-model/CreditIndex>,
        <https://w3id.org/lmodel/common-domain-model/EquityIndex>,
        <https://w3id.org/lmodel/common-domain-model/ForeignExchangeRateIndex>,
        <https://w3id.org/lmodel/common-domain-model/InterestRateIndex>,
        <https://w3id.org/lmodel/common-domain-model/OtherIndex> .

<https://w3id.org/lmodel/common-domain-model/IndexAdjustmentEvents> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms> ;
    rdfs:seeAlso "isda:EquityDerivativesDefinitions_2002"^^xsd:anyURI ;
    skos:editorialNote "ISDA EquityDerivativesDefinitions_2002" ;
    skos:exactMatch "common_domain_model:IndexAdjustmentEvents"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/IndexAdjustmentEvents"^^xsd:anyURI ;
    linkml:description "Defines the specification of the consequences of Index Events" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/indexCancellation>,
        <https://w3id.org/lmodel/common-domain-model/indexDisruption>,
        <https://w3id.org/lmodel/common-domain-model/indexModification> .

<https://w3id.org/lmodel/common-domain-model/IndexBase_assetClass> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_margin_schedule"^^xsd:anyURI ;
    skos:prefLabel "assetClass" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/assetClass"^^xsd:anyURI ;
    linkml:description "The Asset Class of the Index." ;
    linkml:domain <https://w3id.org/lmodel/common-domain-model/IndexBase> ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/IndexBase> ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/assetClass> ;
    linkml:is_usage_slot true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/IndexBase> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/AssetClassEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/assetClass"^^xsd:anyURI ;
    linkml:usage_slot_name "assetClass" .

<https://w3id.org/lmodel/common-domain-model/IndexBase_name> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:prefLabel "name" ;
    linkml:annotations [ linkml:metadata_scheme [ skos:example true ;
                    linkml:annotations [ ] ;
                    linkml:extensions [ ] ;
                    linkml:tag "metadata_scheme"^^xsd:anyURI ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/name"^^xsd:anyURI ;
    linkml:description "A description of the Index." ;
    linkml:domain <https://w3id.org/lmodel/common-domain-model/IndexBase> ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/IndexBase> ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/name> ;
    linkml:is_usage_slot true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/IndexBase> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/name"^^xsd:anyURI ;
    linkml:usage_slot_name "name" .

<https://w3id.org/lmodel/common-domain-model/IneligibleCreditSupport> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_VM_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"13\" clause \"(c)(iii)\" name \"Legally Ineligible Credit Support (VM)\"" ;
    skos:exactMatch "common_domain_model:IneligibleCreditSupport"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/IneligibleCreditSupport"^^xsd:anyURI ;
    linkml:description "Identifies collateral that has been designated as not meeting the eligibility criteria set out in the agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/specifiedParty>,
        <https://w3id.org/lmodel/common-domain-model/totalIneligibilityDate>,
        <https://w3id.org/lmodel/common-domain-model/transferIneligibilityDate> .

<https://w3id.org/lmodel/common-domain-model/InterestShortFall> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:InterestShortFall"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/InterestShortFall"^^xsd:anyURI ;
    linkml:description "A class to specify the interest shortfall floating rate payment event." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/compounding>,
        <https://w3id.org/lmodel/common-domain-model/interestShortfallCap>,
        <https://w3id.org/lmodel/common-domain-model/rateSource> .

<https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_workflow> ;
    skos:exactMatch "common_domain_model:LimitApplicableExtended"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/LimitApplicableExtended"^^xsd:anyURI ;
    linkml:description "A class to represent the CDM attributes that are not part of the FpML standard. Once broader usage is confirmed, it is expected that those two classes can be collapsed." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/LimitApplicable_currency>,
        <https://w3id.org/lmodel/common-domain-model/amountRemaining>,
        <https://w3id.org/lmodel/common-domain-model/amountUtilized>,
        <https://w3id.org/lmodel/common-domain-model/clipSize>,
        <https://w3id.org/lmodel/common-domain-model/limitAmount>,
        <https://w3id.org/lmodel/common-domain-model/limitImpactDueToTrade>,
        <https://w3id.org/lmodel/common-domain-model/limitLevel>,
        <https://w3id.org/lmodel/common-domain-model/limitType>,
        <https://w3id.org/lmodel/common-domain-model/utilization>,
        <https://w3id.org/lmodel/common-domain-model/velocity> .

<https://w3id.org/lmodel/common-domain-model/Lineage> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:Lineage"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Lineage"^^xsd:anyURI ;
    linkml:description "A class to provide lineage information across lifecycle events through a pointer or set of pointers into the event(s), contract(s) and, possibly, payout components that the event is dependent on or relates to. As an example, if an contractFormation event is corrected, the correction event will have a lineage into the initial event, which takes the form of a globalKey into that initial contract formation event. Two referencing mechanisms are provided as part of the CDM: either the globalKey, which corresponds to the hash value of the CDM class which is referred to, or a reference qualifier which is meant to provide support for the ingestion of xml documents with id/href mechanisms. The CDM recommends the use of the globalKey and provides a default implementation which is accessible in the generated code through org.isda.cdm.globalKey.GlobalKeyHashCalculator. If implementers want to use an alternative hashing mechanism, the API in which they need to plug it is com.rosetta.model.lib.HashFunction." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/eventReference>,
        <https://w3id.org/lmodel/common-domain-model/portfolioStateReference>,
        <https://w3id.org/lmodel/common-domain-model/tradeReference> .

<https://w3id.org/lmodel/common-domain-model/MarginCallExposure> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:MarginCallExposure"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: ExposureSimmAndScheduleIMOnly — if simmIMExposure exists and scheduleGridIMExposure exists then regMarginType = RegMarginTypeEnum -> RegIM",
        "Rosetta condition: OverallExposureSumOfSimmAndScheduleIM — if simmIMExposure exists and scheduleGridIMExposure exists then (overallExposure -> aggregateValue -> value = simmIMExposure -> aggregateValue -> value + scheduleGridIMExposure -> aggregateValue -> value) and (overallExposure -> aggregateValue -> unit -> currency = simmIMExposure -> aggregateValue -> unit -> currency) and (overallExposure -> aggregateValue -> unit -> currency = scheduleGridIMExposure -> aggregateValue -> unit -> currency)" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MarginCallExposure"^^xsd:anyURI ;
    linkml:description "Represents attributes required for mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency)." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/MarginCallBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/MarginCallBase_party>,
        <https://w3id.org/lmodel/common-domain-model/MarginCallBase_partyRole>,
        <https://w3id.org/lmodel/common-domain-model/agreementMinimumTransferAmount>,
        <https://w3id.org/lmodel/common-domain-model/agreementRounding>,
        <https://w3id.org/lmodel/common-domain-model/agreementThreshold>,
        <https://w3id.org/lmodel/common-domain-model/baseCurrencyExposure>,
        <https://w3id.org/lmodel/common-domain-model/callAgreementType>,
        <https://w3id.org/lmodel/common-domain-model/callIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/clearingBroker>,
        <https://w3id.org/lmodel/common-domain-model/collateralPortfolio>,
        <https://w3id.org/lmodel/common-domain-model/independentAmountBalance>,
        <https://w3id.org/lmodel/common-domain-model/instructionType>,
        <https://w3id.org/lmodel/common-domain-model/overallExposure>,
        <https://w3id.org/lmodel/common-domain-model/regIMRole>,
        <https://w3id.org/lmodel/common-domain-model/regMarginType>,
        <https://w3id.org/lmodel/common-domain-model/scheduleGridIMExposure>,
        <https://w3id.org/lmodel/common-domain-model/simmIMExposure> .

<https://w3id.org/lmodel/common-domain-model/NaturalPersonRole> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:closeMatch "gist:Assignment"^^xsd:anyURI,
        "oscal:ResponsibleParty"^^xsd:anyURI ;
