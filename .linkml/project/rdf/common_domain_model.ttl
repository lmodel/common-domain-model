    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CashCollateralValuationMethod"^^xsd:anyURI ;
    linkml:description "This type is a generic structure that can represent the parameters of several mid-market valuation and replacement value methods described in the 2021 ISDA Definitions." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/agreedDiscountRate>,
        <https://w3id.org/lmodel/common-domain-model/applicableCsa>,
        <https://w3id.org/lmodel/common-domain-model/cashCollateralCurrency>,
        <https://w3id.org/lmodel/common-domain-model/cashCollateralInterestRate>,
        <https://w3id.org/lmodel/common-domain-model/prescribedDocumentationAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/protectedParty> .

<https://w3id.org/lmodel/common-domain-model/CollateralIssuerType> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:closeMatch "fpml_5_10:CollateralIssuerType"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CollateralIssuerType"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: QuasiGovernmentSubType — if issuerType <> QuasiGovernment then quasiGovernmentType is absent",
        "Rosetta condition: RegionalGovernmentSubType — if issuerType <> RegionalGovernment then regionalGovernmentType is absent",
        "Rosetta condition: SpecialPurposeVehicleSubType — if issuerType <> SpecialPurposeVehicle then specialPurposeVehicleType is absent",
        "Rosetta condition: SupraNationalSubType — if issuerType <> SupraNational then supraNationalType is absent" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta negation: issuerType <> RegionalGovernment" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/issuerType> ] ;
            linkml:description "RegionalGovernmentSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/regionalGovernmentType> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: issuerType <> SupraNational" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/issuerType> ] ;
            linkml:description "SupraNationalSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/supraNationalType> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: issuerType <> QuasiGovernment" ;
