	linkml:range <https://w3id.org/lmodel/common-domain-model/SecuredPartyRightsEvent> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/securityTakerRightsEvent"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/rightsSubscriptionPrice> a linkml:SlotDefinition ;
	linkml:description "The price to pay per each right." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Price> .
<https://w3id.org/lmodel/common-domain-model/role> a linkml:SlotDefinition ;
	linkml:annotations _:c14n440 ;
	linkml:description "FpML specifies a person role that is distinct from the party role." , "Specifies the AncillaryRoleEnum that is associated to the party reference. An ancillary party is any involved party that is not one of the two principal parties to the transaction." , "Specifies the CounterpartyEnum, e.g. either Party1 or Party2, that is associated to the partyReference." , "The category of the relationship. The related party performs the role specified in this field for the base party. For example, if the role is ,Guarantor, the related party acts as a guarantor for the base party." , "The party role." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum> , <https://w3id.org/lmodel/common-domain-model/AssetAncillaryPartyRoleEnum> , <https://w3id.org/lmodel/common-domain-model/AssetPartyRoleEnum> , <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> , <https://w3id.org/lmodel/common-domain-model/NaturalPersonRoleEnum> , <https://w3id.org/lmodel/common-domain-model/PartyRoleEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/rollConvention> a linkml:SlotDefinition ;
	linkml:description "The roll convention specifies the period term as part of a periodic schedule, i.e. the calculation period end date within the regular part of the calculation period. The value could be a rule, e.g. IMM Settlement Dates, which is the 3rd Wednesday of the month, or it could be a specific day of the month, such as the first day of the applicable month. It is used in conjunction with a frequency and the regular period start date of a calculation period." ;
	linkml:equals_string "FRI" , "MON" , "NONE" , "SAT" , "SFE" , "SUN" , "THU" , "TUE" , "WED" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RollConventionEnum> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/rollFeature> a linkml:SlotDefinition ;
	linkml:description "Used in conjunction with an exchange-based pricing source. Identifies a way in which the futures contracts referenced will roll between periods." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RollFeature> .
<https://w3id.org/lmodel/common-domain-model/rollFeature__deliveryDateRollConvention> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "deliveryDateRollConvention" ;
	linkml:description "Specifies, for a Commodity Transaction that references a delivery date for a listed future, the day on which the specified future will roll to the next nearby month prior to the expiration of the referenced future. If the future will not roll at all - i.e. the price will be taken from the expiring contract, 0 should be specified here. If the future will roll to the next nearby on the last trading day - i.e. the price will be taken from the next nearby on the last trading day, then 1 should be specified and so on." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/RollFeature> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/RollFeature> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/deliveryDateRollConvention"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/rollFeature__rollSourceCalendar> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "rollSourceCalendar" ;
	linkml:description "Used in conjunction with an exchange-based pricing source. Identifies a date source calendar from which the pricing dates and thus roll to the next contract will be based off (e.g. pricing is based on the NYMEX WTI First Nearby Futures Contract, if Future is chosen, the pricing will roll to the next futures contract on expiration, if ListedOption is chosen, the pricing will roll to the next futures contract on the Option expiration date which is three business days before the expiration of the NYMEX WTI futures contract.) Omitting this element will result in the default behavior expected with the pricing source described within the commodity element." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/RollFeature> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/RollFeature> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RollSourceCalendarEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/rollSourceCalendar"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/rollSourceCalendar> a linkml:SlotDefinition ;
	linkml:description "Used in conjunction with an exchange-based pricing source. Identifies a date source calendar from which the pricing dates and thus roll to the next contract will be based off (e.g. pricing is based on the NYMEX WTI First Nearby Futures Contract, if Future is chosen, the pricing will roll to the next futures contract on expiration, if ListedOption is chosen, the pricing will roll to the next futures contract on the Option expiration date which is three business days before the expiration of the NYMEX WTI futures contract.) Omitting this element will result in the default behavior expected with the pricing source described within the commodity element." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RollSourceCalendarEnum> .
<https://w3id.org/lmodel/common-domain-model/roundToUnit> a linkml:SlotDefinition ;
	linkml:description "The time unit to which the value should be rounded (e.g., minute, hour, day)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TimeUnitEnum> .
<https://w3id.org/lmodel/common-domain-model/rounding> a linkml:SlotDefinition ;
	linkml:description "Defines rounding rules and precision to be used in the rounding of a number." , "Optional rules that define how the calculated time should be rounded after the offset has been applied." , "Specifies the rounding rules for settling in that currency." , "THe final rate rounding to be applied." , "The rounding methodology applicable to the Delivery Amount and the Return Amount in terms of nearest integral multiple of Base Currency units." , "The rounding rules applicable to the floating rate index in case of a calculation." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CollateralRounding> , <https://w3id.org/lmodel/common-domain-model/Rounding> , <https://w3id.org/lmodel/common-domain-model/TimeRounding> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/roundingDirection> a linkml:SlotDefinition ;
	linkml:description "Specifies the rounding rule as up, down, or nearest." , "The direction in which rounding is performed (e.g., up, down, or to the nearest value)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RoundingDirectionEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/roundingFrequency> a linkml:SlotDefinition ;
	linkml:description "Specifies when/how often is rounding applied?" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RoundingFrequencyEnum> .
<https://w3id.org/lmodel/common-domain-model/rounding__precision> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
	skos:prefLabel "precision" ;
	linkml:description "Specifies the rounding precision in terms of a number of decimal places when the number is evaluated in decimal form (not percentage), e.g. 0.09876543 rounded to the nearest 5 decimal places is 0.0987654." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Rounding> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Rounding> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/precision"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/rounding__roundingDirection> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
	skos:prefLabel "roundingDirection" ;
	linkml:description "Specifies the rounding rule as up, down, or nearest." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Rounding> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Rounding> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/RoundingDirectionEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/roundingDirection"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/safekeepingPeriodExpiry> a linkml:SlotDefinition ;
	linkml:description "The parties' election to specify the number of days prior to the end of the safekeeping period (Clearstream CTA) purpose of qualifying the CE/CME End Date, in the case where advance notice is given." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CustomisableOffset> .
<https://w3id.org/lmodel/common-domain-model/scale> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2143 ;
	linkml:description "Specifies the credit rating scale, with a typical distinction between short term, long term. FpML doesn't specify a default scheme, which is hence not specified as an enumeration as part of the CDM." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/common-domain-model/schedule> a linkml:SlotDefinition ;
	linkml:description "A derivative schedule." , "A schedule for generating averaging observation dates." , "Allows the full representation of a payout by defining a set of schedule periods. It supports standard schedule customization by expressing all the dates, quantities, and pricing data in a non-parametric way." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AveragingSchedule> , <https://w3id.org/lmodel/common-domain-model/CalculationSchedule> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/scheduleBounds> a linkml:SlotDefinition ;
	linkml:description "The first and last dates of a schedule. This can be used to restrict the range of values in a reference series of dates." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DateRange> .
<https://w3id.org/lmodel/common-domain-model/scheduleGridIMExposure> a linkml:SlotDefinition ;
	linkml:description "Represents Initial Margin (IM) exposure derived from schedule or Grid calculation." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Exposure> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/schedulePeriod> a linkml:SlotDefinition ;
