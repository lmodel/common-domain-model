<https://w3id.org/lmodel/common-domain-model/OtherAgreementTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common> ;
    skos:exactMatch "common_domain_model:OtherAgreementTerms"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: LegalDocumentNotSpecified — if isSpecified = False then legalDocument is absent",
        "Rosetta condition: LegalDocumentSpecified — if isSpecified = True then legalDocument exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isSpecified> ] ;
            linkml:description "A data rule to enforce that the related legal agreement should be referenced if it is deemed as specified as part of the boolean attribute." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/legalDocument> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isSpecified> ] ;
            linkml:description "A data rule to enforce that the related legal agreement should not be referenced if it is deemed as not specified as part of the boolean attribute." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/legalDocument> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/OtherAgreementTerms"^^xsd:anyURI ;
    linkml:description "A class to specify a related legal agreement. For example, ISDA 2016 Credit Support Annex for Initial Margin, paragraph 13, General Principles, (s): Other CSA and Japanese Law CSA (VM). | ISDA 2016 Credit Support Annex for Variation Margin, paragraph 13, (o): Other CSA." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/isSpecified>,
        <https://w3id.org/lmodel/common-domain-model/legalDocument> .

