	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/UnderlierSubstitutionProvision> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/UnderlierSubstitutionProvision> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/disputingParty"^^xsd:anyURI .
