<https://w3id.org/lmodel/common-domain-model/numberOfDataSeries> a linkml:SlotDefinition ;
	linkml:description "Number of data series, normal market practice is that correlation data sets are drawn from geographic market areas, such as America, Europe and Asia Pacific, each of these geographic areas will have its own data series to avoid contagion." ;
	linkml:minimum_value "1"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/numberOfObservationDates> a linkml:SlotDefinition ;
	linkml:description "The number of observation dates between observation start date and observation end date." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> .
<https://w3id.org/lmodel/common-domain-model/numberOfOriginals> a linkml:SlotDefinition ;
	linkml:description "The number of original documents." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/numberOfRatingAgencies> a linkml:SlotDefinition ;
	linkml:description "Defines the number of Rating Agencies that the Party must be rated by." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NumberOfRatingAgenciesEnum> .
<https://w3id.org/lmodel/common-domain-model/numberOfSubstitutionsAllowed> a linkml:SlotDefinition ;
