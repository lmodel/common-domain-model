<https://w3id.org/lmodel/common-domain-model/AvailableInventoryRecord> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_position> ;
    skos:closeMatch "fpml_5_10:AvailableInventoryRecord"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AvailableInventoryRecord"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_position"^^xsd:anyURI ;
    skos:note "Rosetta condition: InterestRate — if interestRate exists then interestRate -> priceType = PriceTypeEnum -> InterestRate",
        "Rosetta condition: ValidPartyRole — IsValidPartyRole( partyRole, [PartyRoleEnum -> AgentLender, PartyRoleEnum -> BeneficialOwner, PartyRoleEnum -> Custodian, PartyRoleEnum -> Lender] )" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AvailableInventoryRecord"^^xsd:anyURI ;
    linkml:description "An individual piece of available inventory. This represents a single security and its associated criteria. The criteria are used to describe any restrictions on the securities." ;
