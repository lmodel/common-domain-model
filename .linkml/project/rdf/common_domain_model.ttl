    linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/periodSkip"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/portfolioIdentifier> a linkml:SlotDefinition ;
