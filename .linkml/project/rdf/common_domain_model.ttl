<https://w3id.org/lmodel/common-domain-model/failureToPayInterest> a linkml:SlotDefinition ;
	linkml:description "A credit event. Corresponds to the failure by the Reference Entity to pay an expected interest amount or the payment of an actual interest amount that is less than the expected interest amount. ISDA 2003 Term: Failure to Pay Interest." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/failureToPayPrincipal> a linkml:SlotDefinition ;
	linkml:description "A credit event. Corresponds to the failure by the Reference Entity to pay an expected principal amount or the payment of an actual principal amount that is less than the expected principal amount. ISDA 2003 Term: Failure to Pay Principal." , "A floating rate payment event. Corresponds to the failure by the Reference Entity to pay an expected principal amount or the payment of an actual principal amount that is less than the expected principal amount. ISDA 2003 Term: Failure to Pay Principal." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/failureToPay__applicable> a linkml:SlotDefinition ;
