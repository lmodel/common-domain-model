    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/floatingRateDefinition"^^xsd:anyURI ;
    linkml:description "The floating rate reset information for the calculation period." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriod> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CalculationPeriod> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/floatingRateDefinition"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/floorRate> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/floorRate"^^xsd:anyURI ;
    linkml:description "The floor rate, if any, which applies to the floating rate for the calculation period. The floor rate (strike) is only required where the floating rate on a swap stream is floored at a certain strike level. The floor rate is assumed to be exclusive of any spread and is a per annum rate, expressed as a decimal. The floor rate of 5% would be represented as 0.05." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateProcessingParameters> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FloatingRateProcessingParameters> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Strike> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/floorRate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/forecastRate> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/forecastRate"^^xsd:anyURI ;
    linkml:description "The value representing the forecast rate used to calculate the forecast future value of the accrual period.A value of 1% should be represented as 0.01." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriod>,
        <https://w3id.org/lmodel/common-domain-model/RateObservation> ;
