    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: PositiveCalculationPeriodNumberOfDays — calculationPeriodNumberOfDays >= 0" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML specifies calculationPeriodNumberOfDays as a positiveInteger." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/calculationPeriodNumberOfDays> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FutureValueAmount"^^xsd:anyURI ;
    linkml:description "A class defining a currency and a future value date." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FutureValueAmount_currency>,
        <https://w3id.org/lmodel/common-domain-model/FutureValueAmount_quantity>,
        <https://w3id.org/lmodel/common-domain-model/calculationPeriodNumberOfDays>,
        <https://w3id.org/lmodel/common-domain-model/valueDate> .

<https://w3id.org/lmodel/common-domain-model/IndexTransitionInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:IndexTransitionInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: PriceQuantity — priceQuantity -> price -> priceType contains PriceTypeEnum -> InterestRate and priceQuantity -> observable -> Index -> InterestRateIndex exists and priceQuantity -> quantity is absent",
        "Rosetta func: Create_IndexTransitionTermsChange — Function specification to create a terms change that contains changes to the floating rate indexes and adds an adjustment spread to any existing spread." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_IndexTransitionTermsChange\",\"description\":\"Function specification to create a terms change that contains changes to the floating rate indexes and adds an adjustment spread to any existing spread.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"IndexTransitionInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"termsChange\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/IndexTransitionInstruction"^^xsd:anyURI ;
    linkml:description "Defines the information needed to create a Index Transition Business Event." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/IndexTransitionInstruction_effectiveDate>,
        <https://w3id.org/lmodel/common-domain-model/IndexTransitionInstruction_priceQuantity>,
        <https://w3id.org/lmodel/common-domain-model/cashTransfer> .

<https://w3id.org/lmodel/common-domain-model/InterestAmountApplication> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:exactMatch "common_domain_model:InterestAmountApplication"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/InterestAmountApplication"^^xsd:anyURI ;
    linkml:description "A class to specify the application of Interest Amount with respect to the Delivery Amount and the Return Amount." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/InterestAmountApplication_deliveryAmount>,
        <https://w3id.org/lmodel/common-domain-model/InterestAmountApplication_returnAmount> .

<https://w3id.org/lmodel/common-domain-model/LegacyResolutionAlternative> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:LegacyResolutionAlternative"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdditionalLanguage — if resolutionAlternative is absent then additionalLanguage exists",
        "Rosetta condition: SplitDifferenceAmount — if resolutionAlternative = LegacyResolutionAlternativeEnum -> SplitDifference then amount exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/resolutionAlternative> ] ;
            linkml:description "If the resolution is to split the difference, then the amount concerned should be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/amount> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/resolutionAlternative> ] ;
            linkml:description "If no resolution alternative procedure is defined, additional language must be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/LegacyResolutionAlternative"^^xsd:anyURI ;
    linkml:description "Alternative procedures to those in the pre-print for resolving collateral related disputes." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/LegacyResolutionAlternative_additionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/LegacyResolutionAlternative_amount>,
        <https://w3id.org/lmodel/common-domain-model/resolutionAlternative> .

<https://w3id.org/lmodel/common-domain-model/LegalAgreement> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common> ;
    skos:exactMatch "common_domain_model:LegalAgreement"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: AgreementType — required choice agreementTerms, umbrellaAgreement",
        "Rosetta condition: AgreementVerification — if agreementTerms -> agreement -> securityAgreementElections exists then legalAgreementIdentification -> agreementName -> agreementType = LegalAgreementTypeEnum -> SecurityAgreement else if agreementTerms -> agreement -> creditSupportAgreementElections exists then legalAgreementIdentification -> agreementName -> creditSupportAgreementType = CreditSupportAgreementTypeEnum -> CreditSupportAnnex or legalAgreementIdentification -> agreementName -> creditSupportAgreementType = CreditSupportAgreementTypeEnum -> CreditSupportDeed else if agreementTerms -> agreement -> collateralTransferAgreementElections exists then legalAgreementIdentification -> agreementName -> creditSupportAgreementType = CreditSupportAgreementTypeEnum -> CollateralTransferAgreement else if agreementTerms -> agreement -> masterAgreementSchedule exists then legalAgreementIdentification -> agreementName -> agreementType = LegalAgreementTypeEnum -> MasterAgreement",
        "Rosetta condition: ConsistentlyExecutedAgreements — if relatedAgreements exists and agreementDate exists then relatedAgreements -> agreementDate exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Either the Agreement Terms (i.e. a bilateral or one way agreement) or an Umbrella Agreement (i.e. an agreement where multiple parties and variations of terms are described within a single document but represent multiple agreements for operational purposes) should be included, but not both." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/agreementTerms> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/umbrellaAgreement> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/LegalAgreement"^^xsd:anyURI ;
    linkml:description "The specification of a legal agreement between two parties, being negotiated or having been executed. This includes the baseline information and the optional specialised elections" ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/LegalAgreementBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/LegalAgreementBase_effectiveDate>,
        <https://w3id.org/lmodel/common-domain-model/LegalAgreementBase_identifier>,
        <https://w3id.org/lmodel/common-domain-model/agreementDate>,
        <https://w3id.org/lmodel/common-domain-model/agreementTerms>,
        <https://w3id.org/lmodel/common-domain-model/attachment>,
        <https://w3id.org/lmodel/common-domain-model/contractualParty>,
        <https://w3id.org/lmodel/common-domain-model/legalAgreementIdentification>,
        <https://w3id.org/lmodel/common-domain-model/otherParty>,
        <https://w3id.org/lmodel/common-domain-model/relatedAgreements>,
        <https://w3id.org/lmodel/common-domain-model/umbrellaAgreement> ;
    linkml:tree_root true .

<https://w3id.org/lmodel/common-domain-model/MoneyRange> a linkml:ClassDefinition ;
