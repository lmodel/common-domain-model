            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The identification of the party to which the PartyCustomisedWorkflow pertains to can be done through either a party reference or the party name." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/partyName> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/partyReference> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PartyCustomisedWorkflow"^^xsd:anyURI ;
    linkml:description "A class to specify a party-related, non-standardized data in a generic form." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PartyCustomisedWorkflow_partyReference>,
        <https://w3id.org/lmodel/common-domain-model/customisedWorkflow>,
        <https://w3id.org/lmodel/common-domain-model/partyName> .

<https://w3id.org/lmodel/common-domain-model/PartyIdentifier> a linkml:ClassDefinition ;
