<https://w3id.org/lmodel/common-domain-model/TransferSettlementTiming> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:TransferSettlementTiming"^^xsd:anyURI ;
