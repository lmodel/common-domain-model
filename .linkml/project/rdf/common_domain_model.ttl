    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CorrelationReturnTerms> ;
    linkml:minimum_value "0"^^<https://w3id.org/linkml/@id> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CorrelationReturnTerms> ;
