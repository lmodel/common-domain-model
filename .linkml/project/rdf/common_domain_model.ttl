<https://w3id.org/lmodel/common-domain-model/ExecutionLanguage> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ExecutionLanguage"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: NumberOfOriginals — if standardLanguage = False then numberOfOriginals is absent",
        "Rosetta condition: OtherLanguage — if standardLanguage = False then otherLanguage exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/standardLanguage> ] ;
            linkml:description "A data rule to enforce that the number of original documents should only be specified when standard execution language is used." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/numberOfOriginals> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/standardLanguage> ] ;
            linkml:description "A data rule to enforce that bespoke execution language must be included if non-standard execution language is specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/otherLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExecutionLanguage"^^xsd:anyURI ;
    linkml:description "A class to specify execution language terms of a Security Agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/numberOfOriginals>,
        <https://w3id.org/lmodel/common-domain-model/otherLanguage>,
        <https://w3id.org/lmodel/common-domain-model/standardLanguage> .

