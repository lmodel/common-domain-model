                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/issuerType> ] ;
            linkml:description "QuasiGovernmentSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/quasiGovernmentType> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: issuerType <> SpecialPurposeVehicle" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/issuerType> ] ;
            linkml:description "SpecialPurposeVehicleSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/specialPurposeVehicleType> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CollateralIssuerType"^^xsd:anyURI ;
    linkml:description "Represents a class to allow specification of the type of entity issuing the collateral." ;
    linkml:slot_usage [ ] ;
