    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculationAndTimingInitialMargin"^^xsd:anyURI ;
    linkml:description "Specification of the Calculation, Valuation and Timing terms specific to the Initial Margin Credit Support Annex." ;
