	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/periodMultiplier"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/version> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/common_domain_model_keys"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/version"^^xsd:anyURI ;
