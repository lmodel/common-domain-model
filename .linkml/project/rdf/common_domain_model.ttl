    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ResetDates> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/RelativeDateOffset> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fixingDates"^^xsd:anyURI .

