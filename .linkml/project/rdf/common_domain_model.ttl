<https://w3id.org/lmodel/common-domain-model/minimumTransferAmount> a linkml:SlotDefinition ;
    skos:editorialNote "ISDA CSA_English_1995",
        "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(d)(vi)(C)\" name \"Rounding\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(c)(vi)(C)\" name \"Rounding\"",
        "ISDA CSA_NewYork_1994",
        "ISDA CSA_VM_English_2016",
        "ISDA CSA_VM_NewYork_2016",
        "ISDA CSD_English_1995",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(c)(vi)(C)\" name \"Rounding\"" ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/minimumTransferAmount"^^xsd:anyURI ;
    linkml:description "Represents the threshold specified in the agreement below which collateral need not be delivered, and represents the smallest incremental value of exposure that must be reached before the parties are obliged to transfer collateral." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditSupportObligationsBase> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditSupportObligationsBase> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/MinimumTransferAmount> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/minimumTransferAmount"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/paymentDate> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
