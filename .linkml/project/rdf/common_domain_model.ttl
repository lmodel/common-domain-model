    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SimmVersion> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/SimmVersion> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/partyVersion"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/payer> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
