<https://w3id.org/lmodel/common-domain-model/party> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/party"^^xsd:anyURI ;
    linkml:description "Specifies whether the debt security is redeemed at the election of the Issuer/Holder." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AdditionalObligations>,
        <https://w3id.org/lmodel/common-domain-model/AdditionalRepresentationElection>,
        <https://w3id.org/lmodel/common-domain-model/AggregationParameters>,
        <https://w3id.org/lmodel/common-domain-model/AutomaticEarlyTerminationElection>,
        <https://w3id.org/lmodel/common-domain-model/AvailableInventory>,
        <https://w3id.org/lmodel/common-domain-model/CalculationAgentTerms>,
        <https://w3id.org/lmodel/common-domain-model/CalculationCurrencyElection>,
        <https://w3id.org/lmodel/common-domain-model/CollateralManagementAgreementElection>,
        <https://w3id.org/lmodel/common-domain-model/ControlAgreementElections>,
        <https://w3id.org/lmodel/common-domain-model/ControlAgreementNecEventElection>,
        <https://w3id.org/lmodel/common-domain-model/CounterpartyPosition>,
        <https://w3id.org/lmodel/common-domain-model/CreditSupportDocumentElection>,
        <https://w3id.org/lmodel/common-domain-model/CreditSupportProviderElection>,
        <https://w3id.org/lmodel/common-domain-model/CustodianElection>,
        <https://w3id.org/lmodel/common-domain-model/CustodianRiskElection>,
        <https://w3id.org/lmodel/common-domain-model/DebtRedemption>,
        <https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection>,
        <https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification>,
        <https://w3id.org/lmodel/common-domain-model/EventsOfDefaultElection>,
        <https://w3id.org/lmodel/common-domain-model/FrenchLawAddendumElection>,
        <https://w3id.org/lmodel/common-domain-model/HoldingAndUsingPostedCollateralElection>,
