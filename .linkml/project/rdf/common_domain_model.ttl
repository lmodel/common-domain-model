    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/varyingNotionalFixingDates"^^xsd:anyURI ;
    linkml:description "The dates on which spot currency exchange rates are observed for purposes of determining the varying notional currency amount that will apply to a calculation period." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FxLinkedNotionalSchedule> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FxLinkedNotionalSchedule> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/RelativeDateOffset> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/varyingNotionalFixingDates"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/varyingNotionalInterimExchangePaymentDates> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/varyingNotionalInterimExchangePaymentDates"^^xsd:anyURI ;
    linkml:description "The dates on which interim exchanges of notional are paid. Interim exchanges will arise as a result of changes in the spot currency exchange amount or changes in the constant notional schedule (e.g. amortisation)." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FxLinkedNotionalSchedule> ;
    linkml:inlined true ;
