<https://w3id.org/lmodel/common-domain-model/resourceType> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1994 ;
	linkml:description "A description of the type of the resource, e.g. a confirmation." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ResourceTypeEnum> .
<https://w3id.org/lmodel/common-domain-model/resource__comments> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
	skos:prefLabel "comments" ;
	linkml:description "Any additional comments that are deemed necessary. For example, which software version is required to open the document? Or, how does this resource relate to the others for this event?" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Resource> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/Resource> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/comments"^^xsd:anyURI .
