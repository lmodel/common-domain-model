<https://w3id.org/lmodel/common-domain-model/AdjustmentFactorCalculationTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:closeMatch "fpml_5_10:AdjustmentFactorCalculationTerms"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AdjustmentFactorCalculationTerms"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: DividendObservation — if dividendObservation exists then dividendObservation -> priceType = PriceTypeEnum -> Dividend",
        "Rosetta condition: ShareRatio — optional choice shareForShareRatio, shareForRightsRatio",
        "Rosetta condition: SpinOffOrMergerOrAccrual — optional choice spinOff, merger, accrualFactor" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "ShareRatio" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/shareForShareRatio> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/shareForRightsRatio> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "SpinOffOrMergerOrAccrual" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/spinOff> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/merger> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/accrualFactor> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdjustmentFactorCalculationTerms"^^xsd:anyURI ;
    linkml:description "Describes the input terms involved in the calculation of the adjustment factor applied to the price of the underlier impacted by a Corporate Action." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/accrualFactor>,
        <https://w3id.org/lmodel/common-domain-model/bespokeCalculationFormula>,
        <https://w3id.org/lmodel/common-domain-model/dividendObservation>,
        <https://w3id.org/lmodel/common-domain-model/dividendRatio>,
        <https://w3id.org/lmodel/common-domain-model/lastFixingPriceBeforeAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/merger>,
        <https://w3id.org/lmodel/common-domain-model/rightsSubscriptionPrice>,
        <https://w3id.org/lmodel/common-domain-model/shareForRightsRatio>,
        <https://w3id.org/lmodel/common-domain-model/shareForShareRatio>,
        <https://w3id.org/lmodel/common-domain-model/spinOff> .

<https://w3id.org/lmodel/common-domain-model/AgencyRatingCriteria> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:closeMatch "fpml_5_10:AgencyRatingCriteria"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AgencyRatingCriteria"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta condition: ReferenceAgency — if mismatchResolution = CreditNotationMismatchResolutionEnum -> ReferenceAgency then referenceAgency exists",
        "Rosetta func: CheckAgencyRating" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/mismatchResolution> ] ;
            linkml:description "If the mismatch resolution is ReferenceAgency, ensure that the reference agency is specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/referenceAgency> ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"CheckAgencyRating\",\"inputs\":[{\"name\":\"agencyRatings\",\"type\":\"AgencyRatingCriteria\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AgencyRatingCriteria"^^xsd:anyURI ;
    linkml:description "Represents a class to specify a credit notation." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AgencyRatingCriteria_creditNotation>,
        <https://w3id.org/lmodel/common-domain-model/AgencyRatingCriteria_mismatchResolution>,
        <https://w3id.org/lmodel/common-domain-model/AgencyRatingCriteria_referenceAgency>,
        <https://w3id.org/lmodel/common-domain-model/boundary> .

<https://w3id.org/lmodel/common-domain-model/FeaturePayment> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_event> ;
    skos:exactMatch "common_domain_model:FeaturePayment"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    skos:note "Rosetta condition: Amount — if amount exists then amount >= 0.0",
        "Rosetta condition: FeaturePaymentChoice — required choice levelPercentage, amount" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/amount> ] ;
            linkml:description " The amount attribute is specified in FpML as non-negative decimal." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/amount> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description " Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/amount> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/levelPercentage> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FeaturePayment"^^xsd:anyURI ;
    linkml:description "Payment made following trigger occurrence." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FeaturePayment_amount>,
        <https://w3id.org/lmodel/common-domain-model/FeaturePayment_currency>,
        <https://w3id.org/lmodel/common-domain-model/FeaturePayment_payerReceiver>,
        <https://w3id.org/lmodel/common-domain-model/FeaturePayment_time>,
        <https://w3id.org/lmodel/common-domain-model/levelPercentage>,
        <https://w3id.org/lmodel/common-domain-model/paymentDate> .

<https://w3id.org/lmodel/common-domain-model/MasterAgreement> a linkml:ClassDefinition ;
