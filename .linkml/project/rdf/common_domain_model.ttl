    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    skos:note "Rosetta func: FilterPartyRole — Filters the list of partyRoles based on the provided partyRoleEnum." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"FilterPartyRole\",\"description\":\"Filters the list of partyRoles based on the provided partyRoleEnum.\",\"inputs\":[{\"name\":\"partyRoles\",\"type\":\"PartyRole\",\"cardinality\":\"0..*\"},{\"name\":\"partyRoleEnum\",\"type\":\"PartyRoleEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"filteredPartyRoles\",\"type\":\"PartyRole\",\"cardinality\":\"0..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PartyRole"^^xsd:anyURI ;
