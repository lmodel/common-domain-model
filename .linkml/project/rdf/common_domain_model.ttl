    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CollateralTransferAgreementElections> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/OtherAgreements> ;
