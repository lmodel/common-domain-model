    linkml:is_a <https://w3id.org/lmodel/common-domain-model/EquityMasterConfirmation> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/equityCashSettlementDates>,
        <https://w3id.org/lmodel/common-domain-model/linearInterpolationElection>,
        <https://w3id.org/lmodel/common-domain-model/pricingMethodElection>,
        <https://w3id.org/lmodel/common-domain-model/settlementTerms>,
        <https://w3id.org/lmodel/common-domain-model/typeOfSwapElection>,
        <https://w3id.org/lmodel/common-domain-model/valuationDates> .

<https://w3id.org/lmodel/common-domain-model/EscrowArrangement> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms> ;
    rdfs:seeAlso "isda:FXandCurrencyOptionsDefintions_1998"^^xsd:anyURI ;
    skos:editorialNote "ISDA FXandCurrencyOptionsDefintions_1998 section \"5.2.(c).(iv)\"" ;
    skos:exactMatch "common_domain_model:EscrowArrangement"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
    skos:note "Rosetta condition: SettlementPostponementExistence — if escrowArrangementIsApplicable = False then maximumDaysOfDisruption is absent and if escrowArrangementIsApplicable = True then maximumDaysOfDisruption exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/escrowArrangementIsApplicable> ] ;
            linkml:description "SettlementPostponementExistence" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumDaysOfDisruption> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EscrowArrangement"^^xsd:anyURI ;
    linkml:description "Refers to the segregation deposit procedure parties may want to commmit into during the time a Disruption Event is effective" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/bespokeEscrowArrangements>,
        <https://w3id.org/lmodel/common-domain-model/escrowArrangementIsApplicable>,
        <https://w3id.org/lmodel/common-domain-model/maximumDaysOfDisruption> .

<https://w3id.org/lmodel/common-domain-model/EventCurrency> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms> ;
    rdfs:seeAlso "isda:FXandCurrencyOptionsDefintions_1998"^^xsd:anyURI ;
