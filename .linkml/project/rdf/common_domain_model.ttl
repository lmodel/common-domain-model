<https://w3id.org/lmodel/common-domain-model/PledgeeRepresentativeRider> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:PledgeeRepresentativeRider"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: RepresentativeEventTerms — if representativeEvent = ExceptionEnum -> Other then representativeEventTerms exists",
        "Rosetta condition: RepresentativeParty — if isApplicable = True then party exists and representativeTerms exists and representativeEvent exists and representativeEndDate exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isApplicable> ] ;
            linkml:description "A data rule to enforce that representative terms and a represented party are specified when representative provisions are applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/party>,
                        <https://w3id.org/lmodel/common-domain-model/representativeEndDate>,
                        <https://w3id.org/lmodel/common-domain-model/representativeEvent>,
                        <https://w3id.org/lmodel/common-domain-model/representativeTerms> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/representativeEvent> ] ;
            linkml:description "A data rule to enforce that representative event terms are specified when applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/representativeEventTerms> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PledgeeRepresentativeRider"^^xsd:anyURI ;
    linkml:description "The terms of the Rider for the ISDA Euroclear 2019 Collateral Transfer Agreement with respect to the use of a Pledgee Representative attached to this Agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PledgeeRepresentativeRider_isApplicable>,
        <https://w3id.org/lmodel/common-domain-model/PledgeeRepresentativeRider_party>,
        <https://w3id.org/lmodel/common-domain-model/representativeEndDate>,
        <https://w3id.org/lmodel/common-domain-model/representativeEvent>,
        <https://w3id.org/lmodel/common-domain-model/representativeEventTerms>,
        <https://w3id.org/lmodel/common-domain-model/representativeTerms> .

<https://w3id.org/lmodel/common-domain-model/PositionBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_position> ;
    skos:exactMatch "common_domain_model:PositionBase"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_position"^^xsd:anyURI ;
