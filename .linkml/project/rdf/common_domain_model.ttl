<https://w3id.org/lmodel/common-domain-model/SpecifiedEntities> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isda> ;
    skos:exactMatch "common_domain_model:SpecifiedEntities"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isda"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SpecifiedEntities"^^xsd:anyURI ;
