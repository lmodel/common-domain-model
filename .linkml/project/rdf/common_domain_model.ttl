	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/principalPayment"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/payoutBase__settlementTerms> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "settlementTerms" ;
	linkml:description "Each payout leg must specifies its settlement terms, including the delivery type (i.e. cash vs physical, and their respective terms), the transfer type (DvP etc.) and settlement date, if any." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PayoutBase> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PayoutBase> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementTerms> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/settlementTerms"^^xsd:anyURI .
