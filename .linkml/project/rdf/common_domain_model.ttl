	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/amountUtilized"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicable__clipSize> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "clipSize" ;
	linkml:description "This element is required in FpML, optional in CDM for the purpose of accommodating the CME data representation while making reference to the FpML one." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/clipSize"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicable__currency> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "currency" ;
	linkml:annotations _:c14n514 ;
	linkml:description "The currency in which the applicable limit is denominated. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/currency"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicable__limitType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "limitType" ;
	linkml:annotations _:c14n204 ;
	linkml:description "Standard code to indicate which type of credit line is being referred to - i.e. IM, DV01, PV01, CS01, Notional, Clip Size, Notional, maximumOrderQuantity." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CreditLimitTypeEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/limitType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicable__utilization> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "utilization" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CreditLimitUtilisation> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/utilization"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/limitApplicable__velocity> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
	skos:prefLabel "velocity" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/LimitApplicable> ;
