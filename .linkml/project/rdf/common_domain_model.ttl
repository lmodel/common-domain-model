    linkml:equals_string "True" ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ThresholdMinimumTransferAmountBase> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/zeroEvent"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/AccrualFactorCalculationTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:closeMatch "fpml_5_10:AccrualFactorCalculationTerms"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AccrualFactorCalculationTerms"^^xsd:anyURI ;
