<https://w3id.org/lmodel/common-domain-model/PeriodicDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:exactMatch "common_domain_model:PeriodicDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PeriodicDates"^^xsd:anyURI ;
    linkml:description "A class for specifying a calculation period schedule." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PeriodicDates_dayType>,
        <https://w3id.org/lmodel/common-domain-model/PeriodicDates_endDate>,
