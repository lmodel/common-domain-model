    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/auctionDate>,
        <https://w3id.org/lmodel/common-domain-model/creditEventType>,
        <https://w3id.org/lmodel/common-domain-model/eventDeterminationDate>,
        <https://w3id.org/lmodel/common-domain-model/finalPrice>,
        <https://w3id.org/lmodel/common-domain-model/publiclyAvailableInformation>,
        <https://w3id.org/lmodel/common-domain-model/recoveryPercent>,
        <https://w3id.org/lmodel/common-domain-model/referenceInformation> .

<https://w3id.org/lmodel/common-domain-model/EarlyTerminationEvent> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:EarlyTerminationEvent"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: FpML_ird_39 — adjustedExerciseDate <= adjustedEarlyTerminationDate",
        "Rosetta condition: FpML_ird_40 — adjustedExerciseDate <= adjustedCashSettlementValuationDate",
        "Rosetta condition: FpML_ird_41 — adjustedCashSettlementValuationDate <= adjustedCashSettlementPaymentDate" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: adjustedCashSettlementValuationDate <= adjustedCashSettlementPaymentDate" ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule ird-41 - AdjustedCashSettlementValuationDate must be before or equal to adjustedCashSettlementPaymentDate." ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: adjustedExerciseDate <= adjustedEarlyTerminationDate" ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule ird-39 - AdjustedExerciseDate must be before or equal to adjustedEarlyTerminationDate." ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta comparison: adjustedExerciseDate <= adjustedCashSettlementValuationDate" ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FpML validation rule ird-40 - AdjustedExerciseDate must be before or equal to adjustedCashSettlementValuationDate." ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EarlyTerminationEvent"^^xsd:anyURI ;
    linkml:description "A data to:  define the adjusted dates associated with an early termination provision." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/EarlyTerminationEvent_adjustedCashSettlementPaymentDate>,
        <https://w3id.org/lmodel/common-domain-model/EarlyTerminationEvent_adjustedCashSettlementValuationDate>,
        <https://w3id.org/lmodel/common-domain-model/EarlyTerminationEvent_adjustedExerciseDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedEarlyTerminationDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedExerciseFeePaymentDate> .

<https://w3id.org/lmodel/common-domain-model/EligibilityQuery> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:exactMatch "common_domain_model:EligibilityQuery"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta func: CheckAgencyRating",
        "Rosetta func: CheckAssetType",
        "Rosetta func: CheckCountryOfOrigin",
        "Rosetta func: CheckCriteria — This function takes a single criteria and evaluates it against the criteria.  This function handles the recursive use of AND and OR logic.",
        "Rosetta func: CheckDebtType",
        "Rosetta func: CheckDenominatedCurrency",
        "Rosetta func: CheckEligibilityByDetails — This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.",
        "Rosetta func: CheckIssuerName",
        "Rosetta func: CheckIssuerType",
        "Rosetta func: CheckMaturity" ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"CheckEligibilityByDetails\",\"description\":\"This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.\",\"inputs\":[{\"name\":\"specification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"eligibilityResult\",\"type\":\"CheckEligibilityResult\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckCriteria\",\"description\":\"This function takes a single criteria and evaluates it against the criteria.  This function handles the recursive use of AND and OR logic.\",\"inputs\":[{\"name\":\"inputCriteria\",\"type\":\"CollateralCriteria\",\"cardinality\":\"1..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEligible\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckCountryOfOrigin\",\"inputs\":[{\"name\":\"countryOfOrigin\",\"type\":\"ISOCountryCodeEnum\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckAgencyRating\",\"inputs\":[{\"name\":\"agencyRatings\",\"type\":\"AgencyRatingCriteria\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckAssetType\",\"inputs\":[{\"name\":\"collateralAssetTypes\",\"type\":\"AssetType\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckDebtType\",\"inputs\":[{\"name\":\"collateralDebtTypes\",\"type\":\"DebtType\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckDenominatedCurrency\",\"inputs\":[{\"name\":\"denominatedCurrency\",\"type\":\"CurrencyCodeEnum\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckMaturity\",\"inputs\":[{\"name\":\"maturityRange\",\"type\":\"AssetMaturity\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckIssuerName\",\"inputs\":[{\"name\":\"issuerName\",\"type\":\"IssuerName\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckIssuerType\",\"inputs\":[{\"name\":\"issuerType\",\"type\":\"CollateralIssuerType\",\"cardinality\":\"0..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"isEqual\",\"type\":\"boolean\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EligibilityQuery"^^xsd:anyURI ;
    linkml:description "Query to check against an EligibleCollateralSpecification" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/EligibilityQuery_issuerType>,
        <https://w3id.org/lmodel/common-domain-model/agencyRating>,
        <https://w3id.org/lmodel/common-domain-model/assetCountryOfOrigin>,
        <https://w3id.org/lmodel/common-domain-model/collateralAssetType>,
        <https://w3id.org/lmodel/common-domain-model/denominatedCurrency>,
        <https://w3id.org/lmodel/common-domain-model/issuerName>,
        <https://w3id.org/lmodel/common-domain-model/maturity> .

<https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:FloatingRateDefinition"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: FloatingRateMultiplier — if floatingRateMultiplier exists then floatingRateMultiplier <> 1" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/floatingRateMultiplier> ] ;
            linkml:description "FpML specifies that the floatingRateMultiplier should only be included if different from 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/floatingRateMultiplier> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition"^^xsd:anyURI ;
    linkml:description "A data defining:  parameters associated with a floating rate reset. This data forms:  part of the cashflows representation of a stream." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition_calculatedRate>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateDefinition_spread>,
        <https://w3id.org/lmodel/common-domain-model/capRate>,
        <https://w3id.org/lmodel/common-domain-model/floatingRateMultiplier>,
        <https://w3id.org/lmodel/common-domain-model/floorRate>,
        <https://w3id.org/lmodel/common-domain-model/rateObservation> .

<https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master> ;
    skos:exactMatch "common_domain_model:MasterAgreementVariableSet"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master"^^xsd:anyURI ;
    skos:note "Rosetta condition: NameMustExist — if name exists then value exists",
        "Rosetta condition: ValueMustExist — if value exists then name exists",
        "Rosetta condition: VariableSetExists — if variableSet exists then name is absent and value is absent",
        "Rosetta condition: VariableSetNesting — if variableSet -> variableSet exists then variableSet -> variableSet -> variableSet is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/name> ] ;
            linkml:description "If we have a name then we must also have a value." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ] ;
            linkml:description "If we have a value then we must also have a name." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/name> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/variableSet> ] ;
            linkml:description "If we have a variableSet then we must not have any name/value pairs at this level." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/name>,
                        <https://w3id.org/lmodel/common-domain-model/value> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet"^^xsd:anyURI ;
    linkml:description "Defines a type where additional variables associated to clauses and their variants can be described." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet_name>,
        <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet_value>,
        <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet_variableSet> .

<https://w3id.org/lmodel/common-domain-model/ReferenceInformation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:ReferenceInformation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: ReferenceInformationChoice — required choice referenceObligation, noReferenceObligation , unknownReferenceObligation" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/referenceObligation> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/noReferenceObligation> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/unknownReferenceObligation> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ReferenceInformation"^^xsd:anyURI ;
    linkml:description "A class specifying the Credit Default Swap Reference Information." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/allGuarantees>,
        <https://w3id.org/lmodel/common-domain-model/noReferenceObligation>,
        <https://w3id.org/lmodel/common-domain-model/referenceEntity>,
        <https://w3id.org/lmodel/common-domain-model/referenceObligation>,
        <https://w3id.org/lmodel/common-domain-model/referencePolicy>,
        <https://w3id.org/lmodel/common-domain-model/referencePrice>,
        <https://w3id.org/lmodel/common-domain-model/securedList>,
        <https://w3id.org/lmodel/common-domain-model/unknownReferenceObligation> .

<https://w3id.org/lmodel/common-domain-model/SpecificInconvertibility> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms> ;
    skos:exactMatch "common_domain_model:SpecificInconvertibility"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
    skos:note "Rosetta condition: SettlementPostponementExistence — if localSubstituteProvisionType = FxSubstitutionProvisionTypeEnum -> LocalCurrencySubstitute then maximumDaysOfDisruption exists",
        "Rosetta condition: SubstituteTermsChoice — if localSubstituteProvisionType exists then nonDeliverableSubstitute is absent or if nonDeliverableSubstitute exists then localSubstituteProvisionType is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/localSubstituteProvisionType> ] ;
            linkml:description "SettlementPostponementExistence" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumDaysOfDisruption> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/localSubstituteProvisionType> ] ;
            linkml:description "SubstituteTermsChoice" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nonDeliverableSubstitute> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SpecificInconvertibility"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SpecificInconvertibility_escrowArrangement>,
        <https://w3id.org/lmodel/common-domain-model/SpecificInconvertibility_maximumDaysOfDisruption>,
        <https://w3id.org/lmodel/common-domain-model/localSubstituteProvisionType>,
        <https://w3id.org/lmodel/common-domain-model/minimumAmount>,
        <https://w3id.org/lmodel/common-domain-model/nonDeliverableSubstitute>,
        <https://w3id.org/lmodel/common-domain-model/relevantClass>,
        <https://w3id.org/lmodel/common-domain-model/specificInconvertibilityIsApplicable> .

<https://w3id.org/lmodel/common-domain-model/SpecifiedEntity> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isda> ;
    skos:exactMatch "common_domain_model:SpecifiedEntity"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isda"^^xsd:anyURI ;
    skos:note "Rosetta condition: MaterialSubsidiary — if specifiedEntityTerms = SpecifiedEntityTermsEnum -> MaterialSubsidiary then materialSubsidiaryTerms exists",
        "Rosetta condition: OtherSpecifiedEntity — if specifiedEntityTerms = SpecifiedEntityTermsEnum -> OtherSpecifiedEntity then otherSpecifiedEntityTerms exists",
        "Rosetta condition: SpecifiedEntity — if specifiedEntityTerms = SpecifiedEntityTermsEnum -> NamedSpecifiedEntity then specifiedEntity exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/specifiedEntityTerms> ] ;
            linkml:description "A validation rule to ensure that non standard Specified Entity terms are provided when required." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/otherSpecifiedEntityTerms> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/specifiedEntityTerms> ] ;
            linkml:description "A validation rule to ensure that Material Subsidiary terms are specified when required." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/materialSubsidiaryTerms> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/specifiedEntityTerms> ] ;
            linkml:description "A validation rule to ensure that a SpecifiedEntity is specified when required." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/specifiedEntity> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SpecifiedEntity"^^xsd:anyURI ;
    linkml:description "The party specific election of Specified Entities for the Event of Default or Termination Event specified." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SpecifiedEntity_party>,
        <https://w3id.org/lmodel/common-domain-model/SpecifiedEntity_specifiedEntity>,
        <https://w3id.org/lmodel/common-domain-model/materialSubsidiaryTerms>,
        <https://w3id.org/lmodel/common-domain-model/otherSpecifiedEntityTerms>,
        <https://w3id.org/lmodel/common-domain-model/specifiedEntityTerms> .

