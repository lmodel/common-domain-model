	linkml:description "FpML specifies the timezoneLocationScheme by reference to the Time Zone Database (a.k.a. tz database) maintained by IANA, the Internet Assigned Numbers Authority." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TimeZone> ;
