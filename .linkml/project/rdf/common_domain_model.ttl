	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "quotedCurrencyPair" ;
	linkml:annotations _:c14n166 ;
	linkml:description "Defines the two currencies for an FX trade and the quotation relationship between the two currencies. This attribute was formerly part of 'fxSettlementTerms', which is now being harmonised into a common 'CashSettlementTerms' that includes a 'ValuationDate'." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ValuationSource> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationSource> ;
