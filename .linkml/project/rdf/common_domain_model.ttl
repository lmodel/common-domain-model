	linkml:description "Fixed price step schedule, including an initial price specified as an absolute number." , "Specifies a price to be used for trade amounts and other purposes." , "The initial rate. An initial rate of 5% would be represented as 0.05." , "The price of the package." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Price> , <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/priceComponent> a linkml:SlotDefinition ;
	linkml:description "Denotes the price used to compute the valuation." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Price> .
<https://w3id.org/lmodel/common-domain-model/priceComposite__arithmeticOperator> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "arithmeticOperator" ;
	linkml:description "Specifies the arithmetic operator via an enumeration." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ArithmeticOperationEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/arithmeticOperator"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceComposite__baseValue> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "baseValue" ;
	linkml:description "The 1st value in the arithmetic operation, which may be non-commutative in some cases: Subtract, Divide). This 1st operand is called 'baseValue' as it refers to the price anchor in the arithmetic operation: e.g. the clean price (Bond) or the spot rate (FX)." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/baseValue"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceComposite__operand> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "operand" ;
	linkml:description "The 2nd value in the arithmetic operation, which may be non-commutative in some cases: Subtract, Divide). The 2nd operand is called 'operand' to distinguish it from the 1st one which is the price anchor." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/operand"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceComposite__operandType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "operandType" ;
	linkml:description "Optionally qualifies the type of operand: e.g. accrued or forward point." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceOperandEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/operandType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceExpression> a linkml:SlotDefinition ;
	linkml:description "(Optionally) Specifies whether the price is expressed in absolute or percentage terms." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceExpressionEnum> .
<https://w3id.org/lmodel/common-domain-model/priceMateriality> a linkml:SlotDefinition ;
	linkml:annotations _:c14n574 ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceMateriality> .
<https://w3id.org/lmodel/common-domain-model/priceMaterialityIsApplicable> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/priceMateriality__escrowArrangement> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
	skos:prefLabel "escrowArrangement" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceMateriality> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceMateriality> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/EscrowArrangement> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/escrowArrangement"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceMateriality__fallbackReferencePrice> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
	skos:prefLabel "fallbackReferencePrice" ;
	linkml:description "The method, prioritised by the order it is listed in this element, to get a replacement rate for the disrupted settlement rate option." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceMateriality> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceMateriality> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AssetSettlementRateOption> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fallbackReferencePrice"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceMateriality__priceMaterialityIsApplicable> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
	skos:prefLabel "priceMaterialityIsApplicable" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceMateriality> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceMateriality> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/priceMaterialityIsApplicable"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/pricePublisher> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1718 ;
	linkml:description "Defines a publication in which the price can be found. (e.g Gas Daily, Platts Bloomberg. Commodity publishers can be found at this URL: http://www.fpml.org/coding-scheme/commodity-information-provider>" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/priceQuantity> a linkml:SlotDefinition ;
	linkml:description "Defines the prices (e.g. spread, equity price, FX rate), quantities (e.g. currency amount, no. shares) and settlement terms (e.g. initial fee, broker fee, up-front cds payment or option premium settlement) associated with the constituents of the transacted product." , "Each payout leg must implement the quantity concept as a 'resolvable' type, which allows for different payout legs to be linked to each other (e.g. in the case of cross-curreny products)." , "Position with many price quantities." , "Specifies both new floating rate index and spread adjustment for each leg to be updated. The spread adjustment accounts for the difference between the old floating rate index relative to the new one. This spread amount is added to the existing spread to determine the new spread, which is applied from the specified effective date forward. In the case of the IBOR Fallback Rate Adjustments, the adjustment spread (also known as the Fallback Adjustment) accounts for two distinctions: i) the fact that the replacement Risk-Free Rate is an overnight rate while IBORs have term structures (e.g., 1, 3, 6-month LIBOR); and (ii) the historical spread differential between IBORs and their term equivalent Overnight Risk-Free Rate compounded rates." , "Specifies the settlement characteristics of a trade lot: price, quantity, observable (optionally) and the settlement terms. This attribute has a multiple cardinality to allow to specify the price, quantity and observable of different legs in a single, composite product (e.g. a Swap)." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceQuantity> , <https://w3id.org/lmodel/common-domain-model/ResolvablePriceQuantity> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/priceQuantity__effectiveDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "effectiveDate" ;
	linkml:description "Specifies the date at which the price and quantity become effective. This day may be subject to adjustment in accordance with a business day convention, or could be specified as relative to a trade date, for instance. Optional cardinality, as the effective date is usually specified in the product definition, so it may only need to be specified as part of the PriceQuantity in an increase/decrease scenario for an existing trade." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableOrRelativeDate> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/effectiveDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceQuantity__observable> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "observable" ;
	linkml:annotations _:c14n2140 ;
	linkml:description "Specifies the object to be observed for a price, it could be an asset or an index. The cardinality is optional as some quantity / price cases have no observable (e.g. a fixed rate in a given currency)." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Observable> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/observable"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceQuantity__price> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "price" ;
	linkml:annotations _:c14n1460 ;
	linkml:description "Specifies a price to be used for trade amounts and other purposes." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/price"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceQuantity__quantity> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "quantity" ;
	linkml:annotations _:c14n1008 ;
	linkml:description "Specifies a quantity to be associated with an event, for example a trade amount." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NonNegativeQuantitySchedule> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/quantity"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceQuoteType> a linkml:SlotDefinition ;
	linkml:description "Describes the required quote type of the underlying price that will be observed. Example values include 'Bid, 'Ask', 'Settlement' (for a futures contract) and 'WeightedAverage' (for some published prices and indices)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/QuotationSideEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/priceReturnTerms> a linkml:SlotDefinition ;
	linkml:description "Return terms based upon the underlier's observed price." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceReturnTerms> .
<https://w3id.org/lmodel/common-domain-model/priceReturnTerms__conversionFactor> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "conversionFactor" ;
	linkml:description "Defines the conversion applied if the quantity unit on contract is different from unit on referenced underlier." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceReturnTerms> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceReturnTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/conversionFactor"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceReturnTerms__performance> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "performance" ;
	linkml:description "Performance calculation, in accordance with Part 1 Section 12 of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap, Para 75. 'Equity Performance'. Cumulative performance is used as a notional multiplier factor on both legs of an Equity Swap." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceReturnTerms> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceReturnTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/performance"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceReturnTerms__returnType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "returnType" ;
	linkml:description "The type of return associated with the equity swap." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceReturnTerms> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceReturnTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ReturnTypeEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/returnType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSchedule> a linkml:SlotDefinition ;
	linkml:annotations _:c14n769 ;
	linkml:description "A payout's price specified as a schedule, which may also contain a single value if that price is constant. There may be multiple prices specified for a single payout: e.g. a floating interest rate leg may specify a spread, a cap and/or floor and a multiplier. The price must be specified outside of the payout in a PriceQuantity object and only referenced inside the payout using an address." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceSchedule> .
<https://w3id.org/lmodel/common-domain-model/priceSchedule__arithmeticOperator> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "arithmeticOperator" ;
	linkml:description "(Optionally) When the price is to be understood as an operator to apply to an observable, i.e. a spread, multiplier or min/max." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ArithmeticOperationEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/arithmeticOperator"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSchedule__composite> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "composite" ;
	linkml:description "(Optionally) Specifies the underlying price components if the price can be expressed as a composite: e.g. dirty price = clean price + accrued." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceComposite> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/composite"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSchedule__derivedQuantity> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "derivedQuantity" ;
	linkml:description "Specifies the derived quantity associated with the price. For instance when the price is an asset price expressed in a currency, the primary quantity is the asset's quantity while the derived quantity is the corresponding monetary amount in that currency. When the price is an exchange rate, both the primary quantity and the derived quantity are monetary amounts, in the 2 currencies of the exchange rate." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NonNegativeQuantitySchedule> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/derivedQuantity"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSchedule__perUnitOf> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "perUnitOf" ;
	linkml:description "Provides an attribute to define the unit of the thing being priced. For example, {amount, unitOfAmount, PerUnitOfAmount} = [10, EUR, Shares] = (10.00 EUR/SHARE) * (300,000 SHARES) = EUR 3,000,000.00 (Shares cancel out in the calculation)." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/UnitType> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/perUnitOf"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSchedule__premiumType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "premiumType" ;
	linkml:description "(Optionally) Additional attribute that can further define any premium to the price." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PremiumTypeEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/premiumType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSchedule__priceExpression> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "priceExpression" ;
	linkml:description "(Optionally) Specifies whether the price is expressed in absolute or percentage terms." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceExpressionEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/priceExpression"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSchedule__priceSubType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "priceSubType" ;
	linkml:description "Allows further classification of the chosen price type." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceSubTypeEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/priceSubType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSchedule__priceType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "priceType" ;
	linkml:description "Specifies the price type as an enumeration: interest rate, exchange rate, asset price etc. This attribute is mandatory so that prices can always be clasiffied according to their type. The price type implies some constraints on the price's units." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceTypeEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/priceType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSource> a linkml:SlotDefinition ;
	linkml:description "Specifies a publication that provides the commodity price, including, where applicable the details of where in the publication the price is published. Applicable when the commodity reference price is not a futures contract" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceSource> ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/priceSourceDisruption> a linkml:SlotDefinition ;
	linkml:annotations _:c14n979 ;
	linkml:description "An attribute defining the parameters to get a new quote when a settlement rate option is disrupted." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FxPriceSourceDisruption> , <https://w3id.org/lmodel/common-domain-model/PriceSourceDisruption> .
<https://w3id.org/lmodel/common-domain-model/priceSourceDisruptionIsApplicable> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/priceSourceDisruption__fallbackReferencePrice> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
	skos:prefLabel "fallbackReferencePrice" ;
	linkml:description "The method, prioritised by the order it is listed in this element, to get a replacement rate for the disrupted settlement rate option." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PriceSourceDisruption> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PriceSourceDisruption> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FallbackReferencePrice> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fallbackReferencePrice"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/priceSourceHeading> a linkml:SlotDefinition ;
	linkml:description "Specifies the heading or field name for the price on a given page or screen, where applicable." ;
