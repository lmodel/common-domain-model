        <https://w3id.org/lmodel/common-domain-model/lastPaymentDate> .

<https://w3id.org/lmodel/common-domain-model/Commodity> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:closeMatch "fpml_5_10:Commodity"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:Commodity"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: AssetType — assetType = Commodity",
        "Rosetta condition: ValueSource — if taxonomy exists then (taxonomy -> source exists and taxonomy -> value exists)" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "AssetType must be commodity." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/assetType> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Commodity"^^xsd:anyURI ;
    linkml:description "Commodity.",
        "Identifies a specific commodity by referencing a product identifier or by a product definition.",
        "Identifies basic good used in commerce that is interchangeable with other goods of the same type." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/AssetBase> ;
    linkml:meaning "http://www.fpml.org/coding-scheme/asset-class-2-1#Commodity"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/assetType>,
        <https://w3id.org/lmodel/common-domain-model/commodityProductDefinition>,
        <https://w3id.org/lmodel/common-domain-model/deliveryDateReference>,
        <https://w3id.org/lmodel/common-domain-model/description>,
        <https://w3id.org/lmodel/common-domain-model/exchange>,
        <https://w3id.org/lmodel/common-domain-model/identifier>,
        <https://w3id.org/lmodel/common-domain-model/isExchangeListed>,
        <https://w3id.org/lmodel/common-domain-model/priceQuoteType>,
        <https://w3id.org/lmodel/common-domain-model/relatedExchange>,
        <https://w3id.org/lmodel/common-domain-model/taxonomy> .

<https://w3id.org/lmodel/common-domain-model/ContactInformation> a linkml:ClassDefinition ;
