eriod -> priceTimeIntervalQuantity is absent and schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity is absent else if schedule -> schedulePeriod -> deliveryPeriod -> profile -> block -> priceTimeIntervalQuantity exists then schedule -> schedulePeriod -> deliveryPeriod -> priceTimeIntervalQuantity is absent and delivery -> periods -> profile -> block -> priceTimeIntervalQuantity is absent" , "Rosetta condition SettlementCentreRequired is not stated in LinkML: if underlier as Security exists then (settlementTerms -> securitySettlementCentre exists and settlementTerms -> cashSettlementCentre exists)" , "Rosetta condition SettlementTerms is not stated in LinkML: if underlier as Cash exists then settlementTerms exists" , "Rosetta condition Underlier is not stated in LinkML: underlier as NonTransferableProduct is absent" ;
