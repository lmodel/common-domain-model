<https://w3id.org/lmodel/common-domain-model/AncillaryParty> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:closeMatch "fpml_5_10:AncillaryParty"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AncillaryParty"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    skos:note "Rosetta func: ExtractAncillaryPartyByRole — Extracts from a list of AncillaryParty data types, the AncillaryParty that corresponds to the AncillaryRoleEnum." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"ExtractAncillaryPartyByRole\",\"description\":\"Extracts from a list of AncillaryParty data types, the AncillaryParty that corresponds to the AncillaryRoleEnum.\",\"inputs\":[{\"name\":\"ancillaryParties\",\"type\":\"AncillaryParty\",\"cardinality\":\"1..*\"},{\"name\":\"roleEnumToExtract\",\"type\":\"AncillaryRoleEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"ancillaryParty\",\"type\":\"AncillaryParty\",\"cardinality\":\"0..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AncillaryParty"^^xsd:anyURI ;
    linkml:description "Defines an ancillary role enumerated value with an associated party reference. The product is agnostic to the actual parties involved in the transaction, with the party references abstracted away from the product definition and replaced by the AncillaryRoleEnum. The AncillaryRoleEnum can then be positioned in the product and this AncillaryParty type, which is positioned outside of the product definition, allows the AncillaryRoleEnum to be associated with an actual party reference." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AncillaryParty_partyReference>,
        <https://w3id.org/lmodel/common-domain-model/AncillaryParty_role>,
        <https://w3id.org/lmodel/common-domain-model/onBehalfOf> .

<https://w3id.org/lmodel/common-domain-model/AssetBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:closeMatch "fpml_5_10:AssetBase"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AssetBase"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: ExchangeListed — if exchange exists then isExchangeListed",
        "Rosetta condition: RelatedExchange — if exchange is absent then relatedExchange is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/exchange> ] ;
            linkml:description "If Exchange is specified, it must be an exchange-listed Instrument." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isExchangeListed> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/exchange> ] ;
            linkml:description "Related Exchange should only be specified if an Exchange is also specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/relatedExchange> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AssetBase"^^xsd:anyURI ;
    linkml:description "The base data type to specify common attributes for all Assets." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/assetType>,
        <https://w3id.org/lmodel/common-domain-model/exchange>,
        <https://w3id.org/lmodel/common-domain-model/identifier>,
        <https://w3id.org/lmodel/common-domain-model/isExchangeListed>,
        <https://w3id.org/lmodel/common-domain-model/relatedExchange>,
        <https://w3id.org/lmodel/common-domain-model/taxonomy> .

<https://w3id.org/lmodel/common-domain-model/BusinessDayAdjustments> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
