    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/NonNegativeStep"^^xsd:anyURI ;
    linkml:description "A class defining a step date and non-negative step value pair. This step definitions are used to define varying rate or amount schedules, e.g. a notional amortisation or a step-up coupon schedule." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/stepDate>,
        <https://w3id.org/lmodel/common-domain-model/stepValue> .

