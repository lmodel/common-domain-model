    linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/offsetDays"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/optionType> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/optionType"^^xsd:anyURI ;
