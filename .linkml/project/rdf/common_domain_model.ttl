<https://w3id.org/lmodel/common-domain-model/ResetFrequency> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:ResetFrequency"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    skos:note "Rosetta condition: FpML_ird_49 — if weeklyRollConvention exists then period = PeriodExtendedEnum -> W" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ResetFrequency"^^xsd:anyURI ;
    linkml:description "A class defining the reset frequency. In the case of a weekly reset, also specifies the day of the week that the reset occurs. If the reset frequency is greater than the calculation period frequency the this implies that more or more reset dates is established for each calculation period and some form of rate averaging is applicable. The specific averaging method of calculation is specified in FloatingRateCalculation. In case the reset frequency is of value T (term), the period is defined by the swap/swapStream/calculationPerioDates/effectiveDate and the swap/swapStream/calculationPerioDates/terminationDate." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/Frequency> ;
    linkml:slot_usage [ ] ;
