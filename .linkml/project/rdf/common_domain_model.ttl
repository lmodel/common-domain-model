    linkml:inlined_as_list true ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/priceQuantity> ;
    linkml:is_usage_slot true ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PayoutBase> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/ResolvablePriceQuantity> ;
