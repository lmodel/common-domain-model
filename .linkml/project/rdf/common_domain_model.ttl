<https://w3id.org/lmodel/common-domain-model/failureToPay> a linkml:SlotDefinition ;
	linkml:description "A credit event. This credit event triggers, after the expiration of any applicable grace period, if the reference entity fails to make due payments in an aggregate amount of not less than the payment requirement on one or more obligations (e.g. a missed coupon payment). ISDA 2003 Term: Failure to Pay." , "The failure to pay election." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FailureToPay> , <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/failureToPayEarlyTermination> a linkml:SlotDefinition ;
	linkml:description "A boolean attribute to specify whether Failure to Pay Early Termination language in the agreement is deemed applicable or not." ;
