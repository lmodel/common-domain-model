<https://w3id.org/lmodel/common-domain-model/DiscountingMethod> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:DiscountingMethod"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: DiscountRate — if discountRateDayCountFraction exists then discountRate exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/discountRateDayCountFraction> ] ;
            linkml:description "In FpML discountingRate and discountRateDayCountFraction are part of an optional node, with discountingRate as the required element as part of that node." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/discountRate> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/DiscountingMethod"^^xsd:anyURI ;
    linkml:description "A data defining:  discounting information. The 2000 ISDA definitions, section 8.4. discounting (related to the calculation of a discounted fixed amount or floating amount) apply. This type must only be included if discounting applies." ;
