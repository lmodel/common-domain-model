    linkml:owner <https://w3id.org/lmodel/common-domain-model/CashSettlementTerms> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/ValuationDate> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/valuationDate"^^xsd:anyURI ;
    linkml:usage_slot_name "valuationDate" .

<https://w3id.org/lmodel/common-domain-model/CashSettlementTerms_valuationMethod> a linkml:SlotDefinition ;
