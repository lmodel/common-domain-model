<https://w3id.org/lmodel/common-domain-model/MinimumTransferAmount> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_English_1995"^^xsd:anyURI,
        "isda:CSA_NewYork_1994"^^xsd:anyURI,
        "isda:CSA_VM_English_2016"^^xsd:anyURI,
        "isda:CSA_VM_NewYork_2016"^^xsd:anyURI,
        "isda:CSD_English_1995"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_English_1995 name \"Minimum Transfer Amount\"",
        "ISDA CSA_NewYork_1994 name \"Minimum Transfer Amount\"",
        "ISDA CSA_VM_English_2016 name \"Minimum Transfer Amount\"",
        "ISDA CSA_VM_NewYork_2016 name \"Minimum Transfer Amount\"",
        "ISDA CSD_English_1995 name \"Minimum Transfer Amount\"" ;
    skos:exactMatch "common_domain_model:MinimumTransferAmount"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MinimumTransferAmount"^^xsd:anyURI ;
    linkml:description "Represents the threshold specified in the agreement below which collateral need not be delivered, and represents the smallest incremental value of exposure that must be reached before the parties are obliged to transfer collateral." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/MinimumTransferAmount_partyElection> .

<https://w3id.org/lmodel/common-domain-model/MultipleExercise> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:MultipleExercise"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: MaximumChoice — required choice maximumNotionalAmount, maximumNumberOfOptions",
        "Rosetta condition: MaximumNumberOfOptions — if maximumNumberOfOptions exists then maximumNotionalAmount >= 0",
        "Rosetta condition: MinimumNumberOfOptions — if minimumNumberOfOptions exists then minimumNumberOfOptions >= 0" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumNumberOfOptions> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumNotionalAmount> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumNumberOfOptions> ] ;
            linkml:description "FpML MultipleExercise construct specifies the maximumNumberOfOptions as a positive integer." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumNotionalAmount> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/minimumNumberOfOptions> ] ;
            linkml:description "FpML MultipleExercise construct specifies the minimumNumberOfOptions as a positive integer." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/minimumNumberOfOptions> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MultipleExercise"^^xsd:anyURI ;
    linkml:description "A class defining multiple exercises. As defined in the 2000 ISDA Definitions, Section 12.4. Multiple Exercise, the buyer of the option has the right to exercise all or less than all the unexercised notional amount of the underlying swap on one or more days in the exercise period, but on any such day may not exercise less than the minimum notional amount or more than the maximum notional amount, and if an integral multiple amount is specified, the notional exercised must be equal to or, be an integral multiple of, the integral multiple amount. In FpML, MultipleExercise is built upon the PartialExercise.model." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/PartialExercise> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PartialExercise_notionalReference>,
        <https://w3id.org/lmodel/common-domain-model/integralMultipleAmount>,
        <https://w3id.org/lmodel/common-domain-model/maximumNotionalAmount>,
        <https://w3id.org/lmodel/common-domain-model/maximumNumberOfOptions>,
        <https://w3id.org/lmodel/common-domain-model/minimumNotionalAmount>,
        <https://w3id.org/lmodel/common-domain-model/minimumNumberOfOptions> .

<https://w3id.org/lmodel/common-domain-model/MultipleValuationDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:MultipleValuationDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: BusinessDaysThereafter — if businessDaysThereafter exists then businessDaysThereafter >= 0",
        "Rosetta condition: NumberValuationDates — if numberValuationDates exists then numberValuationDates >= 0" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/businessDaysThereafter> ] ;
            linkml:description "FpML specifies businessDaysThereafter as a PositiveInteger." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/businessDaysThereafter> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/numberValuationDates> ] ;
            linkml:description "FpML specifies numberValuationDates as a PositiveInteger." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/numberValuationDates> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MultipleValuationDates"^^xsd:anyURI ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/SingleValuationDate> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/businessDays>,
        <https://w3id.org/lmodel/common-domain-model/businessDaysThereafter>,
        <https://w3id.org/lmodel/common-domain-model/numberValuationDates> .

