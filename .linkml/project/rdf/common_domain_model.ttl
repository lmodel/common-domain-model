	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/FloatingRateSpecification"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/rateSpecification__InflationRateSpecification> a linkml:SlotDefinition ;
