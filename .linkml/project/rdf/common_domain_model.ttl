<https://w3id.org/lmodel/common-domain-model/calculationPeriodDates__effectiveDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "effectiveDate" ;
	linkml:description "The first day of the terms of the trade. This day may be subject to adjustment in accordance with a business day convention." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
	linkml:inlined true ;
