    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EventCurrency"^^xsd:anyURI ;
    linkml:description "Defines the currency referenced as such in any terms related to FX Disruption Events" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/EventCurrency_eventCurrency>,
        <https://w3id.org/lmodel/common-domain-model/eventCurrencyBuyerSeller>,
        <https://w3id.org/lmodel/common-domain-model/eventCurrentAmount> .

<https://w3id.org/lmodel/common-domain-model/Exposure> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:Exposure"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_ExposureFromTrades — Builds an Exposure structure from a list of trades." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_ExposureFromTrades\",\"description\":\"Builds an Exposure structure from a list of trades.\",\"inputs\":[{\"name\":\"trades\",\"type\":\"TradeState\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"exposure\",\"type\":\"Exposure\",\"cardinality\":\"0..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Exposure"^^xsd:anyURI ;
    linkml:description "Represents the current mark to market value or IM calculation value of the trade portfolio as recorded by the principle (in base currency)." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/aggregateValue>,
        <https://w3id.org/lmodel/common-domain-model/calculationDateTime>,
        <https://w3id.org/lmodel/common-domain-model/tradePortfolio>,
        <https://w3id.org/lmodel/common-domain-model/valuationDateTime> .

<https://w3id.org/lmodel/common-domain-model/FailureToPay> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_event> ;
    skos:exactMatch "common_domain_model:FailureToPay"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FailureToPay"^^xsd:anyURI ;
    linkml:description "This credit event triggers, after the expiration of any applicable grace period, if the reference entity fails to make due payments in an aggregrate amount of not less than the payment requirement on one or more obligations (e.g. a missed coupon payment). ISDA 2003 Term: Failure to Pay." ;
    linkml:meaning "http://www.fpml.org/coding-scheme/credit-event-type-1-0#FailureToPay"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FailureToPay_applicable>,
        <https://w3id.org/lmodel/common-domain-model/gracePeriodExtension>,
        <https://w3id.org/lmodel/common-domain-model/paymentRequirement> .

<https://w3id.org/lmodel/common-domain-model/FallbackReferencePrice> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:FallbackReferencePrice"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: FallbackCalculationAgent — if calculationAgentDetermination -> calculationAgentParty exists then calculationAgentDetermination -> calculationAgentParty = AncillaryRoleEnum -> CalculationAgentFallback",
        "Rosetta condition: MaximumDaysOfPostponement — if valuationPostponement exists then valuationPostponement -> maximumDaysOfPostponement > 0" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FallbackReferencePrice"^^xsd:anyURI ;
    linkml:description "The method, prioritised by the order it is listed in this element, to get a replacement rate for the disrupted settlement rate option." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/calculationAgentDetermination>,
        <https://w3id.org/lmodel/common-domain-model/fallBackSettlementRateOption>,
        <https://w3id.org/lmodel/common-domain-model/fallbackSurveyValuationPostponement>,
        <https://w3id.org/lmodel/common-domain-model/valuationPostponement> .

<https://w3id.org/lmodel/common-domain-model/FinalReturns> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:FinalReturns"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdditionalLanguage — if applicable then additionalLanguage exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/applicable> ] ;
            linkml:description "The additional language should be qualified only if the clause is specified as applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FinalReturns"^^xsd:anyURI ;
    linkml:description "A clause providing that final return collateral is to be provided without consideration of any Minimum Transfer Amount and collateral haircut." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FinalReturns_additionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/FinalReturns_applicable> .

<https://w3id.org/lmodel/common-domain-model/FxAdditionalTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms> ;
    skos:exactMatch "common_domain_model:FxAdditionalTerms"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
    skos:note "Rosetta condition: NoFaultTerminationOrDisruptionTerms — (disruptionEvents exists and noFaultTermination is absent or noFaultTermination = False) or (disruptionEvents is absent and noFaultTermination = True)",
        "Rosetta condition: SpecificDeterminationRetrictionsForFx — determinationTerms -> determinationRole = DeterminationRoleEnum -> CalculationAgent" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FxAdditionalTerms"^^xsd:anyURI ;
    linkml:description "TransactionAdditionalTerms which apply to the CurrencyPair asset class." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FxAdditionalTerms_determinationTerms>,
        <https://w3id.org/lmodel/common-domain-model/disruptionEvents>,
        <https://w3id.org/lmodel/common-domain-model/noFaultTermination> .

<https://w3id.org/lmodel/common-domain-model/GlobalMasterSecuritiesLendingAgreement> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isla> ;
    skos:exactMatch "common_domain_model:GlobalMasterSecuritiesLendingAgreement"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_master_isla"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/GlobalMasterSecuritiesLendingAgreement"^^xsd:anyURI ;
    linkml:description "The set of elections that define a GMSLA." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/MasterAgreementBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/GlobalMasterSecuritiesLendingAgreement_baseCurrency>,
        <https://w3id.org/lmodel/common-domain-model/GlobalMasterSecuritiesLendingAgreement_collateral>,
        <https://w3id.org/lmodel/common-domain-model/eventsOfDefault> .

<https://w3id.org/lmodel/common-domain-model/LegacyIndependentAmount> a linkml:ClassDefinition ;
