	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ResetDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessDayAdjustments> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/resetDatesAdjustments"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/resetDates__resetFrequency> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "resetFrequency" ;
	linkml:description "The frequency at which the reset dates occur. In the case of a weekly reset frequency, also specifies the day of the week that the reset occurs. If the reset frequency is greater than the calculation period frequency then this implies that more than one reset is established for each calculation period and some form of rate averaging is applicable." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ResetDates> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ResetDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ResetFrequency> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/resetFrequency"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/resetDates__resetRelativeTo> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "resetRelativeTo" ;
	linkml:description "Specifies whether the reset dates are determined with respect to each adjusted calculation period start date or adjusted calculation period end date. If the reset frequency is specified as daily this element must not be included." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ResetDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ResetDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ResetRelativeToEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/resetRelativeTo"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/resetFrequency> a linkml:SlotDefinition ;
	linkml:description "The frequency at which the reset dates occur. In the case of a weekly reset frequency, also specifies the day of the week that the reset occurs. If the reset frequency is greater than the calculation period frequency then this implies that more than one reset is established for each calculation period and some form of rate averaging is applicable." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ResetFrequency> .
<https://w3id.org/lmodel/common-domain-model/resetFrequency__weeklyRollConvention> a linkml:SlotDefinition ;
