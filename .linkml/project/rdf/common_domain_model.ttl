    skos:exactMatch "common_domain_model:Observable"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Generated from Rosetta 'choice' construct — represents a union/one-of type." ;
    linkml:abstract true ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Observable"^^xsd:anyURI ;
    linkml:description "Specifies the object to be observed for a price, it could be an asset or a reference." ;
    linkml:slot_usage [ ] ;
    linkml:union_of <https://w3id.org/lmodel/common-domain-model/Asset>,
        <https://w3id.org/lmodel/common-domain-model/Basket>,
        <https://w3id.org/lmodel/common-domain-model/Index> .

<https://w3id.org/lmodel/common-domain-model/PartialExercise> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:PartialExercise"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: MinimumChoice — required choice minimumNotionalAmount, minimumNumberOfOptions" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/minimumNotionalAmount> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/minimumNumberOfOptions> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PartialExercise"^^xsd:anyURI ;
    linkml:description "A class defining partial exercise. As defined in the 2000 ISDA Definitions, Section 12.3 Partial Exercise, the buyer of the option may exercise all or less than all the notional amount of the underlying swap but may not be less than the minimum notional amount (if specified) and must be an integral multiple of the integral multiple amount if specified." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PartialExercise_notionalReference>,
        <https://w3id.org/lmodel/common-domain-model/integralMultipleAmount>,
        <https://w3id.org/lmodel/common-domain-model/minimumNotionalAmount>,
        <https://w3id.org/lmodel/common-domain-model/minimumNumberOfOptions> .

