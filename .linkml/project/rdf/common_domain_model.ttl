	linkml:owner <https://w3id.org/lmodel/common-domain-model/ValuationSource> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FxSpotRateSource> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/informationSource"^^xsd:anyURI .
