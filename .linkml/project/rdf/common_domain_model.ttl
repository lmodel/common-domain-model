<https://w3id.org/lmodel/common-domain-model/stockSplit> a linkml:SlotDefinition ;
	linkml:description "Specifies inputs needed to process a Stock Split business event." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/StockSplitInstruction> .
<https://w3id.org/lmodel/common-domain-model/stockSplitInstruction__adjustmentRatio> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
	skos:prefLabel "adjustmentRatio" ;
	linkml:description "The number that denotes the cumulative quantity of post-split shares issued to shareholders versus the quantity of pre-split shares previously issued to shareholders. This number will be multiplied by existing shares in an equity derivative contract or other positions to determine the post-split number of shares. With regard to any reference to price, the pre-split reference price will be divided by this number to determine the post-split reference price." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/StockSplitInstruction> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/StockSplitInstruction> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/adjustmentRatio"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/stockSplitInstruction__effectiveDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
	skos:prefLabel "effectiveDate" ;
	linkml:description "The effective date of the stock split, also known as the ex-date. This is the date on which the additional shares are paid to the shareholders, or in the case of a reverse stock split, the number shares held by each shareholder is proportionally reduced. Equity derivative transactions can be amended in firms' internal systems on such date. In most markets, the listed stock price is reduced (or increased for a reverse stock split) to account for the split on the same date, but in some markets the price adjustment occurs on a later date. In either case, equity derivative transactions should be amended on the date that the stocks are paid to the shareholders (or consolidated)." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/StockSplitInstruction> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/StockSplitInstruction> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/effectiveDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/strategyFeature> a linkml:SlotDefinition ;
	linkml:description "Defines a simple strategy feature." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/StrategyFeature> .
<https://w3id.org/lmodel/common-domain-model/strategyFeature__calendarSpread> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "calendarSpread" ;
