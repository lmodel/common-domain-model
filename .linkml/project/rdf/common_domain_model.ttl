    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/executionLocation"^^xsd:anyURI ;
    linkml:description "The execution location of the agreement." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ExecutionLocation>,
        <https://w3id.org/lmodel/common-domain-model/ExecutionTerms> ;
