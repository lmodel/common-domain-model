<https://w3id.org/lmodel/common-domain-model/PartyChangeInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:PartyChangeInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PartyChangeInstruction"^^xsd:anyURI ;
    linkml:description "Specifies instruction to change the party on a trade. This primitive instruction is used in a number of scenarios including: clearing, allocation and novation. The instrution must include a trade identifier, because a change of party effectively results in a different trade." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PartyChangeInstruction_ancillaryParty>,
        <https://w3id.org/lmodel/common-domain-model/PartyChangeInstruction_counterparty>,
        <https://w3id.org/lmodel/common-domain-model/partyRole>,
        <https://w3id.org/lmodel/common-domain-model/tradeId> .

<https://w3id.org/lmodel/common-domain-model/PartyReferencePayerReceiver> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:exactMatch "common_domain_model:PartyReferencePayerReceiver"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PartyReferencePayerReceiver"^^xsd:anyURI ;
    linkml:description "Specifies the parties responsible for making and receiving payments defined by this structure." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/payerAccountReference>,
        <https://w3id.org/lmodel/common-domain-model/payerPartyReference>,
        <https://w3id.org/lmodel/common-domain-model/receiverAccountReference>,
        <https://w3id.org/lmodel/common-domain-model/receiverPartyReference> .

<https://w3id.org/lmodel/common-domain-model/PayerReceiver> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:exactMatch "common_domain_model:PayerReceiver"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PayerReceiver"^^xsd:anyURI ;
    linkml:description "Specifies the parties responsible for making and receiving payments defined by this structure." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/payer>,
        <https://w3id.org/lmodel/common-domain-model/receiver> .

<https://w3id.org/lmodel/common-domain-model/ProcessAgentElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ProcessAgentElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: Applicable — if isApplicable = True then primaryContactInformation exists and entity exists and partyReference exists",
        "Rosetta condition: NotApplicable — if isApplicable = False then primaryContactInformation is absent and entity is absent and partyReference is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isApplicable> ] ;
            linkml:description "A data rule to enforce that the Process Agent details cannot be specified if deemed not applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/entity>,
                        <https://w3id.org/lmodel/common-domain-model/partyReference>,
                        <https://w3id.org/lmodel/common-domain-model/primaryContactInformation> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isApplicable> ] ;
            linkml:description "A data rule to enforce that the Process Agent details must be specified when it is applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/entity>,
                        <https://w3id.org/lmodel/common-domain-model/partyReference>,
                        <https://w3id.org/lmodel/common-domain-model/primaryContactInformation> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ProcessAgentElection"^^xsd:anyURI ;
    linkml:description "Specifies the parties' respective elections with respect to the Process Agent." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/ContactInformationElection> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ContactInformationElection_partyReference>,
        <https://w3id.org/lmodel/common-domain-model/ProcessAgentElection_additionalInformation>,
        <https://w3id.org/lmodel/common-domain-model/ProcessAgentElection_isApplicable>,
        <https://w3id.org/lmodel/common-domain-model/entity>,
        <https://w3id.org/lmodel/common-domain-model/primaryContactInformation> .

<https://w3id.org/lmodel/common-domain-model/RecallProvision> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:RecallProvision"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/RecallProvision"^^xsd:anyURI ;
    linkml:description "Defines the additional features that allow securities to be recalled by the lender before the term of the loan. A recall is not the same as an early termination, but may result in the early termination of a loan." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/RecallProvision_notificationTime>,
        <https://w3id.org/lmodel/common-domain-model/intendedSettlementDate>,
        <https://w3id.org/lmodel/common-domain-model/isRecallable>,
        <https://w3id.org/lmodel/common-domain-model/issuanceCutoffTime> .

<https://w3id.org/lmodel/common-domain-model/Restructuring> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_event> ;
    skos:exactMatch "common_domain_model:Restructuring"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Restructuring"^^xsd:anyURI ;
    linkml:description "A restructuring is an event that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2003 Term: Restructuring." ;
    linkml:meaning "http://www.fpml.org/coding-scheme/credit-event-type-1-0#Restructuring"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Restructuring_applicable>,
        <https://w3id.org/lmodel/common-domain-model/multipleCreditEventNotices>,
        <https://w3id.org/lmodel/common-domain-model/multipleHolderObligation>,
        <https://w3id.org/lmodel/common-domain-model/restructuringType> .

<https://w3id.org/lmodel/common-domain-model/ReturnTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:ReturnTerms"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: ReturnTermsExists — if priceReturnTerms -> returnType = ReturnTypeEnum -> Total then (priceReturnTerms, dividendReturnTerms) only exists else if priceReturnTerms -> returnType = ReturnTypeEnum -> Price then priceReturnTerms only exists else priceReturnTerms only exists or dividendReturnTerms only exists or varianceReturnTerms only exists or volatilityReturnTerms only exists or correlationReturnTerms only exists" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ReturnTerms"^^xsd:anyURI ;
    linkml:description "Specifies the type of return of a performance payout." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/correlationReturnTerms>,
        <https://w3id.org/lmodel/common-domain-model/dividendReturnTerms>,
        <https://w3id.org/lmodel/common-domain-model/priceReturnTerms>,
        <https://w3id.org/lmodel/common-domain-model/varianceReturnTerms>,
        <https://w3id.org/lmodel/common-domain-model/volatilityReturnTerms> .

<https://w3id.org/lmodel/common-domain-model/Rounding> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_math> ;
    skos:exactMatch "common_domain_model:Rounding"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Rounding"^^xsd:anyURI ;
    linkml:description "Defines rounding rules and precision to be used in the rounding of a number." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Rounding_roundingDirection>,
        <https://w3id.org/lmodel/common-domain-model/precision> .

<https://w3id.org/lmodel/common-domain-model/Schedule> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_math> ;
    skos:exactMatch "common_domain_model:Schedule"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    skos:relatedMatch "gist:ScheduledEvent"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Schedule"^^xsd:anyURI ;
    linkml:description "A class defining a schedule of rates or amounts in terms of an initial value and then a series of step date and value pairs. On each step date the rate or amount changes to the new step value. The series of step date and value pairs are optional. If not specified, this implies that the initial value remains unchanged over time." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Schedule_datedValue>,
        <https://w3id.org/lmodel/common-domain-model/Schedule_value> .

<https://w3id.org/lmodel/common-domain-model/SettlementRateOption> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:SettlementRateOption"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SettlementRateOption"^^xsd:anyURI ;
    linkml:description "Defines the settlement rate option to use for fixing in case of cash settlement. Currently only applicable to foreign exchange fixing in case of cross-currency settlement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SettlementRateOption_priceSourceDisruption>,
        <https://w3id.org/lmodel/common-domain-model/SettlementRateOption_settlementRateOption> .

<https://w3id.org/lmodel/common-domain-model/SimmVersion> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_2018"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_2018 paragraph \"13 General Principles\" clause \"(ee)(1)\"" ;
    skos:exactMatch "common_domain_model:SimmVersion"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: VersionNotSpecified — if isSpecified = False then partyVersion is absent",
        "Rosetta condition: VersionSpecified — if isSpecified = True then partyVersion exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isSpecified> ] ;
            linkml:description "A data rule to enforce that the version attribute should be specified when the SIMM version is stated as specified for the CSA." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/partyVersion> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isSpecified> ] ;
            linkml:description "A data rule to enforce that the version attribute should be absent when the SIMM version is stated as not specified for the CSA." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/partyVersion> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SimmVersion"^^xsd:anyURI ;
    linkml:description "A class to specify the ISDA SIMM version that applies to the ISDA 2018 CSA for Initial Margin." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SimmVersion_asSpecified>,
        <https://w3id.org/lmodel/common-domain-model/SimmVersion_isSpecified>,
        <https://w3id.org/lmodel/common-domain-model/partyVersion> .

<https://w3id.org/lmodel/common-domain-model/SpecificNonTransferability> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms> ;
    skos:exactMatch "common_domain_model:SpecificNonTransferability"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
    skos:note "Rosetta condition: SettlementPostponementExistence — if localSubstituteProvisionType = FxSubstitutionProvisionTypeEnum -> LocalCurrencySubstitute then maximumDaysOfDisruption exists",
        "Rosetta condition: SubstituteTermsChoice — if localSubstituteProvisionType exists then nonDeliverableSubstitute is absent or if nonDeliverableSubstitute exists then localSubstituteProvisionType is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/localSubstituteProvisionType> ] ;
            linkml:description "SubstituteTermsChoice" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nonDeliverableSubstitute> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/localSubstituteProvisionType> ] ;
            linkml:description "SettlementPostponementExistence" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumDaysOfDisruption> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SpecificNonTransferability"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/escrowArrangement>,
        <https://w3id.org/lmodel/common-domain-model/localSubstituteProvisionType>,
        <https://w3id.org/lmodel/common-domain-model/maximumDaysOfDisruption>,
        <https://w3id.org/lmodel/common-domain-model/nonDeliverableSubstitute>,
        <https://w3id.org/lmodel/common-domain-model/relevantClass>,
        <https://w3id.org/lmodel/common-domain-model/specificNonTransferabilityIsApplicable> .

<https://w3id.org/lmodel/common-domain-model/Strike> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:Strike"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Strike"^^xsd:anyURI ;
    linkml:description "A class describing a single cap or floor rate." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Strike_buyer>,
        <https://w3id.org/lmodel/common-domain-model/Strike_seller>,
        <https://w3id.org/lmodel/common-domain-model/strikeRate> .

<https://w3id.org/lmodel/common-domain-model/ValuationMethod> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:ValuationMethod"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: Dealer — if quotationAmount exists or minimumQuotationAmount exists then valuationSource -> dealerOrCCP -> legalEntity exists",
        "Rosetta condition: FpML_cd_37 — if (quotationAmount -> unit -> currency exists and minimumQuotationAmount -> unit -> currency exists) and quotationAmount -> unit -> currency = minimumQuotationAmount -> unit -> currency then quotationAmount -> value > minimumQuotationAmount -> value" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ValuationMethod"^^xsd:anyURI ;
    linkml:description "Specifies the parameters required to obtain a valuation, including the source, quotation method (bid, mid etc.) and any applicable quotation amount." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/cashCollateralValuationMethod>,
        <https://w3id.org/lmodel/common-domain-model/minimumQuotationAmount>,
        <https://w3id.org/lmodel/common-domain-model/quotationAmount>,
        <https://w3id.org/lmodel/common-domain-model/quotationMethod>,
        <https://w3id.org/lmodel/common-domain-model/valuationMethod>,
        <https://w3id.org/lmodel/common-domain-model/valuationSource> .

<https://w3id.org/lmodel/common-domain-model/WorkflowState> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_workflow> ;
    skos:exactMatch "common_domain_model:WorkflowState"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/WorkflowState"^^xsd:anyURI ;
    linkml:description "A class to specify workflow information, which is conceptually applicable to all lifecycle events." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/WorkflowState_comment>,
        <https://w3id.org/lmodel/common-domain-model/partyCustomisedWorkflow>,
        <https://w3id.org/lmodel/common-domain-model/warehouseIdentity>,
        <https://w3id.org/lmodel/common-domain-model/workflowStatus> .

<https://w3id.org/lmodel/common-domain-model/cdm_event_position> a linkml:SubsetDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_position"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CdmEventPosition"^^xsd:anyURI ;
    linkml:description "Classes defined in the cdm_event_position module." .

<https://w3id.org/lmodel/common-domain-model/cdm_observable_event> a linkml:SubsetDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CdmObservableEvent"^^xsd:anyURI ;
    linkml:description "Classes defined in the cdm_observable_event module." .

<https://w3id.org/lmodel/common-domain-model/datedValue> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/datedValue"^^xsd:anyURI ;
    linkml:description "A schedule of step date and value pairs. On each step date the associated step value becomes effective. The step dates are used to order the steps by ascending order. This attribute is optional so the data type may be used to define a schedule with a single value." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/MeasureSchedule>,
        <https://w3id.org/lmodel/common-domain-model/Schedule> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/Schedule> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/DatedValue> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/datedValue"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/escrowArrangement> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/escrowArrangement"^^xsd:anyURI ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FxBenchmarkObligationDefault>,
        <https://w3id.org/lmodel/common-domain-model/FxDualExchangeRate>,
        <https://w3id.org/lmodel/common-domain-model/FxPriceSourceDisruption>,
        <https://w3id.org/lmodel/common-domain-model/GeneralInconvertibility>,
        <https://w3id.org/lmodel/common-domain-model/GeneralNonTransferability>,
        <https://w3id.org/lmodel/common-domain-model/GovernmentalAuthorityDefault>,
        <https://w3id.org/lmodel/common-domain-model/Illiquidity>,
        <https://w3id.org/lmodel/common-domain-model/MaterialChangeInCircumstance>,
        <https://w3id.org/lmodel/common-domain-model/Nationalization>,
        <https://w3id.org/lmodel/common-domain-model/PriceMateriality>,
        <https://w3id.org/lmodel/common-domain-model/SpecificInconvertibility>,
        <https://w3id.org/lmodel/common-domain-model/SpecificNonTransferability> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/SpecificNonTransferability> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/EscrowArrangement> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/escrowArrangement"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/time> a linkml:SlotDefinition,
        linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\".",
        "URI is dateTime because OWL reasoners do not work with straight date or time" ;
    skos:exactMatch "schema:Time"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI,
        "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:base "XSDTime" ;
    linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI,
        "https://w3id.org/lmodel/common-domain-model/time"^^xsd:anyURI ;
    linkml:description "A time object represents a (local) time of day, independent of any particular day",
        "The observation time." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FeaturePayment>,
        <https://w3id.org/lmodel/common-domain-model/TimeZone>,
        <https://w3id.org/lmodel/common-domain-model/ValuationTime> ;
    linkml:imported_from "linkml:types" ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FeaturePayment> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/time> ;
    linkml:repr "str" ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/time"^^xsd:anyURI ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/AdjustableDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:AdjustableDates"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AdjustableDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdjustedDate — if adjustedDate is absent then unadjustedDate exists and dateAdjustments exists",
        "Rosetta func: AdjustableDatesResolution — Prioritization of unadjustedDate over adjustedDate." ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustedDate> ] ;
            linkml:description "FpML specifies a choice between adjustedDate and [unadjustedDate (required), dateAdjutsments (required), adjustedDate (optional)]." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dateAdjustments>,
                        <https://w3id.org/lmodel/common-domain-model/unadjustedDate> ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "[{\"name\":\"AdjustableDatesResolution\",\"description\":\"Prioritization of unadjustedDate over adjustedDate.\",\"inputs\":[{\"name\":\"adjustableDates\",\"type\":\"AdjustableDates\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"0..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdjustableDates"^^xsd:anyURI ;
    linkml:description "A class for defining a series of dates that shall be subject to adjustment if they would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the dates." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AdjustableDates_adjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableDates_unadjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/dateAdjustments> .

