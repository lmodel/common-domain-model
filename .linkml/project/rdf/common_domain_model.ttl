    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/nonDeliverableSubstitute"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/product> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/product"^^xsd:anyURI ;
    linkml:description "Defines the financial product to be executed and contract formed." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AggregationParameters>,
        <https://w3id.org/lmodel/common-domain-model/ExcludedProducts>,
        <https://w3id.org/lmodel/common-domain-model/ExecutionInstruction>,
        <https://w3id.org/lmodel/common-domain-model/PositionBase>,
        <https://w3id.org/lmodel/common-domain-model/TermsChangeInstruction>,
        <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
