    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/debtTypes"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/deemedEffectiveNextLBD> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/deemedEffectiveNextLBD"^^xsd:anyURI ;
    linkml:description "Specifies if notice shall be deemed to be effective at the time such notice is actually received unless such notice is received on a day which is not a Local Business Day or after the Notification Time on any Local Business Day in which event such notice shall be deemed to be effective on the next succeeding Local Business Day. If deemed effective,'True'. If not deemed effective, or not stated,'False'." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DemandsAndNotices> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/DemandsAndNotices> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/deemedEffectiveNextLBD"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/defaultRequirement> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/defaultRequirement"^^xsd:anyURI ;
    linkml:description "In relation to certain credit events, serves as a threshold for Obligation Acceleration, Obligation Default, Repudiation/Moratorium and Restructuring. Market standard is USD 10,000,000 (JPY 1,000,000,000 for all Japanese Yen trades). This is applied on an aggregate or total basis across all Obligations of the Reference Entity. Used to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Default Requirement." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditEvents> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/defaultRequirement"^^xsd:anyURI .

