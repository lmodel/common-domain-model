	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/standardElection"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliveryCapacity> a linkml:SlotDefinition ;
	linkml:description "The number of units included in the transaction for each delivery interval" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Quantity> .
<https://w3id.org/lmodel/common-domain-model/deliveryDate> a linkml:SlotDefinition ;
	linkml:description "Specifies the specific contract date for the contract that should be referenced for a price." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableDate> ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/deliveryDateExpirationConvention> a linkml:SlotDefinition ;
	linkml:description "Specifies, for a Commodity Transaction that references a listed future, the day on which the specified future will expire ahead of the actual expiration of the referenced future. For example: Z21 Contract expires on 19Nov21, with an adjust of 2D the 'expire' will be 16Nov21. DeliveryDateRollConvention takes precedence. Example: Pricing on the Z21 Contract with NearbyContractDay and a deliveryDateRoll of 10D, Sampling of the F22 Contract will occur on 8Nov21 through the last Date of the Z21 Contract. With an ExpConvention of 5D, the last sampling date on the F22 contract will be 12Nov21." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> .
<https://w3id.org/lmodel/common-domain-model/deliveryDateParameters__deliveryDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "deliveryDate" ;
	linkml:description "Specifies the specific contract date for the contract that should be referenced for a price." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableDate> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/deliveryDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/deliveryDateParameters__deliveryDateExpirationConvention> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
	skos:prefLabel "deliveryDateExpirationConvention" ;
	linkml:description "Specifies, for a Commodity Transaction that references a listed future, the day on which the specified future will expire ahead of the actual expiration of the referenced future. For example: Z21 Contract expires on 19Nov21, with an adjust of 2D the 'expire' will be 16Nov21. DeliveryDateRollConvention takes precedence. Example: Pricing on the Z21 Contract with NearbyContractDay and a deliveryDateRoll of 10D, Sampling of the F22 Contract will occur on 8Nov21 through the last Date of the Z21 Contract. With an ExpConvention of 5D, the last sampling date on the F22 contract will be 12Nov21." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliveryDateParameters> ;
