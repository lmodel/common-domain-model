    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/initialStockLoanRate"^^xsd:anyURI ;
    linkml:description "Specifies the initial stock loan per ISDA Def. A percentage of 5% is represented as 0.05." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AdditionalDisruptionEvents> ;
    linkml:maximum_value "1"^^<https://w3id.org/linkml/@id> ;
    linkml:minimum_value "0"^^<https://w3id.org/linkml/@id> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/AdditionalDisruptionEvents> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
