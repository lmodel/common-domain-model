                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/qualification> ] ;
            linkml:description "The Pledgor/Obligor/Chargor Additional Rights should be qualified only when the Pledgor Additional Rights Event election is specified as applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isApplicable> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdditionalRightsEvent"^^xsd:anyURI ;
    linkml:description "A class to specify the Pledgor/Obligor/Chargor Additional Rights Event election." ;
