<https://w3id.org/lmodel/common-domain-model/ratingMultiplier__exposureMultiplier> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
