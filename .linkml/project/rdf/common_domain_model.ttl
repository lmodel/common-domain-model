	skos:prefLabel "offsetDays" ;
	linkml:description "The number of business days offset." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/OffsetCalculation> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/OffsetCalculation> ;
