            linkml:range <https://w3id.org/lmodel/common-domain-model/CommodityPayout> ],
        [ a linkml:AnonymousSlotExpression ;
            linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ],
        [ a linkml:AnonymousSlotExpression ;
            linkml:range <https://w3id.org/lmodel/common-domain-model/FixedPricePayout> ],
        [ a linkml:AnonymousSlotExpression ;
            linkml:range <https://w3id.org/lmodel/common-domain-model/OptionPayout> ],
        [ a linkml:AnonymousSlotExpression ;
            linkml:range <https://w3id.org/lmodel/common-domain-model/InterestRatePayout> ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/payout"^^xsd:anyURI ;
