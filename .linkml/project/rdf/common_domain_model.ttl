	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/additionalInformation"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/noticeContactInformation__naturalPerson> a linkml:SlotDefinition ;
