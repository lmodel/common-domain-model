    skos:note "Rosetta func: Create_Valuation — Function specification to incorporate a new assessment of the valuation in the valuation history of a given trade state." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_Valuation\",\"description\":\"Function specification to incorporate a new assessment of the valuation in the valuation history of a given trade state.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"ValuationInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"before\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"after\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ValuationInstruction"^^xsd:anyURI ;
    linkml:description "Specifies inputs needed to process a valuation." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ValuationInstruction_valuation>,
        <https://w3id.org/lmodel/common-domain-model/replace> .

<https://w3id.org/lmodel/common-domain-model/businessCenter> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#BusinessCenters.businessCenter"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_scheme"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/businessCenter"^^xsd:anyURI ;
    linkml:description "A code identifying one or several business day calendar location(s). The set of business day calendar locations are specified by the business day calendar location enumeration which is maintained by the FpML standard." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/BusinessCenterTime>,
        <https://w3id.org/lmodel/common-domain-model/BusinessCenters>,
        <https://w3id.org/lmodel/common-domain-model/CalculationFrequency>,
        <https://w3id.org/lmodel/common-domain-model/CreditEventNotice>,
        <https://w3id.org/lmodel/common-domain-model/ExerciseNotice>,
        <https://w3id.org/lmodel/common-domain-model/ValuationCalculationDateLocationElection> ;
    linkml:inlined_as_list true ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ExerciseNotice> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessCenter> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/businessCenter"^^xsd:anyURI .

