        <https://w3id.org/lmodel/common-domain-model/settlementDate> .

<https://w3id.org/lmodel/common-domain-model/BusinessCenter> a linkml:TypeDefinition ;
    rdfs:seeAlso "http://www.fpml.org/coding-scheme/business-center"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_codelist"^^xsd:anyURI ;
    linkml:base "str" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/BusinessCenter"^^xsd:anyURI ;
    linkml:description "FpML coding scheme constrained to domain 'business-center'" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/BusinessCenters> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:BusinessCenters"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:BusinessCenters"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: BusinessCentersChoice — required choice businessCenter, businessCentersReference, commodityBusinessCalendar",
        "Rosetta func: GetAllBusinessCenters — Returns a merged list of BusinessCenter codes for the supplied BusinessCenters." ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/businessCentersReference> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/commodityBusinessCalendar> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/businessCenter> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"GetAllBusinessCenters\",\"description\":\"Returns a merged list of BusinessCenter codes for the supplied BusinessCenters.\",\"inputs\":[{\"name\":\"businessCenters\",\"type\":\"BusinessCenters\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"businessCenterCodes\",\"type\":\"BusinessCenter\",\"cardinality\":\"0..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/BusinessCenters"^^xsd:anyURI ;
    linkml:description "A class for specifying the business day calendar location used in determining whether a day is a business day or not, either by specifying this business center by reference to an enumerated list that is maintained by the FpML standard, or by reference to such specification when it exists elsewhere as part of the instance document. This class corresponds to the FpML BusinessCentersOrReference.model." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/businessCenter>,
        <https://w3id.org/lmodel/common-domain-model/businessCentersReference>,
        <https://w3id.org/lmodel/common-domain-model/commodityBusinessCalendar> .

<https://w3id.org/lmodel/common-domain-model/CSAThresholdVariableSet> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:closeMatch "fpml_5_10:CSAThresholdVariableSet"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CSAThresholdVariableSet"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: NameMustExist — if name exists then value exists",
        "Rosetta condition: ValueMustExist — if value exists then name exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ] ;
            linkml:description "If we have a value then we must also have a name." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/name> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/name> ] ;
            linkml:description "If we have a name then we must also have a value." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/value> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CSAThresholdVariableSet"^^xsd:anyURI ;
    linkml:description "Defines a combination of Rating Agency, Rating Value, Threshold amount and Currency code." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CSAThresholdVariableSet_amount>,
        <https://w3id.org/lmodel/common-domain-model/CSAThresholdVariableSet_name>,
        <https://w3id.org/lmodel/common-domain-model/CSAThresholdVariableSet_value> .

<https://w3id.org/lmodel/common-domain-model/CalculateTransferInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:closeMatch "fpml_5_10:CalculateTransferInstruction"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CalculateTransferInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: CalculateTransfer — Function specification to calculate a transfer, e.g. following a reset on a contract",
        "Rosetta func: Create_AssetTransfer — Defines how Transfer that represents an exchange of asset based on an asset payout, should be constructed.",
        "Rosetta func: Create_CashTransfer — Defines how Transfer that represents an exchange of cash, should be constructed.",
        "Rosetta func: ResolveTransfer — Defines how to calculate the amount due to be transferred after a Reset Event." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"CalculateTransfer\",\"description\":\"Function specification to calculate a transfer, e.g. following a reset on a contract\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"CalculateTransferInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"0..*\"}},{\"name\":\"Create_CashTransfer\",\"description\":\"Defines how Transfer that represents an exchange of cash, should be constructed.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"CalculateTransferInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_AssetTransfer\",\"description\":\"Defines how Transfer that represents an exchange of asset based on an asset payout, should be constructed.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"CalculateTransferInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}},{\"name\":\"ResolveTransfer\",\"description\":\"Defines how to calculate the amount due to be transferred after a Reset Event.\",\"inputs\":[{\"name\":\"instruction\",\"type\":\"CalculateTransferInstruction\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculateTransferInstruction"^^xsd:anyURI ;
    linkml:description "Defines the tradeState or payout on which to create a Transfer along with all necessary resets." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CalculateTransferInstruction_date>,
        <https://w3id.org/lmodel/common-domain-model/CalculateTransferInstruction_payout>,
        <https://w3id.org/lmodel/common-domain-model/payerReceiver>,
        <https://w3id.org/lmodel/common-domain-model/quantity>,
        <https://w3id.org/lmodel/common-domain-model/resets>,
        <https://w3id.org/lmodel/common-domain-model/tradeState> .

<https://w3id.org/lmodel/common-domain-model/CalculationAgent> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:closeMatch "fpml_5_10:CalculationAgent"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CalculationAgent"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: CalculationAgentChoice — optional choice calculationAgentParty, calculationAgentPartyEnum" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/calculationAgentPartyEnum> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/calculationAgentParty> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculationAgent"^^xsd:anyURI ;
    linkml:description "A class defining the ISDA calculation agent responsible for performing duties as defined in the applicable product definitions.",
        "Determined by the Calculation Agent.",
        "Specifies the party responsible for performing calculation agent duties as defined in the applicable product definition. As an indication, the role of Calculation Agent is key in regards of other roles, for mainly two reasons : first is that it is a fallback role i.e. whenever another role is not defined, then such role would be assumed by the Calculation Agent ; second is that related determination are not limited to Extraordinary Event per se i.e. any determinationr required in regards of Payout calculations for instance would fall on Calculation Agent, unless otherwise specified in Calculation Agent attached to Economic Terms.",
        "The Calculation Agent will determine what adjustment is required to offset any change to the economics of the trade. If the Calculation Agent cannot achieve this, the trade goes to Cancellation and Payment with the Calculation Agent deciding on the value of the cancellation fee. Adjustments may not be made to account solely for changes in volatility, expected dividends, stock loan rate or liquidity." ;
    linkml:meaning "http://www.fpml.org/coding-scheme/determination-method-3-4#CalculationAgent"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/calculationAgentBusinessCenter>,
        <https://w3id.org/lmodel/common-domain-model/calculationAgentParty>,
        <https://w3id.org/lmodel/common-domain-model/calculationAgentPartyEnum> .

<https://w3id.org/lmodel/common-domain-model/CashCollateralValuationMethod> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:closeMatch "fpml_5_10:CashCollateralValuationMethod"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CashCollateralValuationMethod"^^xsd:anyURI ;
