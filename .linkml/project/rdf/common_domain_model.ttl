    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: NamedAffiliate — if ratedParty = RatedPartyEnum -> NamedAffiliate then namedAffiliate exists",
        "Rosetta condition: NamedEntity — if ratedParty = RatedPartyEnum -> NamedEntity then namedEntity exists" ;
