	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/time"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/timestamp> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/common_domain_model_keys"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/timestamp"^^xsd:anyURI ;
	linkml:description "The CDM's timestamp attribute; each class's slot_usage gives its meaning." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CompositionStep> , <https://w3id.org/lmodel/common-domain-model/Valuation> , <https://w3id.org/lmodel/common-domain-model/WorkflowStep> , <https://w3id.org/lmodel/common-domain-model/WorkflowStepApproval> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/WorkflowStepApproval> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/timestamp"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/timezone> a linkml:SlotDefinition ;
	linkml:description "Any relevant time zone where specified." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessCenter> .
<https://w3id.org/lmodel/common-domain-model/total> a linkml:SlotDefinition ;
	linkml:description "Specifies the total quantity when the quantity itself is specified with a frequency." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Schedule> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/totalIneligibilityDate> a linkml:SlotDefinition ;
	linkml:description "Specifies the date from which all credit support provided by a party is treated as ineligible under the agreement." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/totalPosition> a linkml:SlotDefinition ;
	linkml:description "Specifies whether to calculate total position to given date, or only daily position for the given date." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/totalRatio> a linkml:SlotDefinition ;
	linkml:description "Specifies the total actual dividend payout ratio associated with the equity underlier. A ratio of 90% should be expressed at 0.90." ;
	linkml:maximum_value "1"^^linkml:\@id ;
	linkml:minimum_value "0"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/totalVolatilityCap> a linkml:SlotDefinition ;
	linkml:description "Volatility Cap Amount in accordance with the ISDA 2011 Equity Derivatives Definitions. This means the Volatility Cap Amount election is a number." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> .
<https://w3id.org/lmodel/common-domain-model/tradableProduct__adjustment> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "adjustment" ;
	linkml:description "Specifies the conditions that govern the adjustment to the quantity of a product being traded: e.g. execution, portfolio rebalancing etc. It is typically used in the context of Equity Swaps." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NotionalAdjustmentEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/adjustment"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tradableProduct__ancillaryParty> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "ancillaryParty" ;
	linkml:description "Specifies the parties with ancillary roles in the transaction. The product is agnostic to the actual parties involved in the transaction, with the party references abstracted away from the product definition and replaced by the AncillaryRoleEnum. The AncillaryRoleEnum can then be positioned in the product and this AncillaryParty type, which is positioned outside of the product definition, allows the AncillaryRoleEnum to be associated with an actual party reference." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AncillaryParty> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/ancillaryParty"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tradableProduct__counterparty> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "counterparty" ;
	linkml:annotations _:c14n841 ;
	linkml:description "Specifies the parties which are the two counterparties to the transaction. The product is agnostic to the actual parties to the transaction, with the party references abstracted away from the product definition and replaced by the counterparty enum (e.g. CounterpartyEnum values Party1 or Party2). The counterparty enum can then be positioned in the product (e.g. to specify which counterparty is the payer, receiver etc) and this counterparties attribute, which is positioned outside of the product definition, allows the counterparty enum to be associated with an actual party reference." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:maximum_cardinality 2 ;
	linkml:minimum_cardinality 2 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Counterparty> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/counterparty"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tradableProduct__product> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "product" ;
	linkml:description "The underlying product to be included in a contract or execution." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/NonTransferableProduct> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/product"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tradableProduct__tradeLot> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "tradeLot" ;
	linkml:description "Specifies the price, quantity and effective date of each trade lot, when the same product may be traded multiple times in different lots with the same counterparty. In a trade increase, a new trade lot is added to the list, with the corresponding effective date. In a trade decrease, the existing trade lot(s) are decreased of the corresponding quantity (and an unwind fee may have to be settled). The multiple cardinality and the ability to increase existing trades is used for Equity Swaps in particular." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradableProduct> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TradeLot> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/tradeLot"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/trade> a linkml:SlotDefinition ;
	linkml:description "Represents the Trade that has been effected by a business or life-cycle event." , "Represents the cosensus based pricing parameters on a trade basis." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Trade> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/tradeDate> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2672 , _:c14n2673 ;
	linkml:description "Denotes the trade/execution date." , "Specifies the date which the trade was agreed." , "The date the underlying trade was executed, used for referencing the relevant holiday calendars." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/tradeId> a linkml:SlotDefinition ;
	linkml:description "Identifier of the underlying trade to which this InstructionComposition relates." , "The identifier to be assigned to the new trade post change of party." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TradeIdentifier> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/tradeIdentifier> a linkml:SlotDefinition ;
	linkml:description "Denotes one or more identifiers associated with the transaction." , "Represents the identifier(s) that uniquely identify a trade for an identity issuer. A trade can include multiple identifiers, for example a trade that is reportable to both the CFTC and ESMA, and then has an associated USI (Unique Swap Identifier) UTI (Unique Trade Identifier)." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TradeIdentifier> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/tradeIdentifier__identifierType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
	skos:prefLabel "identifierType" ;
	linkml:description "The enumerated classification of the identifier. Optional as a trade identifier may be party-specific, in which case it may not correspond to any established classification." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradeIdentifier> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradeIdentifier> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TradeIdentifierTypeEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/identifierType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tradeInfo> a linkml:SlotDefinition ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/StandardizedScheduleTradeInfo> .
<https://w3id.org/lmodel/common-domain-model/tradeLot> a linkml:SlotDefinition ;
	linkml:description "Specifies the price, quantity and effective date of each trade lot, when the same product may be traded multiple times in different lots with the same counterparty. In a trade increase, a new trade lot is added to the list, with the corresponding effective date. In a trade decrease, the existing trade lot(s) are decreased of the corresponding quantity (and an unwind fee may have to be settled). The multiple cardinality and the ability to increase existing trades is used for Equity Swaps in particular." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TradeLot> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/tradeLot__lotIdentifier> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "lotIdentifier" ;
	linkml:description "Specifies one or more identifiers for the lot, if any." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradeLot> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradeLot> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Identifier> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/lotIdentifier"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tradeLot__priceQuantity> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "priceQuantity" ;
	linkml:description "Specifies the settlement characteristics of a trade lot: price, quantity, observable (optionally) and the settlement terms. This attribute has a multiple cardinality to allow to specify the price, quantity and observable of different legs in a single, composite product (e.g. a Swap)." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradeLot> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradeLot> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/priceQuantity"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tradePortfolio> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2133 ;
	linkml:description "Represents a Portfolio that describes all the positions held at a given time, in various states which can be either traded, settled, etc., with lineage information to the previous state." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PortfolioState> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/tradePricingReport__discountingIndex> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
	skos:prefLabel "discountingIndex" ;
	linkml:description "It specifies the interest payable on collateral delivered under a CSA covering the trade." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradePricingReport> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradePricingReport> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/discountingIndex"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/tradePricingReport__pricingTime> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
	skos:prefLabel "pricingTime" ;
	linkml:description "The regional exchange close time for the underlying contract,including time zone, at which the trades should be priced. This provides an indication for which regional snapshot should be used for pricing primarily for Global markets where there are multiple regional close times." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/TradePricingReport> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/TradePricingReport> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TimeZone> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/pricingTime"^^xsd:anyURI .
