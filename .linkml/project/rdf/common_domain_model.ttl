        <https://w3id.org/lmodel/common-domain-model/NonLegalEntity>,
        <https://w3id.org/lmodel/common-domain-model/PartyIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/PersonIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/PositionIdentifier>,
        <https://w3id.org/lmodel/common-domain-model/TradeIdentifier> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/NonLegalEntity> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/AssetIdTypeEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/identifierType"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/other> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CollateralRounding.other"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/other"^^xsd:anyURI ;
    linkml:description "Utilised where the clause data structure is not able to capture a material aspect of the clause." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CollateralRounding>,
        <https://w3id.org/lmodel/common-domain-model/MinimumTransferAmountElection>,
        <https://w3id.org/lmodel/common-domain-model/SecurityInterestForObligations>,
        <https://w3id.org/lmodel/common-domain-model/SinglePostingParty>,
        <https://w3id.org/lmodel/common-domain-model/ThresholdElection> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/MinimumTransferAmountElection> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/other"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/periodMultiplier> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta: strictly greater than" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/periodMultiplier"^^xsd:anyURI ;
    linkml:description "A time period multiplier, e.g. 1, 2, or 3. If the period value is T (Term) then period multiplier must contain the value 1." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Frequency>,
        <https://w3id.org/lmodel/common-domain-model/Period>,
        <https://w3id.org/lmodel/common-domain-model/Velocity> ;
    linkml:equals_string "1" ;
    linkml:minimum_value "0"^^<https://w3id.org/linkml/@id> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/Velocity> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
    linkml:required true ;
