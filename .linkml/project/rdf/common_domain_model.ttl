    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/outlook"^^xsd:anyURI ;
    linkml:description "Assesses the potential direction of a long-term credit rating over the intermediate term, which is generally up to two years for investment grade and generally up to one year for speculative grade." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditNotation> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CreditNotation> ;
