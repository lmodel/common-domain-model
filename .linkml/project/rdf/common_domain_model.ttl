                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/callType> ] ;
            linkml:description "Represents a condition to ensure that a visibility indicator is specifies then the call type must be an expected call." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/visibilityIndicator> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/MarginCallInstructionType"^^xsd:anyURI ;
    linkml:description "Represents enumeration values to specify the call notification type, direction, specific action type." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/callType>,
        <https://w3id.org/lmodel/common-domain-model/visibilityIndicator> .

