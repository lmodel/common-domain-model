<https://w3id.org/lmodel/common-domain-model/pCDeliverableObligationCharac__partialCashSettlement> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "partialCashSettlement" ;
	linkml:description "Specifies whether either 'Partial Cash Settlement of Assignable Loans', 'Partial Cash Settlement of Consent Required Loans' or 'Partial Cash Settlement of Participations' is applicable. If this element is specified and Assignable Loan is a Deliverable Obligation Characteristic, any Assignable Loan that is deliverable, but where a non-receipt of Consent by the Physical Settlement Date has occurred, the Loan can be cash settled rather than physically delivered. If this element is specified and Consent Required Loan is a Deliverable Obligation Characteristic, any Consent Required Loan that is deliverable, but where a non-receipt of Consent by the Physical Settlement Date has occurred, the Loan can be cash settled rather than physically delivered. If this element is specified and Direct Loan Participation is a Deliverable Obligation Characteristic, any Participation that is deliverable, but where this participation has not been effected (has not come into effect) by the Physical Settlement Date, the participation can be cash settled rather than physically delivered." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PCDeliverableObligationCharac> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PCDeliverableObligationCharac> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/partialCashSettlement"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/packageInformation> a linkml:SlotDefinition ;
	linkml:description "Specifies the package information in case the business event represents several trades executed as a package (hence this attribute is optional). The package information is only instantiated once at the business event level to preserve referential integrity, whereas individual trades make reference to it to identify that they are part of a package." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/IdentifiedList> .
<https://w3id.org/lmodel/common-domain-model/packageReference> a linkml:SlotDefinition ;
	linkml:description "A reference to the package linking the trade with other trades, in case the trade was executed as part of a package (hence this attribute is optional)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/IdentifiedList> .
<https://w3id.org/lmodel/common-domain-model/parametricDates> a linkml:SlotDefinition ;
	linkml:description "Defines rules for the dates on which the price will be determined." , "Specifies parametric terms to determine which days within a given calculation period the price would be observed. Typically associated with Commodities." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/parametricDates__businessCenters> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "businessCenters" ;
	linkml:description "The enumerated values to specify the business centers." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessCenters> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/businessCenters"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/parametricDates__dayDistribution> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "dayDistribution" ;
	linkml:description "Denotes the method by which the pricing days are distributed across the pricing period." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DayDistributionEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dayDistribution"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/parametricDates__dayFrequency> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "dayFrequency" ;
	linkml:description "Defines the occurrence of the dayOfWeek within the pricing period on which pricing will take place, e.g. the 3rd Friday within each Calculation Period. If omitted, every dayOfWeek will be a pricing day." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dayFrequency"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/parametricDates__dayOfWeek> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "dayOfWeek" ;
	linkml:description "Indicates the days of the week on which the price will be determined." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:maximum_cardinality 7 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DayOfWeekEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dayOfWeek"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/parametricDates__dayType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "dayType" ;
	linkml:description "Denotes the enumerated values to specify the day type classification used in counting the number of days between two dates." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ParametricDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/DayTypeEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/dayType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/parametricDates__lag> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "lag" ;
