<https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet_name> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:prefLabel "name" ;
    linkml:annotations [ linkml:metadata_scheme [ skos:example true ;
                    linkml:annotations [ ] ;
                    linkml:extensions [ ] ;
                    linkml:tag "metadata_scheme"^^xsd:anyURI ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/name"^^xsd:anyURI ;
    linkml:description "The name of the variable." ;
    linkml:domain <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/name> ;
    linkml:is_usage_slot true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/name"^^xsd:anyURI ;
    linkml:usage_slot_name "name" .

<https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet_value> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    skos:prefLabel "value" ;
