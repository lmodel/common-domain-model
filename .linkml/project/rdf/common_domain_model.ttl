<https://w3id.org/lmodel/common-domain-model/BespokeCalculationTime> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:closeMatch "fpml_5_10:BespokeCalculationTime"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:BespokeCalculationTime"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AsCalculationAgentIm — if asCalculationAgent = True then bespokeCalculationTimeTerms is absent",
        "Rosetta condition: BespokeCalculationTimeTerms — if asCalculationAgent = False then bespokeCalculationTimeTerms exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/asCalculationAgent> ] ;
            linkml:description "A data rule to enforce that the Calculation Time for Initial Margin shouldn't be specified when the Control Agreement isn't deemed a Credit Support Document with respect to the party(ies)." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/bespokeCalculationTimeTerms> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/asCalculationAgent> ] ;
            linkml:description "A data rule to enforce that the terms applicable to Calculation Time for Initial Margin should be specified when the computation time is not as per Calculation Agent." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/bespokeCalculationTimeTerms> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/BespokeCalculationTime"^^xsd:anyURI ;
    linkml:description "A class to specify additional Calculation Time terms for the purposes of Initial Margin." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/asCalculationAgent>,
        <https://w3id.org/lmodel/common-domain-model/bespokeCalculationTimeTerms> .

<https://w3id.org/lmodel/common-domain-model/BillingSummary> a linkml:ClassDefinition ;
