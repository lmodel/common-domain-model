<https://w3id.org/lmodel/common-domain-model/failureToPayPrincipal> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/failureToPayPrincipal"^^xsd:anyURI ;
    linkml:description "A credit event. Corresponds to the failure by the Reference Entity to pay an expected principal amount or the payment of an actual principal amount that is less than the expected principal amount. ISDA 2003 Term: Failure to Pay Principal." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CreditEvents>,
        <https://w3id.org/lmodel/common-domain-model/FloatingAmountEvents> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FloatingAmountEvents> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/failureToPayPrincipal"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/fallbackLanguageBespokeTerms> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction_additionalterms"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/fallbackLanguageBespokeTerms"^^xsd:anyURI ;
    linkml:description "Where parties may optionnaly describe any extra bespoke agreements about fallback procedure attached to a particular determination role. This fallback bespoke paragraph would typically address topics such as : delay for the Disputing Party to notify a disagreement when receiving a determination from the Calculation Agent ; Independent Third Party Dealers election terms e.g. number of Dealers to be jointly elected by the counterparties ; delay for joint election of Dealers by the counterparties ; further fallback election procedure in case of disagreement between parties to jointly elect all the Dealers e.g. typically each party designates 1 Dealer, each a Party Representant, which thus result in 2 Dealers in charge of joint election of 3 other Dealers who will be the final ones to provide the response, each a Final Dealer ; delay for joint election of the Final Dealers by the Party Representants ; fees repartition e.g. typically cost and fees incurred by the election of Dealers are equally shared by the parties ; etc." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/DeterminationRolesAndTerms>,
        <https://w3id.org/lmodel/common-domain-model/FxDisruptionEvents> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FxDisruptionEvents> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Clause> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fallbackLanguageBespokeTerms"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/feeAmount> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/feeAmount"^^xsd:anyURI ;
    linkml:description "The amount of fee to be paid on exercise. The fee currency is that of the referenced notional." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ExerciseFee> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ExerciseFee> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/feeAmount"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/feeAmountSchedule> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/feeAmountSchedule"^^xsd:anyURI ;
    linkml:description "The exercise fee amount schedule. The fees are expressed as currency amounts. The currency of the fee is assumed to be that of the notional schedule referenced." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/AmountSchedule> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/feeAmountSchedule"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/feePaymentDate> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/feePaymentDate"^^xsd:anyURI ;
    linkml:description "The date on which exercise fee(s) will be paid. It is specified as a relative date." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ExerciseFee>,
        <https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/RelativeDateOffset> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/feePaymentDate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/feeRate> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/feeRate"^^xsd:anyURI ;
    linkml:description "A fee represented as a percentage of some referenced notional. A percentage of 5% would be represented as 0.05." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ExerciseFee> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ExerciseFee> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/feeRate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/feeRateSchedule> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/feeRateSchedule"^^xsd:anyURI ;
    linkml:description "The exercise free rate schedule. The fees are expressed as percentage rates of the notional being exercised. The currency of the fee is assumed to be that of the notional schedule referenced." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ExerciseFeeSchedule> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Schedule> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/feeRateSchedule"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/finalRateRounding> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/finalRateRounding"^^xsd:anyURI ;
    linkml:description "The rounding convention to apply to the final rate used in determination of a calculation period amount." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FloatingRateSpecification> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FloatingRateSpecification> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Rounding> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/finalRateRounding"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/finalStub> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/finalStub"^^xsd:anyURI ;
    linkml:description "Specifies how the final stub amount is calculated. A single floating rate tenor different to that used for the regular part of the calculation periods schedule may be specified, or two floating tenors may be specified. If two floating rate tenors are specified then Linear Interpolation (in accordance with the 2000 ISDA Definitions, Section 8.3. Interpolation) is assumed to apply. Alternatively, an actual known stub rate or stub amount may be specified." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/StubCalculationPeriodAmount>,
        <https://w3id.org/lmodel/common-domain-model/StubPeriod> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/StubCalculationPeriodAmount> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/StubValue> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/finalStub"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/firstName> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/firstName"^^xsd:anyURI ;
    linkml:description "The natural person's first name. It is optional in FpML." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/NaturalPerson> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/NaturalPerson> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/firstName"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/firstPaymentDate> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/firstPaymentDate"^^xsd:anyURI ;
    linkml:description "The first unadjusted payment date. This day may be subject to adjustment in accordance with any business day convention specified in paymentDatesAdjustments. This element must only be included if there is an initial stub. This date will normally correspond to an unadjusted calculation period start or end date. This is true even if early or delayed payment is specified to be applicable since the actual first payment date will be the specified number of days before or after the applicable adjusted calculation period start or end date with the resulting payment date then being adjusted in accordance with any business day convention specified in paymentDatesAdjustments." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/firstPaymentDate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/firstRegularPeriodStartDate> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CalculationPeriodDates.firstRegularPeriodStartDate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/firstRegularPeriodStartDate"^^xsd:anyURI ;
    linkml:description "The start date of the regular part of the calculation period schedule. It must only be specified if there is an initial stub calculation period. This day may be subject to adjustment in accordance with any adjustments specified in calculationPeriodDatesAdjustments." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/CalculationPeriodDates> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/firstRegularPeriodStartDate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/fixedPaymentAmount> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/fixedPaymentAmount"^^xsd:anyURI ;
    linkml:description "A known fixed payment amount." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentCalculationPeriod> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentCalculationPeriod> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/fixedPaymentAmount"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/fixingOffsetDefinition> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#BusinessDayOffset.fixingOffsetDefinition"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset_fro"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/fixingOffsetDefinition"^^xsd:anyURI ;
    linkml:description "Legal text that underlies the Fixing Offset. ISDA Fixing Offset Definition. (e.g. One day that is either a Sydney Business Day or a Melbourne Business Day following the Reset Date)" ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/BusinessDayOffset> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/BusinessDayOffset> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
