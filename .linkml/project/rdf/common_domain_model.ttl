<https://w3id.org/lmodel/common-domain-model/totalVolatilityCap> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/totalVolatilityCap"^^xsd:anyURI ;
    linkml:description "Volatility Cap Amount in accordance with the ISDA 2011 Equity Derivatives Definitions. This means the Volatility Cap Amount election is a number." ;
