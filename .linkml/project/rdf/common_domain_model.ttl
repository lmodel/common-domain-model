    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/returnAmount"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/role> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/role"^^xsd:anyURI ;
    linkml:description "Specifies the CounterpartyEnum, e.g. either Party1 or Party2, that is associated to the partyReference." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AncillaryParty>,
        <https://w3id.org/lmodel/common-domain-model/Counterparty>,
