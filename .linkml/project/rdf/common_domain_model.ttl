    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/payer"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/payout> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
