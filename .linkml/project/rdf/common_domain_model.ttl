	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
	skos:prefLabel "day" ;
	linkml:description "The day in respect of which the Valuation Time is being specified. If not specified, addional language must be used to define the methodology." ;
