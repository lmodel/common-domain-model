        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(e)\" name \" Conditions Precedent\"",
        "ISDA CSA_NewYork_1994 paragraph \"13\" clause \"(d)\" name \"Conditions Precedent and Secured Partys Rights and Remedies.\"",
        "ISDA CSA_VM_2016 paragraph \"13\" clause \"(e)\" name \"Conditions Precedent and Secured Partys Rights and Remedies\"",
        "ISDA CSA_VM_2016 paragraph \"4\" clause \"(a)\"",
        "ISDA CSD_English_1995 paragraph \"13\" clause \"(e)\" name \"Conditions Precedent and Secured Partys Rights and Remedies.\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(e)\" name \" Conditions Precedent\"",
        "ISDA CSD_IM_English_2018 paragraph \"13 General Principles\" clause \"(e)\" name \" Conditions Precedent\"" ;
    skos:exactMatch "common_domain_model:ConditionsPrecedent"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: CustomProvision — if customProvision exists then conditionsPrecedentElection = ExceptionEnum -> Other" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ConditionsPrecedent"^^xsd:anyURI ;
    linkml:description "A class to specify the two set of elections that may overwrite the default Condition Precedent provision." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ConditionsPrecedent_customProvision>,
        <https://w3id.org/lmodel/common-domain-model/conditionsPrecedentElection>,
        <https://w3id.org/lmodel/common-domain-model/specifiedConditionOrAccessCondition> .

<https://w3id.org/lmodel/common-domain-model/CreditSupportAmount> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:CreditSupportAmount"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdditionalLanguage — if creditSupportAmount = CreditSupportAmountEnum -> NonStandardOther then additionalLanguage exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/creditSupportAmount> ] ;
            linkml:description "If a Non Standard Other definition is defined, additional language must be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CreditSupportAmount"^^xsd:anyURI ;
    linkml:description "The total amount one counterparty must deliver to the other at any time: the combination of the Exposure to that party and the net Independent Amounts it must post, minus any agreed Threshold." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CreditSupportAmount_additionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/CreditSupportAmount_creditSupportAmount> .

<https://w3id.org/lmodel/common-domain-model/CreditSupportProviderElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:CreditSupportProviderElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: CreditSupportProvider — if creditSupportProviderTerms = CreditSupportProviderTermsEnum -> Specified then creditSupportProvider exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/creditSupportProviderTerms> ] ;
            linkml:description "A validation rule to ensure that a Credit Support Provider is specified when required." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/creditSupportProvider> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CreditSupportProviderElection"^^xsd:anyURI ;
    linkml:description "The party election of Credit Support Provider(s), if any." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CreditSupportProviderElection_party>,
        <https://w3id.org/lmodel/common-domain-model/bespokeCreditSuppportProvider>,
        <https://w3id.org/lmodel/common-domain-model/creditSupportProvider>,
        <https://w3id.org/lmodel/common-domain-model/creditSupportProviderTerms> .

<https://w3id.org/lmodel/common-domain-model/DatedValue> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_math> ;
    skos:exactMatch "common_domain_model:DatedValue"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    skos:note "Rosetta func: UpdateDatedValues — Updates the amounts of the dated values based on the given QuantityChangeDirectionEnum. For all periods after the effective date of the change, if the direction is Increase, the old amount and change amount are summed, if the direction is Decrease, then the change amount is subtracted from the old amount, and if the direction is Replace then the change amount replaces the old amount." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "[{\"name\":\"UpdateDatedValues\",\"description\":\"Updates the amounts of the dated values based on the given QuantityChangeDirectionEnum. For all periods after the effective date of the change, if the direction is Increase, the old amount and change amount are summed, if the direction is Decrease, then the change amount is subtracted from the old amount, and if the direction is Replace then the change amount replaces the old amount.\",\"inputs\":[{\"name\":\"datedValues\",\"type\":\"DatedValue\",\"cardinality\":\"0..*\"},{\"name\":\"changeAmount\",\"type\":\"number\",\"cardinality\":\"0..1\"},{\"name\":\"direction\",\"type\":\"QuantityChangeDirectionEnum\",\"cardinality\":\"1..1\"},{\"name\":\"effectiveDate\",\"type\":\"date\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"newdatedValues\",\"type\":\"DatedValue\",\"cardinality\":\"0..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/DatedValue"^^xsd:anyURI ;
    linkml:description "Defines a date and value pair. This definition is used for varying rate or amount schedules, e.g. a notional amortisation or a step-up coupon schedule." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/DatedValue_date>,
        <https://w3id.org/lmodel/common-domain-model/DatedValue_value> .

<https://w3id.org/lmodel/common-domain-model/DebtEconomics> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:DebtEconomics"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/DebtEconomics"^^xsd:anyURI ;
    linkml:description "Specifies selected economics of a debt security." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/interest>,
        <https://w3id.org/lmodel/common-domain-model/principal>,
        <https://w3id.org/lmodel/common-domain-model/redemption>,
        <https://w3id.org/lmodel/common-domain-model/secured>,
        <https://w3id.org/lmodel/common-domain-model/seniority> .

<https://w3id.org/lmodel/common-domain-model/EarlyTerminationProvision> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:EarlyTerminationProvision"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: MandatoryEarlyTermination — (mandatoryEarlyTermination exists or optionalEarlyTermination exists) or (mandatoryEarlyTermination exists and optionalEarlyTermination exists)" ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EarlyTerminationProvision"^^xsd:anyURI ;
    linkml:description "A data defining:  an early termination provision for a swap. This early termination is at fair value, i.e. on termination the fair value of the product must be settled between the parties.",
        "The intent is to fully unwind the Trade, as a result of the application of Trade contractual terms (e.g. an obligation to do so before Termination Date as part of any kind of Early Termination terms) as defined within the CDM EarlyTerminationProvision data type. Accordingly, increase and decrease of positions which result from negotiation by the parties shall not be designated by such intentEnum. For clarity, partial exercise of an option before its expiration date is excluded as well, though related to Trade contract terms, because a dedicated intentEnum value exists for this event i.e. OptionExercise value." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/mandatoryEarlyTermination>,
        <https://w3id.org/lmodel/common-domain-model/mandatoryEarlyTerminationDateTenor>,
        <https://w3id.org/lmodel/common-domain-model/optionalEarlyTermination>,
        <https://w3id.org/lmodel/common-domain-model/optionalEarlyTerminationParameters> .

<https://w3id.org/lmodel/common-domain-model/EligibilityToHoldCollateral> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_VM_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_VM_2016 paragraph \"13\" clause \" (h)(i)\" name \"Eligibility to Hold Posted Collateral (VM) Custodians (VM)\"" ;
    skos:exactMatch "common_domain_model:EligibilityToHoldCollateral"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: Custodian — if custodianEligibility = True then initialCustodian exists else initialCustodian is absent and custodianCondition is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/custodianEligibility> ] ;
            linkml:description "A condition to ensure that if a Custodian is eligible to hold collateral, the Initial Custodian must be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/initialCustodian> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EligibilityToHoldCollateral"^^xsd:anyURI ;
    linkml:description "Specifies the conditions under which a party and its custodian(s) are entitled to hold collateral." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/criteria>,
        <https://w3id.org/lmodel/common-domain-model/custodianCondition>,
        <https://w3id.org/lmodel/common-domain-model/custodianEligibility>,
        <https://w3id.org/lmodel/common-domain-model/eligibleCountry>,
        <https://w3id.org/lmodel/common-domain-model/initialCustodian> .

<https://w3id.org/lmodel/common-domain-model/EligibleCollateralCriteria> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:exactMatch "common_domain_model:EligibleCollateralCriteria"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta condition: AverageTradingVolumeEquityOnly — if treatment -> concentrationLimit -> concentrationLimitCriteria -> averageTradingVolume exists then CriteriaMatchesSecurityType(collateralCriteria, Equity) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType( item -> concentrationLimitCriteria -> collateralCriteria, Equity )) all = True",
        "Rosetta condition: ConcentrationLimitTypeIssueOSAmountDebtOnly — if treatment -> concentrationLimit -> concentrationLimitCriteria -> concentrationLimitType only-element = ConcentrationLimitTypeEnum -> IssueOutstandingAmount then CriteriaMatchesSecurityType(collateralCriteria, Debt) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType( item -> concentrationLimitCriteria -> collateralCriteria, Debt )) all = True",
        "Rosetta condition: ConcentrationLimitTypeMarketCapEquityOnly — if treatment -> concentrationLimit -> concentrationLimitCriteria -> concentrationLimitType only-element = ConcentrationLimitTypeEnum -> MarketCapitalisation then CriteriaMatchesSecurityType(collateralCriteria, Equity) or (treatment -> concentrationLimit extract CriteriaMatchesSecurityType( item -> concentrationLimitCriteria -> collateralCriteria, Equity )) all = True" ;
    skos:relatedMatch "gist:Specification"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EligibleCollateralCriteria"^^xsd:anyURI ;
    linkml:description "Represents a set of criteria used to specify eligible collateral." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/CollateralCriteriaBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/EligibleCollateralCriteria_treatment>,
        <https://w3id.org/lmodel/common-domain-model/appliesTo>,
        <https://w3id.org/lmodel/common-domain-model/collateralCriteria>,
        <https://w3id.org/lmodel/common-domain-model/ratingPriorityResolution>,
        <https://w3id.org/lmodel/common-domain-model/restrictTo> .

<https://w3id.org/lmodel/common-domain-model/EquitySwapMasterConfirmation2018> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction> ;
