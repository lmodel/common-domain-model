    skos:note "Rosetta condition: BusinessCentersChoice — optional choice businessCenters, businessCentersReference",
        "Rosetta condition: DateChoice — required choice dateRelativeToPaymentDates, dateRelativeToCalculationPeriodDates" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
