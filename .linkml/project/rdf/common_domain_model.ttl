<https://w3id.org/lmodel/common-domain-model/minimumNumberOfOptions> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/minimumNumberOfOptions"^^xsd:anyURI ;
