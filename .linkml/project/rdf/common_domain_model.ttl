	linkml:description "The cashflow representation of the swap stream." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CashflowRepresentation> .
<https://w3id.org/lmodel/common-domain-model/cashflowRepresentation__cashflowsMatchParameters> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "cashflowsMatchParameters" ;
	linkml:description "A true/false flag to indicate whether the cashflows match the parametric definition of the stream, i.e. whether the cashflows could be regenerated from the parameters without loss of information." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CashflowRepresentation> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CashflowRepresentation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/cashflowsMatchParameters"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/cashflowRepresentation__paymentCalculationPeriod> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
	skos:prefLabel "paymentCalculationPeriod" ;
	linkml:description "The adjusted payment date and associated calculation period parameters required to calculate the actual or projected payment amount. A list of payment calculation period elements may be ordered in the document by ascending adjusted payment date. An FpML document containing an unordered list of payment calculation periods is still regarded as a conformant document." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CashflowRepresentation> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/CashflowRepresentation> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PaymentCalculationPeriod> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentCalculationPeriod"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/cashflowsMatchParameters> a linkml:SlotDefinition ;
	linkml:description "A true/false flag to indicate whether the cashflows match the parametric definition of the stream, i.e. whether the cashflows could be regenerated from the parameters without loss of information." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/category> a linkml:SlotDefinition ;
	linkml:description "The ISDA FRO category (e.g. screen rate or calculated rate)." , "Used in both obligations and deliverable obligations to represent a class or type of securities which apply. ISDA 2003 Term: Obligation Category/Deliverable Obligation Category." ;
	linkml:equals_string "ReferenceObligationsOnly" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FloatingRateIndexCategoryEnum> , <https://w3id.org/lmodel/common-domain-model/ObligationCategoryEnum> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/change> a linkml:SlotDefinition ;
	linkml:description "Quantity by which the trade is being increased, decreased or replaced, and the price at which such quantity change is agreed. The quantity change should always be specified as a positive number, with the direction (increase/decrease/replacement) being specified by the direction enumeration. A fee can also be associated to the quantity change by specifying a Price component of type CashPrice, including the corresponding settlement date and direction." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PriceQuantity> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/changeInLaw> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
