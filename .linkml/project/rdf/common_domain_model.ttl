	skos:prefLabel "settlementCentre" ;
	linkml:deprecated "Marked [deprecated] in the CDM." ;
	linkml:description "Optional settlement centre as an enumerated list: Euroclear, Clearstream." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementCentreEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/settlementCentre"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementBase__settlementCurrency> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "settlementCurrency" ;
	linkml:annotations _:c14n1379 , _:c14n441 ;
	linkml:description "The settlement currency is to be specified when the Settlement Amount cannot be known in advance. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/settlementCurrency"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementBase__settlementDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "settlementDate" ;
	linkml:description "The date on which the settlement amount will be paid, subject to adjustment in accordance with any applicable business day convention. This component would not be present for a mandatory early termination provision where the cash settlement payment date is the mandatory early termination date." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/settlementDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementBase__settlementProvision> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "settlementProvision" ;
	linkml:description "Optionally defines the parameters that regulate a settlement." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementProvision> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/settlementProvision"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementBase__settlementType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "settlementType" ;
	linkml:description "Whether the settlement will be cash, physical, by election, ..." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementTypeEnum> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/settlementType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementBase__standardSettlementStyle> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "standardSettlementStyle" ;
	linkml:description "Settlement Style." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/StandardSettlementStyleEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/standardSettlementStyle"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementBase__transferSettlementType> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "transferSettlementType" ;
	linkml:description "The qualification as to how the transfer will settle, e.g. a DvP settlement." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementBase> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/TransferSettlementEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/transferSettlementType"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementCentre> a linkml:SlotDefinition ;
	linkml:deprecated "Marked [deprecated] in the CDM." ;
	linkml:description "Optional settlement centre as an enumerated list: Euroclear, Clearstream." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementCentreEnum> .
<https://w3id.org/lmodel/common-domain-model/settlementCurrency> a linkml:SlotDefinition ;
	linkml:annotations _:c14n1115 , _:c14n53 ;
	linkml:description "The settlement currency is to be specified when the Settlement Amount cannot be known in advance. The list of valid currencies is not presently positioned as an enumeration as part of the CDM because that scope is limited to the values specified by ISDA and FpML. As a result, implementers have to make reference to the relevant standard, such as the ISO 4217 standard for currency codes." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> .
<https://w3id.org/lmodel/common-domain-model/settlementDate> a linkml:SlotDefinition ;
	linkml:description "Represents the date on which the transfer to due." , "Specifies the settlement date of securities. In a repo transaction the purchase date would always be the effective date as specified under Economic Terms, the repurchase date would always be the termination date as specified under Economic Terms." , "The date for settlement of the transfer." , "The date on which the settlement amount will be paid, subject to adjustment in accordance with any applicable business day convention. This component would not be present for a mandatory early termination provision where the cash settlement payment date is the mandatory early termination date." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedOrRelativeDate> , <https://w3id.org/lmodel/common-domain-model/AdjustableOrRelativeDate> , <https://w3id.org/lmodel/common-domain-model/AdjustedRelativeDateOffset> , <https://w3id.org/lmodel/common-domain-model/SettlementDate> , <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/settlementDate__adjustableDates> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "adjustableDates" ;
	linkml:description "A series of dates that shall be subject to adjustment if they would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the date. This attributes was formerly part of 'CashSettlementPaymentDate' as included into 'OptionCashSettlement' (which is now merged into a unique 'CashSettlementTerms' data type." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableDates> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/adjustableDates"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementDate__adjustableOrRelativeDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "adjustableOrRelativeDate" ;
	linkml:description "A single settlement date subject to adjustment or specified as relative to another date (e.g. the trade date). This attribute was formerly part of 'SettlementTerms', which is now being harmonised to include a common 'SettlementDate', as inherited from 'SettlementBase'." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedOrRelativeDate> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/adjustableOrRelativeDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementDate__businessDateRange> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "businessDateRange" ;
	linkml:description "A range of contiguous business days. This attribute is meant to be merged with the 'settlementDate' at some future point once we refactor 'Date' to use a single complex type across the model. This attributes was formerly part of 'CashSettlementPaymentDate', as included into 'OptionCashSettlement' (which is now merged into a unique 'CashSettlementTerms' data type." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessDateRange> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/businessDateRange"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementDate__cashSettlementBusinessDays> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "cashSettlementBusinessDays" ;
	linkml:description "The number of business days used in the determination of the cash settlement payment date. If a cash settlement amount is specified, the cash settlement payment date will be this number of business days following the calculation of the final price. If a cash settlement amount is not specified, the cash settlement payment date will be this number of business days after all conditions to settlement are satisfied. ISDA 2003 Term: Cash Settlement Date. This attribute was formerly part of 'CashSettlementTerms' as used for credit event settlement, which now includes a common 'SettlementDate' attribute." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/cashSettlementBusinessDays"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementDate__paymentDelay> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "paymentDelay" ;
	linkml:description "Applicable to CDS on MBS to specify whether payment delays are applicable to the fixed Amount. RMBS typically have a payment delay of 5 days between the coupon date of the reference obligation and the payment date of the synthetic swap. CMBS do not, on the other hand, with both payment dates being on the 25th of each month." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentDelay"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementDate__valueDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "valueDate" ;
	linkml:description "The settlement date for a forward settling product. For Foreign Exchange contracts, this represents a common settlement date between both currency legs. To specify different settlement dates for each currency leg, see the ForeignExchange class. This attribute was formerly part of 'SettlementTerms', which is now being harmonised to include a common 'SettlementDate', as inherited from 'SettlementBase'." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementDate> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/valueDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementPayout__delivery> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "delivery" ;
	linkml:description "Contains the information relative to the delivery of the asset." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AssetDeliveryInformation> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/delivery"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementPayout__deliveryTerm> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "deliveryTerm" ;
	linkml:description "Also called contract month or delivery month. However, it's not always a month. It is usually expressed using a code, e.g. Z23 would be the Dec 2023 contract, (Z = December). For crude oil, the corresponding contract might be called CLZ23." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/deliveryTerm"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementPayout__schedule> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "schedule" ;
	linkml:description "Allows the full representation of a payout by defining a set of schedule periods. It supports standard schedule customization by expressing all the dates, quantities, and pricing data in a non-parametric way." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CalculationSchedule> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/schedule"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementPayout__underlier> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "underlier" ;
	linkml:description "The underlying financial product that will be physically or cash settled, which can be of any type, eg an asset such as cash or a security, or the cash settlement of an index rate." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementPayout> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Underlier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/underlier"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementProvision> a linkml:SlotDefinition ;
	linkml:description "Optionally defines the parameters that regulate a settlement." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementProvision> .
<https://w3id.org/lmodel/common-domain-model/settlementProvision__shapingProvisions> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "shapingProvisions" ;
	linkml:description "Defines the parameters that are necessary to 'shape' a settlement, i.e. break it down into smaller amounts." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementProvision> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementProvision> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ShapingProvision> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/shapingProvisions"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementRateOption> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2564 , _:c14n2565 ;
	linkml:description "Indicates that an officially defined rate settlement rate option will be the used for the fixing." , "The rate option to use for the fixing. Currently only applicable to foreign exchange fixing in case of cross-currency settlement." , "The rate source for the conversion to the settlement currency. This source is specified through a scheme that reflects the terms of the Annex A to the 1998 FX and Currency Option Definitions." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AssetSettlementRateOption> , <https://w3id.org/lmodel/common-domain-model/SettlementRateOptionEnum> , <https://w3id.org/lmodel/common-domain-model/string> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/settlementRateSource> a linkml:SlotDefinition ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/FxSettlementRateSource> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/settlementTerms> a linkml:SlotDefinition ;
	linkml:description "Each payout leg must specifies its settlement terms, including the delivery type (i.e. cash vs physical, and their respective terms), the transfer type (DvP etc.) and settlement date, if any." , "Per Part 1 Section 8, 'Settlement', of the 2018 ISDA CDM Equity Confirmation for Security Equity Swap." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementTerms> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/settlementTerms__cashSettlementTerms> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "cashSettlementTerms" ;
	linkml:description "Specifies the parameters associated with the cash settlement procedure." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementTerms> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CashSettlementTerms> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/cashSettlementTerms"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementTerms__physicalSettlementTerms> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "physicalSettlementTerms" ;
	linkml:description "Specifies the physical settlement terms which apply to the transaction." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/SettlementTerms> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/SettlementTerms> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PhysicalSettlementTerms> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/physicalSettlementTerms"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/settlementType> a linkml:SlotDefinition ;
	linkml:description "Whether the settlement will be cash, physical, by election, ..." ;
	linkml:equals_string "Cash" , "CashOrPhysical" , "Election" , "Physical" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementTypeEnum> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/shapeSchedule> a linkml:SlotDefinition ;
	linkml:description "Defines applicable settlement limits in each currency." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/shapingProvision__shapeSchedule> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "shapeSchedule" ;
	linkml:description "Defines applicable settlement limits in each currency." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/ShapingProvision> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/ShapingProvision> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/shapeSchedule"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/shapingProvisions> a linkml:SlotDefinition ;
	linkml:description "Defines the parameters that are necessary to 'shape' a settlement, i.e. break it down into smaller amounts." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ShapingProvision> .
<https://w3id.org/lmodel/common-domain-model/shareForCombined> a linkml:SlotDefinition ;
	linkml:description "Shall occur if a Merger Event occurs and the consideration for the relevant Security consists solely of Combined Consideration." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/shareForOther> a linkml:SlotDefinition ;
	linkml:description "Shall occur if a Merger Event occurs and the consideration for the relevant Security consists solely of Other Consideration." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/shareForRightsRatio> a linkml:SlotDefinition ;
	linkml:description "Multiple value, say 'M/N' where 'M' is the number of rights after the event, and 'N' of shares prior to the event." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/shareForShare> a linkml:SlotDefinition ;
	linkml:description "Shall occur if a Merger Event occurs and the consideration for the relevant Security consists solely of Combined Consideration." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ShareExtraordinaryEventEnum> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/shareForShareRatio> a linkml:SlotDefinition ;
	linkml:description "Multiple value, say 'M/N' where 'M' is the number of shares after the event and 'N' is the number of shares prior to the event." ;
