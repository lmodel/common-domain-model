<https://w3id.org/lmodel/common-domain-model/Period_period> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:prefLabel "period" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/period"^^xsd:anyURI ;
    linkml:description "A time period, e.g. a day, week, month or year of the stream. If the periodMultiplier value is 0 (zero) then period must contain the value D (day)." ;
    linkml:domain <https://w3id.org/lmodel/common-domain-model/Period> ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Period> ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/period> ;
    linkml:is_usage_slot true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/Period> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/PeriodEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/period"^^xsd:anyURI ;
    linkml:usage_slot_name "period" .

<https://w3id.org/lmodel/common-domain-model/Period_periodMultiplier> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:prefLabel "periodMultiplier" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/periodMultiplier"^^xsd:anyURI ;
    linkml:description "A time period multiplier, e.g. 1, 2 or 3 etc. A negative value can be used when specifying an offset relative to another date, e.g. -2 days." ;
    linkml:domain <https://w3id.org/lmodel/common-domain-model/Period> ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/Period> ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/periodMultiplier> ;
    linkml:is_usage_slot true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/Period> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/integer> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/periodMultiplier"^^xsd:anyURI ;
    linkml:usage_slot_name "periodMultiplier" .

<https://w3id.org/lmodel/common-domain-model/PriceComposite> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:PriceComposite"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: ArithmeticOperator — if operandType = PriceOperandEnum -> ForwardPoint or operandType = PriceOperandEnum -> AccruedInterest then arithmeticOperator = ArithmeticOperationEnum -> Add or arithmeticOperator = ArithmeticOperationEnum -> Subtract" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PriceComposite"^^xsd:anyURI ;
    linkml:description "Defines the inputs required to calculate a price as a simple composite of 2 other values. The inputs consist of 2 numbers and a simple arithmetic operator. This generic data type applies to a variety of use cases where a price is obtained by simple composition, e.g. dirty = clean + accrued (Bond), forward rate = spot rate + forward point (FX) etc." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/arithmeticOperator>,
        <https://w3id.org/lmodel/common-domain-model/baseValue>,
        <https://w3id.org/lmodel/common-domain-model/operand>,
        <https://w3id.org/lmodel/common-domain-model/operandType> .

