<https://w3id.org/lmodel/common-domain-model/buyer> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#BuyerSeller.buyer"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/buyer"^^xsd:anyURI ;
    linkml:description "Buyer party that can be resolved as one of the two principal parties to the transaction. The party that buys this instrument, i.e. pays for this instrument and receives the rights defined by it. ISDA 2002 Equity Definitions section 1.18: `Buyer` means the party specified as such in the related Confirmation. | ISDA 2006 Definitions article 12.1 (b)(i) relating to a Swaption: 'Buyer' means the party that will, on each Premium Payment Date, pay to Seller the Premium | ISDA 2006 Definitions article 12.1 (b)(ii) relating to Swap Transactions with applicable Early Termination: the party specified as such in the related Confirmation, or the Exercising Party if neither party is specified | ISDA 2006 Definitions article 12.1 (b)(iii) relating to any other Option Transaction: the party specified as such in the related Confirmation. | ISDA 2014 Credit Definition article 1.4: `Buyer` means the Fixed Rate Payer." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/BuyerSeller>,
        <https://w3id.org/lmodel/common-domain-model/Strike>,
        <https://w3id.org/lmodel/common-domain-model/StrikeSchedule> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/StrikeSchedule> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/CounterpartyRoleEnum> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/buyer"^^xsd:anyURI .

