    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/BusinessDayAdjustments"^^xsd:anyURI ;
    linkml:description "A class defining the business day convention and financial business centers used for adjusting any relevant date if it would otherwise fall on a day that is not a business day in the specified business center." ;
