	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/recalculationOfValueElection"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/recalculationOfValueElection__recalculationOfValueTerms> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
	skos:prefLabel "recalculationOfValueTerms" ;
