        "isda:CSA_VM_NewYork_2016"^^xsd:anyURI,
        "isda:CSD_English_1995"^^xsd:anyURI,
        "isda:CSD_IM_English_2016"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_English_1995 paragraph \"11\" clause \"(c)(iv)\" name \"Notification Time\"",
        "ISDA CSA_IM_Japanese_2016 paragraph \"13 General Principles\" clause \"(e)(iii)\" name \"Notification Time\"",
        "ISDA CSA_IM_NewYork_2016 paragraph \"13 General Principles\" clause \"(d)(iii)\" name \"Notification Time\"",
        "ISDA CSA_NewYork_1994 paragraph \"13\" clause \"(c)(iv)\" name \"Notification Time\"",
        "ISDA CSA_VM_English_2016 paragraph \"11\" clause \"(d)(iv)\" name \"Notification Time\"",
        "ISDA CSA_VM_NewYork_2016 paragraph \"13\" clause \"(d)(iv)\" name \"Notification Time\"",
        "ISDA CSD_English_1995 paragraph \"13\" clause \"(d)(iv)\" name \"Notification Time\"",
        "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(d)(iii)\" name \"Notification Time\"" ;
    skos:exactMatch "common_domain_model:NotificationTime"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/NotificationTime"^^xsd:anyURI ;
    linkml:description "Specifies the time by which a demand for the Transfer of Eligible Credit Support or Posted Credit Support needs to be made in order for the transfer to take place in accordance with the Transfer Timing provisions." ;
