<https://w3id.org/lmodel/common-domain-model/LegacyIndependentAmountRatingsXExposure> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:LegacyIndependentAmountRatingsXExposure"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: CompareIA — if compare = IndependentAmountCompareEnum -> Compare then compareVariableSet exists and highestLowestVariableSet is absent",
        "Rosetta condition: HighestIA — if compare = IndependentAmountCompareEnum -> Highest then highestLowestVariableSet exists and compareVariableSet is absent",
        "Rosetta condition: LowestIA — if compare = IndependentAmountCompareEnum -> Lowest then highestLowestVariableSet exists and compareVariableSet is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compare> ] ;
            linkml:description "Ensures the appropriate variable set is populated based on how the Ratings are compared." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compareVariableSet>,
                        <https://w3id.org/lmodel/common-domain-model/highestLowestVariableSet> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compare> ] ;
            linkml:description "Ensures the appropriate variable set is populated based on how the Ratings are compared." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compareVariableSet>,
                        <https://w3id.org/lmodel/common-domain-model/highestLowestVariableSet> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compare> ] ;
            linkml:description "Ensures the appropriate variable set is populated based on how the Ratings are compared." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/compareVariableSet>,
                        <https://w3id.org/lmodel/common-domain-model/highestLowestVariableSet> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/LegacyIndependentAmountRatingsXExposure"^^xsd:anyURI ;
    linkml:description "Specifies that the Independent Amount is determined using both credit rating and exposure metrics." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_compare>,
        <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_namedAffiliate>,
        <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_namedEntity>,
        <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_ratedParty>,
        <https://w3id.org/lmodel/common-domain-model/compareVariableSet>,
        <https://w3id.org/lmodel/common-domain-model/highestLowestVariableSet>,
        <https://w3id.org/lmodel/common-domain-model/ratingType> .

