<https://w3id.org/lmodel/common-domain-model/Price> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:Price"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: AmountOnlyExists — value exists and datedValue is absent" ;
    skos:relatedMatch "gist:Magnitude"^^xsd:anyURI ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The amount must exist when the price represents a single value, and steps must be absent." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/datedValue>,
                        <https://w3id.org/lmodel/common-domain-model/value> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Price"^^xsd:anyURI ;
    linkml:description "Price return, i.e. excluding dividends.",
        "Specifies a price as a single value to be associated to a financial product. This data type extends PriceSchedule and requires that only the amount value exists.",
        "When quotation style is 'Price', the marketPrice element of the Credit Default Swap feeLeg should be populated" ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/PriceSchedule> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PriceSchedule_arithmeticOperator>,
        <https://w3id.org/lmodel/common-domain-model/composite>,
        <https://w3id.org/lmodel/common-domain-model/datedValue>,
        <https://w3id.org/lmodel/common-domain-model/perUnitOf>,
        <https://w3id.org/lmodel/common-domain-model/premiumType>,
        <https://w3id.org/lmodel/common-domain-model/priceExpression>,
        <https://w3id.org/lmodel/common-domain-model/priceSubType>,
        <https://w3id.org/lmodel/common-domain-model/priceType>,
        <https://w3id.org/lmodel/common-domain-model/unit>,
        <https://w3id.org/lmodel/common-domain-model/value> .

<https://w3id.org/lmodel/common-domain-model/Resource> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common> ;
    skos:exactMatch "common_domain_model:Resource"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: ResourceChoice — optional choice string, url" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct. Note that FpML also provides the ability to have hexadecimalBinary or base64Binary, which have not been implemented in Rosetta until we see actual use cases." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/url> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/string> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Resource"^^xsd:anyURI ;
    linkml:description "Describes the resource that contains the media representation of a business event (i.e used for stating the Publicly Available Information). For example, can describe a file or a URL that represents the event. This type is an extended version of a type defined by RIXML (www.rixml.org).  Rosetta restricts the FpML implementation by not providing the ability to associated a document in hexadecimalBinary or base64Binary until such time that actual use cases will come up." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Resource_name>,
        <https://w3id.org/lmodel/common-domain-model/comments>,
        <https://w3id.org/lmodel/common-domain-model/language>,
        <https://w3id.org/lmodel/common-domain-model/length>,
        <https://w3id.org/lmodel/common-domain-model/mimeType>,
        <https://w3id.org/lmodel/common-domain-model/resourceId>,
        <https://w3id.org/lmodel/common-domain-model/resourceType>,
        <https://w3id.org/lmodel/common-domain-model/sizeInBytes>,
        <https://w3id.org/lmodel/common-domain-model/string>,
        <https://w3id.org/lmodel/common-domain-model/url> .

