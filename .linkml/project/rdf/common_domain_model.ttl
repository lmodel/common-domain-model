    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/spread"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/zeroEvent> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/zeroEvent"^^xsd:anyURI ;
    linkml:description "Indicates whether a trigger applies for the Threshold or Minimum Transfer Amount to fall to zero. If 'True' then such a trigger exists." ;
