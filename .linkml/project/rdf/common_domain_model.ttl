<https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedDate> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:AdjustableOrAdjustedDate"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AdjustableOrAdjustedDate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdjustedDate — if adjustedDate is absent then unadjustedDate exists and dateAdjustments exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustedDate> ] ;
            linkml:description "FpML specifies a choice between adjustedDate and [unadjustedDate (required), dateAdjutsments (required), adjustedDate (optional)]." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dateAdjustments>,
                        <https://w3id.org/lmodel/common-domain-model/unadjustedDate> ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedDate"^^xsd:anyURI ;
    linkml:description "A class for defining a date that shall be subject to adjustment if it would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the date." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedDate_unadjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/adjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/dateAdjustments> .

<https://w3id.org/lmodel/common-domain-model/Aggregation> a linkml:ClassDefinition ;
