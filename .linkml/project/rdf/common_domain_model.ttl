<https://w3id.org/lmodel/common-domain-model/notificationTime> a linkml:SlotDefinition ;
	linkml:description "Specifies the time of day that the notification should occur." , "The Notification Time as a time that is qualified as a standard business center." , "The time by which a demand for the Transfer of Eligible Credit Support (IM) or Posted Credit Support (IM) needs to be made in order for the transfer to take place in accordance with the Transfer Timing provisions." , "The time on the day of intended settlement by which the borrower must notify the lender that they will be returning the requested security. For the UK, best practice recommends that this would be 30 minutes before the CREST DVP cut-off time i.e. 15:15:00 GMT" , "What is the notification time of the GMSLA?" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessCenterTime> , <https://w3id.org/lmodel/common-domain-model/NotificationTime> , <https://w3id.org/lmodel/common-domain-model/TimeZone> , <https://w3id.org/lmodel/common-domain-model/time> ;
	linkml:required true ;
	linkml:value_presence "PRESENT" .
