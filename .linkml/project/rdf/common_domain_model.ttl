<https://w3id.org/lmodel/common-domain-model/length> a linkml:SlotDefinition ;
	linkml:description "Indicates the length of the resource. For example, if the resource were a PDF file, the length would be in pages." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/ResourceLength> .
<https://w3id.org/lmodel/common-domain-model/lengthUnit> a linkml:SlotDefinition ;
