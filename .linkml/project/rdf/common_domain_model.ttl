    skos:note "Rosetta condition: DayOfWeekMethod — if dayOfWeek exists then dayFrequency exists",
        "Rosetta condition: ParametricDatesChoice — required choice dayDistribution, dayOfWeek" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dayOfWeek> ] ;
