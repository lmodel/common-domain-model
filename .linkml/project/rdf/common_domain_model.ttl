<https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet_variableSet> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:prefLabel "variableSet" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/variableSet"^^xsd:anyURI ;
    linkml:description "For some variants a table of variables is required. To support this use case we need to be able to specify variables within variables. Including a variable set here gives us infinite nesting opportunities - realistically we are only ever expecting that a table would need to be defined for any particular clause, so we would expect two levels of nesting as a maximum i.e. variableSet->variableSet->name/value." ;
    linkml:domain <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/variableSet> ;
    linkml:is_usage_slot true ;
    linkml:multivalued true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/variableSet"^^xsd:anyURI ;
    linkml:usage_slot_name "variableSet" .

