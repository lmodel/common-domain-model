<https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum> skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    skos:relatedMatch "oscal:Role"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AncillaryRoleEnum"^^xsd:anyURI ;
    linkml:description "Defines the enumerated values to specify the ancillary roles to the transaction. The product is agnostic to the actual parties involved in the transaction, with the party references abstracted away from the product definition and replaced by the AncillaryRoleEnum. The AncillaryRoleEnum can then be positioned in the product and the AncillaryParty type, which is positioned outside of the product definition, allows the AncillaryRoleEnum to be associated with an actual party reference." ;
    linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/CalculationAgentFallback>,
        <https://w3id.org/lmodel/common-domain-model/CalculationAgentIndependent>,
        <https://w3id.org/lmodel/common-domain-model/CalculationAgentMandatoryEarlyTermination>,
        <https://w3id.org/lmodel/common-domain-model/CalculationAgentOptionalEarlyTermination>,
        <https://w3id.org/lmodel/common-domain-model/DisruptionEventsDeterminingParty>,
        <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeReceiverPartyCancelableProvision>,
        <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeReceiverPartyExtendibleProvision>,
        <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeReceiverPartyManual>,
        <https://w3id.org/lmodel/common-domain-model/ExerciseNoticeReceiverPartyOptionalEarlyTermination>,
        <https://w3id.org/lmodel/common-domain-model/ExtraordinaryDividendsParty>,
        <https://w3id.org/lmodel/common-domain-model/PredeterminedClearingOrganizationParty> .

<https://w3id.org/lmodel/common-domain-model/AppropriatedCollateralValuation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSD_IM_English_2016"^^xsd:anyURI ;
    skos:closeMatch "fpml_5_10:AppropriatedCollateralValuation"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSD_IM_English_2016 paragraph \"13 General Principles\" clause \"(u)\" name \"Valuation of Appropriated Collateral\"" ;
    skos:exactMatch "common_domain_model:AppropriatedCollateralValuation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: NotSpecified — if isSpecified = False then election is absent",
        "Rosetta condition: Specified — if isSpecified = True then election exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isSpecified> ] ;
            linkml:description "The Valuation of Appropriate Collateral election must be specified when it is applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/election> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isSpecified> ] ;
            linkml:description "The Valuation of Appropriate Collateral election cannot be specified when it is not applicable." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/election> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AppropriatedCollateralValuation"^^xsd:anyURI ;
    linkml:description "A class to specify the Valuation of Appropriated Collateral." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AppropriatedCollateralValuation_isSpecified>,
        <https://w3id.org/lmodel/common-domain-model/election> .

