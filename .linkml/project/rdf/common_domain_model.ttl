<https://w3id.org/lmodel/common-domain-model/Account> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
	linkml:annotations _:c14n1556 ;
	linkml:attributes <https://w3id.org/lmodel/common-domain-model/accountBeneficiary> , <https://w3id.org/lmodel/common-domain-model/accountName> , <https://w3id.org/lmodel/common-domain-model/accountNumber> , <https://w3id.org/lmodel/common-domain-model/accountType> , <https://w3id.org/lmodel/common-domain-model/partyReference> , <https://w3id.org/lmodel/common-domain-model/servicingParty> ;
	linkml:class_uri "https://w3id.org/lmodel/common-domain-model/Account"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Account"^^xsd:anyURI ;
	linkml:description "A class to specify an account as an account number alongside, optionally. an account name, an account type, an account beneficiary and a servicing party." , "The limit is set in relation to the proprietary business undertaken by the clearing counterparty." ;
	linkml:slot_usage _:c14n1918 ;
	linkml:slots <https://w3id.org/lmodel/common-domain-model/account__accountBeneficiary> , <https://w3id.org/lmodel/common-domain-model/account__accountName> , <https://w3id.org/lmodel/common-domain-model/account__accountNumber> , <https://w3id.org/lmodel/common-domain-model/account__accountType> , <https://w3id.org/lmodel/common-domain-model/account__partyReference> , <https://w3id.org/lmodel/common-domain-model/account__servicingParty> .
<https://w3id.org/lmodel/common-domain-model/AccountTypeEnum> skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AccountTypeEnum"^^xsd:anyURI ;
	linkml:description "The enumeration values to qualify the type of account." ;
	linkml:permissible_values <https://w3id.org/lmodel/common-domain-model/AggregateClient> , <https://w3id.org/lmodel/common-domain-model/Client> , <https://w3id.org/lmodel/common-domain-model/House> .
<https://w3id.org/lmodel/common-domain-model/Accountant> linkml:description "Organization responsible for preparing the accounting for the trade." .
<https://w3id.org/lmodel/common-domain-model/AccrualFactor> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
	skos:note "Rosetta condition AccrualPriceIsRate is not stated in LinkML: value -> priceType = PriceTypeEnum -> InterestRate" ;
	linkml:attributes <https://w3id.org/lmodel/common-domain-model/calculationTerms> , <https://w3id.org/lmodel/common-domain-model/value> ;
	linkml:class_uri "https://w3id.org/lmodel/common-domain-model/AccrualFactor"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AccrualFactor"^^xsd:anyURI ;
	linkml:description "The accrual rate and related terms, to adjust the price of an underlier impacted by a Corporate Action when economic impact consists in freezing the underlier price to the last fixing then applying accruals per each remaining underlier price fixing date required i.e. for each fixing date, adjustedPrice = lastFixingPrice x accrualFactor, where: accrualFactor = (1 + accrualRateValue x DCF)." ;
	linkml:slot_usage _:c14n560 ;
	linkml:slots <https://w3id.org/lmodel/common-domain-model/accrualFactor__calculationTerms> , <https://w3id.org/lmodel/common-domain-model/accrualFactor__value> .
<https://w3id.org/lmodel/common-domain-model/AccrualFactorCalculationTerms> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/common-domain-model/dayCountFraction> , <https://w3id.org/lmodel/common-domain-model/interpolationTerms> , <https://w3id.org/lmodel/common-domain-model/tenorTillMaturity> ;
	linkml:class_uri "https://w3id.org/lmodel/common-domain-model/AccrualFactorCalculationTerms"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AccrualFactorCalculationTerms"^^xsd:anyURI ;
	linkml:description "Describes the input terms involved in the calculation of the accrual factor. Optionnally, long and short stub interpolation rates can be specified." ;
	linkml:slot_usage _:c14n2026 ;
	linkml:slots <https://w3id.org/lmodel/common-domain-model/accrualFactorCalculationTerms__dayCountFraction> , <https://w3id.org/lmodel/common-domain-model/accrualFactorCalculationTerms__interpolationTerms> , <https://w3id.org/lmodel/common-domain-model/accrualFactorCalculationTerms__tenorTillMaturity> .
<https://w3id.org/lmodel/common-domain-model/ActionEnum> skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ActionEnum"^^xsd:anyURI ;
