<https://w3id.org/lmodel/common-domain-model/AgreementName> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common> ;
    skos:closeMatch "fpml_5_10:AgreementName"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AgreementName"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: AgreementType — if agreementType <> LegalAgreementTypeEnum -> Other then otherAgreement is absent else if agreementType <> LegalAgreementTypeEnum -> MasterAgreement then masterAgreementType is absent else if agreementType <> LegalAgreementTypeEnum -> MasterConfirmation then masterConfirmationType is absent and masterConfirmationAnnexType is absent else if agreementType <> LegalAgreementTypeEnum -> Confirmation then contractualDefinitionsType is absent and contractualTermsSupplement is absent and contractualMatrix is absent",
        "Rosetta condition: CSAMarginType — if creditSupportAgreementMarginType exists then creditSupportAgreementType exists",
        "Rosetta condition: CreditSupportAgreement — if agreementType = LegalAgreementTypeEnum -> CreditSupportAgreement then creditSupportAgreementType exists",
        "Rosetta condition: MasterConfirmation — if masterConfirmationAnnexType exists then masterConfirmationType exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/masterConfirmationAnnexType> ] ;
            linkml:description "If a master confirmation annex type is specified a master confirmation type must exist." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/masterConfirmationType> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/agreementType> ] ;
            linkml:description "A condition to ensure that the credit supoort agreement type is specified when required." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/creditSupportAgreementType> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/creditSupportAgreementMarginType> ] ;
            linkml:description "A condition to ensure that CSA margin type is only specified if a credit support agreemnt type is specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/creditSupportAgreementType> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AgreementName"^^xsd:anyURI ;
    linkml:description "Specifies the agreement name through an agreement type and optional detailed sub agreement type." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/agreementType>,
        <https://w3id.org/lmodel/common-domain-model/brokerConfirmationType>,
        <https://w3id.org/lmodel/common-domain-model/contractualDefinitionsType>,
        <https://w3id.org/lmodel/common-domain-model/contractualMatrix>,
        <https://w3id.org/lmodel/common-domain-model/contractualTermsSupplement>,
        <https://w3id.org/lmodel/common-domain-model/creditSupportAgreementMarginType>,
        <https://w3id.org/lmodel/common-domain-model/creditSupportAgreementType>,
        <https://w3id.org/lmodel/common-domain-model/masterAgreementType>,
        <https://w3id.org/lmodel/common-domain-model/masterConfirmationAnnexType>,
        <https://w3id.org/lmodel/common-domain-model/masterConfirmationType>,
        <https://w3id.org/lmodel/common-domain-model/otherAgreement> .

<https://w3id.org/lmodel/common-domain-model/EventInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_workflow> ;
    skos:exactMatch "common_domain_model:EventInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
    skos:note "Rosetta condition: CorporateAction — if corporateActionIntent exists then intent = EventIntentEnum -> CorporateActionAdjustment",
        "Rosetta func: Create_ProposedWorkflowStep — Represents the proposal to create a business event that results in a workflow step containing an instruction, message details, identifiers, event timestamps, parties and accounts. The optional previous workflow step input provides workflow lineage to where there has been a correction or cancellation to the proposed step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_ProposedWorkflowStep\",\"description\":\"Represents the proposal to create a business event that results in a workflow step containing an instruction, message details, identifiers, event timestamps, parties and accounts. The optional previous workflow step input provides workflow lineage to where there has been a correction or cancellation to the proposed step. The action is constrained so that when a previous workflow step is specified, the valid actions are as follows; New -> Correct and Correct -> Cancel. When a previous workflow is not specified, the action must be New.\",\"inputs\":[{\"name\":\"messageInformation\",\"type\":\"MessageInformation\",\"cardinality\":\"0..1\"},{\"name\":\"timestamp\",\"type\":\"EventTimestamp\",\"cardinality\":\"1..*\"},{\"name\":\"eventIdentifier\",\"type\":\"Identifier\",\"cardinality\":\"1..*\"},{\"name\":\"party\",\"type\":\"Party\",\"cardinality\":\"0..*\"},{\"name\":\"account\",\"type\":\"Account\",\"cardinality\":\"0..*\"},{\"name\":\"previousWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"0..1\"},{\"name\":\"action\",\"type\":\"ActionEnum\",\"cardinality\":\"1..1\"},{\"name\":\"proposedEvent\",\"type\":\"EventInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"approval\",\"type\":\"WorkflowStepApproval\",\"cardinality\":\"0..*\"}],\"output\":{\"name\":\"proposedWorkflowStep\",\"type\":\"WorkflowStep\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EventInstruction"^^xsd:anyURI ;
    linkml:description "Specifies instructions to create a BusinessEvent." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/EventInstruction_effectiveDate>,
        <https://w3id.org/lmodel/common-domain-model/EventInstruction_intent>,
        <https://w3id.org/lmodel/common-domain-model/corporateActionIntent>,
        <https://w3id.org/lmodel/common-domain-model/effectiveTime>,
        <https://w3id.org/lmodel/common-domain-model/eventDate>,
        <https://w3id.org/lmodel/common-domain-model/eventTime>,
        <https://w3id.org/lmodel/common-domain-model/instruction>,
        <https://w3id.org/lmodel/common-domain-model/packageInformation> .

<https://w3id.org/lmodel/common-domain-model/ExtraordinaryEvents> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction> ;
    rdfs:seeAlso "isda:EquityDerivativesDefinitions_2002"^^xsd:anyURI,
        "isda:SecurityEquitySwapConfirmation_2018"^^xsd:anyURI ;
    skos:editorialNote "ISDA EquityDerivativesDefinitions_2002",
        "ISDA SecurityEquitySwapConfirmation_2018" ;
    skos:exactMatch "common_domain_model:ExtraordinaryEvents"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction"^^xsd:anyURI ;
    skos:note "Rosetta condition: ExtraordinaryEventsChoice — required choice additionalDisruptionEvents, failureToDeliver" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "condition to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/failureToDeliver> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalDisruptionEvents> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExtraordinaryEvents"^^xsd:anyURI ;
    linkml:description "Where the underlying is shares, defines market events affecting the issuer of those shares that may require the terms of the transaction to be adjusted." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ExtraordinaryEvents_additionalBespokeTerms>,
        <https://w3id.org/lmodel/common-domain-model/additionalDisruptionEvents>,
        <https://w3id.org/lmodel/common-domain-model/compositionOfCombinedConsideration>,
        <https://w3id.org/lmodel/common-domain-model/delisting>,
        <https://w3id.org/lmodel/common-domain-model/failureToDeliver>,
        <https://w3id.org/lmodel/common-domain-model/indexAdjustmentEvents>,
        <https://w3id.org/lmodel/common-domain-model/mergerEvents>,
        <https://w3id.org/lmodel/common-domain-model/nationalizationOrInsolvency>,
        <https://w3id.org/lmodel/common-domain-model/representations>,
        <https://w3id.org/lmodel/common-domain-model/tenderOfferEvents> .

<https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:IndependentAmountRatings"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: NamedAffiliate — if ratedParty = RatedPartyEnum -> NamedAffiliate then namedAffiliate exists else namedAffiliate is absent",
        "Rosetta condition: NamedEntity — if ratedParty = RatedPartyEnum -> NamedEntity then namedEntity exists else namedEntity is absent",
        "Rosetta condition: RestrictCompare — if compare exists then compare = IndependentAmountCompareEnum -> Compare or compare = IndependentAmountCompareEnum -> Lowest or compare = IndependentAmountCompareEnum -> Highest" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/ratedParty> ] ;
            linkml:description "Ensures Named Affiliate is provided where the Rated Party is Named Affiliate." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/namedAffiliate> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/ratedParty> ] ;
            linkml:description "Ensures Named Entity is provided where the Rated Party is Named Entity." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/namedEntity> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings"^^xsd:anyURI ;
    linkml:description "A logical container designed to hold a set of related data. In this case, designed to hold a set of information required when Independent Amount is determined using credit ratings." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_compare>,
        <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_namedAffiliate>,
        <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_namedEntity>,
        <https://w3id.org/lmodel/common-domain-model/IndependentAmountRatings_ratedParty>,
        <https://w3id.org/lmodel/common-domain-model/ratingType> .

<https://w3id.org/lmodel/common-domain-model/NaturalPerson> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party> ;
    skos:closeMatch "gist:Person"^^xsd:anyURI,
        "iso29100:PIIPrincipal"^^xsd:anyURI,
        "oscal:Party"^^xsd:anyURI,
        "spdx:Person"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:NaturalPerson"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_party"^^xsd:anyURI ;
    skos:note "Rosetta condition: NameOrIdChoice — (firstName exists and surname exists) or personId exists",
        "Rosetta condition: NaturalPersonChoice — optional choice middleName, initial" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/initial> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/middleName> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "NameOrIdChoice" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/personId> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/firstName>,
                                <https://w3id.org/lmodel/common-domain-model/surname> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/NaturalPerson"^^xsd:anyURI ;
    linkml:description "A class to represent the attributes that are specific to a natural person." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/NaturalPerson_contactInformation>,
        <https://w3id.org/lmodel/common-domain-model/dateOfBirth>,
        <https://w3id.org/lmodel/common-domain-model/firstName>,
        <https://w3id.org/lmodel/common-domain-model/honorific>,
        <https://w3id.org/lmodel/common-domain-model/initial>,
        <https://w3id.org/lmodel/common-domain-model/middleName>,
        <https://w3id.org/lmodel/common-domain-model/personId>,
        <https://w3id.org/lmodel/common-domain-model/suffix>,
        <https://w3id.org/lmodel/common-domain-model/surname> .

<https://w3id.org/lmodel/common-domain-model/Obligations> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit> ;
    skos:exactMatch "common_domain_model:Obligations"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit"^^xsd:anyURI ;
    skos:note "Rosetta condition: ObligationsChoice — optional choice fullFaithAndCreditObLiability, generalFundObligationLiability, revenueObligationLiability" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/revenueObligationLiability> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fullFaithAndCreditObLiability> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/generalFundObligationLiability> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Obligations"^^xsd:anyURI ;
    linkml:description "A class to specify the underlying obligations of the reference entity on which protection is purchased or sold through the Credit Default Swap." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/cashSettlementOnly>,
        <https://w3id.org/lmodel/common-domain-model/category>,
        <https://w3id.org/lmodel/common-domain-model/continuity>,
        <https://w3id.org/lmodel/common-domain-model/deliveryOfCommitments>,
        <https://w3id.org/lmodel/common-domain-model/designatedPriority>,
        <https://w3id.org/lmodel/common-domain-model/excluded>,
        <https://w3id.org/lmodel/common-domain-model/fullFaithAndCreditObLiability>,
        <https://w3id.org/lmodel/common-domain-model/generalFundObligationLiability>,
        <https://w3id.org/lmodel/common-domain-model/listed>,
        <https://w3id.org/lmodel/common-domain-model/notContingent>,
        <https://w3id.org/lmodel/common-domain-model/notDomesticCurrency>,
        <https://w3id.org/lmodel/common-domain-model/notDomesticIssuance>,
        <https://w3id.org/lmodel/common-domain-model/notDomesticLaw>,
        <https://w3id.org/lmodel/common-domain-model/notSovereignLender>,
        <https://w3id.org/lmodel/common-domain-model/notSubordinated>,
        <https://w3id.org/lmodel/common-domain-model/othReferenceEntityObligations>,
        <https://w3id.org/lmodel/common-domain-model/revenueObligationLiability>,
        <https://w3id.org/lmodel/common-domain-model/specifiedCurrency> .

<https://w3id.org/lmodel/common-domain-model/PayoutBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement> ;
    skos:exactMatch "common_domain_model:PayoutBase"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
    skos:note "Rosetta condition: FinalPrincipalAmountExists — if principalPayment -> principalPaymentSchedule -> finalPrincipalPayment exists and priceQuantity -> quantitySchedule exists and priceQuantity -> reset is absent then principalPayment -> principalPaymentSchedule -> finalPrincipalPayment -> principalAmount exists or principalPayment -> principalPaymentSchedule -> finalPrincipalPayment -> presentValuePrincipalAmount exists" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/PayoutBase"^^xsd:anyURI ;
    linkml:description "A data type that contains the common attributes (e.g. payer and receiver parties) and validation conditions that apply across all payout types" ;
