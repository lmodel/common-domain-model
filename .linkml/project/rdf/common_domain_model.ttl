<https://w3id.org/lmodel/common-domain-model/SpinOff> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:SpinOff"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: EquityPrice — parentSecurity -> securityType = Equity and childSecurity -> securityType = Equity" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SpinOff"^^xsd:anyURI ;
    linkml:description "Corporate action triggered by a spin Off. A spin-out, also known as a spin-off or a starburst, refers to a type of corporate action where a company splits off sections of itself as a separate business. The value maps closely to the ISO code (SOFF) defined as a a distribution of subsidiary stock to the shareholders of the parent company without a surrender of shares. Spin-off represents a form of divestiture usually resulting in an independent company or in an existing company. For example, demerger, distribution, unbundling.",
        "Defines the underlier for both the Parent Company and the Child Compagny involved in Spin Off corporate action, as well as th respective price observation for each." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/childSecurity>,
        <https://w3id.org/lmodel/common-domain-model/childSecurityPrice>,
        <https://w3id.org/lmodel/common-domain-model/parentSecurity>,
        <https://w3id.org/lmodel/common-domain-model/parentSecurityPrice> .

<https://w3id.org/lmodel/common-domain-model/SwapCurveValuation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:SwapCurveValuation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SwapCurveValuation"^^xsd:anyURI ;
    linkml:description "A class to specify a valuation swap curve, which is used as part of the strike construct for the bond and convertible bond options." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/SwapCurveValuation_indexTenor>,
        <https://w3id.org/lmodel/common-domain-model/floatingRateIndex>,
        <https://w3id.org/lmodel/common-domain-model/side>,
        <https://w3id.org/lmodel/common-domain-model/spread> .

<https://w3id.org/lmodel/common-domain-model/Taxonomy> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:exactMatch "common_domain_model:Taxonomy"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: DifferentOrdinals — if value -> classification -> ordinal exists then value -> classification -> ordinal count = value -> classification -> ordinal distinct count",
        "Rosetta condition: OrdinalExists — if value -> classification count > 1 then value -> classification -> ordinal count = value -> classification count",
        "Rosetta condition: SequentialOrdinals — if value -> classification count > 1 then value -> classification -> ordinal count = value -> classification -> ordinal max" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Taxonomy"^^xsd:anyURI ;
    linkml:description "Defines the taxonomy of an object by combining a taxonomy source (i.e. the rules to classify the object) and a value (i.e. the output of those rules on the object)." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Taxonomy_source>,
        <https://w3id.org/lmodel/common-domain-model/Taxonomy_value> .

<https://w3id.org/lmodel/common-domain-model/TermsChangeInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:TermsChangeInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: AtLeastOneOf — (product exists or ancillaryParty exists or adjustment exists)",
        "Rosetta func: Create_CancellationTermChangeInstruction — Create a terms change instruction for a cancellation that consists in bringing the termination date forward.",
        "Rosetta func: Create_EffectiveOrTerminationDateTermChangeInstruction — Creates the relevant terms change primitive instruction object for rolling a contractual product, which consists in the same terms as the original contractual product but with different effective and termination dates.",
        "Rosetta func: Create_OnDemandRateChangeTermsChangeInstruction — Creates a terms change instruction for an on-demand rate change, based on a new rate provided as a single number. This instruction only updates the effective date but keeps other details of the trade unchanged.",
        "Rosetta func: Create_RollTermChangeInstruction — Creates the relevant terms change primitive instruction object for rolling a contractual product, which consists in the same terms as the original contractual product but with different effective and termination dates.",
        "Rosetta func: Create_SubstitutionInstruction — Creates the terms change instruction that updates the payout with the new substitution payout.",
        "Rosetta func: Create_TermsChange — A specification of the inputs, outputs and constraints when calculating the after tradeState based Terms Change Primitive Instruction." ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "AtLeastOneOf" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/ancillaryParty> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/product> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustment> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_TermsChange\",\"description\":\"A specification of the inputs, outputs and constraints when calculating the after tradeState based Terms Change Primitive Instruction.\",\"inputs\":[{\"name\":\"termsChange\",\"type\":\"TermsChangeInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"before\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_EffectiveOrTerminationDateTermChangeInstruction\",\"description\":\"Creates the relevant terms change primitive instruction object for rolling a contractual product, which consists in the same terms as the original contractual product but with different effective and termination dates.\",\"inputs\":[{\"name\":\"product\",\"type\":\"NonTransferableProduct\",\"cardinality\":\"1..1\"},{\"name\":\"effectiveRollDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"0..1\"},{\"name\":\"terminationDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"termsChangeInstruction\",\"type\":\"TermsChangeInstruction\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_RollTermChangeInstruction\",\"description\":\"Creates the relevant terms change primitive instruction object for rolling a contractual product, which consists in the same terms as the original contractual product but with different effective and termination dates.\",\"inputs\":[{\"name\":\"product\",\"type\":\"NonTransferableProduct\",\"cardinality\":\"1..1\"},{\"name\":\"effectiveRollDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"1..1\"},{\"name\":\"terminationDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"termsChangeInstruction\",\"type\":\"TermsChangeInstruction\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_OnDemandRateChangeTermsChangeInstruction\",\"description\":\"Creates a terms change instruction for an on-demand rate change, based on a new rate provided as a single number. This instruction only updates the effective date but keeps other details of the trade unchanged.\",\"inputs\":[{\"name\":\"product\",\"type\":\"NonTransferableProduct\",\"cardinality\":\"1..1\"},{\"name\":\"effectiveDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"termsChangeInstruction\",\"type\":\"TermsChangeInstruction\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_CancellationTermChangeInstruction\",\"description\":\"Create a terms change instruction for a cancellation that consists in bringing the termination date forward.\",\"inputs\":[{\"name\":\"product\",\"type\":\"NonTransferableProduct\",\"cardinality\":\"1..1\"},{\"name\":\"cancellationDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"termsChangeInstruction\",\"type\":\"TermsChangeInstruction\",\"cardinality\":\"1..1\"}},{\"name\":\"Create_SubstitutionInstruction\",\"description\":\"Creates the terms change instruction that updates the payout with the new substitution payout.\",\"inputs\":[{\"name\":\"product\",\"type\":\"NonTransferableProduct\",\"cardinality\":\"1..1\"},{\"name\":\"effectiveDate\",\"type\":\"AdjustableOrRelativeDate\",\"cardinality\":\"1..1\"},{\"name\":\"newCollateralPortfolio\",\"type\":\"CollateralPortfolio\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"termsChangeInstruction\",\"type\":\"TermsChangeInstruction\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TermsChangeInstruction"^^xsd:anyURI ;
    linkml:description "Specifies instructions for terms change consisting of the new transaction terms, and the renegotiation fee." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/TermsChangeInstruction_ancillaryParty>,
        <https://w3id.org/lmodel/common-domain-model/TermsChangeInstruction_product>,
        <https://w3id.org/lmodel/common-domain-model/adjustment> .

<https://w3id.org/lmodel/common-domain-model/ThresholdElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ThresholdElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: ThresholdOneOf — required choice fixedAmount, ratingsBased, infinity, other" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Ensures that threshold is specified as one-of fixedAmount, ratingsBased, infinity, or other." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fixedAmount> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/other> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/ratingsBased> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/infinity> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ThresholdElection"^^xsd:anyURI ;
    linkml:description "Specifies whether the threshold is rating based, a fixed amount, or infinity." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ThresholdElection_party>,
        <https://w3id.org/lmodel/common-domain-model/fixedAmount>,
        <https://w3id.org/lmodel/common-domain-model/infinity>,
        <https://w3id.org/lmodel/common-domain-model/other>,
        <https://w3id.org/lmodel/common-domain-model/ratingsBased> .

<https://w3id.org/lmodel/common-domain-model/TransferBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:TransferBase"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/TransferBase"^^xsd:anyURI ;
    linkml:description "Defines the movement of an Asset (eg cash, securities or commodities) between two parties on a date." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/AssetFlowBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AssetFlowBase_asset>,
        <https://w3id.org/lmodel/common-domain-model/AssetFlowBase_quantity>,
        <https://w3id.org/lmodel/common-domain-model/AssetFlowBase_settlementDate>,
        <https://w3id.org/lmodel/common-domain-model/TransferBase_identifier>,
        <https://w3id.org/lmodel/common-domain-model/TransferBase_payerReceiver>,
        <https://w3id.org/lmodel/common-domain-model/paymentDiscounting> .

<https://w3id.org/lmodel/common-domain-model/Trigger> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_event> ;
    skos:exactMatch "common_domain_model:Trigger"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    skos:note "Rosetta condition: Choice1 — required choice level, creditEvents , creditEventsReference" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description " Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/level> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/creditEventsReference> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/creditEvents> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Trigger"^^xsd:anyURI ;
    linkml:description "Trigger point at which feature is effective." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/creditEvents>,
        <https://w3id.org/lmodel/common-domain-model/creditEventsReference>,
        <https://w3id.org/lmodel/common-domain-model/level>,
        <https://w3id.org/lmodel/common-domain-model/triggerTimeType>,
        <https://w3id.org/lmodel/common-domain-model/triggerType> .

<https://w3id.org/lmodel/common-domain-model/VarianceReturnTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:VarianceReturnTerms"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: NonNegativeStrikePrice — if volatilityStrikePrice -> value exists then volatilityStrikePrice -> value >= 0 and if varianceStrikePrice -> value exists then varianceStrikePrice -> value >= 0",
        "Rosetta condition: Positive_VegaNotionalAmount — if vegaNotionalAmount -> value exists then vegaNotionalAmount -> value > 0",
        "Rosetta condition: ReferenceContract — if valuationTerms -> futuresPriceValuation = True then exchangeTradedContractNearest exists",
        "Rosetta condition: StrikePriceMustExist — required choice volatilityStrikePrice, varianceStrikePrice",
        "Rosetta condition: UnderlierMustBeListedDerivative — if exchangeTradedContractNearest exists then exchangeTradedContractNearest -> Asset -> Instrument -> ListedDerivative exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The strike price must be present, but it can be expressed in either variance or volatility terms" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/volatilityStrikePrice> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/varianceStrikePrice> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/VarianceReturnTerms"^^xsd:anyURI ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/ReturnTermsBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/annualizationFactor>,
        <https://w3id.org/lmodel/common-domain-model/dividendApplicability>,
        <https://w3id.org/lmodel/common-domain-model/equityUnderlierProvisions>,
        <https://w3id.org/lmodel/common-domain-model/exchangeTradedContractNearest>,
        <https://w3id.org/lmodel/common-domain-model/expectedN>,
        <https://w3id.org/lmodel/common-domain-model/initialLevel>,
        <https://w3id.org/lmodel/common-domain-model/initialLevelSource>,
        <https://w3id.org/lmodel/common-domain-model/meanAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/performance>,
        <https://w3id.org/lmodel/common-domain-model/sharePriceDividendAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/valuationTerms>,
        <https://w3id.org/lmodel/common-domain-model/varianceCapFloor>,
        <https://w3id.org/lmodel/common-domain-model/varianceStrikePrice>,
        <https://w3id.org/lmodel/common-domain-model/vegaNotionalAmount>,
        <https://w3id.org/lmodel/common-domain-model/volatilityCapFloor>,
        <https://w3id.org/lmodel/common-domain-model/volatilityStrikePrice> .

<https://w3id.org/lmodel/common-domain-model/Velocity> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_workflow> ;
    skos:exactMatch "common_domain_model:Velocity"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_workflow"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Velocity"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Velocity_period>,
        <https://w3id.org/lmodel/common-domain-model/Velocity_periodMultiplier> .

<https://w3id.org/lmodel/common-domain-model/VolatilityCapFloor> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:VolatilityCapFloor"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: CapFloorApplicability — if applicable = True then totalVolatilityCap exists or volatilityCapFactor exists // If CapFloor is applicable at least one cap expression must exist else totalVolatilityCap is absent and volatilityCapFactor is absent // If CapFloor is not applicable, then there cannot be any volatility caps",
        "Rosetta condition: PositiveCaps — if totalVolatilityCap exists then totalVolatilityCap >= 0 and if volatilityCapFactor exists then volatilityCapFactor >= 0" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/totalVolatilityCap> ] ;
            linkml:description "Barriers must be set to positive values" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/totalVolatilityCap> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/applicable> ] ;
            linkml:description "Caps/floors can and must be specified if applicable is set to true. If false, barriers cannot be established" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/volatilityCapFactor> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/totalVolatilityCap> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/VolatilityCapFloor"^^xsd:anyURI ;
    linkml:description "Contains volatility-based barriers. Volatility Cap needs to be specified in accordance with the ISDA 2011 Equity Derivatives Definitions." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/VolatilityCapFloor_applicable>,
        <https://w3id.org/lmodel/common-domain-model/totalVolatilityCap>,
        <https://w3id.org/lmodel/common-domain-model/volatilityCapFactor> .

<https://w3id.org/lmodel/common-domain-model/applicable> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_credit"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/applicable"^^xsd:anyURI ;
    linkml:description "Indicates whether the Not Domestic Currency provision is applicable." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FailureToPay>,
        <https://w3id.org/lmodel/common-domain-model/FinalReturns>,
        <https://w3id.org/lmodel/common-domain-model/GracePeriodExtension>,
        <https://w3id.org/lmodel/common-domain-model/NotDomesticCurrency>,
        <https://w3id.org/lmodel/common-domain-model/PCDeliverableObligationCharac>,
        <https://w3id.org/lmodel/common-domain-model/Restructuring>,
        <https://w3id.org/lmodel/common-domain-model/SpecifiedCurrency>,
        <https://w3id.org/lmodel/common-domain-model/VolatilityCapFloor> ;
    linkml:equals_string "True" ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PCDeliverableObligationCharac> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/applicable"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction> a linkml:SubsetDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CdmLegaldocumentationTransaction"^^xsd:anyURI ;
    linkml:description "Classes defined in the cdm_legaldocumentation_transaction module." .

<https://w3id.org/lmodel/common-domain-model/customElection> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AdditionalRepresentation.customElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/customElection"^^xsd:anyURI ;
    linkml:description "A supplemental custom election that might be specified by the parties for the purpose of specifying the Additional Representation." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AdditionalRepresentation>,
        <https://w3id.org/lmodel/common-domain-model/DeliveryAmount>,
        <https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection>,
        <https://w3id.org/lmodel/common-domain-model/InterestAdjustmentPeriodicity>,
        <https://w3id.org/lmodel/common-domain-model/ReturnAmount>,
        <https://w3id.org/lmodel/common-domain-model/SecurityProviderRightsEvent> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/DeliveryAmount> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/customElection"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/datetime> a linkml:TypeDefinition ;
    skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"." ;
    skos:exactMatch "schema:DateTime"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
    linkml:base "XSDDateTime" ;
    linkml:definition_uri "https://w3id.org/linkml/Datetime"^^xsd:anyURI ;
    linkml:description "The combination of a date and time" ;
    linkml:imported_from "linkml:types" ;
    linkml:repr "str" ;
    linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/notificationTime> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/notificationTime"^^xsd:anyURI ;
    linkml:description "The time by which a demand for the Transfer of Eligible Credit Support (IM) or Posted Credit Support (IM) needs to be made in order for the transfer to take place in accordance with the Transfer Timing provisions." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/CalculationAndTimingBase>,
        <https://w3id.org/lmodel/common-domain-model/CollateralInterestNotification>,
        <https://w3id.org/lmodel/common-domain-model/CollateralSpecification>,
        <https://w3id.org/lmodel/common-domain-model/NotificationTimeElection>,
        <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/RecallProvision> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/NotificationTime> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/notificationTime"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/unadjustedDate> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#AdjustableDate.unadjustedDate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/unadjustedDate"^^xsd:anyURI ;
    linkml:description "A date subject to adjustment. While in FpML this date is required, this cardinality constraint has been relaxed as part of the CDM in order to support the FRA representation, which effective and termination dates are specified in FpML as adjusted dates." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/AdjustableDate>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableDates>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/AdjustableOrAdjustedOrRelativeDate>,
        <https://w3id.org/lmodel/common-domain-model/ObservationDate> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/ObservationDate> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/unadjustedDate"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/AdjustableDate> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:AdjustableDate"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AdjustableDate"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdjustableDateChoice — optional choice dateAdjustments, dateAdjustmentsReference",
        "Rosetta func: AdjustableDateResolution — Prioritization of unadjustedDate over adjustedDate." ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dateAdjustmentsReference> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dateAdjustments> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "[{\"name\":\"AdjustableDateResolution\",\"description\":\"Prioritization of unadjustedDate over adjustedDate.\",\"inputs\":[{\"name\":\"adjustableDate\",\"type\":\"AdjustableDate\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"0..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdjustableDate"^^xsd:anyURI ;
    linkml:description "A class for defining a date that shall be subject to adjustment if it would otherwise fall on a day that is not a business day in the specified business centers, together with the convention for adjusting the date." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/adjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/dateAdjustments>,
        <https://w3id.org/lmodel/common-domain-model/dateAdjustmentsReference>,
        <https://w3id.org/lmodel/common-domain-model/unadjustedDate> .

<https://w3id.org/lmodel/common-domain-model/AdjustableRelativeOrPeriodicDates> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:AdjustableRelativeOrPeriodicDates"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AdjustableRelativeOrPeriodicDates"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdjustableRelativeOrPeriodicDatesChoice — required choice adjustableDates, relativeDates, periodicDates",
        "Rosetta func: ResolveAdjustableDates" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/relativeDates> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/adjustableDates> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/periodicDates> ] ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"ResolveAdjustableDates\",\"inputs\":[{\"name\":\"adjustableRelativeOrPeriodicDates\",\"type\":\"AdjustableRelativeOrPeriodicDates\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"adjustedDates\",\"type\":\"date\",\"cardinality\":\"0..*\"},\"code_implementation\":true}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdjustableRelativeOrPeriodicDates"^^xsd:anyURI ;
    linkml:description "A class giving the choice between defining a series of dates as an explicit list of dates together with applicable adjustments or as relative to some other series of (anchor) dates, or as a calculation period schedule." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/adjustableDates>,
        <https://w3id.org/lmodel/common-domain-model/periodicDates>,
        <https://w3id.org/lmodel/common-domain-model/relativeDates> .

<https://w3id.org/lmodel/common-domain-model/ApplicableRegime> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:closeMatch "fpml_5_10:ApplicableRegime"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:ApplicableRegime"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: ApplicableRegimeChoice — required choice regime, additionalRegime" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The applicable regime should be specified either as an enumeration or as an additional regime specified by the parties." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/regime> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalRegime> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ApplicableRegime"^^xsd:anyURI ;
    linkml:description "A class to specify the applicable regulatory regime(s) that parties to a legal agreement, such as the ISDA 2016 and 2018 CSA for Initial Margin, might be subject to." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ApplicableRegime_regime>,
        <https://w3id.org/lmodel/common-domain-model/additionalRegime>,
        <https://w3id.org/lmodel/common-domain-model/additionalTerms>,
        <https://w3id.org/lmodel/common-domain-model/additionalType>,
        <https://w3id.org/lmodel/common-domain-model/regimeTerms> .

<https://w3id.org/lmodel/common-domain-model/AssetDeliveryInformation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:closeMatch "fpml_5_10:AssetDeliveryInformation"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AssetDeliveryInformation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AssetDeliveryInformation"^^xsd:anyURI ;
    linkml:description "Contains the information relative to the delivery of the asset." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AssetDeliveryInformation_location>,
        <https://w3id.org/lmodel/common-domain-model/commodityGrade>,
        <https://w3id.org/lmodel/common-domain-model/deliveryCapacity>,
        <https://w3id.org/lmodel/common-domain-model/periods> .

<https://w3id.org/lmodel/common-domain-model/AssignedIdentifier> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_identifier> ;
    skos:closeMatch "fpml_5_10:AssignedIdentifier"^^xsd:anyURI,
        "gist:ID"^^xsd:anyURI,
        "spdx:ExternalIdentifier"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AssignedIdentifier"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_identifier"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AssignedIdentifier"^^xsd:anyURI ;
    linkml:description "A class to specify the identifier value and its associated version." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AssignedIdentifier_identifier>,
        <https://w3id.org/lmodel/common-domain-model/AssignedIdentifier_version> .

<https://w3id.org/lmodel/common-domain-model/CalculationCurrencyElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    rdfs:seeAlso "isda:CSA_IM_2016"^^xsd:anyURI ;
    skos:closeMatch "fpml_5_10:CalculationCurrencyElection"^^xsd:anyURI ;
    skos:editorialNote "ISDA CSA_IM_2016 paragraph \"13 General Principles\" clause \"(ee)(3\"" ;
    skos:exactMatch "common_domain_model:CalculationCurrencyElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: BaseCurrency — if isBaseCurrency = True then currency is absent else currency exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isBaseCurrency> ] ;
            linkml:description "A data rule to enforce that, when the SIMM calculation currency is specified as the Base Currency and vice versa." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/currency> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculationCurrencyElection"^^xsd:anyURI ;
    linkml:description "A class to specify the ISDA SIMM Calculation Currency." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CalculationCurrencyElection_currency>,
        <https://w3id.org/lmodel/common-domain-model/CalculationCurrencyElection_party>,
        <https://w3id.org/lmodel/common-domain-model/isBaseCurrency> .

<https://w3id.org/lmodel/common-domain-model/CollateralAccessBreach> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:closeMatch "fpml_5_10:CollateralAccessBreach"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CollateralAccessBreach"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: CabEndDateTerms — if cabEndDateElection = True then cabEndDateTerms is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/cabEndDateElection> ] ;
            linkml:description "A condition to require Collateral Access Breach End Date Terms when a specification is required." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/cabEndDateTerms> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CollateralAccessBreach"^^xsd:anyURI ;
    linkml:description "A class to specify Collateral Access Breach language." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CollateralAccessBreach_isApplicable>,
        <https://w3id.org/lmodel/common-domain-model/cabEndDate>,
        <https://w3id.org/lmodel/common-domain-model/cabEndDateElection>,
        <https://w3id.org/lmodel/common-domain-model/cabEndDateTerms> .

<https://w3id.org/lmodel/common-domain-model/CollateralProvisions> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:closeMatch "fpml_5_10:CollateralProvisions"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CollateralProvisions"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:relatedMatch "gist:ContractTerm"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CollateralProvisions"^^xsd:anyURI ;
    linkml:description "Contains collateral attributes which can also inherit information from a GMRA" ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CollateralProvisions_eligibleCollateral>,
        <https://w3id.org/lmodel/common-domain-model/collateralType>,
        <https://w3id.org/lmodel/common-domain-model/substitutionProvisions> .

<https://w3id.org/lmodel/common-domain-model/CommodityReferenceFramework> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:closeMatch "fpml_5_10:CommodityReferenceFramework"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CommodityReferenceFramework"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: CommodityReferenceFrameworkChoice — optional choice capacityUnit, weatherUnit" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Requires that either the capacity unit or weather unit is populated." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/capacityUnit> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/weatherUnit> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CommodityReferenceFramework"^^xsd:anyURI ;
    linkml:description "Specifies the type of commodity." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CommodityReferenceFramework_currency>,
        <https://w3id.org/lmodel/common-domain-model/capacityUnit>,
        <https://w3id.org/lmodel/common-domain-model/commodityName>,
        <https://w3id.org/lmodel/common-domain-model/weatherUnit> .

<https://w3id.org/lmodel/common-domain-model/ControlAgreementElections> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ControlAgreementElections"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ControlAgreementElections"^^xsd:anyURI ;
    linkml:description "A class to specify the Control Agreement election sby each party to the agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ControlAgreementElections_party>,
        <https://w3id.org/lmodel/common-domain-model/consistencyWithControlAgreement>,
        <https://w3id.org/lmodel/common-domain-model/controlAgreementAsCsd>,
        <https://w3id.org/lmodel/common-domain-model/relationshipWithControlAgreement> .

<https://w3id.org/lmodel/common-domain-model/CounterpartyPositionState> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:CounterpartyPositionState"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CounterpartyPositionState"^^xsd:anyURI ;
    linkml:description "Defines the fundamental financial information that can be changed by a Primitive Event and by extension any business or life-cycle event. Each PositionState specifies where a Position is in its life-cycle. PositionState is a root type and as such, can be created independently to any other CDM data type, but can also be used as part of the CDM Event Model." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CounterpartyPositionState_state>,
        <https://w3id.org/lmodel/common-domain-model/counterpartyPosition>,
        <https://w3id.org/lmodel/common-domain-model/observationHistory>,
        <https://w3id.org/lmodel/common-domain-model/valuationHistory> ;
    linkml:tree_root true .

<https://w3id.org/lmodel/common-domain-model/CreditDefaultPayout> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:CreditDefaultPayout"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: FpML_cd_12 — if generalTerms -> referenceInformation -> referencePrice exists then generalTerms -> referenceInformation -> referencePrice -> value >= 0",
        "Rosetta condition: Quantity — priceQuantity exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "When there is an OptionPayout the quantity can be expressed as part of the payoutQuantity, or as part of the underlier in the case of a Swaption.  For all other payouts that extend PayoutBase the payoutQuantity is a mandatory attribute." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/priceQuantity> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CreditDefaultPayout"^^xsd:anyURI ;
    linkml:description " The credit default payout specification provides the details necessary for determining when a credit payout will be triggered as well as the parameters for calculating the payout and the settlement terms. The associated globalKey denotes the ability to associate a hash value to the CreditDefaultPayout instantiations for the purpose of model cross-referencing, in support of functionality such as the event effect and the lineage." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/PayoutBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/PayoutBase_payerReceiver>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase_priceQuantity>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase_settlementTerms>,
        <https://w3id.org/lmodel/common-domain-model/generalTerms>,
        <https://w3id.org/lmodel/common-domain-model/principalPayment>,
        <https://w3id.org/lmodel/common-domain-model/protectionTerms>,
        <https://w3id.org/lmodel/common-domain-model/transactedPrice> .

<https://w3id.org/lmodel/common-domain-model/ExcludedProducts> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ExcludedProducts"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExcludedProducts"^^xsd:anyURI ;
    linkml:description "Description of the relevant derivative transactions excluded from the calculation of exposure." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ExcludedProducts_excluded>,
        <https://w3id.org/lmodel/common-domain-model/ExcludedProducts_product>,
        <https://w3id.org/lmodel/common-domain-model/branch> .

<https://w3id.org/lmodel/common-domain-model/ExerciseInstruction> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:ExerciseInstruction"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta func: Create_Exercise — Defines the process of putting into effect the rights specified in an options contract, such as to buy or sell a security.  Once exercised the option contract is terminated." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"Create_Exercise\",\"description\":\"Defines the process of putting into effect the rights specified in an options contract, such as to buy or sell a security.  Once exercised the option contract is terminated.\",\"inputs\":[{\"name\":\"exerciseInstruction\",\"type\":\"ExerciseInstruction\",\"cardinality\":\"1..1\"},{\"name\":\"originalTrade\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"exercise\",\"type\":\"TradeState\",\"cardinality\":\"1..*\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExerciseInstruction"^^xsd:anyURI ;
    linkml:description "Specifies the information required to communicate the choices made by the exercising party, in a financial product endowing the party with at least one option." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/exerciseDate>,
        <https://w3id.org/lmodel/common-domain-model/exerciseOption>,
        <https://w3id.org/lmodel/common-domain-model/exerciseQuantity>,
        <https://w3id.org/lmodel/common-domain-model/exerciseTime>,
        <https://w3id.org/lmodel/common-domain-model/replacementTradeIdentifier> .

<https://w3id.org/lmodel/common-domain-model/ExerciseNotice> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:ExerciseNotice"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExerciseNotice"^^xsd:anyURI ;
    linkml:description "Defines to whom and where notice of execution should be given. The exerciseNoticeGiver refers to one or both of the principal parties of the trade. If present the exerciseNoticeReceiver refers to a party, other than the principal party, to whom notice should be given." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ExerciseNotice_businessCenter>,
        <https://w3id.org/lmodel/common-domain-model/exerciseNoticeGiver>,
        <https://w3id.org/lmodel/common-domain-model/exerciseNoticeReceiver> .

<https://w3id.org/lmodel/common-domain-model/ExerciseProcedure> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:exactMatch "common_domain_model:ExerciseProcedure"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: ExerciseProcedureChoice — required choice manualExercise, automaticExercise" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule to represent an FpML choice construct." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/manualExercise> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/automaticExercise> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExerciseProcedure"^^xsd:anyURI ;
    linkml:description "A class describing how notice of exercise should be given. This can be either manual or automatic." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/automaticExercise>,
        <https://w3id.org/lmodel/common-domain-model/followUpConfirmation>,
        <https://w3id.org/lmodel/common-domain-model/limitedRightToConfirm>,
        <https://w3id.org/lmodel/common-domain-model/manualExercise>,
        <https://w3id.org/lmodel/common-domain-model/splitTicket> .

