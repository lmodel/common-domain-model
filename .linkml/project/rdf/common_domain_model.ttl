    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/appliesTo>,
        <https://w3id.org/lmodel/common-domain-model/averageTradingVolume>,
        <https://w3id.org/lmodel/common-domain-model/collateralCriteria>,
        <https://w3id.org/lmodel/common-domain-model/concentrationLimitType>,
        <https://w3id.org/lmodel/common-domain-model/ratingPriorityResolution>,
        <https://w3id.org/lmodel/common-domain-model/restrictTo> .

<https://w3id.org/lmodel/common-domain-model/ConstituentWeight> a linkml:ClassDefinition ;
