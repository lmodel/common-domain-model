    linkml:is_a <https://w3id.org/lmodel/common-domain-model/value> ;
    linkml:is_usage_slot true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/MasterAgreementVariableSet> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/string> ;
