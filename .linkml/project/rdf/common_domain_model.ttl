    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ClosedState"^^xsd:anyURI ;
    linkml:description " A class to qualify the closed state of an execution or a contract through the combination or a state (e.g. terminated, novated) and a set of dates: activity date, effective date and, when relevant, last payment date." ;
