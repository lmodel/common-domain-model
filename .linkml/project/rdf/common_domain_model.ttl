<https://w3id.org/lmodel/common-domain-model/daysInRangeAdjustment> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#BoundedVariance.daysInRangeAdjustment"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/daysInRangeAdjustment"^^xsd:anyURI ;
    linkml:description "The contract specifies whether the notional should be scaled by the Number of Days in Range divided by the Expected N. The number of Days in Ranges refers to the number of returns that contribute to the realized volatility." ;
