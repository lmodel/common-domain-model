	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/MultipleExercise> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/MultipleExercise> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/maximumNotionalAmount"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/multipleExercise__maximumNumberOfOptions> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
	skos:prefLabel "maximumNumberOfOptions" ;
	linkml:description "The maximum number of options that can be exercised on a given exercise date. If the number is not specified, it means that the maximum number of options corresponds to the remaining unexercised options." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/MultipleExercise> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/MultipleExercise> ;
