<https://w3id.org/lmodel/common-domain-model/FxSettlementRateSource> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_observable_asset> ;
    skos:exactMatch "common_domain_model:FxSettlementRateSource"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: FxSettlementRateSourceChoice — required choice settlementRateOption, nonstandardSettlementRate" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "FxSettlementRateSourceChoice" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nonstandardSettlementRate> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/settlementRateOption> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FxSettlementRateSource"^^xsd:anyURI ;
    linkml:description "The source of the Foreign Exchange settlement rate." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FxSettlementRateSource_settlementRateOption>,
        <https://w3id.org/lmodel/common-domain-model/nonstandardSettlementRate> .

