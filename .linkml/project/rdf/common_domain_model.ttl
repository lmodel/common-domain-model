<https://w3id.org/lmodel/common-domain-model/CalculationPeriodFrequency> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:CalculationPeriodFrequency"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CalculationPeriodFrequency"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: FpML_ird_57 — if period = PeriodExtendedEnum -> M or period = PeriodExtendedEnum -> Y then rollConvention <> RollConventionEnum -> NONE and rollConvention <> RollConventionEnum -> SFE and rollConvention <> RollConventionEnum -> MON and rollConvention <> RollConventionEnum -> TUE and rollConvention <> RollConventionEnum -> WED and rollConvention <> RollConventionEnum -> THU and rollConvention <> RollConventionEnum -> FRI and rollConvention <> RollConventionEnum -> SAT and rollConvention <> RollConventionEnum -> SUN",
        "Rosetta condition: FpML_ird_58 — if period = PeriodExtendedEnum -> W then rollConvention = RollConventionEnum -> NONE or rollConvention = RollConventionEnum -> SFE or rollConvention = RollConventionEnum -> MON or rollConvention = RollConventionEnum -> TUE or rollConvention = RollConventionEnum -> WED or rollConvention = RollConventionEnum -> THU or rollConvention = RollConventionEnum -> FRI or rollConvention = RollConventionEnum -> SAT or rollConvention = RollConventionEnum -> SUN",
        "Rosetta condition: FpML_ird_60 — if period = PeriodExtendedEnum -> T then rollConvention = RollConventionEnum -> NONE" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CalculationPeriodFrequency"^^xsd:anyURI ;
    linkml:description "A class to specify the frequency at which calculation period end dates occur within the regular part of the calculation period schedule and their roll date convention." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/Frequency> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/balanceOfFirstPeriod>,
        <https://w3id.org/lmodel/common-domain-model/period>,
        <https://w3id.org/lmodel/common-domain-model/periodMultiplier>,
        <https://w3id.org/lmodel/common-domain-model/rollConvention> .

<https://w3id.org/lmodel/common-domain-model/Cash> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:closeMatch "gist:Magnitude"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:Cash"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: AssetType — assetType = Cash",
        "Rosetta condition: CurrencyExists — AssetIdentifierByType(identifier, AssetIdTypeEnum -> CurrencyCode) count = 1 and AssetIdentifierByType(identifier, AssetIdTypeEnum -> CurrencyCode) -> identifier first to-enum CurrencyCodeEnum exists",
        "Rosetta condition: NoExchange — exchange is absent and isExchangeListed is absent",
        "Rosetta condition: NoTaxonomy — taxonomy is absent",
        "Rosetta func: GetCashCurrency — Returns the enumerated Currency Code of a Cash asset.",
        "Rosetta func: SetCashCurrency — Sets (or updates) the string identifier of a Cash asset using an enumerated Currency Code." ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "AssetType must be cash." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/assetType> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Taxonomy is not applicable for a Cash asset." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/taxonomy> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Cash cannot be a listed Asset." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/exchange>,
                        <https://w3id.org/lmodel/common-domain-model/isExchangeListed> ] ] ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"GetCashCurrency\",\"description\":\"Returns the enumerated Currency Code of a Cash asset.\",\"inputs\":[{\"name\":\"cash\",\"type\":\"Cash\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"currencyEnum\",\"type\":\"CurrencyCodeEnum\",\"cardinality\":\"1..1\"}},{\"name\":\"SetCashCurrency\",\"description\":\"Sets (or updates) the string identifier of a Cash asset using an enumerated Currency Code.\",\"inputs\":[{\"name\":\"cash\",\"type\":\"Cash\",\"cardinality\":\"0..1\"},{\"name\":\"currency\",\"type\":\"CurrencyCodeEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"cashOutput\",\"type\":\"Cash\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Cash"^^xsd:anyURI ;
    linkml:description "An Asset that consists solely of a monetary holding in a currency. The currency of the Cash asset is held in the string Identifier (from AssetBase) and the AssetIdTypeEnum must be set to define that a CurrencyCode is set.  The function SetCashCurrency can be used to create (or update) a Cash object and the function GetCashCurrency can be used to retrieve the currency of a Cash object.",
        "Identifies cash in a currency form.",
        "Security Lending Trades against Cash collateral",
        "The intrinsic value of the option will be delivered by way of a cash settlement amount determined, (i) by reference to the differential between the strike price and the settlement price; or (ii) in accordance with a bilateral agreement between the parties.",
        "When the margin type is Cash, the margin factor is applied to the cash value of the transaction." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/AssetBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/assetType>,
        <https://w3id.org/lmodel/common-domain-model/exchange>,
        <https://w3id.org/lmodel/common-domain-model/identifier>,
        <https://w3id.org/lmodel/common-domain-model/isExchangeListed>,
        <https://w3id.org/lmodel/common-domain-model/relatedExchange>,
        <https://w3id.org/lmodel/common-domain-model/taxonomy> .

<https://w3id.org/lmodel/common-domain-model/CollateralTaxonomy> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    skos:closeMatch "fpml_5_10:CollateralTaxonomy"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CollateralTaxonomy"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: Eu_EligibleCollateralTaxonomy — if taxonomySource = TaxonomySourceEnum -> EU_EMIR_EligibleCollateralAssetClass then taxonomyValue -> eu_EMIR_EligibleCollateral exists",
        "Rosetta condition: TaxonomyValue — if taxonomyValue -> nonEnumeratedTaxonomyValue exists then taxonomySource <> TaxonomySourceEnum -> EU_EMIR_EligibleCollateralAssetClass and taxonomySource <> TaxonomySourceEnum -> UK_EMIR_EligibleCollateralAssetClass and taxonomySource <> TaxonomySourceEnum -> US_CFTC_PR_EligibleCollateralAssetClass",
        "Rosetta condition: UkEligibleCollateralTaxonomy — if taxonomySource = TaxonomySourceEnum -> UK_EMIR_EligibleCollateralAssetClass then taxonomyValue -> uk_EMIR_EligibleCollateral exists",
        "Rosetta condition: UsEligibleCollateralTaxonomy — if taxonomySource = TaxonomySourceEnum -> US_CFTC_PR_EligibleCollateralAssetClass then taxonomyValue -> us_CFTC_PR_EligibleCollateral exists" ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CollateralTaxonomy"^^xsd:anyURI ;
    linkml:description "Specifies the collateral taxonomy, which is composed of a taxonomy value and a taxonomy source." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/taxonomySource>,
        <https://w3id.org/lmodel/common-domain-model/taxonomyValue> .

<https://w3id.org/lmodel/common-domain-model/ConcentrationLimit> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:exactMatch "common_domain_model:ConcentrationLimit"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta condition: ConcentrationLimitValueChoice — required choice valueLimit, percentageLimit",
        "Rosetta condition: PercentageConcentrationLimit — if concentrationLimitCriteria -> concentrationLimitType = ConcentrationLimitTypeEnum -> MarketCapitalisation then percentageLimit exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Either a value or percentage concentration limit must be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/percentageLimit> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/valueLimit> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ConcentrationLimit"^^xsd:anyURI ;
    linkml:description "Represents a class to describe concentration limits that may be applicable to eligible collateral criteria." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/concentrationLimitCriteria>,
        <https://w3id.org/lmodel/common-domain-model/percentageLimit>,
        <https://w3id.org/lmodel/common-domain-model/valueLimit> .

<https://w3id.org/lmodel/common-domain-model/ContractualTermsSupplement> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common> ;
    skos:exactMatch "common_domain_model:ContractualTermsSupplement"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ContractualTermsSupplement"^^xsd:anyURI ;
    linkml:description "A contractual supplement (such as those published by ISDA) and its publication date that will apply to the trade." ;
