    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/paymentPercent"^^xsd:anyURI ;
    linkml:description "A percentage of the notional amount." ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PercentageRule> ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/PercentageRule> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
    linkml:required true ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentPercent"^^xsd:anyURI .

<https://w3id.org/lmodel/common-domain-model/paymentRequirement> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_observable_event"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/paymentRequirement"^^xsd:anyURI ;
    linkml:description "Specifies a threshold for the failure to pay credit event. Market standard is USD 1,000,000 (JPY 100,000,000 for Japanese Yen trades) or its equivalent in the relevant obligation currency. This is applied on an aggregate basis across all Obligations of the Reference Entity. Intended to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Payment Requirement" ;
    linkml:domain_of <https://w3id.org/lmodel/common-domain-model/FailureToPay> ;
    linkml:inlined true ;
    linkml:inlined_as_list true ;
    linkml:owner <https://w3id.org/lmodel/common-domain-model/FailureToPay> ;
    linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
    linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentRequirement"^^xsd:anyURI .

