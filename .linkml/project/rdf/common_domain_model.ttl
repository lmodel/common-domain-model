<https://w3id.org/lmodel/common-domain-model/Reset> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:Reset"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: AveragingMethodologyExists — if observations count > 1 then averagingMethodology exists",
        "Rosetta func: InterestCashSettlementAmount — Defines the performance calculations relevant for a fixed or floating rate payout.",
        "Rosetta func: ResolveInterestRateReset — Defines how to resolve the reset value for an InterestRatePayout.",
        "Rosetta func: ResolvePerformanceReset — Defines how to resolve the reset value for a performance payout.",
        "Rosetta func: ResolveReset — Defines the interface for adopters to resolve a reset, given a trade state and a date.",
        "Rosetta func: ResolveSecurityFinanceBillingAmount — Calculates the billing amount for a Security Finance transaction." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"ResolveInterestRateReset\",\"description\":\"Defines how to resolve the reset value for an InterestRatePayout.\",\"inputs\":[{\"name\":\"payouts\",\"type\":\"InterestRatePayout\",\"cardinality\":\"1..*\"},{\"name\":\"observation\",\"type\":\"Observation\",\"cardinality\":\"1..1\"},{\"name\":\"resetDate\",\"type\":\"date\",\"cardinality\":\"1..1\"},{\"name\":\"rateRecordDate\",\"type\":\"date\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"reset\",\"type\":\"Reset\",\"cardinality\":\"1..1\"}},{\"name\":\"InterestCashSettlementAmount\",\"description\":\"Defines the performance calculations relevant for a fixed or floating rate payout.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"},{\"name\":\"payout\",\"type\":\"Payout\",\"cardinality\":\"1..1\"},{\"name\":\"resets\",\"type\":\"Reset\",\"cardinality\":\"1..*\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"interestCashSettlementAmount\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}},{\"name\":\"ResolveReset\",\"description\":\"Defines the interface for adopters to resolve a reset, given a trade state and a date.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"reset\",\"type\":\"Reset\",\"cardinality\":\"1..1\"},\"code_implementation\":true},{\"name\":\"ResolvePerformanceReset\",\"description\":\"Defines how to resolve the reset value for a performance payout.\",\"inputs\":[{\"name\":\"performancePayout\",\"type\":\"PerformancePayout\",\"cardinality\":\"1..1\"},{\"name\":\"observation\",\"type\":\"Observation\",\"cardinality\":\"1..1\"},{\"name\":\"date\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"reset\",\"type\":\"Reset\",\"cardinality\":\"1..1\"}},{\"name\":\"ResolveSecurityFinanceBillingAmount\",\"description\":\"Calculates the billing amount for a Security Finance transaction.\",\"inputs\":[{\"name\":\"tradeState\",\"type\":\"TradeState\",\"cardinality\":\"1..1\"},{\"name\":\"reset\",\"type\":\"Reset\",\"cardinality\":\"1..1\"},{\"name\":\"recordStartDate\",\"type\":\"date\",\"cardinality\":\"1..1\"},{\"name\":\"recordEndDate\",\"type\":\"date\",\"cardinality\":\"1..1\"},{\"name\":\"transferDate\",\"type\":\"date\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"transfer\",\"type\":\"Transfer\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Reset"^^xsd:anyURI ;
    linkml:description "Defines the reset value or fixing value produced in cashflow calculations, during the life-cycle of a financial instrument. The reset process defined in Create_Reset function joins product definition details with observations to compute the reset value." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Reset_resetDate>,
        <https://w3id.org/lmodel/common-domain-model/averagingMethodology>,
        <https://w3id.org/lmodel/common-domain-model/observations>,
        <https://w3id.org/lmodel/common-domain-model/rateRecordDate>,
        <https://w3id.org/lmodel/common-domain-model/resetValue> .

<https://w3id.org/lmodel/common-domain-model/Security> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common> ;
    rdfs:seeAlso "icma:GMRA"^^xsd:anyURI ;
    skos:editorialNote "ICMA GMRA namingConvention \"Purchased Security\"" ;
    skos:exactMatch "common_domain_model:Security"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_staticdata_asset_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: AssetType — assetType = Security",
        "Rosetta condition: DebtSubType — if securityType <> Debt then debtType is absent",
        "Rosetta condition: EquitySubType — if securityType <> Equity then equityType is absent",
        "Rosetta condition: FundSubType — if securityType <> Fund then fundType is absent" ;
    sh:rule [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securityType <> Debt" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securityType> ] ;
            linkml:description "DebtSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/debtType> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securityType <> Equity" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securityType> ] ;
            linkml:description "EquitySubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/equityType> ] ],
        [ a linkml:ClassRule ;
            skos:note "Rosetta negation: securityType <> Fund" ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/securityType> ] ;
            linkml:description "FundSubType" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fundType> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Asset type must be Security." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/assetType> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Security"^^xsd:anyURI ;
    linkml:description "Identifies a security by referencing an identifier and by specifying the sector.",
        "Identifies negotiable financial instrument of monetary value with an issue ownership position." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/InstrumentBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/assetType>,
        <https://w3id.org/lmodel/common-domain-model/debtType>,
        <https://w3id.org/lmodel/common-domain-model/equityType>,
        <https://w3id.org/lmodel/common-domain-model/exchange>,
        <https://w3id.org/lmodel/common-domain-model/fundType>,
        <https://w3id.org/lmodel/common-domain-model/identifier>,
        <https://w3id.org/lmodel/common-domain-model/isExchangeListed>,
        <https://w3id.org/lmodel/common-domain-model/relatedExchange>,
        <https://w3id.org/lmodel/common-domain-model/securityType>,
        <https://w3id.org/lmodel/common-domain-model/taxonomy> .

