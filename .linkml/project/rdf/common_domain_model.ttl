<https://w3id.org/lmodel/common-domain-model/FxHaircutCurrency> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:FxHaircutCurrency"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: FxDesignatedCurrency — if isTerminationCurrency = False then fxDesignatedCurrency exists",
        "Rosetta condition: TerminationCurrency — if isTerminationCurrency = True then fxDesignatedCurrency is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isTerminationCurrency> ] ;
            linkml:description "The FX Designated Currency shouldn't be specified when the reference currency for the purpose of specifying the FX Haircut relating to a posting obligation is specified as the Termination Currency." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fxDesignatedCurrency> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/isTerminationCurrency> ] ;
            linkml:description "The FX Designated Currency should be specified when the reference currency for the purpose of specifying the FX Haircut relating to a posting obligation is specified as not being the Termination Currency." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fxDesignatedCurrency> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FxHaircutCurrency"^^xsd:anyURI ;
    linkml:description "A class to specify the reference currency for the purpose of specifying the FX Haircut relating to a posting obligation, as being either the Termination Currency or an FX Designated Currency." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/fxDesignatedCurrency>,
        <https://w3id.org/lmodel/common-domain-model/isTerminationCurrency> .

