<https://w3id.org/lmodel/common-domain-model/ObservationTerms_calculationPeriodDates> a linkml:SlotDefinition ;
    skos:closeMatch "https://www.fpml.org/spec/fpml-5-10#CommodityPayout.calculationPeriodDates"^^xsd:anyURI ;
