    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/SecuredPartyRightsEvent"^^xsd:anyURI ;
    linkml:description "A class to specify Secured Party Rights Event language." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/earlyTerminationDateOptionalLanguage>,
        <https://w3id.org/lmodel/common-domain-model/failureToPayEarlyTermination>,
