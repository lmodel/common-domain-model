<https://w3id.org/lmodel/common-domain-model/numberOfDataSeries> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta: strictly greater than" ;
