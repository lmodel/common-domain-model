<https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ElectiveAmountElection"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: NonZeroAmount — if electiveAmount is absent then amount exists or customElection exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/electiveAmount> ] ;
            linkml:description "When the elective amount is not zero either a currency amount or a custom election must exist." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/customElection> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/amount> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection"^^xsd:anyURI ;
    linkml:description "A class to specify the party elective amounts which can be used for the purpose of specifying elections such as the ISDA CSA Threshold and Minimum Transfer Amount." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection_amount>,
        <https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection_customElection>,
        <https://w3id.org/lmodel/common-domain-model/ElectiveAmountElection_party>,
        <https://w3id.org/lmodel/common-domain-model/electiveAmount> .

<https://w3id.org/lmodel/common-domain-model/EquityUnderlierProvisions> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:EquityUnderlierProvisions"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: ComponentSecurityOrMultipleExchange — optional choice multipleExchangeIndexAnnexFallback, componentSecurityIndexAnnexFallback" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "If multipleExchangeIndexAnnexFallback is present then componentSecurityIndexAnnexFallback must be absent and vice versa." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:any_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/multipleExchangeIndexAnnexFallback> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/componentSecurityIndexAnnexFallback> ] ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EquityUnderlierProvisions"^^xsd:anyURI ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/EquityUnderlierProvisions_componentSecurityIndexAnnexFallback>,
        <https://w3id.org/lmodel/common-domain-model/EquityUnderlierProvisions_multipleExchangeIndexAnnexFallback>,
        <https://w3id.org/lmodel/common-domain-model/localJurisdiction>,
        <https://w3id.org/lmodel/common-domain-model/relevantJurisdiction> .

<https://w3id.org/lmodel/common-domain-model/ExecutionLocation> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
    skos:exactMatch "common_domain_model:ExecutionLocation"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa"^^xsd:anyURI ;
    skos:note "Rosetta condition: DutyPayerLanguage — if dutyPayer = \"Specify\" then dutyPayerLanguage exists",
        "Rosetta condition: DutyPaymentLanguage — if dutyPaymentDate exists then dutyPaymentLanguage is absent",
        "Rosetta condition: OtherLanguage — if executionLocation = ExecutionLocationEnum -> OtherLocation then otherLanguage exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/executionLocation> ] ;
            linkml:description "A data rule to enforce that bespoke execution language must be included if non-standard execution language is specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/otherLanguage> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dutyPaymentDate> ] ;
            linkml:description "A data rule to enforce that Duty Payment Language should be absent when a Duty Payment date is provided." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dutyPaymentLanguage> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dutyPayer> ] ;
            linkml:description "A data rule to enforce that Duty Payer Language should only be specified when required." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/dutyPayerLanguage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ExecutionLocation"^^xsd:anyURI ;
    linkml:description "A class to specify execution location terms of a Security Agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/ExecutionLocation_otherLanguage>,
        <https://w3id.org/lmodel/common-domain-model/dutyPayer>,
        <https://w3id.org/lmodel/common-domain-model/dutyPayerLanguage>,
        <https://w3id.org/lmodel/common-domain-model/dutyPaymentDate>,
        <https://w3id.org/lmodel/common-domain-model/dutyPaymentLanguage>,
        <https://w3id.org/lmodel/common-domain-model/executionLocation> .

<https://w3id.org/lmodel/common-domain-model/FloatingRateSettingDetails> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset_floatingrate> ;
    skos:exactMatch "common_domain_model:FloatingRateSettingDetails"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset_floatingrate"^^xsd:anyURI ;
    skos:note "Rosetta func: DetermineFloatingRateReset — Get the value of a floating rate by either observing it directly or performing a rate calculation.  This function works differently depending on the rate category and style, as described in the 2021 ISDA Definitions, Section 6.6.",
        "Rosetta func: EvaluateScreenRate — Evaluate/lookup the value of a screen rate.",
        "Rosetta func: ProcessFloatingRateReset — Entry point for the function that performs the floating rate resetting operation.  There are different variations depending on the processing type (e.g. screen rate, OIS, modular calculated rate. ." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"DetermineFloatingRateReset\",\"description\":\"Get the value of a floating rate by either observing it directly or performing a rate calculation.  This function works differently depending on the rate category and style, as described in the 2021 ISDA Definitions, Section 6.6.\",\"inputs\":[{\"name\":\"interestRatePayout\",\"type\":\"InterestRatePayout\",\"cardinality\":\"1..1\"},{\"name\":\"calcPeriod\",\"type\":\"CalculationPeriodBase\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"floatingRate\",\"type\":\"FloatingRateSettingDetails\",\"cardinality\":\"1..1\"}},{\"name\":\"ProcessFloatingRateReset\",\"description\":\"Entry point for the function that performs the floating rate resetting operation.  There are different variations depending on the processing type (e.g. screen rate, OIS, modular calculated rate. .\",\"inputs\":[{\"name\":\"interestRatePayout\",\"type\":\"InterestRatePayout\",\"cardinality\":\"1..1\"},{\"name\":\"calcPeriod\",\"type\":\"CalculationPeriodBase\",\"cardinality\":\"1..1\"},{\"name\":\"processingType\",\"type\":\"FloatingRateIndexProcessingTypeEnum\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"floatingRate\",\"type\":\"FloatingRateSettingDetails\",\"cardinality\":\"1..1\"},\"code_implementation\":true},{\"name\":\"EvaluateScreenRate\",\"description\":\"Evaluate/lookup the value of a screen rate.\",\"inputs\":[{\"name\":\"rateDef\",\"type\":\"FloatingRate\",\"cardinality\":\"1..1\"},{\"name\":\"resetDates\",\"type\":\"ResetDates\",\"cardinality\":\"1..1\"},{\"name\":\"calculationPeriod\",\"type\":\"CalculationPeriodBase\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"details\",\"type\":\"FloatingRateSettingDetails\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/FloatingRateSettingDetails"^^xsd:anyURI ;
    linkml:description "Type for reporting the raw (untreated) observed or calculated rate for a calculation period.  If this is a calculated rate, it allows details of the observations and the resulting rate to be returned." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/FloatingRateSettingDetails_floatingRate>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateSettingDetails_observationDate>,
        <https://w3id.org/lmodel/common-domain-model/FloatingRateSettingDetails_resetDate>,
        <https://w3id.org/lmodel/common-domain-model/calculationDetails> .

