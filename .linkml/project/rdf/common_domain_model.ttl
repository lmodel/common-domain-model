<https://w3id.org/lmodel/common-domain-model/notification> a linkml:SlotDefinition ;
	linkml:description "Specifies the terms describing notification requirements." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/CollateralInterestNotification> .
<https://w3id.org/lmodel/common-domain-model/notificationDayType> a linkml:SlotDefinition ;
