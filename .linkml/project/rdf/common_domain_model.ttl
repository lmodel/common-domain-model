	linkml:annotations _:c14n1403 ;
	linkml:description "This settlement rate option will be used in its place." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/SettlementRateOptionEnum> .
<https://w3id.org/lmodel/common-domain-model/fallback> a linkml:SlotDefinition ;
	linkml:description "Represents whether a fallback calculation method is applicable. 'True' if fallback calculation method is applicable." ;
