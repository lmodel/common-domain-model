<https://w3id.org/lmodel/common-domain-model/paymentDates> a linkml:SlotDefinition ;
	linkml:description "Defines the payment date schedule, as defined by the parameters that are needed to specify it, either in a parametric way or by reference to another schedule of dates (e.g. the valuation dates)." , "Specifies the parameters to generate the payment date schedule, either through a parametric representation or by reference to specified dates." , "The payment date schedule, as defined by the parameters that are needed to specify it, either in a parametric way or by reference to another schedule of dates (e.g. the reset dates)." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:required true ;
	linkml:value_presence "ABSENT" , "PRESENT" .
<https://w3id.org/lmodel/common-domain-model/paymentDatesAdjustments> a linkml:SlotDefinition ;
	linkml:description "The definition of the business day convention and financial business centers used for adjusting the payment date if it would otherwise fall on a day that is not a business day in the specified business center." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessDayAdjustments> .
<https://w3id.org/lmodel/common-domain-model/paymentDatesReference> a linkml:SlotDefinition ;
	linkml:annotations _:c14n296 ;
	linkml:description "A set of href pointers to payment dates defined somewhere else in the document." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/paymentDates__firstPaymentDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "firstPaymentDate" ;
	linkml:description "The first unadjusted payment date. This day may be subject to adjustment in accordance with any business day convention specified in paymentDatesAdjustments. This element must only be included if there is an initial stub. This date will normally correspond to an unadjusted calculation period start or end date. This is true even if early or delayed payment is specified to be applicable since the actual first payment date will be the specified number of days before or after the applicable adjusted calculation period start or end date with the resulting payment date then being adjusted in accordance with any business day convention specified in paymentDatesAdjustments." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/firstPaymentDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDates__lastRegularPaymentDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "lastRegularPaymentDate" ;
	linkml:description "The last regular payment date when specified as a date, as in the FpML interest rate construct. FpML specifies that this date may be subject to adjustment in accordance with any business day convention specified in the paymentDatesAdjustments attribute." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/date> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/lastRegularPaymentDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDates__payRelativeTo> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "payRelativeTo" ;
	linkml:description "Specifies whether the payments occur relative to each adjusted calculation period start date or end date, each reset date, valuation date or the last pricing date. Calculation period start date means relative to the start of the first calculation period contributing to a given payment. Similarly, calculation period end date means the end of the last calculation period contributing to a given payment. The valuation date is applicable for Brazilian-CDI and equity swaps." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PayRelativeToEnum> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/payRelativeTo"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDates__paymentDateSchedule> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "paymentDateSchedule" ;
	linkml:description "The payment dates when specified as relative to a set of dates specified somewhere else in the instance document/transaction, e.g. the valuation dates as typically the case for equity swaps, or when specified as a calculation period schedule." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PaymentDateSchedule> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentDateSchedule"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDates__paymentDatesAdjustments> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "paymentDatesAdjustments" ;
	linkml:description "The definition of the business day convention and financial business centers used for adjusting the payment date if it would otherwise fall on a day that is not a business day in the specified business center." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/BusinessDayAdjustments> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentDatesAdjustments"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDates__paymentDaysOffset> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "paymentDaysOffset" ;
	linkml:description "If early payment or delayed payment is required, specifies the number of days offset that the payment occurs relative to what would otherwise be the unadjusted payment date. The offset can be specified in terms of either calendar or business days. Even in the case of a calendar days offset, the resulting payment date, adjusted for the specified calendar days offset, will still be adjusted in accordance with the specified payment dates adjustments. This element should only be included if early or delayed payment is applicable, i.e. if the periodMultiplier element value is not equal to zero. An early payment would be indicated by a negative periodMultiplier element value and a delayed payment (or payment lag) would be indicated by a positive periodMultiplier element value." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentDaysOffset"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDates__paymentFrequency> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
	skos:prefLabel "paymentFrequency" ;
	linkml:description "The frequency at which regular payment dates occur. If the payment frequency is equal to the frequency defined in the calculation period dates component then one calculation period contributes to each payment amount. If the payment frequency is less frequent than the frequency defined in the calculation period dates component then more than one calculation period will contribute to the payment amount. A payment frequency more frequent than the calculation period frequency or one that is not a multiple of the calculation period frequency is invalid. If the payment frequency is of value T (term), the period is defined by the effectiveDate and the terminationDate." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDates> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Frequency> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentFrequency"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDaysOffset> a linkml:SlotDefinition ;
	linkml:description "If early payment or delayed payment is required, specifies the number of days offset that the payment occurs relative to what would otherwise be the unadjusted payment date. The offset can be specified in terms of either calendar or business days. Even in the case of a calendar days offset, the resulting payment date, adjusted for the specified calendar days offset, will still be adjusted in accordance with the specified payment dates adjustments. This element should only be included if early or delayed payment is applicable, i.e. if the periodMultiplier element value is not equal to zero. An early payment would be indicated by a negative periodMultiplier element value and a delayed payment (or payment lag) would be indicated by a positive periodMultiplier element value." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Offset> .
<https://w3id.org/lmodel/common-domain-model/paymentDelay> a linkml:SlotDefinition ;
	linkml:description "Applicable to CDS on MBS to specify whether payment delays are applicable to the fixed Amount. RMBS typically have a payment delay of 5 days between the coupon date of the reference obligation and the payment date of the synthetic swap. CMBS do not, on the other hand, with both payment dates being on the 25th of each month." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> .
<https://w3id.org/lmodel/common-domain-model/paymentDetail> a linkml:SlotDefinition ;
	linkml:description "An attribute that specifies a payment as the combination of a payment amount, a payment date and an associated payment calculation rule." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PaymentDetail> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/paymentDetail__paymentAmount> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "paymentAmount" ;
	linkml:description "A fixed payment amount." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDetail> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDetail> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentAmount"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDetail__paymentDate> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "paymentDate" ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDetail> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDetail> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/AdjustableOrRelativeDate> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentDate"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDetail__paymentRule> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "paymentRule" ;
	linkml:description "The calculation rule." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDetail> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDetail> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PaymentRule> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/paymentRule"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDiscounting> a linkml:SlotDefinition ;
	linkml:description "FpML specifies the FpML PaymentDiscounting.model group for representing the discounting elements that can be associated with a payment." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PaymentDiscounting> .
<https://w3id.org/lmodel/common-domain-model/paymentDiscounting__discountFactor> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "discountFactor" ;
	linkml:description "The value representing the discount factor used to calculate the present value of the cash flow." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDiscounting> ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDiscounting> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/discountFactor"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentDiscounting__presentValueAmount> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "presentValueAmount" ;
	linkml:description "The amount representing the present value of the forecast payment." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentDiscounting> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentDiscounting> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/presentValueAmount"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/paymentFrequency> a linkml:SlotDefinition ;
	linkml:description "The frequency at which regular payment dates occur. If the payment frequency is equal to the frequency defined in the calculation period dates component then one calculation period contributes to each payment amount. If the payment frequency is less frequent than the frequency defined in the calculation period dates component then more than one calculation period will contribute to the payment amount. A payment frequency more frequent than the calculation period frequency or one that is not a multiple of the calculation period frequency is invalid. If the payment frequency is of value T (term), the period is defined by the effectiveDate and the terminationDate." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Frequency> .
<https://w3id.org/lmodel/common-domain-model/paymentPercent> a linkml:SlotDefinition ;
	linkml:description "A percentage of the notional amount." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/decimal> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/paymentRequirement> a linkml:SlotDefinition ;
	linkml:description "Specifies a threshold for the failure to pay credit event. Market standard is USD 1,000,000 (JPY 100,000,000 for Japanese Yen trades) or its equivalent in the relevant obligation currency. This is applied on an aggregate basis across all Obligations of the Reference Entity. Intended to prevent technical/operational errors from triggering credit events. ISDA 2003 Term: Payment Requirement" ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Money> .
<https://w3id.org/lmodel/common-domain-model/paymentRule> a linkml:SlotDefinition ;
	linkml:description "The calculation rule." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PaymentRule> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/paymentRule__percentageRule> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "percentageRule" ;
	linkml:description "This attribute is not present as part of the FpML construct, as the payment rule is specialised by means of runtime type extension through the xsi:type." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PaymentRule> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/common-domain-model/PaymentRule> ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/PercentageRule> ;
	linkml:slot_uri "https://w3id.org/lmodel/common-domain-model/percentageRule"^^xsd:anyURI .
<https://w3id.org/lmodel/common-domain-model/payout> a linkml:SlotDefinition ;
	linkml:annotations _:c14n2535 , _:c14n2536 ;
	linkml:description "The payout specifies the future cashflow computation methodology which characterizes a financial product." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/Payout> ;
	linkml:required true .
<https://w3id.org/lmodel/common-domain-model/payoutBase__payerReceiver> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_settlement"^^xsd:anyURI ;
	skos:prefLabel "payerReceiver" ;
	linkml:description "Canonical representation of the payer and receiver parties applicable to each payout leg." ;
	linkml:domain_of <https://w3id.org/lmodel/common-domain-model/PayoutBase> ;
