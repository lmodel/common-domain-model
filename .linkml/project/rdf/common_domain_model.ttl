<https://w3id.org/lmodel/common-domain-model/AdditionalDisruptionEvents> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction> ;
    rdfs:seeAlso "isda:EquityDerivativesDefinitions_2002"^^xsd:anyURI ;
    skos:closeMatch "fpml_5_10:AdditionalDisruptionEvents"^^xsd:anyURI ;
    skos:editorialNote "ISDA EquityDerivativesDefinitions_2002" ;
    skos:exactMatch "common_domain_model:AdditionalDisruptionEvents"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_transaction"^^xsd:anyURI ;
    skos:note "Rosetta condition: DisruptionEventsDeterminingParty — if determiningParty exists then determiningParty = AncillaryRoleEnum -> DisruptionEventsDeterminingParty",
        "Rosetta condition: InitialStockLoanRate — if initialStockLoanRate exists then initialStockLoanRate >= 0 and initialStockLoanRate <= 1",
        "Rosetta condition: MaximumStockLoanRate — if maximumStockLoanRate exists then maximumStockLoanRate >= 0 and maximumStockLoanRate <= 1" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/initialStockLoanRate> ] ;
            linkml:description " FpML specifies the initialStockLoanRate as a RestrictedPercentage, meaning that its value is comprised between 0 and 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/initialStockLoanRate> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumStockLoanRate> ] ;
            linkml:description " FpML specifies the maximumStockLoanRate as a RestrictedPercentage, meaning that its value is comprised between 0 and 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/maximumStockLoanRate> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AdditionalDisruptionEvents"^^xsd:anyURI ;
    linkml:description "A type for defining the Additional Disruption Events." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AdditionalDisruptionEvents_additionalBespokeTerms>,
        <https://w3id.org/lmodel/common-domain-model/changeInLaw>,
        <https://w3id.org/lmodel/common-domain-model/determiningParty>,
        <https://w3id.org/lmodel/common-domain-model/failureToDeliver>,
        <https://w3id.org/lmodel/common-domain-model/foreignOwnershipEvent>,
        <https://w3id.org/lmodel/common-domain-model/hedgingDisruption>,
        <https://w3id.org/lmodel/common-domain-model/increasedCostOfHedging>,
        <https://w3id.org/lmodel/common-domain-model/increasedCostOfStockBorrow>,
        <https://w3id.org/lmodel/common-domain-model/initialStockLoanRate>,
        <https://w3id.org/lmodel/common-domain-model/insolvencyFiling>,
        <https://w3id.org/lmodel/common-domain-model/lossOfStockBorrow>,
        <https://w3id.org/lmodel/common-domain-model/maximumStockLoanRate> .

<https://w3id.org/lmodel/common-domain-model/DividendReturnTerms> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:DividendReturnTerms"^^xsd:anyURI ;
