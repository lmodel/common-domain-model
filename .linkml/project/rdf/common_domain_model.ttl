<https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementParty> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common> ;
    skos:exactMatch "common_domain_model:UmbrellaAgreementParty"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: NonLegalEntityParent — if nonLegalEntity exists then parentParty exists",
        "Rosetta condition: ParentParty — if partyRole = UmbrellaPartyRoleEnum -> Sleeve then parentParty exists",
        "Rosetta condition: UmbrellaParty — required choice party, nonLegalEntity" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/partyRole> ] ;
            linkml:description "Specifies that certain defined roles require that a parent party is identified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/parentParty> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Only a Party or a non-Legal entity can be set." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nonLegalEntity> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/party> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/nonLegalEntity> ] ;
            linkml:description "Non-Legal entity must have a Parent Party." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/parentParty> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementParty"^^xsd:anyURI ;
    linkml:description "Specifies the entities that are part of the umbrella agreement." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementParty_party>,
        <https://w3id.org/lmodel/common-domain-model/UmbrellaAgreementParty_partyRole>,
        <https://w3id.org/lmodel/common-domain-model/actingAs>,
        <https://w3id.org/lmodel/common-domain-model/nonLegalEntity>,
        <https://w3id.org/lmodel/common-domain-model/parentParty> .

<https://w3id.org/lmodel/common-domain-model/ValuationAgent> a linkml:ClassDefinition ;
