<https://w3id.org/lmodel/common-domain-model/Period> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "gist:TimeInterval"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:Period"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta condition: DayPeriod — if periodMultiplier = 0 then period = PeriodEnum -> D" ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/Period"^^xsd:anyURI ;
    linkml:description "A class to define recurring periods or time offsets." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Period_period>,
        <https://w3id.org/lmodel/common-domain-model/Period_periodMultiplier> .

<https://w3id.org/lmodel/common-domain-model/RelativeDateOffset> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:exactMatch "common_domain_model:RelativeDateOffset"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/RelativeDateOffset"^^xsd:anyURI ;
    linkml:description "A class defining a date (referred to as the derived date) as a relative offset from another date (referred to as the anchor date). If the anchor date is itself an adjustable date then the offset is assumed to be calculated from the adjusted anchor date. A number of different scenarios can be supported, namely; 1) the derived date may simply be a number of calendar periods (days, weeks, months or years) preceding or following the anchor date; 2) the unadjusted derived date may be a number of calendar periods (days, weeks, months or years) preceding or following the anchor date with the resulting unadjusted derived date subject to adjustment in accordance with a specified business day convention, i.e. the derived date must fall on a good business day; 3) the derived date may be a number of business days preceding or following the anchor date. Note that the businessDayConvention specifies any required adjustment to the unadjusted derived date. A negative or positive value in the periodMultiplier indicates whether the unadjusted derived precedes or follows the anchor date. The businessDayConvention should contain a value NONE if the day type element contains a value of Business (since specifying a negative or positive business days offset would already guarantee that the derived date would fall on a good business day in the specified business centers)." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/Offset> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/Period_period>,
        <https://w3id.org/lmodel/common-domain-model/Period_periodMultiplier>,
        <https://w3id.org/lmodel/common-domain-model/RelativeDateOffset_businessCentersReference>,
        <https://w3id.org/lmodel/common-domain-model/adjustedDate>,
        <https://w3id.org/lmodel/common-domain-model/businessCenters>,
        <https://w3id.org/lmodel/common-domain-model/businessDayConvention>,
        <https://w3id.org/lmodel/common-domain-model/dateRelativeTo>,
        <https://w3id.org/lmodel/common-domain-model/dayType> .

<https://w3id.org/lmodel/common-domain-model/ReturnTermsBase> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_asset> ;
    skos:exactMatch "common_domain_model:ReturnTermsBase"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_asset"^^xsd:anyURI ;
    skos:note "Rosetta condition: InitialLevelOrInitialLevelSource — if initialLevel is absent then initialLevelSource exists and if initialLevelSource is absent then initialLevel exists",
        "Rosetta condition: PositiveExpectedN — expectedN > 0" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "The number of expected trading dates must be positive" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/expectedN> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/initialLevel> ] ;
            linkml:description "At least one of initialLevel and initialLevelSource must be present, or both" ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/initialLevelSource> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/ReturnTermsBase"^^xsd:anyURI ;
    linkml:description "Contains all common elements in variance, volatility and correlation return Terms." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/annualizationFactor>,
        <https://w3id.org/lmodel/common-domain-model/dividendApplicability>,
        <https://w3id.org/lmodel/common-domain-model/equityUnderlierProvisions>,
        <https://w3id.org/lmodel/common-domain-model/expectedN>,
        <https://w3id.org/lmodel/common-domain-model/initialLevel>,
        <https://w3id.org/lmodel/common-domain-model/initialLevelSource>,
        <https://w3id.org/lmodel/common-domain-model/meanAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/performance>,
        <https://w3id.org/lmodel/common-domain-model/sharePriceDividendAdjustment>,
        <https://w3id.org/lmodel/common-domain-model/valuationTerms> .

<https://w3id.org/lmodel/common-domain-model/AggregationParameters> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_position> ;
    skos:closeMatch "fpml_5_10:AggregationParameters"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AggregationParameters"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_position"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AggregationParameters"^^xsd:anyURI ;
    linkml:description " Parameters to be used to filter events that are relevant to a given portfolio in order to calculate the state of this portfolio. The attributes correspond to all the possible aggregation criteria that can be used and these criteria can be combined. All the attributes are optional." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AggregationParameters_dateTime>,
        <https://w3id.org/lmodel/common-domain-model/AggregationParameters_party>,
        <https://w3id.org/lmodel/common-domain-model/AggregationParameters_product>,
        <https://w3id.org/lmodel/common-domain-model/AggregationParameters_productQualifier>,
        <https://w3id.org/lmodel/common-domain-model/positionStatus>,
        <https://w3id.org/lmodel/common-domain-model/totalPosition>,
        <https://w3id.org/lmodel/common-domain-model/tradeReference> .

<https://w3id.org/lmodel/common-domain-model/AssetPayout> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_template> ;
    skos:closeMatch "fpml_5_10:AssetPayout"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:AssetPayout"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_template"^^xsd:anyURI ;
    skos:note "Rosetta condition: Quantity — priceQuantity exists",
        "Rosetta condition: UnderlierNotCash — underlier -> Cash is absent" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "When there is an OptionPayout the quantity can be expressed as part of the payoutQuantity, or as part of the underlier in the case of a Swaption.  For all other payouts that extend PayoutBase the payoutQuantity is a mandatory attribute." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/priceQuantity> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/AssetPayout"^^xsd:anyURI ;
    linkml:description "Security finance payout specification in case the product payout involves some form of security collateral, as in a securities financing transaction. Plus additional description for ICMA." ;
    linkml:is_a <https://w3id.org/lmodel/common-domain-model/PayoutBase> ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/AssetPayout_dividendTerms>,
        <https://w3id.org/lmodel/common-domain-model/AssetPayout_minimumFee>,
        <https://w3id.org/lmodel/common-domain-model/AssetPayout_underlier>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase_payerReceiver>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase_priceQuantity>,
        <https://w3id.org/lmodel/common-domain-model/PayoutBase_settlementTerms>,
        <https://w3id.org/lmodel/common-domain-model/assetLeg>,
        <https://w3id.org/lmodel/common-domain-model/principalPayment>,
        <https://w3id.org/lmodel/common-domain-model/tradeType> .

<https://w3id.org/lmodel/common-domain-model/BusinessCenterTime> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_base_datetime> ;
    skos:closeMatch "fpml_5_10:BusinessCenterTime"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:BusinessCenterTime"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_datetime"^^xsd:anyURI ;
    skos:note "Rosetta func: TimeZoneFromBusinessCenterTime — Function to resolve a time passed as BusinessCenterTime into a TimeZone time." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example "[{\"name\":\"TimeZoneFromBusinessCenterTime\",\"description\":\"Function to resolve a time passed as BusinessCenterTime into a TimeZone time.\",\"inputs\":[{\"name\":\"time\",\"type\":\"BusinessCenterTime\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"result\",\"type\":\"TimeZone\",\"cardinality\":\"1..1\"},\"code_implementation\":true}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/BusinessCenterTime"^^xsd:anyURI ;
    linkml:description "A class for defining a time with respect to a business day calendar location. For example, 11:00:00 GBLO." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/BusinessCenterTime_businessCenter>,
        <https://w3id.org/lmodel/common-domain-model/hourMinuteTime> .

<https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:exactMatch "common_domain_model:EligibleCollateralSpecification"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta func: CheckEligibilityByDetails — This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.",
        "Rosetta func: CheckEligibilityForProduct",
        "Rosetta func: CloneEligibleCollateralWithChangedTreatment — Creates a new Eligible Collateral Specification based on an input specification but with one changed criteria and with one changed treatment." ;
    linkml:annotations [ a linkml:Annotation ;
            skos:example true ;
            linkml:tag "metadata_key"^^xsd:anyURI ],
        [ a linkml:Annotation ;
            skos:example "[{\"name\":\"CloneEligibleCollateralWithChangedTreatment\",\"description\":\"Creates a new Eligible Collateral Specification based on an input specification but with one changed criteria and with one changed treatment.\",\"inputs\":[{\"name\":\"inputSpecification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"},{\"name\":\"changedCriteria\",\"type\":\"CollateralCriteria\",\"cardinality\":\"1..1\"},{\"name\":\"changedTreatment\",\"type\":\"CollateralTreatment\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"outputSpecification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"}},{\"name\":\"CheckEligibilityForProduct\",\"inputs\":[{\"name\":\"specifications\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..*\"},{\"name\":\"product\",\"type\":\"TransferableProduct\",\"cardinality\":\"0..1\"}],\"output\":{\"name\":\"eligibilityResult\",\"type\":\"CheckEligibilityResult\",\"cardinality\":\"0..1\"},\"code_implementation\":true},{\"name\":\"CheckEligibilityByDetails\",\"description\":\"This function when presented with a set of Asset and Issuer details to be potentially posted as collateral, will check against a set of given Eligibility Criteria or Basket (EligibleCollateralSpecification) to determine which collateral meets the eligibility and can be used/posted for delivery.\",\"inputs\":[{\"name\":\"specification\",\"type\":\"EligibleCollateralSpecification\",\"cardinality\":\"1..1\"},{\"name\":\"query\",\"type\":\"EligibilityQuery\",\"cardinality\":\"1..1\"}],\"output\":{\"name\":\"eligibilityResult\",\"type\":\"CheckEligibilityResult\",\"cardinality\":\"1..1\"}}]" ;
            linkml:tag "rosetta_functions"^^xsd:anyURI ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification"^^xsd:anyURI ;
    linkml:description "Represents a set of criteria used to specify eligible collateral." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification_counterparty>,
        <https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification_criteria>,
        <https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification_identifier>,
        <https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification_party>,
        <https://w3id.org/lmodel/common-domain-model/EligibleCollateralSpecification_partyRole> ;
    linkml:tree_root true .

<https://w3id.org/lmodel/common-domain-model/ExtendibleProvision> a linkml:ClassDefinition ;
