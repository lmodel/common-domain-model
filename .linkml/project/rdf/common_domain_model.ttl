<https://w3id.org/lmodel/common-domain-model/ComputedAmount_currency> a linkml:SlotDefinition ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_base_math"^^xsd:anyURI ;
    skos:prefLabel "currency" ;
    linkml:annotations [ linkml:metadata_scheme [ skos:example true ;
                    linkml:annotations [ ] ;
                    linkml:extensions [ ] ;
                    linkml:tag "metadata_scheme"^^xsd:anyURI ] ] ;
