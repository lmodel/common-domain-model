<https://w3id.org/lmodel/common-domain-model/State> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_event_common> ;
    skos:exactMatch "common_domain_model:State"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_event_common"^^xsd:anyURI ;
    skos:note "Rosetta condition: ClosedStateExists — if positionState = PositionStatusEnum -> Closed then closedState exists" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/positionState> ] ;
            linkml:description "When the position state is identified as closed, the closed state must also be specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/closedState> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/State"^^xsd:anyURI ;
    linkml:description "Defines the state of a trade at a point in the Trade's life cycle. Trades have many state dimensions, all of which are represented here. For example, states useful for position keeping are represented alongside those needed for regulatory reporting." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/closedState>,
        <https://w3id.org/lmodel/common-domain-model/positionState> .

<https://w3id.org/lmodel/common-domain-model/StubCalculationPeriodAmount> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule> ;
    skos:exactMatch "common_domain_model:StubCalculationPeriodAmount"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_common_schedule"^^xsd:anyURI ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/StubCalculationPeriodAmount"^^xsd:anyURI ;
    linkml:description "A data defining:  how the initial or final stub calculation period amounts is calculated. For example, the rate to be applied to the initial or final stub calculation period may be the linear interpolation of two different tenors for the floating rate index specified in the calculation period amount component, e.g. A two month stub period may used the linear interpolation of a one month and three month floating rate. The different rate tenors would be specified in this component. Note that a maximum of two rate tenors can be specified. If a stub period uses a single index tenor and this is the same as that specified in the calculation period amount component then the initial stub or final stub component, as the case may be, must not be included." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/calculationPeriodDatesReference>,
        <https://w3id.org/lmodel/common-domain-model/finalStub>,
        <https://w3id.org/lmodel/common-domain-model/initialStub> .

