<https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_product_collateral> ;
    skos:closeMatch "fpml_5_10:CollateralValuationTreatment"^^xsd:anyURI ;
    skos:exactMatch "common_domain_model:CollateralValuationTreatment"^^xsd:anyURI ;
    skos:inScheme "https://w3id.org/lmodel/common-domain-model/cdm_product_collateral"^^xsd:anyURI ;
    skos:note "Rosetta condition: AdditionalHaircutPercentage — if additionalHaircutPercentage exists then additionalHaircutPercentage > 0 and additionalHaircutPercentage < 1",
        "Rosetta condition: FxHaircutPercentage — if fxHaircutPercentage exists then fxHaircutPercentage > 0 and fxHaircutPercentage < 1",
        "Rosetta condition: HaircutPercentage — if haircutPercentage exists then haircutPercentage >= 0 and haircutPercentage < 1",
        "Rosetta condition: HaircutPercentageOrMarginPercentage — required choice haircutPercentage, marginPercentage",
        "Rosetta condition: MarginPercentage — if marginPercentage exists then marginPercentage >= 1" ;
    sh:rule [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ] ;
            linkml:description "Choice rule requiring that either a haircut percentage or margin percentage is specified." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:exactly_one_of [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/marginPercentage> ],
                        [ a linkml:AnonymousClassExpression ;
                            linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/haircutPercentage> ] ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/marginPercentage> ] ;
            linkml:description "A data rule to validate that if a Margin Percentage is specified it should be greater than 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/marginPercentage> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalHaircutPercentage> ] ;
            linkml:description "A data rule to validate that if an FX Haircut Percentage is specified it should be between 0 and  less than 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/additionalHaircutPercentage> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fxHaircutPercentage> ] ;
            linkml:description "A data rule to validate that if an FX Haircut Percentage is specified it should be between 0 and less than 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/fxHaircutPercentage> ] ],
        [ a linkml:ClassRule ;
            sh:condition [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/haircutPercentage> ] ;
            linkml:description "A data rule to validate that if a Valuation Percentage is specified it should be greater than or equal to 0 and less than 1." ;
            linkml:postconditions [ a linkml:AnonymousClassExpression ;
                    linkml:slot_conditions <https://w3id.org/lmodel/common-domain-model/haircutPercentage> ] ] ;
    linkml:definition_uri "https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment"^^xsd:anyURI ;
    linkml:description "Specification of the valuation treatment for the specified collateral." ;
    linkml:slot_usage [ ] ;
    linkml:slots <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment_additionalHaircutPercentage>,
        <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment_fxHaircutPercentage>,
        <https://w3id.org/lmodel/common-domain-model/CollateralValuationTreatment_haircutPercentage>,
        <https://w3id.org/lmodel/common-domain-model/marginPercentage> .

<https://w3id.org/lmodel/common-domain-model/CoveredTransactions> a linkml:ClassDefinition ;
    OIO:inSubset <https://w3id.org/lmodel/common-domain-model/cdm_legaldocumentation_csa> ;
