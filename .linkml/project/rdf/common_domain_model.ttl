<https://w3id.org/lmodel/common-domain-model/sovereignRecourse> a linkml:SlotDefinition ;
	linkml:description "Applies to non-sovereign entity (e.g. separate legal personality from sovereign). True if entity has recourse to sovereign (e.g. debt guaranteed by government). False if entity does not have recourse to sovereign." , "Applies to regional governments, local authorities or municipals. True if entity has recourse to sovereign (e.g. debt guaranteed by government). False if entity does not have recourse to sovereign." ;
	linkml:range <https://w3id.org/lmodel/common-domain-model/boolean> ;
	linkml:required true .
